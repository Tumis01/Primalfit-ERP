                            </button>
                            @if (_hrReportOpen)
                            {
                                <div class="space-y-0.5 mb-2">
                                    <NavLink href="hr/payslips" class="@NestedNavLink" activeClass="@NestedNavActive">Payslips & Exports</NavLink>
                                    <NavLink href="hr/compliance-reports" class="@NestedNavLink" activeClass="@NestedNavActive">Compliance Reports</NavLink>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div> 

            @* 6. PROJECTS *@
            <NavLink href="/projects" class="@NavBase" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                </svg>
                <span class="flex-1 font-medium">Projects</span>
            </NavLink>

            @* 7. FIXED ASSETS *@
            <div class="space-y-1">
                <button @onclick="ToggleAssetsMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                        </svg>
                        <span class="flex-1 text-left font-medium">Fixed Assets</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_assetsMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_assetsMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="assets/register" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Asset Register
                            </NavLink>
                            <NavLink href="assets/categories" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Categories
                            </NavLink>
                            <NavLink href="assets/usage-logs" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Usage Logs
                            </NavLink>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-6 mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-slate-400">Tools & Config</div>

            @* 8. SYSTEM SETUP *@
            <div class="space-y-1">
                <button @onclick="ToggleSetupMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">System Setup</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_setupMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_setupMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="/companydetails" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Company Details
                            </NavLink>
                            <NavLink href="users" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Users
                            </NavLink>
                            <NavLink href="roles" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Roles
                            </NavLink>
                            <NavLink href="tax-setup" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Tax Setup
                            </NavLink>
                            <NavLink href="accounting-periods" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Fiscal Periods
                            </NavLink>
                            <NavLink href="currency-setup" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Currency
                            </NavLink>
                        </div>
                    </div>
                }
            </div>

           

        </nav>

        <div class="border-t border-slate-100 p-4 bg-white">
            <a href="/auth/logout" class="group flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-rose-50 hover:text-rose-600 transition-all">
                <svg class="h-5 w-5 text-slate-400 group-hover:text-rose-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                Sign Out
            </a>
        </div>

    </div>
</aside>

@code {
    private bool _sidebarOpen;

    // Main Module Toggles
    private bool _financeMenuOpen;
    private bool _salesMenuOpen;
    private bool _purchasingMenuOpen;
    private bool _inventoryMenuOpen;
    private bool _hrMenuOpen;
    private bool _assetsMenuOpen;
    private bool _setupMenuOpen;

    // Sub-Folder Toggles
    private bool _financeSetupOpen;
    private bool _financeTransOpen;
    private bool _financeReportOpen;

    private bool _salesSetupOpen;
    private bool _salesTransOpen;
    private bool _salesReportOpen;

    private bool _purchasingSetupOpen;
    private bool _purchasingTransOpen;
    private bool _purchasingReportOpen;

    private bool _inventorySetupOpen;
    private bool _inventoryTransOpen;
    private bool _inventoryReportOpen;

    private bool _hrSetupOpen;
    private bool _hrTransOpen;
    private bool _hrReportOpen;

    private string userName = "Guest";
    private string userInitial = "G";
    private bool needsCompanySetup = false;

    // CSS Classes
    private string SidebarClass => _sidebarOpen
            ? "fixed inset-y-0 left-0 z-40 w-[280px] bg-white shadow-[4px_0_24px_-12px_rgba(0,0,0,0.18)] transition-transform duration-300 ease-out lg:translate-x-0"
            : "fixed inset-y-0 left-0 z-40 w-[280px] bg-white shadow-none -translate-x-full transition-transform duration-300 ease-out lg:translate-x-0";

    // Main module styles
    private const string NavBase = "group relative flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all cursor-pointer";
    private const string NavActive = "bg-slate-900 text-white shadow-sm hover:text-white";
    private const string IconBase = "h-5 w-5 opacity-70 group-hover:opacity-100 transition-opacity [.active_&]:opacity-100";

    // Standard Subnav styles (for single depth)
    private const string SubNavBase = "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all ml-3.5";
    private const string SubNavActive = "text-slate-900 bg-slate-100 font-semibold shadow-sm ring-1 ring-slate-200/50";

    // Nested Subnav styles (for the Setup/Trans/Report folders)
    private const string SubNavFolderBase = "flex w-full items-center justify-between rounded-lg px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 transition-all ml-2";
    private const string NestedNavLink = "flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-all ml-6 relative before:content-[''] before:absolute before:left-[-12px] before:top-1/2 before:-translate-y-1/2 before:w-1.5 before:h-1.5 before:rounded-full before:bg-slate-300 hover:before:bg-slate-500";
    private const string NestedNavActive = "text-slate-900 bg-slate-100 font-bold shadow-sm ring-1 ring-slate-200/50 before:bg-slate-800";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // 1. Get the UserId safely from the browser's auth cookie (Claims) without hitting the DB
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            // 2. Spin up a completely private, isolated DB connection just for the NavMenu
            await using var ctx = await DbFactory.CreateDbContextAsync();
        
            // 3. Fetch the user directly
            var dbUser = await ctx.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);

            if (dbUser?.CompanyDetailsId != null)
            {
                // 4. Fetch the company directly using this isolated context (Bypassing ApiService)
                var company = await ctx.CompanyDetails.AsNoTracking().FirstOrDefaultAsync(c => c.CompanyDetailsId == dbUser.CompanyDetailsId.Value);
            
                if (company != null && (string.IsNullOrWhiteSpace(company.BaseCurrency) || company.FiscalStartYear == null))
                {
                    needsCompanySetup = true;
                }
            }
        }

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            userName = user.Identity.Name ?? "User";
            userInitial = userName.Substring(0, 1).ToUpperInvariant();
        }

        // --- INTELLIGENT AUTO-EXPAND LOGIC ---
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
    
        // 1. Finance & GL Routing
        if (path.StartsWith("seg-account-types") || path.StartsWith("finance/segments-setup") || path.StartsWith("finance/segmented-coa"))
        { _financeMenuOpen = true; _financeSetupOpen = true; }

        if (path.StartsWith("gl/journal-entry") || path.StartsWith("gl/batches") || path.StartsWith("gl/cashbook") || path.StartsWith("finance/budget"))
        { _financeMenuOpen = true; _financeTransOpen = true; }

        if (path.StartsWith("gl/general-ledger") || path.StartsWith("reports/profit-and-loss") || path.StartsWith("reports/balance-sheet") || path.StartsWith("reports/budget-variance") || path.StartsWith("gl/bank-reconciliation"))
        { _financeMenuOpen = true; _financeReportOpen = true; }
    
        // 2. AR & Sales Routing
        if (path.StartsWith("md/customers") || path.StartsWith("md/customer-groups"))
        { _salesMenuOpen = true; _salesSetupOpen = true; }

        if (path.StartsWith("sc/sales-orders") || path.StartsWith("ar/payment-entry") || path.StartsWith("sales/credit-notes"))
        { _salesMenuOpen = true; _salesTransOpen = true; }

        if (path.StartsWith("reports/customer-transactions") || path.StartsWith("reports/ar-age-analysis") || path.StartsWith("reports/sales-analysis"))
        { _salesMenuOpen = true; _salesReportOpen = true; }
    
        // 3. AP & Purchasing Routing
        if (path.StartsWith("md/vendors") || path.StartsWith("md/vendor-groups"))
        { _purchasingMenuOpen = true; _purchasingSetupOpen = true; }

        if (path.StartsWith("procurement/purchase-orders") || path.StartsWith("ap/bill-entry") || path.StartsWith("purchases/returns"))
        { _purchasingMenuOpen = true; _purchasingTransOpen = true; }
    
        // 4. Inventory & Stock Routing
        if (path.StartsWith("sc/items") || path.StartsWith("sc/uom") || path == "warehouses")
        { _inventoryMenuOpen = true; _inventorySetupOpen = true; }

        if (path.StartsWith("sc/stock-entry") || path.StartsWith("sc/transfers") || path.StartsWith("supply-chain/issue-to-project") || path.StartsWith("wh/shipments"))
        { _inventoryMenuOpen = true; _inventoryTransOpen = true; }

        if (path.StartsWith("sc/stock-list") || path.StartsWith("reports/consumption-log") || path.StartsWith("reports/stock-aging") || path.StartsWith("reports/inventory-valuation"))
        { _inventoryMenuOpen = true; _inventoryReportOpen = true; }
    
        // 5. HR & Payroll Routing
        if (path.StartsWith("hr/settings") || path.StartsWith("hr/employees"))
        { _hrMenuOpen = true; _hrSetupOpen = true; }

        if (path.StartsWith("hr/payroll-manager"))
        { _hrMenuOpen = true; _hrTransOpen = true; }

        if (path.StartsWith("hr/payslips") || path.StartsWith("hr/compliance-reports"))
        { _hrMenuOpen = true; _hrReportOpen = true; }
    
        // Others
        _assetsMenuOpen = path.StartsWith("assets/");
        _setupMenuOpen = path is "companies" or "users" or "roles" or "tax-setup" or "accounting-periods" or "currency-setup";
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;

    // Main Toggles
    private void ToggleFinanceMenu() => _financeMenuOpen = !_financeMenuOpen;
    private void ToggleSalesMenu() => _salesMenuOpen = !_salesMenuOpen;
    private void TogglePurchasingMenu() => _purchasingMenuOpen = !_purchasingMenuOpen;
    private void ToggleInventoryMenu() => _inventoryMenuOpen = !_inventoryMenuOpen;
    private void ToggleHrMenu() => _hrMenuOpen = !_hrMenuOpen;
    private void ToggleAssetsMenu() => _assetsMenuOpen = !_assetsMenuOpen;
    private void ToggleSetupMenu() => _setupMenuOpen = !_setupMenuOpen;
}