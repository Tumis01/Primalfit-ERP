@code {
    // THIS ALLOWS THE NAV TO TALK TO THE LAYOUT
    [Parameter]
    public EventCallback<bool> OnCollapseToggled { get; set; }

    private bool _sidebarOpen;
    private bool _isCollapsed = false;

    // Main Module Toggles
    private bool _financeMenuOpen;
    private bool _salesMenuOpen;
    private bool _purchasingMenuOpen;
    private bool _inventoryMenuOpen;
    private bool _hrMenuOpen;
    private bool _assetsMenuOpen;
    private bool _setupMenuOpen;

    // Sub-Folder Toggles
    private bool _financeSetupOpen;
    private bool _financeTransOpen;
    private bool _financeReportOpen;

    private bool _salesSetupOpen;
    private bool _salesTransOpen;
    private bool _salesReportOpen;

    private bool _purchasingSetupOpen;
    private bool _purchasingTransOpen;
    private bool _purchasingReportOpen;

    private bool _inventorySetupOpen;
    private bool _inventoryTransOpen;
    private bool _inventoryReportOpen;

    private bool _hrSetupOpen;
    private bool _hrTransOpen;
    private bool _hrReportOpen;

    private string userName = "Guest";
    private string userInitial = "G";
    private bool needsCompanySetup = false;

    private string SidebarClass =>
        $"fixed inset-y-0 left-0 z-40 bg-white border-r border-slate-200 transition-all duration-300 ease-in-out flex flex-col " +
        (_sidebarOpen ? "translate-x-0 shadow-[4px_0_24px_-12px_rgba(0,0,0,0.18)] " : "-translate-x-full lg:translate-x-0 ") +
        (_isCollapsed ? "lg:w-[80px]" : "lg:w-[280px]");

    private const string NavBase = "group relative flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all cursor-pointer";
    private const string NavActive = "bg-slate-900 text-white shadow-sm hover:text-white";
    private const string IconBase = "h-5 w-5 shrink-0 opacity-70 group-hover:opacity-100 transition-opacity [.active_&]:opacity-100";
    private const string SubNavBase = "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all ml-3.5 whitespace-nowrap";
    private const string SubNavActive = "text-slate-900 bg-slate-100 font-semibold shadow-sm ring-1 ring-slate-200/50";
    private const string SubNavFolderBase = "flex w-full items-center justify-between rounded-lg px-3 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 transition-all ml-2 whitespace-nowrap";
    private const string NestedNavLink = "flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-medium text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-all ml-6 relative before:content-[''] before:absolute before:left-[-12px] before:top-1/2 before:-translate-y-1/2 before:w-1.5 before:h-1.5 before:rounded-full before:bg-slate-300 hover:before:bg-slate-500 whitespace-nowrap";
    private const string NestedNavActive = "text-slate-900 bg-slate-100 font-bold shadow-sm ring-1 ring-slate-200/50 before:bg-slate-800";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var dbUser = await ctx.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == userId);

            if (dbUser?.CompanyDetailsId != null)
            {
                // ---> CRITICAL FIX: Load permissions into the cache before NavMenu renders <---
                await PermissionCache.LoadAsync(dbUser.Id, dbUser.CompanyDetailsId.Value);

                var company = await ctx.CompanyDetails.AsNoTracking().FirstOrDefaultAsync(c => c.CompanyDetailsId == dbUser.CompanyDetailsId.Value);
            
                if (company != null && (string.IsNullOrWhiteSpace(company.BaseCurrency) || company.FiscalStartYear == null))
                {
                    needsCompanySetup = true;
                }
            }
        }

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            userName = user.Identity.Name ?? "User";
            userInitial = userName.Substring(0, 1).ToUpperInvariant();
        }

        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
    
        if (path.StartsWith("seg-account-types") || path.StartsWith("finance/segments-setup") || path.StartsWith("finance/segmented-coa"))
        { _financeMenuOpen = true; _financeSetupOpen = true; }

        if (path.StartsWith("gl/journal-entry") || path.StartsWith("gl/batches") || path.StartsWith("gl/cashbook") || path.StartsWith("finance/budget"))
        { _financeMenuOpen = true; _financeTransOpen = true; }

        if (path.StartsWith("gl/general-ledger") || path.StartsWith("reports/profit-and-loss") || path.StartsWith("reports/balance-sheet") || path.StartsWith("reports/budget-variance") || path.StartsWith("gl/bank-reconciliation"))
        { _financeMenuOpen = true; _financeReportOpen = true; }
    
        if (path.StartsWith("md/customers") || path.StartsWith("md/customer-groups"))
        { _salesMenuOpen = true; _salesSetupOpen = true; }

        if (path.StartsWith("sc/sales-orders") || path.StartsWith("ar/payment-entry") || path.StartsWith("sales/credit-notes"))
        { _salesMenuOpen = true; _salesTransOpen = true; }

        if (path.StartsWith("reports/customer-transactions") || path.StartsWith("reports/ar-age-analysis") || path.StartsWith("reports/sales-analysis"))
        { _salesMenuOpen = true; _salesReportOpen = true; }
    
        if (path.StartsWith("md/vendors") || path.StartsWith("md/vendor-groups"))
        { _purchasingMenuOpen = true; _purchasingSetupOpen = true; }

        if (path.StartsWith("procurement/purchase-orders") || path.StartsWith("ap/bill-entry") || path.StartsWith("purchases/returns"))
        { _purchasingMenuOpen = true; _purchasingTransOpen = true; }
    
        if (path.StartsWith("sc/items") || path.StartsWith("sc/uom") || path == "warehouses")
        { _inventoryMenuOpen = true; _inventorySetupOpen = true; }

        if (path.StartsWith("sc/stock-entry") || path.StartsWith("sc/transfers") || path.StartsWith("supply-chain/issue-to-project") || path.StartsWith("wh/shipments"))
        { _inventoryMenuOpen = true; _inventoryTransOpen = true; }

        if (path.StartsWith("sc/stock-list") || path.StartsWith("reports/consumption-log") || path.StartsWith("reports/stock-aging") || path.StartsWith("reports/inventory-valuation"))
        { _inventoryMenuOpen = true; _inventoryReportOpen = true; }
    
        if (path.StartsWith("hr/settings") || path.StartsWith("hr/employees"))
        { _hrMenuOpen = true; _hrSetupOpen = true; }

        if (path.StartsWith("hr/payroll-manager"))
        { _hrMenuOpen = true; _hrTransOpen = true; }

        if (path.StartsWith("hr/payslips") || path.StartsWith("hr/compliance-reports"))
        { _hrMenuOpen = true; _hrReportOpen = true; }
    
        _assetsMenuOpen = path.StartsWith("assets/");
        _setupMenuOpen = path is "companies" or "users" or "roles" or "tax-setup" or "accounting-periods" or "currency-setup";
        
        // Force Blazor to re-evaluate the gates now that the cache is definitely loaded
        StateHasChanged();
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;
    
    // FIRES THE EVENT TO MAIN LAYOUT
    private async Task ToggleDesktopSidebar()
    {
        _isCollapsed = !_isCollapsed;
        if (OnCollapseToggled.HasDelegate) await OnCollapseToggled.InvokeAsync(_isCollapsed);
    }

    private async Task AutoExpand()
    {
        if (_isCollapsed)
        {
            _isCollapsed = false;
            if (OnCollapseToggled.HasDelegate) await OnCollapseToggled.InvokeAsync(false);
        }
    }

    private void CloseAllMainMenus()
    {
        _financeMenuOpen = false; _salesMenuOpen = false; _purchasingMenuOpen = false;
        _inventoryMenuOpen = false; _hrMenuOpen = false; _assetsMenuOpen = false; _setupMenuOpen = false;
    }

    private void CloseAllSubMenus()
    {
        _financeSetupOpen = false; _financeTransOpen = false; _financeReportOpen = false;
        _salesSetupOpen = false; _salesTransOpen = false; _salesReportOpen = false;
        _purchasingSetupOpen = false; _purchasingTransOpen = false; _purchasingReportOpen = false;
        _inventorySetupOpen = false; _inventoryTransOpen = false; _inventoryReportOpen = false;
        _hrSetupOpen = false; _hrTransOpen = false; _hrReportOpen = false;
    }

    // Toggles now automatically expand the sidebar if it was collapsed!
    private async Task ToggleFinanceMenu() { await AutoExpand(); bool wasOpen = _financeMenuOpen; CloseAllMainMenus(); _financeMenuOpen = !wasOpen; }
    private async Task ToggleSalesMenu() { await AutoExpand(); bool wasOpen = _salesMenuOpen; CloseAllMainMenus(); _salesMenuOpen = !wasOpen; }
    private async Task TogglePurchasingMenu() { await AutoExpand(); bool wasOpen = _purchasingMenuOpen; CloseAllMainMenus(); _purchasingMenuOpen = !wasOpen; }
    private async Task ToggleInventoryMenu() { await AutoExpand(); bool wasOpen = _inventoryMenuOpen; CloseAllMainMenus(); _inventoryMenuOpen = !wasOpen; }
    private async Task ToggleHrMenu() { await AutoExpand(); bool wasOpen = _hrMenuOpen; CloseAllMainMenus(); _hrMenuOpen = !wasOpen; }
    private async Task ToggleAssetsMenu() { await AutoExpand(); bool wasOpen = _assetsMenuOpen; CloseAllMainMenus(); _assetsMenuOpen = !wasOpen; }
    private async Task ToggleSetupMenu() { await AutoExpand(); bool wasOpen = _setupMenuOpen; CloseAllMainMenus(); _setupMenuOpen = !wasOpen; }

    private void ToggleFinanceSetup() { bool wasOpen = _financeSetupOpen; CloseAllSubMenus(); _financeSetupOpen = !wasOpen; }
    private void ToggleFinanceTrans() { bool wasOpen = _financeTransOpen; CloseAllSubMenus(); _financeTransOpen = !wasOpen; }
    private void ToggleFinanceReport() { bool wasOpen = _financeReportOpen; CloseAllSubMenus(); _financeReportOpen = !wasOpen; }

    private void ToggleSalesSetup() { bool wasOpen = _salesSetupOpen; CloseAllSubMenus(); _salesSetupOpen = !wasOpen; }
    private void ToggleSalesTrans() { bool wasOpen = _salesTransOpen; CloseAllSubMenus(); _salesTransOpen = !wasOpen; }
    private void ToggleSalesReport() { bool wasOpen = _salesReportOpen; CloseAllSubMenus(); _salesReportOpen = !wasOpen; }

    private void TogglePurchasingSetup() { bool wasOpen = _purchasingSetupOpen; CloseAllSubMenus(); _purchasingSetupOpen = !wasOpen; }
