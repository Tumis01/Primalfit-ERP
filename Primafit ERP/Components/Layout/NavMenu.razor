                                <svg class="h-3 w-3 text-slate-400 @(_hrTransOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                            </button>
                            @if (_hrTransOpen)
                            {
                                <div class="space-y-0.5 mb-2">
