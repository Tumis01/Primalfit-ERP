@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PrimafitERP.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject CompanyApiService ApiService
@inject UserManager<ApplicationUser> UserManager
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager

@inject IDbContextFactory<AppDbContext> DbFactory

@* --- MOBILE OVERLAY --- *@
<div class="@(_sidebarOpen ? "fixed inset-0 z-40 bg-slate-900/30 backdrop-blur-sm lg:hidden transition-opacity duration-300" : "hidden")"
     @onclick="CloseSidebar"></div>

@* --- TOP HEADER --- *@
<header class="fixed top-0 left-0 right-0 z-30 flex h-16 items-center border-b border-slate-200/80 bg-white/90 backdrop-blur-xl transition-all duration-300 @(_isCollapsed ? "lg:left-[80px]" : "lg:left-[280px]") shadow-sm">
    
    <div class="flex h-full w-full items-center gap-4 px-4 lg:px-6">

        @* Desktop Toggle Button *@
        <button type="button"
                class="hidden lg:inline-flex h-10 w-10 items-center justify-center rounded-xl text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all mr-2"
                @onclick="ToggleDesktopSidebar">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

        @* Mobile Toggle Button *@
        <button type="button"
                class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all lg:hidden"
                @onclick="ToggleSidebar">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

        <a href="/" class="flex items-center gap-2 lg:hidden">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-slate-900 text-white shadow-sm">
                <span class="text-sm font-bold">P</span>
            </span>
            <span class="text-lg font-bold text-slate-900 tracking-tight">Primafit</span>
        </a>

        <div class="flex-1"></div>
        
        @if (needsCompanySetup)
        {
            <div class="bg-indigo-600 text-white px-4 py-2 text-center text-xs font-bold rounded-lg shadow-sm">
                Your organization profile is incomplete!
                <a href="/companydetails" class="underline ml-2 hover:text-indigo-200">Complete Setup Now →</a>
            </div>
        }
        
        <div class="flex items-center gap-3 pl-4 lg:border-l lg:border-slate-200/70">
            <div class="group flex items-center gap-3 rounded-full bg-white border border-slate-200/70 py-1 pl-1 pr-3 transition-all cursor-pointer hover:bg-slate-50 hover:border-slate-300/80">
                <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-800 font-bold text-xs ring-2 ring-white shadow-sm">
                    @userInitial
                </div>
                <div class="text-left hidden sm:block">
                    <p class="text-xs font-semibold text-slate-800">@userName</p>
                    <p class="text-[10px] text-emerald-600 font-medium flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Online
                    </p>
                </div>
            </div>
        </div>

    </div>
</header>

@* --- SIDEBAR --- *@
<aside class="@SidebarClass">
    <div class="flex h-full flex-col bg-white border-r border-slate-200 overflow-x-hidden">

        @* Brand *@
        <div class="flex h-20 items-center px-6 border-b border-slate-100 @(_isCollapsed ? "justify-center px-0" : "")">
            <div class="flex items-center gap-3.5">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-900 text-white shadow-md shadow-slate-200 ring-2 ring-white">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </span>
                <div class="@(_isCollapsed ? "hidden" : "block") whitespace-nowrap">
                    <div class="font-bold text-slate-900 tracking-tight leading-none text-lg">Primafit</div>
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Enterprise</div>
                </div>
            </div>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto overflow-x-hidden px-4 py-6 scrollbar-thin scrollbar-thumb-slate-200">

            <div class="mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-slate-400 @(_isCollapsed ? "hidden" : "block")">Overview</div>

            <NavLink href="/" Match="NavLinkMatch.All" class="@NavBase" activeClass="@NavActive" title="Dashboard">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
                <span class="flex-1 font-medium whitespace-nowrap @(_isCollapsed ? "hidden" : "block")">Dashboard</span>
            </NavLink>

            <div class="mt-6 mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-slate-400 @(_isCollapsed ? "hidden" : "block")">Core Modules</div>

            @* 1. FINANCE & GL *@
            <PermissionGate Key="GL_PAGE">
                 
                    <div class="space-y-1">
                        <button @onclick="ToggleFinanceMenu" class="@NavBase w-full justify-between" title="Finance & GL">
                            <div class="flex items-center gap-3">
                                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span class="flex-1 text-left font-medium whitespace-nowrap @(_isCollapsed ? "hidden" : "block")">Finance & GL</span>
                            </div>
                            <svg class="h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform duration-300 @(_isCollapsed ? "hidden" : "block") @(_financeMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                        </button>
                        @if (_financeMenuOpen && !_isCollapsed)
                        {
                            <div class="relative pl-5 animate-in slide-in-from-left-2 duration-300">
                                <div class="absolute left-[26px] top-0 bottom-2 w-px bg-slate-200"></div>
                                <div class="space-y-1 pt-1">
                                    <PermissionGate Key="GL_SEGMENT_SETUP_PAGE">
                                         
                                            <button @onclick="ToggleFinanceSetup" class="@SubNavFolderBase">
                                                <span>Setup</span>
                                                <svg class="h-3 w-3 text-slate-400 @(_financeSetupOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                            </button>
                                            @if (_financeSetupOpen)
                                            {
                                                <div class="space-y-0.5 mb-2">
                                                    <NavLink href="/seg-account-types" class="@NestedNavLink" activeClass="@NestedNavActive">Account Types</NavLink>
                                                    <NavLink href="/finance/segments-setup" class="@NestedNavLink" activeClass="@NestedNavActive">Segments</NavLink>
                                                    <NavLink href="/finance/segmented-coa" class="@NestedNavLink" activeClass="@NestedNavActive">Chart of Accounts</NavLink>
                                                </div>
                                            }
                                         
                                    </PermissionGate>

                                    @* Transaction Folder (Clerk has GL_JOURNAL_CREATE, so we leave this open, or gate specific links inside it) *@
                                    <button @onclick="ToggleFinanceTrans" class="@SubNavFolderBase">
                                        <span>Transaction</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_financeTransOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_financeTransOpen)
                                    {
                                        <div class="space-y-0.5 mb-2">
                                            <NavLink href="gl/journal-entry" class="@NestedNavLink" activeClass="@NestedNavActive">Journal Entry</NavLink>
                                            <NavLink href="gl/cashbook" class="@NestedNavLink" activeClass="@NestedNavActive">CashBook Batches</NavLink>
                                            <NavLink href="gl/adjustments" class="@NestedNavLink" activeClass="@NestedNavActive">Adjustment</NavLink>
                    
                                            @* Further restrict highly sensitive links inside the open folder *@
                                            <PermissionGate Key="RECON_START">
                                                 
                                                    <NavLink href="gl/bank-reconciliation" class="@NestedNavLink" activeClass="@NestedNavActive">Reconciliation</NavLink>
                                                 
                                            </PermissionGate>
                    
                                            <NavLink href="finance/budget" class="@NestedNavLink" activeClass="@NestedNavActive">Budgets</NavLink>
                                        </div>
                                    }

                                    <PermissionGate Key="FINANCE_REPORTS_PAGE">
                                         
                                            <button @onclick="ToggleFinanceReport" class="@SubNavFolderBase">
                                                <span>Report</span>
                                                <svg class="h-3 w-3 text-slate-400 @(_financeReportOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                                </svg>
                                            </button>

                                            @if (_financeReportOpen)
                                            {
                                                <div class="space-y-0.5 mb-2">
                                                    <NavLink href="reports/general-ledger" class="@NestedNavLink" activeClass="@NestedNavActive">Ledger Report</NavLink>
                                                    <NavLink href="reports/trial-balance" class="@NestedNavLink" activeClass="@NestedNavActive">Trial Balance</NavLink>
                                                    <NavLink href="reports/profit-and-loss" class="@NestedNavLink" activeClass="@NestedNavActive">Profit & Loss</NavLink>
                                                    <NavLink href="reports/balance-sheet" class="@NestedNavLink" activeClass="@NestedNavActive">Balance Sheet</NavLink>
                                                    <NavLink href="gl/batches" class="@NestedNavLink" activeClass="@NestedNavActive">Batches</NavLink>
                                                    <NavLink href="/reports/cashbook" class="@NestedNavLink" activeClass="@NestedNavActive">Cashbook Report</NavLink>
                                                    <NavLink href="reports/budget-variance" class="@NestedNavLink" activeClass="@NestedNavActive">Budget Variance</NavLink>
                                                </div>
                                            }
                                         
                                    </PermissionGate>
                                </div>
                            </div>
                        }
                    </div>
                 
            </PermissionGate>

            @* 2. AR & SALES *@
            <PermissionGate Key="SALES_ORDER_PAGE">
                 
                    <div class="space-y-1">
                        <button @onclick="ToggleSalesMenu" class="@NavBase w-full justify-between" title="AR & Sales">
                            <div class="flex items-center gap-3">
                                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                </svg>
                                <span class="flex-1 text-left font-medium whitespace-nowrap @(_isCollapsed ? "hidden" : "block")">AR & Sales</span>
                            </div>
                            <svg class="h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform duration-300 @(_isCollapsed ? "hidden" : "block") @(_salesMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                        </button>
                        @if (_salesMenuOpen && !_isCollapsed)
                        {
                            <div class="relative pl-5 animate-in slide-in-from-left-2 duration-300">
                                <div class="absolute left-[26px] top-0 bottom-2 w-px bg-slate-200"></div>
                                <div class="space-y-1 pt-1">

                                    <button @onclick="ToggleSalesSetup" class="@SubNavFolderBase">
                                        <span>Setup</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_salesSetupOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_salesSetupOpen)
                                    {
                                        <div class="space-y-0.5 mb-2">
                                            <NavLink href="md/customer-groups" class="@NestedNavLink" activeClass="@NestedNavActive">Customer Groups</NavLink>
                                            <NavLink href="md/customers" class="@NestedNavLink" activeClass="@NestedNavActive">Customer Setup</NavLink>
                                        </div>
                                    }

                                    <button @onclick="ToggleSalesTrans" class="@SubNavFolderBase">
                                        <span>Transaction</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_salesTransOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_salesTransOpen)
                                    {
                                        <div class="space-y-0.5 mb-2">
                                            <NavLink href="sc/sales-orders" class="@NestedNavLink" activeClass="@NestedNavActive">Sales Orders</NavLink>
                                            <NavLink href="/ar/direct-invoices" class="@NestedNavLink" activeClass="@NestedNavActive">Direct Invoice</NavLink>
                                            <NavLink href="/finance/ar-adjustments" class="@NestedNavLink" activeClass="@NestedNavActive">Ar Adjustment</NavLink>
                                            <NavLink href="ar/payment-entry" class="@NestedNavLink" activeClass="@NestedNavActive">Customer Receipt</NavLink>
                                            <NavLink href="sales/credit-notes" class="@NestedNavLink" activeClass="@NestedNavActive">Credit Notes</NavLink>
                                            <NavLink href="sales/credit-notes/refund" class="@NestedNavLink" activeClass="@NestedNavActive">Receipt Refund</NavLink>
                                            <NavLink href="wh/shipments" class="@NestedNavLink" activeClass="@NestedNavActive">Shipments</NavLink>
                                        </div>
                                    }

                                    <button @onclick="ToggleSalesReport" class="@SubNavFolderBase">
                                        <span>Report</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_salesReportOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_salesReportOpen)
                                    {
                                        <PermissionGate Key="SALES_REPORTS_PAGE">
                                             
                                                <div class="space-y-0.5 mb-2">
                                                    <NavLink href="reports/customer-transactions" class="@NestedNavLink" activeClass="@NestedNavActive">Customer's Transactions</NavLink>
                                                    <NavLink href="reports/ar-age-analysis" class="@NestedNavLink" activeClass="@NestedNavActive">Age Analysis</NavLink>
                                                    <NavLink href="reports/sales-analysis" class="@NestedNavLink" activeClass="@NestedNavActive">Sales Analysis</NavLink>
                                                    <NavLink href="reports/customer-statement" class="@NestedNavLink" activeClass="@NestedNavActive">Customer Statement</NavLink>
                                                </div>
                                             
                                        </PermissionGate>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                 
            </PermissionGate>

            @* 3. AP & PURCHASING *@
            <PermissionGate Key="PURCHASING_PAGE">
                 
                    <div class="space-y-1">
                        <button @onclick="TogglePurchasingMenu" class="@NavBase w-full justify-between" title="AP & Purchasing">
                            <div class="flex items-center gap-3">
                                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                </svg>
                                <span class="flex-1 text-left font-medium whitespace-nowrap @(_isCollapsed ? "hidden" : "block")">AP & Purchasing</span>
                            </div>
                            <svg class="h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform duration-300 @(_isCollapsed ? "hidden" : "block") @(_purchasingMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                        </button>
                        @if (_purchasingMenuOpen && !_isCollapsed)
                        {
                            <div class="relative pl-5 animate-in slide-in-from-left-2 duration-300">
                                <div class="absolute left-[26px] top-0 bottom-2 w-px bg-slate-200"></div>
                                <div class="space-y-1 pt-1">

                                    <button @onclick="TogglePurchasingSetup" class="@SubNavFolderBase">
                                        <span>Setup</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_purchasingSetupOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_purchasingSetupOpen)
                                    {
                                        <div class="space-y-0.5 mb-2">
                                            <NavLink href="md/vendor-groups" class="@NestedNavLink" activeClass="@NestedNavActive">Vendor Groups</NavLink>
                                            <NavLink href="md/vendors" class="@NestedNavLink" activeClass="@NestedNavActive">Vendor Setup</NavLink>
                                        </div>
                                    }

                                    <button @onclick="TogglePurchasingTrans" class="@SubNavFolderBase">
                                        <span>Transaction</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_purchasingTransOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_purchasingTransOpen)
                                    {
                                        <div class="space-y-0.5 mb-2">
                                            <NavLink href="procurement/purchase-orders" class="@NestedNavLink" activeClass="@NestedNavActive">Purchase Orders</NavLink>
                                            <NavLink href="/finance/ap-adjustments" class="@NestedNavLink" activeClass="@NestedNavActive">Ap Adjustment</NavLink>
                                            <NavLink href="/ap/direct-bills" class="@NestedNavLink" activeClass="@NestedNavActive">Direct Invoice</NavLink>
                                            <NavLink href="ap/bill-entry" class="@NestedNavLink" activeClass="@NestedNavActive">Vendor Bills</NavLink>
                                            <NavLink href="purchases/returns" class="@NestedNavLink" activeClass="@NestedNavActive">Returns to Vendor</NavLink>
                                        </div>
                                    }

                                    <button @onclick="TogglePurchasingReport" class="@SubNavFolderBase">
                                        <span>Report</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_purchasingReportOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_purchasingReportOpen)
                                    {
                                        <PermissionGate Key="PURCHASING_REPORTS_PAGE">
                                             
                                                <div class="space-y-0.5 mb-2">
                                                    <NavLink href="/reports/discount-received-summary" class="@NestedNavLink" activeClass="@NestedNavActive">Discount Received Summary</NavLink>
                                                    <NavLink href="/reports/partially-received" class="@NestedNavLink" activeClass="@NestedNavActive">Partially Received Items</NavLink>
                                                    <NavLink href="/reports/po-aging" class="@NestedNavLink" activeClass="@NestedNavActive">Aging Report</NavLink>
                                                    <NavLink href="/reports/purchase-spend-by-vendor" class="@NestedNavLink" activeClass="@NestedNavActive">Purchase By Vendor</NavLink>
                                                    <NavLink href="reports/vendor-statement" class="@NestedNavLink" activeClass="@NestedNavActive">Vendor Statement</NavLink>
                                                    <NavLink href="/reports/vendor-payment-history" class="@NestedNavLink" activeClass="@NestedNavActive">Vendor Payment History</NavLink>
                                                </div>
                                             
                                        </PermissionGate>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                 
            </PermissionGate>

            @* 4. INVENTORY & STOCK *@
            <PermissionGate Key="INVENTORY_SETUP_PAGE">
                 
                    <div class="space-y-1">
                        <button @onclick="ToggleInventoryMenu" class="@NavBase w-full justify-between" title="Inventory & Stock">
                            <div class="flex items-center gap-3">
                                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                                <span class="flex-1 text-left font-medium whitespace-nowrap @(_isCollapsed ? "hidden" : "block")">Inventory & Stock</span>
                            </div>
                            <svg class="h-3.5 w-3.5 shrink-0 text-slate-400 transition-transform duration-300 @(_isCollapsed ? "hidden" : "block") @(_inventoryMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                        </button>
                        @if (_inventoryMenuOpen && !_isCollapsed)
                        {
                            <div class="relative pl-5 animate-in slide-in-from-left-2 duration-300">
                                <div class="absolute left-[26px] top-0 bottom-2 w-px bg-slate-200"></div>
                                <div class="space-y-1 pt-1">

                                    <button @onclick="ToggleInventorySetup" class="@SubNavFolderBase">
                                        <span>Setup</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_inventorySetupOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_inventorySetupOpen)
                                    {
                                        <div class="space-y-0.5 mb-2">
                                            <NavLink href="sc/items" class="@NestedNavLink" activeClass="@NestedNavActive">Items & Services</NavLink>
                                            <NavLink href="/sc/item-categories" class="@NestedNavLink" activeClass="@NestedNavActive">Item Category</NavLink>
                                            <NavLink href="sc/uom" class="@NestedNavLink" activeClass="@NestedNavActive">Units of Measure</NavLink>
                                            <NavLink href="warehouses" class="@NestedNavLink" activeClass="@NestedNavActive">Warehouses</NavLink>
                                        </div>
                                    }

                                    <button @onclick="ToggleInventoryTrans" class="@SubNavFolderBase">
                                        <span>Transaction</span>
                                        <svg class="h-3 w-3 text-slate-400 @(_inventoryTransOpen ? "rotate-90" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                    </button>
                                    @if (_inventoryTransOpen)
                                    {
                                        <div class="space-y-0.5 mb-2">
                                            <NavLink href="/inventory/adjustments" class="@NestedNavLink" activeClass="@NestedNavActive">Inventory Adjustment</NavLink>
                                            <NavLink href="sc/stock-entry" class="@NestedNavLink" activeClass="@NestedNavActive">Stock Entry & Adj.</NavLink>
                                            <NavLink href="sc/transfers" class="@NestedNavLink" activeClass="@NestedNavActive">Stock Transfer</NavLink>
