                                    <NavLink href="hr/settings" class="@NestedNavLink" activeClass="@NestedNavActive">Payroll Configuration</NavLink>
                                </div>
                            }

                            <button @onclick="() => _hrTransOpen = !_hrTransOpen" class="@SubNavFolderBase">
