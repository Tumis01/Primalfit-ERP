@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

@* --- MOBILE OVERLAY --- *@
<div class="@(_sidebarOpen ? "fixed inset-0 z-40 bg-slate-900/30 backdrop-blur-sm lg:hidden transition-opacity duration-300" : "hidden")"
     @onclick="CloseSidebar"></div>

@* --- TOP HEADER  *@
<header class="fixed top-0 left-0 right-0 z-30 flex h-20 items-center backdrop-blur-xl transition-all duration-300 lg:left-[280px]">
    <div class="flex h-full w-full items-center gap-4 px-4 lg:px-8 mt-1">

        <button type="button"
                class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-[#5EA9D3] hover:text-[#004E7A] transition-all"
                @onclick="ToggleSidebar">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

        <a href="/" class="flex flex-col align-items-start">
            <span class="text-[25px] lg:text-[40px] font-bold tracking-tight">Hello, Welcome</span>
            <span class="text-xs text-slate-400">PrimaFit ERP</span>
        </a>

        <div class="flex-1"></div>

        @* <div class="hidden w-96 lg:block">
            <div class="relative group">
                <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-slate-400 group-focus-within:text-indigo-500 transition-colors">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input class="h-10 w-full rounded-full border-0 bg-slate-50/80 py-2 pl-11 pr-4 text-sm text-slate-700 placeholder-slate-400 ring-1 ring-inset ring-slate-200 focus:bg-white focus:ring-2 focus:ring-inset focus:ring-indigo-500 transition-all shadow-sm"
                       placeholder="Search invoices, customers, or reports..." />
            </div>
        </div> *@

        <AuthorizeView>
            <Authorized>
                <div class="flex items-center gap-3 pl-4 lg:border-l lg:border-indigo-50">
                    <div class="group flex items-center gap-3 rounded-full bg-white/50 border border-transparent hover:border-indigo-100 py-1 pl-1 pr-3 transition-all cursor-pointer">
                        <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-100 to-violet-100 flex items-center justify-center text-indigo-700 font-bold text-xs ring-2 ring-white shadow-sm">
                            @context.User.Identity?.Name?.Substring(0, 1).ToUpper()
                        </div>
                        <div class="text-left hidden sm:block">
                            <p class="text-xs font-semibold text-slate-700 group-hover:text-indigo-700 transition-colors">@context.User.Identity?.Name</p>
                            <p class="text-[10px] text-slate-400 font-medium">Online</p>
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@* --- SIDEBAR (Premium Depth) --- *@

<aside class="@SidebarClass">
    <div class="flex h-full flex-col bg-[#004E7A] text-white relative">
        <nav class="flex-1 overflow-y-auto px-4 py-4 scrollbar-thin scrollbar-thumb-indigo-50">

            <NavLink href="/" Match="NavLinkMatch.All" class="@($"{NavBase} mt-4 mb-4")" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
                <span class="flex-1 font-medium">Dashboard</span>
            </NavLink>

            <div class="mt-8 mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-white">Operations</div>

            <div class="space-y-1">
                <button @onclick="ToggleFinanceMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">General Ledger</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_financeMenuOpen ? "rotate-90 text-indigo-500" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>

                @if (_financeMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-indigo-100"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="gl/account-types" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Account Type
                            </NavLink>
                            <NavLink href="gl/main-accounts" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Main Account
                            </NavLink>
                            <NavLink href="gl/chart-of-accounts" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Chart Of Accounts
                            </NavLink>

                        </div>
                    </div>
                }
            </div>



            <div class="mt-8 mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-white">Configuration</div>

            <div class="space-y-1">
                <button @onclick="ToggleSetupMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">System Setup</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-white transition-transform duration-300 @(_setupMenuOpen ? "rotate-90 text-indigo-500" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>

                @if (_setupMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-indigo-100"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="companies" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Company Details
                            </NavLink>
                            <NavLink href="users" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                User Management
                            </NavLink>
                            <NavLink href="roles" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Roles Management
                            </NavLink>
                            @* <NavLink href="projects" class="@SubNavBase" activeClass="@SubNavActive">
                                    <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                    Projects
                                </NavLink> *@
                            <NavLink href="tax-setup" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Tax Management
                            </NavLink>
                            <NavLink href="accounting-periods" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Accounting Periods
                            </NavLink>
                            <NavLink href="currency-setup" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current transition-colors"></span>
                                Currency Management
                            </NavLink>

                        </div>
                    </div>
                }
            </div>

            <NavLink href="/settings" class="@($"{NavBase} mt-6")" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                </svg>
                <span class="flex-1 font-medium">Settings</span>
            </NavLink>

        </nav>

        <div class=" p-4 bg-[#004E7A]">
            <AuthorizeView>
                <Authorized>
                    <form action="api/auth/logout" method="post">
                        <button type="submit" class="group flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-white hover:bg-red-50 hover:text-red-600 transition-all">
                            <svg class="h-5 w-5 text-white group-hover:text-red-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Sign Out
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

    </div>

</aside>

@code {
    public bool _sidebarOpen;
    private bool _financeMenuOpen;
    private bool _setupMenuOpen;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;
    private void ToggleFinanceMenu() => _financeMenuOpen = !_financeMenuOpen;
    private void ToggleSetupMenu() => _setupMenuOpen = !_setupMenuOpen;

    // --- PREMIUM LAYOUT UTILS ---

    // Sidebar: High-quality shadow + smooth transitions
    private string SidebarClass =>
        _sidebarOpen
            ? "fixed inset-y-0 left-0 z-40 w-[280px] bg-white shadow-[4px_0_24px_-12px_rgba(0,0,0,0.1)] mt-2 mb-2 mr-2 ml-2 rounded-lg overflow-hidden transition-transform duration-300 ease-out"
            : "fixed inset-y-0 left-0 z-40 w-[280px] bg-white shadow-none mt-2 mb-2 mr-2 ml-1 rounded-lg overflow-hidden -translate-x-[400px] transition-transform duration-300 ease-out";

    // Nav Item Base: Subtle hover effects with slate colors
    private const string NavBase = "group relative flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-white-500 hover:bg-white hover:text-[#5EA9D3] transition-all cursor-pointer";

    // Active State: Vivid Gradient + Colored Shadow (Glow Effect)
    private const string NavActive = "group relative flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-[#5EA9D3] bg-white transition-all cursor-pointer";

    // Icon: Default slate, white on active
    private const string IconBase = "h-5 w-5 group-hover:opacity-100 transition-opacity";

    // Sub-Nav: Cleaner, with a tree-like structure indent
    private const string SubNavBase = "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-white hover:text-[#5EA9D3] hover:bg-white transition-all ml-3.5";

    // Sub-Nav Active: Distinct indigo text
    private const string SubNavActive = "!text-[#5EA9D3] bg-white font-semibold";
}
