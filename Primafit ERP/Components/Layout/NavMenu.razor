@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

@* --- MOBILE OVERLAY --- *@
<div class="@(_sidebarOpen ? "fixed inset-0 z-40 bg-slate-900/30 backdrop-blur-sm lg:hidden transition-opacity duration-300" : "hidden")"
     @onclick="CloseSidebar"></div>

@* --- TOP HEADER --- *@
<header class="fixed top-0 left-0 right-0 z-30 flex h-16 items-center border-b border-slate-200/80 bg-white/90 backdrop-blur-xl transition-all duration-300 lg:left-[280px] shadow-sm">
    <div class="flex h-full w-full items-center gap-4 px-4 lg:px-8">

        <button type="button"
                class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all lg:hidden"
                @onclick="ToggleSidebar">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

        <a href="/" class="flex items-center gap-2 lg:hidden">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-slate-900 text-white shadow-sm">
                <span class="text-sm font-bold">P</span>
            </span>
            <span class="text-lg font-bold text-slate-900 tracking-tight">Primafit</span>
        </a>

        <div class="flex-1"></div>

        <div class="flex items-center gap-3 pl-4 lg:border-l lg:border-slate-200/70">
            <div class="group flex items-center gap-3 rounded-full bg-white border border-slate-200/70 py-1 pl-1 pr-3 transition-all cursor-pointer hover:bg-slate-50 hover:border-slate-300/80">
                <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-800 font-bold text-xs ring-2 ring-white shadow-sm">
                    @userInitial
                </div>
                <div class="text-left hidden sm:block">
                    <p class="text-xs font-semibold text-slate-800">@userName</p>
                    <p class="text-[10px] text-emerald-600 font-medium flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Online
                    </p>
                </div>
            </div>
        </div>

    </div>
</header>

@* --- SIDEBAR --- *@
<aside class="@SidebarClass">
    <div class="flex h-full flex-col bg-white border-r border-slate-200">

        @* Brand *@
        <div class="flex h-20 items-center px-6 border-b border-slate-100">
            <div class="flex items-center gap-3.5">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-slate-900 text-white shadow-md shadow-slate-200 ring-2 ring-white">
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </span>
                <div>
                    <div class="font-bold text-slate-900 tracking-tight leading-none text-lg">Primafit</div>
                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Enterprise</div>
                </div>
            </div>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto px-4 py-6 scrollbar-thin scrollbar-thumb-slate-200">

            <div class="mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-slate-400">Overview</div>

            <NavLink href="/" Match="NavLinkMatch.All" class="@NavBase" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                </svg>
                <span class="flex-1 font-medium">Dashboard</span>
            </NavLink>

            <div class="mt-6 mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-slate-400">Core Modules</div>

            @* 1. GENERAL LEDGER (Excluding Assets & Budget) *@
            <div class="space-y-1">
                <button @onclick="ToggleFinanceMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">Finance & GL</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_financeMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_financeMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="/seg-account-types" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Account Types
                            </NavLink>
                            <NavLink href="/finance/segments-setup" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Segments
                            </NavLink>
                            <NavLink href="/finance/segmented-coa" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Chart of Accounts
                            </NavLink>
                            <NavLink href="gl/journal-entry" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Journal Entry
                            </NavLink>
                            <NavLink href="gl/batches" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Batches
                            </NavLink>
                            <NavLink href="gl/cashbook" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> CashBook Batches
                            </NavLink>
                            
                        </div>
                    </div>
                }
            </div>

            @* 2. SALES & RECEIVABLES *@
            <div class="space-y-1">
                <button @onclick="ToggleSalesMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">Sales & Invoicing</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_salesMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_salesMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="sc/sales-orders" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Sales Orders
                            </NavLink>
                            <NavLink href="ar/payment-entry" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Customer Receipt
                            </NavLink>
                            @* --- NEW: CREDIT NOTES --- *@
                            <NavLink href="sales/credit-notes" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Credit Notes
                            </NavLink>
                        </div>
                    </div>
                }
            </div>

            @* 3. PURCHASING & PAYABLES *@
            <div class="space-y-1">
                <button @onclick="TogglePurchasingMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">Purchasing & AP</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_purchasingMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_purchasingMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="procurement/purchase-orders" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Purchase Orders
                            </NavLink>
                            <NavLink href="ap/bill-entry" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Vendor Bills
                            </NavLink>
                            <NavLink href="purchases/returns" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Returns to Vendor
                            </NavLink>
                        </div>
                    </div>
                }
            </div>

            @* 4. INVENTORY & STOCK *@
            <div class="space-y-1">
                <button @onclick="ToggleInventoryMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                        <span class="flex-1 text-left font-medium">Inventory & Stock</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_inventoryMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_inventoryMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="sc/stock-list" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Stock List
                            </NavLink>
                            <NavLink href="sc/stock-entry" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Stock Entry
                            </NavLink>
                            <NavLink href="sc/transfers" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Stock Transfer
                            </NavLink>
                            <NavLink href="supply-chain/issue-to-project" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Issue to Project
                            </NavLink>
                        </div>
                    </div>
                }
            </div>

            @* 5. MASTER DATA (Standalone Category) *@
            <div class="space-y-4 py-4">

                <div>
                    <div class="px-4 text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">
                        Master Data
                    </div>

                    <div class="space-y-1 px-2">
            
                        <div>
                            <button @onclick="() => showCustomers = !showCustomers"
                                    class="flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                                <div class="flex items-center gap-3">
                                    <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                                    </svg>
                                    <span>Customers</span>
                                </div>
                                <svg class="h-4 w-4 text-slate-400 transition-transform duration-200 @(showCustomers ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            @if (showCustomers)
                            {
                                <div class="mt-1 ml-10 space-y-1 border-l-2 border-slate-100 pl-2 animate-in slide-in-from-top-1 fade-in duration-200">
                                    <NavLink class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                                             href="md/customers" Match="NavLinkMatch.All">
                                        Customer Setup
                                    </NavLink>
                                    <NavLink class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                                             href="md/customer-groups" Match="NavLinkMatch.All">
                                        Customer Groups
                                    </NavLink>
                                </div>
                            }
                        </div>

                        <div>
                            <button @onclick="() => showVendors = !showVendors"
                                    class="flex w-full items-center justify-between rounded-xl px-3 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all">
                                <div class="flex items-center gap-3">
                                    <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                    <span>Vendors</span>
                                </div>
                                <svg class="h-4 w-4 text-slate-400 transition-transform duration-200 @(showVendors ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>

                            @if (showVendors)
                            {
                                <div class="mt-1 ml-10 space-y-1 border-l-2 border-slate-100 pl-2 animate-in slide-in-from-top-1 fade-in duration-200">
                                    <NavLink class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                                             href="md/vendors" Match="NavLinkMatch.All">
                                        Vendor Setup
                                    </NavLink>
                                    <NavLink class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-500 hover:bg-indigo-50 hover:text-indigo-600 transition-colors"
                                             href="md/vendor-groups" Match="NavLinkMatch.All">
                                        Vendor Groups
                                    </NavLink>
                                </div>
                            }
                        </div>

                        <NavLink class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-all"
                                 href="sc/items">
                            <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                            </svg>
                            <span>Items & Services</span>
                        </NavLink>

                    </div>
                </div>
            </div>

            <div class="mt-6 mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-slate-400">Specialized</div>

            @* 6. PROJECTS *@
            <NavLink href="/projects" class="@NavBase" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                </svg>
                <span class="flex-1 font-medium">Projects</span>
            </NavLink>

            @* 7. FIXED ASSETS *@
            <NavLink href="assets/register" class="@NavBase" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2" />
                </svg>
                <span class="flex-1 font-medium">Fixed Assets</span>
            </NavLink>

            @* 8. BUDGET *@
            <NavLink href="finance/budget" class="@NavBase" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
                </svg>
                <span class="flex-1 font-medium">Budget</span>
            </NavLink>

            <div class="mt-6 mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-slate-400">Tools</div>

            @* 9. RECONCILIATION *@
            <NavLink href="gl/bank-reconciliation" class="@NavBase" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="flex-1 font-medium">Reconciliation</span>
            </NavLink>

            @* 10. REPORTS *@
            <div class="space-y-1">
                <button @onclick="ToggleReportMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">Financial Reports</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_reportMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_reportMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="gl/general-ledger" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Ledger Report
                            </NavLink>
                        </div>
                    </div>
                }
            </div>

            @* 11. CONFIGURATION *@
            <div class="space-y-1">
                <button @onclick="ToggleSetupMenu" class="@NavBase w-full justify-between">
                    <div class="flex items-center gap-3">
                        <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                        </svg>
                        <span class="flex-1 text-left font-medium">System Setup</span>
                    </div>
                    <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-300 @(_setupMenuOpen ? "rotate-90 text-slate-800" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
                @if (_setupMenuOpen)
                {
                    <div class="relative pl-4 animate-in slide-in-from-left-2 duration-300">
                        <div class="absolute left-[22px] top-0 bottom-2 w-px bg-slate-200"></div>
                        <div class="space-y-1 pt-1">
                            <NavLink href="companies" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Companies
                            </NavLink>
                            <NavLink href="users" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Users
                            </NavLink>
                            <NavLink href="roles" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Roles
                            </NavLink>
                            <NavLink href="tax-setup" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Tax Setup
                            </NavLink>
                            <NavLink href="accounting-periods" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Fiscal Periods
                            </NavLink>
                            <NavLink href="currency-setup" class="@SubNavBase" activeClass="@SubNavActive">
                                <span class="w-1.5 h-1.5 rounded-full bg-current"></span> Currency
                            </NavLink>
                        </div>
                    </div>
                }
            </div>

            <NavLink href="/settings" class="@NavBase" activeClass="@NavActive">
                <svg class="@IconBase" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                </svg>
                <span class="flex-1 font-medium">Settings</span>
            </NavLink>

        </nav>

        <div class="border-t border-slate-100 p-4 bg-white">
            <a href="/auth/logout" class="group flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-rose-50 hover:text-rose-600 transition-all">
                <svg class="h-5 w-5 text-slate-400 group-hover:text-rose-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
                Sign Out
            </a>
        </div>

    </div>
</aside>

@code {
    private bool _sidebarOpen;
    private bool _financeMenuOpen;
    private bool _salesMenuOpen;
    private bool _purchasingMenuOpen;
    private bool _inventoryMenuOpen;
    private bool _masterDataMenuOpen;
    private bool _reportMenuOpen;
    private bool _setupMenuOpen;
    private bool showCustomers = false;
    private bool showVendors = false;
    private string userName = "Guest";
    private string userInitial = "G";

    // CSS Classes
    private string SidebarClass => _sidebarOpen
            ? "fixed inset-y-0 left-0 z-40 w-[280px] bg-white shadow-[4px_0_24px_-12px_rgba(0,0,0,0.18)] transition-transform duration-300 ease-out lg:translate-x-0"
            : "fixed inset-y-0 left-0 z-40 w-[280px] bg-white shadow-none -translate-x-full transition-transform duration-300 ease-out lg:translate-x-0";

    private const string NavBase = "group relative flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all cursor-pointer";
    private const string NavActive = "bg-slate-900 text-white shadow-sm hover:text-white";
    private const string IconBase = "h-5 w-5 opacity-70 group-hover:opacity-100 transition-opacity [.active_&]:opacity-100";
    private const string SubNavBase = "flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 transition-all ml-3.5";
    private const string SubNavActive = "text-slate-900 bg-slate-100 font-semibold shadow-sm ring-1 ring-slate-200/50";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            userName = user.Identity.Name ?? "User";
            userInitial = userName.Substring(0, 1).ToUpperInvariant();
        }

        // Auto-open Menus based on current path
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant();

        _reportMenuOpen = path.StartsWith("gl/trial-balance");

        _financeMenuOpen = (path.StartsWith("finance/") || path.StartsWith("gl/") || path.StartsWith("seg-"))
            && !_reportMenuOpen
            && !path.Contains("bank-reconciliation")
            && !path.Contains("budget");

        // Updated logic to include 'sales/' path for Credit Notes
        _salesMenuOpen = path.StartsWith("sc/sales") || path.StartsWith("ar/") || path.StartsWith("sales/");

        _purchasingMenuOpen = path.StartsWith("procurement/") || path.StartsWith("ap/") || path.StartsWith("purchases/");

        _inventoryMenuOpen = (path.StartsWith("sc/") || path.StartsWith("supply-chain/"))
            && !path.Contains("sales") && !path.Contains("items");

        _masterDataMenuOpen = path.StartsWith("md/") || path == "warehouses" || path.Contains("items");

        _setupMenuOpen = path is "companies" or "users" or "roles" or "tax-setup" or "accounting-periods" or "currency-setup";
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;

    private void ToggleFinanceMenu() => _financeMenuOpen = !_financeMenuOpen;
    private void ToggleSalesMenu() => _salesMenuOpen = !_salesMenuOpen;
    private void TogglePurchasingMenu() => _purchasingMenuOpen = !_purchasingMenuOpen;
    private void ToggleInventoryMenu() => _inventoryMenuOpen = !_inventoryMenuOpen;
    private void ToggleMasterDataMenu() => _masterDataMenuOpen = !_masterDataMenuOpen;
    private void ToggleReportMenu() => _reportMenuOpen = !_reportMenuOpen;
    private void ToggleSetupMenu() => _setupMenuOpen = !_setupMenuOpen;
}