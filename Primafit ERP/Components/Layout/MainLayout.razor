@inherits LayoutComponentBase
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using PrimafitERP.Data

@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject CompanyApiService ApiService

<div class="min-h-screen bg-slate-50 text-slate-900">

    @* Pass the event handler down to the NavMenu *@
    <NavMenu OnCollapseToggled="HandleSidebarCollapse" />
    
    @* Dynamically switch padding based on the sidebar's state *@
    <main class="px-4 py-6 pt-20 lg:px-8 transition-all duration-300 @(isSidebarCollapsed ? "lg:pl-[80px]" : "lg:pl-[280px]")">
        @Body
    </main>

</div>

@code {
    private bool needsCompanySetup = false;
    private bool isSidebarCollapsed = false; // State to track the sidebar

    // This method is triggered by the NavMenu whenever it shrinks or expands
    private void HandleSidebarCollapse(bool collapsedState)
    {
        isSidebarCollapsed = collapsedState;
        StateHasChanged(); // Force the layout to redraw the padding
    }

