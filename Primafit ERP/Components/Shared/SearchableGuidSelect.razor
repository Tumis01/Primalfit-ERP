@using Microsoft.AspNetCore.Components.Web
<div class="relative min-w-0">
    @if (!string.IsNullOrWhiteSpace(Label)) { <label for="@inputId" class="block text-[10px] font-extrabold uppercase tracking-wider text-slate-500 mb-1.5">@Label @if (Required) { <span class="text-rose-600">*</span> }</label> }
    <div class="relative">
        <input id="@inputId" type="text" value="@text" @oninput="OnInput" @onfocus="Open" @onblur="CloseAfterBlur" @onkeydown="HandleKey" disabled="@Disabled" placeholder="@Placeholder" autocomplete="off" role="combobox" aria-expanded="@isOpen.ToString().ToLowerInvariant()" aria-controls="@listId" aria-autocomplete="list" aria-required="@Required.ToString().ToLowerInvariant()" aria-activedescendant="@ActiveOptionId" aria-label="@(string.IsNullOrWhiteSpace(Label) ? Placeholder : Label)" class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-3 pr-9 text-sm font-semibold text-slate-800 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 disabled:bg-slate-100 disabled:text-slate-500" />
        <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-400"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg></span>
    </div>
    @if (isOpen && !Disabled)
    {
        <div id="@listId" role="listbox" class="@(InlineMenu ? "relative" : "absolute") z-[80] mt-1 max-h-60 w-full overflow-auto rounded-xl border border-slate-200 bg-white shadow-xl">
            @if (Value.HasValue && Options.FirstOrDefault(x => x.Id == Value) is { } current) { <div class="border-b border-slate-100 bg-slate-50 px-4 py-2 text-xs text-slate-600">Current: <span class="font-semibold">@current.Label</span></div> }
            @if (AllowClear && Value.HasValue) { <button type="button" @onmousedown:preventDefault="true" @onclick="Clear" class="block w-full px-4 py-2 text-left text-xs font-semibold text-slate-500 hover:bg-slate-50">@ClearLabel</button> }
            @foreach (var option in Filtered.Take(50))
            {
                var optionIndex = Filtered.Take(50).ToList().FindIndex(x => x.Id == option.Id);
                <button id="@OptionId(option.Id)" type="button" role="option" tabindex="-1" disabled="@option.Disabled" aria-disabled="@option.Disabled.ToString().ToLowerInvariant()" aria-selected="@(Value == option.Id ? "true" : "false")" @onmousedown:preventDefault="true" @onclick="() => Select(option)" class="block w-full border-t border-slate-50 px-4 py-2.5 text-left hover:bg-indigo-50 disabled:opacity-50 disabled:cursor-not-allowed @(optionIndex == highlighted ? "bg-indigo-50" : "")">
                    <span class="block text-sm font-semibold text-slate-800">@option.Label</span>@if (!string.IsNullOrWhiteSpace(option.Detail)) { <span class="block text-xs text-slate-500">@option.Detail</span> }
                </button>
            }
            @if (!Filtered.Any()) { <div class="p-4 text-center text-xs text-slate-500">No matching options.</div> }
            @if (Filtered.Skip(50).Any()) { <div class="px-4 py-2 text-xs text-slate-400">Keep typing to narrow the results.</div> }
        </div>
    }
</div>
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Search and select";
    [Parameter] public IReadOnlyCollection<DropdownOption> Options { get; set; } = Array.Empty<DropdownOption>();
    [Parameter] public Guid? Value { get; set; }
    [Parameter] public EventCallback<Guid?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool InlineMenu { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public string ClearLabel { get; set; } = "Clear selection";
    private readonly string inputId = $"search-{Guid.NewGuid():N}", listId = $"options-{Guid.NewGuid():N}";
    private string text = "", query = "";
    private bool isOpen;
    private int highlighted = -1;
    private IEnumerable<DropdownOption> Filtered => string.IsNullOrWhiteSpace(query) ? Options : Options.Where(x => x.Label.Contains(query, StringComparison.OrdinalIgnoreCase) || (x.Detail?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false));
    private string OptionId(Guid id) => $"{listId}-{id:N}";
    private string? ActiveOptionId => isOpen && highlighted >= 0 ? Filtered.Take(50).Skip(highlighted).Select(x => OptionId(x.Id)).FirstOrDefault() : null;
    protected override void OnParametersSet() { if (!isOpen) text = Options.FirstOrDefault(x => x.Id == Value)?.Label ?? ""; }
    private void Open() { if (Disabled) return; isOpen = true; text = ""; query = ""; highlighted = -1; }
    private void OnInput(ChangeEventArgs e) { text = e.Value?.ToString() ?? ""; query = text; isOpen = true; highlighted = -1; }
    private async Task Select(DropdownOption option) { if (Disabled || option.Disabled) return; isOpen = false; query = ""; text = option.Label; await ValueChanged.InvokeAsync(option.Id); }
    private async Task Clear() { isOpen = false; text = query = ""; await ValueChanged.InvokeAsync(null); }
    private async Task CloseAfterBlur() { await Task.Delay(120); isOpen = false; text = Options.FirstOrDefault(x => x.Id == Value)?.Label ?? ""; }
    private async Task HandleKey(KeyboardEventArgs e)
    {
        var choices = Filtered.Take(50).ToList();
        if (e.Key == "Escape") { isOpen = false; text = Options.FirstOrDefault(x => x.Id == Value)?.Label ?? ""; }
        else if (e.Key == "ArrowDown") { isOpen = true; var next = choices.FindIndex(Math.Min(highlighted + 1, choices.Count), x => !x.Disabled); if (next >= 0) highlighted = next; }
        else if (e.Key == "ArrowUp") { var start = highlighted < 0 ? choices.Count - 1 : highlighted - 1; if (start >= 0) { var previous = choices.FindLastIndex(start, x => !x.Disabled); if (previous >= 0) highlighted = previous; } }
        else if (e.Key == "Enter" && isOpen) { var choice = highlighted >= 0 ? choices.ElementAtOrDefault(highlighted) : choices.FirstOrDefault(x => !x.Disabled); if (choice != null) await Select(choice); }
    }
}
