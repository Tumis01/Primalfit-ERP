@using Microsoft.EntityFrameworkCore
@using PrimafitERP.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Components.Pages
@using Primafit_ERP.Services
@inject IDbContextFactory<AppDbContext> DbFactory
<fieldset disabled="@Disabled" class="min-w-0 space-y-5 document-header-fields">
    <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
            @HeaderFields
            <ExchangeRatePicker CompanyId="@CompanyId" CurrencyId="@Terms.CurrencyId" CurrencyCode="@CurrencyCode"
                CompanyBaseCurrency="@baseCurrency" CurrentRate="@Terms.ExchangeRate" CurrentRateChanged="SetRate" Disabled="@Disabled" Searchable="true" />
            <SearchableGuidSelect Label="Tax / VAT" Options="@TaxOptions" Value="@Terms.TaxId" ValueChanged="SetTax" Disabled="@Disabled" Placeholder="Search tax" ClearLabel="No tax" />
            <div><SearchableGuidSelect Label="Withholding Tax" Options="@WithholdingOptions" Value="@Terms.WithholdingTaxId" ValueChanged="SetWithholding" Disabled="@Disabled" Placeholder="Search withholding" ClearLabel="No withholding" /><p class="mt-1 text-[10px] font-medium text-amber-700">Applied when the payment is posted.</p></div>
            @AdditionalFields
        </div>
    </div>
    <div class="rounded-xl border border-rose-100 bg-rose-50/50 p-5 shadow-sm max-w-xl">
        <h4 class="mb-4 text-xs font-extrabold uppercase tracking-wider text-rose-700">Discount</h4>
        <div class="grid grid-cols-2 gap-4">
            <label class="text-[10px] font-extrabold uppercase text-slate-500">Percentage (%)<input type="number" min="0" max="100" step="0.0001" @bind="Terms.DiscountPercentage" @bind:after="PercentageChanged" class="mt-1 w-full rounded-xl border border-rose-200 bg-white p-2.5 text-right text-sm font-bold focus:border-indigo-500 focus:outline-none" /></label>
            <label class="text-[10px] font-extrabold uppercase text-slate-500">Flat amount<input type="number" min="0" step="0.0001" @bind="Terms.DiscountAmount" @bind:after="AmountChanged" class="mt-1 w-full rounded-xl border border-rose-200 bg-white p-2.5 text-right text-sm font-mono focus:border-indigo-500 focus:outline-none" /></label>
        </div>
    </div>
</fieldset>
@code {
    [Parameter, EditorRequired] public DestinationDocumentTerms Terms { get; set; } = new();
    [Parameter] public Guid CompanyId { get; set; }
    [Parameter] public RenderFragment? HeaderFields { get; set; }
    [Parameter] public RenderFragment? AdditionalFields { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnTermsChanged { get; set; }
    private List<Tax> taxes = new();
    private List<WithholdingTax> withholding = new();
    private List<Currency> currencies = new();
    private string baseCurrency = "";
    private Guid loadedCompanyId;
    private string CurrencyCode => currencies.FirstOrDefault(x => x.Id == Terms.CurrencyId)?.CurrencyCode ?? "";
    private IReadOnlyCollection<DropdownOption> TaxOptions => taxes.Select(x => new DropdownOption(x.Id, x.TaxName, $"{x.Per:0.####}%")).ToList();
    private IReadOnlyCollection<DropdownOption> WithholdingOptions => withholding.Select(x => new DropdownOption(x.Id, x.Name, $"{x.PercentageValue:0.####}%")).ToList();
    protected override async Task OnParametersSetAsync()
    {
        if (CompanyId != Guid.Empty && CompanyId != loadedCompanyId) {
            await using var db = await DbFactory.CreateDbContextAsync();
            taxes = await db.Taxes.AsNoTracking().Where(x => x.CompanyId == CompanyId).OrderBy(x => x.TaxName).ToListAsync();
            withholding = await db.WithholdingTaxes.AsNoTracking().Where(x => x.CompanyId == CompanyId).OrderBy(x => x.Name).ToListAsync();
            currencies = await db.Currencies.AsNoTracking().Where(x => x.CompanyId == CompanyId).ToListAsync();
            baseCurrency = await db.CompanyDetails.Where(x => x.CompanyDetailsId == CompanyId).Select(x => x.BaseCurrency).FirstOrDefaultAsync() ?? "";
            loadedCompanyId = CompanyId;
        }
        if (currencies.Any(x => x.Id == Terms.CurrencyId && x.IsBaseCurrency)) Terms.ExchangeRate = 1m;
    }
    private Task Changed() => OnTermsChanged.InvokeAsync();
    private Task SetRate(decimal value) { Terms.ExchangeRate = value; return Changed(); }
    private Task PercentageChanged() { if (Terms.DiscountPercentage > 0) Terms.DiscountAmount = 0; return Changed(); }
    private Task AmountChanged() { if (Terms.DiscountAmount > 0) Terms.DiscountPercentage = 0; return Changed(); }
    private Task SetTax(Guid? id) { Terms.TaxId = id; return Changed(); }
    private Task SetWithholding(Guid? id) { Terms.WithholdingTaxId = id; return Changed(); }
}
