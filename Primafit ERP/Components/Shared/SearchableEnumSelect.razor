@typeparam TEnum where TEnum : struct, Enum

<div class="udf-search-select">
    <label for="@inputId">@Label</label>
    <div class="udf-search-select-input">
        <input id="@inputId" type="text" value="@text" @oninput="Search" @onfocus="Open" @onblur="CloseAfterBlur"
               @onkeydown="HandleKey" disabled="@Disabled" placeholder="@Placeholder" autocomplete="off"
               role="combobox" aria-expanded="@(open ? "true" : "false")" aria-controls="@listId"
               aria-autocomplete="list" aria-activedescendant="@ActiveId" />
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
    </div>
    @if (open && !Disabled)
    {
        <div id="@listId" role="listbox" aria-label="@Label" class="udf-search-select-menu">
            @foreach (var option in Matches)
            {
                <button id="@OptionId(option)" type="button" role="option" tabindex="-1"
                        aria-selected="@(EqualityComparer<TEnum>.Default.Equals(Value, option) ? "true" : "false")"
                        class="@(highlighted.HasValue && EqualityComparer<TEnum>.Default.Equals(highlighted.Value, option) ? "is-highlighted" : "")"
                        @onmousedown:preventDefault="true" @onclick="() => Select(option)">@OptionLabel(option)</button>
            }
            @if (Matches.Count == 0) { <p role="status">No matching locations. Try a record or module name.</p> }
        </div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "Search and select";
    [Parameter] public IReadOnlyCollection<TEnum> Options { get; set; } = Array.Empty<TEnum>();
    [Parameter] public Func<TEnum, string> OptionLabel { get; set; } = value => value.ToString();
    [Parameter] public TEnum Value { get; set; }
    [Parameter] public EventCallback<TEnum> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string inputId = $"enum-search-{Guid.NewGuid():N}", listId = $"enum-options-{Guid.NewGuid():N}";
    private string text = "", query = "";
    private bool open;
    private TEnum? highlighted;
    private List<TEnum> Matches => Options.Where(x => string.IsNullOrWhiteSpace(query) || OptionLabel(x).Contains(query, StringComparison.OrdinalIgnoreCase)).ToList();
    private string OptionId(TEnum option) => $"{listId}-{option}";
    private string? ActiveId => open && highlighted.HasValue ? OptionId(highlighted.Value) : null;
    protected override void OnParametersSet() { if (!open) text = Options.Contains(Value) ? OptionLabel(Value) : ""; }
    private void Open() { if (Disabled) return; open = true; text = query = ""; highlighted = null; }
    private void Search(ChangeEventArgs e) { text = query = e.Value?.ToString() ?? ""; open = true; highlighted = null; }
    private void Close() { open = false; query = ""; highlighted = null; text = Options.Contains(Value) ? OptionLabel(Value) : ""; }
    private async Task CloseAfterBlur() { await Task.Delay(120); Close(); }
    private async Task Select(TEnum option) { if (Disabled || !Options.Contains(option)) return; Close(); text = OptionLabel(option); await ValueChanged.InvokeAsync(option); }
    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (Disabled) return;
        if (e.Key is "Escape" or "Tab") { Close(); return; }
        var matches = Matches;
        var index = highlighted.HasValue ? matches.IndexOf(highlighted.Value) : -1;
        if (e.Key is "ArrowDown" or "ArrowUp") {
            open = true;
            if (matches.Count > 0) highlighted = matches[e.Key == "ArrowDown" ? Math.Min(index + 1, matches.Count - 1) : index <= 0 ? matches.Count - 1 : index - 1];
        }
        else if (e.Key == "Enter" && open && matches.Count > 0) await Select(highlighted ?? matches[0]);
    }
}
