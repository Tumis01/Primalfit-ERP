<div class="ds-pagination">
    <p>Showing <strong>@Start–@End</strong> of <strong>@Total</strong> @Records</p>
    <div class="ds-pagination-controls">
        <label class="ds-page-size">Rows per page<select aria-label="Rows per page" value="@PageSize" @onchange="SizeChanged"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select></label>
        <nav class="ds-page-buttons" aria-label="Results pages">
            <button type="button" class="ds-icon-button" aria-label="Previous page" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)"><DimensionIcon Name="left" /></button>
            <span class="ds-page-position">Page @Page of @PageCount</span>
            <button type="button" class="ds-icon-button" aria-label="Next page" disabled="@(Page >= PageCount)" @onclick="() => PageChanged.InvokeAsync(Page + 1)"><DimensionIcon Name="right" /></button>
        </nav>
    </div>
</div>
@code {
    [Parameter] public int Total { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public string Records { get; set; } = "records";
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    private int PageCount => Math.Max(1, (int)Math.Ceiling(Total / (double)PageSize));
    private int Start => Total == 0 ? 0 : (Page - 1) * PageSize + 1;
    private int End => Math.Min(Page * PageSize, Total);
    private async Task SizeChanged(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var size) && size is 10 or 25 or 50) await PageSizeChanged.InvokeAsync(size); }
}
