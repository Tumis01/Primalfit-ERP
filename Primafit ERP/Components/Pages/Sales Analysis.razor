@page "/reports/sales-analysis"
@using Primafit_ERP.Services
@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Components.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject SalesService SalesService
@inject ReportExportService ExportEngine
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-7xl mx-auto mt-6 space-y-6 font-sans text-slate-800">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Sales Analysis Ledger Report</h1>
            <p class="text-sm text-slate-500 mt-1">Review product and service performance based on baseline gross revenues and absolute transaction quantities.</p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
        <div>
            <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Start Date</label>
            <input type="date" @bind="localStartDate" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-medium outline-none focus:border-indigo-500 bg-white" />
        </div>
        <div>
            <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">End Date</label>
            <input type="date" @bind="localEndDate" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm font-medium outline-none focus:border-indigo-500 bg-white" />
        </div>
        <div>
            <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Search Inventory Item</label>
            <div class="relative rounded-xl shadow-sm">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </div>
                <input type="text" @bind="localSearchTerm" class="w-full pl-9 pr-3 py-2 border border-slate-200 rounded-xl text-sm font-medium outline-none focus:border-indigo-500 bg-white" placeholder="Type Item Name..." />
            </div>
        </div>
        <div class="flex gap-2 h-[42px] items-center">
            <button type="button" @onclick="(() => ProcessDownloadExport(true))" disabled="@(activeReportData == null || isDownloadingPdf)" class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-rose-600 text-xs font-bold rounded-xl hover:bg-rose-50 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed active:scale-95">
                @if (isDownloadingPdf)
                {
                    <svg class="h-3 w-3 animate-spin text-rose-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    <span>PDF...</span>
                }
                else
                {
                    <span>PDF</span>
                }
            </button>

            <button type="button" @onclick="(() => ProcessDownloadExport(false))" disabled="@(activeReportData == null || isDownloadingExcel)" class="flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-200 text-emerald-600 text-xs font-bold rounded-xl hover:bg-emerald-50 transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed active:scale-95">
                @if (isDownloadingExcel)
                {
                    <svg class="h-3 w-3 animate-spin text-emerald-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    <span>Excel...</span>
                }
                else
                {
                    <span>Excel</span>
                }
            </button>
        </div>

        <div>
            <button type="button" @onclick="ExecuteReportPipeline" class="w-full py-2.5 bg-slate-900 text-white text-sm font-bold rounded-xl hover:bg-slate-800 transition-all active:scale-95 flex items-center justify-center gap-2 shadow-sm">
                <span>Run Report</span>
            </button>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col">

        <div class="hidden">
            <ReportViewer CompanyId="companyId" Title="Sales Analysis by Item" Description="" ShowAsOfDate="false" FetchData="GetData" @ref="reportViewerRef" />
        </div>

        @if (activeReportData != null)
        {
            <div class="p-6 bg-slate-50/50 border-b border-slate-200 flex justify-between items-center">
                <div>
                    <h3 class="text-sm font-bold text-slate-800">@activeReportData.ReportName</h3>
                    <p class="text-xs text-slate-400 font-medium mt-0.5">Active Period Frame: @activeReportData.ReportingPeriod</p>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            @foreach (var header in activeReportData.Headers)
                            {
                                <th class="p-4 @(header == "Quantity" || header == "Price" || header == "Amount" ? "text-right" : "")">@header</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                        @foreach (var row in activeReportData.Rows)
                        {
                            if (row[0].StartsWith("SECTION_HEADER:"))
                            {
                                <tr class="bg-slate-100/60 font-black text-slate-900 border-y border-slate-200/80">
                                    <td class="p-3 pl-6 font-bold text-sm text-slate-900" colspan="2">
                                        <span>@row[0].Replace("SECTION_HEADER:", "")</span>
                                    </td>
                                    <td class="p-3 text-center"><span class="px-2 py-0.5 bg-white border border-slate-200 text-slate-600 text-[10px] uppercase rounded font-bold">@row[1]</span></td>
                                    <td class="p-3 text-right font-mono font-bold">@row[3]</td>
                                    <td></td>
                                    <td class="p-3 text-right font-mono font-bold text-slate-900">@row[5]</td>
                                </tr>
                            }
                            else if (row[0] == "SECTION_SPACER")
                            {
                                <tr class="bg-white"><td colspan="6" class="h-2 p-0"></td></tr>
                            }
                            else if (row[0].StartsWith("REPORT_TOTAL:"))
                            {
                                <tr class="bg-white font-bold text-slate-900 border-t-2 border-slate-300">
                                    <td class="p-4 font-bold text-sm uppercase tracking-wider pl-6" colspan="2">@row[0].Replace("REPORT_TOTAL:", "")</td>
                                    <td></td>
                                    <td class="p-4 text-right font-mono text-sm font-bold text-slate-900">@row[3]</td>
                                    <td></td>
                                    <td class="p-4 text-right font-mono text-sm font-bold text-slate-900">@row[5]</td>
                                </tr>
                            }
                            else
                            {
                                <tr class="hover:bg-slate-50/50 transition-colors text-xs text-slate-600">
                                    <td class="p-3 pl-6 font-mono text-slate-500">@row[0]</td>
                                    <td class="p-3 font-semibold text-slate-800">@row[1]</td>
                                    <td class="p-3 text-center text-slate-500">@row[2]</td>
                                    <td class="p-3 text-right font-mono">@row[3]</td>
                                    <td class="p-3 text-right font-mono text-slate-500">@row[4]</td>
                                    <td class="p-3 text-right font-mono text-slate-900">@row[5]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-16 text-center text-slate-400 text-sm font-medium italic bg-slate-50/50">
                Configure report properties parameters above and click "Run Report" to generate data matrix.
            </div>
        }
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
</style>

@code {
    private Guid companyId;
    private string currentUserName = "";
    private ReportViewer? reportViewerRef;
    private StandardReportData? activeReportData;

    private DateOnly localStartDate = DateOnly.FromDateTime(DateTime.Today.AddMonths(-1));
    private DateOnly localEndDate = DateOnly.FromDateTime(DateTime.Today);
    private string localSearchTerm = string.Empty;
    private string committedSearchQuery = string.Empty;

    private bool isDownloadingPdf = false;
    private bool isDownloadingExcel = false;

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SALES_REPORTS_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            companyId = user.CompanyDetailsId.Value;
            currentUserName = user.UserName ?? "ERP User";
        }
    }

    private async Task ExecuteReportPipeline()
    {
        committedSearchQuery = localSearchTerm;

        if (reportViewerRef != null)
        {
            var refreshMethod = reportViewerRef.GetType().GetMethod("RefreshData");
            if (refreshMethod != null)
            {
                refreshMethod.Invoke(reportViewerRef, null);
            }
            else
            {
                activeReportData = await SalesService.GenerateSalesAnalysisReportAsync(companyId, localStartDate, localEndDate, committedSearchQuery);
            }
        }
        StateHasChanged();
    }

    // FIXED: Generates binaries via isolated native libraries and passes down base64 strings cleanly
    private async Task ProcessDownloadExport(bool targetIsPdf)
    {
        if (activeReportData == null) return;

        if (targetIsPdf) isDownloadingPdf = true;
        else isDownloadingExcel = true;
        StateHasChanged();

        try
        {
            await Task.Delay(200); // Visual step thread synchronization buffer

            // Hydrate reporting parameters parameters context metadata
            activeReportData.GeneratedBy = currentUserName;
            activeReportData.DateGenerated = DateTime.Now;
            activeReportData.CompanyName = "Primafit Enterprise Operations";

            byte[] fileBytesArray;
            string generatedFileName;
            string targetMimeType;

            if (targetIsPdf)
            {
                fileBytesArray = ExportEngine.GenerateSalesAnalysisPdf(activeReportData);
                generatedFileName = $"SalesAnalysis_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
                targetMimeType = "application/pdf";
            }
            else
            {
                fileBytesArray = ExportEngine.GenerateSalesAnalysisExcel(activeReportData);
                generatedFileName = $"SalesAnalysis_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
                targetMimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            }

            string cleanBase64String = Convert.ToBase64String(fileBytesArray);

            // Execute file delivery system via your global window download helper interop handler
            await JS.InvokeVoidAsync("window.downloadFile", generatedFileName, cleanBase64String, targetMimeType);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Document compilation terminated by engine: {ex.Message}");
        }
        finally
        {
            isDownloadingPdf = false;
            isDownloadingExcel = false;
            StateHasChanged();
        }
    }

    private async Task<StandardReportData> GetData(DateOnly start, DateOnly end)
    {
        activeReportData = await SalesService.GenerateSalesAnalysisReportAsync(companyId, localStartDate, localEndDate, committedSearchQuery);
        return activeReportData;
    }
}