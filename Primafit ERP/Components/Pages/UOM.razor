@page "/sc/uom"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Text

@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Units of Measure</h1>
            <p class="text-sm text-slate-500 mt-1">Define measurement units and conversion factors for inventory items.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <PermissionGate Key="INVENTORY_SETUP_MANAGE">
                <Authorized>
                    <button @onclick="ExportCsv" class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 text-sm">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        Export CSV
                    </button>

                    <label class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 cursor-pointer mb-0 text-sm">
                        @if (isImporting)
                        {
                            <span class="animate-spin">↻</span>
                            <span>Importing...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                            <span>Import CSV</span>
                        }
                        <InputFile OnChange="ImportCsv" accept=".csv" class="hidden" disabled="@isImporting" />
                    </label>

                    <button @onclick="CreateNew" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        New UoM
                    </button>
                </Authorized>
            </PermissionGate>
        </div>
    </div>

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl mb-6 animate-in slide-in-from-top-4">
            <h3 class="text-lg font-bold text-slate-900 mb-6 border-b border-slate-100 pb-3">
                @(isEditing ? "Edit Unit of Measure" : "Create New Unit of Measure")
            </h3>

            <EditForm Model="@currentUom" OnValidSubmit="SaveUom">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div>
                        <label class="label">UoM Name <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentUom.Name" class="input-class font-bold text-slate-800" placeholder="e.g., Dozen, Box, Tons" />
                        <p class="text-[10px] text-slate-400 mt-1">The primary name of the unit.</p>
                    </div>
                </div>

                <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 mb-6">
                    <div class="flex items-center justify-between mb-3">
                        <div>
                            <h4 class="font-bold text-slate-800">Conversion lines</h4>
                            <p class="text-xs text-slate-500">Define as many conversions as needed. Example: 1 Bag = 50 Kilograms.</p>
                        </div>
                    </div>
                    @if (currentUom.Id != Guid.Empty)
                    {
                        <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr_auto] gap-3 items-end">
                            <div><label class="label">Converts to</label><SearchableUom Units="@uoms.Where(x => x.Id != currentUom.Id).ToList()" @bind-Value="conversionToUomId" /></div>
                            <div><label class="label">Factor</label><InputNumber @bind-Value="conversionFactor" class="input-class font-mono" min="0.0001" /></div>
                            <button type="button" @onclick="SaveConversion" class="rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-bold text-white">@(editingConversionId.HasValue ? "Update" : "Add")</button>
                        </div>
                        @if (conversionRules.Where(x => x.FromUomId == currentUom.Id).Any())
                        {
                            <div class="mt-4 divide-y divide-slate-200 rounded-lg bg-white border border-slate-200">
                                @foreach (var rule in conversionRules.Where(x => x.FromUomId == currentUom.Id))
                                {
                                    <div class="flex items-center justify-between px-3 py-2 text-sm">
                                        <span class="font-medium">1 @currentUom.Name = <b>@rule.ConversionFactor.ToString("N4")</b> @(rule.ToUom?.Name ?? uoms.FirstOrDefault(x => x.Id == rule.ToUomId)?.Name)</span>
                                        <span><button type="button" @onclick="() => EditConversion(rule)" class="text-indigo-600 font-bold mr-3">Edit</button><button type="button" @onclick="() => DeleteConversion(rule)" class="text-rose-600 font-bold">Delete</button></span>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-slate-500">Save the UOM first, then add its conversion lines.</p>
                    }
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" @onclick="() => showForm = false" class="rounded-xl px-6 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancel</button>
                    <button type="submit" disabled="@isBusy" class="rounded-xl bg-indigo-600 px-8 py-2.5 text-sm font-bold text-white shadow-md hover:bg-indigo-700 transition-all flex items-center gap-2 disabled:opacity-50">
                        @if (isBusy)
                        {
                            <span class="animate-spin">↻</span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>@(isEditing ? "Update UoM" : "Save UoM")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-900 min-w-[600px]">
                <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="p-4 w-[40%]">Unit of Measure (Name)</th>
                        <th class="p-4 w-[40%]">Conversions</th>
                        <th class="p-4 text-right w-[20%]">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (uoms.Any())
                    {
                        @foreach (var u in uoms)
                        {
                            <tr class="hover:bg-slate-50 transition-colors group">
                                <td class="p-4 font-bold text-slate-800">
                                    <div class="flex items-center gap-3">
                                        @u.Name
                                    </div>
                                </td>
                                <td class="p-4 text-slate-600 font-medium">
                                    @(conversionRules.Where(x => x.FromUomId == u.Id).Any()
                                        ? string.Join("; ", conversionRules.Where(x => x.FromUomId == u.Id).Select(x => $"1 {u.Name} = {x.ConversionFactor:N4} {(x.ToUom?.Name ?? uoms.FirstOrDefault(y => y.Id == x.ToUomId)?.Name)}"))
                                        : "1:1")
                                </td>
                                <td class="p-4 text-right">
                                    <PermissionGate Key="INVENTORY_SETUP_MANAGE">
                                        <Authorized>
                                            <button @onclick="() => Edit(u)" class="text-indigo-600 font-bold hover:text-indigo-900 mr-4 transition-colors uppercase text-xs tracking-wider">Edit</button>
                                            <button @onclick="() => Delete(u)" class="text-rose-500 font-bold hover:text-rose-700 transition-colors uppercase text-xs tracking-wider">Delete</button>
                                        </Authorized>
                                    </PermissionGate>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="p-16 text-center text-slate-400">
                                <svg class="w-12 h-12 mx-auto text-slate-200 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
                                <p class="font-medium">No Units of Measure found. Click 'New UoM' to add one.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        outline: none;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private List<UnitOfMeasure> uoms = new();
    private List<UomConversionRule> conversionRules = new();
    private UnitOfMeasure currentUom = new();
    private Guid? conversionToUomId;
    private decimal conversionFactor = 1m;
    private Guid? editingConversionId;

    private Guid currentCompanyId;
    private bool showForm = false;
    private bool isEditing = false;
    private bool isBusy = false;
    private bool isImporting = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        uoms = await MasterService.GetUnitOfMeasuresAsync(currentCompanyId);
        conversionRules = await MasterService.GetUomConversionRulesAsync(currentCompanyId);
    }

    private void CreateNew()
    {
        currentUom = new UnitOfMeasure { CompanyId = currentCompanyId };
        conversionToUomId = null; conversionFactor = 1m; editingConversionId = null;
        showForm = true;
        isEditing = false;
    }

    private void Edit(UnitOfMeasure u)
    {
        currentUom = new UnitOfMeasure
        {
            Id = u.Id,
            CompanyId = u.CompanyId,
            Name = u.Name,
            ConversionFactor = u.ConversionFactor,
            ConversionUomId = u.ConversionUomId,
            ConversionFactorValue = u.ConversionFactorValue <= 0 ? 1m : u.ConversionFactorValue
        };
        showForm = true;
        isEditing = true;
        conversionToUomId = null; conversionFactor = 1m; editingConversionId = null;
    }

    private async Task Delete(UnitOfMeasure u)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the UoM '{u.Name}'?");
        if (!confirm) return;

        var err = await MasterService.DeleteUnitOfMeasureAsync(u.Id);
        if (string.IsNullOrEmpty(err))
        {
            await LoadData();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveUom()
    {
        isBusy = true;
        try
        {
            var wasNew = currentUom.Id == Guid.Empty;
            var err = await MasterService.SaveUnitOfMeasureAsync(currentUom);
            if (string.IsNullOrEmpty(err))
            {
                // Keep the editor open after creating a UOM so its conversion lines can be added.
                showForm = wasNew;
                isEditing = true;
                await LoadData();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveConversion()
    {
        if (currentUom.Id == Guid.Empty || !conversionToUomId.HasValue || conversionFactor <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Select a target UOM and enter a factor greater than zero.");
            return;
        }
        var err = await MasterService.SaveUomConversionRuleAsync(new UomConversionRule
        {
            Id = editingConversionId ?? Guid.NewGuid(), CompanyId = currentCompanyId,
            FromUomId = currentUom.Id, ToUomId = conversionToUomId.Value, ConversionFactor = conversionFactor
        });
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }
        editingConversionId = null; conversionToUomId = null; conversionFactor = 1m;
        await LoadData();
    }

    private void EditConversion(UomConversionRule rule)
    {
        editingConversionId = rule.Id; conversionToUomId = rule.ToUomId; conversionFactor = rule.ConversionFactor;
    }

    private async Task DeleteConversion(UomConversionRule rule)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this conversion line?")) return;
        var err = await MasterService.DeleteUomConversionRuleAsync(rule.Id);
        if (!string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", err);
        await LoadData();
    }

    // --- CSV EXPORT LOGIC ---
    private async Task ExportCsv()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("Name,ConversionFactor");

            foreach (var u in uoms)
            {
                var name = $"\"{u.Name?.Replace("\"", "\"\"")}\"";
                var conversion = $"\"{u.ConversionFactor?.Replace("\"", "\"\"")}\"";
                sb.AppendLine($"{name},{conversion}");
            }

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(bytes));

            await JS.InvokeVoidAsync("downloadFileFromStream", "UnitsOfMeasure_Export.csv", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
    }

    // --- CSV IMPORT LOGIC ---
    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        isImporting = true;
        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                await JS.InvokeVoidAsync("alert", "Please upload a valid .csv file.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var lines = content.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length <= 1)
            {
                await JS.InvokeVoidAsync("alert", "The file appears to be empty or missing data rows.");
                return;
            }

            int successCount = 0;

            for (int i = 1; i < lines.Length; i++)
            {
                var cols = ParseCsvLine(lines[i]);

                if (cols.Count >= 1)
                {
                    var name = cols[0].Trim();
                    if (string.IsNullOrWhiteSpace(name)) continue;

                    var uom = uoms.FirstOrDefault(u => u.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
                              ?? new UnitOfMeasure { CompanyId = currentCompanyId, Name = name };

                    if (cols.Count > 1)
                    {
                        uom.ConversionFactor = cols[1].Trim();
                    }

                    await MasterService.SaveUnitOfMeasureAsync(uom);
                    successCount++;
                }
            }

            await LoadData();
            await JS.InvokeVoidAsync("alert", $"Import complete. {successCount} units of measure processed successfully.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Import error: {ex.Message}");
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    // Helper to safely parse CSV rows
    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var currentField = new StringBuilder();

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '\"')
            {
                inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(currentField.ToString());
                currentField.Clear();
            }
            else
            {
                currentField.Append(c);
            }
        }
        result.Add(currentField.ToString());
        return result;
    }
}
