@page "/sc/uom"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Units of Measure</h1>
            <p class="text-sm text-slate-500 mt-1">Define measurement units and conversion factors for inventory items.</p>
        </div>
        <button @onclick="CreateNew" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            New UoM
        </button>
    </div>

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl mb-6 animate-in slide-in-from-top-4">
            <h3 class="text-lg font-bold text-slate-900 mb-6 border-b border-slate-100 pb-3">
                @(isEditing ? "Edit Unit of Measure" : "Create New Unit of Measure")
            </h3>

            <EditForm Model="@currentUom" OnValidSubmit="SaveUom">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div>
                        <label class="label">UoM Name <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentUom.Name" class="input-class font-bold text-slate-800" placeholder="e.g., Dozen, Box, Tons" />
                        <p class="text-[10px] text-slate-400 mt-1">The primary name of the unit.</p>
                    </div>
                    <div>
                        <label class="label">Conversion Factor / Base Unit <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentUom.ConversionFactor" class="input-class" placeholder="e.g., 12 Pieces, 1000 Kilograms" />
                        <p class="text-[10px] text-slate-400 mt-1">What this unit breaks down into.</p>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" @onclick="() => showForm = false" class="rounded-xl px-6 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancel</button>
                    <button type="submit" disabled="@isBusy" class="rounded-xl bg-indigo-600 px-8 py-2.5 text-sm font-bold text-white shadow-md hover:bg-indigo-700 transition-all flex items-center gap-2 disabled:opacity-50">
                        @if (isBusy)
                        {
                            <span class="animate-spin">↻</span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>@(isEditing ? "Update UoM" : "Save UoM")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-900">
            <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                <tr>
                    <th class="p-4 w-[40%]">Unit of Measure (Name)</th>
                    <th class="p-4 w-[40%]">Conversion Factor</th>
                    <th class="p-4 text-right w-[20%]">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (uoms.Any())
                {
                    @foreach (var u in uoms)
                    {
                        <tr class="hover:bg-slate-50 transition-colors group">
                            <td class="p-4 font-bold text-slate-800">
                                <div class="flex items-center gap-3">
                                    @* <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-black text-xs border border-indigo-100">
                                        @u.Name.Substring(0, Math.Min(2, u.Name.Length)).ToUpper()
                                    </div> *@
                                    @u.Name
                                </div>
                            </td>
                            <td class="p-4 text-slate-600 font-medium">@u.ConversionFactor</td>
                            <td class="p-4 text-right">
                                <button @onclick="() => Edit(u)" class="text-indigo-600 font-bold hover:text-indigo-900 mr-4 transition-colors">Edit</button>
                                <button @onclick="() => Delete(u)" class="text-rose-500 font-bold hover:text-rose-700 transition-colors">Delete</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="p-16 text-center text-slate-400">
                            <svg class="w-12 h-12 mx-auto text-slate-200 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
                            <p class="font-medium">No Units of Measure found. Click 'New UoM' to add one.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        outline: none;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private List<UnitOfMeasure> uoms = new();
    private UnitOfMeasure currentUom = new();
    
    private Guid currentCompanyId;
    private bool showForm = false;
    private bool isEditing = false;
    private bool isBusy = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        uoms = await MasterService.GetUnitOfMeasuresAsync(currentCompanyId);
    }

    private void CreateNew()
    {
        currentUom = new UnitOfMeasure { CompanyId = currentCompanyId };
        showForm = true;
        isEditing = false;
    }

    private void Edit(UnitOfMeasure u)
    {
        currentUom = new UnitOfMeasure
        {
            Id = u.Id,
            CompanyId = u.CompanyId,
            Name = u.Name,
            ConversionFactor = u.ConversionFactor
        };
        showForm = true;
        isEditing = true;
    }

    private async Task Delete(UnitOfMeasure u)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete the UoM '{u.Name}'?");
        if (!confirm) return;

        var err = await MasterService.DeleteUnitOfMeasureAsync(u.Id);
        if (string.IsNullOrEmpty(err))
        {
            await LoadData();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveUom()
    {
        isBusy = true;
        try
        {
            var err = await MasterService.SaveUnitOfMeasureAsync(currentUom);
            if (string.IsNullOrEmpty(err))
            {
                showForm = false;
                await LoadData();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}