@page "/setup/gl-mapping"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.IO

@inject TransactionMappingService MappingService
@inject SegCoaService SegCoaService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 mt-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Transaction GL Mapping Router</h1>
            <p class="text-sm text-slate-500 mt-1">Configure global ledger control accounts and define transactional default account routes.</p>
        </div>
        <button @onclick="OpenCreateModal" class="px-5 py-2.5 bg-slate-900 text-white font-bold text-sm rounded-xl hover:bg-slate-800 transition-all flex items-center gap-2 active:scale-95 shadow-sm">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>Add Transaction Type</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse bg-white border border-slate-200 rounded-2xl">Loading configurations...</div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-4 bg-indigo-50 border-b border-indigo-100 text-xs text-indigo-700 font-bold flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Changes save instantly upon clicking "Apply Changes" inside the configuration modal.
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap min-w-[950px]">
                    <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="p-4 w-[25%] pl-6">Transaction Type Route</th>
                            <th class="p-4 w-[30%]">Description Workflow Scope</th>
                            <th class="p-4 w-[18%]">Debit Account (Override)</th>
                            <th class="p-4 w-[18%]">Credit Account (Override)</th>
                            <th class="p-4 text-center w-[9%] pr-6">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var map in mappings)
                        {
                            bool isCustom = map.TransactionType == SystemTransactionType.CustomGlAdjustment;

                            <tr class="hover:bg-slate-50 transition-colors group @(isCustom ? "bg-amber-50/5" : "")">
                                <td class="p-4 pl-6 font-bold text-slate-800">
                                    @if (isCustom)
                                    {
                                        <div class="flex items-center gap-2">
                                            <span class="inline-flex h-2 w-2 rounded-full bg-amber-500 shrink-0"></span>
                                            <span class="truncate max-w-[240px]" title="@map.CustomTransactionType?.Name">@map.CustomTransactionType?.Name</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @FormatEnumName(map.TransactionType.ToString())
                                    }
                                </td>

                                <td class="p-4 text-xs text-slate-500 max-w-xs truncate" title="@GetRowDescription(map)">
                                    @GetRowDescription(map)
                                </td>

                                <td class="p-4">
                                    @if (map.OverrideDebitGlAccountId.HasValue)
                                    {
                                        <div class="font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-100 inline-block text-xs truncate max-w-[180px]">
                                            @GetAccountDisplayName(map.OverrideDebitGlAccountId)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-slate-400 font-medium italic">
                                            @(isCustom ? "Variable Selection" : GetDefaultDescription(map.TransactionType, true))
                                        </div>
                                    }
                                </td>
                                <td class="p-4">
                                    @if (map.OverrideCreditGlAccountId.HasValue)
                                    {
                                        <div class="font-bold text-indigo-700 bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-100 inline-block text-xs truncate max-w-[180px]">
                                            @GetAccountDisplayName(map.OverrideCreditGlAccountId)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-slate-400 font-medium italic">
                                            @(isCustom ? "Variable Selection" : GetDefaultDescription(map.TransactionType, false))
                                        </div>
                                    }
                                </td>
                                <td class="p-4 text-center pr-6">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <button @onclick="() => OpenEditModal(map)" class="px-3 py-1.5 text-xs font-bold text-indigo-600 bg-white border border-slate-200 rounded-lg shadow-sm hover:bg-indigo-50 transition-colors opacity-100 md:opacity-0 group-hover:opacity-100">
                                            Configure
                                        </button>
                                        @if (isCustom)
                                        {
                                            <button @onclick="() => DeleteCustomType(map)" class="px-2.5 py-1.5 text-xs font-bold text-rose-600 bg-white border border-slate-200 rounded-lg shadow-sm hover:bg-rose-50 hover:text-rose-700 transition-colors opacity-100 md:opacity-0 group-hover:opacity-100" title="Delete Custom Template">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showModal)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">
                    @if (isCreatingCustom)
                    {
                        <span class="text-indigo-700">Define Custom Transaction Template</span>
                    }
                    else
                    {
                        <span>Configure Route: <span class="text-indigo-700">@(editingMap?.TransactionType == SystemTransactionType.CustomGlAdjustment ? editingMap.CustomTransactionType?.Name : FormatEnumName(editingMap?.TransactionType.ToString() ?? ""))</span></span>
                    }
                </h3>
                <button type="button" @onclick="CloseModal" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-visible flex-1 content-box">

                @if (isCreatingCustom || (editingMap != null && editingMap.TransactionType == SystemTransactionType.CustomGlAdjustment))
                {
                    <div class="space-y-4 animate-in fade-in duration-300 mb-6">
                        <div>
                            <label class="label">Custom Template Name <span class="text-rose-500">*</span></label>
                            <input type="text" @bind="newCustomName" class="input-class" placeholder="e.g. Shareholder Equity Loan" />
                        </div>
                        <div>
                            <label class="label">Functional Workflow Description</label>
                            <input type="text" @bind="newCustomDesc" class="input-class" placeholder="Describe when to utilize this template..." />
                        </div>
                    </div>
                    <hr class="border-slate-200/60 my-4" />
                }

                <div class="space-y-2 relative z-50">
                    <div class="flex justify-between items-center">
                        <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Debit Account Override Mapping</label>
                        @if (tempDebit.HasValue)
                        {
                            <button type="button" @onclick="() => tempDebit = null" class="text-[9px] font-bold text-rose-500 hover:text-rose-700 uppercase tracking-wider bg-rose-50 px-2 py-0.5 rounded border border-rose-100 transition-colors">
                                Clear Override
                            </button>
                        }
                    </div>
                    <SearchableGlAccount Label=""
                                         Placeholder="@(isCreatingCustom ? "Select Default Debit Account (Optional)..." : GetDefaultDescription(editingMap?.TransactionType ?? SystemTransactionType.SalesInvoice, true))"
                                         Accounts="@coaList"
                                         Value="@(tempDebit ?? Guid.Empty)"
                                         ValueChanged="@((Guid val) => tempDebit = val == Guid.Empty ? null : val)" />
                </div>

                <div class="h-6"></div>

                <div class="space-y-2 relative z-30">
                    <div class="flex justify-between items-center">
                        <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Credit Account Override Mapping</label>
                        @if (tempCredit.HasValue)
                        {
                            <button type="button" @onclick="() => tempCredit = null" class="text-[9px] font-bold text-rose-500 hover:text-rose-700 uppercase tracking-wider bg-rose-50 px-2 py-0.5 rounded border border-rose-100 transition-colors">
                                Clear Override
                            </button>
                        }
                    </div>
                    <SearchableGlAccount Label=""
                                         Placeholder="@(isCreatingCustom ? "Select Default Credit Account (Optional)..." : GetDefaultDescription(editingMap?.TransactionType ?? SystemTransactionType.SalesInvoice, false))"
                                         Accounts="@coaList"
                                         Value="@(tempCredit ?? Guid.Empty)"
                                         ValueChanged="@((Guid val) => tempCredit = val == Guid.Empty ? null : val)" />
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-2xl relative z-[60]">
                <button @onclick="CloseModal" class="px-5 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors" disabled="@isSaving">
                    Cancel
                </button>
                <button @onclick="ApplyAndSaveModal" class="px-6 py-2.5 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-1.5" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="animate-spin h-3 w-3 border-2 border-white border-t-transparent rounded-full"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Apply Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        color: #0f172a;
        outline: none;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private Guid currentCompanyId;
    private string currentUserId = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showModal = false;
    private bool isCreatingCustom = false;

    private List<TransactionGlMapping> mappings = new();
    private List<SegChartOfAccount> coaList = new();

    private string newCustomName = string.Empty;
    private string newCustomDesc = string.Empty;

    private TransactionGlMapping? editingMap;
    private Guid? tempDebit;
    private Guid? tempCredit;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;
            await RefreshDataset();
        }
        isLoading = false;
    }

    private async Task RefreshDataset()
    {
        coaList = await SegCoaService.GetActiveCoaAsync(currentCompanyId);

        await MappingService.GetMappingsAsync(currentCompanyId);

        using var ctx = await DbFactory.CreateDbContextAsync();
        var rawMappings = await ctx.TransactionGlMappings
            .Include(m => m.CustomTransactionType)
            .Where(m => m.CompanyId == currentCompanyId)
            .ToListAsync();

        mappings = rawMappings
            .Where(m => (int)m.TransactionType != 0)
            .OrderBy(m => m.TransactionType == SystemTransactionType.CustomGlAdjustment ? 1 : 0)
            .ThenBy(m => m.TransactionType)
            .ThenBy(m => m.CustomTransactionType?.Name)
            .ToList();
    }

    private void OpenEditModal(TransactionGlMapping map)
    {
        isCreatingCustom = false;
        editingMap = map;
        tempDebit = map.OverrideDebitGlAccountId;
        tempCredit = map.OverrideCreditGlAccountId;

        if (map.TransactionType == SystemTransactionType.CustomGlAdjustment && map.CustomTransactionType != null)
        {
            newCustomName = map.CustomTransactionType.Name;
            newCustomDesc = map.CustomTransactionType.Description;
        }
        else
        {
            newCustomName = string.Empty;
            newCustomDesc = string.Empty;
        }
        showModal = true;
    }

    private void OpenCreateModal()
    {
        isCreatingCustom = true;
        editingMap = null;
        newCustomName = string.Empty;
        newCustomDesc = string.Empty;
        tempDebit = null;
        tempCredit = null;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task ApplyAndSaveModal()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        isSaving = true;

        try
        {
            if (isCreatingCustom)
            {
                if (string.IsNullOrWhiteSpace(newCustomName))
                {
                    await JS.InvokeVoidAsync("alert", "Validation Error: A Template Name identifier is required.");
                    isSaving = false;
                    return;
                }

                bool nameExists = await ctx.CustomTransactionTypes.AnyAsync(x => x.CompanyId == currentCompanyId && x.Name.ToLower() == newCustomName.ToLower());
                if (nameExists)
                {
                    await JS.InvokeVoidAsync("alert", $"Validation Error: A template named '{newCustomName}' already exists.");
                    isSaving = false;
                    return;
                }

                var customRecord = new CustomTransactionType
                {
                    Id = Guid.NewGuid(),
                    CompanyId = currentCompanyId,
                    Name = newCustomName.Trim(),
                    Description = newCustomDesc.Trim(),
                    CreatedByUserId = currentUserId,
                    CreatedAt = DateTime.UtcNow
                };

                var routingRecord = new TransactionGlMapping
                {
                    Id = Guid.NewGuid(),
                    CompanyId = currentCompanyId,
                    TransactionType = SystemTransactionType.CustomGlAdjustment,
                    CustomTransactionTypeId = customRecord.Id,
                    OverrideDebitGlAccountId = tempDebit,
                    OverrideCreditGlAccountId = tempCredit,
                    IsActive = true,
                    UpdatedByUserId = currentUserId,
                    UpdatedAt = DateTime.UtcNow
                };

                ctx.CustomTransactionTypes.Add(customRecord);
                ctx.TransactionGlMappings.Add(routingRecord);
            }
            else if (editingMap != null)
            {
                var targetRecord = await ctx.TransactionGlMappings.FindAsync(editingMap.Id);
                if (targetRecord != null)
                {
                    targetRecord.OverrideDebitGlAccountId = tempDebit;
                    targetRecord.OverrideCreditGlAccountId = tempCredit;
                    targetRecord.UpdatedByUserId = currentUserId;
                    targetRecord.UpdatedAt = DateTime.UtcNow;

                    if (targetRecord.TransactionType == SystemTransactionType.CustomGlAdjustment && targetRecord.CustomTransactionTypeId.HasValue)
                    {
                        var existingCustom = await ctx.CustomTransactionTypes.FindAsync(targetRecord.CustomTransactionTypeId.Value);
                        if (existingCustom != null)
                        {
                            existingCustom.Name = newCustomName.Trim();
                            existingCustom.Description = newCustomDesc.Trim();
                        }
                    }
                }
            }

            await ctx.SaveChangesAsync();
            await RefreshDataset();
            showModal = false;
            await JS.InvokeVoidAsync("alert", "Changes committed and saved securely to database!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Save Operation Rejected: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCustomType(TransactionGlMapping map)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete the template category '{map.CustomTransactionType?.Name}'?\n\nThis will clear its ledger router mappings completely.");
        if (!confirm) return;

        try
        {
            bool deleted = await MappingService.DeleteCustomTransactionTypeAsync(map.Id, currentCompanyId);
            if (deleted)
            {
                await RefreshDataset();
                await JS.InvokeVoidAsync("alert", "Custom transaction configuration template removed successfully.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Could not locate the template to remove.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Operational Refusal: {ex.Message}");
        }
    }

    private string FormatEnumName(string name) => System.Text.RegularExpressions.Regex.Replace(name, "([a-z])([A-Z])", "$1 $2");

    private string GetAccountDisplayName(Guid? accountId)
    {
        if (!accountId.HasValue || accountId.Value == Guid.Empty) return "";
        var acc = coaList.FirstOrDefault(a => a.Id == accountId.Value);
        return acc != null ? $"{acc.AccountCode} - {acc.Description}" : "Unknown Account";
    }
    private string GetRowDescription(TransactionGlMapping map)
    {
        if (map.TransactionType == SystemTransactionType.CustomGlAdjustment)
        {
            return !string.IsNullOrWhiteSpace(map.CustomTransactionType?.Description)
                ? map.CustomTransactionType.Description
                : "User Defined Custom GL Adjustment Template Route.";
        }

        return map.TransactionType switch
        {
            SystemTransactionType.ArAdjustment => "Accounts receivable opening balance migration & subledger manual adjustments.",
            SystemTransactionType.ApAdjustment => "Accounts payable opening balance migration & subledger manual adjustments.",
            SystemTransactionType.DirectPurchaseInvoice => "Non-inventory direct accounts payable supplier bills.",
            SystemTransactionType.DirectSalesInvoice => "Non-inventory free-text customer invoicing revenues.",
            SystemTransactionType.DiscountAllowed => "Financial ledger routing for sales discounts granted.",
            SystemTransactionType.DiscountReceived => "Financial ledger routing for purchasing discounts captured / rolled back.",
            SystemTransactionType.SalesInvoice => "Standard inventory-tracked client invoicing ledger paths.",
            SystemTransactionType.PurchaseInvoice => "Standard inventory-tracked vendor procurement receipts.",
            SystemTransactionType.CreditNote => "Customer returns and accounts receivable sales credits.",
            SystemTransactionType.VendorReturnStock => "Vendor physical stock returns (AP Liability Reduction vs Inventory Asset Credit).",
            SystemTransactionType.VendorReturnRefund => "Vendor cash payment refunds (Deposit Bank Asset vs AP Liability Restoration).",
            SystemTransactionType.DebitNote => "Purchase invoice price reductions & non-stock corrections.",
            SystemTransactionType.CustomerPayment => "Customer receipts and cash collections (Deposit Bank Asset vs Customer AR).",
            SystemTransactionType.VendorPayment => "Vendor bill outgoing payments (AP Liability Reduction vs Disbursement Bank).",
            SystemTransactionType.ReceiptRefundStock => "Customer physical stock intake reversal (Inventory Asset Dr vs COGS Cr).",
            SystemTransactionType.ReceiptRefundCash => "Customer cash refund disbursement (Customer AR Dr vs Bank Cr).",
            SystemTransactionType.ShipmentDispatch => "Warehouse shipment fulfillment (Inventory Stock Out vs COGS recognition).",
            SystemTransactionType.InventoryAdjustment => "Physical stock counts and WACC revaluation updates.",
            SystemTransactionType.GoodsReceipt => "Accrual clearing account (GR/IR) for physical goods receipts & stock intake.",
            _ => "Core System Default Route Configuration."
        };
    }

    private string GetDefaultDescription(SystemTransactionType type, bool isDebit)
    {
        if (isDebit)
        {
            return type switch
            {
                SystemTransactionType.ArAdjustment => "System Default [Customer AR Control]",
                SystemTransactionType.ApAdjustment => "NOT SET [Suspense / Equity Offset]",
                SystemTransactionType.DirectPurchaseInvoice => "NOT SET [Expense Account]",
                SystemTransactionType.DirectSalesInvoice => "System Default [Customer AR]",
                SystemTransactionType.DiscountAllowed => "System Default [Order Discount Acc]",
                SystemTransactionType.DiscountReceived => "NOT SET [Discount Rollback Debit Acc]",
                SystemTransactionType.SalesInvoice => "System Default [Customer AR]",
                SystemTransactionType.PurchaseInvoice => "System Default [Line Expense / Asset]",
                SystemTransactionType.CreditNote => "NOT SET [Item Revenue Account]",
                SystemTransactionType.VendorReturnStock => "System Default [Vendor AP Control]",
                SystemTransactionType.VendorReturnRefund => "NOT SET [Deposit Bank / Cash Asset]",
                SystemTransactionType.DebitNote => "System Default [Vendor AP Control]",
                SystemTransactionType.CustomerPayment => "NOT SET [Deposit Bank / Cash Asset]",
                SystemTransactionType.VendorPayment => "System Default [Vendor AP Control]",
                SystemTransactionType.ReceiptRefundStock => "System Default [Item Inventory Asset Account]",
                SystemTransactionType.ReceiptRefundCash => "System Default [Customer AR Control]",
                SystemTransactionType.ShipmentDispatch => "System Default [Item COGS Account]",
                SystemTransactionType.InventoryAdjustment => "System Default [Inventory Stock Asset]",
                SystemTransactionType.GoodsReceipt => "System Default [Inventory Asset Account]",
                _ => "System Default"
            };
        }
        else
        {
            return type switch
            {
                SystemTransactionType.ArAdjustment => "NOT SET [Custom Suspense / Equity Offset]",
                SystemTransactionType.ApAdjustment => "System Default [Vendor AP Control]",
                SystemTransactionType.DirectPurchaseInvoice => "System Default [Vendor AP]",
                SystemTransactionType.DirectSalesInvoice => "NOT SET [Revenue Account]",
                SystemTransactionType.DiscountAllowed => "System Default [Customer AR]",
                SystemTransactionType.DiscountReceived => "System Default [Line Discount Received Acc]",
                SystemTransactionType.SalesInvoice => "System Default [Item Revenue Account]",
                SystemTransactionType.PurchaseInvoice => "System Default [Vendor AP]",
                SystemTransactionType.CreditNote => "System Default [Customer AR]",
                SystemTransactionType.VendorReturnStock => "System Default [Item Inventory Asset Account]",
                SystemTransactionType.VendorReturnRefund => "System Default [Vendor AP Control]",
                SystemTransactionType.DebitNote => "System Default [Line Expense / Clearing Account]",
                SystemTransactionType.CustomerPayment => "System Default [Customer AR Control]",
                SystemTransactionType.VendorPayment => "NOT SET [Disbursement Bank / Cash Asset]",
                SystemTransactionType.ReceiptRefundStock => "System Default [Item COGS Account]",
                SystemTransactionType.ReceiptRefundCash => "NOT SET [Disbursing Bank / Cash Account]",
                SystemTransactionType.ShipmentDispatch => "System Default [Item Inventory Asset Account]",
                SystemTransactionType.InventoryAdjustment => "NOT SET [Inventory Balance Account]",
                SystemTransactionType.GoodsReceipt => "NOT SET [GR/IR Clearing Liability Account]",
                _ => "System Default"
            };
        }
    }
}