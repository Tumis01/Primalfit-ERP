@page "/procurement/purchase-requests"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Components.Shared
@using Primafit_ERP.Services
@using PrimafitERP.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<AppDbContext> DbFactory
@inject DocumentWorkflowService Workflow
@inject CurrencyService CurrencyService
@inject NavigationManager Navigation
@inject PermissionCacheService PermissionCache
@rendermode InteractiveServer

<PageTitle>Purchase Requests</PageTitle>
<div class="mx-auto max-w-[1400px] space-y-6 px-4 py-8 sm:px-6 lg:px-8 font-sans text-slate-800 pb-16">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="shrink-0"><h1 class="text-2xl font-bold tracking-tight text-slate-900">Procurement</h1>@if (!string.IsNullOrWhiteSpace(companyName)) { <span class="inline-flex rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200 mt-2">@companyName</span> }</div>
        <div class="flex flex-col lg:flex-row flex-wrap gap-4 items-stretch lg:items-center w-full xl:w-auto xl:justify-end">
            @if (!showCreate)
            {
                <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-xl border border-slate-200 h-[42px]"><input type="date" @bind="fromDate" aria-label="Requests from date" class="px-2 py-1.5 text-xs font-bold bg-transparent outline-none" /><span class="text-slate-400">–</span><input type="date" @bind="toDate" aria-label="Requests to date" class="px-2 py-1.5 text-xs font-bold bg-transparent outline-none" /></div>
                <input type="search" value="@search" @oninput="OnSearch" placeholder="Search reference, vendor, item..." aria-label="Search purchase requests" class="h-[42px] w-full md:w-64 px-4 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" />
            }
            <div class="flex bg-slate-100 p-1 rounded-xl overflow-x-auto whitespace-nowrap">
                <button type="button" @onclick="ShowRegister" class="px-4 py-2 rounded-lg text-sm font-bold @(showCreate ? "text-slate-500" : "bg-white text-slate-900 shadow-sm")">All Requests</button>
                <PermissionGate Key="PO_CREATE"><Authorized><button type="button" @onclick="NewRequest" class="px-4 py-2 rounded-lg text-sm font-bold @(showCreate ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">New Request</button></Authorized></PermissionGate>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div role="status" class="rounded-xl border @(isError ? "border-rose-200 bg-rose-50 text-rose-700" : "border-emerald-200 bg-emerald-50 text-emerald-700") px-4 py-3 text-sm">@message</div> }
    @if (isLoading) { <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400">Loading purchase requests...</div> }
    else if (companyId == Guid.Empty) { <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-500">Company context is unavailable.</div> }
    else if (showCreate)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-visible">
            <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-wrap justify-between gap-4 rounded-t-2xl"><div><h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Record Details</h2><p class="mt-1 text-xs text-slate-500">A request number is assigned when you save.</p></div><span class="text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-100 rounded-lg px-3 py-1.5">@(viewOnly ? "View Purchase Request" : editingId.HasValue ? "Edit Purchase Request" : "New Purchase Request")</span></div>
            <fieldset disabled="@viewOnly" class="p-6 sm:p-8 space-y-6 min-w-0">
                <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 shadow-sm"><div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
                    <SearchableGuidSelect Label="Vendor" Required="true" Options="@VendorOptions" Value="@vendorId" ValueChanged="OnVendorChanged" Placeholder="Search vendor" />
                    <div><label class="block text-[10px] font-extrabold uppercase tracking-wider text-slate-500 mb-1.5">Request Date <span class="text-rose-600">*</span></label><input type="datetime-local" @bind="requestDate" class="w-full rounded-xl border border-slate-200 bg-white p-2.5 text-sm" /></div>
                    <DocumentCurrency Code="@(currencies.FirstOrDefault(x => x.Id == currencyId)?.CurrencyCode)" />

                </div></div>
                <section aria-label="Document header terms" class="rounded-xl border border-slate-200 p-5"><PurchaseDocumentTerms CompanyId="@companyId" Terms="@documentTerms" /></section>
                <div class="border border-slate-200 rounded-xl shadow-sm overflow-visible">
                    <div class="overflow-x-auto overflow-y-visible"><div class="transaction-lines-scroll" role="region" aria-label="Transaction line items" tabindex="0"><table class="transaction-lines w-full min-w-[850px] text-sm text-left"><thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase"><tr><th class="p-3 pl-4 w-[32%]">Item</th><th class="p-3 w-[14%]">UOM</th><th class="p-3 w-[14%] text-center">Qty</th><th class="p-3 w-[18%] text-right">Unit Cost</th><th class="p-3 w-[17%] text-right">Total</th><th class="p-3 w-[5%]"></th><th class="p-3">Dimensions</th></tr></thead><tbody class="divide-y divide-slate-100">
                        @foreach (var line in draftLines)
                        {
                            <tr @key="line.Id" class="hover:bg-slate-50 align-top"><td class="p-2 pl-4"><SearchableGuidSelect Options="@ItemOptions" Value="@(line.ItemId == Guid.Empty ? null : line.ItemId)" ValueChanged="@(id => OnItemChanged(line, id))" Placeholder="Search item or code" Required="true" InlineMenu="true" /></td><td class="p-2"><SearchableGuidSelect Options="@UomOptions(line)" Value="@line.UomId" ValueChanged="@(id => OnUomChanged(line, id))" Placeholder="Select UOM" Disabled="@(line.ItemId == Guid.Empty)" AllowClear="false" InlineMenu="true" /></td><td class="p-2"><input type="number" min="0" step="0.0001" value="@Number(UomConversion.FromBase(line.QuantityRequested, line.UomConversionFactor))" @onchange="e => SetQuantity(line, e)" aria-label="Quantity" disabled="@(line.ItemId == Guid.Empty)" class="w-full rounded-xl border border-slate-200 p-2.5 text-center font-bold disabled:bg-slate-100" /></td><td class="p-2"><input type="number" min="0" step="0.0001" value="@Number(UomConversion.PriceFromBase(line.UnitCost, line.UomConversionFactor))" @onchange="e => SetCost(line, e)" aria-label="Unit cost" disabled="@(line.ItemId == Guid.Empty)" class="w-full rounded-xl border border-slate-200 p-2.5 text-right font-mono disabled:bg-slate-100" /></td><td class="p-3 text-right font-mono font-bold">@LineTotal(line).ToString("N4")</td><td class="p-3 text-right"><button type="button" @onclick="() => RemoveLine(line)" aria-label="Remove line" class="text-slate-400 hover:text-rose-600">✕</button></td><td class="p-3 align-top"><DimensionSelect CompanyId="@companyId" @bind-Value="line.DimensionSetId" Disabled="@viewOnly" /></td></tr>
                        }
                    </tbody></table></div></div><div class="p-3 bg-slate-50 border-t border-slate-200 rounded-b-xl"><button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 uppercase tracking-wide">+ Add Line Item</button></div>
                </div>

                <div class="flex justify-end"><div class="space-y-2 text-sm text-slate-600 w-full md:w-80 bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm"><div class="flex justify-between"><span>Subtotal</span><span class="font-mono font-bold">@Subtotal.ToString("N4")</span></div><div class="flex justify-between"><span>Discount</span><span class="font-mono">− @Discount.ToString("N4")</span></div><div class="flex justify-between"><span>Net subtotal</span><span class="font-mono font-bold">@((Subtotal - Discount).ToString("N4"))</span></div><div class="flex justify-between"><span>Tax</span><span class="font-mono">+ @TaxAmount.ToString("N4")</span></div><div class="flex justify-between border-t border-slate-200 pt-3 font-bold text-slate-900"><span>Total (Foreign)</span><span class="font-mono">@Total.ToString("N4")</span></div><div class="flex justify-between text-emerald-700"><span>Total (@baseCurrency)</span><span class="font-mono font-bold">@((Total * documentTerms.ExchangeRate).ToString("N4"))</span></div>@if (documentTerms.WithholdingTaxId.HasValue) { <div class="flex justify-between border-t border-slate-200 pt-2 text-amber-700"><span>Estimated withholding</span><span class="font-mono">@Withholding.ToString("N4")</span></div><p class="text-[10px] text-slate-400">Withholding is applied when the vendor payment is posted.</p> }</div></div>
            </fieldset>
            <div class="flex justify-end gap-3 border-t border-slate-100 bg-slate-50/50 p-5 rounded-b-2xl"><button type="button" @onclick="ShowRegister" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm">Cancel</button>@if (!viewOnly) { <PermissionGate Key="PO_CREATE"><Authorized><button type="button" @onclick="() => SaveRequest(false)" disabled="@saving" class="rounded-xl border px-5 py-2 text-sm font-bold">Save Draft</button><button type="button" @onclick="() => SaveRequest(true)" disabled="@saving" class="px-8 py-2.5 rounded-xl bg-indigo-600 text-white font-bold text-sm hover:bg-indigo-700 disabled:opacity-50">@(saving ? "Saving..." : "Save Purchase Request")</button></Authorized></PermissionGate> }</div>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden"><div class="overflow-x-auto"><div class="transaction-lines-scroll" role="region" aria-label="Transaction line items" tabindex="0"><table class="transaction-lines w-full text-left text-sm whitespace-nowrap min-w-[1100px]"><thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider"><tr><th class="px-6 py-4">Request Number</th><th class="px-6 py-4">Date</th><th class="px-6 py-4">Vendor</th><th class="px-6 py-4 w-[25%]">Items (Qty)</th><th class="px-6 py-4 text-right">Total (Foreign)</th><th class="px-6 py-4 text-right border-l border-slate-200">Total (Base)</th><th class="px-6 py-4 text-right">Actions</th></tr></thead><tbody class="divide-y divide-slate-100">
            @foreach (var request in PagedRequests)
            {
                var total = RequestTotal(request);
                <tr class="hover:bg-slate-50/80 transition-colors align-top"><td class="px-6 py-4"><div class="font-mono font-bold text-slate-900">@request.RequestNumber</div><span class="inline-block mt-1 text-[10px] font-bold uppercase text-indigo-600">@request.Status</span></td><td class="px-6 py-4 text-slate-500 font-medium">@request.RequestDate.ToString("MMM dd, yyyy HH:mm")</td><td class="px-6 py-4 font-bold">@request.Vendor?.Name <div class="text-xs font-normal text-slate-400">@request.Warehouse?.Name</div></td><td class="px-6 py-4">@foreach (var line in request.Lines.Take(2)) { <div class="text-xs mb-1">@(line.Item?.Name ?? line.Description ?? "Unknown") <span class="font-mono text-slate-500">(x@(UomConversion.FromBase(line.QuantityRequested, line.UomConversionFactor).ToString("G29")))</span></div> } @if (request.Lines.Count > 2) { <div class="text-[10px] font-bold text-indigo-500">+ @(request.Lines.Count - 2) more item(s)</div> }</td><td class="px-6 py-4 text-right font-mono font-bold">@total.ToString("N4") <div class="text-[10px] text-slate-400">@request.Currency?.CurrencyCode</div></td><td class="px-6 py-4 text-right font-mono font-bold text-emerald-700 bg-slate-50/30 border-l border-slate-100">@((total * request.ExchangeRate).ToString("N4")) <div class="text-[10px] text-slate-400">@baseCurrency</div></td><td class="px-6 py-4 text-right"><button type="button" @onclick="() => OpenRequest(request)" class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50">@(request.Status is PurchaseRequestStatus.Draft or PurchaseRequestStatus.Open ? "Edit" : "View")</button> @if (request.Status is PurchaseRequestStatus.Open or PurchaseRequestStatus.PartiallyConverted) { <PermissionGate Key="PO_CREATE"><Authorized><a href="@($"/procurement/purchase-orders?request={request.Id}")" class="ml-1 inline-block px-3 py-1.5 rounded-lg bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold">Make Order</a></Authorized></PermissionGate> }</td></tr>
                @if (viewedId == request.Id) { <tr><td colspan="7" class="p-5 bg-slate-50"><div class="grid gap-3 md:grid-cols-4 mb-4 text-xs text-slate-600"><div>Site: @(request.Warehouse?.Name ?? "Unavailable")</div><div>Exchange rate: @request.ExchangeRate.ToString("N4")</div><div>Tax: @taxNames.GetValueOrDefault(request.TaxId ?? Guid.Empty, "None")</div><div>Withholding: @(request.WithholdingTaxName ?? "None")</div><div>Discount: @request.DiscountPercentage.ToString("N2")% / @request.DiscountAmount.ToString("N2")</div><div>Project: @(projects.FirstOrDefault(x => x.Id == request.ProjectId)?.Name ?? "None")</div></div><div class="transaction-lines-scroll" role="region" aria-label="Transaction line items" tabindex="0"><table class="transaction-lines w-full text-sm"><thead><tr class="text-left text-slate-500"><th>Item</th><th>Quantity</th><th>UOM</th><th>Unit cost</th><th>Amount</th></tr></thead><tbody>@foreach (var line in request.Lines) { <tr class="border-t"><td class="py-2">@(line.Item?.Name ?? line.Description ?? "Unknown")</td><td>@UomConversion.FromBase(line.QuantityRequested, line.UomConversionFactor).ToString("N4")</td><td>@line.UomName</td><td>@UomConversion.PriceFromBase(line.UnitCost, line.UomConversionFactor).ToString("N4")</td><td>@LineTotal(line).ToString("N2")</td></tr> }</tbody></table></div><a href="/procurement/purchase-orders" class="inline-block mt-4 text-xs font-bold text-indigo-700">Create a purchase order from request lines →</a></td></tr> }
            }
            @if (!FilteredRequests.Any()) { <tr><td colspan="7" class="p-16 text-center text-slate-400">No requests match your filters.</td></tr> }
        </tbody></table></div></div>
        @if (FilteredRequests.Any()) { <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4 border-t border-slate-200 bg-slate-50"><div class="text-xs font-bold text-slate-500 uppercase">Showing @((CurrentPage - 1) * PageSize + 1) to @Math.Min(CurrentPage * PageSize, FilteredRequests.Count()) of @FilteredRequests.Count() records</div><div class="flex gap-2"><button @onclick="() => page--" disabled="@(CurrentPage <= 1)" class="px-3 py-1.5 rounded-lg border bg-white text-xs font-bold disabled:opacity-50">Previous</button><span class="px-3 py-1.5 text-xs font-bold">Page @CurrentPage of @PageCount</span><button @onclick="() => page++" disabled="@(CurrentPage >= PageCount)" class="px-3 py-1.5 rounded-lg border bg-white text-xs font-bold disabled:opacity-50">Next</button></div></div> }
        </div>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "view")] public Guid? ViewRequestId { get; set; }

    private Guid companyId; private Guid? vendorId, warehouseId, currencyId, projectId, viewedId, editingId;
    private string companyName = "", baseCurrency = "BASE", search = "", message = "", editingNumber = "";
    private bool showCreate, saving, isLoading = true, isError, viewOnly;
    private DateTime requestDate = DateTime.Now; private DateTime? fromDate, toDate;
    private int page = 1; private const int PageSize = 10;
    private DestinationDocumentTerms documentTerms = new();
    private List<Vendor> vendors = new(); private List<Warehouse> warehouses = new(); private List<Currency> currencies = new(); private List<Project> projects = new(); private List<Item> items = new(); private List<UnitOfMeasure> uoms = new(); private List<UomConversionRule> conversionRules = new(); private List<PurchaseRequest> requests = new(); private List<PurchaseRequestLine> draftLines = new();
    private Dictionary<Guid, string> taxNames = new(); private Dictionary<Guid, decimal> taxRates = new(), withholdingRates = new();
    private IReadOnlyCollection<DropdownOption> VendorOptions => vendors.Select(x => new DropdownOption(x.Id, x.Name)).ToList();
    private IReadOnlyCollection<DropdownOption> WarehouseOptions => warehouses.Select(x => new DropdownOption(x.Id, x.Name)).ToList();
    private IReadOnlyCollection<DropdownOption> CurrencyOptions => currencies.Select(x => new DropdownOption(x.Id, x.CurrencyCode)).ToList();
    private IReadOnlyCollection<DropdownOption> ProjectOptions => projects.Where(x => x.IsActive).Select(x => new DropdownOption(x.Id, x.Name, x.ProjectCode)).ToList();
    private IReadOnlyCollection<DropdownOption> ItemOptions => items.Where(x => !x.IsService).Select(x => new DropdownOption(x.Id, x.Name, x.Code)).ToList();
    private IReadOnlyDictionary<(Guid, Guid), decimal> ConversionMap => conversionRules.ToDictionary(x => (x.FromUomId, x.ToUomId), x => x.ConversionFactor);
    private IReadOnlyCollection<DropdownOption> UomOptions(PurchaseRequestLine line) { var item = items.FirstOrDefault(x => x.Id == line.ItemId); if (item?.UomId == null) return Array.Empty<DropdownOption>(); var ids = UomConversion.ConfiguredUoms(item); return uoms.Where(x => ids.Contains(x.Id)).Select(x => new DropdownOption(x.Id, x.Name, x.Id == item.UomId ? "Primary unit" : null)).ToList(); }
    private IEnumerable<PurchaseRequest> FilteredRequests => requests.Where(x => (!fromDate.HasValue || x.RequestDate.Date >= fromDate.Value.Date) && (!toDate.HasValue || x.RequestDate.Date <= toDate.Value.Date) && (string.IsNullOrWhiteSpace(search) || x.RequestNumber.Contains(search, StringComparison.OrdinalIgnoreCase) || (x.Vendor?.Name ?? "").Contains(search, StringComparison.OrdinalIgnoreCase) || x.Lines.Any(l => (l.Item?.Name ?? "").Contains(search, StringComparison.OrdinalIgnoreCase))));
    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredRequests.Count() / (double)PageSize)); private int CurrentPage => Math.Min(Math.Max(1, page), PageCount); private IEnumerable<PurchaseRequest> PagedRequests => FilteredRequests.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    private decimal Subtotal => draftLines.Sum(LineTotal); private decimal Discount => documentTerms.DiscountPercentage > 0 ? Subtotal * documentTerms.DiscountPercentage / 100m : Math.Min(documentTerms.DiscountAmount, Subtotal); private decimal TaxAmount => (Subtotal - Discount) * taxRates.GetValueOrDefault(documentTerms.TaxId ?? Guid.Empty) / 100m; private decimal Total => Subtotal - Discount + TaxAmount; private decimal Withholding => (Subtotal - Discount) * withholdingRates.GetValueOrDefault(documentTerms.WithholdingTaxId ?? Guid.Empty) / 100m;
    private static decimal LineTotal(PurchaseRequestLine line) => Math.Round(line.QuantityRequested * line.UnitCost, 2, MidpointRounding.AwayFromZero);
    private decimal RequestTotal(PurchaseRequest request) { var gross = request.Lines.Sum(LineTotal); var discount = request.DiscountPercentage > 0 ? gross * request.DiscountPercentage / 100m : Math.Min(request.DiscountAmount, gross); return Math.Round((gross - discount) * (1m + taxRates.GetValueOrDefault(request.TaxId ?? Guid.Empty) / 100m), 2, MidpointRounding.AwayFromZero); }
    protected override async Task OnInitializedAsync() { if (!PermissionCache.Has("PURCHASING_PAGE")) { Navigation.NavigateTo("/access-denied"); return; } var user = await UserManager.GetUserAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User); companyId = user?.CompanyDetailsId ?? Guid.Empty; if (companyId != Guid.Empty) { await LoadAsync(); if (ViewRequestId.HasValue && requests.FirstOrDefault(x => x.Id == ViewRequestId) is { } source) { OpenRequest(source); viewOnly = true; } } isLoading = false; }
    private async Task LoadAsync() { await using var db = await DbFactory.CreateDbContextAsync(); var company = await db.CompanyDetails.AsNoTracking().FirstOrDefaultAsync(x => x.CompanyDetailsId == companyId); companyName = company?.CompanyName ?? ""; baseCurrency = company?.BaseCurrency ?? "BASE"; vendors = await db.Vendors.AsNoTracking().Where(x => x.CompanyId == companyId).OrderBy(x => x.Name).ToListAsync(); warehouses = await db.Warehouses.AsNoTracking().Where(x => x.CompanyId == companyId && (x.Type == WarehouseType.Purchase || x.Type == WarehouseType.Both)).OrderBy(x => x.Name).ToListAsync(); currencies = await db.Currencies.AsNoTracking().Where(x => x.CompanyId == companyId).OrderBy(x => x.CurrencyCode).ToListAsync(); var taxes = await db.Taxes.AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); taxNames = taxes.ToDictionary(x => x.Id, x => x.TaxName); taxRates = taxes.ToDictionary(x => x.Id, x => x.Per); withholdingRates = await db.WithholdingTaxes.AsNoTracking().Where(x => x.CompanyId == companyId).ToDictionaryAsync(x => x.Id, x => x.PercentageValue); uoms = await db.UnitOfMeasures.AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); conversionRules = await db.UomConversionRules.AsNoTracking().Where(x => x.CompanyId == companyId && x.IsActive).ToListAsync(); projects = await db.Projects.AsNoTracking().Where(x => x.CompanyId == companyId).OrderBy(x => x.Name).ToListAsync(); items = await db.Items.Include(x => x.UomConversions).AsNoTracking().Include(x => x.PrimaryUom).Where(x => x.CompanyId == companyId).OrderBy(x => x.Name).ToListAsync(); requests = await Workflow.GetPurchaseRequestsAsync(companyId); }
    private void OnSearch(ChangeEventArgs e) { search = e.Value?.ToString() ?? ""; page = 1; }
    private void ShowRegister() { showCreate = false; message = ""; }
    private void NewRequest() { editingId = null; viewOnly = false; vendorId = warehouseId = currencyId = projectId = null; requestDate = DateTime.Now; documentTerms = new(); draftLines = new(); AddLine(); message = ""; showCreate = true; }
    private void OpenRequest(PurchaseRequest request)
    {
        editingId = request.Id; editingNumber = request.RequestNumber; viewOnly = request.Status is not (PurchaseRequestStatus.Draft or PurchaseRequestStatus.Open); vendorId = request.VendorId; warehouseId = request.WarehouseId; currencyId = request.CurrencyId; projectId = request.ProjectId; requestDate = request.RequestDate;
        documentTerms = new DestinationDocumentTerms { CurrencyId = request.CurrencyId, ExchangeRate = request.ExchangeRate, TaxId = request.TaxId, DiscountPercentage = request.DiscountPercentage, DiscountAmount = request.DiscountAmount, WithholdingTaxId = request.WithholdingTaxId, Confirmed = true };
        draftLines = request.Lines.Select(x => new PurchaseRequestLine { DimensionSetId = x.DimensionSetId,  Id = x.Id, ItemId = x.ItemId, Description = x.Description, QuantityRequested = x.QuantityRequested, UnitCost = x.UnitCost, UomId = x.UomId, UomName = x.UomName, UomConversionFactor = x.UomConversionFactor }).ToList(); message = ""; showCreate = true;
    }
    private void AddLine() => draftLines.Add(new PurchaseRequestLine { QuantityRequested = 1, UomConversionFactor = 1 });
    private void RemoveLine(PurchaseRequestLine line) { draftLines.Remove(line); if (draftLines.Count == 0) AddLine(); }
    private async Task OnVendorChanged(Guid? id) { vendorId = id; documentTerms.Confirmed = false; var vendor = vendors.FirstOrDefault(x => x.Id == id); await OnCurrencyChanged(vendor != null && currencies.Any(x => x.Id == vendor.CurrencyId) ? vendor.CurrencyId : null); }
    private async Task OnCurrencyChanged(Guid? id) { currencyId = id; documentTerms.CurrencyId = id ?? Guid.Empty; documentTerms.Confirmed = false; documentTerms.ExchangeRate = id.HasValue ? await CurrencyService.GetLatestExchangeRateAsync(companyId, id.Value) : 1m; }
    private void OnItemChanged(PurchaseRequestLine line, Guid? id) { var item = items.FirstOrDefault(x => x.Id == id); line.ItemId = item?.Id ?? Guid.Empty; line.UomId = item?.UomId; line.UomName = item?.PrimaryUom?.Name ?? item?.UoM ?? ""; line.UomConversionFactor = 1; line.QuantityRequested = 1; line.UnitCost = 0; }
    private void OnUomChanged(PurchaseRequestLine line, Guid? id) { var item = items.FirstOrDefault(x => x.Id == line.ItemId); if (item == null || !id.HasValue || !UomOptions(line).Any(x => x.Id == id)) return; line.UomId = id; line.UomName = uoms.FirstOrDefault(x => x.Id == id)?.Name ?? ""; line.UomConversionFactor = UomConversion.FactorFor(item, id, ConversionMap); }
    private static string Number(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);
    private static bool Parse(ChangeEventArgs e, out decimal value) => decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out value);
    private void SetQuantity(PurchaseRequestLine line, ChangeEventArgs e) { if (Parse(e, out var q)) line.QuantityRequested = UomConversion.ToBase(q, line.UomConversionFactor); }
    private void SetCost(PurchaseRequestLine line, ChangeEventArgs e) { if (Parse(e, out var c)) line.UnitCost = UomConversion.PriceToBase(c, line.UomConversionFactor); }
    private async Task SaveRequest(bool submit = true) { if (saving) return; if (!vendorId.HasValue || !currencyId.HasValue || requestDate == default) { message = "Select a vendor and currency, and enter a request date."; isError = true; return; } if (draftLines.Count == 0 || draftLines.Any(x => x.ItemId == Guid.Empty || x.QuantityRequested <= 0 || x.UnitCost < 0)) { message = "Each line needs an item, a quantity greater than zero and a non-negative unit cost."; isError = true; return; } if (!documentTerms.Confirmed || documentTerms.ExchangeRate <= 0 || documentTerms.DiscountPercentage < 0 || documentTerms.DiscountPercentage > 100 || documentTerms.DiscountAmount < 0 || (documentTerms.DiscountPercentage > 0 && documentTerms.DiscountAmount > 0)) { message = "Review the document terms and enter a valid exchange rate and discount."; isError = true; return; } saving = true; try { await using var db = await DbFactory.CreateDbContextAsync(); var tax = documentTerms.TaxId.HasValue ? await db.Taxes.AsNoTracking().FirstOrDefaultAsync(x => x.Id == documentTerms.TaxId && x.CompanyId == companyId) : null; var withholding = documentTerms.WithholdingTaxId.HasValue ? await db.WithholdingTaxes.AsNoTracking().FirstOrDefaultAsync(x => x.Id == documentTerms.WithholdingTaxId && x.CompanyId == companyId) : null; if ((documentTerms.TaxId.HasValue && tax == null) || (documentTerms.WithholdingTaxId.HasValue && withholding == null)) { message = "The selected tax or withholding is unavailable."; isError = true; return; } var request = new PurchaseRequest { Status = submit ? PurchaseRequestStatus.Open : PurchaseRequestStatus.Draft, Id = editingId ?? Guid.NewGuid(), RequestNumber = editingId.HasValue ? editingNumber : "", CompanyId = companyId, VendorId = vendorId ?? Guid.Empty, WarehouseId = warehouseId, CurrencyId = currencyId ?? Guid.Empty, RequestDate = requestDate, ProjectId = projectId, ExchangeRate = documentTerms.ExchangeRate, TaxId = tax?.Id, TaxGlAccountId = tax?.GLAccountId, DiscountPercentage = documentTerms.DiscountPercentage, DiscountAmount = documentTerms.DiscountAmount, WithholdingTaxId = withholding?.Id, WithholdingTaxName = withholding?.Name, WithholdingPercentage = withholding?.PercentageValue ?? 0, WithholdingGlAccountId = withholding?.WithholdingGlAccountId, Lines = draftLines.Select(x => new PurchaseRequestLine { DimensionSetId = x.DimensionSetId,  ItemId = x.ItemId, QuantityRequested = x.QuantityRequested, UnitCost = x.UnitCost, UomId = x.UomId, UomName = x.UomName, UomConversionFactor = x.UomConversionFactor, Description = x.Description }).ToList() }; message = await Workflow.SavePurchaseRequestAsync(request); isError = !string.IsNullOrEmpty(message); if (!isError) { showCreate = false; await LoadAsync(); message = $"Purchase request {request.RequestNumber} was saved."; } } finally { saving = false; } }
}
