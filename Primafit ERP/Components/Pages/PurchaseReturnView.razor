@page "/purchases/returns"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject CreditNoteService CnService
@inject PermissionCacheService PermissionCache
@rendermode InteractiveServer

<div class="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-2 border-b border-slate-200">
        <div class="space-y-1">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Purchase Returns</h1>
            <p class="text-sm text-slate-500 font-medium">Manage returns to vendors and inventory reversals.</p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-4">
            <div class="relative w-full sm:w-72">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search Return, Vendor or Bill..." class="w-full pl-9 pr-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all shadow-sm" />
            </div>

            <PermissionGate Key="PO_RETURN_MANAGE">
                <Authorized>
                    <button @onclick='() => Nav.NavigateTo("/purchases/returns/entry")' class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-rose-600 px-5 py-2.5 text-sm font-bold text-white shadow-md hover:bg-rose-700 transition-all hover:-translate-y-0.5 active:translate-y-0">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                        New Return
                    </button>
                </Authorized>
            </PermissionGate>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-16 text-center shadow-sm flex flex-col items-center justify-center">
            <div class="w-10 h-10 border-4 border-slate-200 border-t-slate-900 rounded-full animate-spin mb-4"></div>
            <p class="text-sm font-bold text-slate-400">Loading returns data...</p>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="px-6 py-4">Return # / Date</th>
                            <th class="px-6 py-4">Vendor</th>
                            <th class="px-6 py-4 w-[25%]">Items Returned (Qty)</th>
                            <th class="px-6 py-4">Ref Bill</th>
                            <th class="px-6 py-4 text-center">Status</th>
                            <th class="px-6 py-4 text-right">Value (Vendor)</th>
                            <th class="px-6 py-4 text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var r in FilteredReturns)
                        {
                            var currencyCode = currencies.ContainsKey(r.CurrencyId) ? currencies[r.CurrencyId] : "???";
                            var baseAmount = r.TotalAmount * r.ExchangeRate;
                            var vendorName = vendors.ContainsKey(r.VendorId) ? vendors[r.VendorId] : "Unknown";
                            var billNumber = bills.ContainsKey(r.VendorBillId) ? bills[r.VendorBillId] : "N/A";

                            <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                <td class="px-6 py-4">
                                    <div class="font-mono font-bold text-rose-700">@r.ReturnNumber</div>
                                    <div class="text-[11px] text-slate-500 font-medium mt-0.5">@r.ReturnDate.ToShortDateString()</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-800">@vendorName</div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (r.Lines.Any())
                                    {
                                        <div class="space-y-1.5">
                                            @foreach (var line in r.Lines.Take(2))
                                            {
                                                <div class="flex justify-between text-xs text-slate-600">
                                                    <span class="truncate pr-2 font-medium">@line.ItemName</span>
                                                    <span class="font-mono font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">x @line.QtyReturning.ToString("G29")</span>
                                                </div>
                                            }
                                            @if (r.Lines.Count > 2)
                                            {
                                                <div class="text-[10px] text-indigo-500 font-bold uppercase tracking-wider pt-1">
                                                    + @(r.Lines.Count - 2) more items
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-xs font-mono font-bold bg-slate-100 text-slate-600 px-2 py-1.5 rounded-md border border-slate-200 inline-block">
                                        @billNumber
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    @if (r.Status == ReturnStatus.Posted)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Posted</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Draft
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-slate-900">@r.TotalAmount.ToString("N2")</div>
                                    <div class="text-[9px] font-bold text-slate-400 uppercase tracking-wider mt-0.5">@currencyCode</div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <PermissionGate Key="PO_RETURN_MANAGE">
                                        <Authorized>
                                            <a href="/purchases/returns/entry/@r.Id" class="inline-flex items-center justify-center rounded-lg px-4 py-1.5 text-xs font-bold transition-colors @(r.Status == ReturnStatus.Draft ? "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                                                @(r.Status == ReturnStatus.Draft ? "Edit Draft" : "View Details")
                                            </a>
                                        </Authorized>
                                    </PermissionGate>
                                </td>
                            </tr>
                        }
                        @if (!FilteredReturns.Any())
                        {
                            <tr>
                                <td colspan="7" class="p-16 text-center text-slate-400">
                                    <svg class="w-12 h-12 mx-auto text-slate-200 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                    <p class="font-medium">No matching returns found.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private List<PurchaseReturn> returns = new();
    private string searchTerm = "";

    private Dictionary<Guid, string> vendors = new();
    private Dictionary<Guid, string> bills = new();
    private Dictionary<Guid, string> currencies = new();

    private IEnumerable<PurchaseReturn> FilteredReturns => string.IsNullOrWhiteSpace(searchTerm)
        ? returns
        : returns.Where(r =>
            r.ReturnNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (vendors.ContainsKey(r.VendorId) && vendors[r.VendorId].Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
            (bills.ContainsKey(r.VendorBillId) && bills[r.VendorBillId].Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("PURCHASING_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        // 1. Get the current user's Company ID
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId == null) return;
        var companyId = user.CompanyDetailsId.Value;

        using var ctx = await DbFactory.CreateDbContextAsync();

        // 2. Filter the query strictly by CompanyId
        returns = await ctx.PurchaseReturns
            .Where(r => r.CompanyId == companyId) 
            .Include(r => r.Lines)
            .OrderByDescending(r => r.ReturnDate)
            .AsNoTracking()
            .ToListAsync();

        var vendorIds = returns.Select(r => r.VendorId).Distinct().ToList();
        vendors = await ctx.Vendors.Where(v => vendorIds.Contains(v.Id)).ToDictionaryAsync(v => v.Id, v => v.Name);

        var billIds = returns.Select(r => r.VendorBillId).Distinct().ToList();
        bills = await ctx.VendorBills.Where(b => billIds.Contains(b.Id)).ToDictionaryAsync(b => b.Id, b => b.ExternalInvoiceNumber ?? "N/A");

        var currencyIds = returns.Select(r => r.CurrencyId).Distinct().ToList();
        currencies = await ctx.Currencies.Where(c => currencyIds.Contains(c.Id)).ToDictionaryAsync(c => c.Id, c => c.CurrencyCode);

        isLoading = false;
    }
}