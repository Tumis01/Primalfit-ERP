@code {
    [Parameter] public Guid? RouteBillId { get; set; }
    [SupplyParameterFromQuery] public Guid? billId { get; set; }
    [SupplyParameterFromQuery] public Guid? poId { get; set; }

    private int activeTab = 0;

    private VendorPayment payment = new();
    private List<Vendor> vendors = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<Tax> taxes = new();

    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private Guid currentCompanyId;
    private string companyName = "";
    private bool isBusy = false;
    private string currencySymbol = "";

    private Guid selectedVendorId = Guid.Empty;
    private Guid selectedBillId = Guid.Empty;
    private decimal amountPaidForeign = 0;

    private Guid selectedCurrencyId = Guid.Empty;
    private Guid selectedApAccountId = Guid.Empty;

    private bool HasBillSelected => selectedBillId != Guid.Empty;
    private BillRow? SelectedBill => openBills.FirstOrDefault(i => i.BillId == selectedBillId);

    // Email State
    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private Guid emailTargetBillId = Guid.Empty;
    private string emailVendorName = "";
    private string emailVendorAddress = "";
    private string emailSubject = "";
    private string customEmailMessage = "";

    // Filters & Pagination
    private int pageSize = 15;
    private int currentPage = 1;
    private string _statusFilter = "All";
    private string statusFilter
    {
        get => _statusFilter;
        set { _statusFilter = value; currentPage = 1; }
    }

    private IEnumerable<BillStatusRow> FilteredBillStatuses => billStatuses
        .Where(i => statusFilter == "All" || i.Status == statusFilter);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredBillStatuses.Count() / (double)pageSize));

    private IEnumerable<BillStatusRow> PagedBillStatuses => FilteredBillStatuses
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    public class BillRow
    {
        public Guid BillId { get; set; }
        public string RefNumber { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal TotalForeign { get; set; }
        public decimal TotalBase { get; set; }
        public decimal AmountPaidBase { get; set; }
        public decimal BalanceDueBase { get; set; }
        public decimal BalanceDueForeign { get; set; }
        public decimal ExchangeRate { get; set; }
        public Guid CurrencyId { get; set; }
        public Guid AccountsPayableGlId { get; set; }
        public List<VendorBillLine> Lines { get; set; } = new();
        public decimal DiscountAmountForeign { get; set; }
        public decimal SubTotalForeign { get; set; }
        public decimal TaxAmountForeign { get; set; }
        public string TaxDescription { get; set; } = "Tax";
    }

    public class BillStatusRow
    {
        public Guid BillId { get; set; }
        public string RefNumber { get; set; } = "";
        public string VendorName { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal GrandTotal { get; set; }
        public decimal AmountPaid { get; set; }
        public decimal BalanceDue { get; set; }
        public string Status { get; set; } = "";
        public string CurrencyCode { get; set; } = "";
    }

    private List<BillRow> openBills = new();
    private List<BillStatusRow> billStatuses = new();
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("AP_PAYMENT_PAGE"))
        {
            Nav.NavigateTo("/access-denied?page=PURCHASING_PAGE");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            currentCompanyId = user.CompanyDetailsId.Value;
            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null) companyName = company.CompanyName;

            using var ctx = await DbFactory.CreateDbContextAsync();

            vendors = await MasterService.GetVendorsAsync(currentCompanyId);
            currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);
            items = await MasterService.GetItemsAsync(currentCompanyId);
            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);
            taxes = await ctx.Taxes.Where(t => t.CompanyId == currentCompanyId).ToListAsync();

            bankAccounts = allAccounts.Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null &&
                       type.Description.Trim().Equals("Cash and Cash Equivalents", StringComparison.OrdinalIgnoreCase) &&
                       type.IsBalanceSheet == true &&
                       type.IsDebit == true;
            }).OrderBy(x => x.AccountCode).ToList();

            await LoadBillStatuses();
            await CreateNewAsync();

            Guid? actualTargetId = RouteBillId ?? billId;

            if (actualTargetId.HasValue && actualTargetId.Value != Guid.Empty)
            {
                activeTab = 1;
                var targetBill = await ctx.VendorBills.FindAsync(actualTargetId.Value);
                if (targetBill != null)
                {
                    await OnVendorChanged(new ChangeEventArgs { Value = targetBill.VendorId.ToString() });
                    OnBillChanged(new ChangeEventArgs { Value = targetBill.Id.ToString() });
                }
            }
            else if (poId.HasValue && poId.Value != Guid.Empty)
            {
                activeTab = 1;
                var targetBill = await ctx.VendorBills.FirstOrDefaultAsync(b => b.PurchaseOrderId == poId.Value);
                if (targetBill != null)
                {
                    await OnVendorChanged(new ChangeEventArgs { Value = targetBill.VendorId.ToString() });
                    OnBillChanged(new ChangeEventArgs { Value = targetBill.Id.ToString() });
                }
            }
        }
    }

    private async Task LoadBillStatuses()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        var bills = await ctx.VendorBills
            .Include(b => b.Payments)
            .Where(b => b.CompanyId == currentCompanyId && b.IsPosted)
            .OrderByDescending(b => b.BillDate)
            .ToListAsync();

        billStatuses.Clear();
        foreach (var bill in bills)
        {
            var vendor = vendors.FirstOrDefault(v => v.Id == bill.VendorId);
            var currency = currencies.FirstOrDefault(c => c.Id == bill.CurrencyId);

            decimal paidBase = bill.Payments?.Sum(p => p.Amount) ?? 0;
            decimal balanceBase = bill.TotalAmount - paidBase;

            decimal rate = bill.ExchangeRate > 0 ? bill.ExchangeRate : 1;
            decimal paidForeign = Math.Round(paidBase / rate, 2);
            decimal balanceForeign = Math.Round(balanceBase / rate, 2);

            string status = "Unpaid";
            if (balanceBase <= 0.01m) status = "Paid in Full";
            else if (paidBase > 0) status = "Partially Paid";

            billStatuses.Add(new BillStatusRow
            {
                BillId = bill.Id,
                RefNumber = string.IsNullOrEmpty(bill.ExternalInvoiceNumber) ? "NO-REF" : bill.ExternalInvoiceNumber,
                VendorName = vendor?.Name ?? "Unknown",
                Date = bill.BillDate,
                GrandTotal = bill.TotalAmountForeign,
                AmountPaid = paidForeign,
                BalanceDue = balanceForeign,
                Status = status,
                CurrencyCode = currency?.CurrencyCode ?? ""
            });
        }
    }
    private async Task CreateNewAsync()
    {
        payment = new VendorPayment
        {
            Date = DateTime.Today,
            BankGlAccountId = Guid.Empty // Explicitly empty
        };
        openBills.Clear();
        selectedBillId = Guid.Empty;
        selectedVendorId = Guid.Empty;
        selectedApAccountId = Guid.Empty;

        // Only preset if explicitly mapped in GL Mapping router
        Guid defaultBank = await MappingService.GetMappedAccountAsync(
            currentCompanyId,
            SystemTransactionType.VendorPayment,
            isDebit: false,
            defaultAccountId: Guid.Empty);

        if (defaultBank != Guid.Empty)
        {
            payment.BankGlAccountId = defaultBank;
        }

        if (currencies.Any())
        {
            var def = currencies.First();
            selectedCurrencyId = def.Id;
            currencySymbol = def.CurrencyCode;
        }
    }

    private async Task SelectAndLoadBill(BillStatusRow statusRow)
    {
        var targetVendor = vendors.FirstOrDefault(v => v.Name == statusRow.VendorName);
        if (targetVendor == null) return;

        isBusy = true; StateHasChanged();

        selectedVendorId = targetVendor.Id;

        // Resolve AP Control account override from GL router first, fallback to Vendor master
        Guid defaultApId = targetVendor.PayablesAccountId ?? Guid.Empty;
        selectedApAccountId = await MappingService.GetMappedAccountAsync(
            currentCompanyId,
            SystemTransactionType.VendorPayment,
            isDebit: true, // Debit leg = AP Liability Reduction
            defaultAccountId: defaultApId);

        await LoadVendorBills(targetVendor.Id);

        selectedBillId = statusRow.BillId;

        var loadedBill = openBills.FirstOrDefault(b => b.BillId == selectedBillId);
        if (loadedBill != null)
        {
            amountPaidForeign = Math.Round(loadedBill.BalanceDueForeign, 2);
            payment.Reference = loadedBill.RefNumber;
            selectedCurrencyId = loadedBill.CurrencyId;

            var currencyObj = currencies.FirstOrDefault(x => x.Id == loadedBill.CurrencyId);
            currencySymbol = currencyObj?.CurrencyCode ?? "";
        }

        activeTab = 1;
        isBusy = false;
        StateHasChanged();
    }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var venId) && venId != Guid.Empty)
        {
            selectedVendorId = venId;

            var vendor = vendors.FirstOrDefault(c => c.Id == venId);
            Guid defaultApId = vendor?.PayablesAccountId ?? Guid.Empty;

            // Resolve AP Control account override from GL router first, fallback to Vendor master
            selectedApAccountId = await MappingService.GetMappedAccountAsync(
                currentCompanyId,
                SystemTransactionType.VendorPayment,
                isDebit: true, // Debit leg = AP Liability Reduction
                defaultAccountId: defaultApId);

            await LoadVendorBills(venId);
            selectedBillId = Guid.Empty;
            amountPaidForeign = 0;
            payment.Reference = "";
        }
        else
        {
            selectedVendorId = Guid.Empty;
            selectedApAccountId = Guid.Empty;
            openBills.Clear();
            selectedBillId = Guid.Empty;
            amountPaidForeign = 0;
        }
    }

    private async Task LoadVendorBills(Guid vendorId)
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        var bills = await ctx.VendorBills
            .Include(b => b.Lines)
            .Include(b => b.Payments)
            .Where(b => b.CompanyId == currentCompanyId && b.VendorId == vendorId && b.IsPosted)
            .ToListAsync();

        var poIds = bills.Where(b => b.PurchaseOrderId.HasValue).Select(b => b.PurchaseOrderId!.Value).ToList();
        var relatedPOs = await ctx.PurchaseOrders
            .Where(p => poIds.Contains(p.Id))
            .ToDictionaryAsync(p => p.Id);

        openBills.Clear();

        foreach (var bill in bills.OrderBy(b => b.BillDate))
        {
            decimal paidBase = bill.Payments?.Sum(p => p.Amount) ?? 0;
            decimal balBase = bill.TotalAmount - paidBase;

            if (balBase > 0.01m)
            {
                decimal rate = bill.ExchangeRate > 0 ? bill.ExchangeRate : 1;
                decimal pSubTotal = bill.Lines.Sum(l => l.QuantityBilled * l.UnitCostBilled);

                decimal pDiscount = 0;
                decimal pTaxPer = 0;
                string pTaxDesc = "Tax / VAT";

                if (bill.PurchaseOrderId.HasValue && relatedPOs.TryGetValue(bill.PurchaseOrderId.Value, out var po))
                {
                    pDiscount = po.DiscountPercentage > 0
                                ? pSubTotal * (po.DiscountPercentage / 100)
                                : po.DiscountAmount;

                    if (po.TaxId.HasValue)
                    {
                        var taxObj = taxes.FirstOrDefault(t => t.Id == po.TaxId);
                        if (taxObj != null)
                        {
                            pTaxPer = taxObj.Per;
                            pTaxDesc = $"{taxObj.TaxName} ({taxObj.Per}%)";
                        }
                    }
                }

                decimal pNet = pSubTotal - pDiscount;
                decimal pTaxAmount = Math.Round(pNet * (pTaxPer / 100), 2);

                openBills.Add(new BillRow
                {
                    BillId = bill.Id,
                    RefNumber = string.IsNullOrEmpty(bill.ExternalInvoiceNumber) ? "NO-REF" : bill.ExternalInvoiceNumber,
                    Date = bill.BillDate,
                    TotalForeign = bill.TotalAmountForeign,
                    TotalBase = bill.TotalAmount,
                    AmountPaidBase = paidBase,
                    BalanceDueBase = balBase,
                    BalanceDueForeign = balBase / rate,
                    ExchangeRate = rate,
                    CurrencyId = bill.CurrencyId,
                    AccountsPayableGlId = bill.AccountsPayableGlId,
                    Lines = bill.Lines.ToList(),
                    SubTotalForeign = pSubTotal,
                    DiscountAmountForeign = pDiscount,
                    TaxAmountForeign = pTaxAmount,
                    TaxDescription = pTaxDesc
                });
            }
        }
    }

    private void OnBillChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var invId) && invId != Guid.Empty)
        {
            selectedBillId = invId;
            var bill = SelectedBill;

            if (bill != null)
            {
                amountPaidForeign = Math.Round(bill.BalanceDueForeign, 2);
                payment.Reference = bill.RefNumber;
                selectedCurrencyId = bill.CurrencyId;

                var c = currencies.FirstOrDefault(x => x.Id == bill.CurrencyId);
                currencySymbol = c?.CurrencyCode ?? "";
            }
        }
        else
        {
            selectedBillId = Guid.Empty;
            amountPaidForeign = 0;
            payment.Reference = "";
            currencySymbol = "";
        }
    }

    private async Task<(byte[] Bytes, string FileName, string Subject, string VendorEmail)> GetReceiptDataAsync(Guid targetBillId)
    {
        var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
        using var ctx = await DbFactory.CreateDbContextAsync();

        var bill = await ctx.VendorBills.Include(b => b.Payments).FirstOrDefaultAsync(b => b.Id == targetBillId);
        if (bill == null || company == null) return (null, "", "", "");

        var vendor = vendors.FirstOrDefault(v => v.Id == bill.VendorId);
        string vEmail = vendor?.Email ?? "";

        if (bill.PurchaseOrderId.HasValue)
        {
            var printOrder = await ctx.PurchaseOrders
                .Include(p => p.Lines)
                .Include(p => p.Currency)
                .FirstOrDefaultAsync(p => p.Id == bill.PurchaseOrderId.Value);

            if (printOrder != null)
            {
                var itemNamesMap = items.ToDictionary(i => i.Id, i => i.Name);

                decimal st = printOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
                decimal disc = printOrder.DiscountPercentage > 0 ? st * (printOrder.DiscountPercentage / 100) : printOrder.DiscountAmount;
                decimal taxP = taxes.FirstOrDefault(t => t.Id == printOrder.TaxId)?.Per ?? 0;
                printOrder.GrandTotalForeign = (st - disc) + ((st - disc) * (taxP / 100));

                var pdfBytes = ReportExportService.GeneratePurchaseOrderPdf(printOrder, company, vendor?.Name ?? "Vendor", vEmail, itemNamesMap);
                string fileName = $"Payment_Remittance_{bill.ExternalInvoiceNumber ?? bill.Id.ToString()[..8]}.pdf";
                string subject = $"Payment Remittance for Bill {bill.ExternalInvoiceNumber}";
                return (pdfBytes, fileName, subject, vEmail);
            }
        }

        return (null, "", "", "");
    }

    private async Task DownloadReceipt(Guid bId)
    {
        try
        {
            var data = await GetReceiptDataAsync(bId);
            if (data.Bytes == null)
            {
                await JS.InvokeVoidAsync("alert", "Failed to generate receipt. (Only PO-backed bills currently support PDF export).");
                return;
            }

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(data.Bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", data.FileName, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Download Error: {ex.Message}");
        }
    }

    private void PrepareEmailReceipt(Guid bId)
    {
        emailTargetBillId = bId;
        var row = billStatuses.FirstOrDefault(i => i.BillId == bId);
        var vendor = vendors.FirstOrDefault(c => c.Name == row?.VendorName);

        if (vendor != null && !string.IsNullOrWhiteSpace(vendor.Email))
        {
            emailVendorName = vendor.Name;
            emailVendorAddress = vendor.Email;
            emailSubject = $"Payment Remittance - Ref {row?.RefNumber}";

            customEmailMessage = $"Dear {vendor.Name},\n\nPlease find attached the payment remittance advice for Bill/Ref {row?.RefNumber}.\n\nCurrent Balance Remaining: {row?.CurrencyCode} {row?.BalanceDue:N2}\n\nThank you for your partnership!\n\nBest Regards,\nAccounts Payable Team\n{companyName}";

            showEmailPopup = true;
        }
        else
        {
            JS.InvokeVoidAsync("alert", "This vendor does not have an email address on file.");
        }
    }

    private async Task DispatchEmail()
    {
        isSendingEmail = true;
        try
        {
            var data = await GetReceiptDataAsync(emailTargetBillId);
            if (data.Bytes == null) throw new Exception("Failed to generate PDF attachment.");

            await EmailService.SendEmailAsync(
                emailVendorAddress,
                emailSubject,
                customEmailMessage.Replace("\n", "<br>"),
                data.Bytes,
                data.FileName
            );

            await JS.InvokeVoidAsync("alert", "Remittance advice emailed successfully!");
            showEmailPopup = false;
            emailTargetBillId = Guid.Empty;
            activeTab = 0;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}");
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    private async Task PromptEmailPopup(Vendor vendor, Guid targetBId, string billNum, decimal amountPaid, decimal remainingBalance, string currSymbol)
    {
        if (vendor != null && !string.IsNullOrWhiteSpace(vendor.Email))
        {
            emailTargetBillId = targetBId;
            emailVendorName = vendor.Name;
            emailVendorAddress = vendor.Email;
            emailSubject = $"Payment Remittance Advice - {billNum}";

            customEmailMessage = $"Dear {vendor.Name},\n\nWe have processed a payment of {currSymbol}{amountPaid:N2} against your invoice/bill {billNum}.\n\nRemaining Balance: {currSymbol}{remainingBalance:N2}.\n\nPlease find the official remittance advice attached.\n\nBest Regards,\nAccounts Payable Team\n{companyName}";

            showEmailPopup = true;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "✅ Payment Posted Successfully!\n(No email sent: Vendor missing email address).");
            activeTab = 0;
        }
    }

    private async Task PostPayment()
    {
        if (!HasBillSelected) { await JS.InvokeVoidAsync("alert", "Please select a Vendor Bill."); return; }
        if (amountPaidForeign <= 0) { await JS.InvokeVoidAsync("alert", "Amount paid must be greater than zero."); return; }
        if (payment.BankGlAccountId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a Pay From (Bank / Asset) account."); return; }
        if (selectedApAccountId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select an Accounts Payable liability account."); return; }

        if (SelectedBill != null && amountPaidForeign > SelectedBill.BalanceDueForeign + 0.01m)
        {
            await JS.InvokeVoidAsync("alert", $"Validation Error:\n\nPayment amount ({amountPaidForeign:N2}) cannot exceed the remaining balance due ({SelectedBill.BalanceDueForeign:N2}).");
            return;
        }

        isBusy = true;
        try
        {
            payment.VendorBillId = selectedBillId;
            payment.Amount = Math.Round(amountPaidForeign * SelectedBill!.ExchangeRate, 2);

            // Update user-selected AP account directly onto the bill prior to posting
            using (var ctx = await DbFactory.CreateDbContextAsync())
            {
                var billToUpdate = await ctx.VendorBills.FindAsync(selectedBillId);
                if (billToUpdate != null && billToUpdate.AccountsPayableGlId != selectedApAccountId)
                {
                    billToUpdate.AccountsPayableGlId = selectedApAccountId;
                    await ctx.SaveChangesAsync();
                }
            }

            var err = await PurchService.PostVendorPaymentAsync(payment, currentCompanyId, currentUserId);

            if (string.IsNullOrEmpty(err))
            {
                var vendor = vendors.FirstOrDefault(v => v.Id == selectedVendorId);
                Guid targetBId = selectedBillId;
                string billNum = SelectedBill.RefNumber;
                decimal amt = amountPaidForeign;
                decimal remBal = SelectedBill.BalanceDueForeign - amountPaidForeign;
                string cur = currencySymbol;

                await LoadVendorBills(selectedVendorId);
                await LoadBillStatuses();

                selectedBillId = Guid.Empty;
                amountPaidForeign = 0;
                payment.Reference = "";
                currencySymbol = "";

                await PromptEmailPopup(vendor, targetBId, billNum, amt, remBal, cur);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}