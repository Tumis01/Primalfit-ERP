@page "/ap/bill-entry/{Id:guid?}"
@using Microsoft.EntityFrameworkCore
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject BudgetService BudgetService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex items-center justify-between bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Vendor Bill Entry</h1>
            <p class="text-sm text-slate-500">
                @(currentBill.IsPosted ? "View Bill and Process Payments" : "Record incoming invoices and expenses.")
            </p>
        </div>
        
        @if (!currentBill.IsPosted)
        {
            <button @onclick="PostBill" disabled="@isBusy" class="px-6 py-2 bg-indigo-600 text-white font-bold rounded-lg shadow-md flex items-center gap-2 disabled:opacity-50 hover:bg-indigo-700 transition-colors">
                @if (isBusy)
                {
                    <span class="animate-spin">↻</span> <span>Processing...</span>
                }
                else
                {
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Post Bill</span>
                }
            </button>
        }
    </div>

    @if (currentCompanyId != Guid.Empty)
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <div class="lg:col-span-1 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4 h-fit">
                <h3 class="font-bold border-b pb-2 text-slate-800 uppercase text-xs tracking-wider">Bill Header</h3>

                <div class="bg-rose-50 p-3 rounded-lg border border-rose-100">
                    <div class="@(IsLocked ? "pointer-events-none opacity-70" : "")">
                        <SearchableGlAccount 
                            Label="Account Payable" 
                            Placeholder="Search AP Account..." 
                            Accounts="@liabilityAccounts" 
                            @bind-Value="currentBill.AccountsPayableGlId" 
                            IsInvalid="@(currentBill.AccountsPayableGlId == Guid.Empty)" />
                    </div>
                    <p class="text-[10px] text-rose-600 mt-1 font-bold">Liability increases (Credit).</p>
                </div>

                <div>
                    <label class="label">Vendor</label>
                    <select value="@currentBill.VendorId" @onchange="OnVendorChanged" class="input-class @(IsLocked ? "bg-slate-100 text-slate-500 cursor-not-allowed" : "")" disabled="@IsLocked">
                        <option value="@Guid.Empty">-- Select Vendor --</option>
                        @foreach (var v in vendors)
                        {
                            <option value="@v.Id">@v.Name</option>
                        }
                    </select>
                </div>

                @if(!string.IsNullOrEmpty(currencyCode))
                {
                    <div class="bg-indigo-50 p-3 rounded-lg border border-indigo-100 flex justify-between items-center text-xs">
                        <div class="font-bold text-indigo-700">
                            <span class="block text-[10px] text-indigo-400 uppercase">Transaction Currency</span>
                            @currencyCode
                        </div>
                        <div class="text-right">
                            <span class="block text-[10px] text-indigo-400 uppercase">Exchange Rate</span>
                            <span class="font-mono font-bold text-indigo-600">@currentBill.ExchangeRate.ToString("N4")</span>
                        </div>
                    </div>
                }

                <div>
                    <label class="label">Link to PO (Import)</label>
                    <select value="@(currentBill.PurchaseOrderId?.ToString() ?? "")" @onchange="OnPoChanged" class="input-class border-indigo-200 font-medium text-indigo-700 bg-indigo-50/30" disabled="@(currentBill.VendorId == Guid.Empty || currentBill.IsPosted)">
                        <option value="">-- Direct Expense (No PO) --</option>
                        @foreach (var po in openPOs.Where(p => p.VendorId == currentBill.VendorId))
                        {
                            <option value="@po.Id">@po.OrderNumber (@po.OrderDate.ToString("MM/dd"))</option>
                        }
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="label">Invoice #</label>
                        <input @bind="currentBill.ExternalInvoiceNumber" class="input-class font-mono uppercase" placeholder="INV-..." disabled="@currentBill.IsPosted" />
                    </div>
                    <div>
                        <label class="label">Bill Date</label>
                        <input type="date" @bind="currentBill.BillDate" class="input-class" disabled="@currentBill.IsPosted" />
                    </div>
                </div>

                <div class="pt-4 border-t border-slate-100">
                    <label class="label text-slate-600">Total Amount (@(currencyCode ?? "Base"))</label>
                    <div class="relative">
                        <span class="absolute left-3 top-2.5 text-slate-400 font-bold text-sm">@currencySymbol</span>
                        <input type="number" step="0.01" @bind="currentBill.TotalAmountForeign" 
                               class="input-class pl-8 font-bold text-lg text-slate-900 @(IsLocked ? "bg-slate-100 text-slate-500" : "")" 
                               placeholder="0.00" 
                               readonly="@IsLocked" />
                    </div>
                    
                    <div class="mt-2 flex justify-between items-center bg-slate-50 p-2 rounded text-xs border border-slate-100">
                        <span class="font-bold text-slate-400 uppercase">Total Amount (Base Currency)</span>
                        <div class="font-mono font-bold text-emerald-600">
                            @((currentBill.TotalAmountForeign * currentBill.ExchangeRate).ToString("N2"))
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-6">
                
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-4 flex flex-col h-fit">
                    <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-2">
                        <h3 class="font-bold text-slate-700 uppercase text-xs tracking-wider">Expense Allocation</h3>
                        @if (!IsLocked)
                        {
                            <button @onclick="AddLine" class="text-xs font-bold text-indigo-600 bg-indigo-50 border border-indigo-100 px-3 py-1.5 rounded hover:bg-indigo-100 transition-colors flex items-center gap-1">
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Line
                            </button>
                        }
                    </div>
                    
                    <div class="overflow-visible flex-1"> 
                        <table class="w-full text-left text-sm">
                            <thead class="text-xs uppercase font-bold text-slate-500 border-b bg-slate-50/50">
                                <tr>
                                    <th class="px-2 py-2 w-[25%]">Item </th>
                                    <th class="px-2 py-2 text-right w-[10%]">Qty</th>
                                    <th class="px-2 py-2 text-right w-[15%]">Cost</th>
                                    <th class="px-2 py-2 text-right w-[15%]">Total</th>
                                    <th class="px-2 py-2 w-[5%]"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var line in currentBill.Lines)
                                {
                                    <tr class="group hover:bg-slate-50 transition-colors">
                                        @* <td class="px-2 py-2 align-top">
                                            <div class="@(IsLocked ? "pointer-events-none opacity-60" : "")">
                                                <SearchableGlAccount Label="" Placeholder="Select GL..." Accounts="@expenseAccounts" @bind-Value="line.ExpenseGlAccountId" IsInvalid="@(line.ExpenseGlAccountId == Guid.Empty)" />
                                            </div>
                                        </td> *@
                                        <td class="px-2 py-2 align-top">
                                            <div class="@(IsLocked ? "pointer-events-none opacity-60" : "")">
                                                <SearchableItem Label="" Items="@items" @bind-Value="line.ItemId" OnSelectionChanged="@(() => UpdateLineGl(line))" />
                                            </div>
                                        </td>
                                        <td class="px-0 py-2 align-top pt-3">
                                            <input type="number" @bind="line.QuantityBilled" class="input-class py-2 text-center text-xs font-bold @(IsLocked ? "bg-slate-100 text-slate-500" : "")" readonly="@IsLocked" />
                                        </td>
                                        <td class="px-2 py-2 align-top pt-3">
                                            <input type="number" step="0.01" @bind="line.UnitCostBilled" class="input-class py-2 text-right text-xs font-mono @(IsLocked ? "bg-slate-100 text-slate-500" : "")" readonly="@IsLocked" />
                                        </td>
                                        <td class="px-2 py-2 align-top pt-4 text-right font-mono font-bold text-slate-700">
                                            @((line.QuantityBilled * line.UnitCostBilled).ToString("N2"))
                                        </td>
                                        <td class="px-2 py-2 align-top pt-4 text-center">
                                            @if (!IsLocked)
                                            {
                                                <button @onclick="() => currentBill.Lines.Remove(line)" class="text-slate-400 hover:text-red-500 transition-colors opacity-0 group-hover:opacity-100">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="border-t border-slate-200 bg-slate-50">
                                <tr>
                                    <td colspan="4" class="px-4 py-3 text-right font-bold text-slate-500 text-xs uppercase">Calculated Total</td>
                                    <td class="px-2 py-3 text-right font-mono font-bold text-lg text-slate-900">
                                        @currentBill.Lines.Sum(l => l.QuantityBilled * l.UnitCostBilled).ToString("N2")
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                @if (currentBill.IsPosted)
                {
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 animate-in slide-in-from-bottom-4">
                        <h3 class="font-bold text-slate-700 uppercase text-xs tracking-wider border-b border-slate-100 pb-2 mb-4">Payment Tracking</h3>
                        
                        <div class="grid grid-cols-3 gap-4 mb-6">
                            <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl text-center">
                                <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Total Bill (@currencyCode)</div>
                                <div class="text-xl font-mono font-black text-slate-900">@currentBill.TotalAmountForeign.ToString("N2")</div>
                            </div>
                            <div class="bg-emerald-50 border border-emerald-100 p-4 rounded-xl text-center">
                                <div class="text-[10px] text-emerald-600 uppercase font-bold mb-1">Amount Paid</div>
                                <div class="text-xl font-mono font-black text-emerald-700">@currentBill.AmountPaid.ToString("N2")</div>
                            </div>
                            <div class="bg-rose-50 border border-rose-100 p-4 rounded-xl text-center">
                                <div class="text-[10px] text-rose-600 uppercase font-bold mb-1">Balance Due</div>
                                <div class="text-xl font-mono font-black text-rose-700">@currentBill.BalanceDue.ToString("N2")</div>
                            </div>
                        </div>

                        @if (!currentBill.IsFullyPaid)
                        {
                            <div class="flex items-end gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
                                <div>
                                    <label class="label">Date</label>
                                    <input type="date" @bind="newPayment.Date" class="input-class" />
                                </div>
                                <div class="flex-1">
                                    <SearchableGlAccount Label="Bank Account (Cr)" Placeholder="Select Bank..." Accounts="@bankAccounts" @bind-Value="newPayment.BankGlAccountId" IsInvalid="@(newPayment.BankGlAccountId == Guid.Empty)" />
                                </div>
                                <div class="w-32">
                                    <label class="label">Amount (@currencyCode)</label>
                                    <input type="number" step="0.01" @bind="newPayment.Amount" class="input-class font-mono font-bold text-emerald-700" />
                                </div>
                                <div>
                                    <label class="label">Reference</label>
                                    <input type="text" @bind="newPayment.Reference" class="input-class" placeholder="" />
                                </div>
                                <button @onclick="ProcessPayment" disabled="@isPaymentBusy" class="px-5 py-2.5 bg-emerald-600 text-white font-bold rounded-lg shadow-sm hover:bg-emerald-700 disabled:opacity-50 transition-colors h-[42px] flex items-center">
                                    @if(isPaymentBusy) { <span class="animate-spin">↻</span> } else { <span>Pay</span> }
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="text-center p-4 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-xl font-bold uppercase tracking-wider text-sm flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                Invoice Fully Paid & PO Closed
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading context...
        </div>
    }
</div>

<style>
    .label { display: block; font-size: 0.70rem; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
    .input-class { width: 100%; border-radius: 0.5rem; border: 1px solid #cbd5e1; padding: 0.5rem 0.75rem; font-size: 0.875rem; transition: all 0.2s; background-color: #fff; outline: none; }
    .input-class:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15); }
    .input-class[readonly], .input-class[disabled] { background-color: #f8fafc; color: #94a3b8; cursor: not-allowed; border-color: #e2e8f0; }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery] public Guid? PoId { get; set; }

    private VendorBill currentBill = new();
    private VendorPayment newPayment = new(); // NEW: Payment Model
    
    private List<Vendor> vendors = new();
    private List<PurchaseOrder> openPOs = new();
    private List<Item> items = new();
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> liabilityAccounts = new();
    private List<SegChartOfAccount> expenseAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegAccountType> accountTypes = new();
    
    private Guid currentCompanyId;
    private bool isBusy = false;
    private bool isPaymentBusy = false;
    private string currencyCode = "";
    private string currencySymbol = "$";
    
    private bool IsLocked => currentBill.IsPosted || (currentBill.PurchaseOrderId.HasValue && currentBill.PurchaseOrderId != Guid.Empty);

    // === INITIALIZATION ===
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        
        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            
            // Parallel Load for Performance
            var t1 = MasterService.GetVendorsAsync(currentCompanyId);
            var t2 = MasterService.GetItemsAsync(currentCompanyId);
            var t3 = PurchService.GetPOsReadyForInvoicingAsync(currentCompanyId);
            var t4 = SegCoaService.GetAccountTypesAsync();
            var t5 = SegCoaService.GetActiveCoaAsync(currentCompanyId);

            await Task.WhenAll(t1, t2, t3, t4, t5);

            vendors = t1.Result;
            items = t2.Result;
            openPOs = t3.Result;
            accountTypes = t4.Result;
            allAccounts = t5.Result;

            // 1. Filter AP Accounts (Liabilities: Balance Sheet = True, Debit = False)
            liabilityAccounts = allAccounts.Where(a => 
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.IsBalanceSheet == true && type.IsDebit == false;
            }).OrderBy(x => x.AccountCode).ToList();

            // 2. Filter Expense/Asset Accounts (Debits: IsDebit = True)
            expenseAccounts = allAccounts.Where(a => 
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.IsDebit == true;
            }).OrderBy(x => x.AccountCode).ToList();
            
            // 3. Filter Bank/Cash Accounts for Payments
            bankAccounts = allAccounts.Where(a => 
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.Description.Equals("Cash and Cash Equivalents", StringComparison.OrdinalIgnoreCase);
            }).OrderBy(x => x.AccountCode).ToList();

            // --- ROUTING LOGIC ---
            if (Id.HasValue && Id.Value != Guid.Empty)
            {
                // ROUTE A: LOAD EXISTING POSTED BILL (Direct ID from URL)
                await LoadExistingBill(Id.Value);
            }
            else if (PoId.HasValue && PoId.Value != Guid.Empty)
            {
                // ROUTE B: ROUTED FROM PURCHASE ORDER PAGE (Using ?poId=...)
                using var ctx = await DbFactory.CreateDbContextAsync();
                
                // Check if a Bill was already Auto-Posted for this PO
                var existingBill = await ctx.VendorBills.FirstOrDefaultAsync(b => b.PurchaseOrderId == PoId.Value);

                if (existingBill != null)
                {
                    // Load the existing bill so they can make payments!
                    await LoadExistingBill(existingBill.Id);
                }
                else
                {
                    // Fallback to Draft mode if no bill exists yet
                    CreateNew();
                    
                    var targetPO = openPOs.FirstOrDefault(p => p.Id == PoId.Value);
                    if (targetPO != null)
                    {
                        currentBill.VendorId = targetPO.VendorId;
                        var data = await PurchService.GetVendorCurrencyDataAsync(targetPO.VendorId, currentCompanyId);
                        
                        currentBill.CurrencyId = data.CurrencyId;
                        currencyCode = data.CurrencyCode;
                        currentBill.ExchangeRate = targetPO.ExchangeRate > 0 ? targetPO.ExchangeRate : data.Rate;

                        // Trigger the PO mapping
                        OnPoChanged(new ChangeEventArgs { Value = targetPO.Id.ToString() });
                    }
                }
            }
            else
            {
                // ROUTE C: COMPLETELY NEW MANUAL BILL
                CreateNew();
            }
        }
    }

    // --- HELPER METHOD TO LOAD EXISTING BILLS & PAYMENTS ---
    private async Task LoadExistingBill(Guid billId)
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        
        currentBill = await ctx.VendorBills
            .Include(b => b.Lines)
            .Include(b => b.Payments)
            .FirstOrDefaultAsync(b => b.Id == billId) ?? new VendorBill();

        if (currentBill.VendorId != Guid.Empty)
        {
            var data = await PurchService.GetVendorCurrencyDataAsync(currentBill.VendorId, currentCompanyId);
            currencyCode = data.CurrencyCode;
        }

        // Pre-fill the payment input with the remaining balance
        newPayment = new VendorPayment 
        { 
            VendorBillId = currentBill.Id, 
            Amount = currentBill.BalanceDue 
        }; 
    }

    private void CreateNew() 
    {
        currentBill = new VendorBill 
        { 
            CompanyId = currentCompanyId, 
            BillDate = DateTime.Today, 
            Lines = new List<VendorBillLine> { new VendorBillLine() } 
        }; 
    }
   
    private void AddLine() => currentBill.Lines.Add(new VendorBillLine());

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var vId))
        {
            currentBill.VendorId = vId;
            var data = await PurchService.GetVendorCurrencyDataAsync(vId, currentCompanyId);
            
            currentBill.CurrencyId = data.CurrencyId;
            currentBill.ExchangeRate = data.Rate;
            currencyCode = data.CurrencyCode;
            
            currentBill.PurchaseOrderId = null;
            currentBill.Lines.Clear();
            AddLine();
        }
    }

    private void OnPoChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var poId))
        {
            currentBill.PurchaseOrderId = poId;
            var po = openPOs.FirstOrDefault(p => p.Id == poId);
            
            if (po != null)
            {
                currentBill.ExternalInvoiceNumber = po.OrderNumber; 
                
                if(po.ExchangeRate > 0) 
                {
                    // REQUIREMENT 4: IMPORT EXCHANGE RATE FROM PO
                    currentBill.ExchangeRate = po.ExchangeRate;
                    currentBill.CurrencyId = po.CurrencyId;
                }

                currentBill.Lines.Clear();
                decimal totalForeign = 0;

                foreach (var poLine in po.Lines)
                {
                    var item = items.FirstOrDefault(i => i.Id == poLine.ItemId);
                    
                    Guid defaultGl = Guid.Empty;
                    if(item != null)
                    {
                        defaultGl = item.IsService ? item.CostOfGoodsSoldAccountId : item.InventoryAssetAccountId;
                    }

                    var newLine = new VendorBillLine
                    {
                        ItemId = poLine.ItemId,
                        QuantityBilled = poLine.QuantityOrdered,
                        UnitCostBilled = poLine.UnitCost, 
                        ExpenseGlAccountId = defaultGl
                    };
                    
                    currentBill.Lines.Add(newLine);
                    totalForeign += (newLine.QuantityBilled * newLine.UnitCostBilled);
                }

                currentBill.TotalAmountForeign = Math.Round(totalForeign, 2);
                currentBill.TotalAmount = currentBill.TotalAmountForeign * currentBill.ExchangeRate;
            }
        }
        else
        {
            currentBill.PurchaseOrderId = null;
        }
    }

    private void UpdateLineGl(VendorBillLine line)
    {
        var item = items.FirstOrDefault(i => i.Id == line.ItemId);
        if (item != null)
        {
            line.ExpenseGlAccountId = item.IsService ? item.CostOfGoodsSoldAccountId : item.InventoryAssetAccountId;
        }
    }

    private async Task PostBill()
    {
        if (currentBill.VendorId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "STOP: Select a Vendor."); return; }
        if (currentBill.AccountsPayableGlId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "STOP: Select an AP Account."); return; }
        if (!currentBill.Lines.Any()) { await JS.InvokeVoidAsync("alert", "STOP: Add a line."); return; }

        if (currentBill.PurchaseOrderId != null)
        {
            bool hasReceipt = await PurchService.CheckIfPoHasReceipts(currentBill.PurchaseOrderId.Value);
            if (!hasReceipt)
            {
                await JS.InvokeVoidAsync("alert", "STOP: No Goods Receipt found.\n\nYou must Receive Goods (GRN) before posting the invoice.");
                return;
            }
        }

        decimal calcTotalForeign = Math.Round(currentBill.Lines.Sum(l => l.QuantityBilled * l.UnitCostBilled), 2);
        if (currentBill.TotalAmountForeign == 0 && calcTotalForeign > 0) 
            currentBill.TotalAmountForeign = calcTotalForeign;

        currentBill.TotalAmount = currentBill.TotalAmountForeign * currentBill.ExchangeRate;

        isBusy = true;
        try
        {
            var budgetRequests = currentBill.Lines
                .Where(l => l.ExpenseGlAccountId != Guid.Empty)
                .Select(l => (
                    SegCoaId: l.ExpenseGlAccountId, 
                    Amount: (l.QuantityBilled * l.UnitCostBilled) * currentBill.ExchangeRate
                )).ToList();

            if (budgetRequests.Any())
            {
                string budgetError = await BudgetService.ValidateFundsAsync(currentBill.CompanyId, budgetRequests);
                if (!string.IsNullOrEmpty(budgetError))
                {
                    await JS.InvokeVoidAsync("alert", $"BUDGET STOP:\n\n{budgetError}");
                    isBusy = false; return; 
                }
            }

            var saveErr = await PurchService.SaveVendorBillAsync(currentBill);
            if (!string.IsNullOrEmpty(saveErr)) throw new Exception(saveErr);

            if (currentBill.PurchaseOrderId != null)
            {
                var matchRes = await PurchService.ValidateThreeWayMatch(currentBill.Id);
                if (!string.IsNullOrEmpty(matchRes) && matchRes.Contains("Variance")) 
                { 
                    await JS.InvokeVoidAsync("alert", $"Bill Saved but BLOCKED.\n\n{matchRes}"); 
                    isBusy = false; return; 
                }
            }

            var postErr = await PurchService.PostVendorBillAsync(currentBill.Id);
            
            if (string.IsNullOrEmpty(postErr)) 
            { 
                await JS.InvokeVoidAsync("alert", "✅ Bill Posted Successfully!"); 
                // Instead of clearing, just reload so user can pay it immediately!
                Nav.NavigateTo($"/ap/bill-entry/{currentBill.Id}", forceLoad: true);
            }
            else 
            { 
                await JS.InvokeVoidAsync("alert", "❌ " + postErr); 
            }
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", "Error: " + ex.Message); }
        finally { isBusy = false; }
    }

    // --- NEW: PROCESS PAYMENT DIRECTLY ON BILL ---
    private async Task ProcessPayment()
    {
        if (newPayment.BankGlAccountId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Select a Bank Account."); return; }
        if (newPayment.Amount <= 0) { await JS.InvokeVoidAsync("alert", "Amount must be greater than zero."); return; }
        if (newPayment.Amount > currentBill.BalanceDue) { await JS.InvokeVoidAsync("alert", "Cannot pay more than the balance due."); return; }

        isPaymentBusy = true;
        try
        {
            newPayment.VendorBillId = currentBill.Id;
            var err = await PurchService.PostVendorPaymentAsync(newPayment, currentCompanyId);

            if (string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", "Payment Processed!");
                
                // Reload bill to get updated payments list
                using var ctx = await DbFactory.CreateDbContextAsync();
                currentBill = await ctx.VendorBills.Include(b => b.Lines).Include(b => b.Payments).FirstAsync(b => b.Id == currentBill.Id);
                
                newPayment = new VendorPayment { VendorBillId = currentBill.Id, Amount = currentBill.BalanceDue };
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", "Payment Error: " + ex.Message); }
        finally { isPaymentBusy = false; }
    }
}