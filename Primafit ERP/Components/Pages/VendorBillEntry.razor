@page "/ap/bill-entry"
@page "/ap/bill-entry/{RouteBillId:guid}"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject CurrencyService CurrService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Make Payment</h1>
            <p class="text-sm text-slate-500">Record outgoing money against a specific vendor bill.</p>
        </div>
        <div class="flex items-center gap-4">
            <button @onclick="PostPayment" disabled="@isBusy" class="px-6 py-2.5 bg-emerald-600 text-white font-bold rounded-xl shadow-md hover:bg-emerald-700 disabled:opacity-50 flex items-center gap-2 transition-all active:scale-95">
                @if (isBusy)
                {
                    <span class="animate-spin">↻</span> <span>Processing...</span>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    <span>Post Payment</span>
                }
            </button>
        </div>
    </div>

    @if (currentCompanyId != Guid.Empty)
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <div class="lg:col-span-4 space-y-6">
                
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-bold border-b border-slate-100 pb-2 text-slate-800 uppercase text-xs tracking-wider">Transaction Details</h3>

                    <div>
                        <label class="label">Date Paid</label>
                        <input type="date" @bind="payment.Date" class="input-class" />
                    </div>

                    <div>
                        <label class="label">Vendor</label>
                        <select value="@selectedVendorId" @onchange="OnVendorChanged" class="input-class font-bold text-slate-900 border-indigo-200 bg-indigo-50/30">
                            <option value="@Guid.Empty">-- Select Vendor --</option>
                            @foreach (var v in vendors)
                            {
                                <option value="@v.Id">@v.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="label text-indigo-600">Vendor Bill / Invoice Ref</label>
                        <select value="@selectedBillId" @onchange="OnBillChanged" class="input-class border-indigo-200 bg-indigo-50/30 font-bold" disabled="@(selectedVendorId == Guid.Empty)">
                            <option value="@Guid.Empty">-- Select Bill --</option>
                            @foreach (var bill in openBills)
                            {
                                <option value="@bill.BillId">@bill.RefNumber (Due: @bill.BalanceDueForeign.ToString("N2"))</option>
                            }
                        </select>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="label">Currency</label>
                            <select value="@(SelectedBill?.CurrencyId ?? Guid.Empty)" class="input-class bg-slate-50 text-slate-500 cursor-not-allowed" disabled>
                                <option value="@Guid.Empty">N/A</option>
                                @foreach (var c in currencies)
                                {
                                    <option value="@c.Id">@c.CurrencyCode</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="label">Exchange Rate</label>
                            <input type="number" step="0.0001" value="@(SelectedBill?.ExchangeRate ?? 1)" class="input-class font-mono text-right bg-slate-50 text-slate-500 cursor-not-allowed" readonly />
                        </div>
                    </div>

                    <div>
                        <label class="label">Reference (Cheque / Transfer)</label>
                        <input type="text" @bind="payment.Reference" class="input-class" placeholder="e.g. TRF-90210" />
                    </div>

                    <div class="pt-2">
                        <label class="label text-emerald-700">Amount Paid (@currencySymbol)</label>
                        <div class="relative">
                            <span class="absolute left-3 top-2.5 text-slate-400 font-bold text-sm">@currencySymbol</span>
                            <input type="number" step="0.01" @bind="amountPaidForeign" class="input-class pl-8 font-bold text-xl text-emerald-700 border-emerald-200 bg-emerald-50 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100" placeholder="0.00" />
                        </div>
                        
                        @if (HasBillSelected)
                        {
                            <div class="mt-2 flex justify-between items-center bg-slate-50 p-2 rounded text-xs border border-slate-100">
                                <span class="font-bold text-slate-400 uppercase">Ledger Value (Base)</span>
                                <div class="font-mono font-bold text-emerald-600">
                                    @((amountPaidForeign * SelectedBill!.ExchangeRate).ToString("N2"))
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-bold border-b border-slate-100 pb-2 text-slate-800 uppercase text-xs tracking-wider flex items-center justify-between">
                        GL Mapping
                        <span class="text-[10px] text-slate-400 font-normal normal-case">Required</span>
                    </h3>

                    <div class="space-y-3">
                        <div>
                            <SearchableGlAccount Label="Pay From (Bank / Asset)" 
                                                 Placeholder="Search Bank..." 
                                                 Accounts="@bankAccounts" 
                                                 @bind-Value="payment.BankGlAccountId" 
                                                 IsInvalid="@(payment.BankGlAccountId == Guid.Empty)" />
                        </div>
                        
                        <div>
                            <label class="label">Accounts Payable (Liability)</label>
                            <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-500 flex items-center justify-between cursor-not-allowed">
                                <span class="font-bold">@VendorApAccountName</span>
                                <svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            </div>
                            <p class="text-[10px] text-slate-400 mt-1">This account was credited during bill posting.</p>
                        </div>
                    </div>
                </div>

            </div>

            <div class="lg:col-span-8">
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-visible flex flex-col h-full min-h-[600px]">
                    
                    @if (SelectedBill != null)
                    {
                        <div class="p-6 border-b border-slate-100 bg-slate-50/50">
                            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">
                                Bill Tracking: <span class="text-indigo-600 font-mono ml-2">@SelectedBill.RefNumber</span>
                            </h3>
                            
                            <div class="grid grid-cols-3 gap-4 animate-in slide-in-from-bottom-2">
                                <div class="bg-white border border-slate-200 p-4 rounded-xl text-center shadow-sm">
                                    <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Total Bill (@currencySymbol)</div>
                                    <div class="text-xl font-mono font-black text-slate-900">@SelectedBill.TotalForeign.ToString("N2")</div>
                                </div>
                                <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl text-center shadow-sm">
                                    <div class="text-[10px] text-emerald-700 uppercase font-bold mb-1">Amount Paid</div>
                                    <div class="text-xl font-mono font-black text-emerald-700">@((SelectedBill.TotalForeign - SelectedBill.BalanceDueForeign).ToString("N2"))</div>
                                </div>
                                <div class="bg-rose-50 border border-rose-200 p-4 rounded-xl text-center shadow-sm">
                                    <div class="text-[10px] text-rose-700 uppercase font-bold mb-1">Balance Due</div>
                                    <div class="text-xl font-mono font-black text-rose-700">@SelectedBill.BalanceDueForeign.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Expense Allocation</h3>
                        </div>
                    }

                    <div class="overflow-x-auto flex-1 p-6">
                        @if (SelectedBill != null)
                        {
                            <table class="w-full text-left text-sm border border-slate-200 rounded-lg overflow-hidden">
                                <thead class="text-[10px] uppercase font-extrabold text-slate-500 bg-slate-50 border-b border-slate-200 tracking-wider">
                                    <tr>
                                        <th class="px-4 py-3 w-[45%]">Item / Service</th>
                                        <th class="px-4 py-3 text-center">Qty</th>
                                        <th class="px-4 py-3 text-right">Unit Cost</th>
                                        <th class="px-4 py-3 text-right pr-6">Total (@currencySymbol)</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in SelectedBill.Lines)
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="px-4 py-3 font-medium text-slate-800">@(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Ad-Hoc Expense")</td>
                                            <td class="px-4 py-3 text-center font-mono font-bold text-slate-600">@line.QuantityBilled.ToString("N2")</td>
                                            <td class="px-4 py-3 text-right font-mono text-slate-500">@line.UnitCostBilled.ToString("N2")</td>
                                            <td class="px-4 py-3 pr-6 text-right font-mono font-bold text-slate-700">@((line.QuantityBilled * line.UnitCostBilled).ToString("N2"))</td>
                                        </tr>
                                    }
                                </tbody>
                                
                                <tfoot class="bg-slate-50 border-t-2 border-slate-200 text-right text-slate-600">
                                    <tr>
                                        <td colspan="3" class="px-4 py-2 font-bold text-xs uppercase tracking-wider">Subtotal:</td>
                                        <td class="px-4 py-2 pr-6 font-mono font-bold text-slate-700">@SelectedBill.SubTotalForeign.ToString("N2")</td>
                                    </tr>
                                    @if (SelectedBill.DiscountAmountForeign > 0)
                                    {
                                        <tr class="text-rose-600">
                                            <td colspan="3" class="px-4 py-2 font-bold text-xs uppercase tracking-wider">Discount:</td>
                                            <td class="px-4 py-2 pr-6 font-mono font-bold">- @SelectedBill.DiscountAmountForeign.ToString("N2")</td>
                                        </tr>
                                    }
                                    @if (SelectedBill.TaxAmountForeign > 0)
                                    {
                                        <tr>
                                            <td colspan="3" class="px-4 py-2 font-bold text-xs uppercase tracking-wider">@SelectedBill.TaxDescription:</td>
                                            <td class="px-4 py-2 pr-6 font-mono font-bold">+ @SelectedBill.TaxAmountForeign.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr class="text-slate-900 bg-slate-100/50 border-t border-slate-200">
                                        <td colspan="3" class="px-4 py-3 font-black uppercase text-xs tracking-wider">Grand Total:</td>
                                        <td class="px-4 py-3 pr-6 font-mono font-black text-lg text-rose-700">@currencySymbol@SelectedBill.TotalForeign.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        }
                        else
                        {
                            <div class="p-16 text-center text-slate-400 border-2 border-dashed border-slate-200 rounded-2xl m-4">
                                <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                Please select a Vendor and a Bill to view line items.
                            </div>
                        }
                    </div>
                    
                    @if (SelectedBill != null)
                    {
                        <div class="border-t border-slate-200 bg-slate-50 p-5 grid grid-cols-12 gap-4 items-center mt-auto rounded-b-2xl">
                            <div class="col-span-8 text-right text-[10px] font-black text-slate-500 uppercase tracking-wider">Payment Currently Applying:</div>
                            <div class="col-span-4 text-right font-mono font-black text-emerald-600 text-2xl">@currencySymbol@amountPaidForeign.ToString("N2")</div>
                        </div>
                    }
                </div>
            </div>

        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading context...
        </div>
    }
</div>

<style>
    .label { display: block; font-size: 0.70rem; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
    .input-class { width: 100%; border-radius: 0.5rem; border: 1px solid #cbd5e1; padding: 0.5rem 0.75rem; font-size: 0.875rem; color: #0f172a; outline: none; transition: border-color 0.2s; }
    .input-class:focus { border-color: #10b981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15); }
    .input-class:disabled, .input-class[readonly] { background-color: #f8fafc; color: #94a3b8; cursor: not-allowed; border-color: #e2e8f0; }
</style>

@code {
    // FIX 1: Routing resolution! Added RouteBillId to catch path parameters cleanly.
    [Parameter] public Guid? RouteBillId { get; set; }
    [SupplyParameterFromQuery] public Guid? billId { get; set; }
    [SupplyParameterFromQuery] public Guid? poId { get; set; }

    private VendorPayment payment = new();
    private List<Vendor> vendors = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<Tax> taxes = new(); // Required for Tax logic
    
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegAccountType> accountTypes = new();
    
    private Guid currentCompanyId;
    private bool isBusy = false;
    private string currencySymbol = "";
    private string VendorApAccountName = "Select Vendor First";

    private Guid selectedVendorId = Guid.Empty;
    private Guid selectedBillId = Guid.Empty;
    private decimal amountPaidForeign = 0;
    
    private bool HasBillSelected => selectedBillId != Guid.Empty;
    private BillRow? SelectedBill => openBills.FirstOrDefault(i => i.BillId == selectedBillId);

    // FIX 2: Updated DTO to track Subtotal and Tax cleanly for the UI
    public class BillRow
    {
        public Guid BillId { get; set; }
        public string RefNumber { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal TotalForeign { get; set; }
        public decimal TotalBase { get; set; }
        public decimal AmountPaidBase { get; set; }
        public decimal BalanceDueBase { get; set; }
        public decimal BalanceDueForeign { get; set; }
        public decimal ExchangeRate { get; set; }
        public Guid CurrencyId { get; set; }
        public Guid AccountsPayableGlId { get; set; }
        public List<VendorBillLine> Lines { get; set; } = new();
        public decimal DiscountAmountForeign { get; set; }
        public decimal SubTotalForeign { get; set; }
        public decimal TaxAmountForeign { get; set; }
        public string TaxDescription { get; set; } = "Tax";
    }

    private List<BillRow> openBills = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            
            using var ctx = await DbFactory.CreateDbContextAsync();

            vendors = await MasterService.GetVendorsAsync(currentCompanyId);
            currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);
            items = await MasterService.GetItemsAsync(currentCompanyId);
            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);
            taxes = await ctx.Taxes.Where(t => t.CompanyId == currentCompanyId).ToListAsync();

            bankAccounts = allAccounts.Where(a => 
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && 
                       type.Description.Trim().Equals("Cash and Cash Equivalents", StringComparison.OrdinalIgnoreCase) && 
                       type.IsBalanceSheet == true && 
                       type.IsDebit == true;
            }).OrderBy(x => x.AccountCode).ToList();

            CreateNew();

            // Consolidate the route parameter and the query string parameter 
            Guid? actualTargetId = RouteBillId ?? billId;

            if (actualTargetId.HasValue && actualTargetId.Value != Guid.Empty)
            {
                var targetBill = await ctx.VendorBills.FindAsync(actualTargetId.Value);
                if (targetBill != null)
                {
                    await OnVendorChanged(new ChangeEventArgs { Value = targetBill.VendorId.ToString() });
                    OnBillChanged(new ChangeEventArgs { Value = targetBill.Id.ToString() });
                }
            }
            else if (poId.HasValue && poId.Value != Guid.Empty)
            {
                var targetBill = await ctx.VendorBills.FirstOrDefaultAsync(b => b.PurchaseOrderId == poId.Value);
                if (targetBill != null)
                {
                    await OnVendorChanged(new ChangeEventArgs { Value = targetBill.VendorId.ToString() });
                    OnBillChanged(new ChangeEventArgs { Value = targetBill.Id.ToString() });
                }
            }
        }
    }

    private void CreateNew()
    {
        payment = new VendorPayment { Date = DateTime.Today };
        openBills.Clear();
        selectedBillId = Guid.Empty;
        selectedVendorId = Guid.Empty;
    }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var venId))
        {
            selectedVendorId = venId;
            
            var vendor = vendors.FirstOrDefault(c => c.Id == venId);
            if (vendor != null && vendor.PayablesAccountId.HasValue)
            {
                var apAcc = allAccounts.FirstOrDefault(a => a.Id == vendor.PayablesAccountId.Value);
                VendorApAccountName = apAcc != null ? $"{apAcc.AccountCode} - {apAcc.Description}" : "Unknown Account";
            }
            else
            {
                VendorApAccountName = "⚠️ Vendor Missing AP Account!";
            }

            await LoadVendorBills(venId);
            selectedBillId = Guid.Empty;
            amountPaidForeign = 0;
            payment.Reference = "";
            currencySymbol = "";
        }
        else
        {
            selectedVendorId = Guid.Empty;
            VendorApAccountName = "Select Vendor First";
            openBills.Clear();
            selectedBillId = Guid.Empty;
            amountPaidForeign = 0;
            currencySymbol = "";
        }
    }

    private async Task LoadVendorBills(Guid vendorId)
{
    using var ctx = await DbFactory.CreateDbContextAsync();
    
    // 1. Fetch bills including relevant data
    var bills = await ctx.VendorBills
        .Include(b => b.Lines)
        .Include(b => b.Payments)
        .Where(b => b.CompanyId == currentCompanyId && b.VendorId == vendorId && b.IsPosted)
        .ToListAsync();

    // 2. Fetch the original POs for these bills to get Tax/Discount info
    var poIds = bills.Where(b => b.PurchaseOrderId.HasValue).Select(b => b.PurchaseOrderId!.Value).ToList();
    var relatedPOs = await ctx.PurchaseOrders
        .Where(p => poIds.Contains(p.Id))
        .ToDictionaryAsync(p => p.Id);

    openBills.Clear();

    foreach (var bill in bills.OrderBy(b => b.BillDate))
    {
        decimal paidBase = bill.Payments?.Sum(p => p.Amount) ?? 0;
        decimal balBase = bill.TotalAmount - paidBase;

        if (balBase > 0.01m) 
        {
            decimal rate = bill.ExchangeRate > 0 ? bill.ExchangeRate : 1;
            decimal pSubTotal = bill.Lines.Sum(l => l.QuantityBilled * l.UnitCostBilled);
            
            decimal pDiscount = 0;
            decimal pTaxPer = 0;
            string pTaxDesc = "Tax / VAT";

            // CHECK LINKED PO FIRST (Standard logic)
            if (bill.PurchaseOrderId.HasValue && relatedPOs.TryGetValue(bill.PurchaseOrderId.Value, out var po))
            {
                pDiscount = po.DiscountPercentage > 0 
                            ? pSubTotal * (po.DiscountPercentage / 100) 
                            : po.DiscountAmount;

                if (po.TaxId.HasValue)
                {
                    var taxObj = taxes.FirstOrDefault(t => t.Id == po.TaxId);
                    if (taxObj != null)
                    {
                        pTaxPer = taxObj.Per;
                        pTaxDesc = $"{taxObj.TaxName} ({taxObj.Per}%)";
                    }
                }
            }
            else 
            {
                // FALLBACK TO DIRECT BILL HEADER FIELDS
                // Note: Requires bill.DiscountPercentage/Amount/TaxId fields to exist
                // pDiscount = bill.DiscountAmount... (if implemented)
            }

            decimal pNet = pSubTotal - pDiscount;
            decimal pTaxAmount = Math.Round(pNet * (pTaxPer / 100), 2);

            openBills.Add(new BillRow
            {
                BillId = bill.Id,
                RefNumber = string.IsNullOrEmpty(bill.ExternalInvoiceNumber) ? "NO-REF" : bill.ExternalInvoiceNumber,
                Date = bill.BillDate,
                TotalForeign = bill.TotalAmountForeign,
                TotalBase = bill.TotalAmount,
                AmountPaidBase = paidBase,
                BalanceDueBase = balBase,
                BalanceDueForeign = balBase / rate,
                ExchangeRate = rate,
                CurrencyId = bill.CurrencyId,
                Lines = bill.Lines.ToList(),
                SubTotalForeign = pSubTotal,
                DiscountAmountForeign = pDiscount,
                TaxAmountForeign = pTaxAmount,
                TaxDescription = pTaxDesc
            });
        }
    }
}
    private void OnBillChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var invId))
        {
            selectedBillId = invId;
            var bill = SelectedBill;
            
            if (bill != null)
            {
                amountPaidForeign = Math.Round(bill.BalanceDueForeign, 2); 
                payment.Reference = bill.RefNumber; 
                
                var c = currencies.FirstOrDefault(x => x.Id == bill.CurrencyId);
                currencySymbol = c?.CurrencyCode ?? "";
            }
        }
        else
        {
            selectedBillId = Guid.Empty;
            amountPaidForeign = 0;
            payment.Reference = "";
            currencySymbol = "";
        }
    }

    private async Task PostPayment()
    {
        if (!HasBillSelected) { await JS.InvokeVoidAsync("alert", "Please select a Vendor Bill."); return; }
        if (amountPaidForeign <= 0) { await JS.InvokeVoidAsync("alert", "Amount paid must be greater than zero."); return; }
        if (payment.BankGlAccountId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a Pay From (Bank / Asset) account."); return; }

        if (SelectedBill != null && amountPaidForeign > SelectedBill.BalanceDueForeign)
        {
            await JS.InvokeVoidAsync("alert", $"Validation Error:\n\nPayment amount ({amountPaidForeign:N2}) cannot exceed the remaining balance due ({SelectedBill.BalanceDueForeign:N2}).");
            return;
        }

        isBusy = true;
        try
        {
            payment.VendorBillId = selectedBillId;
            
            payment.Amount = Math.Round(amountPaidForeign * SelectedBill!.ExchangeRate, 2);

            var err = await PurchService.PostVendorPaymentAsync(payment, currentCompanyId);

            if (string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", "✅ Payment Posted Successfully!");
                
                await LoadVendorBills(selectedVendorId);
                selectedBillId = Guid.Empty;
                amountPaidForeign = 0;
                payment.Reference = "";
                currencySymbol = "";
            }
            else
            {
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}