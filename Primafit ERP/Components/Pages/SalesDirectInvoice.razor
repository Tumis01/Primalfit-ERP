@page "/ar/direct-invoices"

@using Microsoft.EntityFrameworkCore
@using PrimafitERP.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO

@inject SalesService SalesService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject TransactionMappingService MappingService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ReportExportService ExportService
@inject IEmailService EmailService
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 font-sans text-slate-800">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Direct AR Invoice</h1>
            <p class="text-sm text-slate-500 mt-1">Record revenue and billing vouchers directly against GL accounts without inventory items.</p>
        </div>

        @if (!showForm && HasCompany && !isLoading)
        {
            <PermissionGate Key="SALES_ORDER_CREATE">
                <Authorized>
                    <button type="button" @onclick="OpenNewForm" class="px-5 py-2.5 bg-emerald-600 text-white font-bold text-sm rounded-xl hover:bg-emerald-700 transition-colors shadow-sm flex items-center gap-2 active:scale-95">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        <span>Create Invoice</span>
                    </button>
                </Authorized>
            </PermissionGate>
        }
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading AR setup data...</div>
    }
    else if (HasCompany)
    {
        @if (showForm)
        {
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-visible mb-8">
                <!-- Form Header Bar -->
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between sm:items-center gap-4 rounded-t-2xl">
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-500">Invoice Workspace</span>
                        @if (!string.IsNullOrEmpty(invoice.OrderNumber))
                        {
                            <span class="px-2.5 py-1 bg-slate-200 text-slate-700 font-mono text-xs rounded-lg font-bold">@invoice.OrderNumber</span>
                        }
                        @if (IsCurrentOrderPosted)
                        {
                            <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-lg uppercase tracking-wider">Posted (Read-Only)</span>
                        }
                        else if (IsCurrentOrderRejected)
                        {
                            <span class="px-2.5 py-1 bg-rose-100 text-rose-800 text-[10px] font-bold rounded-lg uppercase tracking-wider animate-pulse">Rejected</span>
                        }
                        else if (IsCurrentOrderStaged)
                        {
                            <span class="px-2.5 py-1 bg-amber-100 text-amber-800 text-[10px] font-bold rounded-lg uppercase tracking-wider">Staged (Review)</span>
                        }
                        else
                        {
                            <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-[10px] font-bold rounded-lg uppercase tracking-wider">Draft</span>
                        }
                    </div>

                    <div class="flex items-center gap-3">
                        @if (!IsLocked && canConfigureRoute)
                        {
                            <button type="button" @onclick="OpenRouteModal" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors flex items-center gap-1.5 shadow-sm active:scale-95">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                <span>Configure Route</span>
                                @if (invoice.CustomTransactionTypeId.HasValue)
                                {
                                    <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                                }
                            </button>
                        }
                    </div>
                </div>

                <!-- Rejection Alert Banner -->
                @if (IsCurrentOrderRejected)
                {
                    <div class="mx-6 md:mx-8 mt-6 p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-start gap-3 animate-in fade-in">
                        <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-rose-800 block">Reviewer Rejection Notice</span>
                            <p class="text-xs text-rose-700 mt-0.5 leading-relaxed">
                                @(CurrentOrderBatchInfo?.RejectionReason ?? "This direct invoice was rejected by a reviewer. Please make adjustments and re-submit to the GL queue.")
                            </p>
                        </div>
                    </div>
                }

                <EditForm Model="invoice">
                    <DataAnnotationsValidator />

                    <div class="p-6 md:p-8 space-y-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 bg-slate-50 p-6 rounded-2xl border border-slate-200">
                            <div>
                                <label class="label">Customer <span class="text-rose-500">*</span></label>
                                <select value="@invoice.CustomerId" @onchange="OnCustomerChanged" class="input-class font-bold text-slate-800 bg-white" disabled="@IsLocked">
                                    <option value="@Guid.Empty">-- Select Customer --</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="label">Invoice Date</label>
                                <input type="date" value="@invoice.Date.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) invoice.Date = d; })" class="input-class bg-white" disabled="@IsLocked" />
                            </div>

                            <ExchangeRatePicker CompanyId="@selectedCompanyId"
                                                 CurrencyId="@invoice.CurrencyId"
                                                 CurrencyCode="@GetCurrencyCode(invoice.CurrencyId)"
                                                 CompanyBaseCurrency="@companyBaseCurrency"
                                                 CurrentRate="@invoice.ExchangeRate"
                                                 CurrentRateChanged="OnExchangeRateChanged"
                                                 Disabled="@IsLocked" />

                            <div>
                                <label class="label">Tax / VAT</label>
                                <select value="@invoice.TaxId" @onchange="OnTaxChanged" class="input-class bg-white" disabled="@IsLocked">
                                    <option value="">No Tax</option>
                                    @foreach (var t in taxes)
                                    {
                                        <option value="@t.Id">@t.TaxName (@t.Per%)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Lines Grid -->
                        <div class="border border-slate-200 rounded-xl shadow-sm overflow-hidden">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-[50%]">Description / Service Rendered <span class="text-rose-500">*</span></th>
                                        <th class="p-3 w-[15%] text-center">Qty</th>
                                        <th class="p-3 w-[15%] text-right">Unit Price (@currencySymbol)</th>
                                        <th class="p-3 w-[15%] text-right pr-4">Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in invoice.Lines)
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="p-2 pl-4 align-top pt-3">
                                                <InputText @bind-Value="line.Description" class="input-class" placeholder="e.g. Monthly Retainer Services" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.0001" min="0.01" @bind="line.Quantity" class="input-class text-center font-bold" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.0001" min="0" @bind="line.UnitPrice" class="input-class text-right font-mono" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-5 text-right font-mono font-bold text-slate-700">
                                                @((line.Quantity * line.UnitPrice).ToString("N4"))
                                            </td>
                                            <td class="p-2 text-center align-top pt-5">
                                                @if (!IsLocked)
                                                {
                                                    <button type="button" @onclick="() => invoice.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600 transition-colors">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!IsLocked)
                            {
                                <div class="p-2 bg-slate-50 border-t border-slate-200">
                                    <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Service Line
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Calculations and Summary -->
                        <div class="flex flex-col md:flex-row justify-between items-start gap-6">
                            <div class="w-full md:w-1/2 p-5 bg-rose-50 border border-rose-100 rounded-xl shadow-sm">
                                <h4 class="font-extrabold text-xs uppercase tracking-wider text-rose-700 mb-4 flex items-center gap-2">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg>
                                    Apply Discount
                                </h4>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="label text-[10px]">Percentage (%)</label>
                                        <input type="number" step="0.0001" min="0" max="100" @bind="invoice.DiscountPercentage"
                                               @bind:after="() => { if (invoice.DiscountPercentage > 0) invoice.DiscountAmount = 0; }"
                                               class="input-class text-center font-bold text-rose-600 border-rose-200 focus:border-rose-500" disabled="@IsLocked" />
                                    </div>
                                    <div>
                                        <label class="label text-[10px]">Flat Amount (@currencySymbol)</label>
                                        <input type="number" step="0.0001" min="0" @bind="invoice.DiscountAmount"
                                               @bind:after="() => { if (invoice.DiscountAmount > 0) invoice.DiscountPercentage = 0; }"
                                               class="input-class text-right font-mono border-rose-200 focus:border-rose-500" disabled="@IsLocked" />
                                    </div>
                                </div>
                            </div>

                            <div class="w-full md:w-80 bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm space-y-2 text-sm text-slate-600">
                                <div class="flex justify-between">
                                    <span>Subtotal:</span>
                                    <span class="font-mono font-bold">@SubTotalForeign.ToString("N4")</span>
                                </div>
                                <div class="flex justify-between items-center text-rose-600 border-b border-slate-200 pb-2">
                                    <span>Discount:</span>
                                    <span class="font-mono font-bold">- @DiscountForeign.ToString("N4")</span>
                                </div>
                                <div class="flex justify-between items-center pt-1">
                                    <span>Net Subtotal:</span>
                                    <span class="font-mono font-bold">@DiscountedSubTotal.ToString("N4")</span>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span>Tax (@TaxPercentage%):</span>
                                    <span class="font-mono font-bold">+ @TaxAmountForeign.ToString("N4")</span>
                                </div>
                                <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                    <span class="font-bold">Total (@currencySymbol):</span>
                                    <span class="font-mono font-black text-emerald-700 text-2xl">@GrandTotalForeign.ToString("N4")</span>
                                </div>
                                <div class="flex justify-between text-[10px] text-slate-400 mt-2 uppercase font-bold tracking-wider pt-2">
                                    <span>Ledger Base Value:</span>
                                    <span class="font-mono text-slate-500">@GrandTotalBase.ToString("N4")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Controls -->
                    <div class="p-6 border-t border-slate-100 bg-slate-50/50 flex flex-wrap justify-between items-center gap-3 rounded-b-2xl">
                        @if (IsLocked)
                        {
                            <div class="mr-auto flex items-center gap-2">
                                <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-lg border border-emerald-200 uppercase tracking-wider flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Posted
                                </span>

                                <button type="button" @onclick="() => DownloadInvoice(invoice)" disabled="@isExporting" class="px-5 py-1.5 rounded-lg border border-slate-300 text-slate-700 bg-white font-bold text-xs hover:bg-slate-50 transition-colors flex items-center gap-2 disabled:opacity-50 shadow-sm">
                                    @if (isExporting)
                                    {
                                        <span class="animate-spin">↻</span>
                                    }
                                    Download Invoice
                                </button>
                            </div>
                        }

                        <div class="flex items-center gap-3 ml-auto">
                            <button type="button" @onclick="CloseForm" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-100 transition-colors">
                                Close
                            </button>

                            <button type="button" @onclick="() => ResetForm(defaultIncomeGlAccountId)" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-white transition-colors">
                                @(IsLocked ? "New Invoice" : "Clear")
                            </button>

                            @if (!IsLocked)
                            {
                                <button type="button" @onclick="SaveDraftInvoice" disabled="@isBusy" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all active:scale-95 disabled:opacity-50 flex items-center gap-2">
                                    @if (isBusy)
                                    {
                                        <span class="animate-spin">↻</span>
                                    }
                                    <span>Save Draft</span>
                                </button>

                                <PermissionGate Key="SALES_INVOICE_POST">
                                    <Authorized>
                                        <button type="button" @onclick="PostInvoice" disabled="@isBusy" class="px-8 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-700 shadow-md transition-all active:scale-95 disabled:opacity-50 flex items-center gap-2">
                                            @if (isBusy)
                                            {
                                                <span class="animate-spin">↻</span>
                                            }
                                            <span>@(IsCurrentOrderStaged ? "Update Staged Invoice" : (IsCurrentOrderRejected ? "Resubmit to GL Review" : "Submit Invoice to GL Queue"))</span>
                                        </button>
                                    </Authorized>
                                </PermissionGate>
                            }
                        </div>
                    </div>
                </EditForm>
            </div>
        }

        <!-- Historical List Grid -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mt-8">
            <div class="p-6 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                <h2 class="text-lg font-bold text-slate-800">Past Direct Invoices</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-100 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase tracking-wider">
                        <tr>
                            <th class="p-4 pl-6">Date</th>
                            <th class="p-4">Invoice #</th>
                            <th class="p-4">Customer</th>
                            <th class="p-4">Description</th>
                            <th class="p-4 text-right">Total (Base)</th>
                            <th class="p-4 text-center">Status</th>
                            <th class="p-4 pr-6 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (pastInvoices == null || !pastInvoices.Any())
                        {
                            <tr>
                                <td colspan="7" class="p-8 text-center text-slate-400 italic">No past direct invoices found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pInv in pastInvoices)
                            {
                                var batchInfo = pInv.InvoiceBatchId.HasValue && batchMap.TryGetValue(pInv.InvoiceBatchId.Value, out var b) ? b : null;
                                bool isGlCommitted = batchInfo?.Status == BatchStatus.Posted;
                                bool isRejected = batchInfo?.Status == BatchStatus.Rejected;
                                bool isStaged = batchInfo?.Status == BatchStatus.Ready;

                                <tr class="hover:bg-slate-50 transition-colors align-middle">
                                    <td class="p-4 pl-6 whitespace-nowrap">@pInv.Date.ToString("MMM dd, yyyy")</td>
                                    <td class="p-4 font-mono text-slate-600 font-semibold whitespace-nowrap">@pInv.OrderNumber</td>
                                    <td class="p-4 font-bold text-slate-800">@(pInv.Customer?.Name ?? "Unknown")</td>
                                    <td class="p-4 text-slate-500 max-w-xs truncate" title="@(pInv.Lines.FirstOrDefault()?.Description)">
                                        @(pInv.Lines.FirstOrDefault()?.Description ?? "Direct AR Invoice")
                                    </td>
                                    <td class="p-4 text-right font-mono font-bold text-slate-700">
                                        @((pInv.GrandTotalForeign * (pInv.ExchangeRate > 0 ? pInv.ExchangeRate : 1)).ToString("N4"))
                                    </td>

                                    <!-- Status Column with Staging Support -->
                                    <td class="p-4 text-center">
                                        @if (isGlCommitted)
                                        {
                                            <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full uppercase tracking-wider">
                                                Posted
                                            </span>
                                        }
                                        else if (isRejected)
                                        {
                                            <span class="px-2.5 py-1 bg-rose-100 text-rose-800 text-[10px] font-bold rounded-full uppercase tracking-wider animate-pulse" title="@batchInfo?.RejectionReason">
                                                Rejected
                                            </span>
                                        }
                                        else if (isStaged)
                                        {
                                            <span class="px-2.5 py-1 bg-amber-100 text-amber-800 text-[10px] font-bold rounded-full uppercase tracking-wider">
                                                Staged (Review)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 bg-slate-100 text-slate-700 text-[10px] font-bold rounded-full uppercase tracking-wider">
                                                Draft
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions Column -->
                                    <td class="p-4 pr-6 text-center space-x-2 whitespace-nowrap">
                                        @if (isGlCommitted)
                                        {
                                            <button type="button" @onclick="() => LoadInvoiceForView(pInv)" class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 hover:text-slate-900 text-xs font-bold transition-colors">
                                                View
                                            </button>

                                            @if (pInv.IsFullyPaid)
                                            {
                                                <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                                    Paid
                                                </span>
                                            }
                                            else if (pInv.AmountPaid > 0)
                                            {
                                                <button type="button" @onclick="() => NavigateToPayment(pInv.Id)" class="px-3 py-1.5 bg-indigo-50 text-indigo-600 border border-indigo-200 rounded-lg hover:bg-indigo-600 hover:text-white text-xs font-bold transition-colors">
                                                    Receive Balance
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick="() => NavigateToPayment(pInv.Id)" class="px-3 py-1.5 bg-indigo-50 text-indigo-600 border border-indigo-200 rounded-lg hover:bg-indigo-600 hover:text-white text-xs font-bold transition-colors">
                                                    Receive Payment
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="() => LoadInvoiceForEdit(pInv)" class="px-3 py-1.5 bg-white border border-slate-200 text-slate-700 rounded-lg hover:bg-slate-50 text-xs font-bold transition-colors shadow-sm">
                                                Edit
                                            </button>

                                            <PermissionGate Key="SALES_INVOICE_POST">
                                                <Authorized>
                                                    <button type="button" @onclick="() => PostDraftFromList(pInv)" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 text-xs font-bold transition-colors shadow-sm">
                                                        @(isStaged ? "Update Staging" : (isRejected ? "Resubmit Invoice" : "Submit Invoice"))
                                                    </button>
                                                </Authorized>
                                            </PermissionGate>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ========================================================= -->
<!-- ROUTE CONFIGURATION MODAL -->
<!-- ========================================================= -->
@if (showRouteModal)
{
    <div class="fixed inset-0 z-[120] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col overflow-visible">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                <div>
                    <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">Direct Invoice GL Route Mapping</h3>
