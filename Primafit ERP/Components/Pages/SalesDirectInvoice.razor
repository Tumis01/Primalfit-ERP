@page "/ar/direct-invoices"

@using Microsoft.EntityFrameworkCore
@using PrimafitERP.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject SalesService SalesService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Direct AR Invoice</h1>
            <p class="text-sm text-slate-500 mt-1">Create free-text invoices directly to a GL Income account without affecting inventory.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading setup data...</div>
    }
    else if (HasCompany)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-visible">
            
            <EditForm Model="invoice"> 
    <DataAnnotationsValidator />

                <div class="p-6 md:p-8 space-y-8">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 bg-slate-50 p-6 rounded-2xl border border-slate-200">
                        <div>
                            <label class="label">Customer <span class="text-rose-500">*</span></label>
                            <select value="@invoice.CustomerId" @onchange="OnCustomerChanged" class="input-class font-bold text-slate-800 bg-white">
                                <option value="@Guid.Empty">-- Select Customer --</option>
                                @foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="label">Invoice Date</label>
                            <input type="date" value="@invoice.Date.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) invoice.Date = d; })" class="input-class bg-white" />
                        </div>

                        <div>
                            <label class="label text-emerald-700">Credit GL Account (Revenue) <span class="text-rose-500">*</span></label>
                            <select @bind="invoice.DirectIncomeGlAccountId" class="input-class bg-white border-emerald-200 font-bold text-emerald-800 focus:border-emerald-500">
                                <option value="">-- Select Income Account --</option>
                                @foreach (var acc in revenueAccounts)
                                {
                                    <option value="@acc.Id">@acc.AccountCode - @acc.Description</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="label">Currency & Rate</label>
                            <div class="flex gap-2">
                                <select value="@invoice.CurrencyId" class="input-class w-1/3 bg-slate-100 text-slate-500 font-bold cursor-not-allowed px-2" disabled>
                                    <option value="@Guid.Empty">N/A</option>
                                    @foreach (var c in currencies)
                                    {
                                        <option value="@c.Id">@c.CurrencyCode</option>
                                    }
                                </select>
                                <input type="number" step="0.01" @bind="invoice.ExchangeRate" class="input-class w-2/3 text-right font-mono font-bold bg-white" />
                            </div>
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-xl shadow-sm">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                <tr>
                                    <th class="p-3 pl-4 w-[50%]">Description / Service Rendered <span class="text-rose-500">*</span></th>
                                    <th class="p-3 w-[15%] text-center">Qty</th>
                                    <th class="p-3 w-[15%] text-right">Unit Price</th>
                                    <th class="p-3 w-[15%] text-right pr-4">Total</th>
                                    <th class="p-3 w-[5%]"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var line in invoice.Lines)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-2 pl-4 align-top pt-3">
                                            <InputText @bind-Value="line.Description" class="input-class" placeholder="e.g. Consulting Fees for March" />
                                        </td>
                                        <td class="p-2 align-top pt-3">
                                            <input type="number" step="0.01" @bind="line.Quantity" class="input-class text-center font-bold" />
                                        </td>
                                        <td class="p-2 align-top pt-3">
                                            <input type="number" step="0.01" @bind="line.UnitPrice" class="input-class text-right font-mono" />
                                        </td>
                                        <td class="p-2 pr-4 align-top pt-5 text-right font-mono font-bold text-slate-700">
                                            @((line.Quantity * line.UnitPrice).ToString("N2"))
                                        </td>
                                        <td class="p-2 text-center align-top pt-5">
                                            <button type="button" @onclick="() => invoice.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div class="p-2 bg-slate-50 border-t border-slate-200 rounded-b-xl">
                            <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Free-Text Line
                            </button>
                        </div>
                    </div>

                    <div class="flex justify-end pt-4">
                        <div class="w-full md:w-80 space-y-4">
                            
                            <div>
                                <label class="label">Tax / VAT</label>
                                <select value="@invoice.TaxId" @onchange="OnTaxChanged" class="input-class bg-white">
                                    <option value="">No Tax</option>
                                    @foreach (var t in taxes)
                                    {
                                        <option value="@t.Id">@t.TaxName (@t.Per%)</option>
                                    }
                                </select>
                            </div>

                            <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm space-y-2 text-sm text-slate-600">
                                <div class="flex justify-between">
                                    <span>Subtotal:</span>
                                    <span class="font-mono font-bold">@SubTotal.ToString("N2")</span>
                                </div>
                                <div class="flex justify-between items-center text-rose-600 pb-2 border-b border-slate-200">
                                    <span>Discount:</span>
                                    <input type="number" @bind="invoice.DiscountAmount" class="w-24 text-right font-mono border border-rose-200 rounded px-2 py-1 bg-white focus:outline-none focus:border-rose-500 text-xs" />
                                </div>
                                <div class="flex justify-between items-center pt-2">
                                    <span>Tax (@TaxPercentage%):</span>
                                    <span class="font-mono font-bold">+ @TaxAmount.ToString("N2")</span>
                                </div>
                                <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                    <span class="font-bold">Total:</span>
                                    <span class="font-mono font-black text-emerald-700 text-2xl">@GrandTotalForeign.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="p-6 border-t border-slate-100 bg-slate-50/50 flex justify-end gap-3 rounded-b-2xl">
                    <button type="button" @onclick="ResetForm" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-white transition-colors">
                        Clear
                    </button>
                    <button type="button" @onclick="PostInvoice" disabled="@isBusy" class="px-8 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-700 shadow-md transition-all active:scale-95 disabled:opacity-50 flex items-center gap-2">
                        @if (isBusy) { <span class="animate-spin">↻</span> }
                        Post Invoice
                    </button>
                </div>
            </EditForm>

        </div>
    }
</div>

<style>
    .label { display: block; font-size: 0.70rem; font-weight: 800; color: #475569; text-transform: uppercase; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
    .input-class { width: 100%; border-radius: 0.5rem; border: 1px solid #cbd5e1; padding: 0.6rem 0.8rem; font-size: 0.875rem; color: #0f172a; outline: none; transition: border-color 0.2s; }
    .input-class:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15); }
    .input-class:disabled { background-color: #f8fafc; color: #94a3b8; cursor: not-allowed; }
</style>

@code {
    private Guid selectedCompanyId;
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private bool isBusy = false;

    private SalesOrder invoice = new();
    private List<Customer> customers = new();
    private List<Currency> currencies = new();
    private List<Tax> taxes = new();
    private List<SegChartOfAccount> revenueAccounts = new();
    
    // Math logic
    private decimal SubTotal => invoice.Lines.Sum(l => l.Quantity * l.UnitPrice);
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == invoice.TaxId)?.Per ?? 0;
    private decimal TaxAmount => (SubTotal - invoice.DiscountAmount) * (TaxPercentage / 100);
    private decimal GrandTotalForeign => (SubTotal - invoice.DiscountAmount) + TaxAmount;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            selectedCompanyId = user.CompanyDetailsId.Value;
            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        // THE FIX: Use the injected DbFactory instead of the non-existent CompanyApiService method
        await using var ctx = await DbFactory.CreateDbContextAsync(); 
        
        customers = await ctx.Customers.Where(c => c.CompanyId == selectedCompanyId).ToListAsync();
        currencies = await CurrService.GetCurrenciesAsync(selectedCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == selectedCompanyId).ToListAsync();

        // Fetch only Revenue/Income accounts (IsBalanceSheet = false, IsDebit = false)
        var accountTypes = await SegCoaService.GetAccountTypesAsync();
        var allAccounts = await SegCoaService.GetCoaAsync(selectedCompanyId);
        
        revenueAccounts = allAccounts.Where(a => 
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == false && type.IsDebit == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        ResetForm();
    }

    private void ResetForm()
    {
        invoice = new SalesOrder { CompanyId = selectedCompanyId, Date = DateOnly.FromDateTime(DateTime.Today) };
        AddLine();
    }

    private void AddLine() => invoice.Lines.Add(new SalesOrderLine { Quantity = 1 });

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var custId))
        {
            invoice.CustomerId = custId;
            var customer = customers.FirstOrDefault(c => c.Id == custId);
            
            if (customer != null && customer.CurrencyId != Guid.Empty)
            {
                invoice.CurrencyId = customer.CurrencyId;
                invoice.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, invoice.CurrencyId);
            }
        }
    }

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId))
        {
            invoice.TaxId = taxId;
            var selectedTax = taxes.FirstOrDefault(t => t.Id == taxId);
            if (selectedTax != null) invoice.TaxGLAccountId = selectedTax.GLAccountId;
        }
        else
        {
            invoice.TaxId = null;
            invoice.TaxGLAccountId = null;
        }
    }

    private async Task PostInvoice()
    {
        // 1. Explicit UI Validation Alerts
        if (invoice.CustomerId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Customer.");
            return;
        }

        if (invoice.DirectIncomeGlAccountId == null || invoice.DirectIncomeGlAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Credit GL Account (Revenue).");
            return;
        }

        if (!invoice.Lines.Any())
        {
            await JS.InvokeVoidAsync("alert", "Please add at least one line item.");
            return;
        }

        if (invoice.Lines.Any(l => string.IsNullOrWhiteSpace(l.Description)))
        {
            await JS.InvokeVoidAsync("alert", "All lines must have a Description / Service Rendered.");
            return;
        }

        // 2. Start Processing
        isBusy = true;
        StateHasChanged(); // Force UI to show the spinning icon

        var err = await SalesService.PostDirectInvoiceAsync(invoice);
        
        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Direct Invoice Posted Successfully!");
            ResetForm(); 
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }

        isBusy = false;
        StateHasChanged(); // Stop spinner
    }
}