@code {
    private Guid selectedCompanyId;
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private bool isBusy = false;
    private bool isExporting = false;
    private bool showForm = false;

    private SalesOrder invoice = new();
    private List<SalesOrder> pastInvoices = new();
    private List<Customer> customers = new();
    private List<Currency> currencies = new();
    private List<Tax> taxes = new();
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> revenueAccounts = new();
    private List<SegChartOfAccount> taxAccounts = new();

    // Route Configuration Modal State
    private bool showRouteModal = false;
    private List<CustomTransactionType> customTemplates = new();
    private Guid defaultArAccountId = Guid.Empty;
    private Guid defaultIncomeGlAccountId = Guid.Empty;
    private Guid defaultDiscountAccountId = Guid.Empty;

    private string currencySymbol = "";
    private string companyBaseCurrency = "BASE";

    // Cache batch status and rejection details by batch ID
    private record BatchSummary(BatchStatus Status, string? RejectionReason);
    private Dictionary<Guid, BatchSummary> batchMap = new();

    private BatchSummary? CurrentOrderBatchInfo =>
        invoice.InvoiceBatchId.HasValue && batchMap.TryGetValue(invoice.InvoiceBatchId.Value, out var b) ? b : null;

    private bool IsCurrentOrderPosted => CurrentOrderBatchInfo?.Status == BatchStatus.Posted;
    private bool IsCurrentOrderStaged => CurrentOrderBatchInfo?.Status == BatchStatus.Ready;
    private bool IsCurrentOrderRejected => CurrentOrderBatchInfo?.Status == BatchStatus.Rejected;

    private bool IsLocked => IsCurrentOrderPosted;

    // Email Modal Backing Fields
    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private Guid emailTargetInvoiceId = Guid.Empty;
    private string emailCustomerName = "";
    private string emailCustomerAddress = "";
    private string emailSubject = "";
    private string customEmailMessage = "";

    // Math calculations
    private decimal SubTotalForeign => invoice.Lines.Sum(l => l.Quantity * l.UnitPrice);
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == invoice.TaxId)?.Per ?? 0;
    private decimal DiscountForeign => invoice.DiscountPercentage > 0 ? SubTotalForeign * (invoice.DiscountPercentage / 100) : invoice.DiscountAmount;
    private decimal DiscountedSubTotal => SubTotalForeign - DiscountForeign;
    private decimal TaxAmountForeign => DiscountedSubTotal * (TaxPercentage / 100);
    private decimal GrandTotalForeign => DiscountedSubTotal + TaxAmountForeign;
    private decimal GrandTotalBase => invoice.ExchangeRate == 0 ? 0 : GrandTotalForeign * invoice.ExchangeRate;
    private string currentUserId = "";
    private bool canConfigureRoute = false;

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SALES_ORDER_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            selectedCompanyId = user.CompanyDetailsId.Value;
            canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(selectedCompanyId);
            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();

        var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
        companyBaseCurrency = company?.BaseCurrency ?? "BASE";

        // Populate Batch Status Map for all batches in the current company
        var batches = await ctx.GLBatches
            .AsNoTracking()
            .Where(b => b.CompanyId == selectedCompanyId)
            .Select(b => new { b.Id, b.Status, b.RejectionReason })
            .ToListAsync();

        batchMap = batches.ToDictionary(b => b.Id, b => new BatchSummary(b.Status, b.RejectionReason));

        customers = await ctx.Customers.Where(c => c.CompanyId == selectedCompanyId).ToListAsync();
        currencies = await CurrService.GetCurrenciesAsync(selectedCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == selectedCompanyId).ToListAsync();

        var accountTypes = await SegCoaService.GetAccountTypesAsync();
        allAccounts = await SegCoaService.GetCoaAsync(selectedCompanyId);

        revenueAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == false && type.IsDebit == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        taxAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        defaultIncomeGlAccountId = await MappingService.GetMappedAccountAsync(
            selectedCompanyId, SystemTransactionType.DirectSalesInvoice, isDebit: false, defaultAccountId: revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty);

        defaultDiscountAccountId = await MappingService.GetMappedAccountAsync(
            selectedCompanyId, SystemTransactionType.DiscountAllowed, isDebit: true, defaultAccountId: Guid.Empty);

        await FetchPastInvoices();
        ResetForm(defaultIncomeGlAccountId);
    }

    private async Task FetchPastInvoices()
    {
        pastInvoices = await SalesService.GetDirectInvoicesAsync(selectedCompanyId);
    }

    private void OpenNewForm()
    {
        ResetForm(defaultIncomeGlAccountId);
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private void ResetForm(Guid defaultIncomeGl)
    {
        invoice = new SalesOrder
        {
            CompanyId = selectedCompanyId,
            Date = DateOnly.FromDateTime(DateTime.Today),
            ExchangeRate = 1,
            Status = OrderStatus.Draft,
            IsDirectInvoice = true,
            DirectIncomeGlAccountId = defaultIncomeGl
        };
        currencySymbol = "";
        AddLine();
    }

    private void AddLine() => invoice.Lines.Add(new SalesOrderLine { Quantity = 1 });

    private async Task OpenRouteModal()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();

        customTemplates = await ctx.CustomTransactionTypes
            .AsNoTracking()
            .Where(t => t.CompanyId == selectedCompanyId)
            .OrderBy(t => t.Name)
            .ToListAsync();

        var customer = customers.FirstOrDefault(c => c.Id == invoice.CustomerId);
        defaultArAccountId = customer?.ReceivablesAccountId ?? Guid.Empty;

        showRouteModal = true;
    }

    private async Task OnCustomTemplateSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var customId) && customId != Guid.Empty)
        {
            invoice.CustomTransactionTypeId = customId;

            await using var ctx = await DbFactory.CreateDbContextAsync();
            var map = await ctx.TransactionGlMappings
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.CompanyId == selectedCompanyId && m.CustomTransactionTypeId == customId);

            if (map != null)
            {
                if (map.OverrideDebitGlAccountId.HasValue)
                    invoice.ReceivablesGlAccountId = map.OverrideDebitGlAccountId.Value;

                if (map.OverrideCreditGlAccountId.HasValue)
                    invoice.DirectIncomeGlAccountId = map.OverrideCreditGlAccountId.Value;
            }
        }
        else
        {
            invoice.CustomTransactionTypeId = null;
        }
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var custId) && custId != Guid.Empty)
        {
            invoice.CustomerId = custId;
            var customer = customers.FirstOrDefault(c => c.Id == custId);

            if (customer != null)
            {
                defaultArAccountId = customer.ReceivablesAccountId ?? Guid.Empty;
                if (customer.CurrencyId != Guid.Empty)
                {
                    invoice.CurrencyId = customer.CurrencyId;
                    currencySymbol = currencies.FirstOrDefault(c => c.Id == customer.CurrencyId)?.CurrencyCode ?? "";
                    invoice.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, invoice.CurrencyId);
                }
            }
        }
        else
        {
            invoice.CustomerId = Guid.Empty;
            currencySymbol = "";
        }
    }

    private void OnExchangeRateChanged(decimal rate)
    {
        invoice.ExchangeRate = Math.Round(rate, 4);
    }

    private string GetCurrencyCode(Guid currencyId) => currencies.FirstOrDefault(c => c.Id == currencyId)?.CurrencyCode ?? "";

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId) && taxId != Guid.Empty)
        {
            invoice.TaxId = taxId;
            var selectedTax = taxes.FirstOrDefault(t => t.Id == taxId);
            if (selectedTax != null) invoice.TaxGLAccountId = selectedTax.GLAccountId;
        }
        else
        {
            invoice.TaxId = null;
            invoice.TaxGLAccountId = null;
        }
    }

    private async Task SaveDraftInvoice()
    {
        // 1. Mandatory Input Validation
        if (invoice.CustomerId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Validation Error: Please select a Customer."); return; }
        if (!invoice.Lines.Any()) { await JS.InvokeVoidAsync("alert", "Validation Error: Please add at least one line item."); return; }
        if (invoice.Lines.Any(l => string.IsNullOrWhiteSpace(l.Description))) { await JS.InvokeVoidAsync("alert", "Validation Error: All lines must have a Description / Service Rendered."); return; }
        if (invoice.Lines.Any(l => l.Quantity <= 0)) { await JS.InvokeVoidAsync("alert", "Validation Error: All line quantities must be greater than zero."); return; }
        if (invoice.Lines.Any(l => l.UnitPrice < 0)) { await JS.InvokeVoidAsync("alert", "Validation Error: Unit prices cannot be negative."); return; }
        if (GrandTotalForeign <= 0) { await JS.InvokeVoidAsync("alert", "Validation Error: Total invoice amount must be greater than zero."); return; }

        // A non-posted invoice with a linked batch is already in the review flow.
        // Save Draft must refresh that batch, just like Update Staged Invoice.
        if (invoice.InvoiceBatchId.HasValue && !IsCurrentOrderPosted)
        {
            isBusy = true;
            StateHasChanged();
            var stagingError = await SalesService.PostDirectInvoiceAsync(invoice, currentUserId);
            if (string.IsNullOrEmpty(stagingError))
            {
                await LoadData();
                showForm = false;
                await JS.InvokeVoidAsync("alert", "Draft changes saved and the General Ledger review batch was updated.");
                ResetForm(defaultIncomeGlAccountId);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", stagingError);
            }

            isBusy = false;
            StateHasChanged();
            return;
        }

        isBusy = true;
        StateHasChanged();

        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();

            invoice.IsDirectInvoice = true;

            if (string.IsNullOrWhiteSpace(invoice.OrderNumber))
            {
                bool isDup = true;
                string generated = string.Empty;
                while (isDup)
                {
                    generated = $"INV-{DateTime.UtcNow:yyMM}-{Random.Shared.Next(1000, 9999)}";
                    isDup = await ctx.SalesOrders.AnyAsync(o => o.CompanyId == invoice.CompanyId && o.OrderNumber == generated);
                }
                invoice.OrderNumber = generated;
            }

            var existing = await ctx.SalesOrders.Include(o => o.Lines).FirstOrDefaultAsync(o => o.Id == invoice.Id);
            if (existing == null)
            {
                if (invoice.Id == Guid.Empty) invoice.Id = Guid.NewGuid();
                invoice.Status = OrderStatus.Draft;
                foreach (var line in invoice.Lines)
                {
                    if (line.Id == Guid.Empty) line.Id = Guid.NewGuid();
                    line.HeaderId = invoice.Id;
                }
                ctx.SalesOrders.Add(invoice);
            }
            else
            {
                if (IsLocked)
                {
                    await JS.InvokeVoidAsync("alert", "Cannot edit an invoice that has already been committed to the General Ledger.");
                    return;
                }

                // Preserve existing staging batch ID and keep state accurate
                invoice.InvoiceBatchId = existing.InvoiceBatchId;
                ctx.Entry(existing).CurrentValues.SetValues(invoice);

                ctx.SalesOrderLines.RemoveRange(existing.Lines);
                foreach (var line in invoice.Lines)
                {
                    line.HeaderId = existing.Id;
                    if (line.Id == Guid.Empty) line.Id = Guid.NewGuid();
                    ctx.SalesOrderLines.Add(line);
                }
            }

            await ctx.SaveChangesAsync();
            await LoadData();
            await JS.InvokeVoidAsync("alert", "Draft invoice saved successfully!");
            showForm = false;
            ResetForm(defaultIncomeGlAccountId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Save Draft Error: {ex.Message}");
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    private async Task PostDraftFromList(SalesOrder draftInv)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Submit invoice {draftInv.OrderNumber} to the General Ledger review queue?");
        if (!confirm) return;

        isBusy = true;
        StateHasChanged();

        var err = await SalesService.PostDirectInvoiceAsync(draftInv, currentUserId);
        if (string.IsNullOrEmpty(err))
        {
            await LoadData();
            await JS.InvokeVoidAsync("alert", "Direct AR Invoice staged and submitted to the General Ledger review queue.");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }

        isBusy = false;
        StateHasChanged();
    }

    private async Task PostInvoice()
    {
        // 1. Mandatory Input Validation
        if (invoice.CustomerId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Validation Error: Please select a Customer."); return; }
        if (!invoice.Lines.Any()) { await JS.InvokeVoidAsync("alert", "Validation Error: Please add at least one line item."); return; }
        if (invoice.Lines.Any(l => string.IsNullOrWhiteSpace(l.Description))) { await JS.InvokeVoidAsync("alert", "Validation Error: All lines must have a Description / Service Rendered."); return; }
        if (invoice.Lines.Any(l => l.Quantity <= 0)) { await JS.InvokeVoidAsync("alert", "Validation Error: All line quantities must be greater than zero."); return; }
        if (invoice.Lines.Any(l => l.UnitPrice < 0)) { await JS.InvokeVoidAsync("alert", "Validation Error: Unit prices cannot be negative."); return; }
        if (GrandTotalForeign <= 0) { await JS.InvokeVoidAsync("alert", "Validation Error: Total invoice amount must be greater than zero."); return; }

        // 2. Account Route Validation
        var directRevAccount = invoice.DirectIncomeGlAccountId ?? defaultIncomeGlAccountId;
        if (directRevAccount == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Route Error: Revenue / Income GL account is not configured. Please assign it in 'Configure Route' before submitting.");
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", "Submit this direct invoice to the General Ledger review queue?");
        if (!confirm) return;

        isBusy = true;
        StateHasChanged();

        var err = await SalesService.PostDirectInvoiceAsync(invoice, currentUserId);

        if (string.IsNullOrEmpty(err))
        {
            await LoadData();

            await using var ctx = await DbFactory.CreateDbContextAsync();
            var emailConfig = await ctx.CompanyEmailSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == selectedCompanyId);
            bool showPopupToggle = emailConfig?.EnableInvoiceEmailPopup ?? true;

            if (!showPopupToggle)
            {
                await JS.InvokeVoidAsync("alert", "Direct AR Invoice staged and submitted to the General Ledger review queue.");
                showForm = false;
                ResetForm(defaultIncomeGlAccountId);
                isBusy = false;
                StateHasChanged();
                return;
            }

            var targetCustomer = customers.FirstOrDefault(c => c.Id == invoice.CustomerId);
            if (targetCustomer != null && !string.IsNullOrWhiteSpace(targetCustomer.Email))
            {
                emailTargetInvoiceId = invoice.Id;
                emailCustomerName = targetCustomer.Name;
                emailCustomerAddress = targetCustomer.Email;
                emailSubject = $"Invoice {invoice.OrderNumber}";
                customEmailMessage = $"Dear {targetCustomer.Name},\n\nPlease find attached our official invoice {invoice.OrderNumber} issued regarding services rendered.\n\nTotal Due: {currencySymbol}{invoice.GrandTotalForeign:N4}.\n\nThank you for your business!\n\nBest Regards,\nAccounts Receivable Team";

                showEmailPopup = true;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Direct AR Invoice submitted to General Ledger queue!\n(No email sent: Customer missing email address).");
                showForm = false;
            }
            ResetForm(defaultIncomeGlAccountId);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }

        isBusy = false;
        StateHasChanged();
    }

    private async Task DispatchEmail()
    {
        if (emailTargetInvoiceId == Guid.Empty) return;

        isSendingEmail = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            var printInvoice = pastInvoices.FirstOrDefault(i => i.Id == emailTargetInvoiceId) ?? invoice;

            var pdfBytes = ExportService.GenerateDirectInvoicePdf(printInvoice, company);
            var fileName = $"AR_Invoice_{printInvoice.OrderNumber}.pdf";

            await EmailService.SendEmailAsync(
                emailCustomerAddress,
                emailSubject,
                customEmailMessage.Replace("\n", "<br>"),
                pdfBytes,
                fileName
            );

            await JS.InvokeVoidAsync("alert", "Invoice emailed successfully!");
            showEmailPopup = false;
            showForm = false;
            emailTargetInvoiceId = Guid.Empty;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}");
        }
        finally
        {
            isSendingEmail = false;
            StateHasChanged();
        }
    }

    private void LoadInvoiceForView(SalesOrder selectedInvoice)
    {
        invoice = selectedInvoice;

        var customer = customers.FirstOrDefault(c => c.Id == invoice.CustomerId);
        if (customer != null && customer.CurrencyId != Guid.Empty)
        {
            currencySymbol = currencies.FirstOrDefault(c => c.Id == customer.CurrencyId)?.CurrencyCode ?? "";
        }
        else
        {
            currencySymbol = invoice.Currency?.CurrencyCode ?? "";
        }

        showForm = true;
        JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private void LoadInvoiceForEdit(SalesOrder draftInvoice)
    {
        invoice = new SalesOrder
        {
            Id = draftInvoice.Id,
            CompanyId = draftInvoice.CompanyId,
            CustomerId = draftInvoice.CustomerId,
            Date = draftInvoice.Date,
            OrderNumber = draftInvoice.OrderNumber,
            Status = draftInvoice.Status,
            InvoiceBatchId = draftInvoice.InvoiceBatchId,
            IsDirectInvoice = true,
            CurrencyId = draftInvoice.CurrencyId,
            ExchangeRate = draftInvoice.ExchangeRate,
            TaxId = draftInvoice.TaxId,
            TaxGLAccountId = draftInvoice.TaxGLAccountId,
            DiscountPercentage = draftInvoice.DiscountPercentage,
            DiscountAmount = draftInvoice.DiscountAmount,
            DiscountGlAccountId = draftInvoice.DiscountGlAccountId,
            CustomTransactionTypeId = draftInvoice.CustomTransactionTypeId,
            ReceivablesGlAccountId = draftInvoice.ReceivablesGlAccountId,
            DirectIncomeGlAccountId = draftInvoice.DirectIncomeGlAccountId,
            Lines = draftInvoice.Lines.Select(l => new SalesOrderLine
            {
                Id = l.Id,
                HeaderId = draftInvoice.Id,
                Description = l.Description,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice
            }).ToList()
        };

        var customer = customers.FirstOrDefault(c => c.Id == invoice.CustomerId);
        if (customer != null && customer.CurrencyId != Guid.Empty)
        {
            currencySymbol = currencies.FirstOrDefault(c => c.Id == customer.CurrencyId)?.CurrencyCode ?? "";
        }
        else
        {
            currencySymbol = invoice.Currency?.CurrencyCode ?? "";
        }

        showForm = true;
        JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private void NavigateToPayment(Guid invoiceId)
    {
        NavManager.NavigateTo($"/ar/payment-entry?invoiceId={invoiceId}");
    }

    private async Task DownloadInvoice(SalesOrder targetInvoice)
    {
        if (targetInvoice == null || targetInvoice.Id == Guid.Empty) return;

        isExporting = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            if (company == null) return;

            var pdfBytes = ExportService.GenerateDirectInvoicePdf(targetInvoice, company);
            var fileName = $"AR_Invoice_{targetInvoice.OrderNumber}.pdf";

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(pdfBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }
}
