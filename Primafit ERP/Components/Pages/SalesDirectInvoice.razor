@page "/ar/direct-invoices"

@using Microsoft.EntityFrameworkCore
@using PrimafitERP.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO

@inject SalesService SalesService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ReportExportService ExportService
@inject IEmailService EmailService
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Direct AR Invoice</h1>
            <p class="text-sm text-slate-500 mt-1">Create free-text invoices directly to a GL Income account without affecting inventory.</p>
        </div>

        @if (!showForm && HasCompany && !isLoading)
        {
            <PermissionGate Key="SALES_ORDER_CREATE">
                <Authorized>
                    <button type="button" @onclick="OpenNewForm" class="px-5 py-2.5 bg-emerald-600 text-white font-bold text-sm rounded-xl hover:bg-emerald-700 transition-colors shadow-sm flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        Create Invoice
                    </button>
                </Authorized>
            </PermissionGate>
        }
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading setup data...</div>
    }
    else if (HasCompany)
    {
        @if (showForm)
        {
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-visible mb-8">

                <EditForm Model="invoice">
                    <DataAnnotationsValidator />

                    <div class="p-6 md:p-8 space-y-8">

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 bg-slate-50 p-6 rounded-2xl border border-slate-200">
                            <div>
                                <label class="label">Customer <span class="text-rose-500">*</span></label>
                                <select value="@invoice.CustomerId" @onchange="OnCustomerChanged" class="input-class font-bold text-slate-800 bg-white" disabled="@IsLocked">
                                    <option value="@Guid.Empty">-- Select Customer --</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="label">Invoice Date</label>
                                <input type="date" value="@invoice.Date.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) invoice.Date = d; })" class="input-class bg-white" disabled="@IsLocked" />
                            </div>

                            <div>
                                <label class="label">Currency & Rate</label>
                                <div class="flex gap-2">
                                    <select value="@invoice.CurrencyId" class="input-class w-1/3 bg-slate-100 text-slate-500 font-bold cursor-not-allowed px-2" disabled>
                                        <option value="@Guid.Empty">N/A</option>
                                        @foreach (var c in currencies)
                                        {
                                            <option value="@c.Id">@c.CurrencyCode</option>
                                        }
                                    </select>
                                    <input type="number" step="0.01" @bind="invoice.ExchangeRate" class="input-class w-2/3 text-right font-mono font-bold bg-white" disabled="@IsLocked" />
                                </div>
                            </div>

                            <div>
                                <label class="label">Tax / VAT</label>
                                <select value="@invoice.TaxId" @onchange="OnTaxChanged" class="input-class bg-white" disabled="@IsLocked">
                                    <option value="">No Tax</option>
                                    @foreach (var t in taxes)
                                    {
                                        <option value="@t.Id">@t.TaxName (@t.Per%)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="border border-slate-200 rounded-xl shadow-sm">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-[50%]">Description / Service Rendered <span class="text-rose-500">*</span></th>
                                        <th class="p-3 w-[15%] text-center">Qty</th>
                                        <th class="p-3 w-[15%] text-right">Unit Price</th>
                                        <th class="p-3 w-[15%] text-right pr-4">Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in invoice.Lines)
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="p-2 pl-4 align-top pt-3">
                                                <InputText @bind-Value="line.Description" class="input-class" placeholder="e.g. Consulting Fees for March" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.01" @bind="line.Quantity" class="input-class text-center font-bold" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.01" @bind="line.UnitPrice" class="input-class text-right font-mono" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-5 text-right font-mono font-bold text-slate-700">
                                                @((line.Quantity * line.UnitPrice).ToString("N2"))
                                            </td>
                                            <td class="p-2 text-center align-top pt-5">
                                                @if (!IsLocked)
                                                {
                                                    <button type="button" @onclick="() => invoice.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (!IsLocked)
                            {
                                <div class="p-2 bg-slate-50 border-t border-slate-200 rounded-b-xl">
                                    <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Free-Text Line
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="flex justify-end pt-4">
                            <div class="w-full md:w-80 space-y-4">
                                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm space-y-2 text-sm text-slate-600">
                                    <div class="flex justify-between">
                                        <span>Subtotal:</span>
                                        <span class="font-mono font-bold">@SubTotalForeign.ToString("N2")</span>
                                    </div>
                                    <div class="flex justify-between items-center pt-2">
                                        <span>Tax (@TaxPercentage%):</span>
                                        <span class="font-mono font-bold">+ @TaxAmountForeign.ToString("N2")</span>
                                    </div>
                                    <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                        <span class="font-bold">Total (@currencySymbol):</span>
                                        <span class="font-mono font-black text-emerald-700 text-2xl">@GrandTotalForeign.ToString("N2")</span>
                                    </div>
                                    <div class="flex justify-between text-[10px] text-slate-400 mt-2 uppercase font-bold tracking-wider pt-2">
                                        <span>Ledger Base Asset:</span>
                                        <span class="font-mono text-slate-500">@GrandTotalBase.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="p-6 border-t border-slate-100 bg-slate-50/50 flex justify-end gap-3 rounded-b-2xl">
                        @if (IsLocked)
                        {
                            <div class="mr-auto flex items-center gap-2">
                                <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-lg border border-emerald-200 uppercase tracking-wider flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Posted
                                </span>

                                <button type="button" @onclick="() => DownloadInvoice(invoice)" disabled="@isExporting" class="px-5 py-1.5 rounded-lg border border-slate-300 text-slate-700 bg-white font-bold text-xs hover:bg-slate-50 transition-colors flex items-center gap-2 disabled:opacity-50 shadow-sm">
                                    @if (isExporting)
                                    {
                                        <span class="animate-spin">↻</span>
                                    }
                                    Download Invoice
                                </button>
                            </div>
                        }

                        <button type="button" @onclick="CloseForm" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-100 transition-colors">
                            Close
                        </button>

                        <button type="button" @onclick="() => ResetForm(revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty)" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-white transition-colors">
                            @if (IsLocked)
                            {
                                <span>New Invoice</span>
                            }
                            else
                            {

                                <span>Clear</span>
                            }
                        </button>

                        @if (!IsLocked)
                        {
                            <PermissionGate Key="SALES_INVOICE_POST">
                                <Authorized>
                                    <button type="button" @onclick="PostInvoice" disabled="@isBusy" class="px-8 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-700 shadow-md transition-all active:scale-95 disabled:opacity-50 flex items-center gap-2">
                                        @if (isBusy)
                                        {
                                            <span class="animate-spin">↻</span>
                                        }
                                        Post Invoice
                                    </button>
                                </Authorized>
                            </PermissionGate>
                        }
                    </div>
                </EditForm>

            </div>
        }

        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mt-8">
            <div class="p-6 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                <h2 class="text-lg font-bold text-slate-800">Past Direct Invoices</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-100 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase tracking-wider">
                        <tr>
                            <th class="p-4 pl-6">Date</th>
                            <th class="p-4">Invoice #</th>
                            <th class="p-4">Customer</th>
                            <th class="p-4">Description</th>
                            <th class="p-4 text-right">Total (Foreign)</th>
                            <th class="p-4 text-right">Total (Base)</th>
                            <th class="p-4 text-center">Status</th>
                            <th class="p-4 pr-6 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (pastInvoices == null || !pastInvoices.Any())
                        {
                            <tr>
                                <td colspan="8" class="p-8 text-center text-slate-400 italic">No past direct invoices found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pInv in pastInvoices)
                            {
                                decimal pGrandBase = pInv.GrandTotalForeign * (pInv.ExchangeRate > 0 ? pInv.ExchangeRate : 1);
                                string pCurr = pInv.Currency?.CurrencyCode ?? "N/A";

                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="p-4 pl-6 whitespace-nowrap">@pInv.Date.ToString("MMM dd, yyyy")</td>
                                    <td class="p-4 font-mono text-slate-600 font-semibold whitespace-nowrap">@pInv.OrderNumber</td>
                                    <td class="p-4 font-bold text-slate-800">@(pInv.Customer?.Name ?? "Unknown")</td>
                                    <td class="p-4 text-slate-500 max-w-[200px] truncate" title="@(pInv.Lines.FirstOrDefault()?.Description)">
                                        @(pInv.Lines.FirstOrDefault()?.Description ?? "Direct Invoice")
                                    </td>
                                    <td class="p-4 text-right font-mono font-bold text-slate-700">
                                        @pInv.GrandTotalForeign.ToString("N2") <span class="text-[10px] text-slate-400">@pCurr</span>
                                    </td>
                                    <td class="p-4 text-right font-mono font-bold text-emerald-700">
                                        @pGrandBase.ToString("N2")
                                    </td>
                                    <td class="p-4 text-center">
                                        @if (pInv.Status == OrderStatus.Invoiced)
                                        {
                                            <span class="px-2 py-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded uppercase tracking-wider">Posted</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-1 bg-amber-100 text-amber-800 text-[10px] font-bold rounded uppercase tracking-wider">Draft</span>
                                        }
                                    </td>
                                    <td class="p-4 pr-6 text-center space-x-2 whitespace-nowrap">
                                        <button type="button" @onclick="() => LoadInvoiceForView(pInv)" class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 hover:text-slate-900 text-xs font-bold transition-colors">
                                            View
                                        </button>

                                        @if (pInv.Status == OrderStatus.Invoiced)
                                        {
                                            @if (pInv.IsFullyPaid)
                                            {
                                                <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                                    Paid
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button" @onclick="() => NavigateToPayment(pInv.Id)" class="px-3 py-1.5 bg-indigo-50 text-indigo-600 border border-indigo-200 rounded-lg hover:bg-indigo-600 hover:text-white text-xs font-bold transition-colors">
                                                    @(pInv.AmountPaid > 0 ? "Receive Balance" : "Receive Payment")
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showEmailPopup)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border border-slate-200 animate-in zoom-in-95 duration-200">

            <div class="p-6 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <h3 class="font-bold text-slate-800 uppercase tracking-wider text-sm">Send Invoice via Email</h3>
                <button type="button" @onclick="() => { showEmailPopup = false; showForm = false; }" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="label">To Customer:</label>
                    <input type="text" class="input-class bg-slate-50 cursor-not-allowed font-bold text-slate-600" value="@($"{emailCustomerName} <{emailCustomerAddress}>")" disabled />
                </div>

                <div>
                    <label class="label">Subject:</label>
                    <input type="text" class="input-class font-bold text-slate-800" value="@emailSubject" disabled />
                </div>

                <div>
                    <label class="label">Professional Message:</label>
                    <textarea @bind="customEmailMessage" class="input-class h-36 resize-none text-sm text-slate-700"></textarea>
                </div>

                <div class="flex items-center gap-2 p-3 bg-indigo-50 border border-indigo-100 rounded-lg text-indigo-700 text-xs font-bold">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                    A PDF copy of the invoice will be attached automatically.
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
                <button type="button" @onclick="() => { showEmailPopup = false; showForm = false; }" class="px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors disabled:opacity-50" disabled="@isSendingEmail">
                    Skip
                </button>
                <button type="button" @onclick="DispatchEmail" class="px-6 py-2.5 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50" disabled="@isSendingEmail">
                    @if (isSendingEmail)
                    {
                        <span class="animate-spin">↻</span> <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Email</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        color: #0f172a;
        outline: none;
        transition: border-color 0.2s;
    }

        .input-class:focus {
            border-color: #059669;
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
        }

        .input-class:disabled {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
        }
</style>

@code {
    private Guid selectedCompanyId;
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private bool isBusy = false;
    private bool isExporting = false;
    private bool showForm = false;

    private SalesOrder invoice = new();
    private List<SalesOrder> pastInvoices = new();
    private List<Customer> customers = new();
    private List<Currency> currencies = new();
    private List<Tax> taxes = new();
    private List<SegChartOfAccount> revenueAccounts = new();
    private List<SegChartOfAccount> taxAccounts = new();

    private string currencySymbol = "";
    private bool IsLocked => invoice.Status == OrderStatus.Invoiced;

    // Email Modal Backing Fields
    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private Guid emailTargetInvoiceId = Guid.Empty;
    private string emailCustomerName = "";
    private string emailCustomerAddress = "";
    private string emailSubject = "";
    private string customEmailMessage = "";

    // Math logic mapped to handle foreign currency correctly
    private decimal SubTotalForeign => invoice.Lines.Sum(l => l.Quantity * l.UnitPrice);
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == invoice.TaxId)?.Per ?? 0;
    private decimal DiscountForeign => invoice.DiscountPercentage > 0 ? SubTotalForeign * (invoice.DiscountPercentage / 100) : invoice.DiscountAmount;
    private decimal TaxAmountForeign => (SubTotalForeign - DiscountForeign) * (TaxPercentage / 100);
    private decimal GrandTotalForeign => (SubTotalForeign - DiscountForeign) + TaxAmountForeign;
    private decimal GrandTotalBase => invoice.ExchangeRate == 0 ? 0 : GrandTotalForeign * invoice.ExchangeRate;
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SALES_ORDER_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            selectedCompanyId = user.CompanyDetailsId.Value;
            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();

        customers = await ctx.Customers.Where(c => c.CompanyId == selectedCompanyId).ToListAsync();
        currencies = await CurrService.GetCurrenciesAsync(selectedCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == selectedCompanyId).ToListAsync();

        var accountTypes = await SegCoaService.GetAccountTypesAsync();
        var allAccounts = await SegCoaService.GetCoaAsync(selectedCompanyId);

        revenueAccounts = allAccounts.Where(a =>
                {
                    var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                    return type != null && type.IsBalanceSheet == false && type.IsDebit == false && a.IsActive;
                }).OrderBy(x => x.AccountCode).ToList();

        taxAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        Guid defaultIncomeGl = revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty;

        await FetchPastInvoices();
        ResetForm(defaultIncomeGl);
    }

    private async Task FetchPastInvoices()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();

        var invoices = await ctx.SalesOrders
                    .Include(o => o.Customer)
                    .Include(o => o.Currency)
                    .Include(o => o.Lines)
                    .Where(o => o.CompanyId == selectedCompanyId && o.IsDirectInvoice)
                    .OrderByDescending(o => o.Date)
                    .AsNoTracking()
                    .ToListAsync();

        var invoiceIds = invoices.Select(i => i.Id).ToList();
        var payments = await ctx.PaymentApplications
            .Where(pa => invoiceIds.Contains(pa.InvoiceId))
            .GroupBy(pa => pa.InvoiceId)
            .Select(g => new { InvoiceId = g.Key, TotalPaid = g.Sum(x => x.AppliedAmount + x.CashDiscountTaken) })
            .ToDictionaryAsync(x => x.InvoiceId, x => x.TotalPaid);

        foreach (var inv in invoices)
        {
            decimal pSubTotal = inv.Lines.Sum(l => l.Quantity * l.UnitPrice);
            decimal pDiscount = inv.DiscountPercentage > 0 ? pSubTotal * (inv.DiscountPercentage / 100) : inv.DiscountAmount;
            decimal pNet = pSubTotal - pDiscount;
            decimal pTaxPer = inv.TaxId.HasValue && taxes.FirstOrDefault(t => t.Id == inv.TaxId) != null ? taxes.FirstOrDefault(t => t.Id == inv.TaxId)!.Per : 0;

            inv.GrandTotalForeign = pNet + (pNet * (pTaxPer / 100));
            inv.AmountPaid = payments.ContainsKey(inv.Id) ? payments[inv.Id] : 0;
        }

        pastInvoices = invoices;
    }

    private void OpenNewForm()
    {
        ResetForm(revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty);
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
    }

    private void ResetForm(Guid defaultIncomeGl)
    {
        invoice = new SalesOrder
        {
            CompanyId = selectedCompanyId,
            Date = DateOnly.FromDateTime(DateTime.Today),
            ExchangeRate = 1,
            DirectIncomeGlAccountId = defaultIncomeGl
        };
        currencySymbol = "";
        AddLine();
    }

    private void AddLine() => invoice.Lines.Add(new SalesOrderLine { Quantity = 1 });

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var custId))
        {
            invoice.CustomerId = custId;
            var customer = customers.FirstOrDefault(c => c.Id == custId);

            if (customer != null && customer.CurrencyId != Guid.Empty)
            {
                invoice.CurrencyId = customer.CurrencyId;
                currencySymbol = currencies.FirstOrDefault(c => c.Id == customer.CurrencyId)?.CurrencyCode ?? "";
                invoice.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, invoice.CurrencyId);
            }
        }
        else
        {
            invoice.CustomerId = Guid.Empty;
            currencySymbol = "";
        }
    }

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId))
        {
            invoice.TaxId = taxId;
            var selectedTax = taxes.FirstOrDefault(t => t.Id == taxId);
            if (selectedTax != null) invoice.TaxGLAccountId = selectedTax.GLAccountId;
        }
        else
        {
            invoice.TaxId = null;
            invoice.TaxGLAccountId = null;
        }
    }

    private async Task PostInvoice()
    {
        if (invoice.CustomerId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Customer.");
            return;
        }

        if (invoice.DirectIncomeGlAccountId == null || invoice.DirectIncomeGlAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Credit GL Account (Revenue).");
            return;
        }

        if (!invoice.Lines.Any())
        {
            await JS.InvokeVoidAsync("alert", "Please add at least one line item.");
            return;
        }

        if (invoice.Lines.Any(l => string.IsNullOrWhiteSpace(l.Description)))
        {
            await JS.InvokeVoidAsync("alert", "All lines must have a Description / Service Rendered.");
            return;
        }

        isBusy = true;
        StateHasChanged();

        var err = await SalesService.PostDirectInvoiceAsync(invoice, currentUserId);

        if (string.IsNullOrEmpty(err))
        {
            await FetchPastInvoices();

            // 1. Check corporate configuration safety toggle switch
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var emailConfig = await ctx.CompanyEmailSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == selectedCompanyId);
            bool showPopupToggle = emailConfig?.EnableInvoiceEmailPopup ?? true;

            if (!showPopupToggle)
            {
                await JS.InvokeVoidAsync("alert", "Direct Invoice Posted Successfully!");
                showForm = false; // Collapse entry layout view back to historical grid list
                ResetForm(revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty);
                isBusy = false;
                StateHasChanged();
                return;
            }

            // 2. Hydrate composition context if configuration preference permits
            var targetCustomer = customers.FirstOrDefault(c => c.Id == invoice.CustomerId);
            if (targetCustomer != null && !string.IsNullOrWhiteSpace(targetCustomer.Email))
            {
                emailTargetInvoiceId = invoice.Id;
                emailCustomerName = targetCustomer.Name;
                emailCustomerAddress = targetCustomer.Email;
                emailSubject = $"Invoice {invoice.OrderNumber} ";
                customEmailMessage = $"Dear {targetCustomer.Name},\n\nPlease find attached our official invoice {invoice.OrderNumber} issued regarding services rendered.\n\nTotal Due: {currencySymbol}{invoice.GrandTotalForeign:N2}.\n\nThank you for your business!\n\nBest Regards,\nAccounts Receivable Team";

                showEmailPopup = true;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Invoice Posted Successfully!\n(No email sent: Customer missing email address).");
                showForm = false;
            }
            ResetForm(revenueAccounts.FirstOrDefault()?.Id ?? Guid.Empty);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }

        isBusy = false;
        StateHasChanged();
    }

    private async Task DispatchEmail()
    {
        if (emailTargetInvoiceId == Guid.Empty) return;

        isSendingEmail = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            var printInvoice = pastInvoices.FirstOrDefault(i => i.Id == emailTargetInvoiceId) ?? invoice;

            var pdfBytes = ExportService.GenerateDirectInvoicePdf(printInvoice, company);
            var fileName = $"AR_Invoice_{printInvoice.OrderNumber}.pdf";

            await EmailService.SendEmailAsync(
                emailCustomerAddress,
                emailSubject,
                customEmailMessage.Replace("\n", "<br>"),
                pdfBytes,
                fileName
            );

            await JS.InvokeVoidAsync("alert", "Invoice emailed successfully!");
            showEmailPopup = false;
            showForm = false; // Safely return layout to view grid
            emailTargetInvoiceId = Guid.Empty;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}");
        }
        finally
        {
            isSendingEmail = false;
            StateHasChanged();
        }
    }

    private void LoadInvoiceForView(SalesOrder selectedInvoice)
    {
        invoice = selectedInvoice;

        var customer = customers.FirstOrDefault(c => c.Id == invoice.CustomerId);
        if (customer != null && customer.CurrencyId != Guid.Empty)
        {
            currencySymbol = currencies.FirstOrDefault(c => c.Id == customer.CurrencyId)?.CurrencyCode ?? "";
        }
        else
        {
            currencySymbol = invoice.Currency?.CurrencyCode ?? "";
        }

        showForm = true;
        JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private void NavigateToPayment(Guid invoiceId)
    {
        NavManager.NavigateTo($"/ar/payment-entry?invoiceId={invoiceId}");
    }

    private async Task DownloadInvoice(SalesOrder targetInvoice)
    {
        if (targetInvoice == null || targetInvoice.Id == Guid.Empty) return;

        isExporting = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            if (company == null) return;

            targetInvoice.GrandTotalForeign = targetInvoice.Lines.Sum(l => l.Quantity * l.UnitPrice)
                                            - (targetInvoice.DiscountPercentage > 0 ? targetInvoice.Lines.Sum(l => l.Quantity * l.UnitPrice) * (targetInvoice.DiscountPercentage / 100) : targetInvoice.DiscountAmount)
                                            + ((targetInvoice.Lines.Sum(l => l.Quantity * l.UnitPrice) - (targetInvoice.DiscountPercentage > 0 ? targetInvoice.Lines.Sum(l => l.Quantity * l.UnitPrice) * (targetInvoice.DiscountPercentage / 100) : targetInvoice.DiscountAmount)) * (taxes.FirstOrDefault(t => t.Id == targetInvoice.TaxId)?.Per ?? 0) / 100);

            var pdfBytes = ExportService.GenerateDirectInvoicePdf(targetInvoice, company);
            var fileName = $"AR_Invoice_{targetInvoice.OrderNumber}.pdf";

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(pdfBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }
}