@page "/tax-setup"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject TaxService Service
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Tax Configuration</h1>
            <p class="text-sm text-slate-500">Manage tax rates and codes.</p>
        </div>

        <button @onclick="ShowAddForm"
                class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-all active:scale-95">
            + Add Tax
        </button>
    </div>

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-4 border-b border-slate-100 pb-2 flex items-center justify-between">
                <h3 class="font-semibold text-slate-800">@(isEditing ? "Edit Tax Rate" : "New Tax Rate")</h3>

                <button type="button"
                        @onclick="CancelEdit"
                        class="rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">
                    Close
                </button>
            </div>

            <EditForm Model="@currentTax" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                    <div class="md:col-span-3">
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Tax Code</label>
                        <InputText @bind-Value="currentTax.TaxCode"
                                   class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 transition-all font-mono"
                                   placeholder="e.g. VAT-7.5" />
                    </div>

                    <div class="md:col-span-6">
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Tax Name</label>
                        <InputText @bind-Value="currentTax.TaxName"
                                   class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 transition-all"
                                   placeholder="e.g. Value Added Tax" />
                    </div>

                    <div class="md:col-span-3">
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Percentage (%)</label>
                        <div class="relative">
                            <InputNumber @bind-Value="currentTax.Per"
                                         class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 transition-all pr-8"
                                         placeholder="0.00" />
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                                <span class="text-slate-400 text-sm font-bold">%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
                    <button type="button"
                            @onclick="CancelEdit"
                            class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50">
                        Cancel
                    </button>

                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-all active:scale-95">
                        @(isEditing ? "Update Tax" : "Save Tax")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50/50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4">Tax Code</th>
                    <th class="px-6 py-4">Description</th>
                    <th class="px-6 py-4">Rate</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (taxes.Any())
                {
                    @foreach (var item in taxes)
                    {
                        <tr class="group hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 font-mono font-bold text-indigo-600">@item.TaxCode</td>
                            <td class="px-6 py-4 font-medium text-slate-900">@item.TaxName</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded-lg bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700">
                                    @item.Per.ToString("0.##")%
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button @onclick="() => EditTax(item)" class="text-indigo-600 hover:underline px-2">Edit</button>
                                    <button @onclick="() => DeleteTax(item)" class="text-red-600 hover:underline px-2">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                            No tax rates configured yet. Click <span class="font-semibold text-slate-600">Add Tax</span> to create one.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Tax> taxes = new();
    private Tax currentTax = new();
    private bool isEditing = false;
    private bool showForm = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        taxes = await Service.GetTaxesAsync();
    }

    private void ShowAddForm()
    {
        currentTax = new Tax();
        isEditing = false;
        showForm = true;
    }

    private async Task HandleSubmit()
    {
        string result = await Service.SaveTaxAsync(currentTax);

        if (string.IsNullOrEmpty(result))
        {
            await LoadData();
            CancelEdit();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", result);
        }
    }

    private void EditTax(Tax item)
    {
        currentTax = new Tax
        {
            Id = item.Id,
            TaxCode = item.TaxCode,
            TaxName = item.TaxName,
            Per = item.Per
        };

        isEditing = true;
        showForm = true;
    }

    private void CancelEdit()
    {
        currentTax = new Tax();
        isEditing = false;
        showForm = false;
    }

    private async Task DeleteTax(Tax item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {item.TaxName}?"))
        {
            if (await Service.DeleteTaxAsync(item.Id))
            {
                await LoadData();
                if (isEditing && currentTax.Id == item.Id) CancelEdit();
            }
        }
    }
}
