@page "/tax-setup"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject TaxService Service
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Tax Configuration</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Manage tax rates and codes.</p>
        </div>

        <div class="flex gap-2">
            @if (!showForm)
            {
                <button @onclick="ShowAddForm" disabled="@(!HasCompany)"
                        class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    Add Tax
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading taxes...
        </div>
    }
    else if (showForm && HasCompany)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 animate-in fade-in slide-in-from-top-4 mb-6">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-900">@(isEditing ? "Edit Tax Rate" : "New Tax Rate")</h3>
                <button @onclick="CancelEdit" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="@currentTax" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
                    <div class="md:col-span-3">
                        <label class="label">Tax Code</label>
                        <InputText @bind-Value="currentTax.TaxCode" class="input-class font-mono" placeholder="e.g. VAT-7.5" />
                    </div>

                    <div class="md:col-span-6">
                        <label class="label">Tax Name</label>
                        <InputText @bind-Value="currentTax.TaxName" class="input-class" placeholder="e.g. Value Added Tax" />
                    </div>

                    <div class="md:col-span-3">
                        <label class="label">Percentage (%)</label>
                        <div class="relative">
                            <InputNumber @bind-Value="currentTax.Per" class="input-class pr-8" placeholder="0.00" />
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                                <span class="text-slate-400 text-sm font-bold">%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
                    <button type="button" @onclick="CancelEdit" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                        @(isEditing ? "Update Tax" : "Save Tax")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-900">
            <thead class="bg-slate-50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                <tr>
                    <th class="px-6 py-4">Tax Code</th>
                    <th class="px-6 py-4">Description</th>
                    <th class="px-6 py-4">Rate</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (taxes.Any())
                {
                    @foreach (var item in taxes)
                    {
                        <tr class="group hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-mono font-bold text-slate-900">@item.TaxCode</td>
                            <td class="px-6 py-4 font-medium text-slate-700">@item.TaxName</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-900">
                                    @item.Per.ToString("0.##")%
                                </span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-3 opacity-100">
                                    <button @onclick="() => EditTax(item)" class="text-slate-600 hover:text-slate-900 font-bold hover:underline transition-all">Edit</button>
                                    <button @onclick="() => DeleteTax(item)" class="text-slate-400 hover:text-red-600 font-bold hover:underline transition-all">Delete</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-slate-400">
                            No tax rates configured for this company.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.025em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
        }
</style>

@code {
    // --- Context ---
    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;

    // --- Data ---
    private List<Tax> taxes = new();
    private Tax currentTax = new();
    private bool isEditing = false;
    private bool showForm = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                await LoadData();
            }
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        if (!HasCompany) { taxes = new(); return; }
        taxes = await Service.GetTaxesAsync(selectedCompanyId);
    }

    private void ShowAddForm()
    {
        currentTax = new Tax();
        isEditing = false;
        showForm = true;
    }

    private async Task HandleSubmit()
    {
        var result = await Service.SaveTaxAsync(selectedCompanyId, currentTax);

        if (string.IsNullOrEmpty(result))
        {
            await LoadData();
            CancelEdit();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", result);
        }
    }

    private void EditTax(Tax item)
    {
        currentTax = new Tax
        {
            Id = item.Id,
            TaxCode = item.TaxCode,
            TaxName = item.TaxName,
            Per = item.Per
        };

        isEditing = true;
        showForm = true;
    }

    private void CancelEdit()
    {
        currentTax = new Tax();
        isEditing = false;
        showForm = false;
    }

    private async Task DeleteTax(Tax item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Delete {item.TaxName}?"))
        {
            if (await Service.DeleteTaxAsync(selectedCompanyId, item.Id))
            {
                await LoadData();
                if (isEditing && currentTax.Id == item.Id) CancelEdit();
            }
        }
    }
}