@page "/purchases/returns/entry/{Id:guid?}"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject PurchaseReturnService RtvService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 font-sans text-slate-800">

    <div class="flex items-center justify-between bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
                @(IsNew ? "New Purchase Return" : $"{currentRtv.ReturnNumber}")
            </h1>
            <p class="text-sm font-medium @(IsPosted ? "text-emerald-600" : "text-amber-600")">
                @(IsPosted ? "● Posted Return Document" : "● Draft Return - Pending Post")
            </p>
        </div>
        <div class="flex gap-3">
            <button @onclick='() => Nav.NavigateTo("/purchases/returns")'
                    class="px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-600 font-bold hover:bg-slate-50 transition-colors shadow-sm">
                Back
            </button>

            @if (!IsPosted && !IsNew)
            {
                <PermissionGate Key="PO_RETURN_MANAGE">
                    <Authorized>
                        <button @onclick="TerminateReturn"
                                class="px-5 py-2.5 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-sm font-bold hover:bg-rose-100 transition-colors">
                            Terminate
                        </button>

                        <button @onclick="SaveDraft"
                                class="px-5 py-2.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-xl text-sm font-bold hover:bg-indigo-100 transition-colors shadow-sm">
                            Save Draft
                        </button>
                    </Authorized>
                </PermissionGate>

                <PermissionGate Key="PO_RETURN_POST">
                    <Authorized>
                        <button @onclick="PostReturn"
                                class="px-6 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 shadow-md transition-all hover:-translate-y-0.5 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Post Return
                        </button>
                    </Authorized>
                </PermissionGate>
            }
        </div>
    </div>

    @if (IsNew)
    {
        <div class="bg-white p-10 rounded-2xl border border-slate-200 shadow-sm max-w-2xl mx-auto mt-12 text-center">
            <div class="mx-auto w-16 h-16 bg-rose-50 text-rose-600 rounded-full flex items-center justify-center mb-6 border border-rose-100">
                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 15v-1a4 4 0 00-4-4H8m0 0l3 3m-3-3l3-3m9 14V5a2 2 0 00-2-2H6a2 2 0 00-2 2v16l4-2 4 2 4-2 4 2z" /></svg>
            </div>
            <h3 class="text-xl font-extrabold text-slate-900 mb-2">Create Purchase Return</h3>
            <p class="text-slate-500 text-sm mb-8 font-medium">Select a Posted Vendor Bill to initiate a return to the supplier.</p>

            <div class="flex flex-col gap-5 max-w-sm mx-auto text-left">

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Vendor</label>
                    <select @onchange="OnVendorSelected" class="w-full p-3 border border-slate-300 rounded-xl bg-slate-50 text-slate-800 font-bold focus:ring-2 focus:ring-indigo-500 outline-none transition-all" disabled="@_busy">
                        <option value="">-- Select Vendor --</option>
                        @foreach (var v in vendors)
                        {
                            <option value="@v.Id">@v.Name</option>
                        }
                    </select>
                </div>

                <div class="relative text-left">
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Search & Select Bill</label>
                    <div class="relative">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        <input type="text"
                               @bind="billSearchTerm"
                               @bind:event="oninput"
                               @onfocus="() => isBillDropdownOpen = true"
                               @onblur="HideDropdownWithDelay"
                               disabled="@(_busy || selectedVendorId == Guid.Empty)"
                               placeholder="Type bill number..."
                               class="w-full pl-9 pr-4 py-3 border border-slate-300 rounded-xl bg-slate-50 text-slate-800 font-bold focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none transition-all disabled:opacity-50" />
                    </div>

                    @if (isBillDropdownOpen && selectedVendorId != Guid.Empty)
                    {
                        <ul class="absolute z-10 w-full mt-2 bg-white border border-slate-200 rounded-xl shadow-xl max-h-60 overflow-auto animate-in fade-in slide-in-from-top-2">
                            @if (FilteredEligibleBills.Any())
                            {
                                @foreach (var b in FilteredEligibleBills)
                                {
                                    <li @onclick="() => SelectBill(b.Id, b.DisplayText)"
                                        class="px-4 py-3 hover:bg-indigo-50 cursor-pointer text-sm text-slate-700 font-medium border-b border-slate-50 last:border-0 transition-colors">
                                        @b.DisplayText
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="px-4 py-4 text-sm text-slate-400 text-center font-medium">No posted bills found matching search.</li>
                            }
                        </ul>
                    }
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Return From Warehouse</label>
                    <select @bind="selectedWarehouseId" class="w-full p-3 border border-slate-300 rounded-xl bg-slate-50 text-slate-800 font-bold focus:ring-2 focus:ring-indigo-500 outline-none transition-all" disabled="@_busy">
                        <option value="">-- Select Source Warehouse --</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>

                <PermissionGate Key="PO_RETURN_MANAGE">
                    <Authorized>
                        <button @onclick="InitializeReturn"
                                disabled="@(_busy || selectedBillId == Guid.Empty || selectedWarehouseId == Guid.Empty)"
                                class="mt-2 w-full px-6 py-3.5 bg-indigo-600 text-white rounded-xl font-bold text-sm hover:bg-indigo-700 shadow-md disabled:opacity-50 transition-all flex items-center justify-center gap-2">
                            @if (_busy)
                            {
                                <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                                <span>Loading Items...</span>
                            }
                            else
                            {
                                <span>Load Items & Create Draft</span>
                            }
                        </button>
                    </Authorized>
                </PermissionGate>

                @if (!string.IsNullOrWhiteSpace(_errMsg))
                {
                    <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-rose-700 text-sm font-medium flex items-start gap-2">
                        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        @_errMsg
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <div class="lg:col-span-4 space-y-6">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                    <h3 class="font-extrabold text-xs text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Reference Info</h3>

                    <div>
                        <label class="label">Return Date</label>
                        <InputDate @bind-Value="currentRtv.ReturnDate" class="input-class" disabled="@IsPosted" />
                    </div>

                    <div>
                        <label class="label text-slate-500">Vendor</label>
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800">
                            @(vendors.FirstOrDefault(v => v.Id == currentRtv.VendorId)?.Name)
                        </div>
                    </div>

                    <div>
                        <label class="label text-slate-500">Original Bill</label>
                        <div class="font-mono bg-slate-50 p-3 rounded-xl border border-slate-200 text-sm font-bold text-slate-800">
                            @(originalBill?.ExternalInvoiceNumber ?? "Loading...")
                        </div>
                    </div>

                    <div>
                        <label class="label text-slate-500">Warehouse</label>
                        <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800">
                            @(warehouses.FirstOrDefault(w => w.Id == currentRtv.WarehouseId)?.Name)
                        </div>
                    </div>

                    <div>
                        <label class="label text-slate-500">Exchange Rate</label>
                        <div class="font-mono text-slate-700 font-bold p-3 bg-slate-50 rounded-xl border border-slate-200">
                            @currentRtv.ExchangeRate.ToString("N4")
                        </div>
                    </div>

                    <div>
                        <label class="label">Reason</label>
                        <InputTextArea @bind-Value="currentRtv.Reason" class="input-class h-24 resize-none" placeholder="Why are we returning this?" disabled="@IsPosted" />
                    </div>
                </div>
            </div>

            <div class="lg:col-span-8">
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden h-full flex flex-col">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Returnable Items</h3>
                        <span class="text-xs bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full font-bold">Currency: @currencyCode</span>
                    </div>

                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 bg-white tracking-wider">
                                <tr>
                                    <th class="p-4 w-[35%]">Item Details</th>
                                    <th class="p-4 text-center">Billed</th>
                                    <th class="p-4 text-center">Prev Ret.</th>
                                    <th class="p-4 text-center w-32">Return Qty</th>
                                    <th class="p-4 text-right">Unit Cost</th>
                                    <th class="p-4 text-right pr-6">Total</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var line in currentRtv.Lines)
                                {
                                    decimal billed = GetBilledQty(line.VendorBillLineId);
                                    decimal prev = GetPrevReturnedQty(line.VendorBillLineId);
                                    decimal max = billed - prev;

                                    decimal whStock = stockLevels.ContainsKey(line.ItemId) ? stockLevels[line.ItemId] : 0;

                                    <tr class="hover:bg-slate-50/80 align-middle">
                                        <td class="p-4 font-bold text-slate-800">
                                            @line.ItemName
                                            <div class="text-[10px] font-medium mt-1">
                                                (In Warehouse:
                                                <span class="@(whStock < line.QtyReturning ? "text-rose-600 font-bold" : "text-slate-500 font-mono")">@whStock.ToString("G29")</span>)
                                            </div>
                                        </td>
                                        <td class="p-4 text-center font-mono text-slate-500">@billed.ToString("G29")</td>
                                        <td class="p-4 text-center font-mono text-slate-500">@prev.ToString("G29")</td>

                                        <td class="p-4">
                                            @if (IsPosted || max <= 0)
                                            {
                                                <div class="text-center font-mono font-bold text-slate-900">@line.QtyReturning.ToString("G29")</div>
                                                @if (max <= 0)
                                                {
                                                    <div class="text-[9px] text-rose-500 font-bold uppercase text-center mt-1">(Fully Returned)</div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="flex items-center gap-1 justify-center">
                                                    <input type="number"
                                                           value="@line.QtyReturning"
                                                           @onchange="@(e => UpdateQty(line, e.Value, max))"
                                                           class="w-20 text-center font-mono font-bold border border-slate-300 rounded-lg px-2 py-1.5 focus:border-rose-500 focus:ring-2 focus:ring-rose-100 outline-none transition-all disabled:bg-slate-100 disabled:text-slate-400"
                                                           min="0" max="@max" step="1" />

                                                    <button @onclick="() => { line.QtyReturning = max; }"
                                                            class="text-[9px] bg-slate-100 border border-slate-200 px-1.5 py-1.5 rounded-lg hover:bg-slate-200 text-slate-600 font-bold transition-colors"
                                                            title="Return Max Available">
                                                        MAX
                                                    </button>
                                                </div>
                                                <div class="text-[9px] text-slate-400 mt-1 text-center font-bold">Max: @max</div>
                                            }
                                        </td>

                                        <td class="p-4 text-right font-mono text-slate-500">
                                            @line.UnitCost.ToString("N2")
                                        </td>
                                        <td class="p-4 pr-6 text-right font-mono font-black text-rose-600">
                                            @line.LineTotal.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-slate-50 border-t border-slate-200">
                                <tr>
                                    <td colspan="5" class="p-4 text-right font-bold text-slate-600 uppercase text-xs align-top pt-5">Total Refund Value:</td>
                                    <td class="p-4 pr-6 text-right">
                                        <div class="font-mono font-black text-xl text-slate-900">
                                            @currentRtv.Lines.Sum(l => l.LineTotal).ToString("N2") <span class="text-sm text-slate-500">@currencyCode</span>
                                        </div>

                                        @{
                                            decimal baseTotal = currentRtv.Lines.Sum(l => l.LineTotal) * currentRtv.ExchangeRate;
                                        }
                                        <div class="text-xs text-slate-500 font-mono mt-1 border-t border-slate-200 pt-1.5 font-bold">
                                            @baseTotal.ToString("N2") <span class="text-[9px] font-black uppercase tracking-wider">Base</span>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: .05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.75rem;
        font-size: 0.875rem;
        outline: none;
        background: #fff;
        color: #1e293b;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .input-class:focus {
            border-color: #e11d48;
            box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.15);
        }

        .input-class:disabled {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
            border-color: #e2e8f0;
        }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsNew => Id == null;
    private bool IsPosted => currentRtv.Status == ReturnStatus.Posted;

    private PurchaseReturn currentRtv = new();
    private VendorBill? originalBill;

    private List<Vendor> vendors = new();
    private List<Warehouse> warehouses = new();

    private Guid selectedVendorId;
    private Guid selectedBillId;
    private Guid selectedWarehouseId;

    private List<VendorBillLine> sourceLines = new();
    private List<PurchaseReturnLine> historyLines = new();
    private Dictionary<Guid, decimal> stockLevels = new();
    private string currencyCode = "";

    private bool _busy = false;
    private string _errMsg = string.Empty;

    // --- Searchable Dropdown State ---
    private string billSearchTerm = "";
    private bool isBillDropdownOpen = false;

    public class BillSelectorDto
    {
        public Guid Id { get; set; }
        public string DisplayText { get; set; } = "";
    }

    private List<BillSelectorDto> eligibleBills = new();

    private IEnumerable<BillSelectorDto> FilteredEligibleBills => string.IsNullOrWhiteSpace(billSearchTerm)
        ? eligibleBills
        : eligibleBills.Where(b => b.DisplayText.Contains(billSearchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        if (!PermissionCache.Has("PURCHASING_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        // Resolve user state context immediately to acquire Company Details
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId == null)
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        Guid companyId = user.CompanyDetailsId.Value;
        using var ctx = await DbFactory.CreateDbContextAsync();

        if (IsNew)
        {
            if (!vendors.Any())
            {
                // Only populate Dropdowns with company-specific masters
                vendors = await ctx.Vendors.Where(v => v.CompanyId == companyId).OrderBy(v => v.Name).ToListAsync();
                warehouses = await ctx.Warehouses.Where(w => w.CompanyId == companyId).ToListAsync();
            }
        }
        else
        {
            // Prevent cross-company document access by parsing CompanyId into the query predicate
            currentRtv = await ctx.PurchaseReturns
                .Include(r => r.Lines)
                .AsNoTracking()
                .FirstOrDefaultAsync(r => r.Id == Id && r.CompanyId == companyId);

            if (currentRtv == null) { Nav.NavigateTo("/purchases/returns"); return; }

            originalBill = await ctx.VendorBills.FirstOrDefaultAsync(b => b.Id == currentRtv.VendorBillId && b.CompanyId == companyId);
            currentRtv.ExchangeRate = originalBill?.ExchangeRate ?? currentRtv.ExchangeRate;
            await LoadValidationContext(ctx, currentRtv.VendorBillId);

            var vName = await ctx.Vendors.Where(v => v.Id == currentRtv.VendorId && v.CompanyId == companyId).Select(v => v.Name).FirstOrDefaultAsync();
            vendors = new List<Vendor> { new Vendor { Id = currentRtv.VendorId, Name = vName ?? "Unknown" } };

            var wName = await ctx.Warehouses.Where(w => w.Id == currentRtv.WarehouseId && w.CompanyId == companyId).Select(w => w.Name).FirstOrDefaultAsync();
            warehouses = new List<Warehouse> { new Warehouse { Id = currentRtv.WarehouseId, Name = wName ?? "Unknown" } };

            var currency = await ctx.Currencies.FindAsync(currentRtv.CurrencyId);
            currencyCode = currency?.CurrencyCode ?? "";
        }
    }

    private async Task OnVendorSelected(ChangeEventArgs e)
    {
        _errMsg = string.Empty;

        if (_busy) return;

        if (Guid.TryParse(e.Value?.ToString(), out var vid))
        {
            selectedVendorId = vid;
            selectedBillId = Guid.Empty;
            billSearchTerm = "";

            _busy = true;
            StateHasChanged();

            try
            {
                using var ctx = await DbFactory.CreateDbContextAsync();
                var dbBills = await ctx.VendorBills
                    .Where(b => b.VendorId == vid && b.IsPosted)
                    .OrderByDescending(b => b.BillDate)
                    .ToListAsync();

                eligibleBills = dbBills.Select(b => new BillSelectorDto
                {
                    Id = b.Id,
                    DisplayText = $"Inv #{b.ExternalInvoiceNumber} ({b.BillDate.ToShortDateString()}) - Total: {b.TotalAmount:N2}"
                }).ToList();
            }
            catch (Exception ex)
            {
                _errMsg = "Failed to load bills: " + ex.Message;
            }
            finally
            {
                _busy = false;
                StateHasChanged();
            }
        }
        else
        {
            selectedVendorId = Guid.Empty;
            eligibleBills.Clear();
            selectedBillId = Guid.Empty;
            billSearchTerm = "";
        }
    }

    private async Task HideDropdownWithDelay()
    {
        await Task.Delay(200);
        isBillDropdownOpen = false;
        StateHasChanged();
    }

    private void SelectBill(Guid id, string displayText)
    {
        selectedBillId = id;
        billSearchTerm = displayText;
        isBillDropdownOpen = false;
    }

    private async Task InitializeReturn()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user == null)
        {
            _errMsg = "User not authenticated.";
            await JS.InvokeVoidAsync("alert", _errMsg);
            return;
        }

        if (user.CompanyDetailsId == null)
        {
            _errMsg = "No active company profile found for this user account.";
            await JS.InvokeVoidAsync("alert", _errMsg);
            return;
        }

        try
        {
            _busy = true;
            StateHasChanged();

            // Pass user.CompanyDetailsId.Value as the 4th parameter to secure document isolation
            currentRtv = await RtvService.CreateDraftFromBillAsync(
                selectedBillId,
                selectedWarehouseId,
                Guid.Parse(user.Id),
                user.CompanyDetailsId.Value
            );

            var err = await RtvService.SaveDraftAsync(currentRtv);
            if (string.IsNullOrEmpty(err))
            {
                Nav.NavigateTo($"/purchases/returns/entry/{currentRtv.Id}");
            }
            else
            {
                _errMsg = err;
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        catch (Exception ex)
        {
            _errMsg = "Error: " + ex.Message;
            await JS.InvokeVoidAsync("alert", _errMsg);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task LoadValidationContext(AppDbContext ctx, Guid billId)
    {
        sourceLines = await ctx.VendorBillLines.Where(l => l.VendorBillId == billId).ToListAsync();

        historyLines = await ctx.PurchaseReturnLines
            .Include(l => l.PurchaseReturn)
            .Where(l => l.VendorBillLine.VendorBillId == billId && l.PurchaseReturn.Status == ReturnStatus.Posted)
            .ToListAsync();

        var itemIds = sourceLines.Select(l => l.ItemId).Distinct().ToList();

        stockLevels = await ctx.StockLedgers
            .Where(s => itemIds.Contains(s.ItemId) && s.WarehouseId == currentRtv.WarehouseId)
            .GroupBy(s => s.ItemId)
            .Select(g => new { ItemId = g.Key, Qty = g.Sum(x => x.QuantityChanged) })
            .ToDictionaryAsync(k => k.ItemId, v => v.Qty);
    }

    private decimal GetBilledQty(Guid billLineId) => sourceLines.FirstOrDefault(l => l.Id == billLineId)?.QuantityBilled ?? 0;
    private decimal GetPrevReturnedQty(Guid billLineId) => historyLines.Where(l => l.VendorBillLineId == billLineId).Sum(l => l.QtyReturning);

    private void UpdateQty(PurchaseReturnLine line, object? value, decimal max)
    {
        if (decimal.TryParse(value?.ToString(), out var val))
        {
            line.QtyReturning = (val > max) ? max : (val < 0 ? 0 : val);
        }
    }

    private async Task SaveDraft()
    {
        if (currentRtv.Lines.Any(l => l.QtyReturning > (GetBilledQty(l.VendorBillLineId) - GetPrevReturnedQty(l.VendorBillLineId))))
        {
            await JS.InvokeVoidAsync("alert", "One or more lines exceeds the maximum returnable quantity.");
            return;
        }

        var err = await RtvService.SaveDraftAsync(currentRtv);
        if (string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", "Draft Saved.");
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task TerminateReturn()
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "Delete this return? This cannot be undone.");
        if (!confirm) return;

        var err = await RtvService.TerminateReturnAsync(currentRtv.Id);
        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Return Terminated.");
            Nav.NavigateTo("/purchases/returns");
        }
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task PostReturn()
    {
        if (!currentRtv.Lines.Any(l => l.QtyReturning > 0))
        {
            await JS.InvokeVoidAsync("alert", "Please enter a return quantity > 0.");
            return;
        }

        var saveErr = await RtvService.SaveDraftAsync(currentRtv);
        if (!string.IsNullOrEmpty(saveErr)) { await JS.InvokeVoidAsync("alert", "Error saving: " + saveErr); return; }

        var confirm = await JS.InvokeAsync<bool>("confirm", "Confirm posting? This will deduct stock.");
        if (!confirm) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user == null) return;

        var err = await RtvService.PostReturnAsync(currentRtv.Id, Guid.Parse(user.Id));

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Return Posted Successfully.");
            using var ctx = await DbFactory.CreateDbContextAsync();
            currentRtv = await ctx.PurchaseReturns.Include(r => r.Lines).FirstAsync(r => r.Id == currentRtv.Id);
            StateHasChanged();
        }
        else await JS.InvokeVoidAsync("alert", err);
    }
}