@page "/sales/credit-notes"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject CreditNoteService CnService

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Credit Notes</h1>
            <p class="text-sm text-slate-500">Manage sales returns and invoice reversals.</p>
        </div>
        <button @onclick='() => Nav.NavigateTo("/sales/credit-notes/entry")' class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-bold hover:bg-indigo-700 shadow-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            New Credit Note
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse">Loading credit notes...</div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <table class="w-full text-left text-sm text-slate-900">
                <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="p-4">Number</th>
                        <th class="p-4">Date</th>
                        <th class="p-4">Customer</th>
                        <th class="p-4">Ref Invoice</th>
                        <th class="p-4">Status</th>
                        <th class="p-4 text-right">Amount</th>
                        <th class="p-4 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var cn in creditNotes)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="p-4 font-mono font-bold text-indigo-700">@cn.CreditNoteNumber</td>
                            <td class="p-4 text-slate-500">@cn.Date.ToShortDateString()</td>
                            <td class="p-4 font-bold">@cn.Customer?.Name</td>
                            <td class="p-4 text-xs font-mono bg-slate-50 rounded">
                                CN for Inv #@cn.SalesOrder?.Id.ToString().Substring(0, 8)...
                            </td>
                            <td class="p-4">
                                <span class="px-2 py-1 rounded text-xs font-bold border
                                                    @(cn.Status == CreditNoteStatus.Posted ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-amber-50 text-amber-600 border-amber-200")">
                                    @cn.Status
                                </span>
                            </td>
                            <td class="p-4 text-right font-mono font-bold">
                                @cn.TotalAmount.ToString("N2") <span class="text-xs text-slate-400">@cn.Currency?.CurrencyCode</span>
                            </td>
                            <td class="p-4 text-right">
                                <a href="/sales/credit-notes/entry/@cn.Id" class="text-indigo-600 font-bold hover:underline">
                                    @(cn.Status == CreditNoteStatus.Draft ? "Edit" : "View")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!creditNotes.Any())
            {
                <div class="p-12 text-center text-slate-400">No credit notes found.</div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private List<CreditNote> creditNotes = new();

    protected override async Task OnInitializedAsync()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        creditNotes = await ctx.CreditNotes
            .Include(c => c.Customer)
            .Include(c => c.Currency)
            .Include(c => c.SalesOrder)
            .OrderByDescending(c => c.Date)
            .AsNoTracking()
            .ToListAsync();

        isLoading = false;
    }
}