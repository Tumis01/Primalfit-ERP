@page "/reports/budget-variance"
@using System.IO
@using Primafit_ERP.Services
@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Components.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@inject BudgetService BudgetService
@inject CompanyApiService CompanyService
@inject ReportExportService ExportService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-[1400px] mx-auto space-y-6 animate-in fade-in duration-500 pb-12 mt-6">

    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Detailed Budget Variance Report</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Compare period-specific limits against Actuals and PO Encumbrances, with monthly breakdowns.</p>
        </div>

        <div class="flex gap-2">
            <button @onclick="DownloadPdf" disabled="@(isExportingPdf || reportData == null || !reportData.Rows.Any())" class="px-4 py-2 bg-rose-50 text-rose-700 border border-rose-200 font-bold text-xs rounded-xl hover:bg-rose-100 transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed w-28 justify-center">
                @if (isExportingPdf)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-rose-700 border-t-transparent rounded-full"></span>
                    <span>Wait...</span>
                }
                else
                {
                    <span>PDF</span>
                }
            </button>

            <button @onclick="DownloadExcel" disabled="@(isExportingExcel || reportData == null || !reportData.Rows.Any())" class="px-4 py-2 bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold text-xs rounded-xl hover:bg-emerald-100 transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed w-28 justify-center">
                @if (isExportingExcel)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-emerald-700 border-t-transparent rounded-full"></span>
                    <span>Wait...</span>
                }
                else
                {
                    <span>Excel</span>
                }
            </button>
        </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-wrap gap-6 items-end">
        <div>
            <label class="label text-xs font-bold text-slate-500 uppercase tracking-wide mb-1 block">Account Search</label>
            <input type="text" @bind="AccountFilter" @bind:event="oninput" @onkeyup="HandleSearchKey" placeholder="Search Code or Name..." class="border border-slate-200 rounded-lg px-3 py-2 text-sm w-64 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" />
        </div>
        <div>
            <label class="label text-xs font-bold text-slate-500 uppercase tracking-wide mb-1 block">Start Date</label>
            <input type="date" @bind="FilterStartDate" class="border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono w-40 outline-none focus:border-indigo-500" />
        </div>
        <div>
            <label class="label text-xs font-bold text-slate-500 uppercase tracking-wide mb-1 block">End Date</label>
            <input type="date" @bind="FilterEndDate" class="border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono w-40 outline-none focus:border-indigo-500" />
        </div>
        @if (availableBudgets.Any())
        {
            <div>
                <label class="label text-xs font-bold text-slate-500 uppercase tracking-wide mb-1 block">Budget</label>
                <select @bind="selectedBudgetId" class="border border-slate-200 rounded-lg px-3 py-2 text-sm w-56 outline-none focus:border-indigo-500">
                    <option value="">All active budgets</option>
                    @foreach (var availableBudget in availableBudgets)
                    {
                        <option value="@availableBudget.Id">@availableBudget.BudgetName @(availableBudget.IsActive ? "" : "(Inactive)")</option>
                    }
                </select>
            </div>
        }
        <button @onclick="GenerateReport" class="px-6 py-2 bg-indigo-600 text-white font-bold text-sm rounded-lg hover:bg-indigo-700 transition-colors shadow-sm active:scale-95">
            Apply Filters
        </button>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-16 text-center text-slate-400 font-bold animate-pulse flex flex-col items-center gap-3">
            <span class="animate-spin h-6 w-6 border-2 border-indigo-600 border-t-transparent rounded-full"></span>
            Generating detailed variance analysis...
        </div>
    }
    else if (reportData != null)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col h-full">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="px-6 py-4 w-24">@reportData.Headers[0]</th>
                            <th class="px-6 py-4 w-[25%]">@reportData.Headers[1]</th>
                            <th class="px-6 py-4 text-right">@reportData.Headers[2]</th>
                            <th class="px-6 py-4 text-right text-amber-600 bg-amber-50/30">@reportData.Headers[3]</th>
                            <th class="px-6 py-4 text-right text-indigo-600 bg-indigo-50/30">@reportData.Headers[4]</th>
                            <th class="px-6 py-4 text-right text-amber-600 bg-amber-50/30">@reportData.Headers[5]</th>
                            <th class="px-6 py-4 text-right">@reportData.Headers[6]</th>
                            <th class="px-6 py-4 text-right">@reportData.Headers[7]</th>
                            <th class="px-6 py-4 text-right">@reportData.Headers[8]</th>
                            <th class="px-6 py-4 text-center">@reportData.Headers[9]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @for (int i = 0; i < reportData.Rows.Count - 1; i++)
                        {
                            var row = reportData.Rows[i];
                            bool isSubRow = string.IsNullOrWhiteSpace(row[0]); // Subrows have empty account codes
                            
                            <tr class="@(isSubRow ? "bg-slate-50/50 text-xs" : "hover:bg-slate-50/80") transition-colors">
                                <td class="px-6 py-3 font-mono @(!isSubRow ? "font-bold text-slate-900" : "")">
                                    @row[0]
                                </td>
                                <td class="px-6 py-3 @(isSubRow ? "text-slate-500 italic pl-10" : "font-bold text-slate-900") truncate max-w-[200px]" title="@row[1]">
                                    @row[1]
                                </td>
                                <td class="px-6 py-3 text-right font-mono @(!isSubRow ? "font-bold text-slate-800" : "text-slate-500")">@row[2]</td>
                                <td class="px-6 py-3 text-right font-mono text-amber-700 bg-amber-50/30">@row[3]</td>
                                <td class="px-6 py-3 text-right font-mono text-indigo-700 bg-indigo-50/30">@row[4]</td>
                                <td class="px-6 py-3 text-right font-mono text-amber-700 bg-amber-50/30">@row[5]</td>
                                <td class="px-6 py-3 text-right font-mono @(!isSubRow ? "font-bold" : "") text-slate-600">@row[6]</td>
                                <td class="px-6 py-3 text-right font-mono @(!isSubRow ? "font-bold" : "") @(row[7].Contains("(") || row[7].Contains("-") ? "text-rose-600" : "text-emerald-600")">@row[7]</td>
                                <td class="px-6 py-3 text-right font-mono @(!isSubRow ? "font-bold" : "") @(row[8].Contains("(") || row[8].Contains("-") ? "text-rose-600" : "text-emerald-600")">@row[8]</td>
                                <td class="px-6 py-3 text-center text-xs font-bold">
                                    @{
                                        bool isOver = decimal.TryParse(row[9].Replace("%", ""), out decimal pct) && pct > 100;
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row[9]))
                                    {
                                        <span class="px-2 py-1 rounded-lg @(isOver ? "bg-rose-100 text-rose-700" : "bg-slate-100 text-slate-600")">
                                            @row[9]
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                        
                        @if (reportData.Rows.Count <= 1)
                        {
                            <tr><td colspan="10" class="p-16 text-center text-slate-400">No active budget data found for this period and filter.</td></tr>
                        }
                    </tbody>
                    
                    @if (reportData.Rows.Count > 1)
                    {
                        var grandTotalRow = reportData.Rows.Last();
                        <tfoot class="bg-slate-100 border-t-2 border-slate-300">
                            <tr>
                                <td colspan="2" class="px-6 py-4 text-right font-black text-slate-700 uppercase text-xs tracking-wider">GRAND TOTAL</td>
                                <td class="px-6 py-4 text-right font-mono font-black text-slate-900 text-sm">@grandTotalRow[2]</td>
                                <td class="px-6 py-4 text-right font-mono font-black text-amber-700 bg-amber-100 text-sm">@grandTotalRow[3]</td>
                                <td class="px-6 py-4 text-right font-mono font-black text-indigo-700 bg-indigo-100 text-sm">@grandTotalRow[4]</td>
                                <td class="px-6 py-4 text-right font-mono font-black text-amber-700 bg-amber-100 text-sm">@grandTotalRow[5]</td>
                                <td class="px-6 py-4 text-right font-mono font-black text-slate-800 text-sm">@grandTotalRow[6]</td>
                                <td class="px-6 py-4 text-right font-mono font-black @(grandTotalRow[7].Contains("(") || grandTotalRow[7].Contains("-") ? "text-rose-600" : "text-emerald-600") text-sm">@grandTotalRow[7]</td>
                                <td class="px-6 py-4 text-right font-mono font-black @(grandTotalRow[8].Contains("(") || grandTotalRow[8].Contains("-") ? "text-rose-600" : "text-emerald-600") text-sm">@grandTotalRow[8]</td>
                                <td class="px-6 py-4 text-center font-bold text-slate-900">@grandTotalRow[9]</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    }
</div>

@code {
    private Guid companyId = Guid.Empty;
    private string companyName = "";
    private bool isLoading = true;
    
    private bool isExportingPdf = false;
    private bool isExportingExcel = false;

    private StandardReportData? reportData;
    private List<BudgetHeader> availableBudgets = new();
    private Guid? selectedBudgetId;

    // Filters
    private string AccountFilter { get; set; } = "";
    private DateTime FilterStartDate { get; set; } = new DateTime(DateTime.Today.Year, 1, 1); // Default to start of year
    private DateTime FilterEndDate { get; set; } = new DateTime(DateTime.Today.Year, 12, 31); // Default to end of year

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("FINANCE_REPORTS_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null)
        {
            companyId = user.CompanyDetailsId.Value;
            var company = await CompanyService.GetCompanyByIdAsync(companyId);
            if (company != null) companyName = company.CompanyName;

            availableBudgets = await BudgetService.GetAllBudgetsAsync(companyId);
            await GenerateReport();
        }
    }

    private async Task HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await GenerateReport();
        }
    }

    private async Task GenerateReport()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        var start = DateOnly.FromDateTime(FilterStartDate);
        var end = DateOnly.FromDateTime(FilterEndDate);

        // Fetch using the new method with the optional AccountFilter string
        reportData = await BudgetService.GeneratePeriodicVarianceReportAsync(companyId, start, end, AccountFilter, selectedBudgetId);

        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadPdf()
    {
        if (reportData == null) return;
        isExportingPdf = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var pdfBytes = await Task.Run(() => ExportService.GeneratePdf(reportData));
            using var streamRef = new DotNetStreamReference(new MemoryStream(pdfBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", "Detailed_Budget_Variance.pdf", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExportingPdf = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DownloadExcel()
    {
        if (reportData == null) return;
        isExportingExcel = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var excelBytes = await Task.Run(() => ExportService.GenerateExcel(reportData));
            using var streamRef = new DotNetStreamReference(new MemoryStream(excelBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", "Detailed_Budget_Variance.xlsx", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExportingExcel = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
