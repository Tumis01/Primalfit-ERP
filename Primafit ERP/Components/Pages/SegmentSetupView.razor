@page "/finance/segments-setup"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject SegmentsSetupService Service
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Segment Setup</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">
                Name segments, activate segments, and maintain segment values (Code + Description).
            </p>
        </div>

        <div class="flex flex-wrap gap-2">
            <button @onclick="ToggleConfig"
                    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all active:scale-95">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a6 6 0 100 12m0-12a6 6 0 010 12m0 0v2m0-2a6 6 0 01-6-6m6 6a6 6 0 006-6" />
                </svg>
                Configure Segments
            </button>

            <button @onclick="ToggleAddValue"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Add Value
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading...
        </div>
    }
    else if (!HasCompany)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center text-slate-500">
            No company found for this user.
        </div>
    }
    else
    {
        <!-- Config (minimizable) -->
        @if (showConfig)
        {
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="p-6 border-b border-slate-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Configuration</h3>
                        <p class="text-sm text-slate-500 mt-1">Segment0 is always required. You can activate Segment1–Segment5.</p>
                    </div>

                    <div class="flex gap-2">
                        <button @onclick="CancelConfig"
                                class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                            Cancel
                        </button>

                        <button @onclick="SaveConfig"
                                class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95">
                            Save Configuration
                        </button>
                    </div>
                </div>

                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-1.5">
                        <label class="label">Segment 0 Name (Required)</label>
                        <InputText @bind-Value="cfg.Segment0Name" class="@InputClass" />
                        <div class="text-xs text-slate-500 font-medium">Segment0 is compulsory for COA creation.</div>
                    </div>

                    <div class="rounded-xl border border-slate-200 p-4 bg-slate-50">
                        <div class="text-sm font-bold text-slate-900">Active Segments</div>
                        <div class="text-xs text-slate-500 mt-1">Only active segments must be filled during COA creation.</div>
                    </div>

                    @ConfigRow("Segment 1", cfg.Segment1Name, v => cfg.Segment1Name = v, cfg.Segment1Active, v => cfg.Segment1Active = v)
                    @ConfigRow("Segment 2", cfg.Segment2Name, v => cfg.Segment2Name = v, cfg.Segment2Active, v => cfg.Segment2Active = v)
                    @ConfigRow("Segment 3", cfg.Segment3Name, v => cfg.Segment3Name = v, cfg.Segment3Active, v => cfg.Segment3Active = v)
                    @ConfigRow("Segment 4", cfg.Segment4Name, v => cfg.Segment4Name = v, cfg.Segment4Active, v => cfg.Segment4Active = v)
                    @ConfigRow("Segment 5", cfg.Segment5Name, v => cfg.Segment5Name = v, cfg.Segment5Active, v => cfg.Segment5Active = v)
                </div>
            </div>
        }

        <!-- Segment Values -->
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="p-6 border-b border-slate-100 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Segment Values</h3>
                    <p class="text-sm text-slate-500 mt-1">Add/edit values for each segment.</p>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button @onclick="() => SelectTab(0)" class="@TabClass(activeTab == 0)">@(cfg.Segment0Name ?? "Segment 0")</button>
                    @if (cfg.Segment1Active)
                    {
                        <button @onclick="() => SelectTab(1)" class="@TabClass(activeTab == 1)">@cfg.Segment1Name</button>
                    }
                    @if (cfg.Segment2Active)
                    {
                        <button @onclick="() => SelectTab(2)" class="@TabClass(activeTab == 2)">@cfg.Segment2Name</button>
                    }
                    @if (cfg.Segment3Active)
                    {
                        <button @onclick="() => SelectTab(3)" class="@TabClass(activeTab == 3)">@cfg.Segment3Name</button>
                    }
                    @if (cfg.Segment4Active)
                    {
                        <button @onclick="() => SelectTab(4)" class="@TabClass(activeTab == 4)">@cfg.Segment4Name</button>
                    }
                    @if (cfg.Segment5Active)
                    {
                        <button @onclick="() => SelectTab(5)" class="@TabClass(activeTab == 5)">@cfg.Segment5Name</button>
                    }
                </div>
            </div>

            <!-- Form (minimizable) -->
            @if (showValueForm)
            {
                <div class="p-6 border-b border-slate-100">
                    <EditForm Model="editModel" OnValidSubmit="SaveSegmentRow">
                        <DataAnnotationsValidator />

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="space-y-1.5">
                                <label class="label">Code</label>
                                <InputText @bind-Value="editModel.Code" class="@InputClass" placeholder="e.g. 1000" />
                            </div>

                            <div class="space-y-1.5 md:col-span-2">
                                <label class="label">Description</label>
                                <InputText @bind-Value="editModel.Description" class="@InputClass" placeholder="e.g. Lagos Branch" />
                            </div>
                        </div>

                        <div class="mt-5 flex justify-end gap-3">
                            <button type="button" @onclick="CancelValueForm"
                                    class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                                @(editModel.Id == Guid.Empty ? "Save Value" : "Save Changes")
                            </button>
                        </div>
                    </EditForm>
                </div>
            }

            <!-- Table (unchanged) -->
            <div class="overflow-hidden">
                <table class="w-full text-left text-sm text-slate-900">
                    <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="px-6 py-4">Code</th>
                            <th class="px-6 py-4">Description</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var row in CurrentRows())
                        {
                            <tr class="group hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-700">
                                        @row.Code
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-slate-600 font-medium">@row.Description</td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-3">
                                        <button @onclick="() => BeginEdit(row)"
                                                class="text-slate-600 hover:text-slate-900 font-bold hover:underline transition-all">
                                            Edit
                                        </button>

                                        <button @onclick="() => DeleteRow(row.Id)"
                                                class="text-slate-400 hover:text-red-600 transition-colors p-1">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!CurrentRows().Any())
                        {
                            <tr>
                                <td colspan="3" class="px-6 py-12 text-center text-slate-400">
                                    No values yet for this segment.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.025em;
    }
</style>

@code {
    private const string InputClass =
        "block w-full rounded-xl border border-slate-200 bg-white py-2.5 px-3 text-sm text-slate-900 shadow-sm " +
        "focus:border-slate-800 focus:ring-2 focus:ring-slate-200 transition-all placeholder:text-slate-400";

    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;

    private SegCoaConfig cfg = new();
    private SegCoaConfig cfgSnapshot = new(); // for cancel

    private int activeTab = 0;

    private bool showConfig = false;    // minimized on load
    private bool showValueForm = false; // minimized on load

    private SegmentEditVm editModel = new();

    private List<Segment0> seg0 = new();
    private List<Segment1> seg1 = new();
    private List<Segment2> seg2 = new();
    private List<Segment3> seg3 = new();
    private List<Segment4> seg4 = new();
    private List<Segment5> seg5 = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                cfg = await Service.GetOrCreateConfigAsync(selectedCompanyId);
                cfgSnapshot = CloneCfg(cfg);

                await LoadAllSegments();
            }
        }

        isLoading = false;
    }

    private async Task LoadAllSegments()
    {
        seg0 = await Service.GetSegmentsAsync<Segment0>(selectedCompanyId);
        seg1 = await Service.GetSegmentsAsync<Segment1>(selectedCompanyId);
        seg2 = await Service.GetSegmentsAsync<Segment2>(selectedCompanyId);
        seg3 = await Service.GetSegmentsAsync<Segment3>(selectedCompanyId);
        seg4 = await Service.GetSegmentsAsync<Segment4>(selectedCompanyId);
        seg5 = await Service.GetSegmentsAsync<Segment5>(selectedCompanyId);
    }

    // -----------------------------
    // toggles
    // -----------------------------
    private void ToggleConfig()
    {
        showConfig = !showConfig;
        if (showConfig)
            cfgSnapshot = CloneCfg(cfg);
    }

    private void ToggleAddValue()
    {
        showValueForm = true;
        CancelEdit(); // open clean form
    }

    private void CancelConfig()
    {
        cfg = CloneCfg(cfgSnapshot);
        showConfig = false;
    }

    private void CancelValueForm()
    {
        CancelEdit();
        showValueForm = false;
    }

    private static SegCoaConfig CloneCfg(SegCoaConfig c) => new()
    {
        Id = c.Id,
        CompanyId = c.CompanyId,
        Segment0Name = c.Segment0Name,
        Segment1Name = c.Segment1Name,
        Segment2Name = c.Segment2Name,
        Segment3Name = c.Segment3Name,
        Segment4Name = c.Segment4Name,
        Segment5Name = c.Segment5Name,
        Segment1Active = c.Segment1Active,
        Segment2Active = c.Segment2Active,
        Segment3Active = c.Segment3Active,
        Segment4Active = c.Segment4Active,
        Segment5Active = c.Segment5Active
    };

    // -----------------------------
    // config UI pieces
    // -----------------------------
    private RenderFragment ConfigRow(string label, string name, Action<string> setName, bool active, Action<bool> setActive) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "rounded-xl border border-slate-200 p-4 bg-white");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex items-center justify-between gap-3");

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex-1 space-y-1.5");

        builder.OpenElement(seq++, "label");
        builder.AddAttribute(seq++, "class", "label");
        builder.AddContent(seq++, label);
        builder.CloseElement();

        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "class", InputClass);
        builder.AddAttribute(seq++, "value", name);
        builder.AddAttribute(seq++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, e => setName(e.Value?.ToString() ?? "")));
        builder.CloseElement();

        builder.CloseElement(); // left

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "flex items-center gap-2");

        builder.OpenElement(seq++, "input");
        builder.AddAttribute(seq++, "type", "checkbox");
        builder.AddAttribute(seq++, "checked", active);
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => setActive((bool)e.Value!)));
        builder.CloseElement();

        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "class", "text-sm font-bold text-slate-700");
        builder.AddContent(seq++, "Active");
        builder.CloseElement();

        builder.CloseElement(); // right

        builder.CloseElement(); // row
        builder.CloseElement(); // container
    };

    private string TabClass(bool isActive) =>
        isActive
            ? "rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white"
            : "rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50";

    private void SelectTab(int tab)
    {
        if (tab == 1 && !cfg.Segment1Active) return;
        if (tab == 2 && !cfg.Segment2Active) return;
        if (tab == 3 && !cfg.Segment3Active) return;
        if (tab == 4 && !cfg.Segment4Active) return;
        if (tab == 5 && !cfg.Segment5Active) return;

        activeTab = tab;
        CancelEdit();
        // don't auto-open form; user must click "Add Value"
    }

    private async Task SaveConfig()
    {
        cfg.CompanyId = selectedCompanyId;

        var err = await Service.SaveConfigAsync(cfg);
        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        // if current tab became inactive, reset to segment0
        if (activeTab == 1 && !cfg.Segment1Active) activeTab = 0;
        if (activeTab == 2 && !cfg.Segment2Active) activeTab = 0;
        if (activeTab == 3 && !cfg.Segment3Active) activeTab = 0;
        if (activeTab == 4 && !cfg.Segment4Active) activeTab = 0;
        if (activeTab == 5 && !cfg.Segment5Active) activeTab = 0;

        cfgSnapshot = CloneCfg(cfg);
        showConfig = false; // collapse after save
    }

    // -----------------------------
    // segment form (add/edit/delete)
    // -----------------------------
    private sealed class SegmentEditVm
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private IEnumerable<(Guid Id, string Code, string Description)> CurrentRows()
    {
        return activeTab switch
        {
            0 => seg0.Select(x => (x.Id, x.Code, x.Description)),
            1 => seg1.Select(x => (x.Id, x.Code, x.Description)),
            2 => seg2.Select(x => (x.Id, x.Code, x.Description)),
            3 => seg3.Select(x => (x.Id, x.Code, x.Description)),
            4 => seg4.Select(x => (x.Id, x.Code, x.Description)),
            5 => seg5.Select(x => (x.Id, x.Code, x.Description)),
            _ => Enumerable.Empty<(Guid, string, string)>()
        };
    }

    private void BeginEdit((Guid Id, string Code, string Description) row)
    {
        editModel = new SegmentEditVm { Id = row.Id, Code = row.Code, Description = row.Description };
        showValueForm = true; // open form when editing from table
    }

    private void CancelEdit() => editModel = new SegmentEditVm();

    private async Task SaveSegmentRow()
    {
        string? err = activeTab switch
        {
            0 => await Service.SaveSegmentAsync(new Segment0 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description }),
            1 => await Service.SaveSegmentAsync(new Segment1 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description }),
            2 => await Service.SaveSegmentAsync(new Segment2 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description }),
            3 => await Service.SaveSegmentAsync(new Segment3 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description }),
            4 => await Service.SaveSegmentAsync(new Segment4 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description }),
            5 => await Service.SaveSegmentAsync(new Segment5 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description }),
            _ => "Invalid segment."
        };

        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        await LoadAllSegments();
        CancelEdit();
        showValueForm = false; // collapse after save
    }

    private async Task DeleteRow(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this value?")) return;

        string? err = activeTab switch
        {
            0 => await Service.DeleteSegmentAsync<Segment0>(id),
            1 => await Service.DeleteSegmentAsync<Segment1>(id),
            2 => await Service.DeleteSegmentAsync<Segment2>(id),
            3 => await Service.DeleteSegmentAsync<Segment3>(id),
            4 => await Service.DeleteSegmentAsync<Segment4>(id),
            5 => await Service.DeleteSegmentAsync<Segment5>(id),
            _ => "Invalid segment."
        };

        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        await LoadAllSegments();

        // if you deleted the row being edited, clear form
        if (editModel.Id == id) CancelValueForm();
    }
}
