@page "/finance/segments-setup"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO
@using System.Text

@inject SegmentsSetupService Service
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-[1400px] mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Segment Setup</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">
                Name segments, activate segments, and manage their values.
            </p>
        </div>

        <div class="flex flex-wrap gap-2">
            <button @onclick="ToggleConfig"
                    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 transition-all active:scale-95">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a6 6 0 100 12m0-12a6 6 0 010 12m0 0v2m0-2a6 6 0 01-6-6m6 6a6 6 0 006-6" />
                </svg>
                Configure Structure
            </button>

            <button @onclick="ToggleAddValue"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Add Value
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading...
        </div>
    }
    else if (!HasCompany)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-10 text-center text-slate-500">
            No company found for this user.
        </div>
    }
    else
    {
        @if (showConfig)
        {
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm mb-6 animate-in slide-in-from-top-2">
                <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Segment Configuration</h3>
                        <p class="text-sm text-slate-500 mt-1">Define which segments are active for your Chart of Accounts.</p>
                    </div>
                    <div class="flex gap-2">
                        <button @onclick="CancelConfig" class="rounded-xl px-4 py-2 text-sm font-bold text-slate-500 hover:bg-slate-100 transition-colors">Cancel</button>
                        <button @onclick="SaveConfig" class="rounded-xl bg-indigo-600 px-4 py-2 text-sm font-bold text-white hover:bg-indigo-700 transition-colors shadow-sm">Save Config</button>
                    </div>
                </div>

                <div class="p-6">
                    <div class="mb-6 p-4 bg-slate-50 rounded-xl border border-slate-100 max-w-xl">
                        <label class="label text-indigo-700">Segment 0 Name (Primary / Required)</label>
                        <InputText @bind-Value="cfg.Segment0Name" class="@InputClass" />
                        <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mt-2">This is the main natural account segment.</div>
                    </div>

                    <div class="text-xs font-black text-slate-500 uppercase tracking-widest border-b border-slate-100 pb-2 mb-4">Optional Segments</div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                        @ConfigRow("Segment 1", cfg.Segment1Name, v => cfg.Segment1Name = v, cfg.Segment1Active, v => cfg.Segment1Active = v)
                        @ConfigRow("Segment 2", cfg.Segment2Name, v => cfg.Segment2Name = v, cfg.Segment2Active, v => cfg.Segment2Active = v)
                        @ConfigRow("Segment 3", cfg.Segment3Name, v => cfg.Segment3Name = v, cfg.Segment3Active, v => cfg.Segment3Active = v)
                        @ConfigRow("Segment 4", cfg.Segment4Name, v => cfg.Segment4Name = v, cfg.Segment4Active, v => cfg.Segment4Active = v)
                        @ConfigRow("Segment 5", cfg.Segment5Name, v => cfg.Segment5Name = v, cfg.Segment5Active, v => cfg.Segment5Active = v)
                    </div>
                </div>
            </div>
        }

        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm flex flex-col min-h-[500px]">

            <div class="p-4 border-b border-slate-100 bg-slate-50/30">
                <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">@GetCurrentSegmentName() Values</h3>
                        <div class="text-xs text-slate-500 mt-1 flex items-center gap-1">
                            <span>Manages values for: </span>
                            <span class="font-mono font-bold bg-slate-100 px-1 rounded border border-slate-200">@GetCurrentSegmentName()</span>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-2">
                        <button @onclick="() => SelectTab(0)" class="@TabClass(activeTab == 0)">@(string.IsNullOrWhiteSpace(cfg.Segment0Name) ? "Seg 0" : cfg.Segment0Name)</button>
                        @if (cfg.Segment1Active)
                        {
                            <button @onclick="() => SelectTab(1)" class="@TabClass(activeTab == 1)">@cfg.Segment1Name</button>
                        }
                        @if (cfg.Segment2Active)
                        {
                            <button @onclick="() => SelectTab(2)" class="@TabClass(activeTab == 2)">@cfg.Segment2Name</button>
                        }
                        @if (cfg.Segment3Active)
                        {
                            <button @onclick="() => SelectTab(3)" class="@TabClass(activeTab == 3)">@cfg.Segment3Name</button>
                        }
                        @if (cfg.Segment4Active)
                        {
                            <button @onclick="() => SelectTab(4)" class="@TabClass(activeTab == 4)">@cfg.Segment4Name</button>
                        }
                        @if (cfg.Segment5Active)
                        {
                            <button @onclick="() => SelectTab(5)" class="@TabClass(activeTab == 5)">@cfg.Segment5Name</button>
                        }
                    </div>
                </div>
            </div>

            <!-- SEARCH AND DATA ACTIONS BAR -->
            <div class="p-4 border-b border-slate-200 bg-slate-50 flex flex-col md:flex-row gap-4 items-center justify-between">
                <div class="relative w-full max-w-md">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <input @bind="GlobalSearchTerm" @bind:event="oninput" type="text" placeholder="Search by code or description..." 
                           class="w-full pl-9 pr-4 py-2 text-sm rounded-xl border border-slate-300 bg-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all shadow-sm" />
                </div>

                <div class="flex items-center gap-2">
                    <label for="csvImport" class="cursor-pointer inline-flex items-center gap-2 text-xs font-bold text-indigo-700 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-4 py-2 rounded-lg transition-colors border border-indigo-200 shadow-sm active:scale-95">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                        </svg>
                        Import
                    </label>
                    <InputFile id="csvImport" OnChange="HandleFileImport" class="hidden" accept=".csv, .xlsx, .xls" />
                    <button @onclick="ExportToExcel" class="inline-flex items-center gap-2 text-xs font-bold text-emerald-700 hover:text-emerald-900 bg-emerald-50 hover:bg-emerald-100 px-4 py-2 rounded-lg transition-colors border border-emerald-200 shadow-sm active:scale-95">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        Export
                    </button>
                </div>
            </div>

            @if (isImporting)
            {
                <div class="p-4 bg-indigo-50 border-b border-indigo-100 flex items-center justify-center gap-3">
                    <div class="h-4 w-4 rounded-full border-2 border-indigo-200 border-t-indigo-600 animate-spin"></div>
                    <span class="text-sm font-bold text-indigo-700">Importing data into @GetCurrentSegmentName()...</span>
                </div>
            }

            @if (showValueForm)
            {
                <div class="p-6 border-b border-slate-100 bg-slate-50 animate-in slide-in-from-top-2">
                    <EditForm Model="editModel" OnValidSubmit="SaveSegmentRow">
                        <DataAnnotationsValidator />
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
                            <div class="md:col-span-3 space-y-1.5">
                                <label class="label">Code</label>
                                <InputText @bind-Value="editModel.Code" class="@($"{InputClass} font-mono")" placeholder="e.g. 1000" />
                            </div>
                            <div class="md:col-span-6 space-y-1.5">
                                <label class="label">Description</label>
                                <InputText @bind-Value="editModel.Description" class="@InputClass" placeholder="e.g. Assets" />
                            </div>
                            <div class="md:col-span-3 flex gap-2">
                                <button type="button" @onclick="CancelValueForm" class="flex-1 rounded-xl px-4 py-2.5 text-sm font-bold text-slate-500 hover:bg-slate-200 transition-colors">Cancel</button>
                                <button type="submit" class="flex-1 rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-colors">
                                    @(editModel.Id == Guid.Empty ? "Add" : "Update")
                                </button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            }

            <div class="flex-1 overflow-auto">
                <table class="w-full text-left text-sm text-slate-900">
                    <thead class="bg-white text-[10px] uppercase tracking-wider font-extrabold text-slate-500 border-b border-slate-200 sticky top-0 z-10">
                        <tr>
                            <th class="px-6 py-4 w-32 bg-slate-50/50">Code</th>
                            <th class="px-6 py-4 bg-slate-50/50">Description</th>
                            <th class="px-6 py-4 text-right bg-slate-50/50">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var row in GetPagedRows())
                        {
                            <tr class="group hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-3">
                                    <span class="inline-flex items-center rounded border border-slate-200 bg-white px-2.5 py-1 text-xs font-mono font-bold text-slate-700 shadow-sm">@row.Code</span>
                                </td>
                                <td class="px-6 py-3 font-bold text-slate-700">@row.Description</td>
                                <td class="px-6 py-3 text-right">
                                    <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <button @onclick="() => BeginEdit(row)" class="text-indigo-600 font-bold hover:underline text-xs">Edit</button>
                                        <button @onclick="() => DeleteRow(row.Id)" class="text-rose-600 font-bold hover:underline text-xs">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!GetPagedRows().Any())
                        {
                            <tr>
                                <td colspan="3" class="px-6 py-16 text-center text-slate-400">
                                    <div class="flex flex-col items-center">
                                        <svg class="w-12 h-12 mb-3 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
                                        <p class="font-bold">No values found.</p>
                                        <p class="text-xs mt-1">Add manually or Import CSV.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (FilteredRows.Any())
            {
                <div class="p-3 border-t border-slate-200 bg-slate-50 text-xs flex items-center justify-between rounded-b-2xl">
                    <div class="text-slate-500">
                        Showing <strong>@(((currentPage - 1) * pageSize) + 1)</strong> to <strong>@(Math.Min(currentPage * pageSize, FilteredRows.Count()))</strong> of <strong>@FilteredRows.Count()</strong> entries
                    </div>

                    <div class="flex items-center gap-2">
                        <button @onclick="PrevPage" disabled="@(currentPage == 1)" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white font-bold disabled:opacity-50 hover:bg-slate-100 text-slate-600 transition-colors">
                            Prev
                        </button>
                        <span class="font-bold text-slate-700 px-2">Page @currentPage of @TotalPages</span>
                        <button @onclick="NextPage" disabled="@(currentPage >= TotalPages)" class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white font-bold disabled:opacity-50 hover:bg-slate-100 text-slate-600 transition-colors">
                            Next
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        display: block;
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        background-color: #fff;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        color: #0f172a;
        transition: all 0.2s;
        outline: none;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private const string InputClass = "block w-full rounded-xl border border-slate-200 bg-white py-2 px-3 text-sm font-bold text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all outline-none";

    // State
    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private bool isImporting = false;

    // --- Search & Pagination Updates ---
    private string _globalSearchTerm = "";
    private string GlobalSearchTerm
    {
        get => _globalSearchTerm;
        set
        {
            if (_globalSearchTerm != value)
            {
                _globalSearchTerm = value;
                currentPage = 1; // Reset to page 1 on search
            }
        }
    }

    private IEnumerable<(Guid Id, string Code, string Description)> FilteredRows =>
        string.IsNullOrWhiteSpace(GlobalSearchTerm)
        ? GetAllRowsForTab()
        : GetAllRowsForTab().Where(r => 
            (r.Code != null && r.Code.Contains(GlobalSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
            (r.Description != null && r.Description.Contains(GlobalSearchTerm, StringComparison.OrdinalIgnoreCase)));

    private int currentPage = 1;
    private int pageSize = 15;
    private int TotalPages => (int)Math.Ceiling(FilteredRows.Count() / (double)pageSize);

    // Config & Data
    private SegCoaConfig cfg = new();
    private SegCoaConfig cfgSnapshot = new();
    private int activeTab = 0;

    // UI State
    private bool showConfig = false;
    private bool showValueForm = false;
    private SegmentEditVm editModel = new();

    // Data Containers
    private List<Segment0> seg0 = new();
    private List<Segment1> seg1 = new();
    private List<Segment2> seg2 = new();
    private List<Segment3> seg3 = new();
    private List<Segment4> seg4 = new();
    private List<Segment5> seg5 = new();

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("GL_SEGMENT_SETUP_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            selectedCompanyId = user.CompanyDetailsId.Value;
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            if (company != null) companyName = company.CompanyName;

            cfg = await Service.GetOrCreateConfigAsync(selectedCompanyId);
            cfgSnapshot = CloneCfg(cfg);
            await LoadAllSegments();
        }
        isLoading = false;
    }

    private async Task LoadAllSegments()
    {
        seg0 = await Service.GetSegmentsAsync<Segment0>(selectedCompanyId);
        seg1 = await Service.GetSegmentsAsync<Segment1>(selectedCompanyId);
        seg2 = await Service.GetSegmentsAsync<Segment2>(selectedCompanyId);
        seg3 = await Service.GetSegmentsAsync<Segment3>(selectedCompanyId);
        seg4 = await Service.GetSegmentsAsync<Segment4>(selectedCompanyId);
        seg5 = await Service.GetSegmentsAsync<Segment5>(selectedCompanyId);
    }

    // --- CSV/Excel IMPORT LOGIC ---
    private async Task HandleFileImport(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;

        isImporting = true;
        string resultMsg = "";

        try
        {
            using var stream = e.File.OpenReadStream(5 * 1024 * 1024);

            resultMsg = activeTab switch
            {
                0 => await Service.ImportSegmentValuesAsync<Segment0>(selectedCompanyId, stream, e.File.Name),
                1 => await Service.ImportSegmentValuesAsync<Segment1>(selectedCompanyId, stream, e.File.Name),
                2 => await Service.ImportSegmentValuesAsync<Segment2>(selectedCompanyId, stream, e.File.Name),
                3 => await Service.ImportSegmentValuesAsync<Segment3>(selectedCompanyId, stream, e.File.Name),
                4 => await Service.ImportSegmentValuesAsync<Segment4>(selectedCompanyId, stream, e.File.Name),
                5 => await Service.ImportSegmentValuesAsync<Segment5>(selectedCompanyId, stream, e.File.Name),
                _ => "Error: Invalid Segment selected."
            };

            await LoadAllSegments();
            await JS.InvokeVoidAsync("alert", resultMsg);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Import Failed: " + ex.Message);
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task ExportToExcel()
    {
        var rows = FilteredRows.ToList(); // Export what is currently filtered
        if (!rows.Any())
        {
            await JS.InvokeVoidAsync("alert", "No data to export.");
            return;
        }

        var sb = new StringBuilder();
        sb.AppendLine("Code,Description"); 

        foreach (var row in rows)
        {
            string code = $"\"{row.Code.Replace("\"", "\"\"")}\"";
            string desc = $"\"{row.Description.Replace("\"", "\"\"")}\"";
            sb.AppendLine($"{code},{desc}");
        }

        var fileName = $"{GetCurrentSegmentName().Replace(" ", "_")}_Export_{DateTime.Now:yyyyMMdd}.csv";
        var fileContent = sb.ToString();
        var bytes = Encoding.UTF8.GetBytes(fileContent);

        using var streamRef = new DotNetStreamReference(stream: new MemoryStream(bytes));
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    private IEnumerable<(Guid Id, string Code, string Description)> GetAllRowsForTab()
    {
        return activeTab switch
        {
            0 => seg0.Select(x => (x.Id, x.Code, x.Description)),
            1 => seg1.Select(x => (x.Id, x.Code, x.Description)),
            2 => seg2.Select(x => (x.Id, x.Code, x.Description)),
            3 => seg3.Select(x => (x.Id, x.Code, x.Description)),
            4 => seg4.Select(x => (x.Id, x.Code, x.Description)),
            5 => seg5.Select(x => (x.Id, x.Code, x.Description)),
            _ => Enumerable.Empty<(Guid, string, string)>()
        };
    }

    private IEnumerable<(Guid Id, string Code, string Description)> GetPagedRows()
    {
        return FilteredRows.Skip((currentPage - 1) * pageSize).Take(pageSize);
    }

    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PrevPage() { if (currentPage > 1) currentPage--; }

    private string GetCurrentSegmentName() => activeTab switch { 0 => cfg.Segment0Name ?? "Segment 0", 1 => cfg.Segment1Name, 2 => cfg.Segment2Name, 3 => cfg.Segment3Name, 4 => cfg.Segment4Name, 5 => cfg.Segment5Name, _ => "" };

    private string TabClass(bool isActive) => isActive
        ? "rounded-xl bg-slate-900 px-5 py-2.5 text-xs font-bold text-white shadow-md transition-all scale-105"
        : "rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 transition-all";

    private void SelectTab(int tab)
    {
        if (tab == 1 && !cfg.Segment1Active) return;
        if (tab == 2 && !cfg.Segment2Active) return;
        if (tab == 3 && !cfg.Segment3Active) return;
        if (tab == 4 && !cfg.Segment4Active) return;
        if (tab == 5 && !cfg.Segment5Active) return;

        activeTab = tab;
        currentPage = 1; 
        CancelEdit();
    }

    private void ToggleConfig() { showConfig = !showConfig; if (showConfig) cfgSnapshot = CloneCfg(cfg); }
    private void CancelConfig() { cfg = CloneCfg(cfgSnapshot); showConfig = false; }

    private async Task SaveConfig()
    {
        cfg.CompanyId = selectedCompanyId;
        var err = await Service.SaveConfigAsync(cfg);
        if (!string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", err);
        else { cfgSnapshot = CloneCfg(cfg); showConfig = false; }
    }

    private void ToggleAddValue() { showValueForm = true; CancelEdit(); }
    private void CancelValueForm() { CancelEdit(); showValueForm = false; }

    private void BeginEdit((Guid Id, string Code, string Description) row)
    {
        editModel = new SegmentEditVm { Id = row.Id, Code = row.Code, Description = row.Description };
        showValueForm = true;
    }

    private void CancelEdit() => editModel = new SegmentEditVm();

    private async Task SaveSegmentRow()
    {
        string? err = "";

        switch (activeTab)
        {
            case 0:
                err = await Service.SaveSegmentAsync(new Segment0 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description });
                break;
            case 1:
                err = await Service.SaveSegmentAsync(new Segment1 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description });
                break;
            case 2:
                err = await Service.SaveSegmentAsync(new Segment2 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description });
                break;
            case 3:
                err = await Service.SaveSegmentAsync(new Segment3 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description });
                break;
            case 4:
                err = await Service.SaveSegmentAsync(new Segment4 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description });
                break;
            case 5:
                err = await Service.SaveSegmentAsync(new Segment5 { Id = editModel.Id, CompanyId = selectedCompanyId, Code = editModel.Code, Description = editModel.Description });
                break;
            default:
                err = "Invalid segment selected.";
                break;
        }

        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
        }
        else
        {
            await LoadAllSegments();
            CancelValueForm();
        }
    }

    private async Task DeleteRow(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this segment value?")) return;
        
        string? err = activeTab switch
        {
            0 => await Service.DeleteSegmentAsync<Segment0>(id),
            1 => await Service.DeleteSegmentAsync<Segment1>(id),
            2 => await Service.DeleteSegmentAsync<Segment2>(id),
            3 => await Service.DeleteSegmentAsync<Segment3>(id),
            4 => await Service.DeleteSegmentAsync<Segment4>(id),
            5 => await Service.DeleteSegmentAsync<Segment5>(id),
            _ => "Invalid"
        };
        
        if (!string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", err);
        else await LoadAllSegments();
    }

