@page "/md/customers"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Text

@inject MasterDataService MasterService
@inject IDocumentNumberingService NumberingService
@inject SegCoaService SegCoaService
@inject CurrencyService CurrencyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 mt-6">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Customers</h1>
            <p class="text-sm text-slate-500">Manage client profiles, currencies, and GL mapping.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <PermissionGate Key="CUSTOMER_GROUP_MANAGE">
                <Authorized>
                    <button @onclick="ExportCsv" class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 text-sm">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        Export CSV
                    </button>

                    <label class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 cursor-pointer mb-0 text-sm">
                        @if (isImporting)
                        {
                            <span class="animate-spin">↻</span>
                            <span>Importing...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                            <span>Import CSV</span>
                        }
                        <InputFile OnChange="ImportCsv" accept=".csv" class="hidden" disabled="@isImporting" />
                    </label>

                    <button @onclick="CreateNew" class="px-5 py-2 bg-indigo-600 text-white rounded-lg font-bold hover:bg-indigo-700 shadow-sm transition-all active:scale-95 text-sm">
                        + New Customer
                    </button>
                </Authorized>
            </PermissionGate>
        </div>
    </div>

    @if (isEditing)
    {
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-xl mb-6 animate-in slide-in-from-top-4">
            <h3 class="text-lg font-bold text-slate-800 mb-6">@(currentCustomer.Id == Guid.Empty ? "Create Customer" : "Edit Customer")</h3>

            <EditForm Model="currentCustomer" OnValidSubmit="Save">
                <DataAnnotationsValidator />

                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 border-b border-slate-100 pb-1">Profile Details</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <label class="label">Customer Code <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentCustomer.Code" readonly="@IsCustomerCodeReadOnly" class="@(IsCustomerCodeReadOnly ? "input-class bg-slate-100 text-slate-600" : "input-class")" placeholder="Enter customer code" />
                        <ValidationMessage For="@(() => currentCustomer.Code)" class="mt-1 block text-xs font-semibold text-rose-600" />
                        <p class="mt-1 text-xs text-slate-500">@CustomerCodeHint</p>
                        @if (!string.IsNullOrWhiteSpace(customerCodeError))
                        {
                            <p role="alert" class="mt-1 text-xs font-semibold text-rose-600">@customerCodeError</p>
                        }
                    </div>
                    <div>
                        <label class="label">Customer Name <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentCustomer.Name" class="input-class" placeholder="Company or Person Name" />
                    </div>

                    <div>
                        <label class="label">Customer Group <span class="text-rose-500">*</span></label>
                        <select @onchange="OnGroupChanged" value="@(currentCustomer.CustomerGroupId == Guid.Empty ? "" : currentCustomer.CustomerGroupId.ToString())" class="input-class bg-slate-50 border-slate-300">
                            <option value="">-- Select Group --</option>
                            @foreach (var g in groups)
                            {
                                <option value="@g.Id">@g.Name</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="label">Email</label>
                        <InputText @bind-Value="currentCustomer.Email" class="input-class" />
                    </div>
                    <div>
                        <label class="label">Phone</label>
                        <InputText @bind-Value="currentCustomer.Phone" class="input-class" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="label">Address</label>
                        <InputTextArea @bind-Value="currentCustomer.Address" class="input-class h-24 resize-none" />
                    </div>
                </div>

                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 border-b border-slate-100 pb-1 mt-8">Accounting Setup</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 bg-slate-50 p-4 rounded-xl border border-slate-200">

                    <div>
                        <label class="label">Trading Currency <span class="text-rose-500">*</span></label>
                        <select @bind="currentCustomer.CurrencyId" class="input-class bg-white">
                            <option value="@Guid.Empty">-- Select Currency --</option>
                            @foreach (var c in availableCurrencies)
                            {
                                <option value="@c.Id">@c.CurrencyCode - @c.CurrencyName</option>
                            }
                        </select>
                        <p class="text-xs text-slate-400 mt-1">Default currency for Sales Orders and Invoices.</p>
                    </div>

                    <div>
                        <SearchableGlAccount Label="Accounts Receivable GL Account (Asset)"
                                             Placeholder="Search A/R accounts..."
                                             Accounts="@arAccounts"
                                             @bind-Value="ReceivablesAccountIdWrapper"
                                             IsInvalid="@(ReceivablesAccountIdWrapper == Guid.Empty)" />

                        <p class="text-[10px] text-rose-500 font-bold mt-1 tracking-wide uppercase">Required for Invoicing.</p>
                    </div>

                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" @onclick="CancelEdit" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 font-bold transition-colors">Cancel</button>
                    <button type="submit" class="px-6 py-2.5 bg-emerald-600 text-white rounded-xl font-bold hover:bg-emerald-700 shadow-md transition-all active:scale-95">Save Profile</button>
                </div>
            </EditForm>
        </div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 border-b border-slate-100 bg-slate-50/50">
                <div class="relative w-full sm:max-w-md">

                    <input type="text" @bind="customerSearch" @bind:event="oninput" class="input-class bg-white pl-10 pr-10" placeholder="Search customers by name, email, phone, or group..." />
                    @if (!string.IsNullOrWhiteSpace(customerSearch))
                    {
                        <button type="button" @onclick="() => customerSearch = string.Empty" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700" aria-label="Clear customer search">&times;</button>
                    }
                </div>
                <div class="text-xs font-bold uppercase tracking-wider text-slate-400">@FilteredCustomers.Count() of @customers.Count customers</div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600 whitespace-nowrap min-w-[900px]">
                    <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="px-6 py-4">Code</th>
                            <th class="px-6 py-4">Name</th>
                            <th class="px-6 py-4">Group</th>
                            <th class="px-6 py-4">Contact</th>
                            <th class="px-6 py-4 text-center">Currency</th>
                            <th class="px-6 py-4">A/R Setup</th>
                            <th class="px-6 py-4 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var c in FilteredCustomers)
                        {
                            var arAccount = arAccounts.FirstOrDefault(a => a.Id == c.ReceivablesAccountId);
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4 font-mono font-semibold text-slate-700">@(string.IsNullOrWhiteSpace(c.Code) ? "—" : c.Code)</td>
                                <td class="px-6 py-4 font-bold text-slate-900">@c.Name</td>
                                <td class="px-6 py-4">
                                    @if (c.Group != null)
                                    {
                                        <span class="px-2.5 py-1 bg-indigo-50 text-indigo-700 rounded-md text-[10px] uppercase tracking-wider font-bold border border-indigo-100">@c.Group.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 text-xs">-</span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="font-medium">@c.Email</span>
                                        <span class="text-[10px] font-mono text-slate-400 mt-0.5">@c.Phone</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="px-2 py-1 bg-slate-100 border border-slate-200 rounded text-[10px] font-bold text-slate-700 font-mono tracking-wider">
                                        @c.DefaultCurrency?.CurrencyCode
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    @if (c.ReceivablesAccountId.HasValue && c.ReceivablesAccountId != Guid.Empty)
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200 uppercase tracking-wider">
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                                            Configured
                                        </span>
                                        @if (arAccount != null)
                                        {
                                            <div class="text-[10px] font-mono text-slate-400 mt-1">@arAccount.AccountCode</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-600 bg-rose-50 px-2.5 py-1 rounded-md border border-rose-200 uppercase tracking-wider">
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                            Missing
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-4">
                                        <PermissionGate Key="CUSTOMER_GROUP_MANAGE">
                                            <Authorized>
                                                <button @onclick="() => Edit(c)" class="text-indigo-600 font-bold hover:text-indigo-900 hover:underline transition-colors text-xs uppercase tracking-wide">
                                                    Edit
                                                </button>
                                            </Authorized>
                                        </PermissionGate>

                                        <PermissionGate Key="CUSTOMER_GROUP_MANAGE">
                                            <Authorized>
                                                <button @onclick="() => DeleteCustomer(c)" class="text-rose-600 font-bold hover:text-rose-900 hover:underline transition-colors text-xs uppercase tracking-wide">
                                                    Delete
                                                </button>
                                            </Authorized>
                                        </PermissionGate>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!customers.Any())
                        {
                            <tr><td colspan="6" class="p-16 text-center text-slate-400 italic">No customers found. Click "+ New Customer" to start.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        transition: border-color 0.2s;
        outline: none;
        background: #fff;
        color: #0f172a;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private List<Customer> customers = new();
    private List<Currency> availableCurrencies = new();
    private List<CustomerGroup> groups = new();

    // Segmented COA
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> arAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private Customer currentCustomer = new();
    private bool isEditing = false;
    private bool isImporting = false;
    private Guid selectedCompanyId;
    private string customerSearch = string.Empty;
    private string? customerCodeError;
    private Guid? pendingCustomerCodeSequenceId;

    private IEnumerable<Customer> FilteredCustomers => customers
        .Where(c => string.IsNullOrWhiteSpace(customerSearch)
                 || c.Name.Contains(customerSearch, StringComparison.OrdinalIgnoreCase)
                 || (c.Email?.Contains(customerSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                 || (c.Phone?.Contains(customerSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                 || (c.Group?.Name.Contains(customerSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                 || (c.DefaultCurrency?.CurrencyCode.Contains(customerSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    private Guid ReceivablesAccountIdWrapper
    {
        get => currentCustomer.ReceivablesAccountId ?? Guid.Empty;
        set => currentCustomer.ReceivablesAccountId = value == Guid.Empty ? null : value;
    }

    private CustomerGroup? SelectedCustomerGroup => groups.FirstOrDefault(x => x.Id == currentCustomer.CustomerGroupId);
    private bool IsCustomerCodeReadOnly => SelectedCustomerGroup?.SequenceDefinitionId.HasValue == true;
    private string CustomerCodeHint => IsCustomerCodeReadOnly
        ? "Generated by the customer group sequence; this code is read-only."
        : "Enter a unique code. Codes are generated only when the selected group has an assigned sequence.";

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("MD_CUSTOMER_GROUPS_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user?.CompanyDetailsId != null)
        {
            selectedCompanyId = user.CompanyDetailsId.Value;

            availableCurrencies = await CurrencyService.GetCurrenciesAsync(selectedCompanyId);
            groups = await MasterService.GetCustomerGroupsAsync(selectedCompanyId);

            await LoadGlAccounts();
            await LoadCustomers(); // Load customers after GL so mappings display properly
        }
    }

    private async Task LoadCustomers() => customers = await MasterService.GetCustomersAsync(selectedCompanyId);

    private async Task LoadGlAccounts()
    {
        accountTypes = await SegCoaService.GetAccountTypesAsync();
        allAccounts = await SegCoaService.GetCoaAsync(selectedCompanyId);
        arAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && type.IsDebit == true && a.IsActive;
        }).OrderBy(a => a.AccountCode).ToList();
    }

    private async Task OnGroupChanged(ChangeEventArgs e)
    {
        customerCodeError = null;
        var previousGroup = groups.FirstOrDefault(x => x.Id == currentCustomer.CustomerGroupId);
        if (Guid.TryParse(e.Value?.ToString(), out var gId) && gId != Guid.Empty)
        {
            var group = groups.FirstOrDefault(x => x.Id == gId);
            if (group is null) return;
            currentCustomer.CustomerGroupId = gId;

            if (group.SequenceDefinitionId is Guid sequenceId
                && (previousGroup?.SequenceDefinitionId != sequenceId || string.IsNullOrWhiteSpace(currentCustomer.Code)))
            {
                pendingCustomerCodeSequenceId = sequenceId;
                try
                {
                    currentCustomer.Code = await NumberingService.PeekNextNumberAsync(
                        sequenceId,
                        exceptEntityId: currentCustomer.Id);
                }
                catch (Exception ex)
                {
                    currentCustomer.Code = string.Empty;
                    customerCodeError = $"Could not generate a customer code from this group's sequence: {ex.Message}";
                }
            }
            else if (group.SequenceDefinitionId is null)
            {
                pendingCustomerCodeSequenceId = null;
            }

            if (group.ReceivablesAccountId != Guid.Empty)
            {
                currentCustomer.ReceivablesAccountId = group.ReceivablesAccountId;
            }
        }
        else
        {
            currentCustomer.CustomerGroupId = Guid.Empty;
            pendingCustomerCodeSequenceId = null;
        }
    }

    private void CreateNew()
    {
        currentCustomer = new Customer { CompanyId = selectedCompanyId };
        customerCodeError = null;
        pendingCustomerCodeSequenceId = null;
        if (availableCurrencies.Any()) currentCustomer.CurrencyId = availableCurrencies.First().Id;
        isEditing = true;
    }

    private void Edit(Customer c)
    {
        currentCustomer = c;
        customerCodeError = null;
        pendingCustomerCodeSequenceId = null;
        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
        customerCodeError = null;
        pendingCustomerCodeSequenceId = null;
    }

    private async Task Save()
    {
        if (!IsCustomerCodeReadOnly) customerCodeError = null;
        if (!string.IsNullOrWhiteSpace(customerCodeError)) return;
        if (!IsCustomerCodeReadOnly)
        {
            if (string.IsNullOrWhiteSpace(currentCustomer.Code))
            {
                customerCodeError = "Enter a customer code.";
                return;
            }
            if (!await NumberingService.IsCodeAvailableAsync(selectedCompanyId, SequenceTargetType.CustomerCode, currentCustomer.Code, currentCustomer.Id))
            {
                customerCodeError = $"Customer Code '{currentCustomer.Code.Trim()}' already exists in this company.";
                return;
            }
        }
        if (currentCustomer.ReceivablesAccountId == null || currentCustomer.ReceivablesAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Accounts Receivable GL Account is required.");
            return;
        }

        var previewedCustomerCode = currentCustomer.Code;
        if (pendingCustomerCodeSequenceId.HasValue)
            currentCustomer.Code = string.Empty; // Let the save service allocate and commit a checked number atomically.

        string err;
        try
        {
            err = await MasterService.SaveCustomerAsync(currentCustomer);
        }
        catch (Exception ex)
        {
            if (pendingCustomerCodeSequenceId.HasValue)
                currentCustomer.Code = previewedCustomerCode;
            customerCodeError = $"Could not save the customer: {ex.Message}";
            return;
        }
        if (string.IsNullOrEmpty(err))
        {
            await LoadCustomers();
            isEditing = false;
            customerCodeError = null;
            pendingCustomerCodeSequenceId = null;
        }
        else
        {
            if (pendingCustomerCodeSequenceId.HasValue)
                currentCustomer.Code = previewedCustomerCode;
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task DeleteCustomer(Customer c)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete customer '{c.Name}'?\n\nThis will fail if they have associated Sales Orders or Invoices.");
        if (!confirm) return;

        try
        {
            var err = await MasterService.DeleteCustomerAsync(c.Id);
            if (string.IsNullOrEmpty(err))
            {
                await LoadCustomers();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error deleting customer: " + ex.Message);
        }
    }

    // --- CSV EXPORT LOGIC ---
    private async Task ExportCsv()
    {
        try
        {
            var sb = new StringBuilder();
            // Headers match our import parsing structure
            sb.AppendLine("Name,Email,Phone,Address,GroupName,CurrencyCode,ArGlAccountCode,Code");

            foreach (var c in customers)
            {
                var groupName = c.Group?.Name ?? "";
                var curCode = c.DefaultCurrency?.CurrencyCode ?? "";
                var glCode = arAccounts.FirstOrDefault(a => a.Id == c.ReceivablesAccountId)?.AccountCode ?? "";

                // Wrap fields in quotes to safely handle commas inside addresses or names
                sb.AppendLine($"\"{c.Name?.Replace("\"", "\"\"")}\",\"{c.Email?.Replace("\"", "\"\"")}\",\"{c.Phone?.Replace("\"", "\"\"")}\",\"{c.Address?.Replace("\"", "\"\"")}\",\"{groupName}\",\"{curCode}\",\"{glCode}\",\"{c.Code?.Replace("\"", "\"\"")}\"");
            }

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(bytes));

            await JS.InvokeVoidAsync("downloadFileFromStream", "Customers_Export.csv", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
    }

    // --- CSV IMPORT LOGIC ---
    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        isImporting = true;
        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                await JS.InvokeVoidAsync("alert", "Please upload a valid .csv file.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var lines = content.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length <= 1)
            {
                await JS.InvokeVoidAsync("alert", "The file appears to be empty or missing data rows.");
                return;
            }

            int successCount = 0;
            var importErrors = new List<string>();

            // Start loop at 1 to skip header row
            for (int i = 1; i < lines.Length; i++)
            {
                var cols = ParseCsvLine(lines[i]);

                if (cols.Count >= 1)
                {
                    var name = cols[0].Trim();
                    if (string.IsNullOrWhiteSpace(name)) continue;

                    var customer = customers.FirstOrDefault(c => c.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
                                   ?? new Customer { CompanyId = selectedCompanyId, Name = name };

                    if (cols.Count > 1) customer.Email = cols[1].Trim();
                    if (cols.Count > 2) customer.Phone = cols[2].Trim();
                    if (cols.Count > 3) customer.Address = cols[3].Trim();

                    // Map Customer Group
                    if (cols.Count > 4 && !string.IsNullOrWhiteSpace(cols[4]))
                    {
                        var group = groups.FirstOrDefault(g => g.Name.Equals(cols[4].Trim(), StringComparison.OrdinalIgnoreCase));
                        if (group != null) customer.CustomerGroupId = group.Id;
                    }
                    if (customer.CustomerGroupId == Guid.Empty && groups.Any()) customer.CustomerGroupId = groups[0].Id;

                    // Map Currency (Required, defaults to first available if invalid)
                    if (cols.Count > 5 && !string.IsNullOrWhiteSpace(cols[5]))
                    {
                        var cur = availableCurrencies.FirstOrDefault(c => c.CurrencyCode.Equals(cols[5].Trim(), StringComparison.OrdinalIgnoreCase));
                        if (cur != null) customer.CurrencyId = cur.Id;
                    }
                    if (customer.CurrencyId == Guid.Empty && availableCurrencies.Any())
                    {
                        customer.CurrencyId = availableCurrencies.First().Id;
                    }

                    // Map AR GL Account (Required)
                    if (cols.Count > 6 && !string.IsNullOrWhiteSpace(cols[6]))
                    {
                        var gl = arAccounts.FirstOrDefault(a => a.AccountCode == cols[6].Trim());
                        if (gl != null) customer.ReceivablesAccountId = gl.Id;
                    }
                    if (cols.Count > 7) customer.Code = cols[7].Trim();

                    // Only save if the mandatory AR account is successfully mapped
                    if (customer.ReceivablesAccountId.HasValue && customer.ReceivablesAccountId != Guid.Empty)
                    {
                        var error = await MasterService.SaveCustomerAsync(customer);
                        if (string.IsNullOrWhiteSpace(error)) successCount++;
                        else importErrors.Add($"{name}: {error}");
                    }
                    else importErrors.Add($"{name}: A valid A/R GL account is required.");
                }
            }

            await LoadCustomers();
            var importSummary = $"Import complete. {successCount} customers processed successfully.";
            if (importErrors.Count > 0)
                importSummary += $" {importErrors.Count} row(s) were skipped. First issue: {importErrors[0]}";
            await JS.InvokeVoidAsync("alert", importSummary);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Import error: {ex.Message}");
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    // Helper to safely parse CSV rows where data (like Addresses) might contain commas wrapped in quotes
    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var currentField = new StringBuilder();

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '\"')
            {
                inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(currentField.ToString());
                currentField.Clear();
            }
            else
            {
                currentField.Append(c);
            }
        }
        result.Add(currentField.ToString());
        return result;
    }
}
