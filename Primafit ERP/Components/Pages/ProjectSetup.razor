@page "/projects"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject ProjectService Service
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Project Setup</h1>
            <p class="text-sm text-slate-500">Create independent tracking codes</p>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <EditForm Model="@newProject" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">

                <div class="md:col-span-4">
                    <label class="mb-1 block text-sm font-medium text-slate-700">Project Code</label>
                    <InputText @bind-Value="newProject.Code"
                               class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder:text-slate-400 font-mono"
                               placeholder="e.g. PRJ-001" />
                </div>

                <div class="md:col-span-8">
                    <label class="mb-1 block text-sm font-medium text-slate-700">Project Name</label>
                    <InputText @bind-Value="newProject.Name"
                               class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder:text-slate-400"
                               placeholder="e.g. Warehouse Renovation" />
                </div>

            </div>

            <div class="mt-6 flex justify-end border-t border-slate-100 pt-5">
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 transition-all">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                    Create Project
                </button>
            </div>
        </EditForm>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                <tr>
                    <th class="px-6 py-4">Code</th>
                    <th class="px-6 py-4">Name</th>
                    <th class="px-6 py-4">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (projects.Any())
                {
                    @foreach (var item in projects)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 font-mono font-medium text-indigo-600">@item.Code</td>
                            <td class="px-6 py-4">@item.Name</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">
                                    Active
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-6 py-8 text-center text-slate-400 italic">No projects found. Add one above.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Project> projects = new();
    private Project newProject = new();

    protected override async Task OnInitializedAsync()
    {
        projects = await Service.GetProjectsAsync();
    }

    private async Task HandleSubmit()
    {
        if (await Service.CreateProjectAsync(newProject))
        {
            newProject = new();
            projects = await Service.GetProjectsAsync();
        }
    }
}