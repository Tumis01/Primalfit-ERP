@page "/companydetails"
@using Microsoft.EntityFrameworkCore
@using PrimafitERP.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject CompanyApiService ApiService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Organization Settings</h1>
            <p class="text-sm text-slate-500">Manage your company entities and financial details.</p>
        </div>

        @* Only show "Add Company" if they somehow have 0 companies linked to their account *@
        @if (!showForm && !companies.Any() && !isLoading)
        {
            <PermissionGate Key="SYSTEM_SETUP_MANAGE">
                <Authorized>
                    <button @onclick="ShowCreateForm"
                            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-500/20 transition-all hover:shadow-lg hover:shadow-indigo-500/30 focus:outline-none">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        Add Company
                    </button>
                </Authorized>
            </PermissionGate>
        }
    </div>

    @if (requiresOnboarding && showForm)
    {
        <div class="rounded-xl bg-indigo-50 border border-indigo-200 p-4 flex items-start gap-4 mb-6 animate-in fade-in">
            <div class="bg-indigo-600 rounded-full p-2 text-white shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
                <h3 class="text-sm font-bold text-indigo-900">Welcome to Primafit ERP!</h3>
                <p class="text-xs text-indigo-700 mt-1">Before you can start posting transactions, you must configure your Fiscal Years and Base Currency. Please complete the form below.</p>
            </div>
        </div>
    }

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="border-b border-slate-100 px-6 py-4 flex justify-between items-center">
                <h2 class="font-semibold text-slate-900">@(isEditing ? "Edit Company Profile" : "New Company Details")</h2>
                @if (!requiresOnboarding)
                {
                    <button @onclick="CancelForm" class="text-slate-400 hover:text-slate-600 font-bold">✕</button>
                }
            </div>

            <EditForm Model="@currentCompany" OnValidSubmit="HandleSubmit" class="p-6">
                <DataAnnotationsValidator />

                <div class="grid gap-6 md:grid-cols-2 items-start">

                    <div class="space-y-6">
                        <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
                            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Identity</h3>

                            <div class="mb-4 flex items-center gap-4">
                                <div class="relative h-16 w-16 overflow-hidden rounded-full border border-slate-200 bg-white shadow-sm">
                                    @if (!string.IsNullOrEmpty(currentCompany.LogoPath))
                                    {
                                        <img src="@currentCompany.LogoPath" class="h-full w-full object-cover" alt="Logo" />
                                    }
                                    else
                                    {
                                        <div class="flex h-full w-full items-center justify-center text-slate-300">
                                            <svg class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                                <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </div>
                                    }
                                </div>
                                <div class="flex-1">
                                    <label class="block text-sm font-medium text-slate-700">Company Logo</label>
                                    <div class="mt-1 flex items-center gap-2">
                                        <label class="cursor-pointer rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-600 shadow-sm hover:bg-slate-50 transition-colors">
                                            Upload New
                                            <InputFile OnChange="HandleFileSelected" class="hidden" accept=".jpg,.jpeg,.png" />
                                        </label>
                                        <span class="text-[10px] text-slate-400">JPG or PNG, max 5MB</span>
                                    </div>
                                </div>
                            </div>

                            <div class="space-y-4">
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Company Name <span class="text-rose-500">*</span></label>
                                    <InputText @bind-Value="currentCompany.CompanyName" class="@InputClass" placeholder="e.g. Acme Corp" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Reg Number</label>
                                    <InputText @bind-Value="currentCompany.ComanyRegNumber" class="@InputClass" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Tax ID</label>
                                    <InputText @bind-Value="currentCompany.TaxIdentidicationNum" class="@InputClass" />
                                </div>
                            </div>
                        </div>

                        <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
                            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Addresses</h3>
                            <div class="space-y-3">
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Physical Address</label>
                                    <InputTextArea @bind-Value="currentCompany.PhysicalAddress" class="@InputClass" rows="3" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Postal Address</label>
                                    <InputTextArea @bind-Value="currentCompany.PostalAddress" class="@InputClass" rows="3" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
                            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Contact & Details</h3>
                            <div class="space-y-3">
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Email</label>
                                    <InputText @bind-Value="currentCompany.CompanyEmail" class="@InputClass" type="email" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Website</label>
                                    <InputText @bind-Value="currentCompany.CompanyWebsite" class="@InputClass" placeholder="https://" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Country</label>
                                    <InputText @bind-Value="currentCompany.country" class="@InputClass" />
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="mb-1 block text-sm font-medium text-slate-700">Type</label>
                                        <InputSelect @bind-Value="currentCompany.Type" class="@InputClass">
                                            @foreach (var type in Enum.GetValues<CompanyType>())
                                            {
                                                <option value="@type">@SplitCamelCase(type.ToString())</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="rounded-xl border border-indigo-100 bg-indigo-50/30 p-4 shadow-sm">
                            <h3 class="mb-3 text-xs font-bold uppercase tracking-wider text-indigo-700">Required Financials</h3>
                            <div class="space-y-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="mb-1 block text-sm font-bold text-slate-700">Fiscal Start <span class="text-rose-500">*</span></label>
                                        <InputDate @bind-Value="currentCompany.FiscalStartYear" class="@($"{InputClass} border-indigo-200")" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-bold text-slate-700">Fiscal End <span class="text-rose-500">*</span></label>
                                        <InputDate @bind-Value="currentCompany.FiscalEndYear" class="@($"{InputClass} border-indigo-200")" />
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="mb-1 block text-sm font-bold text-slate-700">Base Currency <span class="text-rose-500">*</span></label>
                                        <InputText @bind-Value="currentCompany.BaseCurrency" placeholder="e.g. NGN" class="@($"{InputClass} border-indigo-200")" />
                                    </div>
                                    <div>
                                        <label class="mb-1 block text-sm font-bold text-slate-700">Func. Currency</label>
                                        <InputText @bind-Value="currentCompany.FunctionalCurrency" placeholder="e.g. USD" class="@InputClass" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
                    @if (!requiresOnboarding)
                    {
                        <button type="button" @onclick="CancelForm" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900">
                            Cancel
                        </button>
                    }
                    <PermissionGate Key="COMPANY_PROFILE_UPDATE">
                        <Authorized>
                            <button type="submit" disabled="@isBusy" class="rounded-xl bg-slate-900 px-8 py-2.5 text-sm font-bold text-white hover:bg-slate-800 shadow-sm disabled:opacity-50 transition-colors">
                                @(isBusy ? "Processing..." : (requiresOnboarding ? "Complete Setup" : "Update Profile"))
                            </button>
                        </Authorized>
                    </PermissionGate>
                </div>
            </EditForm>
        </div>
    }

    @if (!requiresOnboarding && !showForm)
    {
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500">
                        <tr>
                            <th class="px-6 py-4">Organization</th>
                            <th class="px-6 py-4">Reg No.</th>
                            <th class="px-6 py-4">Email</th>
                            <th class="px-6 py-4">Base Currency</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (isLoading)
                        {
                            <tr><td colspan="5" class="px-6 py-8 text-center text-slate-400 animate-pulse">Loading company data...</td></tr>
                        }
                        else if (!companies.Any())
                        {
                            <tr><td colspan="5" class="px-6 py-8 text-center text-slate-400">No company profile found for your account.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in companies)
                            {
                                <tr class="group hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-medium text-slate-900">
                                        <div class="flex items-center gap-3">
                                            @if (!string.IsNullOrEmpty(item.LogoPath))
                                            {
                                                <img src="@item.LogoPath" class="h-8 w-8 rounded-full object-cover border border-slate-200" alt="" />
                                            }
                                            else
                                            {
                                                <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-xs font-bold text-slate-500">
                                                    @item.CompanyName?.FirstOrDefault()
                                                </div>
                                            }
                                            @item.CompanyName
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 font-mono text-xs">@(string.IsNullOrEmpty(item.ComanyRegNumber) ? "-" : item.ComanyRegNumber)</td>
                                    <td class="px-6 py-4">@item.CompanyEmail</td>
                                    <td class="px-6 py-4 font-bold text-emerald-600">@item.BaseCurrency</td>
                                    
                                    <td class="px-6 py-4 text-right">
                                        <PermissionGate Key="COMPANY_PROFILE_UPDATE">
                                            <Authorized>
                                                <button @onclick="() => EditCompany(item)" class="text-indigo-600 hover:text-indigo-900 font-bold hover:underline">Manage Settings</button>
                                            </Authorized>
                                        </PermissionGate>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private const string InputClass = "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20";

    private Guid currentCompanyId = Guid.Empty;
    private List<CompanyDetails> companies = new();
    private CompanyDetails currentCompany = new();
    
    private bool showForm = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private bool isBusy = false;
    
    // Controls the forced onboarding flow
    private bool requiresOnboarding = false;

    protected override async Task OnInitializedAsync()
    {
        // 1. Check general access permission
        if (!PermissionCache.Has("SYSTEM_SETUP_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            await LoadData();
        }
        else
        {
            isLoading = false; // No company ID linked to this user
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        var allCompanies = await ApiService.GetCompaniesAsync();
        companies = allCompanies.Where(c => c.CompanyDetailsId == currentCompanyId).ToList();

        // Onboarding Check Logic
        if (companies.Any())
        {
            var myCompany = companies.First();
            
            if (string.IsNullOrWhiteSpace(myCompany.BaseCurrency) || myCompany.FiscalStartYear == null)
            {
                requiresOnboarding = true;
                EditCompany(myCompany);
            }
            else
            {
                requiresOnboarding = false;
                showForm = false; 
            }
        }

        isLoading = false;
    }

    private void ShowCreateForm()
    {
        currentCompany = new CompanyDetails
        {
            FiscalStartYear = DateOnly.FromDateTime(DateTime.Now),
            FiscalEndYear = DateOnly.FromDateTime(DateTime.Now.AddYears(1)),
            BaseCurrency = "NGN",
            FunctionalCurrency = "USD",
            country = "Nigeria"
        };
        isEditing = false;
        showForm = true;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(currentCompany.BaseCurrency))
        {
            await JS.InvokeVoidAsync("alert", "Base Currency is strictly required to process financials.");
            return;
        }

        isBusy = true;
        try
        {
            if (isEditing)
            {
                var success = await ApiService.UpdateCompanyAsync(currentCompany);
                if (success) await LoadData(); 
            }
            else
            {
                var success = await ApiService.CreateCompanyAsync(currentCompany);
                if (success) await LoadData();
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        long maxFileSize = 1024 * 1024 * 5; // 5MB

        try
        {
            await using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var bytes = ms.ToArray();

            currentCompany.NewLogoBase64 = Convert.ToBase64String(bytes);
            currentCompany.NewLogoExtension = Path.GetExtension(file.Name);

            currentCompany.LogoPath = $"data:{file.ContentType};base64,{currentCompany.NewLogoBase64}";
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Image Upload Error: {ex.Message}");
        }
    }

    private void EditCompany(CompanyDetails item)
    {
        currentCompany = new CompanyDetails
        {
            CompanyDetailsId = item.CompanyDetailsId,
            CompanyName = item.CompanyName,
            ComanyRegNumber = item.ComanyRegNumber,
            TaxIdentidicationNum = item.TaxIdentidicationNum,
            CompanyEmail = item.CompanyEmail,
            PhysicalAddress = item.PhysicalAddress,
            PostalAddress = item.PostalAddress,
            FiscalStartYear = item.FiscalStartYear,
            FiscalEndYear = item.FiscalEndYear,
            country = item.country,
            CompanyWebsite = item.CompanyWebsite,
            FunctionalCurrency = item.FunctionalCurrency,
            BaseCurrency = item.BaseCurrency,
            CreatedDate = item.CreatedDate,
            ModifiedDate = item.ModifiedDate,
            LogoPath = item.LogoPath,
            Type = item.Type,
            CreatedByUserId = item.CreatedByUserId
        };
        isEditing = true;
        showForm = true;
    }

    private string SplitCamelCase(string input) => System.Text.RegularExpressions.Regex.Replace(input, "([a-z])([A-Z])", "$1 $2");

    private void CancelForm()
    {
        showForm = false;
        currentCompany = new();
    }
}