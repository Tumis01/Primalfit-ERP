@page "/currency-setup"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject CurrencyService Service
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Currency Management</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Manage trading currencies and daily exchange rates.</p>
        </div>

        <div class="flex items-center gap-4">
            <div class="hidden md:flex flex-col items-end">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Base Currency</span>
                <span class="text-xl font-bold text-slate-900 font-mono">@(string.IsNullOrEmpty(companyBaseCurrency) ? "-" : companyBaseCurrency)</span>
            </div>

            <div class="h-8 w-px bg-slate-200 hidden md:block"></div>

            <div class="flex gap-2">
                <button @onclick="OpenCurrencyForm" disabled="@(!HasCompany)"
                        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-indigo-600 transition-all active:scale-95 disabled:opacity-50">
                    New Currency
                </button>

                <button @onclick="OpenRateForm" disabled="@(!CanAddRate)"
                        class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                    Add Rate
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading currency data...
        </div>
    }
    else if (HasCompany)
    {
        @if (string.IsNullOrWhiteSpace(companyBaseCurrency))
        {
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 flex gap-3 text-amber-900">
                <svg class="w-6 h-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                <div>
                    <div class="font-bold text-sm">Base Currency Missing</div>
                    <div class="text-xs mt-1 opacity-90">Go to Company Details and set a Base Currency (e.g., USD, NGN) before adding rates.</div>
                </div>
            </div>
        }

        @if (showCurrencyForm)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl animate-in slide-in-from-top-2 mb-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-900">Define New Currency</h3>
                    <button @onclick="CloseCurrencyForm" class="text-slate-400 hover:text-slate-600">✕</button>
                </div>

                <EditForm Model="@newCurrency" OnValidSubmit="HandleSaveCurrency">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="label">Code</label>
                            <InputText @bind-Value="newCurrency.CurrencyCode" class="input-class font-mono uppercase" placeholder="e.g. EUR" />
                            <ValidationMessage For="@(() => newCurrency.CurrencyCode)" class="text-red-500 text-xs mt-1" />
                        </div>
                        <div>
                            <label class="label">Name</label>
                            <InputText @bind-Value="newCurrency.CurrencyName" class="input-class" placeholder="e.g. Euro" />
                            <ValidationMessage For="@(() => newCurrency.CurrencyName)" class="text-red-500 text-xs mt-1" />
                        </div>
                    </div>
                    <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-slate-100">
                        <button type="button" @onclick="CloseCurrencyForm" class="px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">Cancel</button>
                        <button type="submit" class="px-5 py-2 text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-lg shadow-md transition-colors">Save</button>
                    </div>
                </EditForm>
            </div>
        }

        @if (showRateForm)
        {
            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/30 p-6 shadow-xl ring-1 ring-indigo-900/5 animate-in slide-in-from-top-2 mb-6">
                <h3 class="font-bold text-indigo-900 mb-4">@(isEditingRate ? "Edit Rate" : "Add Exchange Rate")</h3>

                <EditForm Model="@currentRate" OnValidSubmit="HandleSaveRate">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div>
                            <label class="label text-indigo-900">Effective Date</label>
                            <InputDate @bind-Value="currentRate.Date" class="input-class border-indigo-200 focus:border-indigo-500 focus:ring-indigo-200" />
                        </div>
                        <div>
                            <label class="label text-indigo-900">Target Currency</label>
                            <InputSelect @bind-Value="currentRate.CurrencyId" class="input-class border-indigo-200 focus:border-indigo-500 focus:ring-indigo-200">
                                <option value="@Guid.Empty">-- Select --</option>
                                @foreach (var c in AvailableCurrenciesForRates)
                                {
                                    <option value="@c.Id">@c.CurrencyName (@c.CurrencyCode)</option>
                                }
                            </InputSelect>
                        </div>
                        <div>
                            <label class="label text-indigo-900 opacity-60">Base Currency</label>
                            <div class="input-class bg-slate-100 text-slate-500 cursor-not-allowed flex items-center border-indigo-100">
                                @companyBaseCurrency
                            </div>
                        </div>
                        <div>
                            <label class="label text-indigo-900">Rate</label>
                            <InputNumber @bind-Value="currentRate.Rate" class="input-class font-mono border-indigo-200 focus:border-indigo-500 focus:ring-indigo-200" placeholder="1.0000" />
                        </div>
                    </div>
                    <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-indigo-100">
                        <button type="button" @onclick="CloseRateForm" class="px-4 py-2 text-sm font-bold text-slate-600 hover:bg-white rounded-lg transition-colors">Cancel</button>
                        <button type="submit" class="px-5 py-2 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-md transition-colors">
                            @(isEditingRate ? "Update Rate" : "Add Rate")
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <div class="lg:col-span-1 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden h-fit">
                <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
                    <h3 class="font-bold text-sm text-slate-800 uppercase tracking-wide">Defined Currencies</h3>
                </div>
                <table class="w-full text-left text-sm">
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var c in currencyList)
                        {
                            var hasRates = ratesList.Any(r => r.CurrencyId == c.Id);
                            <tr class="hover:bg-slate-50 group transition-colors">
                                <td class="px-6 py-3 font-mono font-bold text-slate-900">@c.CurrencyCode</td>
                                <td class="px-6 py-3 text-slate-600">@c.CurrencyName</td>
                                <td class="px-6 py-3 text-right">
                                    @if (!hasRates)
                                    {
                                        <button @onclick="() => DeleteCurrency(c)" class="text-slate-400 hover:text-red-600 opacity-0 group-hover:opacity-100 transition-opacity">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!currencyList.Any())
                        {
                            <tr><td colspan="3" class="p-6 text-center text-slate-400 text-xs">No currencies defined.</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden h-fit">
                <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
                    <h3 class="font-bold text-sm text-slate-800 uppercase tracking-wide">Daily Exchange Rates</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-white text-xs uppercase font-bold text-slate-500 border-b border-slate-100">
                            <tr>
                                <th class="px-6 py-3">Date</th>
                                <th class="px-6 py-3">Currency</th>
                                <th class="px-6 py-3 text-right">Rate (vs @companyBaseCurrency)</th>
                                <th class="px-6 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var item in ratesList)
                            {
                                <tr class="hover:bg-slate-50 group transition-colors">
                                    <td class="px-6 py-4 font-mono text-slate-600">@item.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="px-6 py-4 font-bold text-slate-900">@item.Currency?.CurrencyCode</td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-900">@item.Rate.ToString("N4")</td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex justify-end gap-3 opacity-60 group-hover:opacity-100 transition-opacity">
                                            <button @onclick="() => EditRate(item)" class="text-slate-600 hover:text-indigo-600 font-bold text-xs">Edit</button>
                                            <button @onclick="() => DeleteRate(item)" class="text-slate-400 hover:text-red-600 font-bold text-xs">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!ratesList.Any())
                            {
                                <tr><td colspan="4" class="p-8 text-center text-slate-400 text-xs">No exchange rates recorded.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.025em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
        }
</style>

@code {
    // --- Context ---
    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private string companyBaseCurrency = "";

    // --- Data ---
    private List<Currency> currencyList = new();
    private List<CurrencyManagement> ratesList = new();

    // --- State ---
    private Currency newCurrency = new();
    private CurrencyManagement currentRate = new();
    private bool showCurrencyForm = false;
    private bool showRateForm = false;
    private bool isEditingRate = false;

    // Logic: Can only add rate if company has base currency AND there are currencies without rates (or editing)
    private bool CanAddRate => HasCompany && !string.IsNullOrWhiteSpace(companyBaseCurrency) && (AvailableCurrenciesForRates.Any() || isEditingRate);

    // Filter Logic
    private IEnumerable<Currency> AvailableCurrenciesForRates
    {
        get
        {
            if (!ratesList.Any()) return currencyList;

            // Get IDs that already have rates
            var usedIds = ratesList.Select(r => r.CurrencyId).ToHashSet();

            // If editing, allow the current one
            if (isEditingRate) usedIds.Remove(currentRate.CurrencyId);

            return currencyList.Where(c => !usedIds.Contains(c.Id));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null)
                {
                    companyName = company.CompanyName;
                    companyBaseCurrency = (company.BaseCurrency ?? "").Trim().ToUpperInvariant();
                }

                await LoadAll();
            }
        }
        isLoading = false;
    }

    private async Task LoadAll()
    {
        if (!HasCompany) return;
        currencyList = await Service.GetCurrenciesAsync(selectedCompanyId);
        ratesList = await Service.GetRatesAsync(selectedCompanyId);
    }

    // --- Currency Actions ---
    private void OpenCurrencyForm()
    {
        newCurrency = new Currency { CompanyId = selectedCompanyId };
        showCurrencyForm = true;
        showRateForm = false;
    }

    private void CloseCurrencyForm() => showCurrencyForm = false;

    private async Task HandleSaveCurrency()
    {
        newCurrency.CompanyId = selectedCompanyId; // Ensure context
        var result = await Service.SaveCurrencyAsync(selectedCompanyId, newCurrency);
        if (!string.IsNullOrEmpty(result))
        {
            await JS.InvokeVoidAsync("alert", result);
            return;
        }
        await LoadAll();
        CloseCurrencyForm();
    }

    private async Task DeleteCurrency(Currency item)
    {
        if (ratesList.Any(r => r.CurrencyId == item.Id))
        {
            await JS.InvokeVoidAsync("alert", "Cannot delete currency with existing rates.");
            return;
        }

        if (await JS.InvokeAsync<bool>("confirm", $"Delete currency {item.CurrencyCode}?"))
        {
            var result = await Service.DeleteCurrencyAsync(selectedCompanyId, item.Id);
            if (!string.IsNullOrEmpty(result)) await JS.InvokeVoidAsync("alert", result);
            await LoadAll();
        }
    }

    // --- Rate Actions ---
    private void OpenRateForm()
    {
        currentRate = new CurrencyManagement
        {
            CompanyId = selectedCompanyId,
            ExchangeCurrency = companyBaseCurrency,
            Date = DateTime.Today,
            CurrencyId = AvailableCurrenciesForRates.FirstOrDefault()?.Id ?? Guid.Empty
        };
        isEditingRate = false;
        showRateForm = true;
        showCurrencyForm = false;
    }

    private void EditRate(CurrencyManagement item)
    {
        currentRate = new CurrencyManagement
        {
            Id = item.Id,
            CompanyId = selectedCompanyId,
            CurrencyId = item.CurrencyId,
            Rate = item.Rate,
            Date = item.Date,
            ExchangeCurrency = item.ExchangeCurrency
        };
        isEditingRate = true;
        showRateForm = true;
        showCurrencyForm = false;
    }

    private void CloseRateForm()
    {
        showRateForm = false;
        isEditingRate = false;
    }

    private async Task HandleSaveRate()
    {
        currentRate.CompanyId = selectedCompanyId;
        currentRate.ExchangeCurrency = companyBaseCurrency;

        var result = await Service.SaveRateAsync(selectedCompanyId, currentRate, companyBaseCurrency);
        if (!string.IsNullOrEmpty(result))
        {
            await JS.InvokeVoidAsync("alert", result);
            return;
        }
        await LoadAll();
        CloseRateForm();
    }

    private async Task DeleteRate(CurrencyManagement item)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Delete this exchange rate?"))
        {
            await Service.DeleteRateAsync(selectedCompanyId, item.Id);
            await LoadAll();
        }
    }
}