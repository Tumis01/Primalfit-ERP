@page "/currency-setup"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject CurrencyService Service
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Currency & Exchange Rate Management</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Configure multi-currency dictionaries and daily historical exchange rate timelines.</p>
        </div>

        <div class="flex items-center gap-4">
            <div class="hidden md:flex flex-col items-end">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Base Currency</span>
                <span class="text-xl font-bold text-slate-900 font-mono">@(string.IsNullOrEmpty(companyBaseCurrency) ? "-" : companyBaseCurrency)</span>
            </div>

            <div class="h-8 w-px bg-slate-200 hidden md:block"></div>

            <div class="flex gap-2">
                <PermissionGate Key="SYSTEM_SETUP_MANAGE">
                    <Authorized>
                        <button @onclick="OpenCurrencyForm" disabled="@(!HasCompany)"
                                class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-indigo-600 transition-all active:scale-95 disabled:opacity-50">
                            New Currency
                        </button>

                        <button @onclick="OpenRateForm" disabled="@(!CanAddRate)"
                                class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                            Add Daily Rate
                        </button>
                    </Authorized>
                </PermissionGate>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading currency and rate configurations...
        </div>
    }
    else if (HasCompany)
    {
        @if (string.IsNullOrWhiteSpace(companyBaseCurrency))
        {
            <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 flex gap-3 text-amber-900">
                <svg class="w-6 h-6 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                <div>
                    <div class="font-bold text-sm">Base Currency Missing</div>
                    <div class="text-xs mt-1 opacity-90">Please set a Base Currency in Company Setup (e.g. USD, NGN, EUR) before adding rates.</div>
                </div>
            </div>
        }

        @* CURRENCY MODAL / FORM *@
        @if (showCurrencyForm)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xl animate-in slide-in-from-top-2 mb-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-slate-900">@(isEditingCurrency ? $"Edit Currency: {newCurrency.CurrencyCode}" : "Define New Currency")</h3>
                    <button @onclick="CloseCurrencyForm" class="text-slate-400 hover:text-slate-600">✕</button>
                </div>

                <EditForm Model="@newCurrency" OnValidSubmit="HandleSaveCurrency">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="label">Currency Code <span class="text-rose-500">*</span></label>
                            <InputText @bind-Value="newCurrency.CurrencyCode" class="input-class font-mono uppercase" placeholder="e.g. GBP" />
                            <ValidationMessage For="@(() => newCurrency.CurrencyCode)" class="text-red-500 text-xs mt-1" />
                        </div>
                        <div>
                            <label class="label">Currency Name <span class="text-rose-500">*</span></label>
                            <InputText @bind-Value="newCurrency.CurrencyName" class="input-class" placeholder="e.g. British Pound" />
                            <ValidationMessage For="@(() => newCurrency.CurrencyName)" class="text-red-500 text-xs mt-1" />
                        </div>
                    </div>
                    <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-slate-100">
                        <button type="button" @onclick="CloseCurrencyForm" class="px-4 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">Cancel</button>
                        <PermissionGate Key="SYSTEM_SETUP_MANAGE">
                            <Authorized>
                                <button type="submit" class="px-5 py-2 text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-lg shadow-md transition-colors">
                                    @(isEditingCurrency ? "Update Currency" : "Save Currency")
                                </button>
                            </Authorized>
                        </PermissionGate>
                    </div>
                </EditForm>
            </div>
        }

        @* EXCHANGE RATE FORM *@
        @if (showRateForm)
        {
            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/40 p-6 shadow-xl ring-1 ring-indigo-900/5 animate-in slide-in-from-top-2 mb-6">
                <div class="flex justify-between items-center mb-4">
                    <h3 class="font-bold text-indigo-950">@(isEditingRate ? "Edit Historical Exchange Rate" : "Add New Historical Exchange Rate")</h3>
                    <button @onclick="CloseRateForm" class="text-slate-400 hover:text-slate-600">✕</button>
                </div>

                <EditForm Model="@currentRate" OnValidSubmit="HandleSaveRate">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div>
                            <label class="label text-indigo-900">Effective Date <span class="text-rose-500">*</span></label>
                            <InputDate @bind-Value="currentRate.Date" class="input-class border-indigo-200 focus:border-indigo-500 focus:ring-indigo-200" />
                            <ValidationMessage For="@(() => currentRate.Date)" class="text-rose-500 text-xs mt-1" />
                        </div>
                        <div>
                            <label class="label text-indigo-900">Trading Currency <span class="text-rose-500">*</span></label>
                            <InputSelect @bind-Value="currentRate.CurrencyId" class="input-class border-indigo-200 focus:border-indigo-500 focus:ring-indigo-200 font-bold">
                                <option value="@Guid.Empty">-- Select Currency --</option>
                                @foreach (var c in currencyList)
                                {
                                    <option value="@c.Id">@c.CurrencyName (@c.CurrencyCode)</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => currentRate.CurrencyId)" class="text-rose-500 text-xs mt-1" />
                        </div>
                        <div>
                            <label class="label text-indigo-900 opacity-60">Base Currency Target</label>
                            <div class="input-class bg-slate-100 text-slate-500 cursor-not-allowed flex items-center border-indigo-100 font-mono font-bold">
                                @companyBaseCurrency
                            </div>
                        </div>
                        <div>
                            <label class="label text-indigo-900">Exchange Rate Multiplier <span class="text-rose-500">*</span></label>
                            <InputNumber @bind-Value="currentRate.Rate"   class="input-class font-mono font-bold border-indigo-200 focus:border-indigo-500 focus:ring-indigo-200 text-right" placeholder="1.000000" />
                            <ValidationMessage For="@(() => currentRate.Rate)" class="text-rose-500 text-xs mt-1" />
                        </div>
                    </div>
                    <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-indigo-100">
                        <button type="button" @onclick="CloseRateForm" class="px-4 py-2 text-sm font-bold text-slate-600 hover:bg-white rounded-lg transition-colors">Cancel</button>
                        <PermissionGate Key="SYSTEM_SETUP_MANAGE">
                            <Authorized>
                                <button type="submit" class="px-5 py-2 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-md transition-colors">
                                    @(isEditingRate ? "Save Rate Update" : "Commit Exchange Rate")
                                </button>
                            </Authorized>
                        </PermissionGate>
                    </div>
                </EditForm>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            @* LEFT: DEFINED CURRENCIES LIST *@
            <div class="lg:col-span-4 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden h-fit">
                <div class="bg-slate-50 px-5 py-3.5 border-b border-slate-200 flex justify-between items-center">
                    <h3 class="font-bold text-xs text-slate-800 uppercase tracking-wider">Trading Currencies</h3>
                    <span class="text-[11px] font-mono text-slate-400 font-semibold">@currencyList.Count Total</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <tbody class="divide-y divide-slate-100 font-medium">
                            @foreach (var c in currencyList)
                            {
                                int recordedCount = ratesList.Count(r => r.CurrencyId == c.Id);
                                bool isBase = c.CurrencyCode.Equals(companyBaseCurrency, StringComparison.OrdinalIgnoreCase);

                                <tr class="hover:bg-slate-50 group transition-colors @(selectedFilterCurrencyId == c.Id ? "bg-indigo-50/40" : "")">
                                    <td class="px-5 py-3">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono font-bold text-slate-900">@c.CurrencyCode</span>
                                            @if (isBase)
                                            {
                                                <span class="px-1.5 py-0.5 rounded text-[9px] font-extrabold uppercase bg-emerald-50 text-emerald-700 border border-emerald-200">Base</span>
                                            }
                                        </div>
                                        <div class="text-xs text-slate-500 font-normal">@c.CurrencyName</div>
                                    </td>
                                    <td class="px-3 py-3 text-center">
                                        <button type="button" @onclick="() => FilterByCurrency(c.Id)"
                                                class="px-2 py-0.5 rounded text-[11px] font-mono font-bold transition-colors @(selectedFilterCurrencyId == c.Id ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-600 hover:bg-slate-200")">
                                            @recordedCount @(recordedCount == 1 ? "rate" : "rates")
                                        </button>
                                    </td>
                                    <td class="px-5 py-3 text-right">
                                        <div class="flex items-center justify-end gap-2 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity">
                                            <PermissionGate Key="SYSTEM_SETUP_MANAGE">
                                                <Authorized>
                                                    <button type="button" @onclick="() => EditCurrency(c)" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">Edit</button>
                                                    @if (recordedCount == 0 && !isBase)
                                                    {
                                                        <button type="button" @onclick="() => DeleteCurrency(c)" class="text-xs font-bold text-rose-500 hover:text-rose-700">Delete</button>
                                                    }
                                                </Authorized>
                                            </PermissionGate>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!currencyList.Any())
                            {
                                <tr><td colspan="3" class="p-8 text-center text-slate-400 text-xs">No currencies configured.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* RIGHT: RATES LOG (ALLOWS MULTIPLE DATED RATES PER CURRENCY) *@
            <div class="lg:col-span-8 rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden h-fit">
                <div class="bg-slate-50 px-6 py-3.5 border-b border-slate-200 flex flex-col sm:flex-row justify-between sm:items-center gap-3">
                    <div>
                        <h3 class="font-bold text-xs text-slate-800 uppercase tracking-wider">Exchange Rate History &amp; Timelines</h3>
                        <p class="text-[11px] text-slate-500 mt-0.5">Historical entries determine system exchange rates based on transaction dates.</p>
                    </div>

                    <div class="flex items-center gap-2">
                        @if (selectedFilterCurrencyId.HasValue)
                        {
                            <button type="button" @onclick="ClearCurrencyFilter" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 border border-indigo-100 px-2 py-1 rounded-lg">
                                Show All Currencies ✕
                            </button>
                        }
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-white text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-100 tracking-wider">
                            <tr>
                                <th class="px-6 py-3.5">Effective Date</th>
                                <th class="px-6 py-3.5">Currency</th>
                                <th class="px-6 py-3.5 text-right">Multiplier Rate (vs @companyBaseCurrency)</th>
                                <th class="px-6 py-3.5 text-center">Relative Valuation</th>
                                <th class="px-6 py-3.5 text-right pr-6">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                            @foreach (var item in FilteredRatesList)
                            {
                                <tr class="hover:bg-slate-50 group transition-colors">
                                    <td class="px-6 py-3.5 font-mono text-slate-600 font-bold">@item.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="px-6 py-3.5">
                                        <span class="font-mono font-black text-slate-900">@item.Currency?.CurrencyCode</span>
                                        <span class="text-xs text-slate-400 ml-1.5 font-normal">(@item.Currency?.CurrencyName)</span>
                                    </td>
                                    <td class="px-6 py-3.5 text-right font-mono font-black text-slate-900">
                                        @item.Rate.ToString("N4")
                                    </td>
                                    <td class="px-6 py-3.5 text-center">
                                        <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-slate-100 text-slate-600">
                                            1 @item.Currency?.CurrencyCode = @item.Rate.ToString("N4") @companyBaseCurrency
                                        </span>
                                    </td>
                                    <td class="px-6 py-3.5 text-right pr-6">
                                        <div class="flex justify-end gap-3 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity">
                                            <PermissionGate Key="SYSTEM_SETUP_MANAGE">
                                                <Authorized>
                                                    <button type="button" @onclick="() => EditRate(item)" class="text-slate-600 hover:text-indigo-600 font-bold text-xs">Edit</button>
                                                    <button type="button" @onclick="() => DeleteRate(item)" class="text-slate-400 hover:text-rose-600 font-bold text-xs">Delete</button>
                                                </Authorized>
                                            </PermissionGate>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!FilteredRatesList.Any())
                            {
                                <tr>
                                    <td colspan="5" class="p-12 text-center text-slate-400 text-xs font-medium">
                                        No exchange rates recorded @(selectedFilterCurrencyId.HasValue ? "for the selected currency filter." : ".")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
        }
</style>

@code {
    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private string companyBaseCurrency = "";

    private List<Currency> currencyList = new();
    private List<CurrencyManagement> ratesList = new();

    private Currency newCurrency = new();
    private CurrencyManagement currentRate = new();

    private bool showCurrencyForm = false;
    private bool isEditingCurrency = false;

    private bool showRateForm = false;
    private bool isEditingRate = false;

    private Guid? selectedFilterCurrencyId = null;

    // Any defined currency can receive multiple rates as long as the base currency is defined
    private bool CanAddRate => HasCompany && !string.IsNullOrWhiteSpace(companyBaseCurrency) && currencyList.Any();

    private IEnumerable<CurrencyManagement> FilteredRatesList =>
        ratesList
            .Where(r => !selectedFilterCurrencyId.HasValue || r.CurrencyId == selectedFilterCurrencyId.Value)
            .OrderByDescending(r => r.Date)
            .ThenBy(r => r.Currency?.CurrencyCode);

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SYSTEM_SETUP_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null)
                {
                    companyName = company.CompanyName;
                    companyBaseCurrency = (company.BaseCurrency ?? "").Trim().ToUpperInvariant();
                }

                await LoadAll();
            }
        }
        isLoading = false;
    }

    private async Task LoadAll()
    {
        if (!HasCompany) return;
        currencyList = await Service.GetCurrenciesAsync(selectedCompanyId);
        ratesList = await Service.GetRatesAsync(selectedCompanyId);
    }

    private void FilterByCurrency(Guid currencyId)
    {
        if (selectedFilterCurrencyId == currencyId)
            selectedFilterCurrencyId = null;
        else
            selectedFilterCurrencyId = currencyId;
    }

    private void ClearCurrencyFilter() => selectedFilterCurrencyId = null;

    // --- Currency Actions ---
    private void OpenCurrencyForm()
    {
        newCurrency = new Currency { CompanyId = selectedCompanyId };
        isEditingCurrency = false;
        showCurrencyForm = true;
        showRateForm = false;
    }

    private void EditCurrency(Currency item)
    {
        newCurrency = new Currency
        {
            Id = item.Id,
            CompanyId = selectedCompanyId,
            CurrencyCode = item.CurrencyCode,
            CurrencyName = item.CurrencyName
        };
        isEditingCurrency = true;
        showCurrencyForm = true;
        showRateForm = false;
    }

    private void CloseCurrencyForm()
    {
        showCurrencyForm = false;
        isEditingCurrency = false;
    }

    private async Task HandleSaveCurrency()
    {
        newCurrency.CompanyId = selectedCompanyId;
        var result = await Service.SaveCurrencyAsync(selectedCompanyId, newCurrency);
        if (!string.IsNullOrEmpty(result))
        {
            await JS.InvokeVoidAsync("alert", result);
            return;
        }
        await LoadAll();
        CloseCurrencyForm();
    }

    private async Task DeleteCurrency(Currency item)
    {
        if (ratesList.Any(r => r.CurrencyId == item.Id))
        {
            await JS.InvokeVoidAsync("alert", "Cannot delete currency with existing recorded exchange rates.");
            return;
        }

        if (await JS.InvokeAsync<bool>("confirm", $"Permanently remove currency {item.CurrencyCode} ({item.CurrencyName})?"))
        {
            var result = await Service.DeleteCurrencyAsync(selectedCompanyId, item.Id);
            if (!string.IsNullOrEmpty(result)) await JS.InvokeVoidAsync("alert", result);
            await LoadAll();
        }
    }

    // --- Rate Actions ---
    private void OpenRateForm()
    {
        currentRate = new CurrencyManagement
        {
            CompanyId = selectedCompanyId,
            ExchangeCurrency = companyBaseCurrency,
            Date = DateTime.Today,
            CurrencyId = selectedFilterCurrencyId ?? currencyList.FirstOrDefault()?.Id ?? Guid.Empty,
            Rate = 1.0m
        };
        isEditingRate = false;
        showRateForm = true;
        showCurrencyForm = false;
    }

    private void EditRate(CurrencyManagement item)
    {
        currentRate = new CurrencyManagement
        {
            Id = item.Id,
            CompanyId = selectedCompanyId,
            CurrencyId = item.CurrencyId,
            Rate = item.Rate,
            Date = item.Date,
            ExchangeCurrency = item.ExchangeCurrency
        };
        isEditingRate = true;
        showRateForm = true;
        showCurrencyForm = false;
    }

    private void CloseRateForm()
    {
        showRateForm = false;
        isEditingRate = false;
    }

    private async Task HandleSaveRate()
    {
        currentRate.CompanyId = selectedCompanyId;
        currentRate.ExchangeCurrency = companyBaseCurrency;

        var result = await Service.SaveRateAsync(selectedCompanyId, currentRate, companyBaseCurrency);
        if (!string.IsNullOrEmpty(result))
        {
            await JS.InvokeVoidAsync("alert", result);
            return;
        }
        await LoadAll();
        CloseRateForm();
    }

    private async Task DeleteRate(CurrencyManagement item)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Delete exchange rate of {item.Rate:N4} on {item.Date:yyyy-MM-dd}?"))
        {
            await Service.DeleteRateAsync(selectedCompanyId, item.Id);
            await LoadAll();
        }
    }
}