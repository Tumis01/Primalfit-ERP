@* @page "/companies"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject CompanyService CompanyService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Companies</h1>
            <p class="text-sm text-slate-500">Manage your company entities and details.</p>
        </div>
        <button @@onclick="ShowCreateForm"
                class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-500/20 transition-all hover:shadow-lg hover:shadow-indigo-500/30 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Add Company
        </button>
    </div>

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="border-b border-slate-100 px-6 py-4">
                <h2 class="font-semibold text-slate-900">@(isEditing ? "Edit Company" : "New Company Details")</h2>
            </div>

            <EditForm Model="currentCompany" OnValidSubmit="HandleSubmit" class="p-6">
                <DataAnnotationsValidator />

                <div class="grid gap-6 md:grid-cols-2">
                    <div class="space-y-4">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Identity</h3>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Company Name</label>
                            <InputText bind-Value="currentCompany.CompanyName" class="@@InputClass" placeholder="e.g. Acme Corp" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Registration Number</label>
                            <InputText bind-Value="currentCompany.ComanyRegNumber" class="@@InputClass" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Tax ID</label>
                            <InputText bind-Value="currentCompany.TaxIdentidicationNum" class="@@InputClass" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Company Type</label>
                            <InputSelect bind-Value="currentCompany.Type" class="@@InputClass">
                                @foreach (var type in Enum.GetValues(typeof(CompanyType)))
                                {
                                    <option value="@@type">@@type</option>
                                }
                            </InputSelect>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Contact</h3>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Email Address</label>
                            <InputText bind-Value="currentCompany.CompanyEmail" class="@@InputClass" type="email" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Website</label>
                            <InputText bind-Value="currentCompany.CompanyWebsite" class="@@InputClass" placeholder="https://" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Physical Address</label>
                            <InputTextArea bind-Value="currentCompany.PhysicalAddress" class="@@InputClass" rows="2" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Postal Address</label>
                            <InputTextArea bind-Value="currentCompany.PostalAddress" class="@@InputClass" rows="2" />
                        </div>
                    </div>

                    <div class="space-y-4">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Financials</h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700">Base Currency</label>
                                <InputText bind-Value="currentCompany.BaseCurrency" class="@@InputClass" />
                            </div>
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700">Func. Currency</label>
                                <InputText bind-Value="currentCompany.FunctionalCurrency" class="@@InputClass" />
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700">Fiscal Start</label>
                                <InputDate bind-Value="currentCompany.FiscalStartYear" class="@@InputClass" />
                            </div>
                            <div>
                                <label class="mb-1 block text-sm font-medium text-slate-700">Fiscal End</label>
                                <InputDate bind-Value="currentCompany.FiscalEndYear" class="@@InputClass" />
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Settings</h3>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Country</label>
                            <InputText bind-Value="currentCompany.country" class="@@InputClass" />
                        </div>
                        <div>
                            <label class="mb-1 block text-sm font-medium text-slate-700">Status</label>
                            <InputSelect bind-Value="currentCompany.Status" class="@@InputClass">
                                @foreach (var status in Enum.GetValues(typeof(CompanyStatus)))
                                {
                                    <option value="@@status">@@status</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
                    <button type="button" onclick="CancelForm" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                        Cancel
                    </button>
                    <button type="submit" disabled="@@isBusy" class="rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 shadow-sm disabled:opacity-50">
                        @if (isBusy)
                        {
                            <span>Processing...</span>
                        }
                        else
                        {

                            <span>@@(isEditing ? "Save Changes" : "Create Company")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500">
                    <tr>
                        <th class="px-6 py-4">Company Name</th>
                        <th class="px-6 py-4">Email</th>
                        <th class="px-6 py-4">Country</th>
                        <th class="px-6 py-4">Type</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (isLoading)
                    {
                        <tr><td colspan="6" class="px-6 py-8 text-center text-slate-400">Loading companies...</td></tr>
                    }
                    else if (companies == null || !companies.Any())
                    {
                        <tr><td colspan="6" class="px-6 py-8 text-center text-slate-400">No companies found.</td></tr>
                    }
                    else
                    {
                        @foreach (var company in companies)
                        {
                            <tr class="group hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-4 font-medium text-slate-900">
                                    @@company.CompanyName
                                    <div class="text-xs text-slate-400 font-normal">@@company.ComanyRegNumber</div>
                                </td>
                                <td class="px-6 py-4">@@company.CompanyEmail</td>
                                <td class="px-6 py-4">@@company.country</td>
                                <td class="px-6 py-4">@@company.Type</td>
                                <td class="px-6 py-4">
                                    <span class="@@GetStatusBadgeClass(company.Status)">
                                        @@company.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button @@onclick="() => EditCompany(company)" class="rounded-lg p-2 text-slate-400 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" title="Edit">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </button>
                                        <button @@onclick="() => DeleteCompany(company)" class="rounded-lg p-2 text-slate-400 hover:bg-red-50 hover:text-red-600 transition-colors" title="Delete">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private const string InputClass = "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10";

    private bool showForm = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private bool isBusy = false;

    private CompanyDetails currentCompany = new();
    private List<CompanyDetails> companies = new();

    // 1. Load Data on Start
    protected override async Task OnInitializedAsync()
    {
        await LoadCompanies();
    }

    private async Task LoadCompanies()
    {
        isLoading = true;
        companies = await CompanyService.GetAllCompaniesAsync();
        isLoading = false;
    }

    private void ShowCreateForm()
    {
        // Reset form for new entry
        currentCompany = new CompanyDetails
        {
            FiscalStartYear = DateOnly.FromDateTime(DateTime.Now),
            FiscalEndYear = DateOnly.FromDateTime(DateTime.Now.AddYears(1)),
            Type = CompanyType.LimitedLiabilityCompany,
            Status = CompanyStatus.Active
        };
        isEditing = false;
        showForm = true;
    }

    private void EditCompany(CompanyDetails company)
    {
        // Create a copy so we don't edit the table row directly until saved
        currentCompany = new CompanyDetails
        {
            CompanyDetailsId = company.CompanyDetailsId,
            CompanyName = company.CompanyName,
            ComanyRegNumber = company.ComanyRegNumber,
            TaxIdentidicationNum = company.TaxIdentidicationNum,
            CompanyEmail = company.CompanyEmail,
            PhysicalAddress = company.PhysicalAddress,
            PostalAddress = company.PostalAddress,
            FiscalStartYear = company.FiscalStartYear,
            FiscalEndYear = company.FiscalEndYear,
            country = company.country,
            CompanyWebsite = company.CompanyWebsite,
            FunctionalCurrency = company.FunctionalCurrency,
            BaseCurrency = company.BaseCurrency,
            Type = company.Type,
            Status = company.Status,
            CreatedDate = company.CreatedDate
        };

        isEditing = true;
        showForm = true;
    }

    private async Task HandleSubmit()
    {
        isBusy = true;
        try
        {
            if (isEditing)
            {
                await CompanyService.UpdateCompanyAsync(currentCompany);
            }
            else
            {
                await CompanyService.AddCompanyAsync(currentCompany);
            }

            await LoadCompanies(); // Refresh list
            showForm = false;
        }
        catch (Exception ex)
        {
            // Ideally show a toast notification here
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteCompany(CompanyDetails company)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {company.CompanyName}?");
        if (confirmed)
        {
            await CompanyService.DeleteCompanyAsync(company.CompanyDetailsId);
            await LoadCompanies();
        }
    }

    private void CancelForm()
    {
        showForm = false;
        currentCompany = new();
    }

    private string GetStatusBadgeClass(CompanyStatus status)
    {
        return status == CompanyStatus.Active
            ? "inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20"
            : "inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10";
    }
} *@