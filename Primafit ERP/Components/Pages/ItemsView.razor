@page "/sc/items"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Text

@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject PermissionCacheService PermissionCache
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Item Master</h1>
            <p class="text-sm text-slate-500 mt-1">Manage Inventory Items, Services, and their GL mappings.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <PermissionGate Key="INVENTORY_SETUP_MANAGE">
                <Authorized>
                    <button @onclick="ExportCsv" class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 text-sm">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        Export CSV
                    </button>

                    <label class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 cursor-pointer mb-0 text-sm">
                        @if (isImporting)
                        {
                            <span class="animate-spin">↻</span>
                            <span>Importing...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                            <span>Import CSV</span>
                        }
                        <InputFile OnChange="ImportCsv" accept=".csv" class="hidden" disabled="@isImporting" />
                    </label>

                    <button @onclick="CreateNew" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        New Item
                    </button>
                </Authorized>
            </PermissionGate>
        </div>
    </div>

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl mb-6 animate-in slide-in-from-top-4">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-bold text-slate-900">@(isEditing ? "Edit Item" : "New Item")</h3>
                @if (isEditing)
                {
                    <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-lg text-xs font-bold font-mono border border-slate-200">Current Cost: @currentItem.CurrentDisplayCost.ToString("N4")</span>
                }
            </div>

            <EditForm Model="@currentItem" OnValidSubmit="SaveItem">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 items-start">
                    <div>
                        <label class="label">Code <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentItem.SKU" class="input-class font-mono uppercase" placeholder="PROD-001" />
                    </div>
                    <div>
                        <label class="label">Name <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentItem.Name" class="input-class" placeholder="Product Name" />
                    </div>
                    <div>
                        <label class="label">Type</label>
                        <div class="flex items-center gap-3 mt-2 h-[42px]">
                            <label class="flex items-center gap-2 cursor-pointer p-2 rounded hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all">
                                <InputCheckbox @bind-Value="currentItem.IsService" class="w-4 h-4 rounded text-slate-900 focus:ring-slate-900" />
                                <span class="text-sm font-bold text-slate-700">Is Service?</span>
                            </label>
                        </div>
                    </div>

                    @if (!currentItem.IsService)
                    {
                        <div>
                            <label class="label">Attached / Primary UOM</label>
                            <select value="@currentItem.UomId" @onchange="OnPrimaryUomChanged" class="input-class">
                                <option value="">-- Select UOM --</option>
                                @foreach (var u in uoms)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                            <p class="text-[10px] text-slate-400 mt-1">The item price is defined in this UOM.</p>
                        </div>
                        <div>
                            <label class="label">Alternate / Stock UOM</label>
                            <InputSelect @bind-Value="currentItem.AlternateUomId" class="input-class">
                                <option value="">-- None / 1:1 --</option>
                                @foreach (var u in uoms.Where(x => x.Id != currentItem.UomId))
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </InputSelect>
                        </div>
                        @if (currentItem.AlternateUomId.HasValue)
                        {
                            <div>
                                <label class="label">Units per Primary UOM</label>
                                <InputNumber @bind-Value="currentItem.AlternateUomConversionFactor" class="input-class font-mono" min="0.0001"   />
                                <p class="text-[10px] text-indigo-600 mt-1 font-semibold">
                                    1 @(uoms.FirstOrDefault(x => x.Id == currentItem.UomId)?.Name ?? "primary") = @currentItem.AlternateUomConversionFactor:N4> @(uoms.FirstOrDefault(x => x.Id == currentItem.AlternateUomId)?.Name ?? "alternate")
                                </p>
                            </div>
                        }
                        else if (uoms.FirstOrDefault(x => x.Id == currentItem.UomId)?.ConversionUomId is Guid inheritedUomId)
                        {
                            var inheritedPrimary = uoms.FirstOrDefault(x => x.Id == currentItem.UomId);
                            var inheritedTarget = uoms.FirstOrDefault(x => x.Id == inheritedUomId);
                            <div class="rounded-xl border border-indigo-100 bg-indigo-50/50 p-3 text-xs font-semibold text-indigo-700">
                                Inherited conversion: 1 @(inheritedPrimary?.Name ?? "primary") = @((inheritedPrimary?.ConversionFactorValue > 0 ? inheritedPrimary.ConversionFactorValue : 1m).ToString("N4")) @(inheritedTarget?.Name ?? "alternate")
                            </div>
                        }
                        <div>
                            <label class="label">Reorder Level</label>
                            <InputNumber @bind-Value="currentItem.ReorderLevel" class="input-class font-mono" />
                        </div>

                        <div class="p-3 bg-indigo-50/50 border border-indigo-100 rounded-xl space-y-3">
                            <div>
                                <label class="label text-indigo-700">Costing Method <span class="text-rose-500">*</span></label>
                                <InputSelect @bind-Value="currentItem.CostingType" class="input-class bg-white font-bold text-indigo-900 border-indigo-200">
                                    <option value="@CostingMethod.WACC">Weighted Avg Cost (WACC)</option>
                                    <option value="@CostingMethod.StandardCosting">Standard Costing</option>
                                    <option value="@CostingMethod.UserSpecified">User Specified</option>
                                    <option value="@CostingMethod.FIFO">FIFO (First-In, First-Out)</option>
                                    <option value="@CostingMethod.LIFO">LIFO (Last-In, First-Out)</option>
                                    <option value="@CostingMethod.MostRecentCost">Most Recent Cost</option>
                                </InputSelect>
                            </div>

                            @if (currentItem.CostingType == CostingMethod.UserSpecified)
                            {
                                <div class="animate-in fade-in slide-in-from-top-2">
                                    <label class="label text-indigo-700">User Specified Cost</label>
                                    <InputNumber @bind-Value="currentItem.UserSpecifiedCost" class="input-class font-mono text-indigo-700 font-bold border-indigo-200" placeholder="0.0000" />
                                </div>
                            }
                            else if (currentItem.CostingType == CostingMethod.StandardCosting)
                            {
                                <div class="animate-in fade-in slide-in-from-top-2">
                                    <label class="label text-indigo-700">Standard Cost</label>
                                    <InputNumber @bind-Value="currentItem.StandardCost" class="input-class font-mono text-indigo-700 font-bold border-indigo-200" placeholder="0.0000" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="md:col-span-3 border-t border-slate-100 my-2"></div>
                    }

                    <div>
                        <label class="label">Default Selling Price</label>
                        <InputNumber @bind-Value="currentItem.SellingPrice" class="input-class font-mono text-emerald-700 font-bold" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div class="mb-8 bg-slate-50 border border-slate-100 p-5 rounded-xl shadow-sm">
                        <label class="label text-indigo-900">Item Category </label>
                        <select class="input-class border-slate-200 bg-white" @onchange="OnCategorySelected">
                            <option value="@Guid.Empty">-- Select Item Category --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" selected="@(currentItem.CategoryId == cat.Id)">
                                    @cat.Name @(cat.IsService ? "(Service)" : "(Physical Goods)")
                                </option>
                            }
                        </select>
                        <p class="text-xs text-indigo-700 mt-2 font-medium flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            Selecting a category will automatically apply its predefined General Ledger mapping and item type below.
                        </p>
                    </div>
                </div>

                <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 mb-6">
                    <h4 class="text-xs font-bold text-slate-500 uppercase mb-4 border-b border-slate-200 pb-2">Financial Ledger Routing</h4>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        @if (!currentItem.IsService)
                        {
                            <SearchableGlAccount Label="Inventory Asset Account (BS / Debit)"
                                                 Placeholder="Search Asset Accounts..."
                                                 Accounts="@assetAccounts"
                                                 @bind-Value="currentItem.InventoryAssetAccountId"
                                                 IsInvalid="@(currentItem.InventoryAssetAccountId == Guid.Empty)" />
                        }

                        <SearchableGlAccount Label="Sales Income Account (PL / Credit)"
                                             Placeholder="Search Revenue Accounts..."
                                             Accounts="@revenueAccounts"
                                             @bind-Value="currentItem.SalesIncomeAccountId"
                                             IsInvalid="@(currentItem.SalesIncomeAccountId == Guid.Empty)" />

                        <SearchableGlAccount Label="Cost of Goods Sold (PL / Debit)"
                                             Placeholder="Search Expense Accounts..."
                                             Accounts="@expenseAccounts"
                                             @bind-Value="currentItem.CostOfGoodsSoldAccountId"
                                             IsInvalid="@(currentItem.CostOfGoodsSoldAccountId == Guid.Empty)" />

                        @if (!currentItem.IsService)
                        {
                            <SearchableGlAccount Label="Inventory Adjustment / Loss (PL / Debit)"
                                                 Placeholder="Search Expense Accounts..."
                                                 Accounts="@expenseAccounts"
                                                 @bind-Value="currentItem.AdjustmentExpenseAccountId" />
                        }
                    </div>
                </div>

                <div class="flex justify-end gap-3">
                    <button type="button" @onclick="() => showForm = false" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancel</button>
                    <button type="submit" class="rounded-xl bg-slate-900 px-8 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">@(isEditing ? "Update Item" : "Save Item")</button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 border-b border-slate-100 bg-slate-50/50">
            <div class="relative w-full sm:max-w-md">
                
                <input type="text" @bind="itemSearch" @bind:event="oninput" class="input-class bg-white pl-10 pr-10" placeholder="Search items by code, name, UOM, or category..." />
                @if (!string.IsNullOrWhiteSpace(itemSearch))
                {
                    <button type="button" @onclick="() => itemSearch = string.Empty" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700" aria-label="Clear item search">&times;</button>
                }
            </div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">@FilteredItems.Count() of @items.Count items</div>
        </div>
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left text-sm text-slate-900 whitespace-nowrap min-w-[1000px]">
                <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                    <tr>
                        <th class="p-4 pl-6">CODE</th>
                        <th class="p-4">Item Name</th>
                        <th class="p-4 text-center">Type</th>
                        <th class="p-4">Costing Method</th>
                        <th class="p-4 text-right">Selling Price</th>
                        <th class="p-4 text-right">Cost</th>
                        <th class="p-4 text-right pr-6">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (FilteredItems.Any())
                    {
                        @foreach (var i in FilteredItems)
                        {
                            <tr class="hover:bg-slate-50 transition-colors group">
                                <td class="p-4 pl-6 font-mono font-bold text-slate-700">@i.SKU</td>
                                <td class="p-4 font-bold text-slate-900">
                                    <div class="truncate max-w-[250px]" title="@i.Name">@i.Name</div>
                                </td>
                                <td class="p-4 text-center">
                                    <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider @(i.IsService ? "bg-indigo-50 text-indigo-700 border border-indigo-200" : "bg-emerald-50 text-emerald-700 border border-emerald-200")">
                                        @(i.IsService ? "Service" : "Goods")
                                    </span>
                                </td>
                                <td class="p-4">
                                    @if (!i.IsService)
                                    {
                                        <span class="text-xs text-slate-500 font-bold bg-slate-100 px-2 py-1 rounded">@i.CostingType.ToString()</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-400 italic">N/A</span>
                                    }
                                </td>
                                <td class="p-4 text-right font-mono font-bold text-emerald-600">@i.SellingPrice.ToString("N4")</td>

                                <td class="p-4 text-right font-mono text-slate-500">@i.CurrentDisplayCost.ToString("N4")</td>

                                <td class="p-4 text-right pr-6 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity">
                                    <PermissionGate Key="INVENTORY_SETUP_MANAGE">
                                        <Authorized>
                                            <button @onclick="() => Edit(i)" class="text-indigo-600 font-bold hover:text-indigo-900 mr-4 text-xs uppercase tracking-wider">Edit</button>
                                            <button @onclick="() => Delete(i)" class="text-rose-500 font-bold hover:text-rose-700 text-xs uppercase tracking-wider">Delete</button>
                                        </Authorized>
                                    </PermissionGate>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="p-12 text-center text-slate-400">No items match the current search.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        outline: none;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private List<Item> items = new();
    private List<UnitOfMeasure> uoms = new();
    private List<ItemCategory> categories = new();

    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> assetAccounts = new();
    private List<SegChartOfAccount> revenueAccounts = new();
    private List<SegChartOfAccount> expenseAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private Item currentItem = new();
    private bool showForm = false;
    private bool isEditing = false;
    private bool isImporting = false;
    private Guid currentCompanyId;
    private string itemSearch = string.Empty;

    private IEnumerable<Item> FilteredItems => items
        .Where(i => string.IsNullOrWhiteSpace(itemSearch)
                 || i.SKU.Contains(itemSearch, StringComparison.OrdinalIgnoreCase)
                 || i.Name.Contains(itemSearch, StringComparison.OrdinalIgnoreCase)
                 || (i.UoM?.Contains(itemSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                 || (i.PrimaryUom?.Name.Contains(itemSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                 || (i.AlternateUom?.Name.Contains(itemSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                 || (categories.FirstOrDefault(c => c.Id == i.CategoryId)?.Name.Contains(itemSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                 || i.CostingType.ToString().Contains(itemSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("INVENTORY_SETUP_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;

            items = await MasterService.GetItemsAsync(currentCompanyId);
            uoms = await MasterService.GetUnitOfMeasuresAsync(currentCompanyId);
            categories = await MasterService.GetItemCategoriesAsync(currentCompanyId);

            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

            assetAccounts = FilterAccounts(true, true);
            revenueAccounts = FilterAccounts(false, false);
            expenseAccounts = FilterAccounts(false, true);
        }
    }

    private List<SegChartOfAccount> FilterAccounts(bool isBs, bool isDr)
    {
        return allAccounts
            .Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.IsBalanceSheet == isBs && type.IsDebit == isDr && a.IsActive;
            })
            .OrderBy(a => a.AccountCode)
            .ToList();
    }

    private void CreateNew()
    {
        currentItem = new Item { CompanyId = currentCompanyId, CostingType = CostingMethod.WACC };
        showForm = true;
        isEditing = false;
    }

    private void Edit(Item i)
    {
        currentItem = new Item
        {
            Id = i.Id,
            CompanyId = i.CompanyId,
            CategoryId = i.CategoryId,
            Name = i.Name,
            SKU = i.SKU,
            IsService = i.IsService,
            SellingPrice = i.SellingPrice,
            UoM = i.UoM,
            UomId = i.UomId ?? uoms.FirstOrDefault(u => u.Name.Equals(i.UoM, StringComparison.OrdinalIgnoreCase))?.Id,
            AlternateUomId = i.AlternateUomId,
            AlternateUomConversionFactor = i.AlternateUomConversionFactor <= 0 ? 1m : i.AlternateUomConversionFactor,
            ReorderLevel = i.ReorderLevel,
            CostingType = i.CostingType,
            WeightedAverageCost = i.WeightedAverageCost,
            StandardCost = i.StandardCost,
            UserSpecifiedCost = i.UserSpecifiedCost,
            MostRecentCost = i.MostRecentCost,
            InventoryAssetAccountId = i.InventoryAssetAccountId,
            SalesIncomeAccountId = i.SalesIncomeAccountId,
            CostOfGoodsSoldAccountId = i.CostOfGoodsSoldAccountId,
            AdjustmentExpenseAccountId = i.AdjustmentExpenseAccountId
        };
        showForm = true;
        isEditing = true;
    }

    private void OnPrimaryUomChanged(ChangeEventArgs e)
    {
        currentItem.UomId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        var primary = uoms.FirstOrDefault(x => x.Id == currentItem.UomId);
        if (currentItem.AlternateUomId == null && primary?.ConversionUomId is Guid targetId)
        {
            currentItem.AlternateUomId = targetId;
            currentItem.AlternateUomConversionFactor = primary.ConversionFactorValue > 0 ? primary.ConversionFactorValue : 1m;
        }
    }

    private void OnCategorySelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var catId) && catId != Guid.Empty)
        {
            var selectedCategory = categories.FirstOrDefault(c => c.Id == catId);
            if (selectedCategory != null)
            {
                currentItem.CategoryId = catId;
                currentItem.IsService = selectedCategory.IsService;

                currentItem.SalesIncomeAccountId = selectedCategory.SalesIncomeAccountId;
                currentItem.CostOfGoodsSoldAccountId = selectedCategory.CostOfGoodsSoldAccountId;

                if (!selectedCategory.IsService)
                {
                    currentItem.InventoryAssetAccountId = selectedCategory.InventoryAssetAccountId ?? Guid.Empty;
                    currentItem.AdjustmentExpenseAccountId = selectedCategory.AdjustmentExpenseAccountId ?? Guid.Empty;
                }
                else
                {
                    currentItem.InventoryAssetAccountId = Guid.Empty;
                    currentItem.AdjustmentExpenseAccountId = Guid.Empty;
                    currentItem.UoM = "";
                    currentItem.UomId = null;
                    currentItem.AlternateUomId = null;
                    currentItem.AlternateUomConversionFactor = 1m;
                    currentItem.ReorderLevel = 0;
                }
            }
        }
        else
        {
            currentItem.CategoryId = null;
        }
    }

    private async Task Delete(Item i)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Permanently delete item '{i.Name}'?")) return;
        var err = await MasterService.DeleteItemAsync(i.Id);
        if (string.IsNullOrEmpty(err))
        {
            items = await MasterService.GetItemsAsync(currentCompanyId);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveItem()
    {
        if (currentItem.SalesIncomeAccountId == Guid.Empty || currentItem.CostOfGoodsSoldAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Sales Income and COGS accounts are required.");
            return;
        }

        if (!currentItem.IsService && currentItem.InventoryAssetAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Inventory Asset account is required for physical goods.");
            return;
        }

        var err = await MasterService.SaveItemAsync(currentItem);
        if (string.IsNullOrEmpty(err))
        {
            showForm = false;
            items = await MasterService.GetItemsAsync(currentCompanyId);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    // --- CSV EXPORT LOGIC ---
    private async Task ExportCsv()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("SKU,Name,IsService,CategoryName,CostingType,UoM,ReorderLevel,SellingPrice,StandardCost,UserSpecifiedCost,SalesIncomeGlCode,CogsGlCode,InventoryAssetGlCode,AdjustmentGlCode");

            foreach (var i in items)
            {
                var catName = categories.FirstOrDefault(c => c.Id == i.CategoryId)?.Name ?? "";
                var incCode = allAccounts.FirstOrDefault(a => a.Id == i.SalesIncomeAccountId)?.AccountCode ?? "";
                var cogsCode = allAccounts.FirstOrDefault(a => a.Id == i.CostOfGoodsSoldAccountId)?.AccountCode ?? "";
                var assetCode = allAccounts.FirstOrDefault(a => a.Id == i.InventoryAssetAccountId)?.AccountCode ?? "";
                var adjCode = allAccounts.FirstOrDefault(a => a.Id == i.AdjustmentExpenseAccountId)?.AccountCode ?? "";

                sb.AppendLine($"\"{i.SKU?.Replace("\"", "\"\"")}\",\"{i.Name?.Replace("\"", "\"\"")}\",{i.IsService},\"{catName?.Replace("\"", "\"\"")}\",{i.CostingType},\"{i.UoM}\",{i.ReorderLevel},{i.SellingPrice},{i.StandardCost},{i.UserSpecifiedCost},\"{incCode}\",\"{cogsCode}\",\"{assetCode}\",\"{adjCode}\"");
            }

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(bytes));

            await JS.InvokeVoidAsync("downloadFileFromStream", "ItemsMaster_Export.csv", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
    }

    // --- CSV IMPORT LOGIC ---
    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        isImporting = true;
        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                await JS.InvokeVoidAsync("alert", "Please upload a valid .csv file.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var lines = content.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length <= 1)
            {
                await JS.InvokeVoidAsync("alert", "The file appears to be empty or missing data rows.");
                return;
            }

            int successCount = 0;

            for (int i = 1; i < lines.Length; i++)
            {
                var cols = ParseCsvLine(lines[i]);

                if (cols.Count >= 2)
                {
                    var sku = cols[0].Trim();
                    var name = cols[1].Trim();
                    if (string.IsNullOrWhiteSpace(sku) || string.IsNullOrWhiteSpace(name)) continue;

                    // Match by SKU to avoid duplicates
                    var item = items.FirstOrDefault(x => x.SKU.Equals(sku, StringComparison.OrdinalIgnoreCase))
                               ?? new Item { CompanyId = currentCompanyId, SKU = sku };

                    item.Name = name;

                    if (cols.Count > 2 && bool.TryParse(cols[2].Trim(), out bool isSvc)) item.IsService = isSvc;

                    // Map Category
                    if (cols.Count > 3 && !string.IsNullOrWhiteSpace(cols[3]))
                    {
                        var cat = categories.FirstOrDefault(c => c.Name.Equals(cols[3].Trim(), StringComparison.OrdinalIgnoreCase));
                        if (cat != null) item.CategoryId = cat.Id;
                    }

                    // Map Costing Type
                    if (cols.Count > 4 && Enum.TryParse<CostingMethod>(cols[4].Trim(), true, out var cType))
                    {
                        item.CostingType = cType;
                    }

                    if (cols.Count > 5) item.UoM = cols[5].Trim();
                    if (cols.Count > 6 && decimal.TryParse(cols[6].Trim(), out decimal reorder)) item.ReorderLevel = reorder;
                    if (cols.Count > 7 && decimal.TryParse(cols[7].Trim(), out decimal selling)) item.SellingPrice = selling;
                    if (cols.Count > 8 && decimal.TryParse(cols[8].Trim(), out decimal stdCost)) item.StandardCost = stdCost;
                    if (cols.Count > 9 && decimal.TryParse(cols[9].Trim(), out decimal usrCost)) item.UserSpecifiedCost = usrCost;

                    // GL Mapping
                    if (cols.Count > 10 && !string.IsNullOrWhiteSpace(cols[10]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[10].Trim());
                        if (gl != null) item.SalesIncomeAccountId = gl.Id;
                    }
                    if (cols.Count > 11 && !string.IsNullOrWhiteSpace(cols[11]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[11].Trim());
                        if (gl != null) item.CostOfGoodsSoldAccountId = gl.Id;
                    }
                    if (cols.Count > 12 && !string.IsNullOrWhiteSpace(cols[12]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[12].Trim());
                        if (gl != null) item.InventoryAssetAccountId = gl.Id;
                    }
                    if (cols.Count > 13 && !string.IsNullOrWhiteSpace(cols[13]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[13].Trim());
                        if (gl != null) item.AdjustmentExpenseAccountId = gl.Id;
                    }

                    // Validate Required GLs before saving
                    if (item.SalesIncomeAccountId != Guid.Empty && item.CostOfGoodsSoldAccountId != Guid.Empty)
                    {
                        if (item.IsService || (item.InventoryAssetAccountId != Guid.Empty))
                        {
                            await MasterService.SaveItemAsync(item);
                            successCount++;
                        }
                    }
                }
            }

            items = await MasterService.GetItemsAsync(currentCompanyId); // Refresh full list
            await JS.InvokeVoidAsync("alert", $"Import complete. {successCount} items processed and mapped successfully.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Import error: {ex.Message}");
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    // Helper to safely parse CSV rows
    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var currentField = new StringBuilder();

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '\"')
            {
                inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(currentField.ToString());
                currentField.Clear();
            }
            else
            {
                currentField.Append(c);
            }
        }
        result.Add(currentField.ToString());
        return result;
    }
}
