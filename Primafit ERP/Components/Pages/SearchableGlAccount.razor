@using Primafit_ERP.Components.Models

<div class="relative">
    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">@Label</label>

    @if (SelectedAccount != null && !isSearching)
    {
        <div class="flex items-center justify-between p-2.5 border rounded-xl bg-slate-50 border-slate-200 cursor-pointer hover:border-slate-300"
             @onclick="EnableSearch">
            <div class="flex flex-col">
                <span class="text-sm font-bold text-slate-900">@SelectedAccount.AccountCode</span>
                <span class="text-xs text-slate-500 truncate w-48">@SelectedAccount.AccountName</span>
            </div>
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
    }
    else
    {
        <input @bind="searchTerm"
               @bind:event="oninput"
               @onfocus="() => showDropdown = true"
               @onblur="OnBlur"
               class="w-full rounded-xl border border-slate-200 p-2.5 text-sm focus:border-slate-900 focus:outline-none @(IsInvalid ? "border-red-300 bg-red-50" : "")"
               placeholder="@Placeholder" />

        @if (showDropdown)
        {
            <div class="absolute z-50 mt-1 max-h-60 w-full overflow-auto rounded-xl border border-slate-200 bg-white shadow-xl">
                @if (FilteredAccounts.Any())
                {
                    @foreach (var acc in FilteredAccounts)
                    {
                        <div class="cursor-pointer px-4 py-2 hover:bg-slate-50 border-b border-slate-50 last:border-0"
                             @onmousedown="() => Select(acc)">
                            <div class="font-bold text-sm text-slate-900">@acc.AccountCode</div>
                            <div class="text-xs text-slate-500">@acc.AccountName</div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-3 text-xs text-slate-400 text-center">No accounts found.</div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "GL Account";
    [Parameter] public string Placeholder { get; set; } = "Search Account...";
    [Parameter] public List<GLChartOfAccount> Accounts { get; set; } = new();
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }
    [Parameter] public bool IsInvalid { get; set; }

    private string searchTerm = "";
    private bool isSearching = false;
    private bool showDropdown = false;

    private GLChartOfAccount? SelectedAccount => Accounts.FirstOrDefault(a => a.Id == Value);

    private IEnumerable<GLChartOfAccount> FilteredAccounts =>
        string.IsNullOrWhiteSpace(searchTerm)
        ? Accounts.Take(20)
        : Accounts.Where(a => a.AccountName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                           || a.AccountCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        // If we have a value but haven't started searching, ensure dropdown is closed
        if (Value != Guid.Empty && string.IsNullOrEmpty(searchTerm))
        {
            isSearching = false;
        }
    }

    private void EnableSearch()
    {
        isSearching = true;
        showDropdown = true;
        searchTerm = ""; // Clear to show full list or let user type
    }

    private async Task Select(GLChartOfAccount acc)
    {
        searchTerm = "";
        isSearching = false;
        showDropdown = false;
        await ValueChanged.InvokeAsync(acc.Id);
    }

    private async Task OnBlur()
    {
        // Small delay to allow click event to register
        await Task.Delay(150);
        showDropdown = false;
        isSearching = false;
    }
}