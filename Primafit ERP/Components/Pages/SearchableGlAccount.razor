@using Primafit_ERP.Components.Models

<div class="relative w-full">
    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">@Label</label>
    
    <div class="relative">
        <input type="text" 
               class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all @(IsInvalid ? "border-red-300 bg-red-50" : "")"
               placeholder="@Placeholder"
               @bind="SearchTerm"
               @bind:event="oninput"
               @onfocus="OpenDropdown"
               @onblur="CloseDropdown" 
               autocomplete="off" />

        <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none text-slate-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
    </div>

    @if (isOpen)
    {
        <div class="absolute z-50 mt-1 w-full max-h-60 overflow-auto rounded-xl bg-white py-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none sm:text-sm animate-in fade-in slide-in-from-top-2 duration-200">
            @if (FilteredAccounts.Any())
            {
                @foreach (var account in FilteredAccounts)
                {
                    <div class="cursor-pointer select-none py-2 pl-3 pr-9 hover:bg-indigo-50 hover:text-indigo-900 text-slate-700"
                         @onmousedown="() => Select(account)"> <span class="block truncate">
                            <span class="font-mono font-bold text-slate-500 mr-2">@account.AccountCode</span>
                            @account.AccountName
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="cursor-default select-none py-2 pl-3 pr-9 text-slate-400 italic">No accounts found.</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Account";
    [Parameter] public string Placeholder { get; set; } = "Search account...";
    [Parameter] public List<GLChartOfAccount> Accounts { get; set; } = new();
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }
    
    // Optional: Visual validation state
    [Parameter] public bool IsInvalid { get; set; } 

    private string SearchTerm { get; set; } = "";
    private bool isOpen = false;

    // Filter logic: Matches Code OR Name
    private IEnumerable<GLChartOfAccount> FilteredAccounts => 
        string.IsNullOrWhiteSpace(SearchTerm) 
            ? Accounts 
            : Accounts.Where(a => a.AccountName.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) 
                               || a.AccountCode.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        // If an ID is selected but SearchTerm is empty, pre-fill the name
        if (Value != Guid.Empty && string.IsNullOrEmpty(SearchTerm))
        {
            var selected = Accounts.FirstOrDefault(a => a.Id == Value);
            if (selected != null)
            {
                SearchTerm = $"{selected.AccountCode} - {selected.AccountName}";
            }
        }
    }

    private void OpenDropdown() => isOpen = true;
    
    // Small delay to allow 'Select' to fire before closing
    private async Task CloseDropdown() { await Task.Delay(200); isOpen = false; }

    private async Task Select(GLChartOfAccount account)
    {
        SearchTerm = $"{account.AccountCode} - {account.AccountName}";
        Value = account.Id;
        await ValueChanged.InvokeAsync(account.Id);
        isOpen = false;
    }
}