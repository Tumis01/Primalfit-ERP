    private void LoadExistingRefund(Guid id) => Nav.NavigateTo($"/sales/receipt-refunds/entry/{id}");

    private void ResetToDashboard()
    {
        Nav.NavigateTo("/sales/receipt-refunds/entry", forceLoad: true);
    }

    private async Task InitializeDraft()
    {
        if (selectedInvoiceId == Guid.Empty) return;
        isBusy = true; _errMsg = string.Empty; StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            var draft = await RefundService.CreateReceiptRefundDraftAsync(selectedInvoiceId, selectedRefundType, Guid.Parse(user.Id));
            Nav.NavigateTo($"/sales/receipt-refunds/entry/{draft.Id}");
        }
        catch (Exception ex) { _errMsg = ex.Message; }
        finally { isBusy = false; StateHasChanged(); }
    }

    private async Task OpenRouteModal()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        customTemplates = await ctx.CustomTransactionTypes
            .AsNoTracking()
            .Where(t => t.CompanyId == currentRefund.CompanyId)
            .OrderBy(t => t.Name)
            .ToListAsync();

        var customer = customers.FirstOrDefault(c => c.Id == currentRefund.CustomerId);
        defaultArAccountId = customer?.ReceivablesAccountId ?? Guid.Empty;

        showRouteModal = true;
    }

    private async Task OnCustomTemplateSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var customId) && customId != Guid.Empty)
        {
            currentRefund.CustomTransactionTypeId = customId;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var map = await ctx.TransactionGlMappings
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.CompanyId == currentRefund.CompanyId && m.CustomTransactionTypeId == customId);

            if (map != null)
            {
                if (map.OverrideDebitGlAccountId.HasValue)
                {
                    currentRefund.OverrideReceivablesGlAccountId = map.OverrideDebitGlAccountId.Value;
                    currentRefund.OverrideInventoryAssetGlAccountId = map.OverrideDebitGlAccountId.Value;
                }

                if (map.OverrideCreditGlAccountId.HasValue)
                {
                    currentRefund.OverrideCogsGlAccountId = map.OverrideCreditGlAccountId.Value;
                }
            }
        }
        else
        {
            currentRefund.CustomTransactionTypeId = null;
        }
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            currentRefund.TransactionDateTime = d;
            currentRefund.Date = DateOnly.FromDateTime(d);
        }
    }

    private void OnCashRefundAmountChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val))
        {
            currentRefund.TotalAmount = Math.Max(0, Math.Min(val, cashSummary.MaxRefundable));
        }
        StateHasChanged();
    }

    private void ValidateLineQuantity(ReceiptRefundLine line, string? val)
    {
        if (decimal.TryParse(val, out decimal res))
        {
            if (res < 0) line.Quantity = 0;
            else if (res > GetDisplayedQuantity(line.MaxAdjustableQty, line)) line.Quantity = line.MaxAdjustableQty;
            else line.Quantity = UomConversion.ToBase(res, GetLineFactor(line));
        }
        else line.Quantity = 0;
        StateHasChanged();
    }

    private IEnumerable<UnitOfMeasure> GetItemUoms(Item? item)
    {
        if (item == null) return Enumerable.Empty<UnitOfMeasure>();
        var result = new List<UnitOfMeasure>();
        if (item.UomId.HasValue)
            result.Add(item.PrimaryUom ?? uoms.FirstOrDefault(x => x.Id == item.UomId.Value) ?? new UnitOfMeasure { Id = item.UomId.Value, Name = item.UoM });
        else if (!string.IsNullOrWhiteSpace(item.UoM))
            result.Add(new UnitOfMeasure { Id = Guid.Empty, Name = item.UoM });
        foreach (var conversion in itemUomLines.Where(x => x.ItemId == item.Id && x.UomId != item.UomId))
            result.Add(conversion.Uom ?? uoms.FirstOrDefault(x => x.Id == conversion.UomId) ?? new UnitOfMeasure { Id = conversion.UomId, Name = "UOM" });
        if (item.UomId.HasValue)
            foreach (var uomId in UomConversion.ReachableUoms(item.UomId.Value, conversionRules.Select(x => (x.FromUomId, x.ToUomId))))
                if (uomId != item.UomId.Value && result.All(x => x.Id != uomId) && UomConversion.FactorBetween(item.UomId.Value, uomId, ConversionMap).HasValue)
                    result.Add(uoms.FirstOrDefault(x => x.Id == uomId) ?? new UnitOfMeasure { Id = uomId, Name = "UOM" });
        return result;
    }

    private decimal GetLineFactor(ReceiptRefundLine line) => line.UomConversionFactor > 0 ? line.UomConversionFactor : 1m;
    private decimal GetDisplayedQuantity(decimal baseQuantity, ReceiptRefundLine line) => UomConversion.FromBase(baseQuantity, GetLineFactor(line));
    private decimal GetDisplayedUnitPrice(ReceiptRefundLine line) => UomConversion.PriceFromBase(line.UnitPrice, GetLineFactor(line));
    private string GetUomConversionText(ReceiptRefundLine line) => GetLineFactor(line) == 1m ? "1:1" : $"1 {line.Item?.PrimaryUom?.Name ?? line.Item?.UoM ?? "primary"} = {1m / GetLineFactor(line):N4} {line.UomName}";

    private string GetUomOptionLabel(Item? item, UnitOfMeasure uom)
    {
        if (item == null || item.UomId == uom.Id) return $"{uom.Name} (Primary)";
        var conversion = itemUomLines.FirstOrDefault(x => x.ItemId == item.Id && x.UomId == uom.Id);
        return conversion == null
            ? uom.Name
            : $"{uom.Name} (1 {item.PrimaryUom?.Name ?? item.UoM} = {conversion.ConversionFactorToBase:N4} {uom.Name})";
    }

    private decimal GetItemFactor(Item item, Guid? selectedId)
    {
        var factors = itemUomLines.Where(x => x.ItemId == item.Id)
            .ToDictionary(x => x.UomId, x => x.ConversionFactorToBase);
        return UomConversion.FactorFor(item, selectedId, factors, ConversionMap);
    }

    private void OnLineUomChanged(ReceiptRefundLine line, ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var selectedId) || line.Item == null) return;
        line.UomId = selectedId;
        line.UomName = UomConversion.NameFor(line.Item, selectedId);
        line.UomConversionFactor = GetItemFactor(line.Item, selectedId);
    }

    private async Task SaveDraft()
    {
        var err = await RefundService.SaveDraftAsync(currentRefund);
        if (string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", "Voucher configurations saved as draft.");
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task PostRefund()
    {
        if (currentRefund.RefundType == ReceiptRefundType.QuantityOnly || currentRefund.RefundType == ReceiptRefundType.Both)
        {
            if (currentRefund.DestinationWarehouseId == null || currentRefund.DestinationWarehouseId == Guid.Empty)
            {
                await JS.InvokeVoidAsync("alert", "Please specify a Receiving Warehouse destination location for physical items.");
                return;
            }
        }

        if (currentRefund.RefundType == ReceiptRefundType.PaymentOnly || currentRefund.RefundType == ReceiptRefundType.Both)
        {
            if (currentRefund.BankAccountId == null || currentRefund.BankAccountId == Guid.Empty)
            {
                await JS.InvokeVoidAsync("alert", "Please select a Disbursing Bank Account for cash refund.");
                return;
            }
            if (currentRefund.TotalAmount > cashSummary.MaxRefundable + 0.01m)
            {
                await JS.InvokeVoidAsync("alert", $"Cash refund amount ({currentRefund.TotalAmount:N4}) exceeds the refundable ceiling ({cashSummary.MaxRefundable:N4}).");
                return;
            }
        }

        var saveErr = await RefundService.SaveDraftAsync(currentRefund);
        if (!string.IsNullOrEmpty(saveErr)) { await JS.InvokeVoidAsync("alert", saveErr); return; }

        if (!await JS.InvokeAsync<bool>("confirm", "This will generate permanent ledger entries. Commit to GL?")) return;

        isBusy = true; StateHasChanged();
        var err = await RefundService.PostReceiptRefundAsync(currentRefund.Id, Guid.Parse(currentUserId));
        isBusy = false; StateHasChanged();

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Receipt refund submitted for GL review.");
            ResetToDashboard();
        }
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task DeleteDraft()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Discard this draft workspace permanently?")) return;
        await RefundService.DeleteDraftAsync(currentRefund.Id);
        ResetToDashboard();
    }
}
