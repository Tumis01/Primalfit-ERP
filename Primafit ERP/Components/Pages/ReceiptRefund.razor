@page "/sales/credit-notes/refund/{Id:guid?}"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject CreditNoteService CnService
@inject SegCoaService SegCoaService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PermissionCacheService PermissionCache
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

@rendermode InteractiveServer

<div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-4 border-b border-slate-200">
        <div class="space-y-1">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
                @if (IsListMode)
                {
                    <span>Customer Cash Refunds Ledger</span>
                }
                else if (IsNewInitialization)
                {

                    <span>Initialize Financial Cash Refund</span>
                }
                else
                {

                    <span>Refund Document: @currentCn.CreditNoteNumber</span>
                }
            </h1>
            <p class="text-sm font-medium @(IsPosted ? "text-emerald-600" : "text-amber-600")">
                @if (IsListMode)
                {
                    <span class="text-slate-500">Review, track, and manage historical banking payment reversals.</span>
                }
                else if (IsPosted)
                {

                    <span>● Posted Financial Document - Read Only</span>
                }
                else
                {

                    <span>● Draft Cash Refund - Pending Approval</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            <button type="button" @onclick="NavigateToListView" class="px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-600 font-bold hover:bg-slate-50 transition-all shadow-sm active:scale-95">
                @((!IsListMode) ? "Cancel & Back to List" : "Back to Credit Notes")
            </button>

            @if (IsListMode)
            {
                <PermissionGate Key="CREDIT_NOTE_CREATE">
                    <Authorized>
                        <button type="button" @onclick="OpenNewFormInitializer" class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                            <span>New Cash Refund</span>
                        </button>
                    </Authorized>
                </PermissionGate>
            }
            else if (!IsNewInitialization && !IsPosted)
            {
                <PermissionGate Key="CREDIT_NOTE_CREATE">
                    <Authorized>
                        <button type="button" @onclick="DeleteDraft" class="px-5 py-2.5 bg-white border border-slate-200 text-rose-600 text-sm font-bold rounded-xl hover:bg-rose-50 transition-colors shadow-sm active:scale-95">
                            Delete Draft
                        </button>
                        <button type="button" @onclick="SaveDraftWorkspace" class="px-5 py-2.5 bg-white border border-slate-200 text-indigo-600 text-sm font-bold rounded-xl hover:bg-indigo-50 transition-colors shadow-sm active:scale-95">
                            Save Draft
                        </button>
                    </Authorized>
                </PermissionGate>
                <button type="button" @onclick="PostCashRefund" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2">
                    Post Cash Refund
                </button>
            }
        </div>
    </div>

    @if (IsListMode)
    {
        <div class="space-y-4">
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="relative w-full sm:w-80">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    <input type="text" @bind="listSearchTerm" @bind:event="oninput" placeholder="Search Document, Customer or Inv #..." class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium outline-none focus:border-indigo-500 transition-all" />
                </div>
                <div class="text-xs text-slate-400 font-medium italic">Displaying pure financial cash reversals without stock updates.</div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                @if (_loadingList)
                {
                    <div class="p-16 text-center flex flex-col items-center justify-center"><div class="w-8 h-8 border-4 border-slate-200 border-t-slate-900 rounded-full animate-spin mb-4"></div></div>
                }
                else if (!PaginatedRefunds.Any())
                {
                    <div class="p-16 text-center text-slate-400 italic text-sm font-medium">No financial cash refund documents found matching criteria.</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                                <tr>
                                    <th class="px-6 py-4">Document Ref</th>
                                    <th class="px-6 py-4">Execution Date</th>
                                    <th class="px-6 py-4">Customer Name</th>
                                    <th class="px-6 py-4">Settled Invoice Link</th>
                                    <th class="px-6 py-4 text-center">Status</th>
                                    <th class="px-6 py-4 text-right pr-8">Refund Amount</th>
                                    <th class="px-6 py-4 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                                @foreach (var refund in PaginatedRefunds)
                                {
                                    <tr class="hover:bg-slate-50/60 transition-colors">
                                        <td class="px-6 py-4 font-mono font-bold text-slate-900">@refund.CreditNoteNumber</td>
                                        <td class="px-6 py-4 text-slate-500 font-medium">@refund.Date.ToString("yyyy-MM-dd")</td>
                                        <td class="px-6 py-4 font-bold text-slate-900">@refund.Customer?.Name</td>
                                        <td class="px-6 py-4"><span class="text-xs font-mono font-bold bg-slate-100 text-slate-600 px-2 py-1 rounded-md border border-slate-200">@refund.SalesOrder?.OrderNumber</span></td>
                                        <td class="px-6 py-4 text-center">
                                            @if (refund.Status == CreditNoteStatus.Posted)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Posted</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Draft</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right font-mono font-black text-rose-600 pr-8">
                                            <span>@refund.TotalAmount.ToString("N2")</span>
                                            <span class="text-[9px] text-slate-400 font-bold uppercase ml-1">@refund.Currency?.CurrencyCode</span>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <button type="button" @onclick="() => RouteToTargetRefund(refund.Id)" class="inline-flex items-center justify-center rounded-lg px-4 py-1.5 text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors">
                                                @(refund.Status == CreditNoteStatus.Posted ? "View Details" : "Edit Draft")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-bold text-slate-500">
                        <div>Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, TotalFilteredCount) of @TotalFilteredCount items</div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="GoToPreviousPage" disabled="@(currentPage == 1)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 disabled:opacity-40">Previous</button>
                            <span class="px-3 font-semibold text-slate-700">Page @currentPage of @TotalPages</span>
                            <button type="button" @onclick="GoToNextPage" disabled="@(currentPage == TotalPages || TotalPages == 0)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 disabled:opacity-40">Next</button>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (IsNewInitialization)
    {
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm max-w-xl mx-auto mt-6 space-y-6 overflow-visible relative">
            <h3 class="text-lg font-bold text-slate-900 text-center">Initialize Refund Voucher</h3>

            <div class="relative overflow-visible z-50">
                <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Step 1: Select Target Customer Profile <span class="text-rose-500">*</span></label>
                <div @onclick="ToggleCustomerDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none">
                    <span class="@(selectedCustomerId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">@selectedCustomerName</span>
                    <svg class="w-4 h-4 text-slate-400 transition-transform @(isCustomerDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                </div>

                @if (isCustomerDropdownOpen)
                {
                    <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl p-3 space-y-3 z-[100] animate-in fade-in zoom-in-95 duration-100">
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                            </div>
                            <input type="text" @bind="customerSearchQuery" @bind:event="oninput" class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 focus:bg-white transition-all font-medium text-slate-800" placeholder="Filter customer profiles..." @onclick:stopPropagation />
                        </div>
                        <div class="max-h-48 overflow-y-auto pr-1 divide-y divide-slate-50">
                            @foreach (var cust in customers.Where(c => c.Name.Contains(customerSearchQuery, StringComparison.OrdinalIgnoreCase)))
                            {
                                <div @onclick="() => SelectCustomer(cust)" class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-900 rounded-lg transition-colors cursor-pointer">@cust.Name</div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (selectedCustomerId != Guid.Empty)
            {
                <div class="relative animate-in fade-in duration-300 z-40">
                    <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Step 2: Choose Settled Invoice Target <span class="text-rose-500">*</span></label>

                    <div @onclick="ToggleInvoiceDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none">
                        <span class="@(selectedInvoiceId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">@selectedInvoiceName</span>
                        <svg class="w-4 h-4 text-slate-400 transition-transform @(isInvoiceDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                    </div>

                    @if (isInvoiceDropdownOpen)
                    {
                        <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl p-3 space-y-3 z-[100] animate-in fade-in zoom-in-95 duration-100">
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                </div>
                                <input type="text" @bind="invoiceSearchQuery" @bind:event="oninput" class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 focus:bg-white transition-all font-medium text-slate-800" placeholder="Search by Invoice Number..." @onclick:stopPropagation />
                            </div>
                            <div class="max-h-48 overflow-y-auto pr-1 divide-y divide-slate-50">
                                @foreach (var inv in paidInvoices.Where(i => i.OrderNumber.Contains(invoiceSearchQuery, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div @onclick="() => SelectInvoice(inv)" class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-900 rounded-lg transition-colors cursor-pointer flex justify-between">
                                        <span>@inv.OrderNumber</span>
                                        <span class="text-slate-400 font-mono">Paid Bal: @inv.AmountPaid.ToString("N2")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_loadingInvoices)
                    {
                        <p class="text-xs text-indigo-600 font-bold mt-2 animate-pulse">Aggregating historical payment layers...</p>
                    }
                    else if (!paidInvoices.Any())
                    {
                        <p class="text-xs text-rose-600 font-bold mt-2">⚠️ No cash entries or remaining paid balances found for this customer.</p>
                    }
                </div>
            }

            <button type="button" @onclick="InitializeDraftWorkspace" disabled="@(_busy || selectedInvoiceId == Guid.Empty)" class="w-full px-6 py-3.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-40">
                @if (_busy)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                }
                <span>Initialize Draft Workspace</span>
            </button>
            @if (!string.IsNullOrWhiteSpace(_errMsg))
            {
                <div class="p-4 bg-rose-50 border border-rose-100 text-rose-700 text-xs font-bold rounded-xl">@_errMsg</div>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 relative z-10 overflow-visible">

            <div class="lg:col-span-4 space-y-6">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5 overflow-visible relative">
                    <h3 class="font-extrabold text-xs text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Operational Parameters</h3>

                    <div>
                        <label class="label">Adjustment Posting Date</label>
                        <input type="date" value="@currentCn.Date.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) currentCn.Date = d; })" class="input-class font-bold text-slate-800" disabled="@IsPosted" />
                    </div>

                    <div class="relative overflow-visible z-50">
                        <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Disbursement Bank Account Source <span class="text-rose-500">*</span></label>
                        <div @onclick="ToggleBankDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none @(IsPosted ? "bg-slate-50 opacity-60 cursor-not-allowed" : "")">
                            <span class="@(selectedBankGlId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">@selectedBankGlName</span>
                            @if (!IsPosted)
                            {
                                <svg class="w-4 h-4 text-slate-400 transition-transform @(isBankDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>

                        @if (isBankDropdownOpen && !IsPosted)
                        {
                            <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl p-3 space-y-3 z-[100] animate-in fade-in zoom-in-95 duration-100">
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                    </div>
                                    <input type="text" @bind="bankSearchQuery" @bind:event="oninput" class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 focus:bg-white transition-all font-medium text-slate-800" placeholder="Filter bank accounts..." @onclick:stopPropagation />
                                </div>
                                <div class="max-h-40 overflow-y-auto pr-1 divide-y divide-slate-50">
                                    @foreach (var bank in bankAccounts.Where(b => $"{b.AccountCode} {b.Description}".Contains(bankSearchQuery, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <div @onclick="() => SelectBankAccount(bank)" class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition-colors cursor-pointer">
                                            @bank.AccountCode - @bank.Description
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="space-y-2">
                        <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">
                            Internal Audit Reason <span class="text-rose-400">*</span>
                        </label>
                        <div class="relative">
                            <textarea @bind="currentCn.Reason"
                                      rows="4"
                                      class="w-full resize-none bg-slate-50 rounded-2xl px-4 py-3.5 text-sm font-medium text-slate-800 placeholder:text-slate-300
                            outline-none focus:bg-white focus:ring-2 focus:ring-slate-900/10 transition-all duration-200
                            disabled:opacity-50 disabled:cursor-not-allowed"
                                      placeholder="Provide operational reason description narrative..."
                                      disabled="@IsPosted">
                            </textarea>
                            @if (!IsPosted)
                            {
                                <div class="absolute bottom-3 right-3 text-[10px] font-bold text-slate-300 uppercase tracking-wider select-none">Reason</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-8 overflow-visible">
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col h-full">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Financial Valuation Allocation Summary</h3>
                        <span class="text-xs font-medium text-slate-500 bg-white px-3 py-1 rounded-full border border-slate-200 font-mono font-bold">Invoice Ref: @currentCn.SalesOrder?.OrderNumber</span>
                    </div>

                    <div class="p-6 space-y-6 flex-1 bg-white">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">

                            <div class="p-4 bg-slate-50 border border-slate-200/60 rounded-xl space-y-1">
                                <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Amount Paid (Real-Time Value)</div>
                                <div class="font-mono text-slate-800 space-y-0.5">
                                    <div class="text-lg font-bold">@realTimePaidInvoiceTotal.ToString("N2") <span class="text-xs text-slate-400 font-sans font-medium">@currentCn.Currency?.CurrencyCode</span></div>
                                    @if (currentCn.ExchangeRate > 1)
                                    {
                                        <div class="text-xs font-semibold text-slate-500">Base: @((realTimePaidInvoiceTotal * currentCn.ExchangeRate).ToString("N2"))</div>
                                    }
                                </div>
                            </div>

                            <div class="p-4 bg-emerald-50/40 border border-emerald-100 rounded-xl space-y-1">
                                <div class="text-[10px] font-extrabold text-emerald-600 uppercase tracking-wider">Remaining Refundable Capacity</div>
                                <div class="font-mono text-emerald-700 space-y-0.5">
                                    <div class="text-lg font-black">@maxAllowedRefundCapacity.ToString("N2") <span class="text-xs text-emerald-600/70 font-sans font-medium">@currentCn.Currency?.CurrencyCode</span></div>
                                    @if (currentCn.ExchangeRate > 1)
                                    {
                                        <div class="text-xs font-bold text-emerald-600">Base: @((maxAllowedRefundCapacity * currentCn.ExchangeRate).ToString("N2"))</div>
                                    }
                                </div>
                            </div>

                            @if (currentCn.ExchangeRate > 1)
                            {
                                <div class="p-4 bg-slate-50 border border-slate-200/60 rounded-xl space-y-1 animate-in zoom-in-95 duration-200">
                                    <div class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider">Historical Exchange Rate</div>
                                    <div class="text-lg font-mono font-bold text-slate-800 mt-0.5">@currentCn.ExchangeRate.ToString("N4")</div>
                                </div>
                            }
                        </div>

                        <div class="border border-slate-100 rounded-2xl p-5 bg-slate-50/30 space-y-4 max-w-xl">
                            <h4 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest border-b border-slate-100 pb-2">Voucher Allocation Controls</h4>

                            @if (currentCn.ExchangeRate == 1)
                            {
                                <div class="space-y-2">
                                    <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">
                                        Refund Amount Value
                                    </label>
                                    <div class="relative bg-slate-50 rounded-2xl focus-within:bg-white focus-within:ring-2 focus-within:ring-slate-900/10 transition-all duration-200">
                                        <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                                            <span class="text-xs font-black text-slate-300 font-mono uppercase tracking-wider">@currentCn.Currency?.CurrencyCode</span>
                                        </div>
                                        <input type="number" step="0.01" max="@maxAllowedRefundCapacity"
                                               value="@currentCn.TotalAmount"
                                               @oninput="CalculateFromForeignInput"
                                               disabled="@IsPosted"
                                               class="w-full bg-transparent pl-16 pr-4 py-3.5 font-mono font-black text-slate-900 text-right text-lg
                                        outline-none placeholder:text-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
                                               placeholder="0.00" />
                                    </div>
                                    <p class="text-[10px] text-slate-400 font-medium px-1">Max refundable: <span class="font-mono font-bold text-slate-600">@maxAllowedRefundCapacity.ToString("N2")</span></p>
                                </div>
                            }
                            else
                            {
                                <div class="space-y-3">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

                                        <div class="space-y-2">
                                            <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">
                                                Foreign Amount
                                            </label>
                                            <div class="relative bg-slate-50 rounded-2xl focus-within:bg-white focus-within:ring-2 focus-within:ring-slate-900/10 transition-all duration-200">
                                                <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                                                    <span class="text-[10px] font-black text-slate-300 font-mono uppercase tracking-wider">@currentCn.Currency?.CurrencyCode</span>
                                                </div>
                                                <input type="number" step="0.01"
                                                       value="@(currentCn.TotalAmount == 0 ? "" : currentCn.TotalAmount)"
                                                       @oninput="CalculateFromForeignInput"
                                                       disabled="@IsPosted"
                                                       class="w-full bg-transparent pl-16 pr-4 py-3.5 font-mono font-black text-slate-900 text-right text-lg
                                                outline-none placeholder:text-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
                                                       placeholder="0.00" />
                                            </div>
                                        </div>

                                        <div class="space-y-2">
                                            <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">
                                                Base Currency
                                            </label>
                                            <div class="relative bg-slate-50 rounded-2xl focus-within:bg-white focus-within:ring-2 focus-within:ring-slate-900/10 transition-all duration-200">
                                                <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                                                    <span class="text-[10px] font-black text-slate-300 font-mono uppercase tracking-wider">Base</span>
                                                </div>
                                                <input type="number" step="0.01"
                                                       value="@(baseCurrencyRefundDisplayValue == 0 ? "" : baseCurrencyRefundDisplayValue)"
                                                       @oninput="CalculateFromBaseInput"
                                                       disabled="@IsPosted"
                                                       class="w-full bg-transparent pl-14 pr-4 py-3.5 font-mono font-black text-slate-900 text-right text-lg
                                                outline-none placeholder:text-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
                                                       placeholder="0.00" />
                                            </div>
                                        </div>

                                    </div>

                                    <div class="flex items-center justify-between px-1">
                                        <p class="text-[10px] text-slate-400 font-medium">
                                            Max refundable: <span class="font-mono font-bold text-slate-600">@maxAllowedRefundCapacity.ToString("N2") @currentCn.Currency?.CurrencyCode</span>
                                        </p>
                                        <div class="flex items-center gap-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                            <span class="w-1 h-1 rounded-full bg-slate-300 inline-block"></span>
                                            Rate <span class="font-mono text-slate-600">@currentCn.ExchangeRate.ToString("N4")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="bg-slate-50 border-t border-slate-200 p-5 flex justify-between items-center mt-auto rounded-b-2xl gap-6">
                        <div class="text-xs font-bold text-slate-400 hover:text-slate-600 transition-colors uppercase tracking-wider"></div>
                        <div class="text-right">
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Total Outflow Impact (Foreign)</div>
                            <div class="text-2xl font-mono font-black text-rose-600">@currentCn.TotalAmount.ToString("N2") <span class="text-sm font-sans font-bold text-slate-400">@currentCn.Currency?.CurrencyCode</span></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private Guid companyId;
    private string currentUserId = "";
    private string currentUserName = "";

    private bool isFormOpen = false;
    private bool _loadingList = true;
    private bool _loadingInvoices = false;
    private bool _busy = false;

    // View 1 List state parameters
    private List<CreditNote> historicalRefunds = new();
    private string listSearchTerm = string.Empty;
    private int currentPage = 1;
    private int pageSize = 10;

    // View 2 & 3 Workspace form state profiles
    private CreditNote currentCn = new();
    private List<Customer> customers = new();
    private List<SalesOrder> paidInvoices = new();
    private List<SegChartOfAccount> bankAccounts = new();

    private Guid selectedCustomerId = Guid.Empty;
    private Guid selectedInvoiceId = Guid.Empty;
    private Guid selectedBankGlId = Guid.Empty;
    private SalesOrder? activeInvoiceRef;

    private decimal maxAllowedRefundCapacity = 0;
    private decimal realTimePaidInvoiceTotal = 0;
    private decimal baseCurrencyRefundDisplayValue = 0;
    private string focusedInputField = ""; // Locked options: "Foreign", "Base", or "" empty un-focused

    // Dropdown structural custom properties
    private bool isCustomerDropdownOpen = false;
    private string customerSearchQuery = string.Empty;
    private string selectedCustomerName = "-- Choose Target Customer Profile --";

    private bool isInvoiceDropdownOpen = false;
    private string invoiceSearchQuery = string.Empty;
    private string selectedInvoiceName = "-- Choose Settled Invoice Record --";

    private bool isBankDropdownOpen = false;
    private string bankSearchQuery = string.Empty;
    private string selectedBankGlName = "-- Search Bank Asset Account --";
    private string _errMsg = string.Empty;

    private bool IsListMode => Id == null && !isFormOpen;
    private bool IsNewInitialization => Id == null && isFormOpen;
    private bool IsPosted => currentCn.Status == CreditNoteStatus.Posted;

    private IEnumerable<CreditNote> FilteredRefunds => string.IsNullOrWhiteSpace(listSearchTerm)
        ? historicalRefunds
        : historicalRefunds.Where(c =>
            c.CreditNoteNumber.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase) ||
            (c.Customer != null && c.Customer.Name.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
            (c.SalesOrder != null && c.SalesOrder.OrderNumber.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<CreditNote> PaginatedRefunds => FilteredRefunds
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int TotalFilteredCount => FilteredRefunds.Count();
    private int TotalPages => (int)Math.Ceiling((double)TotalFilteredCount / pageSize);

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("CREDIT_NOTE_PAGE")) { Nav.NavigateTo("/access-denied"); return; }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user?.CompanyDetailsId == null) return;

        companyId = user.CompanyDetailsId.Value;
        currentUserId = user.Id;
        currentUserName = user.UserName ?? "ERP User";

        await LoadHistoricalRefundsLedger();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id.HasValue)
        {
            isFormOpen = true; _busy = true; StateHasChanged();
            await HydrateBankAccountsSelectorDeck();

            var cn = await CnService.GetByIdAsync(Id.Value, companyId);
            if (cn != null && cn.ReturnToStock == false)
            {
                currentCn = cn;
                selectedBankGlId = currentCn.WarehouseId ?? Guid.Empty;

                var matchingBank = bankAccounts.FirstOrDefault(b => b.Id == selectedBankGlId);
                selectedBankGlName = matchingBank != null ? $"{matchingBank.AccountCode} - {matchingBank.Description}" : "-- Search Bank Asset Account --";

                using var ctx = await DbFactory.CreateDbContextAsync();

                realTimePaidInvoiceTotal = await ctx.PaymentApplications
                                    .Where(pa => pa.InvoiceId == currentCn.SalesOrderId)
                                    .SumAsync(pa => pa.AppliedAmount + pa.CashDiscountTaken);

                decimal historicalRefundsVolume = await ctx.CreditNotes
                    .Where(x => x.SalesOrderId == currentCn.SalesOrderId && x.Id != currentCn.Id && x.Status == CreditNoteStatus.Posted && x.ReturnToStock == false)
                    .SumAsync(x => x.TotalAmount);

                maxAllowedRefundCapacity = realTimePaidInvoiceTotal - historicalRefundsVolume;
                activeInvoiceRef = await ctx.SalesOrders.AsNoTracking().FirstOrDefaultAsync(o => o.Id == currentCn.SalesOrderId);

                baseCurrencyRefundDisplayValue = Math.Round(currentCn.TotalAmount * currentCn.ExchangeRate, 2);

                // Initialize default locked input strategy based on pre-populated records
                focusedInputField = currentCn.TotalAmount > 0 ? "Foreign" : "";
            }
            else
            {
                Nav.NavigateTo("/sales/credit-notes/refund");
            }
            _busy = false; StateHasChanged();
        }
    }

    private async Task LoadHistoricalRefundsLedger()
    {
        _loadingList = true; StateHasChanged();
        using var ctx = await DbFactory.CreateDbContextAsync();

        historicalRefunds = await ctx.CreditNotes
            .Where(c => c.CompanyId == companyId && c.ReturnToStock == false)
            .Include(c => c.Customer).Include(c => c.Currency).Include(c => c.SalesOrder)
            .OrderByDescending(c => c.Date).AsNoTracking().ToListAsync();

        _loadingList = false; StateHasChanged();
    }

    private async Task HydrateBankAccountsSelectorDeck()
    {
        if (bankAccounts.Any()) return;
        var coaList = await SegCoaService.GetCoaAsync(companyId);
        var types = await SegCoaService.GetAccountTypesAsync();

        // Filters strictly by Account Type Id == 1 (Cash and Cash Equivalents Balance Sheet Debit)
        bankAccounts = coaList.Where(a =>
        {
            var t = types.FirstOrDefault(x => x.Id == a.SegAccountTypeId);
            return t != null && t.Id == 1 && t.IsBalanceSheet && t.IsDebit && a.IsActive;
        }).OrderBy(a => a.AccountCode).ToList();
    }

    private async Task OpenNewFormInitializer()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        customers = await ctx.Customers.AsNoTracking().Where(c => c.CompanyId == companyId).OrderBy(c => c.Name).ToListAsync();

        isFormOpen = true;
        selectedCustomerId = Guid.Empty;
        selectedInvoiceId = Guid.Empty;
        selectedCustomerName = "-- Choose Target Customer Profile --";
        selectedInvoiceName = "-- Choose Settled Invoice Record --";
    }

    private void NavigateToListView() => Nav.NavigateTo("/sales/credit-notes/refund", forceLoad: true);

    private void ToggleCustomerDropdown() => isCustomerDropdownOpen = !isCustomerDropdownOpen;
    private void ToggleInvoiceDropdown() => isInvoiceDropdownOpen = !isInvoiceDropdownOpen;
    private void ToggleBankDropdown() => isBankDropdownOpen = !isBankDropdownOpen;

    private async Task SelectCustomer(Customer cust)
    {
        selectedCustomerId = cust.Id;
        selectedCustomerName = cust.Name;
        isCustomerDropdownOpen = false;
        customerSearchQuery = string.Empty;

        selectedInvoiceId = Guid.Empty;
        selectedInvoiceName = "-- Choose Settled Invoice Record --";
        paidInvoices.Clear();

        _loadingInvoices = true; StateHasChanged();
        paidInvoices = await CnService.GetPaidInvoicesByCustomerAsync(companyId, selectedCustomerId);
        _loadingInvoices = false; StateHasChanged();
    }

    private void SelectInvoice(SalesOrder inv)
    {
        selectedInvoiceId = inv.Id;
        selectedInvoiceName = $"{inv.OrderNumber} (Real-Time Paid Bal: {inv.AmountPaid:N2})";
        isInvoiceDropdownOpen = false;
        invoiceSearchQuery = string.Empty;
    }

    private void SelectBankAccount(SegChartOfAccount bank)
    {
        selectedBankGlId = bank.Id;
        selectedBankGlName = $"{bank.AccountCode} - {bank.Description}";
        isBankDropdownOpen = false;
        bankSearchQuery = string.Empty;
    }

    private async Task InitializeDraftWorkspace()
    {
        if (selectedInvoiceId == Guid.Empty) return;
        _busy = true; _errMsg = string.Empty; StateHasChanged();
        try
        {
            var cn = await CnService.CreateFinancialRefundDraftAsync(selectedInvoiceId, Guid.Parse(currentUserId));
            Nav.NavigateTo($"/sales/credit-notes/refund/{cn.Id}");
        }
        catch (Exception ex) { _errMsg = ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private void ClearInvoiceSelection()
    {
        selectedInvoiceId = Guid.Empty;
        activeInvoiceRef = null;
        ClearInputValuesContext();
    }

    private void TrackActiveInputContext(string fieldKey)
    {
        if (currentCn.ExchangeRate > 1 && string.IsNullOrEmpty(focusedInputField))
            focusedInputField = fieldKey;
    }

    private void CalculateFromForeignInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal val) && val > 0)
        {
            currentCn.TotalAmount = val > maxAllowedRefundCapacity ? maxAllowedRefundCapacity : val;
            baseCurrencyRefundDisplayValue = Math.Round(currentCn.TotalAmount * currentCn.ExchangeRate, 2);
        }
        else
        {
            currentCn.TotalAmount = 0;
            baseCurrencyRefundDisplayValue = 0;
        }
        StateHasChanged();
    }

    private void CalculateFromBaseInput(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal baseVal) && baseVal > 0)
        {
            decimal maxBase = maxAllowedRefundCapacity * currentCn.ExchangeRate;
            baseCurrencyRefundDisplayValue = baseVal > maxBase ? Math.Round(maxBase, 2) : baseVal;
            currentCn.TotalAmount = currentCn.ExchangeRate > 0
                ? Math.Round(baseCurrencyRefundDisplayValue / currentCn.ExchangeRate, 4)
                : 0;
        }
        else
        {
            currentCn.TotalAmount = 0;
            baseCurrencyRefundDisplayValue = 0;
        }
        StateHasChanged();
    }

    private void ClearInputValuesContext()
    {
        currentCn.TotalAmount = 0;
        baseCurrencyRefundDisplayValue = 0;
        StateHasChanged();
    }
    private void RouteToTargetRefund(Guid id)
    {
        Nav.NavigateTo($"/sales/credit-notes/refund/{id}");
    }

    private async Task SaveDraftWorkspace()
    {
        if (selectedBankGlId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Validation Error: Bank asset routing configuration is mandatory."); return; }
        currentCn.WarehouseId = selectedBankGlId;
        var err = await CnService.SaveDraftAsync(currentCn);
        if (string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", "Refund draft workspace successfully saved.");
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task PostCashRefund()
    {
        if (selectedBankGlId == Guid.Empty || currentCn.TotalAmount <= 0) { await JS.InvokeVoidAsync("alert", "Fulfillment exception: Ensure valid Bank GL references and non-zero amounts are configured."); return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"Post financial reversal of {currentCn.TotalAmount:N2} onto general ledger profiles?")) return;

        _busy = true; StateHasChanged();
        currentCn.WarehouseId = selectedBankGlId;
        await CnService.SaveDraftAsync(currentCn);

        var err = await CnService.PostFinancialRefundDraftAsync(currentCn.Id, selectedBankGlId, Guid.Parse(currentUserId));
        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Voucher finalized and financial ledger balanced successfully!");
            NavigateToListView();
        }
        else await JS.InvokeVoidAsync("alert", $"Posting Rejected: {err}");
        _busy = false; StateHasChanged();
    }

    private async Task DeleteDraft()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Permanently clear this financial refund draft workflow?")) return;
        await CnService.DeleteDraftAsync(currentCn.Id);
        NavigateToListView();
    }

    private void GoToPreviousPage() { if (currentPage > 1) currentPage--; }
    private void GoToNextPage() { if (currentPage < TotalPages) currentPage++; }
}