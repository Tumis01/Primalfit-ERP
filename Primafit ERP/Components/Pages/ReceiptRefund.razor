@page "/sales/receipt-refunds/entry/{Id:guid?}"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject ReceiptRefundService RefundService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject TransactionMappingService MappingService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PermissionCacheService PermissionCache
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

@rendermode InteractiveServer

<div class="mx-auto max-w-[1400px] space-y-6 animate-in fade-in duration-500 text-slate-800 pb-16">

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">
                @(IsNew ? "Receipt Returns & Payout Refunds" : $"Voucher Window: {currentRefund.RefundNumber}")
            </h1>
            <div class="flex items-center gap-2 mt-1.5 flex-wrap">
                @if (!IsNew && currentRefund.SalesOrder != null)
                {
                    <span class="text-xs text-slate-400 font-mono font-bold">Linked Invoice: @currentRefund.SalesOrder.OrderNumber</span>
                }
                @if (!IsNew)
                {
                    <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider bg-indigo-50 text-indigo-700 border-indigo-200">
                        @currentRefund.RefundType.ToString()
                    </span>
                    <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider @(IsPosted ? "bg-emerald-50 text-emerald-700 border-emerald-200" : (IsRejected ? "bg-rose-50 text-rose-700 border-rose-200" : "bg-amber-50 text-amber-700 border-amber-200"))">
                        @(IsPosted ? "Posted" : (IsRejected ? "Returned for Correction" : "Pending GL Review"))
                    </span>
                }
            </div>
        </div>

        <div class="flex items-center justify-end gap-3 flex-wrap">
            @if (!IsNew)
            {
                @if (canConfigureRoute)
                {
                    <!-- Configure Route Button -->
                    <button type="button" @onclick="OpenRouteModal" class="px-4 py-2 bg-indigo-50 border border-indigo-200 text-indigo-700 font-bold text-sm rounded-xl hover:bg-indigo-100 transition-all shadow-sm flex items-center gap-1.5 active:scale-95">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <span>Configure Route</span>
                        @if (currentRefund.CustomTransactionTypeId.HasValue)
                        {
                            <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                        }
                    </button>
                }

                <button type="button" @onclick="ResetToDashboard" class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-sm text-slate-600 font-bold hover:bg-slate-50 transition-all shadow-sm">
                    Cancel &amp; Exit
                </button>
            }

            @if (!IsPosted && !IsNew)
            {
                <button type="button" @onclick="DeleteDraft" class="px-4 py-2 bg-white border border-rose-200 text-rose-600 text-sm font-bold rounded-xl hover:bg-rose-50 transition-all shadow-sm">
                    Discard Draft
                </button>
                <button type="button" @onclick="SaveDraft" class="px-4 py-2 bg-white border border-indigo-200 text-indigo-600 text-sm font-bold rounded-xl hover:bg-indigo-50 transition-all shadow-sm">
                    Save Progress
                </button>
                <button type="button" @onclick="PostRefund" disabled="@isBusy" class="px-5 py-2 bg-emerald-600 text-white rounded-xl text-sm font-bold hover:bg-emerald-700 shadow-md transition-all flex items-center gap-2 disabled:opacity-50">
                    @if (isBusy)
                    {
                        <span class="inline-block w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                    }
                    <span>Submit Voucher for GL Review</span>
                </button>
            }
        </div>
    </div>

    @if (IsRejected && !string.IsNullOrWhiteSpace(currentBatchRejectionReason))
    {
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl text-sm text-rose-800">
            <span class="font-bold uppercase tracking-wider">GL review rejection:</span> @currentBatchRejectionReason
        </div>
    }

    @if (IsNew)
    {
        <div class="flex bg-slate-100 p-1 rounded-xl w-fit">
            <button @onclick="() => dashboardTab = 0" class="px-5 py-2 rounded-lg text-sm font-bold transition-all @(dashboardTab == 0 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                Overview
            </button>
            <button @onclick="() => dashboardTab = 1" class="px-5 py-2 rounded-lg text-sm font-bold transition-all @(dashboardTab == 1 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                Issue Return Refund
            </button>
        </div>

        @if (dashboardTab == 0)
        {
            <div class="space-y-4 animate-in fade-in duration-300">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="relative w-full sm:w-80">
                        <input type="text" @bind="tableSearchTerm" @bind:event="oninput" placeholder="Search voucher #, invoice #, customer..."
                               class="w-full pl-4 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm outline-none focus:border-indigo-500 focus:bg-white transition-all font-medium" />
                    </div>
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider font-mono">Total Records: @FilteredRefunds.Count()</span>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left text-sm text-slate-900 min-w-[1000px]">
                            <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                                <tr>
                                    <th class="p-4">Voucher #</th>
                                    <th class="p-4">Date</th>
                                    <th class="p-4">Linked Invoice</th>
                                    <th class="p-4">Customer</th>
                                    <th class="p-4">Strategy</th>
                                    <th class="p-4 text-right">Cash Refunded</th>
                                    <th class="p-4 text-center">Status</th>
                                    <th class="p-4 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var rfd in PagedRefunds)
                                {
                                    var batchStatus = GetBatchStatus(rfd.GlBatchId, rfd.Status == ReceiptRefundStatus.Posted);
                                    bool isRejected = batchStatus == BatchStatus.Rejected;
                                    bool isPosted = batchStatus == BatchStatus.Posted;
                                    <tr class="hover:bg-slate-50/80 transition-all align-middle">
                                        <td class="p-4 font-mono font-bold text-indigo-700">@rfd.RefundNumber</td>
                                        <td class="p-4 font-mono text-slate-600 text-xs">@rfd.TransactionDateTime.ToString("dd MMM, yyyy HH:mm")</td>
                                        <td class="p-4 font-mono font-bold text-slate-700">@(rfd.SalesOrder?.OrderNumber ?? "N/A")</td>
                                        <td class="p-4 font-medium text-slate-900">@(rfd.Customer?.Name ?? "Unknown")</td>
                                        <td class="p-4 text-xs font-bold text-slate-500">
                                            <span class="px-2 py-0.5 bg-slate-100 rounded border border-slate-200">@rfd.RefundType.ToString()</span>
                                        </td>
                                        <td class="p-4 text-right font-mono font-black text-rose-600">@rfd.TotalAmount.ToString("N4")</td>
                                        <td class="p-4 text-center">
                                            @if (isPosted)
                                            {
                                                <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Posted</span>
                                            }
                                            else if (isRejected)
                                            {
                                                <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-2.5 py-1 text-[10px] font-bold text-rose-700 uppercase tracking-wider animate-pulse">Rejected - Edit Required</span>
                                            }
                                            else if (batchStatus == BatchStatus.Ready)
                                            {
                                                <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Pending GL Review</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">Draft</span>
                                            }
                                        </td>
                                        <td class="p-4 text-center">
                                            <button @onclick="() => LoadExistingRefund(rfd.Id)" class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-lg hover:bg-indigo-100 transition-colors shadow-sm">
                                                @(isRejected ? "Edit & Resubmit" : (isPosted ? "View" : "Edit"))
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!PagedRefunds.Any())
                                {
                                    <tr><td colspan="8" class="p-12 text-center text-slate-400 italic">No historical receipt return voucher records match parameters.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (FilteredRefunds.Any())
                    {
                        <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                            <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, FilteredRefunds.Count())) of @FilteredRefunds.Count() records
                            </div>
                            <div class="flex items-center gap-2">
                                <button @onclick="() => currentPage--" disabled="@(currentPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40 transition-colors shadow-sm">Previous</button>
                                <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm font-mono">Page @currentPage of @TotalPages</span>
                                <button @onclick="() => currentPage++" disabled="@(currentPage >= TotalPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40 transition-colors shadow-sm">Next</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm max-w-2xl mx-auto mt-6 space-y-6 overflow-visible relative animate-in zoom-in-95 duration-200">
                <div class="text-center space-y-1">
                    <h3 class="text-lg font-bold text-slate-900">Initialize Return / Refund Voucher</h3>
                    <p class="text-xs text-slate-400">Select parameters to open an un-mutated draft work session.</p>
                </div>

                <div class="relative overflow-visible">
                    <label class="label block text-[10px] font-extrabold text-slate-500 uppercase tracking-wider mb-1.5">Step 1: Choose Customer Account <span class="text-rose-500">*</span></label>
                    <div @onclick="ToggleCustomerDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none">
                        <span class="@(selectedCustomerId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">@selectedCustomerName</span>
                        <svg class="w-4 h-4 text-slate-400 transition-transform @(isCustomerDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                        </svg>
                    </div>
                    @if (isCustomerDropdownOpen)
                    {
                        <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl z-[100] p-3 space-y-3 animate-in fade-in zoom-in-95 duration-100">
                            <input type="text" @bind="customerSearchQuery" @bind:event="oninput"
                                   class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 focus:bg-white transition-all font-medium"
                                   placeholder="Type to look up customer..." @onclick:stopPropagation />
                            <div class="max-h-44 overflow-y-auto pr-1 divide-y divide-slate-50">
                                @foreach (var cust in customers.Where(c => c.Name.Contains(customerSearchQuery, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div @onclick="() => SelectCustomer(cust)" class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-900 rounded-lg transition-colors cursor-pointer">
                                        @cust.Name
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (selectedCustomerId != Guid.Empty)
                {
                    <div class="relative overflow-visible animate-in fade-in duration-300">
                        <label class="label block text-[10px] font-extrabold text-slate-500 uppercase tracking-wider mb-1.5">Step 2: Link to Invoiced Document <span class="text-rose-500">*</span></label>

                        <div @onclick="ToggleInvoiceDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none">
                            <span class="@(selectedInvoiceId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">
                                @selectedInvoiceNumberDisplay
                            </span>
                            <svg class="w-4 h-4 text-slate-400 transition-transform @(isInvoiceDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>

                        @if (isInvoiceDropdownOpen)
                        {
                            <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl z-[100] p-3 space-y-3 animate-in fade-in zoom-in-95 duration-100">
                                <input type="text" @bind="invoiceSearchQuery" @bind:event="oninput"
                                       class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 focus:bg-white transition-all font-medium"
                                       placeholder="Type invoice reference code to filter..." @onclick:stopPropagation />
                                <div class="max-h-44 overflow-y-auto pr-1 divide-y divide-slate-50">
                                    @foreach (var inv in FilteredInvoices)
                                    {
                                        <div @onclick="() => SelectInvoice(inv)" class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-900 rounded-lg transition-colors cursor-pointer">
                                            @inv.OrderNumber (Dated: @inv.TransactionDateTime.ToString("yyyy-MM-dd HH:mm"))
                                        </div>
                                    }
                                    @if (!FilteredInvoices.Any())
                                    {
                                        <div class="p-3 text-xs text-slate-400 italic text-center">No matching open invoices found.</div>
                                    }
                                </div>
                            </div>
                        }
                        @if (!eligibleInvoices.Any() && !isBusy)
                        {
                            <p class="text-xs text-rose-600 font-bold mt-2">⚠️ No records with items shipped or cash paid are open for return.</p>
                        }
                    </div>
                }

                @if (selectedInvoiceId != Guid.Empty)
                {
                    <div class="relative animate-in fade-in duration-300">
                        <label class="label block text-[10px] font-extrabold text-slate-500 uppercase tracking-wider mb-1.5">Step 3: Financial Reversal Strategy <span class="text-rose-500">*</span></label>
                        <select @bind="selectedRefundType" class="input-class font-bold bg-slate-50 focus:bg-white text-sm text-slate-900 cursor-pointer outline-none">
                            <option value="@ReceiptRefundType.Both">Quantity Return &amp; Cash Payout Refund (Both)</option>
                            <option value="@ReceiptRefundType.QuantityOnly">Quantity Stock Return Only (Balance on Account)</option>
                            <option value="@ReceiptRefundType.PaymentOnly">Pure Cash Payout Refund (Items Remain with Buyer)</option>
                        </select>
                    </div>
                }

                <button type="button" @onclick="InitializeDraft" disabled="@(isBusy || selectedInvoiceId == Guid.Empty)"
                        class="w-full px-6 py-3 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all disabled:opacity-40 flex items-center justify-center gap-2">
                    <span>Open Return Adjustment Workspace</span>
                </button>
            </div>
        }
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <div class="lg:col-span-4 space-y-5">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="font-extrabold text-xs text-slate-400 uppercase tracking-wider border-b border-slate-100 pb-2">Voucher Layout Properties</h3>

                    <div>
                        <label class="label">Refund Profile Context</label>
                        <span class="block px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-black text-xs uppercase text-indigo-700 font-mono tracking-wide">
                            @currentRefund.RefundType.ToString()
                        </span>
                    </div>

                    <div>
                        <label class="label">Adjustment Posting Date</label>
                        <input type="datetime-local" value="@currentRefund.TransactionDateTime.ToString("yyyy-MM-ddTHH:mm")" @onchange="OnDateChanged" class="input-class font-bold" disabled="@IsPosted" />
                    </div>

                    <div>
                        <label class="label">Reason Notes / Narrative</label>
                        <textarea @bind="currentRefund.Reason" class="input-class h-20 text-sm font-medium resize-none"
                                  placeholder="State reasons for inventory rollback or payment return..." disabled="@IsPosted"></textarea>
                    </div>

                    @if (currentRefund.RefundType == ReceiptRefundType.QuantityOnly || currentRefund.RefundType == ReceiptRefundType.Both)
                    {
                        <div class="animate-in fade-in duration-300">
                            <label class="label">Receiving Warehouse Destination</label>
                            <select @bind="currentRefund.DestinationWarehouseId" class="input-class font-bold text-sm bg-white" disabled="@IsPosted">
                                <option value="">-- Choose Target Storehouse --</option>
                                @foreach (var w in warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    @if (currentRefund.RefundType == ReceiptRefundType.PaymentOnly || currentRefund.RefundType == ReceiptRefundType.Both)
                    {
                        <div class="pt-2 space-y-3">
                            <div>
                                <label class="block text-[10px] font-extrabold text-slate-500 uppercase tracking-wider mb-1.5">
                                    Disbursing Bank Account
                                </label>
                                <select @bind="currentRefund.BankAccountId"
                                        class="w-full rounded-xl border border-slate-200 bg-white text-slate-900 px-3 py-2 text-sm font-bold outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 transition-all cursor-pointer disabled:bg-slate-50 disabled:text-slate-400 disabled:cursor-not-allowed"
                                        disabled="@IsPosted">
                                    <option value="" class="text-slate-400">-- Select Cash / Bank COA --</option>
                                    @foreach (var bank in bankAccounts)
                                    {
                                        <option value="@bank.Id">@bank.AccountCode - @bank.Description</option>
                                    }
                                </select>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="lg:col-span-8 space-y-5">
                @if (currentRefund.RefundType == ReceiptRefundType.QuantityOnly || currentRefund.RefundType == ReceiptRefundType.Both)
                {
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden animate-in fade-in duration-300">
                        <div class="p-5 bg-gradient-to-r from-emerald-50 to-white border-b border-emerald-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-emerald-100 border border-emerald-200 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-4 h-4 text-emerald-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10" />
                                    </svg>
                                </div>
                                <div>
                                    <h3 class="text-sm font-black text-slate-900 uppercase tracking-wider">Stock Return Grid</h3>
                                    <p class="text-[10px] text-slate-400 font-medium mt-0.5">Enter quantities to return to inventory. Cannot exceed shipped ceiling.</p>
                                </div>
                            </div>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-sm whitespace-nowrap min-w-[640px]">
                                <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                                    <tr>
                                        <th class="p-4 pl-6 w-[28%]">Item Name</th>
                                        <th class="p-4 text-center">UOM</th>
                                        <th class="p-4 text-center">Unit Price</th>
                                        <th class="p-4 text-center bg-amber-50/40 text-amber-700">Total Shipped</th>
                                        <th class="p-4 text-center bg-rose-50/40 text-rose-700">Max Returnable</th>
                                        <th class="p-4 text-center w-32">Return Qty</th>
                                        <th class="p-4 text-right pr-6">Return Value</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in currentRefund.Lines)
                                    {
                                        bool atMax = line.Quantity >= line.MaxAdjustableQty && line.MaxAdjustableQty > 0;
                                        <tr class="hover:bg-slate-50/60 transition-colors align-middle @(atMax ? "bg-rose-50/30" : "")">
                                            <td class="p-4 pl-6">
                                                <div class="font-bold text-slate-800">@(line.Item?.Name ?? "Unknown Item")</div>
                                                <div class="text-[10px] text-slate-400 font-mono mt-0.5">@(line.Item?.SKU ?? "")</div>
                                            </td>
                                            <td class="p-4 text-center">
                                                <select value="@line.UomId" @onchange="@(e => OnLineUomChanged(line, e))" disabled="@IsPosted" class="input-class py-1.5 text-xs font-semibold">
                                                    @foreach (var uom in GetItemUoms(line.Item))
                                                    {
                                                        <option value="@uom.Id">@GetUomOptionLabel(line.Item, uom)</option>
                                                    }
                                                </select>
                                                <div class="mt-1 text-[10px] text-slate-400">@GetUomConversionText(line)</div>
                                            </td>
                                            <td class="p-4 text-center font-mono text-slate-500 text-xs">@GetDisplayedUnitPrice(line).ToString("N4")</td>
