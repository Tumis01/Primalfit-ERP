@code {
    [Parameter] public Guid? Id { get; set; }

    private Primafit_ERP.Components.Models.ReceiptRefund currentRefund = new();
    private List<Customer> customers = new();
    private List<SalesOrder> eligibleInvoices = new();
    private List<Warehouse> warehouses = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegChartOfAccount> allAccounts = new();
    private List<Primafit_ERP.Components.Models.ReceiptRefund> allHistoricalRefunds = new();

    // Route Configuration Modal State
    private bool showRouteModal = false;
    private List<CustomTransactionType> customTemplates = new();
    private Guid defaultArAccountId = Guid.Empty;
    private Guid defaultInventoryAssetAccountId = Guid.Empty;
    private Guid defaultCogsAccountId = Guid.Empty;

    // Dashboard / pagination
    private int dashboardTab = 0;
    private int pageSize = 10;
    private int currentPage = 1;
    private string tableSearchTerm = string.Empty;
    private string invoiceSearchQuery = string.Empty;

    private Guid selectedCustomerId = Guid.Empty;
    private Guid selectedInvoiceId = Guid.Empty;
    private ReceiptRefundType selectedRefundType = ReceiptRefundType.Both;

    private bool isCustomerDropdownOpen = false;
    private bool isInvoiceDropdownOpen = false;
    private string customerSearchQuery = string.Empty;
    private string selectedCustomerName = "-- Click to Search Customer Directory --";
    private string selectedInvoiceNumberDisplay = "-- Choose Eligible Source Invoice --";
    private string currencyCode = "Base";
    private List<UnitOfMeasure> uoms = new();
    private List<ItemUomConversionLine> itemUomLines = new();
    private List<UomConversionRule> conversionRules = new();
    private IReadOnlyDictionary<(Guid From, Guid To), decimal> ConversionMap =>
        conversionRules.ToDictionary(x => (x.FromUomId, x.ToUomId), x => x.ConversionFactor);

    private bool isBusy = false;
    private string _errMsg = string.Empty;

    private bool IsNew => Id == null;
    private BatchStatus? currentBatchStatus;
    private string? currentBatchRejectionReason;
    private Dictionary<Guid, BatchStatus> batchStatuses = new();
    private bool IsRejected => currentBatchStatus == BatchStatus.Rejected;
    private bool IsPosted => currentRefund.Status == ReceiptRefundStatus.Posted
        && currentBatchStatus != BatchStatus.Ready
        && currentBatchStatus != BatchStatus.Rejected
        && currentBatchStatus != BatchStatus.Draft;

    private BatchStatus GetBatchStatus(Guid? batchId, bool legacyPosted) =>
        batchId.HasValue && batchStatuses.TryGetValue(batchId.Value, out var status)
            ? status
            : (legacyPosted ? BatchStatus.Posted : BatchStatus.Draft);
    private bool canConfigureRoute = false;

    private CashRefundSummaryDto cashSummary = new();

    private IEnumerable<SalesOrder> FilteredInvoices => eligibleInvoices
        .Where(i => string.IsNullOrWhiteSpace(invoiceSearchQuery) || i.OrderNumber.Contains(invoiceSearchQuery, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Primafit_ERP.Components.Models.ReceiptRefund> FilteredRefunds => allHistoricalRefunds
        .Where(r => string.IsNullOrWhiteSpace(tableSearchTerm)
                 || r.RefundNumber.Contains(tableSearchTerm, StringComparison.OrdinalIgnoreCase)
                 || (r.SalesOrder != null && r.SalesOrder.OrderNumber.Contains(tableSearchTerm, StringComparison.OrdinalIgnoreCase))
                 || (r.Customer != null && r.Customer.Name.Contains(tableSearchTerm, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(r => r.Date);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRefunds.Count() / (double)pageSize));

    private IEnumerable<Primafit_ERP.Components.Models.ReceiptRefund> PagedRefunds => FilteredRefunds
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private string currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("AR_PAYMENT_PAGE")) { Nav.NavigateTo("/access-denied"); return; }
        await ReloadRegistryStateAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNew)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            isBusy = true;

            var record = await RefundService.GetByIdAsync(Id.Value, user.CompanyDetailsId ?? Guid.Empty);
            if (record != null)
            {
                currentRefund = record;
                foreach (var line in currentRefund.Lines)
                {
                    var item = line.Item;
                    if (item == null) continue;
                    line.UomId ??= item.UomId;
                    if (string.IsNullOrWhiteSpace(line.UomName)) line.UomName = uoms.FirstOrDefault(x => x.Id == line.UomId)?.Name ?? item.UoM;
                    if (line.UomConversionFactor <= 0) line.UomConversionFactor = GetItemFactor(item, line.UomId);
                }
                await using var ctx = await DbFactory.CreateDbContextAsync();
                var batch = record.GlBatchId.HasValue
                    ? await ctx.GLBatches.AsNoTracking().FirstOrDefaultAsync(b => b.Id == record.GlBatchId.Value && b.CompanyId == record.CompanyId)
                    : null;
                currentBatchStatus = batch?.Status;
                currentBatchRejectionReason = batch?.RejectionReason;
                currencyCode = record.Currency?.CurrencyCode ?? "Base";

                var customer = customers.FirstOrDefault(c => c.Id == currentRefund.CustomerId);
                defaultArAccountId = customer?.ReceivablesAccountId ?? Guid.Empty;

                if (record.RefundType == ReceiptRefundType.PaymentOnly || record.RefundType == ReceiptRefundType.Both)
                {
                    var dto = await RefundService.GetCashRefundSummaryAsync(record.SalesOrderId, record.Id);
                    cashSummary.TotalPaid = dto.TotalPaid;
                    cashSummary.PriorCashRefunded = dto.PriorCashRefunded;
                    cashSummary.MaxRefundable = dto.MaxRefundable;
                }
            }
            else Nav.NavigateTo("/sales/receipt-refunds/entry");

            isBusy = false;
        }
    }

    private async Task ReloadRegistryStateAsync()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user?.CompanyDetailsId == null) return;

        currentUserId = user.Id;
        Guid companyId = user.CompanyDetailsId.Value;

        canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(companyId);
        warehouses = await ctx.Warehouses.AsNoTracking().Where(w => w.CompanyId == companyId).ToListAsync();
        customers = await ctx.Customers.AsNoTracking().Where(c => c.CompanyId == companyId).OrderBy(c => c.Name).ToListAsync();
        uoms = await MasterService.GetUnitOfMeasuresAsync(companyId);
        itemUomLines = await MasterService.GetItemUomConversionLinesAsync(companyId, true);
        conversionRules = await MasterService.GetUomConversionRulesAsync(companyId);

        var accountTypes = await SegCoaService.GetAccountTypesAsync();
        allAccounts = await SegCoaService.GetCoaAsync(companyId);

        bankAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.Description.Trim().Equals("Cash and Cash Equivalents", StringComparison.OrdinalIgnoreCase) && type.IsBalanceSheet && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        defaultInventoryAssetAccountId = await MappingService.GetMappedAccountAsync(
            companyId, SystemTransactionType.ReceiptRefundStock, isDebit: true, defaultAccountId: Guid.Empty);

        defaultCogsAccountId = await MappingService.GetMappedAccountAsync(
            companyId, SystemTransactionType.ReceiptRefundStock, isDebit: false, defaultAccountId: Guid.Empty);

        defaultArAccountId = await MappingService.GetMappedAccountAsync(
            companyId, SystemTransactionType.ReceiptRefundCash, isDebit: true, defaultAccountId: Guid.Empty);

        allHistoricalRefunds = await ctx.ReceiptRefunds
            .Include(r => r.Customer)
            .Include(r => r.SalesOrder)
            .Where(r => r.CompanyId == companyId)
            .ToListAsync();
        batchStatuses = await ctx.GLBatches
            .Where(b => b.CompanyId == companyId)
            .ToDictionaryAsync(b => b.Id, b => b.Status);
    }

    private void ToggleCustomerDropdown() => isCustomerDropdownOpen = !isCustomerDropdownOpen;
    private void ToggleInvoiceDropdown() => isInvoiceDropdownOpen = !isInvoiceDropdownOpen;

    private async Task SelectCustomer(Customer cust)
    {
        selectedCustomerId = cust.Id;
        selectedCustomerName = cust.Name;
        isCustomerDropdownOpen = false;
        customerSearchQuery = string.Empty;
        invoiceSearchQuery = string.Empty;
        selectedInvoiceId = Guid.Empty;
        selectedInvoiceNumberDisplay = "-- Choose Eligible Source Invoice --";
        eligibleInvoices.Clear();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        isBusy = true; StateHasChanged();
        eligibleInvoices = await RefundService.GetInvoicesEligibleForRefundAsync(user.CompanyDetailsId.Value, selectedCustomerId);
        isBusy = false; StateHasChanged();
    }

    private void SelectInvoice(SalesOrder inv)
    {
        selectedInvoiceId = inv.Id;
        selectedInvoiceNumberDisplay = inv.OrderNumber;
        isInvoiceDropdownOpen = false;
        invoiceSearchQuery = string.Empty;
        StateHasChanged();
