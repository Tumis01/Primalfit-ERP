@page "/reports/stock-by-uom"
@using System.IO
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Services
@using PrimafitERP.Data

@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject CompanyApiService CompanyService
@inject ReportExportService ExportService
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 mt-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Stock at Hand by UOM</h1>
            <p class="text-sm text-slate-500 mt-1">View stock in its primary UOM and the active conversion UOMs currently attached to each item.</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
            <button @onclick="DownloadPdf" disabled="@(isExportingPdf || isExportingExcel || !groups.Any())" class="px-4 py-2 bg-rose-50 text-rose-700 border border-rose-200 font-bold text-xs rounded-xl hover:bg-rose-100 transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                @if (isExportingPdf)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-rose-700 border-t-transparent rounded-full"></span>
                    <span>Wait...</span>
                }
                else
                {
                    <span>PDF</span>
                }
            </button>
            <button @onclick="DownloadExcel" disabled="@(isExportingPdf || isExportingExcel || !groups.Any())" class="px-4 py-2 bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold text-xs rounded-xl hover:bg-emerald-100 transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                @if (isExportingExcel)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-emerald-700 border-t-transparent rounded-full"></span>
                    <span>Wait...</span>
                }
                else
                {
                    <span>Excel</span>
                }
            </button>
            <div class="px-4 py-2 bg-emerald-50 rounded-xl border border-emerald-100 text-right">
                <div class="text-[10px] font-bold text-emerald-600 uppercase">Total Stock Value</div>
                <div class="text-lg font-mono font-bold text-emerald-700">@totalStockValue.ToString("N4")</div>
            </div>
        </div>
    </div>

    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-wrap gap-4 items-end">
        <div>
            <label class="label text-xs font-bold text-slate-500 uppercase tracking-wide mb-1 block">Warehouse</label>
            <select @bind="SelectedWarehouseId" class="border border-slate-200 rounded-lg px-3 py-2 text-sm w-72 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100">
                <option value="">All warehouses</option>
                @foreach (var warehouse in warehouses)
                {
                    <option value="@warehouse.Id">@warehouse.Name</option>
                }
            </select>
        </div>
        <button @onclick="ApplyFilters" disabled="@isLoading" class="px-6 py-2 bg-indigo-600 text-white font-bold text-sm rounded-lg hover:bg-indigo-700 transition-colors shadow-sm active:scale-95 disabled:opacity-50">
            Apply Filter
        </button>
        <div class="text-xs text-slate-500 pb-2">Choose a warehouse or view stock across all warehouses.</div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading stock valuation...</div>
    }
    else if (!groups.Any())
    {
        <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-16 text-center text-slate-400">No stock on hand was found for the selected warehouse.</div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 text-xs text-slate-500">
                Items are grouped by warehouse. Each primary UOM row is followed by the active item-specific conversion UOMs. Stock value is shown on the primary row only.
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="p-4">Item</th>
                            <th class="p-4">UOM</th>
                            <th class="p-4 text-right">Qty</th>
                            <th class="p-4 text-right">Unit Cost</th>
                            <th class="p-4 text-right">Stock Value</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var warehouseGroup in groups.GroupBy(x => x.WarehouseName))
                        {
                            <tr class="bg-indigo-50/70 border-t-2 border-indigo-100">
                                <td colspan="5" class="p-3 text-sm font-black uppercase tracking-wide text-indigo-800">
                                    Warehouse: @warehouseGroup.Key
                                </td>
                            </tr>
                            @foreach (var group in warehouseGroup)
                            {
                                <tr class="hover:bg-indigo-50/30 transition-colors">
                                    <td class="p-4 font-bold text-slate-900">
                                        @group.ItemName
                                        <span class="text-xs font-mono font-normal text-slate-500 ml-2">@group.Sku</span>
                                    </td>
                                    <td class="p-4 font-bold text-indigo-700">@group.Primary.UomName</td>
                                    <td class="p-4 text-right font-mono font-bold text-slate-800">@group.Primary.Quantity.ToString("N4")</td>
                                    <td class="p-4 text-right font-mono text-slate-600">@group.Primary.UnitCost.ToString("N4")</td>
                                    <td class="p-4 text-right font-mono font-bold text-emerald-700">@group.StockValue.ToString("N4")</td>
                                </tr>
                                @foreach (var conversion in group.OffsetUoms)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors text-sm">
                                        <td class="p-4 pl-8 text-slate-400">-</td>
                                        <td class="p-4 pl-8 font-semibold text-slate-600">@conversion.UomName</td>
                                        <td class="p-4 text-right font-mono text-slate-700">@conversion.Quantity.ToString("N4")</td>
                                        <td class="p-4 text-right font-mono text-slate-600">@conversion.UnitCost.ToString("N4")</td>
                                        <td class="p-4 text-right font-mono text-slate-400">-</td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private Guid companyId;
    private string companyName = "Primalfit Group";
    private string currentUserName = "System User";
    private bool isLoading = true;
    private bool isExportingPdf;
    private bool isExportingExcel;
    private Guid? selectedWarehouseId;
    private List<WarehouseOption> warehouses = new();
    private List<StockUomGroup> groups = new();
    private decimal totalStockValue;

    private string SelectedWarehouseId
    {
        get => selectedWarehouseId?.ToString() ?? string.Empty;
        set => selectedWarehouseId = Guid.TryParse(value, out var id) ? id : null;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("INVENTORY_REPORTS_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        try
        {
            var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
            if (user?.CompanyDetailsId != null)
            {
                companyId = user.CompanyDetailsId.Value;
                currentUserName = user.UserName ?? user.Email ?? currentUserName;
                var company = await CompanyService.GetCompanyByIdAsync(companyId);
                if (company != null && !string.IsNullOrWhiteSpace(company.CompanyName))
                    companyName = company.CompanyName;

                await LoadReportAsync();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        try
        {
            await LoadReportAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadReportAsync()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();

        warehouses = await ctx.Warehouses
            .AsNoTracking()
            .Where(x => x.CompanyId == companyId)
            .OrderBy(x => x.Name)
            .Select(x => new WarehouseOption(x.Id, x.Name))
            .ToListAsync();

        var items = await ctx.Items
            .AsNoTracking()
            .Include(x => x.PrimaryUom)
            .Where(x => x.CompanyId == companyId && !x.IsService)
            .ToDictionaryAsync(x => x.Id);
        var stockItemIds = items.Keys.ToList();
        var uoms = await ctx.UnitOfMeasures
            .AsNoTracking()
            .Where(x => x.CompanyId == companyId)
            .ToDictionaryAsync(x => x.Id, x => x.Name);
        var itemLines = await ctx.ItemUomConversionLines
            .AsNoTracking()
            .Include(x => x.Uom)
            .Where(x => x.IsActive &&
                        stockItemIds.Contains(x.ItemId))
            .ToListAsync();
        var itemLinesByItemId = itemLines
            .GroupBy(x => x.ItemId)
            .ToDictionary(x => x.Key, x => x.ToList());
        var warehouseMap = warehouses.ToDictionary(x => x.Id, x => x.Name);

        var stockQuery = ctx.StockLedgers
            .AsNoTracking()
            .Where(x => x.CompanyId == companyId);
        if (selectedWarehouseId.HasValue)
            stockQuery = stockQuery.Where(x => x.WarehouseId == selectedWarehouseId.Value);

        var stock = await stockQuery
            .GroupBy(x => new { x.ItemId, x.WarehouseId })
            .Select(g => new
            {
                ItemId = g.Key.ItemId,
                WarehouseId = g.Key.WarehouseId,
                Quantity = g.Sum(x => x.QuantityChanged)
            })
            .Where(x => x.Quantity != 0)
            .ToListAsync();

        totalStockValue = 0m;
        groups = new List<StockUomGroup>();

        foreach (var position in stock.OrderBy(x => x.WarehouseId).ThenBy(x => x.ItemId))
        {
            if (!items.TryGetValue(position.ItemId, out var item)) continue;

            var itemConversions = itemLinesByItemId.GetValueOrDefault(item.Id) ?? new List<ItemUomConversionLine>();
            var options = GetUomOptions(item, itemConversions, uoms).ToList();
            if (!options.Any())
                options.Add(new UomOption(Guid.Empty, string.IsNullOrWhiteSpace(item.UoM) ? "Primary" : item.UoM, 1m, true));

            // CurrentDisplayCost resolves WACC, standard, user-specified, and
            // most-recent costing according to the item's configured method.
            var baseUnitCost = item.CurrentDisplayCost;
            var stockValue = position.Quantity * baseUnitCost;
            totalStockValue += stockValue;

            var lines = options.Select(option => new StockUomLine
            {
                UomName = option.Name,
                Quantity = UomConversion.FromBase(position.Quantity, option.SelectedToPrimaryFactor),
                UnitCost = UomConversion.PriceFromBase(baseUnitCost, option.SelectedToPrimaryFactor),
                IsPrimary = option.IsPrimary
            }).ToList();

            var primary = lines.FirstOrDefault(x => x.IsPrimary) ?? lines[0];
            groups.Add(new StockUomGroup
            {
                ItemName = item.Name,
                Sku = item.SKU,
                WarehouseName = warehouseMap.GetValueOrDefault(position.WarehouseId, "Unknown"),
                Primary = primary,
                OffsetUoms = lines.Where(x => !x.IsPrimary).ToList(),
                StockValue = stockValue
            });
        }

        groups = groups
            .OrderBy(x => x.WarehouseName)
            .ThenBy(x => x.ItemName)
            .ToList();
    }

    private static IEnumerable<UomOption> GetUomOptions(
        Item item,
        IEnumerable<ItemUomConversionLine> itemConversions,
        IReadOnlyDictionary<Guid, string> uoms)
    {
        var options = new List<UomOption>();
        var seen = new HashSet<Guid>();
        var primaryUomId = item.UomId;

        // Older item records may have a primary UOM name but no UomId. Resolve
        // that name so the primary row and its attached offset UOM rows can
        // still be reported together.
        if (!primaryUomId.HasValue && !string.IsNullOrWhiteSpace(item.UoM))
        {
            primaryUomId = uoms.FirstOrDefault(x =>
                string.Equals(x.Value, item.UoM, StringComparison.OrdinalIgnoreCase)).Key;
            if (primaryUomId == Guid.Empty) primaryUomId = null;
        }

        if (primaryUomId.HasValue)
        {
            seen.Add(primaryUomId.Value);
            options.Add(new UomOption(
                primaryUomId.Value,
                uoms.GetValueOrDefault(primaryUomId.Value, item.PrimaryUom?.Name ?? item.UoM),
                1m,
                true));
        }
        else
        {
            options.Add(new UomOption(Guid.Empty,
                string.IsNullOrWhiteSpace(item.UoM) ? "Primary" : item.UoM,
                1m,
                true));
        }

        // Offset/conversion rows come only from the active item setup lines.
        // Global conversion rules and the legacy alternate-UOM fields are not
        // report sources because they do not represent UOMs currently attached
        // to this specific item.
        var configuredLines = itemConversions
            .Where(x => x.IsActive &&
                        x.ItemId == item.Id &&
                        (!primaryUomId.HasValue || x.UomId != primaryUomId.Value) &&
                        x.ConversionFactorToBase > 0)
            .OrderBy(x => x.Uom?.Name)
            .ToList();

        foreach (var line in configuredLines)
        {
            if (!seen.Add(line.UomId)) continue;
            options.Add(new UomOption(
                line.UomId,
                line.Uom?.Name ?? uoms.GetValueOrDefault(line.UomId, "UOM"),
                1m / UomConversion.NormalizeFactor(line.ConversionFactorToBase),
                false));
        }

        return options;
    }

    private StandardReportData BuildExportData()
    {
        var warehouseLabel = selectedWarehouseId.HasValue
            ? warehouses.FirstOrDefault(x => x.Id == selectedWarehouseId.Value)?.Name ?? "Selected warehouse"
            : "All warehouses";

        var exportRows = new List<List<string>>();
        string? lastWarehouse = null;
        foreach (var group in groups)
        {
            if (!string.Equals(lastWarehouse, group.WarehouseName, StringComparison.Ordinal))
            {
                exportRows.Add(new List<string>
                {
                    $"Warehouse: {group.WarehouseName}",
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    string.Empty,
                    string.Empty
                });
                lastWarehouse = group.WarehouseName;
            }

            exportRows.Add(new List<string>
            {
                group.WarehouseName,
                group.ItemName,
                group.Sku,
                group.Primary.UomName,
                group.Primary.Quantity.ToString("N4"),
                group.Primary.UnitCost.ToString("N4"),
                group.StockValue.ToString("N4")
            });

            foreach (var conversion in group.OffsetUoms)
            {
                exportRows.Add(new List<string>
                {
                    "-",
                    string.Empty,
                    string.Empty,
                    conversion.UomName,
                    conversion.Quantity.ToString("N4"),
                    conversion.UnitCost.ToString("N4"),
                    string.Empty
                });
            }
        }

        return new StandardReportData
        {
            ReportName = "Stock at Hand by UOM",
            CompanyName = companyName,
            ReportingPeriod = $"Warehouse: {warehouseLabel}",
            GeneratedBy = currentUserName,
            Headers = new List<string> { "Warehouse", "Item", "SKU", "UOM", "Qty", "Unit Cost", "Stock Value" },
            Rows = exportRows
        };
    }

    private async Task DownloadPdf()
    {
        if (!groups.Any() || isExportingPdf || isExportingExcel) return;
        isExportingPdf = true;
        try
        {
            var bytes = await Task.Run(() => ExportService.GeneratePdf(BuildExportData()));
            using var streamRef = new DotNetStreamReference(new MemoryStream(bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Stock_By_UOM_{DateTime.Now:yyyyMMdd_HHmm}.pdf", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExportingPdf = false;
        }
    }

    private async Task DownloadExcel()
    {
        if (!groups.Any() || isExportingPdf || isExportingExcel) return;
        isExportingExcel = true;
        try
        {
            var bytes = await Task.Run(() => ExportService.GenerateExcel(BuildExportData()));
            using var streamRef = new DotNetStreamReference(new MemoryStream(bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", $"Stock_By_UOM_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExportingExcel = false;
        }
    }

    private sealed record WarehouseOption(Guid Id, string Name);
    private sealed record UomOption(Guid Id, string Name, decimal SelectedToPrimaryFactor, bool IsPrimary);

    private sealed class StockUomGroup
    {
        public string ItemName { get; set; } = string.Empty;
        public string Sku { get; set; } = string.Empty;
        public string WarehouseName { get; set; } = string.Empty;
        public StockUomLine Primary { get; set; } = new();
        public List<StockUomLine> OffsetUoms { get; set; } = new();
        public decimal StockValue { get; set; }
    }

    private sealed class StockUomLine
    {
        public string UomName { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
        public decimal UnitCost { get; set; }
        public bool IsPrimary { get; set; }
    }
}
