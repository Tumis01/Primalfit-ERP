</style>

@code {
    [Parameter] public Guid? Id { get; set; }

    private Guid currentCompanyId = Guid.Empty;
    private string currentUserId = "";
    private string companyBaseCurrency = "BASE";
    private bool isLoading = true;
    private bool isBusy = false;
    private bool isCreateMode = false;
    private bool _loadingOrders = false;
    private string _errMsg = string.Empty;

    private Guid selectedVendorId = Guid.Empty;
    private Guid selectedOrderId = Guid.Empty;
    private VendorReturnType selectedReturnType = VendorReturnType.QuantityOnly;

    private VendorReturn? currentReturn;
    private List<VendorReturn> allReturns = new();
    private List<PurchaseOrder> eligibleOrders = new();
    private List<Vendor> vendors = new();
    private List<Warehouse> warehouses = new();
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();

    // Route Configuration Modal State
    private bool showRouteModal = false;
    private List<CustomTransactionType> customTemplates = new();
    private Guid defaultGrIrAccountId = Guid.Empty;
    private Guid defaultInventoryAssetAccountId = Guid.Empty;
    private Guid defaultApAccountId = Guid.Empty;

    private CashRefundSummaryDto cashSummary = new();

    private int pageSize = 15;
    private int currentPage = 1;
    private string listSearchTerm = "";

    // View State Selectors
    private bool IsListMode => !Id.HasValue && !isCreateMode && currentReturn == null;
    private bool IsNewInitialization => isCreateMode && currentReturn == null;
    private bool IsPosted => currentReturn?.Status == VendorReturnStatus.Posted;

    private IEnumerable<VendorReturn> FilteredReturns => allReturns
        .Where(d => string.IsNullOrWhiteSpace(listSearchTerm)
                 || d.ReturnNumber.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)
                 || (d.Vendor?.Name != null && d.Vendor.Name.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase))
                 || (d.PurchaseOrder?.OrderNumber != null && d.PurchaseOrder.OrderNumber.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)));

    private int TotalFilteredCount => FilteredReturns.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFilteredCount / (double)pageSize));
    private IEnumerable<VendorReturn> PaginatedReturns => FilteredReturns.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;

            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null)
            {
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }

            vendors = await MasterService.GetVendorsAsync(currentCompanyId);
            warehouses = await WhService.GetWarehousesAsync(currentCompanyId);

            var accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

            bankAccounts = allAccounts.Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.IsBalanceSheet == true && type.IsDebit == true && a.IsActive;
            }).OrderBy(x => x.AccountCode).ToList();

            defaultInventoryAssetAccountId = await MappingService.GetMappedAccountAsync(
                currentCompanyId, SystemTransactionType.VendorReturnStock, isDebit: false, defaultAccountId: Guid.Empty);

            defaultApAccountId = await MappingService.GetMappedAccountAsync(
                currentCompanyId, SystemTransactionType.VendorReturnStock, isDebit: true, defaultAccountId: Guid.Empty);

            await LoadListGrid();

            if (Id.HasValue)
            {
                await LoadExistingReturn(Id.Value);
            }
        }
        isLoading = false;
    }

    private async Task LoadListGrid()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        allReturns = await ctx.VendorReturns
            .AsNoTracking()
            .Include(d => d.Vendor)
            .Include(d => d.PurchaseOrder)
            .Include(d => d.Currency)
            .Include(d => d.Lines)
            .Where(d => d.CompanyId == currentCompanyId)
            .OrderByDescending(d => d.Date)
            .ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isLoading) return;

        if (Id.HasValue && (currentReturn == null || currentReturn.Id != Id.Value))
        {
            await LoadExistingReturn(Id.Value);
        }
        else if (!Id.HasValue && currentReturn != null && !isCreateMode)
        {
            currentReturn = null;
            selectedVendorId = Guid.Empty;
            selectedOrderId = Guid.Empty;
        }
    }

    private async Task LoadExistingReturn(Guid returnId)
    {
        isBusy = true;
        currentReturn = await ReturnService.GetByIdAsync(returnId, currentCompanyId);

        if (currentReturn != null)
        {
            isCreateMode = false;
            selectedVendorId = currentReturn.VendorId;
            selectedOrderId = currentReturn.PurchaseOrderId ?? Guid.Empty;

            var vendor = vendors.FirstOrDefault(v => v.Id == currentReturn.VendorId);
            defaultApAccountId = vendor?.PayablesAccountId ?? Guid.Empty;

            if (currentReturn.PurchaseOrderId.HasValue)
            {
                cashSummary = await ReturnService.GetCashRefundSummaryAsync(currentReturn.PurchaseOrderId.Value, currentReturn.Id);
            }
        }
        else
        {
            NavigateToListView();
        }

        isBusy = false;
        StateHasChanged();
    }

    private async Task OnVendorSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var venId) && venId != Guid.Empty)
        {
            selectedVendorId = venId;
            var vendor = vendors.FirstOrDefault(v => v.Id == venId);
            defaultApAccountId = vendor?.PayablesAccountId ?? Guid.Empty;

            await LoadEligibleOrders();
        }
        else
        {
            selectedVendorId = Guid.Empty;
            defaultApAccountId = Guid.Empty;
            eligibleOrders.Clear();
        }
    }

    private async Task LoadEligibleOrders()
    {
        _loadingOrders = true;
        StateHasChanged();

        eligibleOrders = await ReturnService.GetOrdersEligibleForReturnAsync(currentCompanyId, selectedVendorId);

        _loadingOrders = false;
        StateHasChanged();
    }

    private async Task CreateReturnWorkspace()
    {
        if (selectedOrderId == Guid.Empty) return;
        isBusy = true;
        _errMsg = string.Empty;

        try
        {
            Guid parsedUserId = Guid.TryParse(currentUserId, out var uid) ? uid : Guid.Empty;

            currentReturn = await ReturnService.CreateVendorReturnDraftAsync(selectedOrderId, selectedReturnType, parsedUserId);

            if (currentReturn != null)
            {
                currentReturn = await ReturnService.GetByIdAsync(currentReturn.Id, currentCompanyId);
                cashSummary = await ReturnService.GetCashRefundSummaryAsync(selectedOrderId, currentReturn.Id);
                isCreateMode = false;

                var vendor = vendors.FirstOrDefault(v => v.Id == currentReturn?.VendorId);
                defaultApAccountId = vendor?.PayablesAccountId ?? Guid.Empty;
            }
        }
        catch (Exception ex)
        {
            _errMsg = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OpenRouteModal()
    {
        if (currentReturn == null) return;

        using var ctx = await DbFactory.CreateDbContextAsync();
        customTemplates = await ctx.CustomTransactionTypes
            .AsNoTracking()
            .Where(t => t.CompanyId == currentCompanyId)
            .OrderBy(t => t.Name)
            .ToListAsync();

        var vendor = vendors.FirstOrDefault(v => v.Id == currentReturn.VendorId);
        defaultApAccountId = vendor?.PayablesAccountId ?? Guid.Empty;

        showRouteModal = true;
    }

    private async Task OnCustomTemplateSelected(ChangeEventArgs e)
    {
        if (currentReturn == null) return;

        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var customId) && customId != Guid.Empty)
        {
            currentReturn.CustomTransactionTypeId = customId;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var map = await ctx.TransactionGlMappings
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.CompanyId == currentCompanyId && m.CustomTransactionTypeId == customId);

            if (map != null)
            {
                if (map.OverrideDebitGlAccountId.HasValue)
                    currentReturn.OverrideGrIrClearingGlAccountId = map.OverrideDebitGlAccountId.Value;

                if (map.OverrideCreditGlAccountId.HasValue)
                {
                    currentReturn.OverrideInventoryAssetGlAccountId = map.OverrideCreditGlAccountId.Value;
                    currentReturn.OverrideAccountsPayableGlAccountId = map.OverrideCreditGlAccountId.Value;
                }
            }
        }
        else
        {
            currentReturn.CustomTransactionTypeId = null;
        }
    }

    private string GetAccountDisplayName(Guid accountId)
    {
        if (accountId == Guid.Empty) return "System Default";
        var acc = allAccounts.FirstOrDefault(a => a.Id == accountId);
        return acc != null ? $"{acc.AccountCode} - {acc.Description}" : "System Default";
    }

    private void ValidateLineQty(VendorReturnLine line, string? val)
    {
        if (decimal.TryParse(val, out var parsed))
        {
            if (parsed < 0) line.Quantity = 0;
            else if (parsed > line.MaxReturnableQty) line.Quantity = line.MaxReturnableQty;
            else line.Quantity = parsed;
        }
        else
        {
            line.Quantity = 0;
        }
    }

    private async Task SaveDraftWorkspace()
    {
        if (currentReturn == null) return;

        if ((currentReturn.ReturnType == VendorReturnType.PaymentOnly || currentReturn.ReturnType == VendorReturnType.Both)
            && currentReturn.TotalAmount > cashSummary.MaxRefundable && cashSummary.MaxRefundable > 0)
        {
            await JS.InvokeVoidAsync("alert", $"Cash recovery amount ({currentReturn.TotalAmount:N2}) cannot exceed the remaining allowable ceiling ({cashSummary.MaxRefundable:N2}).");
            return;
        }

        isBusy = true;
        string err = await ReturnService.SaveDraftAsync(currentReturn);
        isBusy = false;

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Draft workspace saved successfully.");
            await LoadListGrid();
            NavigateToListView();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task PostVendorReturn()
    {
        if (currentReturn == null) return;

        if (currentReturn.ReturnType == VendorReturnType.QuantityOnly || currentReturn.ReturnType == VendorReturnType.Both)
        {
            if (!currentReturn.WarehouseId.HasValue || currentReturn.WarehouseId == Guid.Empty)
            {
                await JS.InvokeVoidAsync("alert", "Please select a Source Warehouse to return physical stock from.");
                return;
            }

            decimal totalQty = currentReturn.Lines.Sum(l => l.Quantity);
            if (totalQty <= 0)
            {
                await JS.InvokeVoidAsync("alert", "Please specify a return quantity on at least one item line.");
                return;
            }
        }

        if (currentReturn.ReturnType == VendorReturnType.PaymentOnly || currentReturn.ReturnType == VendorReturnType.Both)
        {
            if (!currentReturn.BankAccountId.HasValue || currentReturn.BankAccountId == Guid.Empty)
            {
                await JS.InvokeVoidAsync("alert", "Please designate a Bank / Cash receiving account.");
                return;
            }

            if (currentReturn.TotalAmount <= 0)
            {
                await JS.InvokeVoidAsync("alert", "Refund cash recovery amount must be strictly greater than zero.");
                return;
            }

            if (currentReturn.TotalAmount > cashSummary.MaxRefundable + 0.01m)
            {
                await JS.InvokeVoidAsync("alert", $"Refund cash amount ({currentReturn.TotalAmount:N2}) exceeds remaining refundable balance ({cashSummary.MaxRefundable:N2}).");
                return;
            }
        }

        if (!await JS.InvokeAsync<bool>("confirm", "Permanently post this Vendor Return to the General Ledger and Stock Ledgers?")) return;

        isBusy = true;
        await ReturnService.SaveDraftAsync(currentReturn);

        Guid parsedUserId = Guid.TryParse(currentUserId, out var uid) ? uid : Guid.Empty;
        string err = await ReturnService.PostVendorReturnAsync(currentReturn.Id, parsedUserId);
        isBusy = false;

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Vendor Return successfully posted and locked in the General Ledger.");
            await LoadListGrid();
            NavigateToListView();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task DeleteDraft()
    {
        if (currentReturn == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Permanently discard this draft return?")) return;

        string err = await ReturnService.DeleteDraftAsync(currentReturn.Id);
        if (string.IsNullOrEmpty(err))
        {
            await LoadListGrid();
            NavigateToListView();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private void RouteToTargetReturn(Guid returnId)
    {
        Nav.NavigateTo($"/purchases/vendor-returns/entry/{returnId}");
    }

    private void NavigateToListView()
    {
        currentReturn = null;
        isCreateMode = false;
        selectedVendorId = Guid.Empty;
        selectedOrderId = Guid.Empty;
        _errMsg = string.Empty;

        if (Id.HasValue)
        {
            Nav.NavigateTo("/purchases/vendor-returns");
        }
    }

    private void OpenNewFormInitializer()
    {
        currentReturn = null;
        isCreateMode = true;
        selectedVendorId = Guid.Empty;
        selectedOrderId = Guid.Empty;
        eligibleOrders.Clear();
        _errMsg = string.Empty;
    }
}