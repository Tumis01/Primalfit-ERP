@page "/gl/cashbook"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject ICashbookService CashService
@inject SegCoaService SegCoaService
@inject GLSetupService GLService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Cashbook</h1>
            <p class="text-sm text-slate-500">Manage Petty Cash, Registers, and Bank Transactions.</p>
        </div>
        <button @onclick="CreateBatch" class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800 transition-all flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>New Batch</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse">Loading cashbook data...</div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

            <div class="lg:col-span-1 space-y-4 h-[calc(100vh-200px)] overflow-y-auto pr-2">
                @if (activeBatches.Any())
                {
                    @foreach (var batch in activeBatches)
                    {
                        <div @onclick="() => SelectBatch(batch.Id)"
                             class="p-4 rounded-xl border cursor-pointer transition-all hover:shadow-md @(selectedBatch?.Id == batch.Id ? "bg-indigo-50 border-indigo-200 ring-1 ring-indigo-200" : "bg-white border-slate-200 hover:border-slate-300")">

                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-bold text-slate-500">@batch.BatchReference</span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold @GetStatusColor(batch.Status)">
                                    @batch.Status
                                </span>
                            </div>

                            <div class="font-bold text-slate-900 text-sm mb-1 truncate">
                                @(GetAccountName(batch.BankSegCoaId))
                            </div>

                            <div class="flex justify-between items-end mt-3 border-t border-slate-100 pt-2">
                                <div>
                                    <div class="text-[10px] text-slate-400">Balance</div>
                                    <div class="text-sm font-mono font-bold text-slate-700">@batch.ClosingBalance.ToString("N2")</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[10px] text-slate-400">Entries</div>
                                    <div class="text-xs font-bold text-slate-600">@batch.Entries.Count</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-6 text-center border-2 border-dashed border-slate-200 rounded-xl text-slate-400 text-sm">
                        No active batches found.
                    </div>
                }
            </div>

            <div class="lg:col-span-3">
                @if (selectedBatch != null)
                {
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col h-full min-h-[600px]">

                        <div class="p-6 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                            <div>
                                <h2 class="text-lg font-bold text-slate-900">@selectedBatch.BatchReference</h2>
                                <p class="text-xs text-slate-500">
                                    Opening Balance: <span class="font-mono font-bold">@selectedBatch.OpeningBalance.ToString("N2")</span>
                                </p>
                            </div>
                            <div class="flex gap-2">
                                @if (selectedBatch.Status == BatchStatus.Draft)
                                {
                                    <button @onclick="DeleteBatch" class="px-4 py-2 bg-white border border-rose-300 text-rose-700 text-xs font-bold rounded-lg hover:bg-rose-50 flex items-center gap-2 transition-colors">
                                        <svg class="w-4 h-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        Delete Draft
                                    </button>

                                    <button @onclick="SubmitForApproval" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-100 flex items-center gap-2 transition-colors">
                                        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                        Lock Batch
                                    </button>
                                }
                                @* @if (selectedBatch.Status == BatchStatus.Draft)
                                {
                                    <button @onclick="SubmitForApproval" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-100 flex items-center gap-2">
                                        <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                        Lock Batch
                                    </button>
                                } *@
                                @if (selectedBatch.Status == BatchStatus.Ready)
                                {
                                    <button @onclick="UnlockBatch" class="px-4 py-2 bg-amber-50 border border-amber-200 text-amber-700 text-xs font-bold rounded-lg hover:bg-amber-100 flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" /></svg>
                                        Unlock (Edit)
                                    </button>

                                    <button @onclick="PostBatch" class="px-4 py-2 bg-emerald-600 text-white text-xs font-bold rounded-lg shadow-md hover:bg-emerald-700 flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                        Post to GL
                                    </button>
                                }
                            </div>
                        </div>

                        @if (selectedBatch.Status == BatchStatus.Draft)
                        {
                            <EditForm Model="@entryForm" OnValidSubmit="SaveEntry" class="p-4 bg-slate-50/50 border-b border-slate-100">
                                <DataAnnotationsValidator />
                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">

                                    <div class="md:col-span-2">
                                        <label class="label">Date</label>
                                        <div class="input-class py-2 bg-slate-100 text-slate-500 font-mono text-xs flex items-center justify-center">
                                            @entryForm.TransactionDate.ToString("yyyy-MM-dd")
                                        </div>
                                    </div>

                                    <div class="md:col-span-3">
                                        <SearchableGlAccount Label="Offset Account"
                                                             Placeholder="Search Account..."
                                                             Accounts="@AvailableOffsetAccounts"
                                                             @bind-Value="entryForm.OffsetSegCoaId"
                                                             IsInvalid="@(entryForm.OffsetSegCoaId == Guid.Empty)" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="label">Reference <span class="text-red-500">*</span></label>
                                        <InputText @bind-Value="entryForm.Reference" class="input-class py-2 uppercase font-mono" placeholder="REF-001" />
                                    </div>

                                    <div class="md:col-span-5">
                                        <label class="label">Description</label>
                                        <InputText @bind-Value="entryForm.Description" class="input-class py-2" placeholder="e.g. Sales, Expenses" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="label text-rose-700">Debit </label>
                                        <InputNumber @bind-Value="entryForm.Debit" @oninput="(e) => entryForm.Credit = 0" class="input-class py-2 font-bold text-rose-700" placeholder="0.00" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="label text-emerald-700">Credit </label>
                                        <InputNumber @bind-Value="entryForm.Credit" @oninput="(e) => entryForm.Debit = 0" class="input-class py-2 font-bold text-emerald-700" placeholder="0.00" />
                                    </div>

                                    <div class="md:col-span-8 flex justify-end gap-2 mt-2">
                                        @if (isEditing)
                                        {
                                            <button type="button" @onclick="CancelEdit" class="px-4 py-2 bg-white border border-slate-300 text-slate-500 rounded-lg text-xs font-bold hover:bg-slate-50">Cancel</button>
                                            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-lg text-xs font-bold shadow-sm hover:bg-indigo-700">Update Entry</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="px-6 py-2 bg-slate-900 text-white rounded-lg text-xs font-bold shadow-sm hover:bg-slate-800 flex items-center gap-2">
                                                <span>+ Add Entry</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </EditForm>
                        }

                        <div class="flex-1 overflow-auto p-0">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200 sticky top-0">
                                    <tr>
                                        <th class="p-4 w-24">Date</th>
                                        <th class="p-4">Offset Account</th>
                                        <th class="p-4 w-16 text-center">Module</th>
                                        <th class="p-4 w-32">Reference</th>
                                        <th class="p-4">Description</th>
                                        <th class="p-4 text-right">Debit</th>
                                        <th class="p-4 text-right">Credit</th>
                                        <th class="p-4 w-16 text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var entry in selectedBatch.Entries.OrderByDescending(e => e.TransactionDate))
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors @(entry.Id == entryForm.Id ? "bg-indigo-50/50" : "")">
                                            <td class="p-4 text-slate-500 text-xs font-mono">@entry.TransactionDate.ToString("MM/dd")</td>
                                            <td class="p-4 text-xs text-slate-600 font-medium">@GetAccountName(entry.OffsetSegCoaId)</td>
                                            <td class="p-4 text-center">
                                                <span class="text-[10px] font-bold text-slate-400 bg-slate-100 px-2 py-1 rounded">GL</span>
                                            </td>
                                            <td class="p-4 text-xs font-mono text-slate-700">@entry.Reference</td>
                                            <td class="p-4 text-slate-900">@entry.Description</td>
                                            <td class="p-4 text-right font-mono text-emerald-600 font-bold">@(entry.Debit > 0 ? entry.Debit.ToString("N2") : "-")</td>
                                            <td class="p-4 text-right font-mono text-rose-600 font-bold">@(entry.Credit > 0 ? entry.Credit.ToString("N2") : "-")</td>
                                            <td class="p-4 text-center">
                                                @if (selectedBatch.Status == BatchStatus.Draft)
                                                {
                                                    <div class="flex items-center justify-center gap-2">
                                                        <button @onclick="() => EditEntry(entry)" class="text-slate-400 hover:text-indigo-600" title="Edit">
                                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                                                        </button>
                                                        <button @onclick="() => RemoveEntry(entry.Id)" class="text-slate-400 hover:text-red-500" title="Delete">
                                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    <tr class="bg-slate-50 border-t border-slate-200">
                                        <td colspan="5" class="p-4 text-right font-bold text-slate-600 text-xs uppercase">Closing Balance</td>
                                        <td colspan="2" class="p-4 text-right font-mono font-bold text-slate-900 text-lg">@selectedBatch.ClosingBalance.ToString("N2")</td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="h-full min-h-[400px] flex flex-col items-center justify-center bg-white border border-slate-200 rounded-2xl text-slate-400">
                        <svg class="w-16 h-16 opacity-20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                        <p>Select a batch to begin working.</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (showCreateModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 animate-in fade-in duration-200">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
                <h3 class="text-lg font-bold text-slate-900 mb-4">Start New Cashbook Batch</h3>

                <div class="space-y-4">
                    <SearchableGlAccount Label="Select Bank/Cash Account"
                                         Placeholder="Search bank accounts..."
                                         Accounts="@bankAccounts"
                                         @bind-Value="newBatchAccountId"
                                         IsInvalid="@(newBatchAccountId == Guid.Empty)" />

                    <div class="text-xs text-slate-500 bg-slate-50 p-3 rounded-lg border border-slate-100">
                        This creates a new page in the cashbook. The opening balance will be fetched from the General Ledger automatically.
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6">
                    <button @onclick="() => showCreateModal = false" class="px-4 py-2 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button @onclick="ConfirmCreateBatch" disabled="@(newBatchAccountId == Guid.Empty)" class="px-5 py-2 bg-slate-900 text-white text-sm font-bold rounded-lg shadow hover:bg-slate-800 disabled:opacity-50">Start Batch</button>
                </div>
            </div>
        </div>
    }

</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #6366f1;
            outline: none;
            ring: 2px;
            ring-color: #e0e7ff;
        }
</style>

@code {
    private Guid currentCompanyId;
    private string currentUserId = "";
    private bool isLoading = true;
    private bool showCreateModal = false;
    private bool isEditing = false;

    private List<CashbookBatch> activeBatches = new();
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegAccountType> accountTypes = new();
    private List<AccountingPeriod> openPeriods = new();

    private CashbookBatch? selectedBatch;
    private CashbookEntry entryForm = new();
    private Guid newBatchAccountId;

    // RULE 2: A dynamic list that strips the selected bank out of the offset options
    private List<SegChartOfAccount> AvailableOffsetAccounts =>
        allAccounts.Where(a => selectedBatch == null || a.Id != selectedBatch.BankSegCoaId).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;

            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

            // RULE 1: Filter to ONLY "Cash and Cash Equivalents"
            bankAccounts = allAccounts.Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.Description.Equals("Cash and Cash Equivalents", StringComparison.OrdinalIgnoreCase);
            }).OrderBy(x => x.AccountCode).ToList();

            openPeriods = await GLService.GetOpenPeriodsAsync(currentCompanyId);
            activeBatches = await CashService.GetActiveBatchesAsync(currentCompanyId);
        }
        isLoading = false;
    }

    private async Task LoadBatches()
    {
        activeBatches = await CashService.GetActiveBatchesAsync(currentCompanyId);
        if (selectedBatch != null) selectedBatch = await CashService.GetBatchByIdAsync(selectedBatch.Id);
    }

    private async Task SelectBatch(Guid id)
    {
        selectedBatch = await CashService.GetBatchByIdAsync(id);
        ResetForm();
    }

    private void CreateBatch() => showCreateModal = true;

    private async Task ConfirmCreateBatch()
    {
        var batch = await CashService.CreateBatchAsync(currentCompanyId, newBatchAccountId, currentUserId);
        showCreateModal = false;
        await LoadBatches();
        await SelectBatch(batch.Id);
    }

    private async Task SubmitForApproval()
    {
        if (selectedBatch == null) return;
        var err = await CashService.SubmitForApprovalAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err)) await LoadBatches(); else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task UnlockBatch()
    {
        if (selectedBatch == null) return;
        var err = await CashService.RevertToDraftAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err)) await LoadBatches(); else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task PostBatch()
    {
        if (selectedBatch == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "This will post to the General Ledger. Continue?")) return;

        var err = await CashService.PostBatchAsync(selectedBatch.Id, currentUserId);
        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Batch Posted Successfully.");
            selectedBatch = null;
            await LoadBatches();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveEntry()
    {
        if (entryForm.OffsetSegCoaId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select an offset account."); return; }
        if (string.IsNullOrWhiteSpace(entryForm.Reference)) { await JS.InvokeVoidAsync("alert", "Reference is required."); return; }

        var dateDateOnly = DateOnly.FromDateTime(entryForm.TransactionDate);
        bool isPeriodOpen = openPeriods.Any(p => p.StartDate <= dateDateOnly && p.EndDate >= dateDateOnly);
        if (!isPeriodOpen) { await JS.InvokeVoidAsync("alert", $"Cannot save. Date ({dateDateOnly}) is not in an OPEN fiscal period."); return; }

        string err = isEditing ? await CashService.UpdateEntryAsync(entryForm) : await CashService.AddEntryAsync(entryForm);

        if (string.IsNullOrEmpty(err)) { await LoadBatches(); ResetForm(); }
        else { await JS.InvokeVoidAsync("alert", err); }
    }

    private void EditEntry(CashbookEntry entry)
    {
        entryForm = new CashbookEntry
        {
            Id = entry.Id,
            CashbookBatchId = entry.CashbookBatchId,
            TransactionDate = entry.TransactionDate,
            Description = entry.Description,
            Debit = entry.Debit,
            Credit = entry.Credit,
            OffsetSegCoaId = entry.OffsetSegCoaId,
            Reference = entry.Reference
        };
        isEditing = true;
    }

    private void CancelEdit() => ResetForm();

    private async Task RemoveEntry(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this entry?")) return;
        await CashService.RemoveEntryAsync(id);
        await LoadBatches();
    }

    private void ResetForm()
    {
        isEditing = false;
        entryForm = new CashbookEntry
        {
            CashbookBatchId = selectedBatch?.Id ?? Guid.Empty,
            TransactionDate = DateTime.Today
        };
    }
    private async Task DeleteBatch()
    {
        if (selectedBatch == null) return;
    
        // Safety prompt before deleting
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to permanently delete this Draft batch and all its entries? This cannot be undone.")) return;

        var err = await CashService.DeleteDraftBatchAsync(selectedBatch.Id);
    
        if (string.IsNullOrEmpty(err))
        {
            selectedBatch = null; // Clear the selected view
            await LoadBatches();  // Refresh the left-hand list
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }
    private string GetAccountName(Guid id) => allAccounts.FirstOrDefault(a => a.Id == id)?.Description ?? "Unknown";

    private string GetStatusColor(BatchStatus status) => status switch
    {
        BatchStatus.Draft => "bg-slate-100 text-slate-600 border border-slate-200",
        BatchStatus.Ready => "bg-amber-100 text-amber-700 border border-amber-200",
        BatchStatus.Posted => "bg-emerald-100 text-emerald-700 border border-emerald-200",
        _ => "bg-gray-100"
    };
}