@page "/gl/cashbook"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject ICashbookService CashService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject GLSetupService GLService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Cashbook</h1>
            <p class="text-sm text-slate-500">Manage Petty Cash, Registers, and Bank Transactions.</p>
        </div>
        <PermissionGate Key="CASHBOOK_BATCH_CREATE">
            <Authorized>
                <button @onclick="CreateBatch" class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800 transition-all flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    <span>New Batch</span>
                </button>   
            </Authorized>
        </PermissionGate>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse">Loading cashbook data...</div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

            <div class="lg:col-span-1 space-y-4 h-[calc(100vh-200px)] overflow-y-auto pr-2">
                @if (activeBatches.Any())
                {
                    @foreach (var batch in activeBatches)
                    {
                        <div @onclick="() => SelectBatch(batch.Id)"
                             class="p-4 rounded-xl border cursor-pointer transition-all hover:shadow-md @(selectedBatch?.Id == batch.Id ? "bg-indigo-50 border-indigo-200 ring-1 ring-indigo-200" : "bg-white border-slate-200 hover:border-slate-300")">

                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-bold text-slate-500">@batch.BatchReference</span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold @GetStatusColor(batch.Status)">
                                    @batch.Status
                                </span>
                            </div>

                            <div class="font-bold text-slate-900 text-sm mb-1 truncate">
                                @(GetAccountName(batch.BankSegCoaId))
                            </div>

                            @if (batch.IsForeignCurrency)
                            {
                                <div class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider mb-2">
                                    Foreign Currency (@(currencies.FirstOrDefault(c => c.Id == batch.CurrencyId)?.CurrencyCode ?? "??"))
                                </div>
                            }

                            <div class="flex justify-between items-end mt-3 border-t border-slate-100 pt-2">
                                <div>
                                    <div class="text-[10px] text-slate-400">Opening Balance</div>
                                    <div class="text-sm font-mono font-bold @(batch.ClosingBalance < 0 ? "text-rose-600" : "text-slate-700")">
                                        @batch.ClosingBalance.ToString("#,##0.0000;(#,##0.0000);0.0000")
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[10px] text-slate-400">Entries</div>
                                    <div class="text-xs font-bold text-slate-600">@batch.Entries.Count</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-6 text-center border-2 border-dashed border-slate-200 rounded-xl text-slate-400 text-sm">
                        No active batches found.
                    </div>
                }
            </div>

            <div class="lg:col-span-3">
                @if (selectedBatch != null)
                {
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col h-full min-h-[600px]">

                        <div class="p-6 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                            <div>
                                <div class="flex items-center gap-3">
                                    <h2 class="text-lg font-bold text-slate-900">@selectedBatch.BatchReference</h2>
                                    @if (selectedBatch.IsForeignCurrency)
                                    {
                                        <span class="px-2 py-1 bg-indigo-100 text-indigo-700 text-[10px] font-bold uppercase rounded">
                                            Rate: @selectedBatch.ExchangeRate.ToString("N4")
                                        </span>
                                    }
                                </div>
                                <p class="text-xs text-slate-500 mt-1">
                                    Base Opening Balance: 
                                    <span class="font-mono font-bold @(selectedBatch.OpeningBalance < 0 ? "text-rose-600" : "")">
                                        @selectedBatch.OpeningBalance.ToString("#,##0.0000;(#,##0.0000);0.0000")
                                    </span>
                                </p>
                            </div>
                            <div class="flex gap-2">
                                @if (selectedBatch.Status == BatchStatus.Draft || selectedBatch.Status == BatchStatus.Rejected)
                                {
                                    @if (selectedBatch.Status == BatchStatus.Draft && !selectedBatch.IsLocked)
                                    {
                                    <PermissionGate Key="CASHBOOK_BATCH_CREATE">
                                        <Authorized>
                                            <button @onclick="DeleteBatch" class="px-4 py-2 bg-white border border-rose-300 text-rose-700 text-xs font-bold rounded-lg hover:bg-rose-50 flex items-center gap-2 transition-colors">
                                                <svg class="w-4 h-4 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                Delete Draft
                                            </button>
                                        </Authorized>
                                    </PermissionGate>
                                    }

                                    @if (selectedBatch.Status == BatchStatus.Draft && !selectedBatch.IsLocked)
                                    {
                                        <button @onclick="LockBatch" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-50">Lock Batch</button>
                                    }
                                    else if (selectedBatch.Status == BatchStatus.Draft && selectedBatch.IsLocked)
                                    {
                                        <button @onclick="UnlockBatch" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-50">Unlock for Edit</button>
                                    }

                                    <button @onclick="StageForGLReview" disabled="@(!selectedBatch.Entries.Any())" class="px-4 py-2 bg-indigo-600 text-white text-xs font-bold rounded-lg hover:bg-indigo-700 shadow-sm flex items-center gap-2 transition-colors disabled:opacity-50">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                        @(selectedBatch.Status == BatchStatus.Rejected ? "Resubmit for GL Review" : "Submit for GL Review")
                                    </button>
                                }
                                else if (selectedBatch.Status == BatchStatus.Ready)
                                {
                                    <span class="text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg flex items-center gap-1.5">
                                        <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
                                        Staged on /gl/batches
                                    </span>

                                    <PermissionGate Key="CASHBOOK_BATCH_APPROVE">
                                        <Authorized>
                                            <button @onclick="UnlockBatch" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-50 flex items-center gap-2">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" /></svg>
                                                Unlock (Edit)
                                            </button>
                                        </Authorized>
                                    </PermissionGate>
                                }
                                else if (selectedBatch.Status == BatchStatus.Posted)
                                {
                                    <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-lg flex items-center gap-1.5">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                                        Committed to GL (Read-Only)
                                    </span>
                                    <button @onclick="ReuseBatch" class="px-4 py-2 bg-indigo-600 text-white text-xs font-bold rounded-lg hover:bg-indigo-700 shadow-sm">Reuse Batch</button>
                                }
                            </div>
                        </div>

                        @if (selectedBatch.Status == BatchStatus.Rejected && !string.IsNullOrWhiteSpace(selectedBatch.RejectionReason))
                        {
                            <div class="px-6 py-3 bg-rose-50 border-b border-rose-200 text-xs text-rose-800">
                                <span class="font-bold uppercase tracking-wider">Returned for correction:</span> @selectedBatch.RejectionReason
                            </div>
                        }

                        @if ((selectedBatch.Status == BatchStatus.Draft || selectedBatch.Status == BatchStatus.Rejected) && !selectedBatch.IsLocked)
                        {
                            <EditForm Model="@entryForm" OnValidSubmit="SaveEntry" class="p-4 bg-slate-50/50 border-b border-slate-100">
                                <DataAnnotationsValidator />
                                
                                @if (selectedBatch.IsForeignCurrency)
                                {
                                    <div class="flex items-center gap-2 mb-4 p-2 bg-indigo-50 border border-indigo-100 rounded-lg w-fit">
                                        <span class="text-xs font-bold text-indigo-800 uppercase tracking-wider pl-2 pr-4">Input Mode:</span>
                                        <button type="button" @onclick="() => inputForeignAmount = true" class="px-3 py-1.5 rounded text-xs font-bold transition-colors @(inputForeignAmount ? "bg-white text-indigo-700 shadow-sm" : "text-indigo-400 hover:text-indigo-600")">
                                            Foreign Currency
                                        </button>
                                        <button type="button" @onclick="() => inputForeignAmount = false" class="px-3 py-1.5 rounded text-xs font-bold transition-colors @(!inputForeignAmount ? "bg-white text-indigo-700 shadow-sm" : "text-indigo-400 hover:text-indigo-600")">
                                            Local Currency
                                        </button>
                                    </div>
                                }

                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">

                                    <div class="md:col-span-2">
                                        <label class="label">Date</label>
                                        <input type="datetime-local" @bind="entryForm.TransactionDate" class="input-class font-mono text-xs" />
                                    </div>

                                    <div class="md:col-span-3">
                                        <SearchableGlAccount Label="Offset Account"
                                                             Placeholder="Search Account..."
                                                             Accounts="@AvailableOffsetAccounts"
                                                             @bind-Value="entryForm.OffsetSegCoaId"
                                                             IsInvalid="@(entryForm.OffsetSegCoaId == Guid.Empty)" />
                                    </div>

                                    <div class="md:col-span-2">
                                        <label class="label">Reference <span class="text-red-500">*</span></label>
                                        <InputText @bind-Value="entryForm.Reference" class="input-class py-2 uppercase font-mono" placeholder="REF-001" />
                                    </div>

                                    <div class="md:col-span-5">
                                        <label class="label">Description</label>
                                        <InputText @bind-Value="entryForm.Description" class="input-class py-2" placeholder="e.g. Sales, Expenses" />
                                    </div>

                                    @if (selectedBatch.IsForeignCurrency)
                                    {
                                        <div class="md:col-span-3">
                                            <label class="label text-indigo-600">Foreign Debit </label>
                                            <input type="number"   @bind="ForeignDebitInput" class="input-class py-2 font-bold font-mono text-indigo-700 @(!inputForeignAmount ? "bg-slate-100 text-slate-400 cursor-not-allowed" : "")" placeholder="0.0000" disabled="@(!inputForeignAmount)" />
                                        </div>
                                        <div class="md:col-span-3">
                                            <label class="label text-indigo-600">Foreign Credit </label>
                                            <input type="number"   @bind="ForeignCreditInput" class="input-class py-2 font-bold font-mono text-indigo-700 @(!inputForeignAmount ? "bg-slate-100 text-slate-400 cursor-not-allowed" : "")" placeholder="0.0000" disabled="@(!inputForeignAmount)" />
                                        </div>
                                        
                                        <div class="md:col-span-3">
                                            <label class="label text-rose-700"> Debit </label>
                                            <input type="number"   @bind="BaseDebitInput" class="input-class py-2 font-bold font-mono text-rose-700 @(inputForeignAmount ? "bg-slate-100 text-slate-400 cursor-not-allowed" : "")" placeholder="0.0000" disabled="@inputForeignAmount" />
                                        </div>
                                        <div class="md:col-span-3">
                                            <label class="label text-emerald-700"> Credit</label>
                                            <input type="number"   @bind="BaseCreditInput" class="input-class py-2 font-bold font-mono text-emerald-700 @(inputForeignAmount ? "bg-slate-100 text-slate-400 cursor-not-allowed" : "")" placeholder="0.0000" disabled="@inputForeignAmount" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="md:col-span-6"></div>
                                        <div class="md:col-span-3">
                                            <label class="label text-rose-700">Debit (Money In)</label>
                                            <input type="number"   @bind="BaseDebitInput" class="input-class py-2 font-bold font-mono text-rose-700" placeholder="0.0000" />
                                        </div>
                                        <div class="md:col-span-3">
                                            <label class="label text-emerald-700">Credit (Money Out)</label>
                                            <input type="number"   @bind="BaseCreditInput" class="input-class py-2 font-bold font-mono text-emerald-700" placeholder="0.0000" />
                                        </div>
                                    }

                                    <div class="md:col-span-12 flex justify-end gap-2 mt-4">
                                        @if (isEditing)
                                        {
                                            <button type="button" @onclick="CancelEdit" class="px-4 py-2 bg-white border border-slate-300 text-slate-500 rounded-lg text-xs font-bold hover:bg-slate-50">Cancel</button>
                                            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-lg text-xs font-bold shadow-sm hover:bg-indigo-700">Update Entry</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="px-6 py-2 bg-slate-900 text-white rounded-lg text-xs font-bold shadow-sm hover:bg-slate-800 flex items-center gap-2">
                                                <span>+ Add Entry</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </EditForm>
                        }

                        <div class="flex-1 overflow-auto p-0">
                            <table class="w-full text-left text-sm">
                                <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-500 border-b border-slate-200 sticky top-0">
                                    <tr>
                                        <th class="p-4 w-24">Date</th>
                                        <th class="p-4">Offset Account</th>
                                        <th class="p-4 w-32">Reference</th>
                                        <th class="p-4">Description</th>
                                        @if (selectedBatch.IsForeignCurrency)
                                        {
                                            <th class="p-4 text-right text-indigo-600 bg-indigo-50/30">Foreign Dr</th>
                                            <th class="p-4 text-right text-indigo-600 bg-indigo-50/30">Foreign Cr</th>
                                        }
                                        <th class="p-4 text-right">Debit</th>
                                        <th class="p-4 text-right">Credit</th>
                                        <th class="p-4 w-16 text-center">Action/Status</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var entry in selectedBatch.Entries.OrderByDescending(e => e.TransactionDate))
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors @(entry.Id == entryForm.Id ? "bg-indigo-50/50" : "")">
                                            <td class="p-4 text-slate-500 text-xs font-mono">@entry.TransactionDate.ToString("MM/dd HH:mm")</td>
                                            <td class="p-4 text-xs text-slate-600 font-medium">@GetAccountName(entry.OffsetSegCoaId)</td>
                                            <td class="p-4 text-xs font-mono text-slate-700">@entry.Reference</td>
                                            <td class="p-4 text-slate-900 text-xs">@entry.Description</td>
                                            
                                            @if (selectedBatch.IsForeignCurrency)
                                            {
                                                <td class="p-4 text-right font-mono text-indigo-600 text-xs bg-indigo-50/30">@(entry.ForeignDebit > 0 ? entry.ForeignDebit.ToString("N4") : "-")</td>
                                                <td class="p-4 text-right font-mono text-indigo-600 text-xs bg-indigo-50/30">@(entry.ForeignCredit > 0 ? entry.ForeignCredit.ToString("N4") : "-")</td>
                                            }

                                            <td class="p-4 text-right font-mono text-rose-600 font-bold text-xs">@(entry.Debit > 0 ? entry.Debit.ToString("N4") : "-")</td>
                                            <td class="p-4 text-right font-mono text-emerald-600 font-bold text-xs">@(entry.Credit > 0 ? entry.Credit.ToString("N4") : "-")</td>
                                            <td class="p-4 text-center">
                                                @if (entry.IsPosted)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                                        </svg>
                                                        Posted
                                                    </span>
                                                }
                                                else if ((selectedBatch.Status == BatchStatus.Draft || selectedBatch.Status == BatchStatus.Rejected) && !selectedBatch.IsLocked)
                                                {
                                                    <div class="flex items-center justify-center gap-2">
                                                        <button @onclick="() => EditEntry(entry)" class="text-slate-400 hover:text-indigo-600" title="Edit">
                                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                      d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                                            </svg>
                                                        </button>
                                                        <button @onclick="() => RemoveEntry(entry.Id)" class="text-slate-400 hover:text-red-500" title="Delete">
                                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                            </svg>
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    <tr class="bg-slate-50 border-t border-slate-200">
                                        <td colspan="@(selectedBatch.IsForeignCurrency ? 6 : 4)" class="p-4 text-right font-bold text-slate-600 text-xs uppercase">Base Closing Balance</td>
                                        <td colspan="2" class="p-4 text-right font-mono font-bold @(selectedBatch.ClosingBalance < 0 ? "text-rose-600" : "text-slate-900") text-lg">
                                            @selectedBatch.ClosingBalance.ToString("#,##0.0000;(#,##0.0000);0.0000")
                                        </td>
                                        <td></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="h-full min-h-[400px] flex flex-col items-center justify-center bg-white border border-slate-200 rounded-2xl text-slate-400">
                        <svg class="w-16 h-16 opacity-20 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                        <p>Select a batch to begin working.</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (showCreateModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 animate-in fade-in duration-200">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
                <h3 class="text-lg font-bold text-slate-900 mb-4">Start New Cashbook Batch</h3>

                <div class="space-y-4">
                    <SearchableGlAccount Label="Select Bank/Cash Account"
                                         Placeholder="Search bank accounts..."
                                         Accounts="@bankAccounts"
                                         @bind-Value="newBatchAccountId"
                                         IsInvalid="@(newBatchAccountId == Guid.Empty)" />

                    <div class="pt-4 border-t border-slate-100">
                        <div class="flex items-center gap-2 mb-3">
                            <input type="checkbox" id="foreignToggle" @bind="newBatchIsForeign" class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500" />
                            <label for="foreignToggle" class="text-sm font-bold text-slate-700 cursor-pointer">Foreign Currency Batch</label>
                        </div>

                        @if (newBatchIsForeign)
                        {
                            <div class="bg-indigo-50 p-4 rounded-xl border border-indigo-100 space-y-3 animate-in slide-in-from-top-2">
                                <div>
                                    <label class="label text-indigo-700">Currency</label>
                                    <select value="@newBatchCurrencyId" @onchange="OnCurrencyChanged" class="input-class border-indigo-200">
                                        <option value="@Guid.Empty">-- Select Currency --</option>
                                        @foreach(var c in currencies)
                                        {
                                            <option value="@c.Id">@c.CurrencyCode</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="label text-indigo-700">Exchange Rate</label>
                                    <input type="number"   @bind="newBatchExchangeRate" class="input-class font-mono border-indigo-200" />
                                </div>
                            </div>
                        }
                    </div>
                    <label class="flex items-center gap-3 cursor-pointer select-none p-3 rounded-xl border border-slate-200 hover:bg-slate-50 transition-colors">
                        <input type="checkbox" @bind="newBatchClearAfterPost"
                               class="w-4 h-4 rounded accent-slate-800 cursor-pointer" />
                        <div>
                            <span class="text-sm font-bold text-slate-700">Clear batch after post</span>
                            <p class="text-xs text-slate-400 mt-0.5">
                                When checked, the batch is closed once posted. Uncheck to retain
                                entries with a posted indicator and keep the batch open for new entries.
                            </p>
                        </div>
                    </label>
                    <div class="text-xs text-slate-500 bg-slate-50 p-3 rounded-lg border border-slate-100">
                        This creates a new page in the cashbook. The base opening balance will be fetched from the General Ledger automatically.
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6">
                    <button @onclick="() => showCreateModal = false" class="px-4 py-2 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-lg">Cancel</button>
                    <button @onclick="ConfirmCreateBatch" disabled="@(newBatchAccountId == Guid.Empty || (newBatchIsForeign && newBatchCurrencyId == Guid.Empty))" class="px-5 py-2 bg-slate-900 text-white text-sm font-bold rounded-lg shadow hover:bg-slate-800 disabled:opacity-50">Start Batch</button>
                </div>
            </div>
        </div>
    }

</div>

<style>
    .label { display: block; font-size: 0.75rem; font-weight: 700; color: #475569; text-transform: uppercase; margin-bottom: 0.25rem; }
    .input-class { width: 100%; border-radius: 0.5rem; border: 1px solid #cbd5e1; padding: 0.5rem; font-size: 0.875rem; transition: all 0.2s; }
    .input-class:focus { border-color: #6366f1; outline: none; box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15); }
    .input-class:disabled { background-color: #f1f5f9; color: #94a3b8; cursor: not-allowed; }
</style>

@code {
    private Guid currentCompanyId;
    private string currentUserId = "";
    private bool isLoading = true;
    private bool showCreateModal = false;
    private bool isEditing = false;

    // View state for Foreign toggles
    private bool newBatchIsForeign = false;
    private Guid newBatchCurrencyId = Guid.Empty;
    private decimal newBatchExchangeRate = 1;
    private bool inputForeignAmount = true; // Determines which fields are active

    private List<CashbookBatch> activeBatches = new();
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegAccountType> accountTypes = new();
    private List<AccountingPeriod> openPeriods = new();
    private List<Currency> currencies = new();

    private CashbookBatch? selectedBatch;
    private CashbookEntry entryForm = new();
    private Guid newBatchAccountId;
    private bool newBatchClearAfterPost = true;
    private List<SegChartOfAccount> AvailableOffsetAccounts =>
        allAccounts.Where(a => selectedBatch == null || a.Id != selectedBatch.BankSegCoaId).ToList();

    // === BULLETPROOF PROPERTY WRAPPERS FOR INPUT CALCULATION ===
    // These properties ensure that editing one field zeroes out its opposite (Debit vs Credit)
    // and automatically calculates the exchange rate perfectly without buggy Javascript loops.

    private decimal ForeignDebitInput
    {
        get => entryForm.ForeignDebit;
        set {
            entryForm.ForeignDebit = value;
            entryForm.ForeignCredit = 0;
            entryForm.Credit = 0;
            entryForm.Debit = Math.Round(value * (selectedBatch?.ExchangeRate ?? 1), 2);
        }
    }

    private decimal ForeignCreditInput
    {
        get => entryForm.ForeignCredit;
        set {
            entryForm.ForeignCredit = value;
            entryForm.ForeignDebit = 0;
            entryForm.Debit = 0;
            entryForm.Credit = Math.Round(value * (selectedBatch?.ExchangeRate ?? 1), 2);
        }
    }

    private decimal BaseDebitInput
    {
        get => entryForm.Debit;
        set {
            entryForm.Debit = value;
            entryForm.Credit = 0;
            entryForm.ForeignCredit = 0;
            if (selectedBatch != null && selectedBatch.ExchangeRate > 0)
                entryForm.ForeignDebit = Math.Round(value / selectedBatch.ExchangeRate, 2);
        }
    }

    private decimal BaseCreditInput
    {
        get => entryForm.Credit;
        set {
            entryForm.Credit = value;
            entryForm.Debit = 0;
            entryForm.ForeignDebit = 0;
            if (selectedBatch != null && selectedBatch.ExchangeRate > 0)
                entryForm.ForeignCredit = Math.Round(value / selectedBatch.ExchangeRate, 2);
        }
    }
