    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("CASHBOOK_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;

            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);
            currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);

            bankAccounts = allAccounts.Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.Description.Equals("Cash and Cash Equivalents", StringComparison.OrdinalIgnoreCase);
            }).OrderBy(x => x.AccountCode).ToList();

            openPeriods = await GLService.GetOpenPeriodsAsync(currentCompanyId);
            activeBatches = await CashService.GetActiveBatchesAsync(currentCompanyId);
        }
        isLoading = false;
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var cId))
        {
            newBatchCurrencyId = cId;
            newBatchExchangeRate = await CurrService.GetLatestExchangeRateAsync(currentCompanyId, cId);
        }
    }

    private async Task LoadBatches()
    {
        activeBatches = await CashService.GetActiveBatchesAsync(currentCompanyId);
        if (selectedBatch != null) selectedBatch = await CashService.GetBatchByIdAsync(selectedBatch.Id);
    }

    private async Task SelectBatch(Guid id)
    {
        selectedBatch = await CashService.GetBatchByIdAsync(id);
        ResetForm();
    }

    private void CreateBatch() 
    {
        newBatchIsForeign = false;
        newBatchCurrencyId = Guid.Empty;
        newBatchExchangeRate = 1;
        newBatchClearAfterPost = true;
        showCreateModal = true;
    }

    private async Task ConfirmCreateBatch()
    {
        var batch = await CashService.CreateBatchAsync(currentCompanyId, newBatchAccountId, currentUserId, newBatchIsForeign, newBatchCurrencyId, newBatchExchangeRate, newBatchClearAfterPost);
        showCreateModal = false;
        await LoadBatches();
        await SelectBatch(batch.Id);
    }

    private async Task SubmitForApproval()
    {
        if (selectedBatch == null) return;
        var err = await CashService.SubmitForApprovalAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err)) await LoadBatches(); else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task UnlockBatch()
    {
        if (selectedBatch == null) return;
        var err = await CashService.RevertToDraftAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err)) await LoadBatches(); else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task LockBatch()
    {
        if (selectedBatch == null) return;
        var err = await CashService.LockBatchAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err)) await LoadBatches(); else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task ReuseBatch()
    {
        if (selectedBatch == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Reuse {selectedBatch.BatchReference} for additional cashbook entries?")) return;
        var err = await CashService.ReuseBatchAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err))
        {
            await LoadBatches();
            await SelectBatch(selectedBatch.Id);
        }
        else await JS.InvokeVoidAsync("alert", err);
    }

