    private async Task StageForGLReview()
    {
        if (selectedBatch == null || !selectedBatch.Entries.Any()) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"Stage cashbook batch {selectedBatch.BatchReference} for review? It will appear on /gl/batches for GL posting.");
        if (!confirm) return;

        var err = await CashService.PostBatchAsync(selectedBatch.Id, currentUserId);
        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Batch submitted and staged for GL review.");
            await LoadBatches();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveEntry()
    {
        if (entryForm.OffsetSegCoaId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select an offset account."); return; }
        if (string.IsNullOrWhiteSpace(entryForm.Reference)) { await JS.InvokeVoidAsync("alert", "Reference is required."); return; }

        var dateDateOnly = DateOnly.FromDateTime(entryForm.TransactionDate);
        bool isPeriodOpen = openPeriods.Any(p => p.StartDate <= dateDateOnly && p.EndDate >= dateDateOnly);
        if (!isPeriodOpen) { await JS.InvokeVoidAsync("alert", $"Cannot save. Date ({dateDateOnly}) is not in an OPEN fiscal period."); return; }

        string err = isEditing ? await CashService.UpdateEntryAsync(entryForm) : await CashService.AddEntryAsync(entryForm);

        if (string.IsNullOrEmpty(err)) { await LoadBatches(); ResetForm(); }
        else { await JS.InvokeVoidAsync("alert", err); }
    }

    private void EditEntry(CashbookEntry entry)
    {
        entryForm = new CashbookEntry
        {
            Id = entry.Id,
            CashbookBatchId = entry.CashbookBatchId,
            TransactionDate = entry.TransactionDate,
            Description = entry.Description,
            Debit = entry.Debit,
            Credit = entry.Credit,
            ForeignDebit = entry.ForeignDebit,
            ForeignCredit = entry.ForeignCredit,
            OffsetSegCoaId = entry.OffsetSegCoaId,
            Reference = entry.Reference
        };
        isEditing = true;
    }

    private void CancelEdit() => ResetForm();

    private async Task RemoveEntry(Guid id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this entry?")) return;
        await CashService.RemoveEntryAsync(id);
        await LoadBatches();
    }

    private void ResetForm()
    {
        isEditing = false;
        inputForeignAmount = true; // Default back to foreign input if applicable
        entryForm = new CashbookEntry
        {
            CashbookBatchId = selectedBatch?.Id ?? Guid.Empty,
            TransactionDate = DateTime.Now
        };
    }

    private async Task DeleteBatch()
    {
        if (selectedBatch == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Are you sure you want to permanently delete this Draft batch and all its entries? This cannot be undone.")) return;

        var err = await CashService.DeleteDraftBatchAsync(selectedBatch.Id);
        
        if (string.IsNullOrEmpty(err))
        {
            selectedBatch = null; 
            await LoadBatches();  
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private string GetAccountName(Guid id) => allAccounts.FirstOrDefault(a => a.Id == id)?.Description ?? "Unknown";

    private string GetStatusColor(BatchStatus status) => status switch
    {
        BatchStatus.Draft => "bg-slate-100 text-slate-600 border border-slate-200",
        BatchStatus.Ready => "bg-amber-100 text-amber-700 border border-amber-200",
        BatchStatus.Posted => "bg-emerald-100 text-emerald-700 border border-emerald-200",
        _ => "bg-gray-100"
    };
