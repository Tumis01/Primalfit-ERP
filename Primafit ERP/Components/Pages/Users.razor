@page "/users"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject UserApiService UserService
@inject RoleApiService RoleService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">User Management</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Manage system access for your company.</p>
        </div>

        <div class="flex gap-2">
            @if (!showForm)
            {
                <button @onclick="CreateNew" disabled="@(!HasCompany)"
                        class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    New User
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading users...
        </div>
    }
    else if (showForm && HasCompany)
    {
        <div class="relative overflow-hidden rounded-2xl bg-white p-8 shadow-xl ring-1 ring-slate-200 animate-in slide-in-from-top-4 duration-300">
            <div class="absolute top-0 left-0 w-full h-1 bg-slate-900"></div>

            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-900">Register New User</h3>
                <button @onclick="CancelForm" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="newUser" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-1.5">
                        <label class="label">First Name</label>
                        <InputText @bind-Value="newUser.FirstName" class="@InputClass" placeholder="John" />
                    </div>
                    <div class="space-y-1.5">
                        <label class="label">Last Name</label>
                        <InputText @bind-Value="newUser.LastName" class="@InputClass" placeholder="Doe" />
                    </div>
                    <div class="space-y-1.5 md:col-span-2">
                        <label class="label">Email Address</label>
                        <InputText @bind-Value="newUser.Email" class="@InputClass" placeholder="john@company.com" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="label">Assign Role</label>
                        <InputSelect @bind-Value="newUser.RoleDisplayName" class="@InputClass">
                            <option value="">-- Select Role --</option>
                            @foreach (var role in availableRoles)
                            {
                                <option value="@role.DisplayName">@role.DisplayName</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="space-y-1.5">
                        <label class="label">Company</label>
                        <div class="block w-full rounded-xl border border-slate-200 bg-slate-50 py-2.5 px-3 text-sm text-slate-500 cursor-not-allowed font-medium">
                            @companyName
                        </div>
                    </div>

                    <div class="md:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-slate-100 pt-6 mt-2">
                        <div class="space-y-1.5 relative">
                            <label class="label">Initial Password</label>
                            <input @bind="newUser.Password" type="text" class="@InputClass" placeholder="e.g. Welcome@2026" />
                        </div>
                        <div class="space-y-1.5">
                            <label class="label">Confirm Password</label>
                            <input @bind="confirmPassword" type="text" class="@InputClass @(passwordsMatch ? "" : "border-rose-300 ring-rose-200")" />
                            @if (!passwordsMatch)
                            {
                                <p class="text-xs text-rose-600 mt-1 font-medium">Passwords do not match.</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" @onclick="CancelForm" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                        Create User
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-900">
            <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200 tracking-wider">
                <tr>
                    <th class="px-6 py-4">User</th>
                    <th class="px-6 py-4">Email</th>
                    <th class="px-6 py-4">Role</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (users.Any())
                {
                    @foreach (var u in users)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-bold text-slate-900">
                                <div class="flex items-center gap-3">
                                    <div class="h-8 w-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-700 font-bold text-xs border border-slate-200">
                                        @u.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    @u.FullName
                                </div>
                            </td>
                            <td class="px-6 py-4 text-slate-600">@u.Email</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded border border-slate-200 bg-white px-2 py-1 text-xs font-bold text-slate-700">
                                    @u.Role
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-6 py-12 text-center text-slate-400">
                            No users found for this company.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.025em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
        }
</style>

@code {
    private const string InputClass = "block w-full rounded-xl border-slate-200 bg-white py-2.5 text-sm text-slate-900 shadow-sm focus:border-slate-800 focus:ring-2 focus:ring-slate-200 transition-all placeholder:text-slate-400";

    // --- CONTEXT ---
    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;

    // --- DATA ---
    private List<UserDisplayDto> users = new();
    private List<ApplicationRole> availableRoles = new();

    private UserDto newUser = new();
    private bool showForm = false;
    private string confirmPassword = "";
    private bool passwordsMatch = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                await LoadData();
            }
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        if (!HasCompany) return;

        users = await UserService.GetUsersAsync(selectedCompanyId);
        availableRoles = await RoleService.GetRolesAsync(selectedCompanyId);
    }

    private void CreateNew()
    {
        newUser = new UserDto { CompanyDetailsId = selectedCompanyId };
        showForm = true;
    }

    private async Task HandleSubmit()
    {
        if (newUser.Password != confirmPassword) { passwordsMatch = false; return; }
        passwordsMatch = true;

        newUser.CompanyDetailsId = selectedCompanyId;

        var err = await UserService.CreateUserAsync(newUser);

        if (string.IsNullOrEmpty(err))
        {
            CancelForm();
            await LoadData();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private void CancelForm()
    {
        showForm = false;
        newUser = new UserDto();
        confirmPassword = "";
        passwordsMatch = true;
    }
}