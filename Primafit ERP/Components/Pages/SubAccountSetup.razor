@* @page "/gl/sub-setup"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject GLService GlService
@inject ProjectService ProjectService
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Sub-Account Setup</h1>
            <p class="text-sm text-slate-500">Create transactional accounts linked to a Master.</p>
        </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <EditForm Model="@newSub" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Select Master Account</label>
                    <div class="relative">
                        <InputSelect @bind-Value="newSub.MasterAccountId" class="w-full appearance-none rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 transition-all">
                            <option value="0">-- Select Master --</option>
                            @foreach (var m in masterAccounts)
                            {
                                <option value="@m.Id">@m.AccountCode - @m.AccountName</option>
                            }
                        </InputSelect>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-500">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                    </div>
                </div>

                <div>
                    <label class="mb-1 block text-sm font-medium text-slate-700">Sub-Code Suffix</label>
                    <div class="flex items-center rounded-xl border border-slate-200 bg-white focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/20 overflow-hidden">
                        <span class="bg-slate-100 border-r border-slate-200 px-3 py-2.5 text-slate-500 text-sm font-mono font-medium">
                            @(masterAccounts.FirstOrDefault(m => m.Id == newSub.MasterAccountId)?.AccountCode ?? "XXXX") /
                        </span>
                        <InputText @bind-Value="newSub.SubCode"
                                   class="w-full border-0 bg-transparent px-3 py-2.5 text-sm focus:ring-0 placeholder:text-slate-400 font-mono"
                                   placeholder="001" />
                    </div>
                </div>

                <div class="md:col-span-2">
                    <label class="mb-1 block text-sm font-medium text-slate-700">Account Name</label>
                    <InputText @bind-Value="newSub.AccountName"
                               class="w-full rounded-xl border-slate-200 bg-slate-50 px-3 py-2.5 text-sm focus:border-indigo-500 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 transition-all placeholder:text-slate-400"
                               placeholder="e.g. Office Stationery" />
                </div>

                <div class="md:col-span-2 rounded-xl bg-indigo-50/50 p-4 border border-indigo-100">
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-sm font-semibold text-indigo-700">Optional: Link to Project</label>
                        <span class="text-xs text-indigo-500">Can be linked later via Relink Tool</span>
                    </div>

                    <div class="relative">
                        <InputSelect @bind-Value="newSub.ProjectId" class="w-full appearance-none rounded-lg border-indigo-200 bg-white px-3 py-2.5 text-sm text-slate-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all">
                            <option value="">-- No Project (General Overhead) --</option>
                            @foreach (var p in availableProjects)
                            {
                                <option value="@p.Id">@p.Code - @p.Name</option>
                            }
                        </InputSelect>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-indigo-400">
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-6 flex justify-end">
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 transition-all">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                    Create Sub-Account
                </button>
            </div>
        </EditForm>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50/50 text-xs uppercase font-semibold text-slate-500">
                <tr>
                    <th class="px-6 py-4">Full Code</th>
                    <th class="px-6 py-4">Account Name</th>
                    <th class="px-6 py-4">Master Account</th>
                    <th class="px-6 py-4">Linked Project</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (subAccounts.Any())
                {
                    @foreach (var item in subAccounts)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 font-mono font-bold text-slate-900">
                                <span class="text-slate-400">@item.MasterAccount?.AccountCode /</span> @item.SubCode
                            </td>
                            <td class="px-6 py-4">@item.AccountName</td>
                            <td class="px-6 py-4 text-slate-500">@item.MasterAccount?.AccountName</td>
                            <td class="px-6 py-4">
                                @if (item.LinkedProject != null)
                                {
                                    <span class="inline-flex items-center gap-1.5 rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">
                                        <span class="font-mono">@item.LinkedProject.Code</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-md bg-slate-50 px-2 py-1 text-xs font-medium text-slate-400 ring-1 ring-inset ring-slate-500/10">
                                        Unlinked
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-slate-400 italic">No sub-accounts found. Create one above.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    // 1. Updated Models to use GLMasterAccount and GLSubAccount
    private List<GLMasterAccount> masterAccounts = new();
    private List<GLSubAccount> subAccounts = new();
    private List<Project> availableProjects = new();

    private GLSubAccount newSub = new();

    // Note: We don't need 'selectedMasterId' separately anymore
    // We can bind directly to newSub.MasterAccountId

    protected override async Task OnInitializedAsync()
    {
        masterAccounts = await GlService.GetMastersAsync();
        // 2. Updated to use the new GetAllSubsAsync method
        subAccounts = await GlService.GetAllSubsAsync();
        availableProjects = await ProjectService.GetProjectsAsync();
    }

    private async Task HandleSubmit()
    {
        // 3. Validation: Ensure Master ID is selected
        if (newSub.MasterAccountId == 0) return;

        if (await GlService.CreateSubAsync(newSub))
        {
            newSub = new();
            subAccounts = await GlService.GetAllSubsAsync(); // Refresh list
        }
    }
} *@