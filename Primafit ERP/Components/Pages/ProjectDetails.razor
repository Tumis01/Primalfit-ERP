@page "/projects/report"
@page "/projects/report/{ReportType}"
@page "/projects/{Id:guid}"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject ProjectService ProjectService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6">
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5">
            <div>
                <a href="/projects/setup" class="text-xs font-bold text-indigo-600 hover:underline">← Project setup</a>
                <h1 class="text-2xl font-bold text-slate-900 mt-2">Project Reports</h1>
                @if (selectedProject is not null)
                {
                    <p class="text-sm text-slate-500 mt-1">@selectedProject.ProjectCode · @selectedProject.Name</p>
                }
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3 items-end">
                <div>
                    <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">Project</label>
                    <select @bind:get="selectedProjectId" @bind:set="SelectProject" class="w-full min-w-56 rounded-lg border border-slate-300 px-3 py-2 text-sm bg-white">
                        <option value="">Select a project</option>
                        @foreach (var project in projects)
                        {
                            <option @key="project.Id" value="@project.Id">@project.ProjectCode - @project.Name@(project.IsActive ? "" : " (Inactive)")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">From</label>
                    <InputDate @bind-Value="fromDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase text-slate-400 mb-1">To</label>
                    <InputDate @bind-Value="toDate" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" />
                </div>
                <button @onclick="LoadReport" class="px-4 py-2 rounded-lg bg-slate-900 text-white text-sm font-bold hover:bg-slate-700">Apply</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse bg-white border rounded-2xl">Loading project report…</div>
    }
    else if (projects.Count == 0)
    {
        <div class="p-8 rounded-2xl border border-slate-200 bg-white text-slate-500">No projects have been set up yet.</div>
    }
    else if (selectedProjectId is null)
    {
        <div class="p-8 rounded-2xl border border-dashed border-slate-300 bg-white text-center text-slate-500">Choose a project to view its reports.</div>
    }
    else if (report is null)
    {
        <div class="p-8 rounded-2xl border border-amber-200 bg-amber-50 text-amber-800">
            @(fromDate > toDate ? "The start date must be on or before the end date." : "Project not found.")
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-200"><div class="text-xs font-bold uppercase text-slate-400">Revenue</div><div class="mt-2 text-xl font-mono font-bold text-emerald-700">@FormatAmount(report.Revenue, credit: true)</div></div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200"><div class="text-xs font-bold uppercase text-slate-400">Expenses</div><div class="mt-2 text-xl font-mono font-bold text-rose-700">@FormatAmount(report.Expenses)</div></div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200"><div class="text-xs font-bold uppercase text-slate-400">Net Result</div><div class="mt-2 text-xl font-mono font-bold text-slate-900">@FormatAmount(report.Revenue - report.Expenses)</div></div>
        </div>

        <nav class="flex flex-wrap gap-2 border-b border-slate-200" aria-label="Project reports">
            <NavLink href="/projects/report/profit-and-loss" Match="NavLinkMatch.All" class="@ReportNavClass(ReportTab.ProfitAndLoss)">Profit &amp; Loss</NavLink>
            <NavLink href="/projects/report/balance-sheet" Match="NavLinkMatch.All" class="@ReportNavClass(ReportTab.BalanceSheet)">Balance Sheet</NavLink>
            <NavLink href="/projects/report/general-ledger" Match="NavLinkMatch.All" class="@ReportNavClass(ReportTab.GeneralLedger)">General Ledger</NavLink>
        </nav>

        @switch (activeReport)
        {
            case ReportTab.ProfitAndLoss:
                <section class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100"><h2 class="font-bold text-slate-900">Project Profit and Loss</h2><p class="text-xs text-slate-500">Posted project activity from @report.FromDate.ToString("yyyy-MM-dd") to @report.ToDate.ToString("yyyy-MM-dd"). Credit balances are shown in brackets.</p></div>
                    @AccountTable(report.ProfitAndLossAccounts)
                </section>
                break;
            case ReportTab.BalanceSheet:
                <section class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100"><h2 class="font-bold text-slate-900">Project Balance Sheet</h2><p class="text-xs text-slate-500">Cumulative posted balances through @report.ToDate.ToString("yyyy-MM-dd"). Credit balances are shown in brackets.</p></div>
                    @AccountTable(report.BalanceSheetAccounts)
                </section>
                break;
            case ReportTab.GeneralLedger:
                <section class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100"><h2 class="font-bold text-slate-900">Project General Ledger Activity</h2><p class="text-xs text-slate-500">Posted activity from @report.FromDate.ToString("yyyy-MM-dd") to @report.ToDate.ToString("yyyy-MM-dd"). Credit values are shown in brackets.</p></div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-500"><tr><th class="p-3">Date</th><th class="p-3">Account</th><th class="p-3">Narration</th><th class="p-3 text-right">Debit</th><th class="p-3 text-right">Credit</th></tr></thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var transaction in report.Transactions)
                                {
                                    <tr><td class="p-3">@transaction.PostingDate.ToString("yyyy-MM-dd")</td><td class="p-3">@transaction.SegCoa?.AccountCode - @transaction.SegCoa?.Description</td><td class="p-3">@transaction.Narration</td><td class="p-3 text-right font-mono">@FormatAmount(transaction.Debit)</td><td class="p-3 text-right font-mono">@FormatAmount(transaction.Credit, credit: true)</td></tr>
                                }
                                @if (report.Transactions.Count == 0) { <tr><td colspan="5" class="p-8 text-center text-slate-400">No posted project activity for this period.</td></tr> }
                            </tbody>
                        </table>
                    </div>
                </section>
                break;
        }
    }
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public string? ReportType { get; set; }

    private enum ReportTab { ProfitAndLoss, BalanceSheet, GeneralLedger }
    private ReportTab activeReport = ReportTab.ProfitAndLoss;
    private bool isLoading = true;
    private Guid companyId;
    private Guid? selectedProjectId;
    private List<Project> projects = new();
    private Project? selectedProject => projects.FirstOrDefault(project => project.Id == selectedProjectId);
    private DateOnly fromDate = new(DateTime.Today.Year, 1, 1);
    private DateOnly toDate = DateOnly.FromDateTime(DateTime.Today);
    private ProjectReportViewModel? report;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        companyId = user?.CompanyDetailsId ?? Guid.Empty;
        projects = companyId == Guid.Empty
            ? new List<Project>()
            : await ProjectService.GetProjectsAsync(companyId);
        if (Id.HasValue)
            selectedProjectId = Id;

        activeReport = ReportType?.ToLowerInvariant() switch
        {
            "balance-sheet" => ReportTab.BalanceSheet,
            "general-ledger" => ReportTab.GeneralLedger,
            _ => ReportTab.ProfitAndLoss
        };
        await LoadReport();
    }

    private async Task SelectProject(Guid? projectId)
    {
        selectedProjectId = projectId;
        await LoadReport();
    }

    private async Task LoadReport()
    {
        isLoading = true;
        report = companyId == Guid.Empty || selectedProjectId is null || fromDate > toDate
            ? null
            : await ProjectService.GetProjectReportAsync(companyId, selectedProjectId.Value, fromDate, toDate);
        isLoading = false;
    }

    private string ReportNavClass(ReportTab tab) => activeReport == tab
        ? "px-4 py-2.5 border-b-2 border-slate-900 text-sm font-bold text-slate-900"
        : "px-4 py-2.5 border-b-2 border-transparent text-sm font-semibold text-slate-500 hover:text-slate-900";

    private static string FormatAmount(decimal amount, bool credit = false)
    {
        var formatted = Math.Abs(amount).ToString("N2");
        return amount < 0 || (credit && amount > 0) ? $"({formatted})" : amount.ToString("N2");
    }

    private RenderFragment AccountTable(List<ProjectAccountBalanceRow> rows) => @<div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-500"><tr><th class="p-3">Account</th><th class="p-3">Description</th><th class="p-3 text-right">Debit</th><th class="p-3 text-right">Credit</th><th class="p-3 text-right">Balance</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var row in rows)
                {
                    <tr><td class="p-3 font-mono">@row.AccountCode</td><td class="p-3">@row.AccountName</td><td class="p-3 text-right font-mono">@FormatAmount(row.Debit)</td><td class="p-3 text-right font-mono">@FormatAmount(row.Credit, credit: true)</td><td class="p-3 text-right font-mono font-bold">@FormatAmount(row.Balance, credit: !row.IsDebitNormal)</td></tr>
                }
                @if (rows.Count == 0) { <tr><td colspan="5" class="p-8 text-center text-slate-400">No tagged account activity.</td></tr> }
            </tbody>
        </table>
    </div>;
}
