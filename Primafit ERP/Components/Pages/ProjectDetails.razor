@page "/projects/report"
@page "/projects/report/{ReportType}"
@page "/projects/{Id:guid}"
@inject NavigationManager Navigation
@code {
    [Parameter] public string? ReportType { get; set; }
    [Parameter] public Guid? Id { get; set; }
    protected override void OnParametersSet() => Navigation.NavigateTo("/dimensions/reports/" + (ReportType is "profit-and-loss" or "balance-sheet" ? ReportType : "general-ledger") + (Id.HasValue ? $"?dimension={Id}" : ""), replace: true);
}
