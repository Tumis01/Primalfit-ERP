@page "/projects/setup"
@page "/projects"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject ProjectService ProjectService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Projects</h1>
            <p class="text-sm text-slate-500">Optional reporting tags for transactions and account balances.</p>
        </div>
        <button @onclick="CreateNew" class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800">New Project</button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse bg-white rounded-2xl border">Loading projects…</div>
    }
    else if (projects.Count == 0)
    {
        <div class="p-12 text-center border-2 border-dashed border-slate-200 rounded-2xl text-slate-400 bg-white">No projects have been set up.</div>
    }
    else
    {
        <div class="overflow-x-auto bg-white border border-slate-200 rounded-2xl shadow-sm">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-[10px] uppercase font-bold text-slate-500 border-b">
                    <tr><th class="p-4">Project Code</th><th class="p-4">Name</th><th class="p-4">Description</th><th class="p-4">Status</th><th class="p-4 text-right">Actions</th></tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var project in projects)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="p-4 font-mono font-bold text-slate-800">@project.ProjectCode</td>
                            <td class="p-4 font-semibold text-slate-900">@project.Name</td>
                            <td class="p-4 text-slate-500">@project.Description</td>
                            <td class="p-4"><span class="px-2 py-1 rounded-full text-xs font-bold @(project.IsActive ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-500")">@(project.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="p-4 text-right whitespace-nowrap">
                                <button @onclick="() => Edit(project)" class="px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-100 rounded-lg">Edit</button>
                                <button @onclick="() => Delete(project)" class="px-3 py-1.5 text-xs font-bold text-rose-700 hover:bg-rose-50 rounded-lg">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (showModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6 space-y-4">
                <h2 class="text-xl font-bold text-slate-900">@(model.Id == Guid.Empty ? "Create Project" : "Edit Project")</h2>
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Project Code</label>
                            <InputText @bind-Value="model.ProjectCode" maxlength="50" class="w-full rounded-lg border border-slate-300 px-3 py-2" />
                            <ValidationMessage For="() => model.ProjectCode" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Name</label>
                            <InputText @bind-Value="model.Name" maxlength="200" class="w-full rounded-lg border border-slate-300 px-3 py-2" />
                            <ValidationMessage For="() => model.Name" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Description</label>
                            <InputTextArea @bind-Value="model.Description" class="w-full rounded-lg border border-slate-300 px-3 py-2 h-24" />
                        </div>
                        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                            <InputCheckbox @bind-Value="model.IsActive" /> Active
                        </label>
                    </div>
                    <div class="flex justify-end gap-3 mt-6">
                        <button type="button" @onclick="() => showModal = false" class="px-4 py-2 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-lg">Cancel</button>
                        <button type="submit" class="px-6 py-2 bg-slate-900 text-white font-bold rounded-lg">Save Project</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private List<Project> projects = new();
    private Project model = new();
    private bool isLoading = true;
    private bool showModal;
    private Guid companyId;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId is Guid id)
        {
            companyId = id;
            await LoadData();
        }
        isLoading = false;
    }

    private Task LoadData() => RefreshProjects();
    private async Task RefreshProjects() => projects = await ProjectService.GetProjectsAsync(companyId);
    private void CreateNew() { model = new Project { Id = Guid.Empty, CompanyId = companyId, IsActive = true }; showModal = true; }
    private void Edit(Project project) { model = new Project { Id = project.Id, CompanyId = project.CompanyId, ProjectCode = project.ProjectCode, Name = project.Name, Description = project.Description, IsAccountingProject = true, IsActive = project.IsActive }; showModal = true; }
    private async Task Save()
    {
        var error = await ProjectService.SaveProjectAsync(model);
        if (string.IsNullOrWhiteSpace(error)) { showModal = false; await LoadData(); }
        else await JS.InvokeVoidAsync("alert", error);
    }

    private async Task Delete(Project project)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Delete project {project.ProjectCode} — {project.Name}? This cannot be undone.");
        if (!confirmed) return;

        var error = await ProjectService.DeleteProjectAsync(companyId, project.Id);
        if (!string.IsNullOrWhiteSpace(error))
        {
            await JS.InvokeVoidAsync("alert", error);
            return;
        }

        await LoadData();
    }
}
