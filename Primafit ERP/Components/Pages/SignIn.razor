@page "/login"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject AuthService AuthService
@inject NavigationManager Nav
@layout Primafit_ERP.Components.Layout.LoginLayout

<div class="min-h-screen flex items-center justify-center bg-slate-50 p-4">
    <div class="max-w-5xl w-full bg-white rounded-3xl shadow-2xl overflow-hidden flex flex-col md:flex-row transition-all duration-500">

        <div class="md:w-5/12 bg-slate-900 p-12 flex flex-col justify-between text-white relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-full opacity-20 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-500 via-slate-900 to-black"></div>

            <div class="relative z-10">
                <div class="h-12 w-12 bg-white/10 rounded-xl flex items-center justify-center backdrop-blur-sm mb-6 shadow-inner ring-1 ring-white/20">
                    <svg class="w-7 h-7 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                </div>
                <h1 class="text-3xl font-bold mb-2 tracking-tight">Primafit ERP</h1>
                <p class="text-slate-400 leading-relaxed">
                    @(isRegistering
                                        ? "Register your organization to start managing resources, finance, and operations in one place." 
                                                : "Welcome back. Access your dashboard and manage your business performance.")
                </p>
            </div>

            <div class="relative z-10 mt-12 md:mt-0">
                <p class="text-sm text-slate-500 mb-3 uppercase tracking-wider font-bold">
                    @(isRegistering ? "Already have an account?" : "New to Primafit?")
                </p>
                <button @onclick="ToggleMode" class="group flex items-center gap-2 text-white font-semibold hover:text-indigo-400 transition-colors">
                    @(isRegistering ? "Sign in to existing account" : "Register your Company")
                    <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                </button>
            </div>
        </div>

        <div class="md:w-7/12 p-8 md:p-12 bg-white relative">
            <div class="max-w-md mx-auto">

                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-slate-900">
                        @(isRegistering ? "Setup Organization" : "Sign In")
                    </h2>
                    <p class="text-slate-500 text-sm mt-1">
                        @(isRegistering ? "Enter your company details to bootstrap your environment." : "Enter your credentials to access your account.")
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="mb-6 bg-rose-50 text-rose-600 px-4 py-3 rounded-xl text-sm font-medium border border-rose-100 flex items-start gap-3 animate-in fade-in slide-in-from-top-2">
                        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>@ErrorMessage</span>
                    </div>
                }

                @if (showSuccess)
                {
                    <div class="mb-6 bg-emerald-50 text-emerald-700 px-4 py-3 rounded-xl text-sm font-medium border border-emerald-100 flex items-center gap-3">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>Account created! Please sign in with your new admin credentials.</span>
                    </div>
                }

                @if (isRegistering)
                {
                    <EditForm Model="registerModel" OnValidSubmit="HandleRegistration">
                        <DataAnnotationsValidator />

                        <div class="space-y-6 animate-in fade-in slide-in-from-right-4 duration-300">

                            <div class="p-5 bg-slate-50 rounded-2xl border border-slate-100">
                                <div class="flex items-center gap-2 mb-4 text-indigo-600 font-bold text-xs uppercase tracking-wider">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                                    Organization Profile
                                </div>
                                <div class="space-y-4">
                                    <div>
                                        <label class="label">Company Name</label>
                                        <InputText @bind-Value="registerModel.CompanyName" class="input-field" placeholder="e.g. Acme Corp" />
                                        <ValidationMessage For="@(() => registerModel.CompanyName)" class="text-xs text-rose-500 mt-1" />
                                    </div>
                                    <div>
                                        <label class="label">Official Email</label>
                                        <InputText @bind-Value="registerModel.CompanyEmail" class="input-field" placeholder="info@acme.com" />
                                        <ValidationMessage For="@(() => registerModel.CompanyEmail)" class="text-xs text-rose-500 mt-1" />
                                    </div>
                                    <div>
                                        <label class="label">Company Structure</label>
                                        <InputSelect @bind-Value="registerModel.Type" class="input-field cursor-pointer">
                                            @foreach (var t in Enum.GetValues<CompanyType>())
                                            {
                                                <option value="@t">@t.ToString()</option>
                                            }
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="flex items-center gap-2 mb-3 text-slate-500 font-bold text-xs uppercase tracking-wider">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                    Super Admin User
                                </div>
                                <div class="grid grid-cols-2 gap-3 mb-3">
                                    <InputText @bind-Value="registerModel.FirstName" class="input-field" placeholder="First Name" />
                                    <InputText @bind-Value="registerModel.LastName" class="input-field" placeholder="Last Name" />
                                </div>
                                <div class="space-y-3">
                                    <div>
                                        <label class="label">Your Login Email</label>
                                        <InputText @bind-Value="registerModel.Email" class="input-field" placeholder="you@acme.com" />
                                        <ValidationMessage For="@(() => registerModel.Email)" class="text-xs text-rose-500 mt-1" />
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="label">Password</label>
                                            <InputText type="password" @bind-Value="registerModel.Password" class="input-field" placeholder="••••••" />
                                        </div>
                                        <div>
                                            <label class="label">Confirm</label>
                                            <InputText type="password" @bind-Value="registerModel.ConfirmPassword" class="input-field" placeholder="••••••" />
                                        </div>
                                    </div>
                                    <ValidationMessage For="@(() => registerModel.Password)" class="text-xs text-rose-500 mt-1" />
                                </div>
                            </div>

                            <button type="submit" disabled="@isBusy" class="btn-primary w-full shadow-lg shadow-indigo-100">
                                @(isBusy ? "Setting up Environment..." : "Create Organization Account")
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <form method="post" action="/auth/login" class="space-y-5 animate-in fade-in slide-in-from-left-4 duration-300">
                        <AntiforgeryToken /> <div>
                            <label class="label">Login Email</label>
                            <input name="Email" type="email" class="input-field" placeholder="you@company.com" required />
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="label">Password</label>
                                <a href="#" class="text-xs font-semibold text-indigo-600 hover:underline">Forgot password?</a>
                            </div>
                            <input name="Password" type="password" class="input-field" placeholder="••••••••" required />
                        </div>

                        <button type="submit" class="btn-primary w-full">
                            Sign In to Dashboard
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.25rem;
    }

    .input-field {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        background-color: #ffffff;
        color: #1e293b;
    }

        .input-field:focus {
            outline: none;
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        }

        .input-field::placeholder {
            color: #cbd5e1;
        }

    .btn-primary {
        background-color: #4f46e5;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.2s;
        box-shadow: 0 4px 6px -1px rgba(79, 70, 229, 0.2);
    }

        .btn-primary:hover {
            background-color: #4338ca;
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-primary:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }
</style>

@code {
    // Captures error messages sent back from the Controller via URL
    [SupplyParameterFromQuery(Name = "error")]
    public string ErrorMessage { get; set; } = "";

    private bool isRegistering = false;
    private bool isBusy = false;
    private bool showSuccess = false;

    private RegisterTenantDto registerModel = new();

    private void ToggleMode()
    {
        isRegistering = !isRegistering;
        ErrorMessage = "";
        showSuccess = false;
    }

    private async Task HandleRegistration()
    {
        isBusy = true;
        ErrorMessage = "";

        var (success, msg) = await AuthService.RegisterTenantAsync(registerModel);

        if (success)
        {
            showSuccess = true;
            isRegistering = false; // Switch to login view
            registerModel = new(); // Clear data
        }
        else
        {
            ErrorMessage = msg;
        }
        isBusy = false;
    }
}