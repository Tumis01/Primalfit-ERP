@page "/hr/payroll-manager"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject PayrollService PayrollService
@inject PayrollJournalService JournalService
@inject SegCoaService GLService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <!-- HEADER -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Payroll Engine</h1>
            <p class="text-sm text-slate-500 mt-1">Generate runs, adjust bonuses, approve, and disburse to the General Ledger.</p>
        </div>

        <div class="flex gap-3 items-center">
            @if (selectedRun == null)
            {
                <input type="month" @bind="newPeriodDate" class="input-class w-40 h-[42px]" />
                <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                    <Authorized>
                        <button @onclick="GeneratePayroll" disabled="@isBusy" class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800 transition-all flex items-center gap-2 active:scale-95 disabled:opacity-50 h-[42px]">
                            @if (isBusy)
                            {
                                <span class="animate-spin">↻</span>
                            }
                            <span>Generate Run</span>
                        </button>
                    </Authorized>
                </PermissionGate>
            }
            else
            {
                <button @onclick="CloseRunDetails" class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 font-bold rounded-xl hover:bg-slate-50 transition-all h-[42px]">
                    ← Back to Runs
                </button>
                @if (selectedRun.Status == PayrollRunStatus.Draft || IsRejected(selectedRun.GLBatchId))
                {
                    <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                        <Authorized>
                            <button @onclick="ApprovePayroll" disabled="@isBusy" class="px-5 py-2.5 bg-indigo-600 text-white font-bold rounded-xl shadow-md hover:bg-indigo-700 transition-all flex items-center gap-2 disabled:opacity-50 h-[42px]">
                                @if (isBusy)
                                {
                                    <span class="animate-spin">↻</span>
                                }
                                @(IsRejected(selectedRun.GLBatchId) ? "Resubmit Accrual for GL Review" : "Submit Accrual for GL Review")
                            </button>
                        </Authorized>
                    </PermissionGate>
                }
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="bg-rose-50 text-rose-700 p-4 rounded-xl font-bold text-sm border border-rose-200">
            @error
        </div>
    }

    @if (selectedRun != null && IsRejected(selectedRun.GLBatchId))
    {
        <div class="bg-rose-50 border border-rose-200 text-rose-800 p-4 rounded-xl text-sm">
            <div class="font-black uppercase tracking-wider text-xs mb-1">Payroll accrual rejected</div>
            <div>@(GetBatch(selectedRun.GLBatchId)?.RejectionReason ?? "The reviewer returned this batch for correction.")</div>
            <div class="text-xs mt-2 font-semibold">Adjust the payroll details, then resubmit it for GL review. No ledger entry was posted.</div>
        </div>
    }

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading payroll data...</div>
    }
    else if (selectedRun != null)
    {
        <!-- RUN DETAILS (MASTER-DETAIL VIEW) -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            
            <!-- Summary Card -->
            <div class="md:col-span-1 space-y-4">
                <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-sm border border-slate-800">
                    <div class="text-[10px] uppercase font-black tracking-widest text-slate-400 mb-1">Payroll Period</div>
                    <div class="flex justify-between items-start mb-6">
                        <div class="text-2xl font-bold">@selectedRun.Period</div>
                        <span class="px-2 py-1 text-[10px] uppercase font-bold rounded-md @(selectedRun.Status == PayrollRunStatus.Draft ? "bg-amber-500/20 text-amber-300" : "bg-emerald-500/20 text-emerald-300")">
                            @selectedRun.Status
                        </span>
                    </div>
                    
                    <div class="space-y-3">
                        <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                            <span class="text-xs text-slate-400">Total Gross</span>
                            <span class="font-mono font-bold text-sm">@selectedRun.TotalGrossPay.ToString("N4")</span>
                        </div>
                        <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                            <span class="text-xs text-slate-400">Total Deductions</span>
                            <span class="font-mono font-bold text-sm text-rose-400">@selectedRun.TotalDeductions.ToString("N4")</span>
                        </div>
                        <div class="flex justify-between items-center pt-2">
                            <span class="text-sm font-bold text-emerald-400">Net Payable</span>
                            <span class="font-mono font-black text-lg text-emerald-400">@selectedRun.TotalNetPay.ToString("N4")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Employee Breakdown & Action Bar -->
            <div class="md:col-span-3 space-y-6">
                
                <!-- Action Bar for Approved Runs -->
                @if (selectedRun.Status != PayrollRunStatus.Draft)
                {
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-wrap items-center gap-3">
                        <span class="text-[10px] font-black uppercase text-slate-400 mr-2 tracking-widest">Financial Actions:</span>
                        
                        @if ((selectedRun.Status == PayrollRunStatus.Approved || selectedRun.Status == PayrollRunStatus.Paid) &&
                             (!selectedRun.DisbursementGLBatchId.HasValue || IsRejected(selectedRun.DisbursementGLBatchId)))
{
                            <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                                <Authorized>
                                    <button @onclick='() => OpenPaymentModal("Disburse")' class="px-4 py-2 bg-emerald-600 text-white text-sm font-bold rounded-lg hover:bg-emerald-700 shadow-sm transition-colors">
                                        @(IsRejected(selectedRun.DisbursementGLBatchId) ? "Resubmit Salary Disbursement" : "Submit Salary Disbursement")
                                    </button>
                                </Authorized>
                            </PermissionGate>
                        }
                        else if (GetBatch(selectedRun.DisbursementGLBatchId)?.Status == BatchStatus.Posted)
                        {
                            <span class="px-4 py-2 bg-emerald-50 text-emerald-700 text-sm font-bold rounded-lg border border-emerald-200 flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Salaries Disbursed
                            </span>
                        }
                        else if (selectedRun.DisbursementGLBatchId.HasValue)
                        {
                            <span class="px-4 py-2 bg-amber-50 text-amber-700 text-sm font-bold rounded-lg border border-amber-200">Salary disbursement awaiting GL review</span>
                        }

                        @if ((!selectedRun.IsPayeRemitted || IsRejected(selectedRun.PayeRemittanceGLBatchId)) && selectedRun.PayrollItems.Sum(i => i.PAYETax) > 0)
                        {
                            <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                                <Authorized>
                                    <button @onclick='() => OpenPaymentModal("PAYE")' class="px-4 py-2 bg-slate-900 text-white text-sm font-bold rounded-lg hover:bg-slate-800 shadow-sm transition-colors">
                                        @(IsRejected(selectedRun.PayeRemittanceGLBatchId) ? "Resubmit PAYE for Review" : "Submit PAYE for Review")
                                    </button>
                                </Authorized>
                            </PermissionGate>
                        }
                        else if (GetBatch(selectedRun.PayeRemittanceGLBatchId)?.Status == BatchStatus.Posted)
                        {
                            <span class="px-3 py-2 text-slate-400 text-xs font-bold flex items-center gap-1">
                                <svg class="w-3 h-3 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> PAYE Remitted
                            </span>
                        }
                        else if (selectedRun.PayeRemittanceGLBatchId.HasValue)
                        {
                            <span class="px-3 py-2 text-amber-700 text-xs font-bold">PAYE awaiting GL review</span>
                        }
                        
                        @if ((!selectedRun.IsPensionRemitted || IsRejected(selectedRun.PensionRemittanceGLBatchId)) && selectedRun.PayrollItems.Sum(i => i.EmployeePension + i.EmployerPension) > 0)
                        {
                            <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                                <Authorized>
                                    <button @onclick='() => OpenPaymentModal("Pension")' class="px-4 py-2 bg-slate-900 text-white text-sm font-bold rounded-lg hover:bg-slate-800 shadow-sm transition-colors">
                                        @(IsRejected(selectedRun.PensionRemittanceGLBatchId) ? "Resubmit Pension for Review" : "Submit Pension for Review")
                                    </button>
                                </Authorized>
                            </PermissionGate>
                        }
                        else if (GetBatch(selectedRun.PensionRemittanceGLBatchId)?.Status == BatchStatus.Posted)
                        {
                            <span class="px-3 py-2 text-slate-400 text-xs font-bold flex items-center gap-1">
                                <svg class="w-3 h-3 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> Pension Remitted
                            </span>
                        }
                        else if (selectedRun.PensionRemittanceGLBatchId.HasValue)
                        {
                            <span class="px-3 py-2 text-amber-700 text-xs font-bold">Pension awaiting GL review</span>
                        }
                    </div>
                }

                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-sm text-left">
                            <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                                <tr>
                                    <th class="p-4 pl-6">Employee</th>
                                    <th class="p-4 text-right">Base Gross</th>
                                    <th class="p-4 text-right text-indigo-600">+ Earnings</th>
                                    <th class="p-4 text-right text-rose-600">- Deductions</th>
                                    <th class="p-4 text-right">Net Pay</th>
                                    <th class="p-4 text-center pr-6">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var item in selectedRun.PayrollItems)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors group">
                                        <td class="p-4 pl-6">
                                            <div class="font-bold text-slate-900">@item.Employee?.FirstName @item.Employee?.LastName</div>
                                            <div class="text-[10px] text-slate-500">@item.Employee?.EmployeeCode</div>
                                        </td>
                                        <td class="p-4 text-right font-mono text-slate-600">@item.GrossPay.ToString("N4")</td>
                                        <td class="p-4 text-right font-mono font-bold text-indigo-600">@item.OtherEarnings.ToString("N4")</td>
                                        <td class="p-4 text-right font-mono font-bold text-rose-600">@((item.PAYETax + item.EmployeePension + item.OtherDeductions).ToString("N4"))</td>
                                        <td class="p-4 text-right font-mono font-black text-emerald-600">@item.NetPay.ToString("N4")</td>
                                        <td class="p-4 text-center pr-6">
                                            @if (selectedRun.Status == PayrollRunStatus.Draft)
                                            {
                                                <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                                                    <Authorized>
                                                        <button @onclick="() => OpenAdjustmentModal(item)" class="text-[10px] uppercase font-bold text-slate-500 border border-slate-200 px-2 py-1 rounded hover:bg-slate-100 opacity-0 group-hover:opacity-100 transition-opacity">
                                                            Adjust
                                                        </button>
                                                    </Authorized>
                                                </PermissionGate>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- LIST OF RUNS -->
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
            <table class="w-full text-sm text-left">
                <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                    <tr>
                        <th class="p-4 pl-6">Period</th>
                        <th class="p-4">Run Date</th>
                        <th class="p-4 text-right">Gross Pay</th>
                        <th class="p-4 text-right">Net Pay</th>
                        <th class="p-4 text-center">Status</th>
                        <th class="p-4 text-right pr-6"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!runs.Any())
                    {
                        <tr><td colspan="6" class="p-12 text-center text-slate-400">No payroll runs found. Use 'Generate Run' to start.</td></tr>
                    }
                    else
                    {
                        @foreach (var run in runs)
                        {
                            <tr class="hover:bg-slate-50 transition-colors cursor-pointer" @onclick="() => LoadRunDetails(run.Id)">
                                <td class="p-4 pl-6 font-bold text-slate-900">@run.Period</td>
                                <td class="p-4 text-slate-500">@run.RunDate.ToString("MMM dd, yyyy")</td>
                                <td class="p-4 text-right font-mono text-slate-700">@run.TotalGrossPay.ToString("N4")</td>
                                <td class="p-4 text-right font-mono font-bold text-emerald-600">@run.TotalNetPay.ToString("N4")</td>
                                <td class="p-4 text-center">
                                    <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-full 
                                        @(run.Status == PayrollRunStatus.Draft ? "bg-amber-100 text-amber-700" : 
                                          run.Status == PayrollRunStatus.Paid ? "bg-emerald-100 text-emerald-700" : "bg-indigo-100 text-indigo-700")">
                                        @run.Status
                                    </span>
                                </td>
                                <td class="p-4 text-right pr-6 text-slate-400 hover:text-indigo-600">
                                    <svg class="w-5 h-5 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- MODAL: ADD EARNING/DEDUCTION -->
    @if (showAdjModal && selectedItemForAdj != null)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 animate-in fade-in">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
                <h3 class="text-lg font-bold text-slate-900 mb-1">Adjust Payroll</h3>
                <p class="text-xs text-slate-500 mb-6 border-b border-slate-100 pb-3">@selectedItemForAdj.Employee?.FirstName @selectedItemForAdj.Employee?.LastName</p>

                <div class="space-y-4">
                    <div>
                        <label class="label">Adjustment Type</label>
                        <select @bind="adjIsEarning" class="input-class font-bold">
                            <option value="true">Earning (Bonus, Overtime)</option>
                            <option value="false">Deduction (Loan, Fine)</option>
                        </select>
                    </div>
                    <div>
                        <label class="label">Description</label>
                        <input type="text" @bind="adjDesc" class="input-class" placeholder="e.g. Sales Bonus" />
                    </div>
                    <div>
                        <label class="label">Amount</label>
                        <input type="number" step="0.0001" @bind="adjAmt" class="input-class font-mono" placeholder="0.0000" />
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-slate-100">
                    <button @onclick="() => showAdjModal = false" disabled="@isBusy" class="px-4 py-2 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-lg">Cancel</button>
                    <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                        <Authorized>
                            <button @onclick="ApplyAdjustment" disabled="@isBusy" class="px-5 py-2 bg-slate-900 text-white text-sm font-bold rounded-lg shadow hover:bg-slate-800 disabled:opacity-50 flex items-center gap-2">
                                @if (isBusy)
                                {
                                    <span class="animate-spin">↻</span>
                                }
                                Apply
                            </button>
                        </Authorized>
                    </PermissionGate>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: PAYMENT / REMITTANCE -->
    @if (showPaymentModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 animate-in fade-in">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
                <h3 class="text-lg font-bold text-slate-900 mb-4 border-b border-slate-100 pb-3">
                    @(paymentType == "Disburse" ? "Disburse Net Salaries" : $"Remit {paymentType}")
                </h3>

                <div class="space-y-4">
                    <div>
                        <label class="label">Payment Date</label>
                        <input type="date" @bind="paymentDate" class="input-class" />
                    </div>
                    <div>
                        <!-- Assuming SearchableGlAccount exists in your shared components, otherwise use a select -->
                        <label class="label">Paying Bank Account (Cr)</label>
                        <select @bind="selectedBankId" class="input-class">
                            <option value="@Guid.Empty">-- Select Bank Account --</option>
                            @foreach (var acc in bankAccounts)
                            {
                                <option value="@acc.Id">@acc.AccountCode - @acc.Description</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="label">Payment Reference</label>
                        <input type="text" @bind="paymentReference" class="input-class" placeholder="e.g., TRF-10293" />
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-slate-100">
                    <button @onclick="() => showPaymentModal = false" disabled="@isBusy" class="px-4 py-2 text-sm font-bold text-slate-500 hover:bg-slate-100 rounded-lg">Cancel</button>
                    <PermissionGate Key="HR_MANAGEMENT_MANAGE">
                        <Authorized>
                            <button @onclick="ProcessPayment" disabled="@(isBusy || selectedBankId == Guid.Empty || string.IsNullOrWhiteSpace(paymentReference))" class="px-5 py-2 bg-emerald-600 text-white text-sm font-bold rounded-lg shadow hover:bg-emerald-700 disabled:opacity-50 flex items-center gap-2">
                                @if (isBusy)
                                {
                                    <span class="animate-spin">↻</span>
                                }
                                Confirm & Post GL
                            </button>
                        </Authorized>
                    </PermissionGate>
                </div>
            </div>
        </div>
    }

</div>

<style>
    .label { display: block; font-size: 0.70rem; font-weight: 800; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem; letter-spacing: 0.05em; }
    .input-class { width: 100%; border-radius: 0.5rem; border: 1px solid #cbd5e1; padding: 0.5rem 0.75rem; font-size: 0.875rem; transition: all 0.2s; outline: none; }
    .input-class:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15); }
</style>

@code {
    private Guid currentCompanyId = Guid.Empty;
    private string currentUserId = "";
    private bool isLoading = true;
    private bool isBusy = false;
    private string? error;

    // State
    private List<PayrollRun> runs = new();
    private PayrollRun? selectedRun;
    private Dictionary<Guid, GLBatch> batchCache = new();
    private DateTime newPeriodDate = DateTime.Today;

    private GLBatch? GetBatch(Guid? batchId) =>
        batchId.HasValue && batchCache.TryGetValue(batchId.Value, out var batch) ? batch : null;

    private bool IsRejected(Guid? batchId) => GetBatch(batchId)?.Status == BatchStatus.Rejected;

    // Adjustment Modal State
    private bool showAdjModal = false;
    private PayrollItem? selectedItemForAdj;
    private bool adjIsEarning = true;
    private string adjDesc = "";
    private decimal adjAmt = 0;

    // Payment Modal State
    private bool showPaymentModal = false;
    private string paymentType = ""; // "Disburse", "PAYE", "Pension"
    private Guid selectedBankId = Guid.Empty;
    private DateTime paymentDate = DateTime.Today;
    private string paymentReference = "";
    private List<SegChartOfAccount> bankAccounts = new();

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("HR_MANAGEMENT_MANAGE")) // Allowed if they have either reporting or direct fixed asset rights
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;
            
            await LoadRuns();

            // Load Bank Accounts (Assuming you have a way to filter to just Banks/Cash)
            var allAccounts = await GLService.GetActiveCoaAsync(currentCompanyId);
            // In a real app, you might filter by SegAccountType that represents Cash/Bank.
            // For now, we load all active accounts, but you should refine this filter.
            bankAccounts = allAccounts.OrderBy(a => a.AccountCode).ToList(); 
        }
        isLoading = false;
    }

    private async Task LoadRuns()
    {
        runs = await PayrollService.GetPayrollRunsAsync(currentCompanyId);
        await using var ctx = await DbFactory.CreateDbContextAsync();
        batchCache = await ctx.GLBatches
            .Where(b => b.CompanyId == currentCompanyId)
            .ToDictionaryAsync(b => b.Id);
    }

    private async Task LoadRunDetails(Guid runId)
    {
        error = null;
        selectedRun = await PayrollService.GetPayrollRunDetailsAsync(runId, currentCompanyId);
    }

    private void CloseRunDetails()
    {
        selectedRun = null;
        error = null;
    }

    private async Task GeneratePayroll()
    {
        isBusy = true; error = null;
        string periodStr = newPeriodDate.ToString("MMM-yyyy"); 

        var err = await PayrollService.GeneratePayrollRunAsync(currentCompanyId, periodStr);
        
        if (string.IsNullOrEmpty(err))
        {
            await LoadRuns();
        }
        else
        {
            error = err;
        }
        isBusy = false;
    }

    private async Task ApprovePayroll()
    {
        if (selectedRun == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "This will lock the payroll and post liabilities to the General Ledger. Proceed?")) return;

        isBusy = true; error = null;
        var err = await JournalService.ApproveAndPostPayrollAsync(selectedRun.Id, currentUserId);
        
        if (!string.IsNullOrEmpty(err)) 
        { 
            error = err; 
        }
        else 
        { 
            await LoadRunDetails(selectedRun.Id); // Reload to get updated status
        }
        isBusy = false;
    }

    // --- ADJUSTMENT LOGIC ---
    private void OpenAdjustmentModal(PayrollItem item)
    {
        selectedItemForAdj = item;
        adjIsEarning = true;
        adjDesc = "";
        adjAmt = 0;
        showAdjModal = true;
    }

    private async Task ApplyAdjustment()
    {
        if (selectedItemForAdj == null || string.IsNullOrWhiteSpace(adjDesc) || adjAmt <= 0) return;

        isBusy = true; error = null;
        var err = await PayrollService.AddCustomEarningOrDeductionAsync(selectedItemForAdj.Id, adjIsEarning, adjDesc, adjAmt);
        
        if (string.IsNullOrEmpty(err))
        {
            showAdjModal = false;
            await LoadRunDetails(selectedRun!.Id); // Refresh to show updated net pay
        }
        else
        {
            error = err;
        }
        isBusy = false;
    }

    // --- PAYMENT/REMITTANCE LOGIC ---
    private void OpenPaymentModal(string type)
    {
        paymentType = type;
        selectedBankId = Guid.Empty;
        paymentDate = DateTime.Today;
        paymentReference = "";
        showPaymentModal = true;
    }

    private async Task ProcessPayment()
    {
        if (selectedRun == null || selectedBankId == Guid.Empty || string.IsNullOrWhiteSpace(paymentReference)) return;

        isBusy = true; error = null;
        string err = "";

        // Passed currentUserId to all 3 paths
        if (paymentType == "Disburse")
            err = await JournalService.DisburseSalariesAsync(selectedRun.Id, selectedBankId, paymentDate, paymentReference, currentUserId);
        else if (paymentType == "PAYE")
            err = await JournalService.RemitStatutoryAsync(selectedRun.Id, selectedBankId, paymentDate, paymentReference, true, currentUserId);
        else if (paymentType == "Pension")
            err = await JournalService.RemitStatutoryAsync(selectedRun.Id, selectedBankId, paymentDate, paymentReference, false, currentUserId);

        if (string.IsNullOrEmpty(err))
        {
            showPaymentModal = false;
            await LoadRunDetails(selectedRun.Id); // Refresh to update status badges
        }
        else
        {
            error = err;
        }
        isBusy = false;
    }
}
