@page "/gl/bank-reconciliation"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject ReconciliationService ReconService
@inject GLSetupService GLService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    @if (vm != null)
    {
        <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-lg">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h2 class="text-xl font-bold">@accountName</h2>
                    <p class="text-sm text-slate-400">Statement: @vm.Header.StatementDate.ToString("MMM dd, yyyy")</p>
                </div>
                <div class="text-right">
                    <div class="text-[10px] uppercase tracking-widest text-slate-400">Difference</div>
                    <div class="text-3xl font-mono font-bold @(vm.Difference == 0 ? "text-emerald-400" : "text-rose-400")">
                        @vm.Difference.ToString("N2")
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-center border-t border-slate-700 pt-4">
                <div>
                    <div class="text-[10px] uppercase text-slate-400">Bank Statement Bal</div>
                    <div class="text-lg font-bold">@vm.Header.StatementEndingBalance.ToString("N2")</div>
                </div>
                <div>
                    <div class="text-[10px] uppercase text-emerald-400">+ Deposits in Transit</div>
                    <div class="text-lg font-bold">@vm.DepositsInTransit.ToString("N2")</div>
                </div>
                <div>
                    <div class="text-[10px] uppercase text-rose-400">- Outstanding Checks</div>
                    <div class="text-lg font-bold">(@vm.OutstandingChecks.ToString("N2"))</div>
                </div>
                <div class="bg-slate-800 rounded-lg p-1">
                    <div class="text-[10px] uppercase text-slate-300">Adjusted Bank Bal</div>
                    <div class="text-lg font-bold text-white">@vm.AdjustedBankBalance.ToString("N2")</div>
                </div>
            </div>

            <div class="mt-2 text-center text-xs text-slate-400">
                Target Book Balance: <span class="font-mono text-white">@vm.Header.BookBalanceAtDate.ToString("N2")</span>
            </div>
        </div>
    }

    <div class="flex justify-between items-center bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
        @if (vm == null)
        {
            <div class="flex gap-4 w-full">
                <select @bind="selectedBankAccountId" class="input-class w-64">
                    <option value="@Guid.Empty">-- Select Bank Account --</option>
                    @foreach (var acc in bankAccounts)
                    {
                        <option value="@acc.Id">@acc.AccountCode - @acc.AccountName</option>
                    }
                </select>
                <input type="date" @bind="statementDate" class="input-class w-40" />
                <input type="number" @bind="endingBalance" placeholder="End Balance" class="input-class w-40" />
                <InputFile OnChange="LoadFile" class="text-sm file:bg-slate-100 file:border-0 file:rounded-full file:px-4 file:text-xs" />
                <button @onclick="ImportStatement" class="btn-primary ml-auto">Import Statement</button>
            </div>
        }
        else
        {
            <div class="flex gap-2">
                <button @onclick="AutoMatch" class="btn-secondary flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    Auto Match
                </button>
            </div>
            <div>
                <button @onclick="Finalize" disabled="@(vm.Difference != 0)"
                        class="btn-primary disabled:opacity-50 disabled:cursor-not-allowed">
                    Finalize & Approve
                </button>
            </div>
        }
    </div>

    @if (vm != null)
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 h-[600px]">

            <div class="card flex flex-col">
                <div class="card-header bg-amber-50 text-amber-800">
                    <span>Unmatched Bank Lines (Unrecorded)</span>
                    <span class="text-xs opacity-70">@vm.UnmatchedBankLines.Count items</span>
                </div>
                <div class="flex-1 overflow-auto p-0">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-white border-b sticky top-0">
                            <tr>
                                <th class="p-3">Date</th>
                                <th class="p-3">Desc/Ref</th>
                                <th class="p-3 text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in vm.UnmatchedBankLines)
                            {
                                <tr class="hover:bg-slate-50 cursor-pointer @(selectedBankId == line.Id ? "bg-indigo-50 ring-1 ring-indigo-200" : "")"
                                    @onclick="() => selectedBankId = line.Id">
                                    <td class="p-3">@line.TransactionDate</td>
                                    <td class="p-3">
                                        <div class="font-bold">@line.Description</div>
                                        <div class="text-slate-400">@line.Reference</div>
                                    </td>
                                    <td class="p-3 text-right font-mono">@line.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card flex flex-col">
                <div class="card-header bg-indigo-50 text-indigo-800">
                    <span>Outstanding Book Entries</span>
                    <span class="text-xs opacity-70">@vm.OutstandingGLTransactions.Count items</span>
                </div>
                <div class="flex-1 overflow-auto p-0">
                    <table class="w-full text-xs text-left">
                        <thead class="bg-white border-b sticky top-0">
                            <tr>
                                <th class="p-3">Date</th>
                                <th class="p-3">Ref/Narration</th>
                                <th class="p-3 text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var txn in vm.OutstandingGLTransactions)
                            {
                                var netAmount = txn.Debit - txn.Credit;
                                <tr class="hover:bg-slate-50 cursor-pointer @(selectedGlId == txn.Id ? "bg-indigo-50 ring-1 ring-indigo-200" : "")"
                                    @onclick="() => selectedGlId = txn.Id">
                                    <td class="p-3">@txn.PostingDate</td>
                                    <td class="p-3">
                                        <div class="font-bold">@txn.Narration</div>
                                    </td>
                                    <td class="p-3 text-right font-mono @(netAmount < 0 ? "text-rose-600" : "text-emerald-600")">
                                        @netAmount.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (selectedBankId != Guid.Empty && selectedGlId != Guid.Empty)
        {
            <div class="fixed bottom-10 left-1/2 -translate-x-1/2 animate-in slide-in-from-bottom-4">
                <button @onclick="ManualMatch" class="bg-slate-900 text-white px-8 py-3 rounded-full shadow-2xl font-bold flex items-center gap-2 hover:scale-105 transition-transform">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                    Link Selected
                </button>
            </div>
        }
    }
</div>

<style>
    .input-class {
        border: 1px solid #cbd5e1;
        border-radius: 0.5rem;
        padding: 0.5rem;
        font-size: 0.875rem;
    }

    .btn-primary {
        background-color: #0f172a;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-weight: bold;
        font-size: 0.875rem;
    }

    .btn-secondary {
        background-color: white;
        border: 1px solid #cbd5e1;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-weight: bold;
        font-size: 0.875rem;
    }

    .card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .card-header {
        padding: 0.75rem 1.25rem;
        font-weight: 700;
        font-size: 0.875rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
</style>

@code {
    private Guid currentCompanyId;
    private string currentUserId = "";

    // Selection
    private List<GLChartOfAccount> bankAccounts = new();
    private Guid selectedBankAccountId;
    private string accountName => bankAccounts.FirstOrDefault(a => a.Id == selectedBankAccountId)?.AccountName ?? "";
    private DateOnly statementDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal endingBalance;
    private IBrowserFile? uploadFile;

    // ViewModel
    private ReconViewModel? vm;
    private Guid selectedBankId;
    private Guid selectedGlId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;
            var coa = await GLService.GetChartOfAccountsAsync(currentCompanyId);
            bankAccounts = coa.Where(a => a.AccountCode.StartsWith("1")).ToList(); // Filter Assets/Banks
        }
    }

    private void LoadFile(InputFileChangeEventArgs e) => uploadFile = e.File;

    private async Task ImportStatement()
    {
        if (selectedBankAccountId == Guid.Empty || uploadFile == null) return;

        using var stream = uploadFile.OpenReadStream(2 * 1024 * 1024); // 2MB max
        var (err, id) = await ReconService.ImportStatementAsync(currentCompanyId, selectedBankAccountId, statementDate, endingBalance, stream, currentUserId);

        if (string.IsNullOrEmpty(err) && id != null)
        {
            vm = await ReconService.GetReconWorkspaceAsync(id.Value);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task AutoMatch()
    {
        if (vm == null) return;
        int count = await ReconService.RunAutoMatchAsync(vm.Header.Id);
        await JS.InvokeVoidAsync("alert", $"Auto-Matched {count} items.");
        vm = await ReconService.GetReconWorkspaceAsync(vm.Header.Id);
    }

    private async Task ManualMatch()
    {
        if (selectedBankId == Guid.Empty || selectedGlId == Guid.Empty) return;
        await ReconService.ToggleMatchAsync(selectedBankId, selectedGlId, true);
        selectedBankId = Guid.Empty; selectedGlId = Guid.Empty;
        vm = await ReconService.GetReconWorkspaceAsync(vm!.Header.Id);
    }

    private async Task Finalize()
    {
        if (vm == null) return;
        var res = await ReconService.FinalizeAsync(vm.Header.Id, currentUserId);
        await JS.InvokeVoidAsync("alert", res);
        if (res == "Success") vm = null; // Close workspace
    }
}