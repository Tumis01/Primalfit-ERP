@page "/gl/bank-reconciliation"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services

@inject ReconciliationService ReconService
@inject GLSetupService SetupService
@inject CompanyApiService CompanyService
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 p-6">

    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Bank Reconciliation</h1>
            <p class="text-sm text-slate-500">Import a statement, match lines, create adjustments, then finalize to lock transactions.</p>
        </div>

        <div class="bg-white p-3 rounded-2xl border border-slate-200 shadow-sm text-right">
            <span class="block text-xs uppercase text-slate-500 font-bold">Status</span>
            <span class="text-sm font-semibold text-slate-800">
                @(vm?.Reconciliation?.Status.ToString() ?? "Not started")
            </span>

            <div class="mt-2">
                <span class="block text-xs uppercase text-slate-500 font-bold">Unmatched Lines</span>
                <span class="text-xl font-mono font-bold @(UnmatchedCount == 0 ? "text-emerald-600" : "text-red-600")">
                    @UnmatchedCount
                </span>
            </div>
        </div>
    </div>

    @if (reconId == null)
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
            <div class="lg:col-span-4">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Company</label>
                <select class="w-full rounded-xl border-slate-200" @bind="selectedCompanyId" @bind:after="OnCompanyChanged">
                    <option value="@Guid.Empty">-- Select Company --</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.CompanyDetailsId">@c.CompanyName</option>
                    }
                </select>
            </div>

            <div class="lg:col-span-4">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Bank Account</label>
                <select class="w-full rounded-xl border-slate-200" @bind="selectedBankAccountId" disabled="@(!HasCompany)">
                    <option value="@Guid.Empty">-- Select Account --</option>
                    @foreach (var a in bankAccounts)
                    {
                        <option value="@a.Id">@a.AccountCode - @a.AccountName</option>
                    }
                </select>
            </div>

            <div class="lg:col-span-2">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Statement Date</label>
                <InputDate class="w-full rounded-xl border-slate-200" @bind-Value="statementDate" />
            </div>

            <div class="lg:col-span-2">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Ending Balance</label>
                <InputNumber class="w-full rounded-xl border-slate-200" @bind-Value="endingBalance" />
            </div>

            <div class="lg:col-span-8">
                <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Upload CSV</label>
                <InputFile OnChange="HandleFileUpload" class="w-full text-sm text-slate-500 file:rounded-full file:border-0 file:bg-indigo-50 file:text-indigo-700" />
            </div>

            <div class="lg:col-span-4 flex items-end justify-end">
                <button @onclick="StartRecon" disabled="@(!CanStartRecon)" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                    Start Reconciliation
                </button>
            </div>
        </div>
    }
    else if (vm != null)
    {
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 bg-slate-50 border border-slate-200 rounded-2xl p-4">
            <div class="flex flex-wrap gap-2">
                <button @onclick="AutoMatch" class="rounded-xl bg-white border border-slate-200 px-4 py-2 text-sm font-semibold text-indigo-600 shadow-sm hover:bg-slate-50">✨ Auto Match</button>
                <button @onclick="OpenAdjustment" class="rounded-xl bg-white border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50">+ Create Adjustment</button>
            </div>
            <button @onclick="Finalize" disabled="@(UnmatchedCount != 0)" class="rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700 disabled:opacity-50">Finalize & Lock</button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="px-5 py-4 border-b border-slate-100 bg-slate-50 font-bold text-slate-800">Bank Statement</div>
                <div class="overflow-x-auto max-h-[500px]">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-white text-xs uppercase font-bold text-slate-500 border-b border-slate-100 sticky top-0">
                            <tr><th class="px-5 py-3">Date</th><th class="px-5 py-3">Desc</th><th class="px-5 py-3 text-right">Amount</th></tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var line in vm.Reconciliation.StatementLines.Where(x => !x.IsMatched))
                            {
                                <tr class="hover:bg-slate-50 cursor-pointer @(selectedBankLine?.Id == line.Id ? "bg-indigo-50" : "")" @onclick="() => selectedBankLine = line">
                                    <td class="px-5 py-3">@line.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="px-5 py-3">@line.Description</td>
                                    <td class="px-5 py-3 text-right font-mono">@line.Amount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="px-5 py-4 border-b border-slate-100 bg-slate-50 font-bold text-slate-800">General Ledger</div>
                <div class="overflow-x-auto max-h-[500px]">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-white text-xs uppercase font-bold text-slate-500 border-b border-slate-100 sticky top-0">
                            <tr><th class="px-5 py-3">Date</th><th class="px-5 py-3">Desc</th><th class="px-5 py-3 text-right">Net</th></tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var txn in vm.CandidateGLTransactions)
                            {
                                <tr class="hover:bg-slate-50 cursor-pointer @(selectedTxn?.Id == txn.Id ? "bg-indigo-50" : "")" @onclick="() => selectedTxn = txn">
                                    <td class="px-5 py-3">@txn.PostingDate.ToString("yyyy-MM-dd")</td>
                                    <td class="px-5 py-3">@txn.Narration</td>
                                    <td class="px-5 py-3 text-right font-mono">@((txn.Debit - txn.Credit).ToString("N2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (selectedBankLine != null && selectedTxn != null)
        {
            <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50">
                <button @onclick="ManualMatch" class="rounded-full bg-indigo-600 px-8 py-3 text-sm font-bold text-white shadow-xl hover:bg-indigo-700">Match Selected</button>
            </div>
        }
    }
</div>

@if (showAdjustment)
{
    <div class="fixed inset-0 z-50 bg-slate-900/30 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">
            <h3 class="text-lg font-bold mb-4">Create Adjustment</h3>
            <div class="space-y-4">
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">Description</label>
                    <InputText class="w-full rounded-xl border-slate-200" @bind-Value="adjDescription" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">Amount</label>
                    <InputNumber class="w-full rounded-xl border-slate-200" @bind-Value="adjAmount" />
                </div>
                <div>
                    <label class="text-xs font-bold text-slate-500 uppercase">Expense Account</label>
                    <select class="w-full rounded-xl border-slate-200" @bind="adjExpenseAccountId">
                        <option value="@Guid.Empty">-- Select --</option>
                        @foreach (var a in expenseAccounts)
                        {
                            <option value="@a.Id">@a.AccountName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-6 flex justify-end gap-2">
                <button @onclick="CloseAdjustment" class="px-4 py-2 border rounded-xl">Cancel</button>
                <button @onclick="SaveAdjustment" disabled="@(!CanSaveAdjustment)" class="px-4 py-2 bg-indigo-600 text-white rounded-xl disabled:opacity-50">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CompanyDetails> companies = new();
    private Guid selectedCompanyId = Guid.Empty;
    private Guid selectedBankAccountId = Guid.Empty;
    private List<GLChartOfAccount> bankAccounts = new();
    private List<GLChartOfAccount> expenseAccounts = new();

    private DateOnly statementDate = DateOnly.FromDateTime(DateTime.Today);
    private decimal endingBalance;
    private IBrowserFile? uploadedFile;

    private Guid? reconId;
    private ReconViewModel? vm; // View Model

    private BankStatementLine? selectedBankLine;
    private GLTransaction? selectedTxn;

    private bool showAdjustment = false;
    private string adjDescription = "";
    private decimal adjAmount = 0;
    private Guid adjExpenseAccountId = Guid.Empty;

    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool CanStartRecon => HasCompany && selectedBankAccountId != Guid.Empty && uploadedFile != null;
    private int UnmatchedCount => vm?.Reconciliation?.StatementLines?.Count(l => !l.IsMatched) ?? 0;
    private bool CanSaveAdjustment => !string.IsNullOrWhiteSpace(adjDescription) && adjAmount > 0 && adjExpenseAccountId != Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        companies = await CompanyService.GetCompaniesAsync();
    }

    private async Task OnCompanyChanged()
    {
        reconId = null; vm = null; bankAccounts.Clear(); expenseAccounts.Clear();
        if (!HasCompany) return;
        var coa = await SetupService.GetChartOfAccountsAsync(selectedCompanyId);
        bankAccounts = coa.Where(a => a.AccountCode.StartsWith("1")).ToList();
        expenseAccounts = coa.Where(a => a.AccountCode.StartsWith("5") || a.AccountCode.StartsWith("6")).ToList();
    }

    private void HandleFileUpload(InputFileChangeEventArgs e) => uploadedFile = e.File;

    private async Task StartRecon()
    {
        if (!CanStartRecon) return;

        // Pass stream to Service
        using var stream = uploadedFile!.OpenReadStream(2 * 1024 * 1024);
        var (err, id) = await ReconService.StartReconciliationAsync(selectedCompanyId, selectedBankAccountId, statementDate, endingBalance, stream);

        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        reconId = id;
        await Refresh();
    }

    private async Task Refresh()
    {
        if (reconId == null) return;
        vm = await ReconService.GetReconDataAsync(selectedCompanyId, reconId.Value);
        selectedBankLine = null; selectedTxn = null;
    }

    private async Task AutoMatch()
    {
        var count = await ReconService.AutoMatchAsync(selectedCompanyId, reconId!.Value, toleranceDays: 2);
        await JS.InvokeVoidAsync("alert", $"Matched {count} lines.");
        await Refresh();
    }

    private async Task ManualMatch()
    {
        if (selectedBankLine == null || selectedTxn == null) return;
        var err = await ReconService.MatchManuallyAsync(selectedCompanyId, selectedBankLine.Id, selectedTxn.Id);
        if (!string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", err);
        await Refresh();
    }

    private void OpenAdjustment() { adjDescription = ""; adjAmount = 0; adjExpenseAccountId = Guid.Empty; showAdjustment = true; }
    private void CloseAdjustment() => showAdjustment = false;

    private async Task SaveAdjustment()
    {
        var err = await ReconService.CreateAdjustmentAsync(selectedCompanyId, reconId!.Value, adjDescription, adjAmount, adjExpenseAccountId);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }
        showAdjustment = false;
        await JS.InvokeVoidAsync("alert", "Draft Batch Created. Post it in GL Batches.");
        await Refresh();
    }

    private async Task Finalize()
    {
        var res = await ReconService.FinalizeReconciliationAsync(selectedCompanyId, reconId!.Value);
        await JS.InvokeVoidAsync("alert", res == "Success" ? "Reconciliation Finalized." : res);
        if (res == "Success") { reconId = null; vm = null; }
    }
}