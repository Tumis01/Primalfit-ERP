@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@attribute [Authorize]
@inject CompanyApiService CompanyService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mt-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard</h1>
            <p class="text-sm text-slate-500 mt-1">Overview of your organization's performance and entities.</p>
        </div>
        <div class="text-sm text-slate-400">
            @DateTime.Now.ToString("MMMM dd, yyyy")
        </div>
    </div>

    @* --- QUICK ACTIONS ROW --- *@
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group ml-1 mr-1 p-3 bg-white rounded-lg flex flex-col justify-center shadow-sm ring-1 ring-slate-200 hover:ring-[#2A9ADB] hover:shadow-md transition-all">
            <h2 class="text-md font-bold mb-2">Metrics</h2>
            <div class="mt-2">
                <div class="text-4xl mb-3 font-bold text-slate-900">$ 100,254</div>
                <div class="mt-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">Business Profit</div>
            </div>
            <div class="mt-8 flex flex-col gap-6">
                <div class="flex items-center gap-4">
                    <div class="relative flex-1">
                        <div class="h-5 w-full overflow-hidden">
                            <div class="h-full bg-[#004e7c] w-[90%]"></div>
                        </div>
                    </div>
                    <span class="min-w-[70px] text-sm font-light text-slate-600">$ 187,373</span>
                </div>
                <div class="flex items-center gap-4">
                    <div class="relative flex-1">
                        <div class="h-5 w-full overflow-hidden">
                            <div class="h-full bg-[#2da1e7] w-[45%]"></div>
                        </div>
                    </div>
                    <span class="min-w-[70px] text-sm font-light text-slate-600">$ 87,373</span>
                </div>
            </div>
            <div class="mt-auto pt-6 flex justify-center gap-6">
                <div class="flex items-center gap-2">
                    <span class="block h-3 w-3 bg-[#004e7c]"></span>
                    <span class="text-[11px] font-light text-slate-500">Income</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="block h-3 w-3 bg-[#2da1e7]"></span>
                    <span class="text-[11px] font-light text-slate-500">Spending</span>
                </div>
            </div>
        </div>
        <div class="group w-full ml-1 mr-1 p-3 bg-white rounded-lg not-first:flex not-first:items-center shadow-sm ring-1 ring-slate-200 hover:ring-[#2A9ADB] hover:shadow-md transition-all">
            <h2 class="text-md font-bold mb-3 mt-1">Spending</h2>
            <div class="flex flex-row align-center items-center gap-2">
                <MudChart ChartType="ChartType.Donut"
                          InputData="@data"
                          Width="90%"
                          Height="90%"
                          ChartOptions="@options" />

                <MudStack Spacing="2">
                    @for (int i = 0; i < labels.Length; i++)
                    {
                        var index = i;
                        <div class="flex items-start gap-2 font-light">
                            <div style="width: 16px; height: 16px; background-color: @options.ChartPalette[index]; border-radius: 3px; margin-top: 2px;"></div>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">@labels[index]</MudText>
                                <MudText Typo="Typo.caption" Style="color: #666;">@descriptions[index]</MudText>
                            </div>
                        </div>
                    }
                </MudStack>
            </div>
        </div>

        <div class="group ml-1 mr-1 p-3 bg-white rounded-lg flex flex-col justify-center shadow-sm ring-1 ring-slate-200 hover:ring-[#2A9ADB] hover:shadow-md transition-all">
            <h2 class="text-md font-bold mb-2">Bank Accounts</h2>
            <div class="pb-4 w-full border-b border-slate-300">
                <h3 class="mb-2">Bank 1</h3>
                <div class="text-slate-400 w-full grid grid-cols-3 gap-y-1 text-sm font-light">
                    <p class="col-span-2">Account Number</p>
                    <p>1234567890</p>
                    <p class="col-span-2">Bank Balance</p>
                    <p>$ 123,456</p>
                </div>
            </div>
            <div class="mt-4 mb-4 pb-4 w-full">
                <h3 class="mb-2">Bank 1</h3>
                <div class="text-slate-400 w-full grid grid-cols-3 gap-y-1 text-sm font-light">
                    <p class="col-span-2">Account Number</p>
                    <p>1234567890</p>
                    <p class="col-span-2">Bank Balance</p>
                    <p>$ 123,456</p>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex h-64 items-center justify-center rounded-2xl border border-slate-100 bg-white">
            <div class="flex flex-col items-center gap-3 text-slate-400">
                <svg class="h-8 w-8 animate-spin text-indigo-500" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-sm font-medium">Loading dashboard...</span>
            </div>
        </div>
    }
    else if (!companies.Any())
    {
        <div class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 py-16 text-center">
            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-sm ring-1 ring-slate-100">
                <svg class="h-8 w-8 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900">No Companies Found</h3>
            <p class="mt-2 max-w-sm text-sm text-slate-500">Your system is empty. Get started by registering your first company entity to track financials.</p>
            <a href="companies" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-200 hover:bg-indigo-700 transition-all">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Register Company
            </a>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <h3 class="mb-6 font-bold text-slate-800">Company Count</h3>
                <div class="flex flex-col items-center">
                    <div class="relative h-44 w-44 rounded-full bg-slate-50 shadow-inner p-4"
                         style="background: conic-gradient(#5EA9D3 @(ActivePercentage)%, #f1f5f9 0);">
                        <div class="absolute inset-3 flex items-center justify-center rounded-full bg-white shadow-lg">
                            <div class="text-center">
                                <span class="block text-3xl font-extrabold text-slate-900">@companies.Count</span>
                                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Company</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 flex w-full justify-center gap-8">
                        <div class="flex flex-col items-center gap-1">
                            <span class="h-2.5 w-2.5 rounded-full bg-[#5EA9D3] shadow "></span>
                            <span class="text-2xl font-bold text-slate-700">@activeCount</span>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Active</span>
                        </div>
                        <div class="flex flex-col items-center gap-1">
                            <span class="h-2.5 w-2.5 rounded-full bg-slate-200"></span>
                            <span class="text-2xl font-bold text-slate-700">@inactiveCount</span>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Inactive</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="md:col-span-2 flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
                    <h3 class="font-bold text-slate-800">Recent Companies</h3>
                    <a href="companies" class="text-sm font-medium text-[#5EA9D3] hover:text-[#004E7A] flex items-center gap-1">
                        View All
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50/50 text-[11px] uppercase font-bold tracking-wider text-slate-400">
                            <tr>
                                <th class="px-6 py-4">Company</th>
                                <th class="px-6 py-4">Location</th>
                                <th class="px-6 py-4">Fiscal Year</th>
                                <th class="px-6 py-4">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var company in companies.Take(5))
                            {
                                <tr class="group hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-medium text-slate-900 group-hover:text-[#5EA9D3] transition-colors">@company.CompanyName</td>
                                    <td class="px-6 py-4">@company.country</td>
                                    <td class="px-6 py-4 text-xs font-mono text-slate-500">@company.FiscalStartYear.Year - @company.FiscalEndYear.Year</td>
                                    <td class="px-6 py-4">
                                        @if (company.Status.ToString() == "Active")
                                        {
                                            <span class="inline-flex items-center rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700 ring-1 ring-inset ring-emerald-600/10">Active</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-500/10">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CompanyDetails> companies = new();
    private bool isLoading = true;
    private int activeCount = 0;
    private int inactiveCount = 0;
    private double ActivePercentage = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            companies = await CompanyService.GetCompaniesAsync();
            if (companies.Any())
            {
                activeCount = companies.Count(c => c.Status.ToString() == "Active");
                inactiveCount = companies.Count - activeCount;
                ActivePercentage = ((double)activeCount / companies.Count) * 100;
            }
        }
        finally
        {
            isLoading = false;
        }
    }
    private double[] data = { 25, 25, 30, 20 };
    private string[] labels = { "Oil", "Coal", "Gas", "Renewable" };
    private string[] descriptions = {
                "Fossil fuel energy",
                "Traditional fuel",
                "Natural gas supply",
                "Clean energy sources"
                };

    private ChartOptions options = new ChartOptions
    {
        ChartPalette = new[]
    {
                "#004E7A",
                "#2A9ADB",
                "#CEEDFF",
                "#85CEF9"
                },
        YAxisLines = false,
        XAxisLines = false,
        YAxisTicks = -7,
        YAxisFormat = ""
    };
}
