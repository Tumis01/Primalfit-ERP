@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject DashboardService DashService
@inject CompanyApiService CompanyService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Financial Health</h1>
            <p class="text-sm text-slate-500 mt-1">Real-time performance metrics for @(companyName ?? "your organization").</p>
        </div>
        <div class="text-right">
            <div class="text-sm font-bold text-slate-700">@DateTime.Now.ToString("MMMM dd, yyyy")</div>
            @if (data != null)
            {
                <div class="text-xs text-slate-400">Last refresh: @data.LastRefresh.ToString("HH:mm")</div>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            @for (int i = 0; i < 3; i++)
            {
                <div class="h-32 bg-slate-100 rounded-2xl animate-pulse"></div>
            }
        </div>
    }
    else if (data != null)
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 bg-red-50 border border-red-100 rounded-2xl flex items-center gap-4">
                <div class="p-3 bg-white rounded-xl text-red-600 shadow-sm">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-slate-900">@data.LowStockItemsCount</div>
                    <div class="text-xs font-bold text-red-600 uppercase tracking-wide">Low Stock Items</div>
                </div>
            </div>

            <div class="p-4 bg-amber-50 border border-amber-100 rounded-2xl flex items-center gap-4">
                <div class="p-3 bg-white rounded-xl text-amber-600 shadow-sm">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-slate-900">@data.OverdueInvoicesCount</div>
                    <div class="text-xs font-bold text-amber-600 uppercase tracking-wide">Overdue Invoices</div>
                </div>
            </div>

            <div class="p-4 bg-emerald-50 border border-emerald-100 rounded-2xl flex items-center gap-4 col-span-1 md:col-span-2">
                <div class="p-3 bg-white rounded-xl text-emerald-600 shadow-sm">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                </div>
                <div>
                    <div class="text-2xl font-bold text-slate-900">@data.CashOnHand.ToString("C0")</div>
                    <div class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Cash on Hand</div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4 border-b pb-2">Liquidity</h3>

                <div class="space-y-6">
                    <div>
                        <div class="flex justify-between items-end mb-1">
                            <span class="text-sm font-medium text-slate-600">Current Ratio</span>
                            <span class="text-lg font-bold @(data.CurrentRatio < 1.5m ? "text-amber-500" : "text-slate-900")">@data.CurrentRatio.ToString("0.00")</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2">
                            <div class="bg-indigo-600 h-2 rounded-full" style="width: @Math.Min(data.CurrentRatio * 30, 100)%"></div>
                        </div>
                        <p class="text-xs text-slate-400 mt-1">Target: > 1.5</p>
                    </div>

                    <div>
                        <div class="flex justify-between items-end mb-1">
                            <span class="text-sm font-medium text-slate-600">Quick Ratio</span>
                            <span class="text-lg font-bold @(data.QuickRatio < 1.0m ? "text-red-500" : "text-slate-900")">@data.QuickRatio.ToString("0.00")</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2">
                            <div class="bg-purple-600 h-2 rounded-full" style="width: @Math.Min(data.QuickRatio * 50, 100)%"></div>
                        </div>
                        <p class="text-xs text-slate-400 mt-1">Target: > 1.0</p>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4 border-b pb-2">Profitability (MTD)</h3>

                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="p-3 bg-slate-50 rounded-xl">
                        <div class="text-xs text-slate-500">Revenue</div>
                        <div class="text-lg font-bold text-slate-900">@data.RevenueMTD.ToString("C0")</div>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl">
                        <div class="text-xs text-slate-500">Net Profit</div>
                        <div class="text-lg font-bold text-emerald-600">@data.NetProfitMTD.ToString("C0")</div>
                    </div>
                </div>

                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-slate-600">Gross Margin</span>
                        <span class="font-bold text-slate-900">@data.GrossProfitMargin.ToString("0.0")%</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-slate-600">Net Margin</span>
                        <span class="font-bold text-emerald-600">@data.NetProfitMargin.ToString("0.0")%</span>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-4 border-b pb-2">Efficiency</h3>

                <div class="flex items-center gap-4 mb-6">
                    <div class="h-12 w-12 rounded-full border-4 border-indigo-100 flex items-center justify-center font-bold text-indigo-600 text-sm">
                        @data.DaysSalesOutstanding.ToString("0")
                    </div>
                    <div>
                        <div class="font-bold text-slate-900">Days Sales Outstanding</div>
                        <div class="text-xs text-slate-500">Avg days to collect payment</div>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="h-12 w-12 rounded-full border-4 border-amber-100 flex items-center justify-center font-bold text-amber-600 text-sm">
                        @data.InventoryTurnover.ToString("0.0")
                    </div>
                    <div>
                        <div class="font-bold text-slate-900">Inventory Turnover</div>
                        <div class="text-xs text-slate-500">Cycles per period</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <h3 class="text-lg font-bold text-slate-900">Quick Access</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="companies" class="group flex flex-col items-center justify-center gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-500 hover:shadow-md transition-all">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
            </div>
            <span class="font-semibold text-slate-700 group-hover:text-indigo-700">Add Company</span>
        </a>
        <a href="users" class="group flex flex-col items-center justify-center gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-500 hover:shadow-md transition-all">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-50 text-purple-600 group-hover:bg-purple-600 group-hover:text-white transition-colors">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
            </div>
            <span class="font-semibold text-slate-700 group-hover:text-purple-700">New User</span>
        </a>
        <a href="gl/chart-of-accounts" class="group flex flex-col items-center justify-center gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-500 hover:shadow-md transition-all">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            </div>
            <span class="font-semibold text-slate-700 group-hover:text-emerald-700">Chart Of Account</span>
        </a>
    </div>

</div>

@code {
    private FinancialDashboardSnapshot? data;
    private bool isLoading = true;
    private string? companyName;
    private string ErrorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);

            if (user != null && user.CompanyDetailsId.HasValue)
            {
                // Fetch Company Name for Header
                var company = await CompanyService.GetCompanyByIdAsync(user.CompanyDetailsId.Value);
                companyName = company?.CompanyName;

                // Execute Dashboard Service
                data = await DashService.GetSnapshotAsync(user.CompanyDetailsId.Value);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            isLoading = false;
        }
    }
}