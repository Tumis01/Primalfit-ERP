@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject CompanyApiService CompanyService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard</h1>
            <p class="text-sm text-slate-500 mt-1">Overview of your organization's performance and entities.</p>
        </div>
        <div class="text-sm text-slate-400">
            @DateTime.Now.ToString("MMMM dd, yyyy")
        </div>
    </div>

    @* --- QUICK ACTIONS ROW --- *@
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="companies" class="group flex flex-col items-center justify-center gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-500 hover:shadow-md transition-all">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
            </div>
            <span class="font-semibold text-slate-700 group-hover:text-indigo-700">Add Company</span>
        </a>

        <a href="users" class="group flex flex-col items-center justify-center gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-500 hover:shadow-md transition-all">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-purple-50 text-purple-600 group-hover:bg-purple-600 group-hover:text-white transition-colors">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
            </div>
            <span class="font-semibold text-slate-700 group-hover:text-purple-700">New User</span>
        </a>

        <a href="gl/chart-of-accounts" class="group flex flex-col items-center justify-center gap-3 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 hover:ring-indigo-500 hover:shadow-md transition-all">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            </div>
            <span class="font-semibold text-slate-700 group-hover:text-emerald-700">Chart Of Account</span>
        </a>
    </div>

    @if (isLoading)
    {
        <div class="flex h-64 items-center justify-center rounded-2xl border border-slate-100 bg-white">
            <div class="flex flex-col items-center gap-3 text-slate-400">
                <svg class="h-8 w-8 animate-spin text-indigo-500" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="text-sm font-medium">Loading dashboard...</span>
            </div>
        </div>
    }
    else if (!companies.Any())
    {
        <div class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 py-16 text-center">
            <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-sm ring-1 ring-slate-100">
                <svg class="h-8 w-8 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900">No Companies Found</h3>
            <p class="mt-2 max-w-sm text-sm text-slate-500">Your system is empty. Get started by registering your first company entity to track financials.</p>
            <a href="companies" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-200 hover:bg-indigo-700 transition-all">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Register Company
            </a>
        </div>
    }
    else
    {
        <div class="grid gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <h3 class="mb-6 font-bold text-slate-800">Company Count</h3>
                <div class="flex flex-col items-center">
                    <div class="relative h-44 w-44 rounded-full bg-slate-50 shadow-inner p-4"
                         style="background: conic-gradient(#6366f1 @(ActivePercentage)%, #f1f5f9 0);">
                        <div class="absolute inset-3 flex items-center justify-center rounded-full bg-white shadow-lg">
                            <div class="text-center">
                                <span class="block text-3xl font-extrabold text-slate-900">@companies.Count</span>
                                <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Company</span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 flex w-full justify-center gap-8">
                        <div class="flex flex-col items-center gap-1">
                            <span class="h-2.5 w-2.5 rounded-full bg-indigo-500 shadow shadow-indigo-200"></span>
                            <span class="text-2xl font-bold text-slate-700">@activeCount</span>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Active</span>
                        </div>
                        <div class="flex flex-col items-center gap-1">
                            <span class="h-2.5 w-2.5 rounded-full bg-slate-200"></span>
                            <span class="text-2xl font-bold text-slate-700">@inactiveCount</span>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Inactive</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="md:col-span-2 flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                <div class="flex items-center justify-between border-b border-slate-100 px-6 py-5">
                    <h3 class="font-bold text-slate-800">Recent Companies</h3>
                    <a href="companies" class="text-sm font-medium text-indigo-600 hover:text-indigo-700 flex items-center gap-1">
                        View All
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
                    </a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50/50 text-[11px] uppercase font-bold tracking-wider text-slate-400">
                            <tr>
                                <th class="px-6 py-4">Company</th>
                                <th class="px-6 py-4">Location</th>
                                <th class="px-6 py-4">Fiscal Year</th>
                                <th class="px-6 py-4">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var company in companies.Take(5))
                            {
                                <tr class="group hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-medium text-slate-900 group-hover:text-indigo-600 transition-colors">@company.CompanyName</td>
                                    <td class="px-6 py-4">@company.country</td>
                                    <td class="px-6 py-4 text-xs font-mono text-slate-500">@company.FiscalStartYear.Year - @company.FiscalEndYear.Year</td>
                                    <td class="px-6 py-4">
                                        @if (company.Status.ToString() == "Active")
                                        {
                                            <span class="inline-flex items-center rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-bold text-emerald-700 ring-1 ring-inset ring-emerald-600/10">Active</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-md bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-500/10">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<CompanyDetails> companies = new();
    private bool isLoading = true;
    private int activeCount = 0;
    private int inactiveCount = 0;
    private double ActivePercentage = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            companies = await CompanyService.GetCompaniesAsync();
            if (companies.Any())
            {
                activeCount = companies.Count(c => c.Status.ToString() == "Active");
                inactiveCount = companies.Count - activeCount;
                ActivePercentage = ((double)activeCount / companies.Count) * 100;
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}