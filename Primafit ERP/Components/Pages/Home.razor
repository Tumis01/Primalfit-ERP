@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@attribute [Authorize]

@inject DashboardService DashService
@inject CompanyApiService CompanyService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=DM+Mono:wght@400;500&display=swap');

    .dash-root {
        font-family: 'DM Sans', sans-serif;
    }

    .mono {
        font-family: 'DM Mono', monospace;
    }

    .kpi-card {
        background: #fff;
        border: 1px solid #e8ecf0;
        border-radius: 16px;
        padding: 1.25rem;
        transition: box-shadow .2s, transform .15s;
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

        .kpi-card:hover {
            box-shadow: 0 8px 24px rgba(0,0,0,.07);
            transform: translateY(-2px);
        }

        .kpi-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 16px 16px 0 0;
            background: var(--accent, #6366f1);
        }

    .tab-btn {
        padding: .625rem 1rem;
        font-size: .8125rem;
        font-weight: 700;
        border-bottom: 2px solid transparent;
        color: #64748b;
        transition: color .15s, border-color .15s;
        cursor: pointer;
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
        white-space: nowrap;
    }

        .tab-btn:hover {
            color: #334155;
        }

        .tab-btn.active {
            color: var(--tab-color, #6366f1);
            border-bottom-color: var(--tab-color, #6366f1);
        }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

        .data-table th {
            font-size: .6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #94a3b8;
            padding: .625rem 1rem;
            background: #f8fafc;
            border-bottom: 1px solid #e8ecf0;
            text-align: left;
        }

        .data-table td {
            font-size: .8125rem;
            color: #334155;
            padding: .625rem 1rem;
            border-bottom: 1px solid #f1f5f9;
        }

        .data-table tr:last-child td {
            border-bottom: none;
        }

        .data-table tr:hover td {
            background: #f8fafc;
        }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: .2rem .6rem;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 700;
    }

    .section-title {
        font-size: .6875rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: #94a3b8;
        margin-bottom: 1rem;
    }

    .customer-bar {
        height: 6px;
        border-radius: 3px;
        background: linear-gradient(90deg, #6366f1, #8b5cf6);
        transition: width .4s ease;
    }

    .refresh-spin {
        animation: spin .8s linear infinite;
    }
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .skeleton {
        background: linear-gradient(90deg, #f1f5f9 25%, #e8ecf0 50%, #f1f5f9 75%);
        background-size: 400% 100%;
        animation: shimmer 1.4s ease infinite;
        border-radius: 8px;
    }
    @@keyframes shimmer {
        0% {
            background-position: 100% 0
        }

        100% {
            background-position: -100% 0
        }
    }

    .fade-up {
        animation: fadeUp .4s ease both;
    }
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="dash-root max-w-[1440px] mx-auto px-4 py-6 space-y-6 pb-16">

    @* ── HEADER ──────────────────────────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                Financial Command Center
            </h1>
            <p class="text-sm text-slate-400 mt-0.5 font-medium">
                @(companyName ?? "Organization") &nbsp;·&nbsp; @DateTime.Now.ToString("dddd, MMMM dd yyyy")
            </p>
        </div>
        <div class="flex items-center gap-3">
            @if (data != null)
            {
                <span class="text-xs text-slate-400 font-medium mono">
                    Last sync @data.LastRefresh.ToString("HH:mm:ss")
                </span>
            }
            <button @onclick="RefreshAsync"
                    disabled="@isRefreshing"
                    class="flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-60
                text-white text-sm font-bold rounded-xl shadow-sm transition-all">
                <svg class="@(isRefreshing ? "refresh-spin" : "") w-4 h-4" fill="none"
                     viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4 4v5h5M20 20v-5h-5M4 9a9 9 0 0115.4-4M20 15a9 9 0 01-15.4 4" />
                </svg>
                @(isRefreshing ? "Refreshing…" : "Refresh")
            </button>
        </div>
    </div>

    @* ── DATA RENDERING LOGIC ──────────────────── *@
    @if (isLoading)
    {
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            @for (int i = 0; i < 6; i++)
            {
                <div class="kpi-card space-y-3">
                    <div class="skeleton h-3 w-20"></div>
                    <div class="skeleton h-7 w-24"></div>
                    <div class="skeleton h-2.5 w-16"></div>
                </div>
            }
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 skeleton h-72 rounded-2xl"></div>
            <div class="skeleton h-72 rounded-2xl"></div>
        </div>
    }
    else if (data == null)
    {
        <p class="text-slate-500 text-center py-12">No data available.</p>
    }
    else
    {
        @* ════════════════════════════════════════════════════════════
           KPI STRIP — clickable cards triggered to run drilldown modal
        ════════════════════════════════════════════════════════════ *@
        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 fade-up">

            @* Cash & Bank (Interactive) *@
            <div class="kpi-card transition-transform group" style="--accent:#10b981" @onclick='() => OpenDrillDownAsync("CASH", "Cash & Bank Cumulative Balance")'>
                <div class="flex items-center justify-between">
                    <div class="section-title" style="margin-bottom:.5rem">Cash &amp; Bank</div>
                    <span class="text-emerald-500 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-0.5">
                        Audit
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                    </span>
                </div>
                <div class="text-lg xl:text-xl font-black text-slate-900 mono truncate" title="@FormatAccounting(data.CashOnHand)">
                    @FormatAccounting(data.CashOnHand)
                </div>
                <div class="flex items-center gap-1 mt-2">
                    <span class="text-[11px] text-slate-500 font-medium">
                        CR @data.CurrentRatio.ToString("0.00x") · Click to view ledger
                    </span>
                </div>
            </div>

            @* Revenue MTD (Interactive) *@
            <div class="kpi-card transition-transform group" style="--accent:#6366f1" @onclick='() => OpenDrillDownAsync("REVENUE", "Revenue MTD Ledger Operations")'>
                <div class="flex items-center justify-between">
                    <div class="section-title" style="margin-bottom:.5rem">Revenue MTD</div>
                    <span class="text-indigo-500 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-0.5">
                        Audit
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                    </span>
                </div>
                <div class="text-lg xl:text-xl font-black text-slate-900 mono truncate" title="@FormatAccounting(data.RevenueMTD)">
                    @FormatAccounting(data.RevenueMTD)
                </div>
                @{
                    var revChange = data.PreviousMonthRevenue != 0
                        ? ((data.RevenueMTD - data.PreviousMonthRevenue) / data.PreviousMonthRevenue) * 100
                        : 0m;
                }
                <div class="flex items-center gap-1 mt-2">
                    <span class="text-[11px] font-bold @(revChange >= 0 ? "text-emerald-500" : "text-rose-500")">
                        @(revChange >= 0 ? "▲" : "▼") @Math.Abs(revChange).ToString("N1")%
                    </span>
                    <span class="text-[11px] text-slate-400">vs prior month · Click to audit</span>
                </div>
            </div>

            @* Net Profit MTD (Interactive) *@
            <div class="kpi-card transition-transform group" style="--accent:@(data.NetProfitMTD >= 0 ? "#6366f1" : "#f43f5e")" @onclick='() => OpenDrillDownAsync("PROFIT", "Net Profit MTD Performance")'>
                <div class="flex items-center justify-between">
                    <div class="section-title" style="margin-bottom:.5rem">Net Profit MTD</div>
                    <span class="text-indigo-500 text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-0.5">
                        Audit
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                    </span>
                </div>
                <div class="text-lg xl:text-xl font-black mono truncate @(data.NetProfitMTD >= 0 ? "text-indigo-600" : "text-rose-600")" title="@FormatAccounting(data.NetProfitMTD)">
                    @FormatAccounting(data.NetProfitMTD)
                </div>
                @{
                    var profitChange = data.PreviousMonthProfit != 0
                        ? ((data.NetProfitMTD - data.PreviousMonthProfit) / Math.Abs(data.PreviousMonthProfit)) * 100
                        : 0m;
                }
                <div class="flex items-center gap-1 mt-2">
                    <span class="text-[11px] font-bold @(profitChange >= 0 ? "text-emerald-500" : "text-rose-500")">
                        @(profitChange >= 0 ? "▲" : "▼") @Math.Abs(profitChange).ToString("N1")%
                    </span>
                    <span class="text-[11px] text-slate-400">margin @data.NetProfitMargin.ToString("N1")% · Click to audit</span>
                </div>
            </div>

            @* AR Outstanding *@
            <div class="kpi-card" style="--accent:#f59e0b">
                <div class="section-title" style="margin-bottom:.5rem">AR Outstanding</div>
                <div class="text-lg xl:text-xl font-black text-slate-900 mono truncate" title="@FormatAccounting(data.AROutstandingTotal)">
                    @FormatAccounting(data.AROutstandingTotal)
                </div>
                <div class="flex items-center gap-1 mt-2">
                    <span class="text-[11px] font-bold @(data.OverdueInvoicesCount > 0 ? "text-amber-600" : "text-slate-400")">
                        @data.OverdueInvoicesCount overdue
                    </span>
                </div>
            </div>

            @* AP Outstanding *@
            <div class="kpi-card" style="--accent:#f43f5e">
                <div class="section-title" style="margin-bottom:.5rem">AP Outstanding</div>
                <div class="text-lg xl:text-xl font-black text-slate-900 mono truncate" title="@FormatAccounting(data.APOutstandingTotal)">
                    @FormatAccounting(data.APOutstandingTotal)
                </div>
                <div class="flex items-center gap-1 mt-2">
                    <span class="text-[11px] font-bold @(data.APExceptionsCount > 0 ? "text-rose-500" : "text-slate-400")">
                        @data.APExceptionsCount @(data.APExceptionsCount == 1 ? "exception" : "exceptions")
                    </span>
                </div>
            </div>

            @* Inventory Value *@
            <div class="kpi-card" style="--accent:#14b8a6">
                <div class="section-title" style="margin-bottom:.5rem">Inventory Value</div>
                <div class="text-lg xl:text-xl font-black text-slate-900 mono truncate" title="@FormatAccounting(data.InventoryValue)">
                    @FormatAccounting(data.InventoryValue)
                </div>
                <div class="flex items-center gap-1 mt-2">
                    <span class="text-[11px] font-bold @(data.LowStockItemsCount > 0 ? "text-amber-500" : "text-emerald-500")">
                        @data.LowStockItemsCount low stock @(data.LowStockItemsCount == 1 ? "item" : "items")
                    </span>
                </div>
            </div>
        </div>

        @* ── CHARTS ROW — 6-Month Trend  +  Top Customers ── *@
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 fade-up" style="animation-delay:.08s">
            <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <span class="section-title" style="margin:0">6-Month Financial Trend</span>
                    <div class="flex items-center gap-3 text-[11px] font-bold">
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-1.5 rounded-full bg-indigo-500 inline-block"></span> Revenue
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-1.5 rounded-full bg-rose-400 inline-block"></span> Expenses
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-1.5 rounded-full bg-emerald-500 inline-block"></span> Profit
                        </span>
                    </div>
                </div>
                <div class="h-64 w-full">
                    <canvas id="cashFlowChart"></canvas>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col">
                <span class="section-title">Top Customers MTD</span>
                @if (data.TopCustomers.Any())
                {
                    var maxRev = data.TopCustomers.Max(c => c.RevenueMTD);
                    <div class="space-y-3 flex-1">
                        @foreach (var (cust, idx) in data.TopCustomers.Select((c, i) => (c, i)))
                        {
                            var pct = maxRev > 0 ? (int)((cust.RevenueMTD / maxRev) * 100) : 0;
                            <div>
                                <div class="flex justify-between text-xs mb-1">
                                    <span class="font-semibold text-slate-700 truncate max-w-[130px]" title="@cust.CustomerName">@cust.CustomerName</span>
                                    <span class="mono font-bold text-slate-800">@FormatAccounting(cust.RevenueMTD)</span>
                                </div>
                                <div class="bg-slate-100 rounded-full h-1.5 overflow-hidden">
                                    <div class="customer-bar" style="width:@pct%"></div>
                                </div>
                                <div class="text-[10px] text-slate-400 mt-0.5">@cust.InvoiceCount @(cust.InvoiceCount == 1 ? "invoice" : "invoices")</div>
                            </div>
                        }
                    </div>
                    <div class="mt-4 pt-3 border-t border-slate-100 text-xs text-slate-500 font-medium">
                        YTD Revenue: <span class="font-bold text-slate-700 mono">@FormatAccounting(data.RevenueYTD)</span>
                    </div>
                }
                else
                {
                    <div class="flex-1 flex items-center justify-center text-slate-400 italic text-sm">
                        No invoices this month.
                    </div>
                }
            </div>
        </div>

        @* ── CHARTS ROW 2 — Expense Donut  +  AR/AP Aging ── *@
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 fade-up" style="animation-delay:.16s">

            @* Top Expenses Donut *@
            <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                <span class="section-title">Expense Breakdown MTD</span>
                @if (data.TopExpenses.Any())
                {
                    var totalExp = data.TopExpenses.Sum(e => e.Amount);
                    <div class="h-44 mb-4">
                        <canvas id="topExpensesChart"></canvas>
                    </div>
                    <div class="space-y-1.5">
                        @foreach (var exp in data.TopExpenses)
                        {
                            var expPct = totalExp > 0 ? (exp.Amount / totalExp) * 100 : 0;
                            <div class="flex justify-between items-center text-xs">
                                <span class="text-slate-500 truncate max-w-[140px]" title="@exp.AccountName">
                                    @exp.AccountName
                                </span>
                                <div class="flex items-center gap-2">
                                    <span class="text-slate-400">@expPct.ToString("N0")%</span>
                                    <span class="font-bold mono text-slate-800">@FormatAccounting(exp.Amount)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="h-full flex items-center justify-center text-slate-400 italic text-sm">
                        No expenses this month.
                    </div>
                }
            </div>

            @* AR / AP Aging *@
            <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <span class="section-title" style="margin:0">Receivables vs Payables Aging</span>
                    <div class="flex items-center gap-3 text-[11px] font-bold">
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-1.5 rounded-full bg-indigo-500 inline-block"></span> AR
                        </span>
                        <span class="flex items-center gap-1.5">
                            <span class="w-3 h-1.5 rounded-full bg-rose-400 inline-block"></span> AP
                        </span>
                    </div>
                </div>
                <div class="h-52 w-full">
                    <canvas id="agingChart"></canvas>
                </div>
                <div class="grid grid-cols-4 gap-2 mt-4 pt-3 border-t border-slate-100">
                    @foreach (var (label, ar, ap) in new[]{
                        ("Current",  data.ARAging.Current,    data.APAging.Current),
                        ("1–30d",    data.ARAging.Days1To30,  data.APAging.Days1To30),
                        ("31–60d",   data.ARAging.Days31To60, data.APAging.Days31To60),
                        (">60d",     data.ARAging.DaysOver60, data.APAging.DaysOver60)
                    })
                    {
                        <div class="text-center">
                            <div class="text-[10px] text-slate-400 font-bold uppercase">@label</div>
                            <div class="text-xs font-bold text-indigo-600 mono">@FormatAccounting(ar)</div>
                            <div class="text-xs font-bold text-rose-500 mono">@FormatAccounting(ap)</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── ACTION CENTER — Tabbed drill-down tables ── *@
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden fade-up"
             style="animation-delay:.2s">

            <div class="flex gap-1 px-4 pt-2 border-b border-slate-100 overflow-x-auto bg-slate-50/60">
                <button class="tab-btn @(activeTab == 0 ? "active" : "")" style="--tab-color:#6366f1" @onclick="() => activeTab = 0">
                    Unshipped <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-indigo-100 text-indigo-700">@data.UnshippedOrdersCount</span>
                </button>
                <button class="tab-btn @(activeTab == 1 ? "active" : "")" style="--tab-color:#f43f5e" @onclick="() => activeTab = 1">
                    AP Exceptions <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-rose-100 text-rose-700">@data.APExceptionsCount</span>
                </button>
                <button class="tab-btn @(activeTab == 2 ? "active" : "")" style="--tab-color:#f59e0b" @onclick="() => activeTab = 2">
                    Transfers <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-700">@data.PendingTransfersCount</span>
                </button>
                <button class="tab-btn @(activeTab == 3 ? "active" : "")" style="--tab-color:#14b8a6" @onclick="() => activeTab = 3">
                    Low Stock <span class="ml-1.5 px-1.5 py-0.5 rounded-full text-[10px] bg-teal-100 text-teal-700">@data.LowStockItemsCount</span>
                </button>
            </div>

            @if (activeTab == 0)
            {
                if (data.UnshippedOrderDetails.Any())
                {
                    <div class="overflow-x-auto max-h-64 overflow-y-auto">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Order Date</th>
                                    <th>Days Old</th>
                                    <th class="text-right">Value</th>
                                    <th>Urgency</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in data.UnshippedOrderDetails)
                                {
                                    <tr>
                                        <td class="mono font-semibold text-indigo-600">@o.OrderNumber</td>
                                        <td class="font-medium">@o.CustomerName</td>
                                        <td class="text-slate-500">@o.Date.ToString("dd MMM yyyy")</td>
                                        <td class="mono">@o.DaysOld</td>
                                        <td class="mono font-bold text-right">@FormatAccounting(o.OrderValue)</td>
                                        <td>
                                            @if (o.DaysOld > 14)
                                            {
                                                <span class="badge bg-rose-100 text-rose-700">Overdue</span>
                                            }
                                            else if (o.DaysOld > 7)
                                            {

                                                <span class="badge bg-amber-100 text-amber-700">Aging</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-emerald-100 text-emerald-700">Recent</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="py-10 text-center text-slate-400 text-sm italic">All orders are fully shipped 🎉</div>
                }
                <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/40">
                    <span class="text-xs text-slate-500">@data.UnshippedOrdersCount order@(data.UnshippedOrdersCount != 1 ? "s" : "") awaiting warehouse fulfillment</span>
                    <a href="/wh/shipments" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors">Go to Shipment →</a>
                </div>
            }

            @if (activeTab == 1)
            {
                if (data.APExceptionDetails.Any())
                {
                    <div class="overflow-x-auto max-h-64 overflow-y-auto">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Bill Ref</th>
                                    <th>Vendor</th>
                                    <th class="text-right">Bill Amount</th>
                                    <th>Variance Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ex in data.APExceptionDetails)
                                {
                                    <tr>
                                        <td class="mono font-semibold text-rose-600">@ex.BillReference</td>
                                        <td class="font-medium">@ex.VendorName</td>
                                        <td class="mono font-bold text-right">@FormatAccounting(ex.BillAmount)</td>
                                        <td>
                                            <span class="text-xs text-slate-500 truncate block max-w-[280px]" title="@ex.VarianceReason">
                                                @(ex.VarianceReason.Length > 60 ? ex.VarianceReason[..60] + "…" : ex.VarianceReason)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="py-10 text-center text-slate-400 text-sm italic">No AP exceptions — 3-way match is clean ✓</div>
                }
                <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/40">
                    <span class="text-xs text-slate-500">@data.APExceptionsCount bill@(data.APExceptionsCount != 1 ? "s" : "") flagged for variance review</span>
                    <a href="/reports/three-way-match" class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors">Review AP Exceptions</a>
                </div>
            }

            @if (activeTab == 2)
            {
                <div class="p-8 text-center">
                    <div class="inline-flex items-center justify-center w-12 h-12 bg-amber-100 rounded-2xl mb-3">
                        <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                        </svg>
                    </div>
                    <p class="text-slate-700 font-semibold mb-1">
                        <span class="text-amber-600 text-xl font-black">@data.PendingTransfersCount</span> stock transfer@(data.PendingTransfersCount != 1 ? "s" : "") currently in transit
                    </p>
                    <p class="text-sm text-slate-400 mb-4">These shipments have left the source warehouse and are awaiting receipt.</p>
                    <a href="/sc/transfers" class="inline-block px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold rounded-xl shadow-sm transition-colors">Process Transfers</a>
                </div>
            }

            @if (activeTab == 3)
            {
                if (data.LowStockDetails.Any())
                {
                    <div class="overflow-x-auto max-h-64 overflow-y-auto">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>SKU</th>
                                    <th class="text-right">On Hand</th>
                                    <th class="text-right">Reorder Lvl</th>
                                    <th class="text-right">Shortfall</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in data.LowStockDetails)
                                {
                                    var shortfall = item.ReorderLevel - item.CurrentQty;
                                    <tr>
                                        <td class="font-semibold text-slate-800">@item.ItemName</td>
                                        <td class="mono text-slate-500 text-xs">@item.SKU</td>
                                        <td class="mono text-right @(item.CurrentQty <= 0 ? "text-rose-600 font-bold" : "text-slate-700")">@item.CurrentQty.ToString("N2")</td>
                                        <td class="mono text-right text-slate-500">@item.ReorderLevel.ToString("N2")</td>
                                        <td class="mono font-bold text-right text-amber-600">@shortfall.ToString("N2")</td>
                                        <td>
                                            @if (item.CurrentQty <= 0)
                                            {
                                                <span class="badge bg-rose-100 text-rose-700">Out of Stock</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-amber-100 text-amber-700">Low Stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="py-10 text-center text-slate-400 text-sm italic">All items are above reorder levels ✓</div>
                }
                <div class="px-6 py-4 border-t border-slate-100 flex items-center justify-between bg-slate-50/40">
                    <span class="text-xs text-slate-500">@data.LowStockItemsCount item@(data.LowStockItemsCount != 1 ? "s" : "") at or below reorder level</span>
                    <a href="/procurement/purchase-orders" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold rounded-lg shadow-sm transition-colors">Create Purchase Order</a>
                </div>
            }
        </div>
    }
</div>

@* ════════════════════════════════════════════════════════════
   INTERACTIVE LEDGER DRILL-DOWN POP-UP MODAL
   ════════════════════════════════════════════════════════════ *@
@if (isModalOpen)
{
    <div class="fixed inset-0 z-[999] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-in fade-in duration-200" @onclick="CloseModal">
        <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 w-full max-w-5xl flex flex-col max-h-[85vh] animate-in zoom-in-95 duration-200" @onclick:stopPropagation>

            @* Modal Header *@
            <div class="flex items-center justify-between p-5 border-b border-slate-100 bg-slate-50/50 rounded-t-2xl">
                <div>
                    <span class="section-title" style="margin: 0">Transaction Source Ledger Audit</span>
                    <h2 class="text-lg font-bold text-slate-900 mt-1">@modalTitle</h2>
                </div>
                <button class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition-all" @onclick="CloseModal">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>
            @* Modal Table Content *@
            <div class="p-6 overflow-y-auto flex-1">
                @if (isModalLoading)
                {
                    <div class="space-y-4 py-12">
                        <div class="flex items-center justify-center gap-3">
                            <span class="animate-spin h-6 w-6 border-3 border-indigo-600 border-t-transparent rounded-full"></span>
                            <span class="text-sm font-semibold text-slate-500">Reconciling transaction streams...</span>
                        </div>
                    </div>
                }
                else if (modalItems == null || !modalItems.Any())
                {
                    <div class="py-16 text-center">
                        <p class="text-slate-400 italic text-sm">No accounts or ledger entries matched this bucket definition.</p>
                    </div>
                }
                else
                {
                    <div class="overflow-x-auto border border-slate-100 rounded-xl">
                        <table class="w-full text-left text-sm border-collapse">
                            @if (modalTitle.Contains("Cash & Bank", StringComparison.OrdinalIgnoreCase))
                            {
                                @* ─── CASH & BANK: Account Portfolio View ─── *@
                                <thead>
                                    <tr class="bg-slate-50/60 text-[10px] font-extrabold uppercase text-slate-400 tracking-wider border-b border-slate-100">
                                        <th class="p-4 pl-6">Account Name</th>
                                        <th class="p-4">Classification</th>
                                        <th class="p-4 text-right pr-6">Current Balance</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                                    @foreach (var item in modalItems)
                                    {
                                        <tr class="hover:bg-slate-50/40 transition-colors">
                                            <td class="p-4 pl-6 font-bold text-slate-800 flex items-center gap-3">
                                                
                                                @item.AccountName
                                            </td>
                                            <td class="p-4 text-xs text-slate-400 font-bold uppercase tracking-wider">@item.Reference</td>
                                            <td class="p-4 text-right pr-6 mono font-extrabold text-slate-900 text-sm">
                                                @FormatAccounting(item.NetBalanceEffect)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                            else
                            {
                                @* ─── REVENUE & NET PROFIT: Transaction Audit Ledger ─── *@
                                <thead>
                                    <tr class="bg-slate-50/60 text-[10px] font-extrabold uppercase text-slate-400 tracking-wider border-b border-slate-100">
                                        <th class="p-3 pl-5">Post Date</th>
                                        <th class="p-3">Chart Account</th>
                                        <th class="p-3">Reference / Document</th>
                                        <th class="p-3 text-right">Debit</th>
                                        <th class="p-3 text-right">Credit</th>
                                        <th class="p-3 text-right pr-5">Net Impact</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                                    @foreach (var item in modalItems)
                                    {
                                        <tr class="hover:bg-slate-50/40 transition-colors">
                                            <td class="p-3 pl-5 mono text-xs text-slate-400">@item.Date.ToString("yyyy-MM-dd")</td>
                                            <td class="p-3 font-semibold text-slate-800">@item.AccountName</td>
                                            <td class="p-3 text-xs text-slate-500 max-w-[200px] truncate" title="@item.Reference">@item.Reference</td>
                                            <td class="p-3 text-right mono text-xs text-slate-500">@(item.Debit > 0 ? item.Debit.ToString("N2") : "—")</td>
                                            <td class="p-3 text-right mono text-xs text-slate-500">@(item.Credit > 0 ? item.Credit.ToString("N2") : "—")</td>
                                            <td class="p-3 text-right pr-5 mono font-bold @(item.NetBalanceEffect >= 0 ? "text-emerald-600" : "text-rose-600")">
                                                @FormatAccounting(item.NetBalanceEffect)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                }
            </div>

            @* Modal Footer Summary *@
            <div class="p-5 border-t border-slate-100 bg-slate-50/50 flex justify-between items-center rounded-b-2xl">
                <span class="text-xs text-slate-400 font-medium">Audit data is compiled live from GL journal partitions.</span>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-500 font-bold">Aggregate Net Value:</span>
                    <span class="font-mono font-extrabold text-sm px-3 py-1 bg-white border border-slate-200 rounded-lg text-slate-900 shadow-sm">
                        @FormatAccounting(modalItems?.Sum(i => i.NetBalanceEffect) ?? 0m)
                    </span>
                </div>
            </div>

        </div>
    </div>
}

@code {
    private FinancialDashboardSnapshot? data;
    private bool isLoading = true;
    private bool isRefreshing = false;
    private string? companyName;
    private int activeTab = 0;
    private Guid _companyId;
    private bool _chartsRendered = false;

    // ── Drilldown Modal Interactivity Workspace ──────────
    private bool isModalOpen = false;
    private bool isModalLoading = false;
    private string modalTitle = string.Empty;
    private List<Primafit_ERP.Services.DashboardService.DrillDownLineItem>? modalItems;

    private string FormatAccounting(decimal value)
    {
        var culture = System.Globalization.CultureInfo.CurrentCulture;

        // Custom accounting format using the culture's native currency symbol:
        string symbol = culture.NumberFormat.CurrencySymbol;

        // Formats positive: ₦1,250, negative: (₦1,250), zero: ₦0
        return value.ToString($"{symbol}#,##0;({symbol}#,##0);{symbol}0");
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId is not null)
        {
            _companyId = user.CompanyDetailsId.Value;
            var company = await CompanyService.GetCompanyByIdAsync(_companyId);
            companyName = company?.CompanyName;
            data = await DashService.GetSnapshotAsync(_companyId);
        }

        isLoading = false;
    }

    private async Task OpenDrillDownAsync(string type, string title)
    {
        modalTitle = title;
        modalItems = null;
        isModalOpen = true;
        isModalLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            modalItems = await DashService.GetLedgerDrillDownAsync(_companyId, type);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Drilldown failed: {ex.Message}");
            isModalOpen = false;
        }
        finally
        {
            isModalLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CloseModal()
    {
        isModalOpen = false;
        modalItems = null;
    }

    private async Task RefreshAsync()
    {
        if (isRefreshing || _companyId == Guid.Empty) return;
        isRefreshing = true;
        _chartsRendered = false;
        await InvokeAsync(StateHasChanged);

        data = await DashService.GetSnapshotAsync(_companyId);

        isRefreshing = false;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (data is null || _chartsRendered) return;

        try
        {
            var cfLabels = data.SixMonthCashFlow.Select(x => x.Month).ToArray();
            var cfRev = data.SixMonthCashFlow.Select(x => x.Revenue).ToArray();
            var cfExp = data.SixMonthCashFlow.Select(x => x.Expenses).ToArray();
            var cfProf = data.SixMonthCashFlow.Select(x => x.NetProfit).ToArray();
            await JS.InvokeVoidAsync("window.erpCharts.renderCashFlowChart", "cashFlowChart", cfLabels, cfRev, cfExp, cfProf);

            var arAges = new decimal[] { data.ARAging.Current, data.ARAging.Days1To30, data.ARAging.Days31To60, data.ARAging.DaysOver60 };
            var apAges = new decimal[] { data.APAging.Current, data.APAging.Days1To30, data.APAging.Days31To60, data.APAging.DaysOver60 };
            await JS.InvokeVoidAsync("window.erpCharts.renderAgingChart", "agingChart", arAges, apAges);

            if (data.TopExpenses.Any())
            {
                var expLabels = data.TopExpenses.Select(x => x.AccountName).ToArray();
                var expData = data.TopExpenses.Select(x => x.Amount).ToArray();
                await JS.InvokeVoidAsync("window.erpCharts.renderTopExpensesChart", "topExpensesChart", expLabels, expData);
            }

            _chartsRendered = true;
        }
        catch
        {
            // Prerendering error boundary safety
        }
    }
}