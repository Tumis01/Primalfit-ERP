    [SupplyParameterFromQuery(Name = "view")] public Guid? ViewSourceId { get; set; }
    private Guid companyId; private string userId = "", companyName = "", baseCurrency = "BASE", search = "", sourceSearch = "", message = ""; private bool showCreate, saving, isLoading = true, isError, invoiceFullOrderQuantity;
    private DateTime? fromDate, toDate; private int page = 1; private const int PageSize = 10;
    private Guid? filterCustomerId, filterSiteId, filterCurrencyId, filterShipmentId;
    private Dictionary<(Guid, Guid, Guid), DestinationDocumentTerms> terms = new(); private Dictionary<Guid, string> sites = new(), currencies = new(), sourceNumbers = new(), taxNames = new(); private Dictionary<Guid, decimal> taxRates = new(), withholdingRates = new(), latestRates = new(), sourceQuantities = new(); private Dictionary<Guid, Guid> sourceDocumentIds = new();
    private List<SalesInvoice> invoices = new(); private List<WorkflowLineOption> eligibleLines = new(); private HashSet<Guid> selectedLineIds = new();
    private sealed class ManualRow { public Guid? DimensionSetId { get; set; } public Guid Id { get; } = Guid.NewGuid(); public Guid? ItemId { get; set; } public Guid? UomId { get; set; } public string UomName { get; set; } = ""; public decimal Factor { get; set; } = 1m; public decimal Quantity { get; set; } = 1m; public decimal UnitPrice { get; set; } }
    private List<ManualRow> manualLines = new(); private List<Customer> customers = new(); private List<Item> items = new(); private List<UnitOfMeasure> uoms = new(); private List<UomConversionRule> conversionRules = new(); private List<ItemUomConversionLine> itemUoms = new();
    private IReadOnlyDictionary<(Guid, Guid), decimal> ConversionMap => conversionRules.ToDictionary(x => (x.FromUomId, x.ToUomId), x => x.ConversionFactor);
    private IReadOnlyCollection<DropdownOption> ItemOptions => items.Select(x => new DropdownOption(x.Id, x.Name, x.Code)).OrderBy(x => x.Label).ToList();
    private IReadOnlyCollection<DropdownOption> ManualUomOptions(ManualRow row) { var item = items.FirstOrDefault(x => x.Id == row.ItemId); if (item == null) return Array.Empty<DropdownOption>(); var ids = item.UomId.HasValue ? UomConversion.ConfiguredUoms(item).ToHashSet() : new HashSet<Guid>(); foreach (var unit in itemUoms.Where(x => x.ItemId == item.Id)) ids.Add(unit.UomId); return uoms.Where(x => ids.Contains(x.Id)).Select(x => new DropdownOption(x.Id, x.Name)).ToList(); }
    private string SourceReferences(SalesInvoice invoice) { var names = invoice.Lines.Where(x => x.ShipmentLineId.HasValue).Select(x => sourceNumbers.GetValueOrDefault(x.ShipmentLineId!.Value, "Unavailable")).Distinct().ToList(); return names.Count > 0 ? string.Join(", ", names) : "-"; }
    private string SiteName(Guid? id) => id.HasValue ? sites.GetValueOrDefault(id.Value, "Unavailable") : "No warehouse"; private string CurrencyName(Guid id) => currencies.GetValueOrDefault(id, "Unavailable");
    private IReadOnlyCollection<DropdownOption> CustomerOptions => customers.Select(x => new DropdownOption(x.Id, x.Name, x.Code)).OrderBy(x => x.Label).ToList();
    private IReadOnlyCollection<DropdownOption> SiteOptions => eligibleLines.Where(x => x.SiteId.HasValue && x.PartnerId == filterCustomerId && x.CurrencyId == filterCurrencyId).Select(x => x.SiteId!.Value).Distinct().Select(x => new DropdownOption(x, SiteName(x))).OrderBy(x => x.Label).ToList();
    private IReadOnlyCollection<DropdownOption> CurrencyOptions => currencies.Select(x => new DropdownOption(x.Key, x.Value)).OrderBy(x => x.Label).ToList();
    private IReadOnlyCollection<DropdownOption> ShipmentOptions => eligibleLines.Where(x => x.PartnerId == filterCustomerId && x.CurrencyId == filterCurrencyId && (!filterSiteId.HasValue || x.SiteId == filterSiteId)).GroupBy(x => x.DocumentId).Select(x => new DropdownOption(x.Key, x.First().DocumentNumber, x.First().BusinessPartner)).OrderBy(x => x.Label).ToList();
    private IEnumerable<WorkflowLineOption> FilteredSource => eligibleLines.Where(x => filterCustomerId.HasValue && x.PartnerId == filterCustomerId && (!filterSiteId.HasValue || x.SiteId == filterSiteId) && filterCurrencyId.HasValue && x.CurrencyId == filterCurrencyId && (!filterShipmentId.HasValue || x.DocumentId == filterShipmentId) && (string.IsNullOrWhiteSpace(sourceSearch) || x.DocumentNumber.Contains(sourceSearch, StringComparison.OrdinalIgnoreCase) || x.BusinessPartner.Contains(sourceSearch, StringComparison.OrdinalIgnoreCase) || x.ItemName.Contains(sourceSearch, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<IGrouping<(Guid PartnerId, Guid CurrencyId), WorkflowLineOption>> SelectedGroups
    {
        get
        {
            var selected = eligibleLines.Where(x => selectedLineIds.Contains(x.Id)).ToList();
            if (selected.Count == 0 && manualLines.Count > 0 && filterCustomerId.HasValue && filterCurrencyId.HasValue)
                selected.Add(new WorkflowLineOption(Guid.Empty, Guid.Empty, filterCustomerId.Value, null, filterCurrencyId.Value, latestRates.GetValueOrDefault(filterCurrencyId.Value, 1m), "", customers.FirstOrDefault(x => x.Id == filterCustomerId)?.Name ?? "Customer", "", DateTime.Today, 0, "", 0));
            return selected.GroupBy(x => (x.PartnerId, x.CurrencyId));
        }
    }
    private IEnumerable<SalesInvoice> FilteredInvoices => invoices.Where(x => (!fromDate.HasValue || x.Date >= DateOnly.FromDateTime(fromDate.Value)) && (!toDate.HasValue || x.Date <= DateOnly.FromDateTime(toDate.Value)) && (string.IsNullOrWhiteSpace(search) || x.InvoiceNumber.Contains(search, StringComparison.OrdinalIgnoreCase) || (x.Customer?.Name ?? "").Contains(search, StringComparison.OrdinalIgnoreCase) || x.Lines.Any(l => (l.Item?.Name ?? l.Description ?? "").Contains(search, StringComparison.OrdinalIgnoreCase))));
    private int PageCount => Math.Max(1, (int)Math.Ceiling(FilteredInvoices.Count() / (double)PageSize)); private int CurrentPage => Math.Min(Math.Max(1, page), PageCount); private IEnumerable<SalesInvoice> PagedInvoices => FilteredInvoices.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SALES_ORDER_PAGE")) { Navigation.NavigateTo("/access-denied"); return; }
        var user = await UserManager.GetUserAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User);
        companyId = user?.CompanyDetailsId ?? Guid.Empty; userId = user?.Id ?? "";
        if (companyId != Guid.Empty)
