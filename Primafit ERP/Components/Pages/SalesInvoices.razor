        var header = HeaderTerms; header.InvoiceDate = invoice.Date.ToDateTime(TimeOnly.MinValue); header.ExchangeRate = invoice.ExchangeRate;
        header.TaxId = invoice.TaxId; header.WithholdingTaxId = invoice.WithholdingTaxId;
        header.DiscountPercentage = invoice.DiscountPercentage; header.DiscountAmount = invoice.DiscountAmount; header.Confirmed = true;

        invoiceRoute = new InvoiceRoute { TemplateId = invoice.CustomTransactionTypeId, DebitAccountId = invoice.ReceivablesGlAccountId, CreditAccountId = invoice.DirectIncomeGlAccountId, TaxAccountId = invoice.TaxGLAccountId, DiscountAccountId = invoice.DiscountGlAccountId };
        foreach (var line in invoice.Lines) manualLines.Add(new ManualRow { DimensionSetId = line.DimensionSetId,  ItemId = line.ItemId, UomId = line.UomId, UomName = line.UomName, Factor = line.UomConversionFactor, Quantity = UomConversion.FromBase(line.QuantityInvoiced, line.UomConversionFactor), UnitPrice = UomConversion.PriceFromBase(line.UnitPrice, line.UomConversionFactor) });
