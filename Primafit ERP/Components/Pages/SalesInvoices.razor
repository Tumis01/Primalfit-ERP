    private async Task LoadAsync() { await using var db = await DbFactory.CreateDbContextAsync(); canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(companyId); batchStatuses = await db.GLBatches.AsNoTracking().Where(x => x.CompanyId == companyId).ToDictionaryAsync(x => x.Id, x => x.Status); var company = await db.CompanyDetails.AsNoTracking().FirstOrDefaultAsync(x => x.CompanyDetailsId == companyId); companyName = company?.CompanyName ?? ""; baseCurrency = company?.BaseCurrency ?? "BASE"; customers = await db.Customers.AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); items = await db.Items.Include(x => x.UomConversions).AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); uoms = await db.UnitOfMeasures.AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); conversionRules = await db.UomConversionRules.AsNoTracking().Where(x => x.CompanyId == companyId && x.IsActive).ToListAsync(); itemUoms = await db.ItemUomConversionLines.AsNoTracking().Where(x => x.IsActive && x.Item!.CompanyId == companyId).ToListAsync(); sites = await db.Warehouses.AsNoTracking().Where(x => x.CompanyId == companyId).ToDictionaryAsync(x => x.Id, x => x.Name); currencies = await db.Currencies.AsNoTracking().Where(x => x.CompanyId == companyId).ToDictionaryAsync(x => x.Id, x => x.CurrencyCode); var rateRows = await db.CurrencyManagements.AsNoTracking().Where(x => x.CompanyId == companyId && x.Rate > 0 && db.Currencies.Any(c => c.CompanyId == companyId && c.IsBaseCurrency && (c.Id == x.ExchangeCurrencyId || (!x.ExchangeCurrencyId.HasValue && c.CurrencyCode == x.ExchangeCurrency)))).OrderByDescending(x => x.Date).ToListAsync(); latestRates = rateRows.GroupBy(x => x.CurrencyId).ToDictionary(x => x.Key, x => x.First().Rate); var taxes = await db.Taxes.AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); taxNames = taxes.ToDictionary(x => x.Id, x => x.TaxName); taxRates = taxes.ToDictionary(x => x.Id, x => x.Per); withholdingRates = await db.WithholdingTaxes.AsNoTracking().Where(x => x.CompanyId == companyId).ToDictionaryAsync(x => x.Id, x => x.PercentageValue); var sourceData = await (from line in db.SalesShipmentLines.AsNoTracking() join shipment in db.SalesShipments.AsNoTracking() on line.ShipmentId equals shipment.Id where shipment.CompanyId == companyId select new { line.Id, DocumentId = shipment.Id, Number = shipment.ShipmentNumber, Quantity = line.QtyShipped }).ToListAsync(); sourceNumbers = sourceData.ToDictionary(x => x.Id, x => x.Number); sourceDocumentIds = sourceData.ToDictionary(x => x.Id, x => x.DocumentId); sourceQuantities = sourceData.ToDictionary(x => x.Id, x => x.Quantity); invoices = (await Workflow.GetSalesInvoicesAsync(companyId)).Where(x => !x.IsDirectInvoice).ToList(); eligibleLines = await Workflow.GetShipmentLinesReadyToInvoiceAsync(companyId); }
    private async Task OnSourcePartnerChanged(Guid? id) { if (id == filterCustomerId) return; if (!await ConfirmLineReset()) return; filterCustomerId = id; selectedLineIds.Clear(); manualLines.Clear(); terms.Clear(); headerTermsEdited = false; filterSiteId = filterShipmentId = null; var currency = customers.FirstOrDefault(x => x.Id == id)?.CurrencyId; filterCurrencyId = currency.HasValue && currencies.ContainsKey(currency.Value) ? currency : null; sourceSearch = ""; if (filterCurrencyId.HasValue) { var rate = await CurrencyService.GetLatestExchangeRateAsync(companyId, filterCurrencyId.Value); if (filterCustomerId == id && !headerTermsEdited && selectedLineIds.Count == 0) HeaderTerms.ExchangeRate = rate; } }
    private async Task OnSourceCurrencyChanged(Guid? id) { if (id == filterCurrencyId) return; if (!await ConfirmLineReset()) return; filterCurrencyId = id; filterSiteId = filterShipmentId = null; selectedLineIds.Clear(); manualLines.Clear(); terms.Clear(); }
    private async Task<bool> ConfirmLineReset() => (selectedLineIds.Count == 0 && manualLines.Count == 0) || await JS.InvokeAsync<bool>("confirm", "Changing the customer or currency will remove the selected and manual lines. Continue?");
    private void OnSourceWarehouseChanged(Guid? id) { filterSiteId = id; filterShipmentId = null; }
    private void OnSearch(ChangeEventArgs e) { search = e.Value?.ToString() ?? ""; page = 1; }
    private async Task BackToList() { if (!await ConfirmDiscardDraft()) return; showCreate = false; editingId = null; editingNumber = null; readOnly = editingInReview = false; selectedLineIds.Clear(); manualLines.Clear(); terms.Clear(); message = ""; await LoadAsync(); }
    private void NewFromShipment() { if (showCreate && !editingId.HasValue) return; editingId = null; editingNumber = null; sourceReference = ""; readOnly = editingInReview = false; invoiceRoute = new(); manualEntry = true; headerTermsEdited = false; invoiceFullOrderQuantity = false; showCreate = true; message = ""; selectedLineIds.Clear(); manualLines.Clear(); terms.Clear(); sourceSearch = ""; filterCustomerId = filterSiteId = filterCurrencyId = filterShipmentId = null; }
    private async Task<bool> ConfirmDiscardDraft() => readOnly || !showCreate || (selectedLineIds.Count == 0 && manualLines.Count == 0) || await JS.InvokeAsync<bool>("confirm", "Discard the invoice you are preparing and its selected lines?");
    private void SetInvoiceQuantityMode(bool full) { invoiceFullOrderQuantity = full; MarkTermsChanged(); }
    private decimal InvoiceQuantity(WorkflowLineOption line)
    {
        if (!invoiceFullOrderQuantity) return line.Quantity;
        var selected = eligibleLines.Where(x => selectedLineIds.Contains(x.Id) && x.OrderLineId == line.OrderLineId).ToList();
        if (selected.Count == 0 || selected[0].Id != line.Id) return line.Quantity;
        var extra = Math.Max(0m, line.RemainingInvoiceQuantityBase - selected.Sum(x => UomConversion.ToBase(x.Quantity, x.UomConversionFactor)));
        return line.Quantity + UomConversion.FromBase(extra, line.UomConversionFactor);
    }
    private decimal SourceTotal(IEnumerable<WorkflowLineOption> sourceLines)
    {
        var groups = sourceLines.Where(x => x.Id != Guid.Empty).GroupBy(x => x.OrderLineId);
        decimal total = 0m;
        foreach (var group in groups)
        {
            var lines = group.ToList();
            var selectedBase = lines.Sum(x => UomConversion.ToBase(x.Quantity, x.UomConversionFactor));
            var extra = invoiceFullOrderQuantity ? Math.Max(0m, lines[0].RemainingInvoiceQuantityBase - selectedBase) : 0m;
            for (var i = 0; i < lines.Count; i++)
            {
                var line = lines[i];
                var quantity = UomConversion.ToBase(line.Quantity, line.UomConversionFactor) + (i == 0 ? extra : 0m);
                total += Math.Round(quantity * UomConversion.PriceToBase(line.UnitPrice, line.UomConversionFactor), 2, MidpointRounding.AwayFromZero);
            }
        }
        return total;
    }
    private void MarkTermsChanged() { foreach (var value in terms.Values) value.Confirmed = false; }
    private void AddManualLine() { if (!manualEntry) return; manualLines.Add(new ManualRow()); MarkTermsChanged(); }
    private void RemoveManualLine(ManualRow row) { manualLines.Remove(row); MarkTermsChanged(); }
    private void SetManualItem(ManualRow row, Guid? id)
    {
        var item = items.FirstOrDefault(x => x.Id == id); row.ItemId = item?.Id; row.UomId = item?.UomId;
        row.UomName = item == null ? "" : uoms.FirstOrDefault(x => x.Id == item.UomId)?.Name ?? item.UoM;
        row.Factor = 1m; row.Quantity = 1m; row.UnitPrice = 0m; MarkTermsChanged();
    }
    private void SetManualUom(ManualRow row, Guid? id)
    {
        var item = items.FirstOrDefault(x => x.Id == row.ItemId);
        if (item == null || !id.HasValue || !ManualUomOptions(row).Any(x => x.Id == id)) return;
        var factors = itemUoms.Where(x => x.ItemId == item.Id).GroupBy(x => x.UomId).ToDictionary(x => x.Key, x => x.First().ConversionFactorToBase);
        var newFactor = UomConversion.FactorFor(item, id, factors, ConversionMap);
        row.Quantity = UomConversion.FromBase(UomConversion.ToBase(row.Quantity, row.Factor), newFactor);
        row.UnitPrice = UomConversion.PriceFromBase(UomConversion.PriceToBase(row.UnitPrice, row.Factor), newFactor);
        row.UomId = id; row.UomName = uoms.First(x => x.Id == id).Name; row.Factor = newFactor; MarkTermsChanged();
    }
    private void SelectVisible() => SetSelection(FilteredSource.Select(x => x.Id).ToList(), true);
    private void ClearSelection() { selectedLineIds.Clear(); MarkTermsChanged(); }
    private void ToggleGroup(IEnumerable<Guid> ids, ChangeEventArgs e) => SetSelection(ids.ToList(), e.Value is bool selected && selected);
    private void ToggleLine(Guid id, ChangeEventArgs e) => SetSelection(new[] { id }, e.Value is bool selected && selected);
    private void SetSelection(IEnumerable<Guid> ids, bool selected)
    {
        if (manualEntry) return;
        var hadSelection = selectedLineIds.Count > 0;
        var changed = new HashSet<(Guid, Guid, Guid)>();
        foreach (var id in ids)
        {
            var line = eligibleLines.FirstOrDefault(x => x.Id == id);
            if (line == null || !(selected ? selectedLineIds.Add(id) : selectedLineIds.Remove(id))) continue;
            changed.Add((line.PartnerId, Guid.Empty, line.CurrencyId));
        }
        foreach (var key in changed)
        {
            if (terms.TryGetValue(key, out var current)) current.Confirmed = false;
        }
        if (selected && !hadSelection && !headerTermsEdited && eligibleLines.FirstOrDefault(x => selectedLineIds.Contains(x.Id)) is { } first)
        {
            var header = HeaderTerms;
            header.ExchangeRate = first.ExchangeRate; header.TaxId = first.TaxId;
            header.DiscountPercentage = first.DiscountPercentage; header.DiscountAmount = first.DiscountAmount;
            header.WithholdingTaxId = first.WithholdingTaxId; header.Confirmed = false;
        }
    }
    private DestinationDocumentTerms GetTerms(WorkflowLineOption line) { var key = (line.PartnerId, Guid.Empty, line.CurrencyId); if (!terms.TryGetValue(key, out var value)) terms[key] = value = new DestinationDocumentTerms { PartnerId = key.Item1, SiteId = key.Item2, CurrencyId = key.Item3, ExchangeRate = line.ExchangeRate, TaxId = line.TaxId, DiscountPercentage = line.DiscountPercentage, DiscountAmount = line.DiscountAmount, WithholdingTaxId = line.WithholdingTaxId, InvoiceDate = DateTime.Today }; return value; }
    private async Task CreateInvoices(bool submitForReview)
    {
        if (saving || readOnly) return;
        saveAttempt++;
        if (selectedLineIds.Count > 0 && manualLines.Count > 0) { message = "Choose one invoice entry method. Source lines and manual lines cannot be combined."; isError = true; return; }
        var group = SelectedGroups.SingleOrDefault();
        if (!filterCustomerId.HasValue || !filterCurrencyId.HasValue || group == null) { message = "Select a customer, currency and at least one line."; isError = true; return; }
        if (manualLines.Any(x => !x.ItemId.HasValue || x.Quantity <= 0 || x.UnitPrice < 0)) { message = "Every manual line needs an item, positive quantity and non-negative unit price."; isError = true; return; }
        var selectedTerms = GetTerms(group.First());
        selectedTerms.InvoiceFullOrderQuantity = invoiceFullOrderQuantity; selectedTerms.Route = invoiceRoute;
        if (!selectedTerms.InvoiceDate.HasValue) { message = "Enter an invoice date."; isError = true; return; }
        saving = true;
        try
        {
            selectedTerms.LineDimensionSets = eligibleLines.Where(x => selectedLineIds.Contains(x.Id)).ToDictionary(x => x.Id, x => x.DimensionSetId);
            message = await Workflow.CreateNormalSalesInvoiceDraftAsync(companyId, filterCustomerId.Value, filterCurrencyId.Value, eligibleLines.Where(x => selectedLineIds.Contains(x.Id)).Select(x => x.Id).ToList(), manualLines.Select(x => new ManualSalesInvoiceLineInput(x.ItemId!.Value, x.UomId, x.UomName, x.Factor, x.Quantity, x.UnitPrice, x.DimensionSetId)).ToList(), selectedTerms, editingId, submitForReview ? (db, id) => Workflow.StageSalesInvoiceAsync(db, id, userId) : null);
            isError = !string.IsNullOrEmpty(message);
            if (!isError) { selectedLineIds.Clear(); manualLines.Clear(); terms.Clear(); showCreate = false; await LoadAsync(); message = submitForReview ? "Sales invoice sent to GL review." : "Sales invoice draft saved."; editingId = null; editingNumber = null; }
        }
        finally { saving = false; }
    }
    private async Task DeleteDraft(Guid id, string number)
    {
        if (saving || !await JS.InvokeAsync<bool>("confirm", $"Delete invoice draft {number}? Its source quantities will become available again.")) return;
        saving = true;
        try
        {
            message = await Workflow.DeleteNormalSalesInvoiceDraftAsync(companyId, id, userId);
            isError = !string.IsNullOrEmpty(message);
            if (!isError) { await LoadAsync(); message = $"Invoice draft {number} was deleted and its source quantities released."; }
        }
        finally { saving = false; }
    }
    private async Task PostInvoice(Guid invoiceId) { if (saving) return; saving = true; try { message = await Workflow.PostSalesInvoiceAsync(invoiceId, userId); isError = !string.IsNullOrEmpty(message); await LoadAsync(); if (!isError) message = "Sales invoice was sent to the GL review queue."; } finally { saving = false; } }
}
