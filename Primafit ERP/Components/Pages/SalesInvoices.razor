        ? GetTerms(new WorkflowLineOption(Guid.Empty, Guid.Empty, filterCustomerId.Value, null, filterCurrencyId.Value, latestRates.GetValueOrDefault(filterCurrencyId.Value, 1m), "", "", "", DateTime.Today, 0, "", 0)) : emptyHeaderTerms;
