            var print = new SalesOrder { OrderNumber = invoice.InvoiceNumber, Date = invoice.Date, Customer = invoice.Customer, Currency = invoice.Currency, Status = OrderStatus.Invoiced, DiscountPercentage = invoice.DiscountPercentage, DiscountAmount = invoice.DiscountAmount, GrandTotalForeign = invoice.TotalAmountForeign, Lines = invoice.Lines.Select(x => new SalesOrderLine { DimensionSetId = x.DimensionSetId,  Item = x.Item, Description = x.Description, Quantity = UomConversion.FromBase(x.QuantityInvoiced, x.UomConversionFactor), UnitPrice = UomConversion.PriceFromBase(x.UnitPrice, x.UomConversionFactor) }).ToList() }; var bytes = ExportService.GenerateInvoicePdf(print, company, CurrencyName(invoice.CurrencyId));
            using var stream = new MemoryStream(bytes); using var reference = new DotNetStreamReference(stream); await JS.InvokeVoidAsync("downloadFileFromStream", $"Invoice_{invoice.InvoiceNumber}.pdf", reference);
