@page "/ap/direct-bills"

@using Microsoft.EntityFrameworkCore
@using PrimafitERP.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Components.Shared
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO

@inject PurchasingService PurchService
@inject ProjectService ProjectService
@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject TransactionMappingService MappingService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ReportExportService ExportService
@inject NavigationManager NavManager
@inject PermissionCacheService PermissionCache
@inject IEmailService EmailService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 font-sans text-slate-800">

    @if (!StartInCreate)
    {
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Direct Purchase Invoice</h1>
            <p class="text-sm text-slate-500 mt-1">Record non-PO expenses (like rent, utilities, or services) directly to your General Ledger.</p>
        </div>

        @if (!showForm && HasCompany && !isLoading)
        {
            <PermissionGate Key="PO_CREATE">
                <Authorized>
                    <button type="button" @onclick="OpenNewForm" class="px-5 py-2.5 bg-indigo-600 text-white font-bold text-sm rounded-xl hover:bg-indigo-700 transition-colors shadow-sm flex items-center gap-2 active:scale-95">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        <span>Create Invoice</span>
                    </button>
                </Authorized>
            </PermissionGate>
        }
    </div>
    }

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading AP setup data...</div>
    }
    else if (HasCompany)
    {
        @if (showForm)
        {
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-visible mb-8">
                <!-- Form Header Bar -->
                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between sm:items-center gap-4 rounded-t-2xl">
                    <div class="flex items-center gap-3">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-500">Purchase Invoice Workspace</span>
                        @if (!string.IsNullOrEmpty(bill.ExternalInvoiceNumber))
                        {
                            <span class="px-2.5 py-1 bg-slate-200 text-slate-700 font-mono text-xs rounded-lg font-bold">@bill.ExternalInvoiceNumber</span>
                        }
                    </div>

                    <div class="flex items-center gap-3">
                        @if (bill.IsPosted)
                        {
                            <span class="px-2.5 py-1 text-[10px] font-bold rounded-lg uppercase tracking-wider @(currentBatchStatus == BatchStatus.Rejected ? "bg-rose-100 text-rose-800" : currentBatchStatus == BatchStatus.Ready ? "bg-indigo-100 text-indigo-800" : "bg-emerald-100 text-emerald-800")">
                                @(currentBatchStatus == BatchStatus.Rejected ? "Rejected - Edit Required" : (currentBatchStatus == BatchStatus.Ready ? "In Review" : "Posted"))
                            </span>
                        }
                        @if (!IsLocked && canConfigureRoute)
                        {
                            <!-- Configure Route Button -->
                            <button type="button" @onclick="OpenRouteModal" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors flex items-center gap-1.5 shadow-sm active:scale-95">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                <span>Configure Route</span>
                                @if (bill.CustomTransactionTypeId.HasValue)
                                {
                                    <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                                }
                            </button>
                        }
                    </div>
                </div>

                @if (currentBatchStatus == BatchStatus.Rejected && !string.IsNullOrWhiteSpace(currentBatchRejectionReason))
                {
                    <div class="px-6 py-3 bg-rose-50 border-b border-rose-200 text-xs text-rose-800">
                        <span class="font-bold uppercase tracking-wider">GL review rejection:</span> @currentBatchRejectionReason
                    </div>
                }

                <EditForm Model="bill">
                    <div class="px-6 pt-5"><DocumentNumberPreview CompanyId="@selectedCompanyId" Target="SequenceTargetType.AP_Invoice" Date="@bill.BillDate" Number="@bill.PurchaseInvoiceNumber" /></div>
                    <DataAnnotationsValidator />

                    <div class="p-6 md:p-8 space-y-8">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 bg-slate-50 p-6 rounded-2xl border border-slate-200">
                            <SearchableGuidSelect Label="Vendor" Required="true" Options="@DirectVendorOptions" Value="@(bill.VendorId == Guid.Empty ? null : bill.VendorId)" ValueChanged="OnDirectVendorChanged" Disabled="@IsLocked" Placeholder="Search vendor" />

                            <div>
                                <label class="label">Bill Date</label>
                                <input type="datetime-local" value="@bill.BillDate.ToString("yyyy-MM-ddTHH:mm")" @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) bill.BillDate = d; })" class="input-class bg-white" disabled="@IsLocked" />
                            </div>

                            <ExchangeRatePicker CompanyId="@selectedCompanyId"
                                                 CurrencyId="@bill.CurrencyId"
                                                 CurrencyCode="@GetCurrencyCode(bill.CurrencyId)"
                                                 CompanyBaseCurrency="@companyBaseCurrency"
                                                 CurrentRate="@bill.ExchangeRate"
                                                 CurrentRateChanged="OnExchangeRateChanged"
                                                 Disabled="@IsLocked" Searchable="true" />

                            <DocumentCurrency Code="@GetCurrencyCode(bill.CurrencyId)" />
                            <SearchableGuidSelect Label="Tax / VAT" Options="@DirectTaxOptions" Value="@bill.TaxId" ValueChanged="OnDirectTaxChanged" Disabled="@IsLocked" Placeholder="Search tax" ClearLabel="No tax" />
                            <SearchableGuidSelect Label="Withholding Tax" Options="@DirectWithholdingOptions" Value="@bill.WithholdingTaxId" ValueChanged="OnDirectWithholdingChanged" Disabled="@IsLocked" Placeholder="Search withholding" ClearLabel="No withholding" />

                            <label class="text-xs font-bold text-slate-600">Discount (%)<input type="number" min="0" max="100" step="0.0001" @bind="bill.DiscountPercentage" @bind:after="() => { if (bill.DiscountPercentage > 0) bill.DiscountAmount = 0; }" disabled="@IsLocked" class="input-class mt-1" /></label>
                            <label class="text-xs font-bold text-slate-600">Discount amount<input type="number" min="0" step="0.0001" @bind="bill.DiscountAmount" @bind:after="() => { if (bill.DiscountAmount > 0) bill.DiscountPercentage = 0; }" disabled="@IsLocked" class="input-class mt-1" /></label>

                        </div>

                        <!-- Lines Grid -->
                        <div class="border border-slate-200 rounded-xl shadow-sm overflow-hidden">
                            <div class="transaction-lines-scroll" role="region" aria-label="Transaction line items" tabindex="0"><table class="transaction-lines w-full text-sm text-left">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-[50%]">Description / Memo <span class="text-rose-500">*</span></th>
                                        <th class="p-3 w-[15%] text-center">Qty</th>
                                        <th class="p-3 w-[15%] text-right">Unit Cost (@currencySymbol)</th>
                                        <th class="p-3 w-[15%] text-right pr-4">Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    <th class="p-3">Dimensions</th></tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in bill.Lines)
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="p-2 pl-4 align-top pt-3">
                                                <InputText @bind-Value="line.Description" class="input-class" placeholder="e.g. Office Electricity Bill" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number"   @bind="line.QuantityBilled" class="input-class text-center font-bold" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number"   @bind="line.UnitCostBilled" class="input-class text-right font-mono" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-5 text-right font-mono font-bold text-slate-700">
                                                @line.LineTotal.ToString("N4")
                                            </td>
                                            <td class="p-2 text-center align-top pt-5">
                                                @if (!IsLocked)
                                                {
                                                    <button type="button" @onclick="() => bill.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600 transition-colors">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        <td class="p-3 align-top"><DimensionSelect CompanyId="@selectedCompanyId" @bind-Value="line.DimensionSetId" Disabled="@IsLocked" /></td></tr>
                                    }
                                </tbody>
                            </table></div>
                            @if (!IsLocked)
                            {
                                <div class="p-2 bg-slate-50 border-t border-slate-200">
                                    <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Expense Line
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Summary Calculation -->
                        <div class="flex justify-end pt-4">
                            <div class="w-full md:w-80 bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm space-y-2 text-sm text-slate-600">
                                <div class="flex justify-between">
                                    <span>Subtotal:</span>
                                    <span class="font-mono font-bold">@SubTotalForeign.ToString("N4")</span>
                                </div>
                                @if (DiscountForeign > 0) { <div class="flex justify-between"><span>Discount:</span><span class="font-mono">− @DiscountForeign.ToString("N4")</span></div> }
                                <div class="flex justify-between items-center pt-2">
                                    <span>Tax (@TaxPercentage%):</span>
                                    <span class="font-mono font-bold">+ @TaxAmountForeign.ToString("N4")</span>
                                </div>
                                <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                    <span class="font-bold">Total Invoice Amount (Gross) (@currencySymbol):</span>
                                    <span class="font-mono font-black text-rose-700 text-2xl">@GrandTotalForeign.ToString("N4")</span>
                                </div>
                                @if (WithholdingAmountForeign > 0)
                                {
                                    <div class="flex justify-between items-center text-amber-700 border-t border-amber-100 pt-2">
                                        <span>Less: Withholding Tax (@bill.WithholdingPercentage.ToString("0.####")%):</span>
                                        <span class="font-mono font-bold">- @currencySymbol@WithholdingAmountForeign.ToString("N4")</span>
                                    </div>
                                    <div class="flex justify-between items-center text-slate-900 font-semibold">
                                        <span>Net Amount Payable to Vendor:</span>
                                        <span class="font-mono font-black text-emerald-700">@currencySymbol@NetAmountPayableForeign.ToString("N4")</span>
                                    </div>
                                }
                                <div class="flex justify-between text-[10px] text-slate-400 mt-2 uppercase font-bold tracking-wider pt-2">
                                    <span>Local Base Value:</span>
                                    <span class="font-mono text-slate-500">@GrandTotalBase.ToString("N4")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Controls -->
                    <div class="p-6 border-t border-slate-100 bg-slate-50/50 flex justify-end gap-3 rounded-b-2xl">
                        @if (IsLocked)
                        {
                            <div class="mr-auto flex items-center gap-2">
                                <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 font-bold text-xs rounded-lg border border-emerald-200 uppercase tracking-wider flex items-center gap-1.5">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Posted
                                </span>


                            </div>
                        }

                        <button type="button" @onclick="CloseForm" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-100 transition-colors">
                            Cancel
                        </button>
                            @if (IsLocked) { <button type="button" @onclick="DownloadBill" disabled="@isExporting" class="px-5 py-1.5 rounded-lg border border-slate-300 text-slate-700 bg-white font-bold text-xs hover:bg-slate-50 transition-colors flex items-center gap-2 disabled:opacity-50 shadow-sm">
                                    @if (isExporting)
                                    {
                                        <span class="animate-spin">↻</span>
                                    }
                                    Download Invoice
                                </button> }

                        <button type="button" @onclick="ResetForm" class="px-6 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-white transition-colors">
                            @(IsLocked ? "New Bill" : "Clear")
                        </button>

                        @if (!IsLocked)
                        {
                            @if (!bill.GLBatchId.HasValue) { <button type="button" @onclick="SaveDraftBill" disabled="@isBusy" class="rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white disabled:opacity-50">Save Invoice Draft</button> }
                            <PermissionGate Key="PO_INVOICE_POST">
                                <Authorized>
                                    <button type="button" @onclick="PostBill" disabled="@isBusy" class="px-8 py-2.5 bg-rose-600 text-white rounded-xl font-bold text-sm hover:bg-rose-700 shadow-md transition-all active:scale-95 disabled:opacity-50 flex items-center gap-2">
                                        @if (isBusy)
                                        {
                                            <span class="animate-spin">↻</span>
                                        }
                                        <span>@(currentBatchStatus == BatchStatus.Rejected ? "Resubmit AP Bill for GL Review" : currentBatchStatus == BatchStatus.Ready ? "Update AP Bill Staging" : "Submit AP Bill for GL Review")</span>
                                    </button>
                                </Authorized>
                            </PermissionGate>
                        }
                    </div>
                </EditForm>
            </div>
        }

        <!-- Historical List Grid -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mt-8">
            <div class="p-6 border-b border-slate-200 flex justify-between items-center bg-slate-50">
                <h2 class="text-lg font-bold text-slate-800">Past Direct Invoices</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-100 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase tracking-wider">
                        <tr>
                            <th class="p-4 pl-6">Date</th>
                            <th class="p-4">Invoice #</th>
                            <th class="p-4">Vendor</th>
                            <th class="p-4">Description</th>
                            <th class="p-4 text-right">Total (Base)</th>
                            <th class="p-4 text-center">Status</th>
                            <th class="p-4 pr-6 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @if (pastBills == null || !pastBills.Any())
                        {
                            <tr>
                                <td colspan="7" class="p-8 text-center text-slate-400 italic">No past direct bills found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pBill in pastBills)
                            {
                                var batchStatus = GetBatchStatus(pBill.GLBatchId, pBill.IsPosted);
                                bool isRejected = batchStatus == BatchStatus.Rejected;
                                bool isPosted = batchStatus == BatchStatus.Posted;
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="p-4 pl-6 whitespace-nowrap">@pBill.BillDate.ToString("MMM dd, yyyy")</td>
                                    <td class="p-4 font-mono text-slate-600 font-semibold whitespace-nowrap">@pBill.ExternalInvoiceNumber</td>
                                    <td class="p-4 font-bold text-slate-800">@(vendors.FirstOrDefault(v => v.Id == pBill.VendorId)?.Name ?? "Unknown")</td>
                                    <td class="p-4 text-slate-500 max-w-xs truncate" title="@pBill.Description">@pBill.Description</td>
                                    <td class="p-4 text-right font-mono font-bold text-slate-700">@pBill.TotalAmount.ToString("N4")</td>
                                    <td class="p-4 text-center">
                                        @if (isPosted)
                                        {
                                            <span class="px-2 py-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded uppercase tracking-wider">Posted</span>
                                        }
                                        else if (isRejected)
                                        {
                                            <span class="px-2 py-1 bg-rose-100 text-rose-800 text-[10px] font-bold rounded uppercase tracking-wider">Rejected - Edit Required</span>
                                        }
                                        else if (batchStatus == BatchStatus.Ready)
                                        {
                                            <span class="px-2 py-1 bg-indigo-100 text-indigo-800 text-[10px] font-bold rounded uppercase tracking-wider">In Review</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-1 bg-amber-100 text-amber-800 text-[10px] font-bold rounded uppercase tracking-wider">Draft</span>
                                        }
                                    </td>
                                    <td class="p-4 pr-6 text-center space-x-2 whitespace-nowrap">
                                        <button type="button" @onclick="() => LoadBillForView(pBill)" class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 hover:text-slate-900 text-xs font-bold transition-colors">
                                            @(isRejected ? "Edit & Resubmit" : (isPosted ? "View" : batchStatus == BatchStatus.Ready ? "Update Staging" : "Edit Draft"))
                                        </button>

                                        @if (batchStatus == BatchStatus.Ready)
                                        {
                                            <button type="button" @onclick="() => UpdateStagedBill(pBill)" class="px-3 py-1.5 bg-indigo-50 text-indigo-700 border border-indigo-200 rounded-lg hover:bg-indigo-100 text-xs font-bold transition-colors">
                                                Update Staging
                                            </button>
                                        }

                                        @if (pBill.IsFullyPaid)
                                        {
                                            <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                                Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <PermissionGate Key="PAYMENT_CREATE">
                                                <Authorized>
                                                    <button type="button" @onclick="() => NavigateToPayment(pBill.Id)" class="px-3 py-1.5 bg-indigo-50 text-indigo-600 border border-indigo-200 rounded-lg hover:bg-indigo-600 hover:text-white text-xs font-bold transition-colors">
                                                        @(pBill.AmountPaid > 0 ? "Pay Balance" : "Pay Bill")
                                                    </button>
                                                </Authorized>
                                            </PermissionGate>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ========================================================= -->
<!-- ROUTE CONFIGURATION MODAL (WITH OVERLAPPING DROPDOWNS & 'X' BUTTONS) -->
<!-- ========================================================= -->
<InvoiceRouteEditor @ref="directRouteEditor" CompanyId="@selectedCompanyId" Module="TransactionTemplateModule.AP" Value="@DirectRoute" ValueChanged="ApplyDirectRoute" />

<!-- Email Modal -->
@if (showEmailPopup)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border border-slate-200 animate-in zoom-in-95 duration-200">
            <div class="p-6 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <h3 class="font-bold text-slate-800 uppercase tracking-wider text-sm">Send Payment Remittance</h3>
                <button type="button" @onclick="CloseEmailPopup" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="label">To Vendor:</label>
                    <input type="text" class="input-class bg-slate-50 cursor-not-allowed font-bold text-slate-600" value="@($"{emailVendorName} <{emailVendorAddress}>")" disabled />
                </div>
                <div>
                    <label class="label">Subject:</label>
                    <input type="text" class="input-class font-bold text-slate-800" value="@emailSubject" disabled />
                </div>
                <div>
                    <label class="label">Message:</label>
                    <textarea @bind="customEmailMessage" class="input-class h-40 resize-none text-sm text-slate-700"></textarea>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
                <button type="button" @onclick="CloseEmailPopup" class="px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors disabled:opacity-50" disabled="@isSendingEmail">
                    Skip
                </button>
                <button type="button" @onclick="DispatchEmail" class="px-6 py-2.5 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50" disabled="@isSendingEmail">
                    @if (isSendingEmail)
                    {
                        <span class="animate-spin">↻</span> <span>Sending...</span>
                    }
                    else
                    {

                        <span>Send Remittance</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        color: #0f172a;
        outline: none;
        transition: border-color 0.2s;
    }

        .input-class:focus {
            border-color: #f43f5e;
            box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.15);
        }

        .input-class:disabled {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
            border-color: #e2e8f0;
        }

    tr, td {
        overflow: visible !important;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "view")] public Guid? ViewInvoiceId { get; set; }
    [Parameter] public bool StartInCreate { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    private Guid selectedCompanyId;
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private bool isBusy = false;
    private bool isExporting = false;
    private bool showForm = false;

    private PurchaseInvoice bill = new();
    private List<PurchaseInvoice> pastBills = new();
    private List<Vendor> vendors = new();
    private List<Currency> currencies = new();
    private List<Tax> taxes = new();
    private List<WithholdingTax> withholdingTaxes = new();
    private List<Project> projects = new();

    private List<SegChartOfAccount> apAccounts = new();
    private List<SegChartOfAccount> expenseAccounts = new();
    private List<SegChartOfAccount> taxAccounts = new();
    private bool canConfigureRoute = false;

    // Route Configuration Modal State
    private Guid defaultApAccountId = Guid.Empty;
    private Guid defaultExpenseAccountId = Guid.Empty;

    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private Guid emailTargetBillId = Guid.Empty;
    private string emailVendorName = "";
    private string emailVendorAddress = "";
    private string emailSubject = "";
    private string customEmailMessage = "";
    private string currencySymbol = "";
    private string companyBaseCurrency = "BASE";
    private BatchStatus? currentBatchStatus;
    private string? currentBatchRejectionReason;
    private Dictionary<Guid, BatchStatus> batchStatuses = new();
    private bool IsLocked => bill.IsPosted
        && currentBatchStatus != BatchStatus.Ready
        && currentBatchStatus != BatchStatus.Rejected
        && currentBatchStatus != BatchStatus.Draft;

    private BatchStatus GetBatchStatus(Guid? batchId, bool legacyPosted) =>
        batchId.HasValue && batchStatuses.TryGetValue(batchId.Value, out var status)
            ? status
            : (legacyPosted ? BatchStatus.Posted : BatchStatus.Draft);

    private decimal SubTotalForeign => bill.Lines.Sum(l => l.LineTotal);
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == bill.TaxId)?.Per ?? 0;
    private decimal DiscountForeign => bill.DiscountPercentage > 0 ? SubTotalForeign * bill.DiscountPercentage / 100m : Math.Min(SubTotalForeign, bill.DiscountAmount);
    private decimal TaxAmountForeign => (SubTotalForeign - DiscountForeign) * (TaxPercentage / 100);
    private decimal GrandTotalForeign => SubTotalForeign - DiscountForeign + TaxAmountForeign;
    private decimal WithholdingAmountForeign => bill.WithholdingTaxId.HasValue
        ? (SubTotalForeign - DiscountForeign) * (bill.WithholdingPercentage / 100m)
        : 0m;
    private decimal NetAmountPayableForeign => Math.Max(0, GrandTotalForeign - WithholdingAmountForeign);
    private decimal SubTotalBase => bill.ExchangeRate == 0 ? 0 : SubTotalForeign * bill.ExchangeRate;
    private decimal TaxAmountBase => bill.ExchangeRate == 0 ? 0 : TaxAmountForeign * bill.ExchangeRate;
    private decimal GrandTotalBase => GrandTotalForeign * bill.ExchangeRate;
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("PURCHASING_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            selectedCompanyId = user.CompanyDetailsId.Value;
            canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(selectedCompanyId);
            await LoadData();
            if (ViewInvoiceId.HasValue && pastBills.FirstOrDefault(x => x.Id == ViewInvoiceId) is { } linkedBill) await LoadBillForView(linkedBill);
            else if (StartInCreate) OpenNewForm();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();

        var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
        companyBaseCurrency = company?.BaseCurrency ?? "BASE";
        vendors = await ctx.Vendors.Include(v => v.DefaultCurrency).Where(c => c.CompanyId == selectedCompanyId).ToListAsync();
        projects = await ProjectService.GetActiveProjectsAsync(selectedCompanyId);
        currencies = await CurrService.GetCurrenciesAsync(selectedCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == selectedCompanyId).ToListAsync();
        withholdingTaxes = await ctx.WithholdingTaxes.AsNoTracking().Where(t => t.CompanyId == selectedCompanyId).OrderBy(t => t.PercentageValue).ToListAsync();

        var accountTypes = await SegCoaService.GetAccountTypesAsync();
        var allAccounts = await SegCoaService.GetCoaAsync(selectedCompanyId);

        apAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && type.IsDebit == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        expenseAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == false && type.IsDebit == true && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        taxAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        defaultExpenseAccountId = await MappingService.GetMappedAccountAsync(
            selectedCompanyId, SystemTransactionType.DirectPurchaseInvoice, isDebit: true, defaultAccountId: expenseAccounts.FirstOrDefault()?.Id ?? Guid.Empty);

        pastBills = await PurchService.GetDirectBillsAsync(selectedCompanyId);
        batchStatuses = await ctx.GLBatches
            .Where(b => b.CompanyId == selectedCompanyId)
            .ToDictionaryAsync(b => b.Id, b => b.Status);
        ResetForm();
    }

    private void OpenNewForm()
    {
        ResetForm();
        showForm = true;
    }

    private async Task CloseForm() { showForm = false; if (StartInCreate) await OnExit.InvokeAsync(); }
    private async Task CloseEmailPopup() { showEmailPopup = false; await CloseForm(); }

    private void ResetForm()
    {
        bill = new PurchaseInvoice
        {
            CompanyId = selectedCompanyId,
            BillDate = DateTime.Now,
            ExchangeRate = 1
        };
        currentBatchStatus = null;
        currentBatchRejectionReason = null;
        currencySymbol = "";
        AddLine();
    }

    private void AddLine() => bill.Lines.Add(new PurchaseInvoiceLine { QuantityBilled = 1 });

    private InvoiceRouteEditor? directRouteEditor;
    private InvoiceRoute DirectRoute => new() { TemplateId = bill.CustomTransactionTypeId, DebitAccountId = bill.OverrideExpenseGlAccountId, CreditAccountId = bill.OverrideAccountsPayableGlAccountId, TaxAccountId = bill.TaxGLAccountId, DiscountAccountId = bill.DiscountGlAccountId };
    private Task OpenRouteModal() => directRouteEditor!.Open();
    private void ApplyDirectRoute(InvoiceRoute route)
    {
        bill.CustomTransactionTypeId = route.TemplateId; bill.OverrideExpenseGlAccountId = route.DebitAccountId; bill.OverrideAccountsPayableGlAccountId = route.CreditAccountId;
        bill.TaxGLAccountId = route.TaxAccountId; bill.DiscountGlAccountId = route.DiscountAccountId;
        foreach (var line in bill.Lines) line.ExpenseGlAccountId = route.DebitAccountId ?? Guid.Empty;
    }

    private IReadOnlyCollection<DropdownOption> DirectVendorOptions => vendors.Select(x => new DropdownOption(x.Id, x.Name)).ToList();
    private IReadOnlyCollection<DropdownOption> DirectCurrencyOptions => currencies.Select(x => new DropdownOption(x.Id, x.CurrencyCode)).ToList();
    private IReadOnlyCollection<DropdownOption> DirectTaxOptions => taxes.Select(x => new DropdownOption(x.Id, x.TaxName, $"{x.Per:0.####}%")).ToList();
    private IReadOnlyCollection<DropdownOption> DirectWithholdingOptions => withholdingTaxes.Select(x => new DropdownOption(x.Id, x.Name, $"{x.PercentageValue:0.####}%")).ToList();
    private IReadOnlyCollection<DropdownOption> DirectProjectOptions => projects.Where(x => x.IsActive).Select(x => new DropdownOption(x.Id, x.Name, x.ProjectCode)).ToList();
    private Task OnDirectVendorChanged(Guid? id) => OnVendorChanged(new ChangeEventArgs { Value = id?.ToString() });
    private void OnDirectTaxChanged(Guid? id) => OnTaxChanged(new ChangeEventArgs { Value = id?.ToString() });
    private void OnDirectWithholdingChanged(Guid? id) => OnWithholdingChanged(new ChangeEventArgs { Value = id?.ToString() });
    private async Task OnDirectCurrencyChanged(Guid? id) { bill.CurrencyId = id ?? Guid.Empty; currencySymbol = GetCurrencyCode(bill.CurrencyId); bill.ExchangeRate = bill.CurrencyId == Guid.Empty ? 1 : await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, bill.CurrencyId); }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        bill.AccountsPayableGlId = Guid.Empty;

        if (Guid.TryParse(e.Value?.ToString(), out var venId) && venId != Guid.Empty)
        {
            bill.VendorId = venId;
            var vendor = vendors.FirstOrDefault(c => c.Id == venId);

            if (vendor != null)
            {
                if (vendor.PayablesAccountId.HasValue)
                {
                    bill.AccountsPayableGlId = vendor.PayablesAccountId.Value;
                    defaultApAccountId = vendor.PayablesAccountId.Value;
                }

                if (vendor.CurrencyId != Guid.Empty)
                {
                    bill.CurrencyId = vendor.CurrencyId;
                    currencySymbol = vendor.DefaultCurrency?.CurrencyCode ?? "";
                    bill.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, bill.CurrencyId);
                }
            }
        }
        else
        {
            bill.VendorId = Guid.Empty;
            bill.CurrencyId = Guid.Empty;
            bill.ExchangeRate = 1m;
            currencySymbol = "";
        }
    }

    private void OnExchangeRateChanged(decimal rate)
    {
        bill.ExchangeRate = Math.Round(rate, 4);
    }

    private string GetCurrencyCode(Guid currencyId) => currencies.FirstOrDefault(c => c.Id == currencyId)?.CurrencyCode ?? "";

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId) && taxId != Guid.Empty)
        {
            bill.TaxId = taxId;
            var selectedTax = taxes.FirstOrDefault(t => t.Id == taxId);
            if (selectedTax != null) bill.TaxGLAccountId = selectedTax.GLAccountId;
        }
        else
        {
            bill.TaxId = null;
            bill.TaxGLAccountId = null;
        }
    }

    private async Task SaveDraftBill()
    {
        if (isBusy || IsLocked) return;
        isBusy = true;
        try {
            var error = await PurchService.SaveDirectPurchaseInvoiceDraftAsync(bill);
            if (!string.IsNullOrEmpty(error)) { await JS.InvokeVoidAsync("alert", error); return; }
            pastBills = await PurchService.GetDirectBillsAsync(selectedCompanyId);
            ResetForm(); showForm = false;
        } finally { isBusy = false; }
    }

    private async Task PostBill()
    {
        if (bill.VendorId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a Vendor."); return; }
        if (!bill.Lines.Any()) { await JS.InvokeVoidAsync("alert", "Please add at least one line item."); return; }
        if (bill.Lines.Any(l => string.IsNullOrWhiteSpace(l.Description))) { await JS.InvokeVoidAsync("alert", "All lines must have a Description / Memo."); return; }

        var descriptions = bill.Lines.Select(l => l.Description).Where(d => !string.IsNullOrWhiteSpace(d));
        bill.Description = string.Join(" | ", descriptions);
        if (bill.Description.Length > 200) bill.Description = bill.Description.Substring(0, 197) + "...";

        isBusy = true;
        var err = await PurchService.PostDirectBillAsync(bill, currentUserId);

        if (string.IsNullOrEmpty(err))
        {
            pastBills = await PurchService.GetDirectBillsAsync(selectedCompanyId);

            await using var ctx = await DbFactory.CreateDbContextAsync();
            var emailConfig = await ctx.CompanyEmailSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == selectedCompanyId);
            bool showPopupToggle = emailConfig?.EnableInvoiceEmailPopup ?? true;

            if (!showPopupToggle)
            {
                await JS.InvokeVoidAsync("alert", "Direct Bill submitted for AP/GL review.");
                showForm = false;
                ResetForm();
                isBusy = false;
                if (StartInCreate) await OnExit.InvokeAsync();
                StateHasChanged();
                return;
            }

            var vendor = vendors.FirstOrDefault(v => v.Id == bill.VendorId);
            if (vendor != null && !string.IsNullOrWhiteSpace(vendor.Email))
            {
                emailTargetBillId = bill.Id;
                emailVendorName = vendor.Name;
                emailVendorAddress = vendor.Email;
                emailSubject = $"Remittance Advice - Ref {bill.ExternalInvoiceNumber}";
                customEmailMessage = $"Dear {vendor.Name},\n\nWe have recorded your invoice ({bill.ExternalInvoiceNumber}) successfully into accounts payable.\n\nBest Regards,\nAccounts Payable Team";

                showEmailPopup = true;
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Direct Bill submitted for AP/GL review.\n(No remittance email sent: Vendor missing email address).");
                showForm = false;
            }
            ResetForm();
            if (StartInCreate && !showEmailPopup) await OnExit.InvokeAsync();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
        isBusy = false;
    }

    private void OnWithholdingChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id) && id != Guid.Empty)
        {
            var selected = withholdingTaxes.FirstOrDefault(x => x.Id == id);
            bill.WithholdingTaxId = selected?.Id;
            bill.WithholdingTaxName = selected?.Name;
            bill.WithholdingPercentage = selected?.PercentageValue ?? 0;
            bill.WithholdingGlAccountId = selected?.WithholdingGlAccountId;
        }
        else
        {
            bill.WithholdingTaxId = null;
            bill.WithholdingTaxName = null;
            bill.WithholdingPercentage = 0;
            bill.WithholdingGlAccountId = null;
        }
        bill.WithholdingAmountForeign = 0;
        bill.WithholdingAmount = 0;
    }

    private async Task UpdateStagedBill(PurchaseInvoice selectedBill)
    {
        var status = GetBatchStatus(selectedBill.GLBatchId, selectedBill.IsPosted);
        if (status != BatchStatus.Ready)
        {
            await JS.InvokeVoidAsync("alert", "Only an invoice currently in review can update its staging batch.");
            return;
        }

        await LoadBillForView(selectedBill);
        isBusy = true;
        try
        {
            var descriptions = bill.Lines.Select(l => l.Description).Where(d => !string.IsNullOrWhiteSpace(d));
            bill.Description = string.Join(" | ", descriptions);
            var err = await PurchService.PostDirectBillAsync(bill, currentUserId);
            if (!string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", err);
                return;
            }

            await LoadData();
            showForm = false;
            await JS.InvokeVoidAsync("alert", "AP invoice staging updated and remains in GL review.");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DispatchEmail()
    {
        if (emailTargetBillId == Guid.Empty) return;

        isSendingEmail = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            var vendor = vendors.FirstOrDefault(v => v.Id == bill.VendorId);
            string currCode = currencies.FirstOrDefault(c => c.Id == bill.CurrencyId)?.CurrencyCode ?? "BASE";

            var pdfBytes = ExportService.GeneratePurchaseInvoicePdf(bill, company, vendor?.Name ?? "Vendor", currCode);
            var fileName = $"Direct_Bill_{bill.ExternalInvoiceNumber}.pdf";

            await EmailService.SendEmailAsync(
                emailVendorAddress,
                emailSubject,
                customEmailMessage.Replace("\n", "<br>"),
                pdfBytes,
                fileName
            );

            await JS.InvokeVoidAsync("alert", "Remittance advice emailed successfully!");
            showEmailPopup = false;
            showForm = false;
            emailTargetBillId = Guid.Empty;
            if (StartInCreate) await OnExit.InvokeAsync();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}");
        }
        finally
        {
            isSendingEmail = false;
            StateHasChanged();
        }
    }

    private async Task DownloadBill()
    {
        if (bill == null || bill.Id == Guid.Empty || !bill.IsPosted) return;

        isExporting = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            if (company == null) return;

            var vendor = vendors.FirstOrDefault(v => v.Id == bill.VendorId);
            string currCode = currencies.FirstOrDefault(c => c.Id == bill.CurrencyId)?.CurrencyCode ?? "BASE";

            var pdfBytes = ExportService.GeneratePurchaseInvoicePdf(bill, company, vendor?.Name ?? "Vendor", currCode);
            var fileName = $"Direct_Bill_{bill.ExternalInvoiceNumber}.pdf";

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(pdfBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task LoadBillForView(PurchaseInvoice selectedBill)
    {
        bill = selectedBill;
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var batch = bill.GLBatchId.HasValue
            ? await ctx.GLBatches.AsNoTracking().FirstOrDefaultAsync(b => b.Id == bill.GLBatchId.Value && b.CompanyId == selectedCompanyId)
            : null;
        currentBatchStatus = batch?.Status;
        currentBatchRejectionReason = batch?.RejectionReason;
        var vendor = vendors.FirstOrDefault(v => v.Id == bill.VendorId);
        if (vendor != null)
        {
            currencySymbol = vendor.DefaultCurrency?.CurrencyCode ?? "";
        }

        showForm = true;
        JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private void NavigateToPayment(Guid billId)
    {
        NavManager.NavigateTo($"/ap/bill-entry/{billId}");
    }
}
