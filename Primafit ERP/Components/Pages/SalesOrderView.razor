@page "/sc/sales-orders"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject SalesService SalesService
@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject WarehouseService WhService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Sales Orders</h1>
            @if (!string.IsNullOrEmpty(companyName))
            {
                <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200 mt-2">
                    <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    @companyName
                </span>
            }
        </div>

        <div class="flex bg-slate-100 p-1 rounded-xl">
            <button @onclick="() => activeTab = 0"
                    class="px-4 py-2 rounded-lg text-sm font-bold transition-all @(activeTab == 0 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                All Orders
            </button>
            <button @onclick="CreateNew"
                    class="px-4 py-2 rounded-lg text-sm font-bold transition-all @(activeTab == 1 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                New Order
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading sales data...
        </div>
    }
    else if (HasCompany)
    {
        @if (activeTab == 0)
        {
            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                <table class="w-full text-left text-sm text-slate-900">
                    <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="p-4">Date</th>
                            <th class="p-4">Order #</th>
                            <th class="p-4">Customer</th>
                            <th class="p-4">Status</th>
                            <th class="p-4 text-right">Total</th>
                            <th class="p-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var o in orders)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="p-4 font-mono text-slate-600">@o.Date.ToString("yyyy-MM-dd")</td>
                                <td class="p-4 font-mono font-bold text-slate-900">@o.OrderNumber</td>
                                <td class="p-4 font-medium">@o.Customer?.Name</td>
                                <td class="p-4">
                                    <span class="inline-flex items-center rounded border px-2 py-1 text-xs font-bold
                                                          @(o.Status == OrderStatus.Draft ? "border-slate-200 bg-slate-50 text-slate-600" :
                                                                                                                        o.Status == OrderStatus.Shipped ? "border-amber-200 bg-amber-50 text-amber-700" :
                                                                                                                        o.Status == OrderStatus.Invoiced ? "border-emerald-200 bg-emerald-50 text-emerald-700" :
                                                                                                                        "border-blue-200 bg-blue-50 text-blue-700")">
                                        @o.Status
                                    </span>
                                </td>
                                <td class="p-4 text-right font-mono font-bold text-slate-800">
                                    @o.Lines.Sum(l => l.Quantity * l.UnitPrice).ToString("N2")
                                </td>
                                <td class="p-4 text-right">
                                    <button @onclick="() => EditOrder(o.Id)" class="text-slate-600 font-bold hover:text-slate-900 hover:underline">Manage</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!orders.Any())
                {
                    <div class="p-12 text-center text-slate-400">No orders found.</div>
                }
            </div>
        }
        else
        {
            <!-- IMPORTANT: overflow-visible so SearchableItem dropdown is not clipped -->
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl animate-in fade-in slide-in-from-bottom-4 overflow-visible">

                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Order Details</h3>
                    <div class="text-xs font-medium text-slate-500">
                        Status: <span class="font-bold text-slate-900">@currentOrder.Status</span>
                    </div>
                </div>

                <div class="p-8">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                        <div>
                            <label class="label">Date</label>
                            <InputDate @bind-Value="currentOrder.Date" class="input-class" disabled="@IsLocked" />
                        </div>

                        <div>
                            <label class="label">Customer</label>
                            <select @bind="currentOrder.CustomerId" class="input-class" disabled="@IsLocked">
                                <option value="@Guid.Empty">-- Select --</option>
                                @foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="label">Currency</label>
                            <select value="@currentOrder.CurrencyId" @onchange="OnCurrencyChanged" class="input-class" disabled="@IsLocked">
                                @foreach (var c in currencies)
                                {
                                    <option value="@c.Id">@c.CurrencyCode</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="label">Exchange Rate</label>
                            <div class="flex items-center input-class bg-slate-50 text-slate-500 cursor-not-allowed">
                                <span class="font-bold mr-2 text-slate-400 text-xs">Rate:</span>
                                <span class="font-mono text-sm">@currentOrder.ExchangeRate.ToString("N4")</span>
                            </div>
                        </div>

                        <div>
                            <label class="label">Tax</label>
                            <select @bind="currentOrder.TaxId" class="input-class" disabled="@IsLocked">
                                <option value="">-- No Tax --</option>
                                @foreach (var t in taxes)
                                {
                                    <option value="@t.Id">@t.TaxName (@t.Per.ToString("N2")%)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- IMPORTANT: overflow-visible + relative wrapper to prevent dropdown clipping -->
                    <div class="border border-slate-200 rounded-xl overflow-visible mb-6">
                        <div class="relative overflow-visible">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-1/2">Item</th>
                                        <th class="p-3 w-24">Qty</th>
                                        <th class="p-3 w-32">Unit Price</th>
                                        <th class="p-3 w-32 text-right pr-4">Total</th>
                                        <th class="p-3 w-10"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in currentOrder.Lines)
                                    {
                                        <tr class="relative">
                                            <!-- IMPORTANT: stacking context for dropdown -->
                                            <td class="p-2 pl-4 align-top relative z-30">
                                                @if (IsLocked)
                                                {
                                                    <div class="p-2 font-bold text-slate-700 bg-slate-50 rounded-lg">
                                                        @(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="relative z-[9999]">
                                                        <SearchableItem Label=""
                                                                        Items="@items"
                                                                        @bind-Value="line.ItemId"
                                                                        OnSelectionChanged="@(() => UpdateLinePrice(line))"
                                                                        IsInvalid="@(line.ItemId == Guid.Empty)" />
                                                    </div>
                                                }
                                            </td>

                                            <td class="p-2 align-top pt-3">
                                                <input type="number" @bind="line.Quantity" class="input-class py-2 text-center" placeholder="1" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.01" @bind="line.UnitPrice" class="input-class py-2 text-right" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-4 text-right font-mono font-bold text-slate-700">
                                                @((line.Quantity * line.UnitPrice).ToString("N2"))
                                            </td>
                                            <td class="p-2 text-center align-top pt-4">
                                                @if (!IsLocked)
                                                {
                                                    <button @onclick="() => currentOrder.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600 transition-colors">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                        </svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!IsLocked)
                        {
                            <div class="p-2 bg-slate-50 border-t border-slate-200">
                                <button @onclick="AddLine" class="text-xs font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide transition-colors">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                    </svg>
                                    Add Line Item
                                </button>
                            </div>
                        }
                    </div>

                    <div class="flex flex-col md:flex-row justify-between items-start pt-4 border-t border-slate-100 gap-4">
                        <div class="space-y-2 text-sm text-slate-600">
                            <div class="flex justify-between w-64">
                                <span>Subtotal (Base):</span>
                                <span class="font-mono font-bold">@SubTotal.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between w-64">
                                <span>Tax (@TaxPercentage.ToString("N2")%):</span>
                                <span class="font-mono font-bold text-rose-600">+ @TaxAmount.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between w-64 border-t border-slate-300 pt-2 text-slate-900 text-base">
                                <span class="font-bold">Total (Base):</span>
                                <span class="font-mono font-bold">@GrandTotalBase.ToString("N2")</span>
                            </div>

                            <div class="flex justify-between w-64 bg-slate-100 p-2 rounded-lg border border-slate-200 mt-2">
                                <span class="font-bold text-slate-800">Total (@currencySymbol):</span>
                                <span class="font-mono font-bold text-emerald-700 text-lg">
                                    @GrandTotalForeign.ToString("N2")
                                </span>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 mt-4 md:mt-0">
                            <button @onclick="() => activeTab = 0" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-50">Close</button>

                            @if (currentOrder.Status == OrderStatus.Draft)
                            {
                                <button @onclick="SaveOrder" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md">Confirm Order</button>
                            }
                            else if (currentOrder.Status == OrderStatus.Confirmed)
                            {
                                <div class="flex items-center gap-2 bg-slate-100 p-1 rounded-xl border border-slate-200">
                                    <select @bind="shipFromWarehouseId" class="bg-white border-0 rounded-lg py-1.5 text-sm font-medium text-slate-700 w-40">
                                        <option value="@Guid.Empty">Warehouse...</option>
                                        @foreach (var w in warehouses)
                                        {
                                            <option value="@w.Id">@w.Name</option>
                                        }
                                    </select>
                                    <button @onclick="ShipOrder" class="px-4 py-1.5 bg-amber-600 text-white rounded-lg text-xs font-bold hover:bg-amber-700">Ship Only</button>
                                    <button @onclick="InvoiceOrder" class="px-4 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold hover:bg-emerald-700">Invoice All</button>
                                </div>
                            }
                            else if (currentOrder.Status == OrderStatus.Shipped)
                            {
                                <button @onclick="InvoiceOrder" class="px-6 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-700 shadow-md">Generate Invoice</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
        }

        .input-class:disabled {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
        }
</style>

@code {
    private Guid selectedCompanyId = Guid.Empty;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;

    private bool isLoading = true;
    private int activeTab = 0;
    private bool IsLocked => currentOrder.Status != OrderStatus.Draft;

    private string currencySymbol = "";
    private Guid shipFromWarehouseId;

    private List<SalesOrder> orders = new();
    private SalesOrder currentOrder = new();
    private List<Customer> customers = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<Warehouse> warehouses = new();
    private List<Tax> taxes = new();

    private decimal SubTotal => currentOrder.Lines.Sum(l => l.LineTotal);
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == currentOrder.TaxId)?.Per ?? 0;
    private decimal TaxAmount => SubTotal * (TaxPercentage / 100);
    private decimal GrandTotalBase => SubTotal + TaxAmount;
    private decimal GrandTotalForeign => currentOrder.ExchangeRate == 0 ? 0 : GrandTotalBase / currentOrder.ExchangeRate;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            selectedCompanyId = user.CompanyDetailsId.Value;

            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            if (company != null) companyName = company.CompanyName;

            await LoadData();
        }

        isLoading = false;
    }

    private async Task LoadData()
    {
        if (!HasCompany) return;

        orders = await SalesService.GetOrdersAsync(selectedCompanyId);
        customers = await MasterService.GetCustomersAsync(selectedCompanyId);
        currencies = await CurrService.GetCurrenciesAsync(selectedCompanyId);
        items = await MasterService.GetItemsAsync(selectedCompanyId);
        warehouses = await WhService.GetWarehousesAsync(selectedCompanyId);

        using var ctx = await DbFactory.CreateDbContextAsync();
        taxes = await ctx.Taxes.Where(t => t.CompanyId == selectedCompanyId).ToListAsync();
    }

    private async Task CreateNew()
    {
        currentOrder = new SalesOrder { CompanyId = selectedCompanyId, Date = DateOnly.FromDateTime(DateTime.Today) };

        if (currencies.Any())
        {
            var def = currencies.First();
            currentOrder.CurrencyId = def.Id;
            currencySymbol = def.CurrencyCode;
            currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, def.Id);
        }

        currentOrder.Lines.Add(new SalesOrderLine { HeaderId = currentOrder.Id });
        activeTab = 1;
    }

    private async Task EditOrder(Guid id)
    {
        var o = await SalesService.GetOrderByIdAsync(id);
        if (o != null)
        {
            currentOrder = o;
            activeTab = 1;
            var c = currencies.FirstOrDefault(x => x.Id == o.CurrencyId);
            currencySymbol = c?.CurrencyCode ?? "";
        }
    }

    private void AddLine() => currentOrder.Lines.Add(new SalesOrderLine { HeaderId = currentOrder.Id });

    private void UpdateLinePrice(SalesOrderLine line)
    {
        var item = items.FirstOrDefault(x => x.Id == line.ItemId);
        if (item != null)
        {
            line.UnitPrice = item.SellingPrice;
        }
    }

    private async Task OnCurrencyChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var currId))
        {
            currentOrder.CurrencyId = currId;
            var c = currencies.FirstOrDefault(x => x.Id == currId);
            currencySymbol = c?.CurrencyCode ?? "";
            currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, currId);
        }
    }

    private async Task SaveOrder()
    {
        var err = await SalesService.SaveOrderAsync(currentOrder);
        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        await LoadData();
        activeTab = 0;
    }

    private async Task ShipOrder()
    {
        if (shipFromWarehouseId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Select Warehouse");
            return;
        }

        var err = await SalesService.ShipOrderAsync(currentOrder.Id, shipFromWarehouseId);
        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        await LoadData();
        activeTab = 0;
    }

    private async Task InvoiceOrder()
    {
        if (currentOrder.Status == OrderStatus.Confirmed && shipFromWarehouseId == Guid.Empty)
        {
            bool hasPhysical = currentOrder.Lines.Any();
            if (hasPhysical)
            {
                await JS.InvokeVoidAsync("alert", "Please select a Warehouse to fulfill these items.");
                return;
            }
        }

        var err = await SalesService.InvoiceOrderAsync(currentOrder.Id, shipFromWarehouseId);
        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        await LoadData();
        activeTab = 0;
    }
}
