@page "/sc/sales-orders"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject SalesService SalesService
@inject ShipmentService ShipmentService
@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject WarehouseService WhService
@inject SegCoaService SegCoaService
@inject ReportExportService ReportExportService
@inject IEmailService EmailService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject PermissionCacheService PermissionCache
@inject NavigationManager Nav
@inject TransactionMappingService MappingService

@rendermode InteractiveServer

<div class="max-w-[1400px] mx-auto space-y-6 animate-in fade-in duration-500 pb-16 font-sans text-slate-800">

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">

        <!-- Title Area -->
        <div class="shrink-0">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Sales & Invoicing</h1>
            @if (!string.IsNullOrEmpty(companyName))
            {
                <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200 mt-2">
                    @companyName
                </span>
            }
        </div>

        <!-- Controls Area -->
        <div class="flex flex-col sm:flex-row flex-wrap gap-4 items-start sm:items-center w-full lg:w-auto lg:justify-end">

            @if (activeTab == 0)
            {
                <div class="flex flex-col xl:flex-row gap-3 items-start xl:items-center w-full sm:w-auto">
                    <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 h-[42px] w-full sm:w-auto overflow-x-auto shrink-0 scrollbar-hide">
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider shrink-0">From</span>
                        <input type="date" @bind="filterStartDate" class="bg-transparent text-sm font-bold text-slate-700 outline-none w-auto sm:w-32 cursor-pointer" />

                        <div class="w-px h-4 bg-slate-300 shrink-0"></div>

                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider shrink-0">To</span>
                        <input type="date" @bind="filterEndDate" class="bg-transparent text-sm font-bold text-slate-700 outline-none w-auto sm:w-32 cursor-pointer" />

                        @if (filterStartDate.HasValue || filterEndDate.HasValue)
                        {
                            <button type="button" @onclick="() => { filterStartDate = null; filterEndDate = null; }" class="ml-1 text-slate-400 hover:text-rose-600 transition-colors shrink-0" title="Clear Dates">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        }
                    </div>

                    <div class="relative w-full sm:w-64 xl:w-72 h-[42px] shrink-0">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search customer, item, or order..." class="w-full h-full pl-9 pr-4 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                </div>
            }

            <div class="flex bg-slate-100 p-1 rounded-xl w-full sm:w-auto shrink-0">
                <button type="button" @onclick="() => activeTab = 0" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 0 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    All Records
                </button>
                <PermissionGate Key="SALES_ORDER_CREATE">
                    <Authorized>
                        <button type="button" @onclick="CreateNew" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 1 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                            New Record
                        </button>
                    </Authorized>
                </PermissionGate>
            </div>

        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading sales data...</div>
    }
    else if (HasCompany)
    {
        @if (activeTab == 0)
        {
            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                <div class="flex gap-6 px-6 pt-4 border-b border-slate-100 bg-slate-50/50 overflow-x-auto whitespace-nowrap scrollbar-hide">
                    <button type="button" class="pb-3 text-sm font-bold border-b-2 transition-colors @(recordFilter == "Quotes" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700")" @onclick='() => recordFilter = "Quotes"'>Quotes</button>
                    <button type="button" class="pb-3 text-sm font-bold border-b-2 transition-colors @(recordFilter == "Orders" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700")" @onclick='() => recordFilter = "Orders"'>Orders</button>
                    <button type="button" class="pb-3 text-sm font-bold border-b-2 transition-colors @(recordFilter == "Invoices" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700")" @onclick='() => recordFilter = "Invoices"'>Invoices</button>
                    <button type="button" class="pb-3 text-sm font-bold border-b-2 transition-colors @(recordFilter == "All" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700")" @onclick='() => recordFilter = "All"'>All Records</button>
                </div>

                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left text-sm text-slate-900 min-w-[1000px]">
                        <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                            <tr>
                                <th class="p-4 w-28">Date</th>
                                <th class="p-4">Reference #</th>
                                <th class="p-4">Linked From</th>
                                <th class="p-4">Customer</th>
                                <th class="p-4">Items (Qty)</th>
                                <th class="p-4 text-center">Status</th>
                                <th class="p-4 text-right">Total (Foreign)</th>
                                <th class="p-4 text-right border-r border-slate-100">Total (Base)</th>
                                <th class="p-4 text-center w-64">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var o in PagedOrders)
                            {
                                var batchInfo = o.InvoiceBatchId.HasValue && batchMap.TryGetValue(o.InvoiceBatchId.Value, out var b) ? b : null;
                                bool isGlCommitted = batchInfo?.Status == BatchStatus.Posted;
                                bool isRejected = batchInfo?.Status == BatchStatus.Rejected;
                                bool isStagedForReview = batchInfo?.Status == BatchStatus.Ready;

                                <tr class="hover:bg-slate-50 transition-colors align-middle">
                                    <td class="p-4 font-mono text-slate-600 text-xs">@o.Date.ToString("dd MMM, yyyy")</td>
                                    <td class="p-4 font-mono font-bold @(o.OrderNumber.StartsWith("INV") ? "text-emerald-700" : (o.OrderNumber.StartsWith("ORD") ? "text-blue-700" : "text-indigo-700"))">@o.OrderNumber</td>
                                    <td class="p-4 font-mono text-xs text-slate-400">@(o.ConvertedFromQuoteNumber ?? "-")</td>
                                    <td class="p-4 font-medium">@o.Customer?.Name</td>
                                    <td class="p-4 text-sm">
                                        @if (o.Lines != null && o.Lines.Any())
                                        {
                                            var previewLines = o.Lines.Take(2).ToList();
                                            foreach (var l in previewLines)
                                            {
                                                var itemName = items.FirstOrDefault(i => i.Id == l.ItemId)?.Name ?? "Unknown Item";
                                                <div class="w-40 mb-1 last:mb-0" title="@itemName">
                                                    <div class="truncate flex items-center justify-between">
                                                        <span class="text-slate-700 truncate">@itemName</span>
                                                        <span class="text-slate-400 text-xs font-bold ml-1 whitespace-nowrap">(x@(l.Quantity.ToString("G29")))</span>
                                                    </div>
                                                    @if (l.QtyCredited > 0)
                                                    {
                                                        <span class="block text-[11px] font-semibold font-mono text-rose-600">
                                                            Credit Note qty: (@(l.QtyCredited.ToString("G29")))
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            if (o.Lines.Count > 2)
                                            {
                                                <div class="text-[10px] text-indigo-500 font-bold uppercase mt-1 tracking-wider">+@(o.Lines.Count - 2) more item(s)</div>
                                            }
                                        }
                                    </td>
                                    <td class="p-4 text-center align-middle">
                                        <div class="flex flex-col items-center gap-1.5">
                                            @if (o.Status == OrderStatus.Quote)
                                            {
                                                <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Quote</span>
                                            }
                                            else if (o.Status == OrderStatus.Order || (o.OrderNumber.StartsWith("ORD") && o.Status == OrderStatus.Invoiced))
                                            {
                                                <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 text-[10px] font-bold text-blue-700 uppercase tracking-wider">Order</span>
                                            }
                                            else if (o.OrderNumber.StartsWith("INV"))
                                            {
                                                @if (isGlCommitted)
                                                {
                                                    <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">
                                                        Posted
                                                    </span>
                                                }
                                                else if (isRejected)
                                                {
                                                    <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-2.5 py-1 text-[10px] font-bold text-rose-700 uppercase tracking-wider animate-pulse" title="@batchInfo?.RejectionReason">
                                                        Rejected
                                                    </span>
                                                }
                                                else if (isStagedForReview)
                                                {
                                                    <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">
                                                        Staged (Review)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-600 uppercase tracking-wider">
                                                        Draft
                                                    </span>
                                                }

                                                @if (isGlCommitted)
                                                {
                                                    var physicalLines = o.Lines?.Where(l => l.Item != null && !l.Item.IsService).ToList() ?? new List<SalesOrderLine>();
                                                    if (physicalLines.Any())
                                                    {
                                                        var totalOrdered = physicalLines.Sum(l => l.Quantity);
                                                        var totalShipped = physicalLines.Sum(l => l.QtyShipped);
                                                        var totalCredited = physicalLines.Sum(l => l.QtyCredited);
                                                        var remainingToShip = totalOrdered - totalCredited;

                                                        if (totalShipped == 0 && remainingToShip > 0)
                                                        {
                                                            <span class="inline-flex items-center rounded-md border border-slate-200 bg-white px-2 py-0.5 text-[9px] font-bold text-slate-500 uppercase tracking-wider shadow-sm">Unshipped</span>
                                                        }
                                                        else if (totalShipped < remainingToShip)
                                                        {
                                                            <span class="inline-flex items-center rounded-md border border-amber-200 bg-amber-50 px-2 py-0.5 text-[9px] font-bold text-amber-700 uppercase tracking-wider shadow-sm">Partially Shipped</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-center rounded-md border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[9px] font-bold text-emerald-700 uppercase tracking-wider shadow-sm">Shipped</span>
                                                        }
                                                    }
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td class="p-4 text-right font-mono font-bold @(o.Status == OrderStatus.Quote ? "text-slate-500" : "text-slate-900")">
                                        @o.Currency?.CurrencyCode @o.GrandTotalForeign.ToString("N4")
                                    </td>
                                    <td class="p-4 text-right font-mono font-bold text-emerald-600 border-r border-slate-100">
                                        @((o.GrandTotalForeign * (o.ExchangeRate > 0 ? o.ExchangeRate : 1)).ToString("N4"))
                                        @if (o.CreditNoteTotal > 0)
                                        {
                                            <span class="block text-[11px] font-mono font-semibold text-rose-600 mt-1">
                                                credit note:(@((o.CreditNoteTotal * (o.ExchangeRate > 0 ? o.ExchangeRate : 1)).ToString("N4")))
                                            </span>
                                        }
                                    </td>
                                    <td class="p-4">
                                        <div class="flex items-center justify-center gap-2">
                                            @if (o.Status == OrderStatus.Quote)
                                            {
                                                bool isConverted = orders.Any(inv => inv.ConvertedFromQuoteNumber == o.OrderNumber);
                                                if (isConverted)
                                                {
                                                    <button type="button" @onclick="() => EditOrder(o.Id)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded hover:bg-slate-100">View</button>
                                                    <span class="px-3 py-1.5 text-[10px] font-bold text-slate-400 bg-slate-100 rounded border border-slate-200 uppercase tracking-wider">Converted</span>
                                                }
                                                else
                                                {
                                                    <PermissionGate Key="SALES_ORDER_CREATE">
                                                        <Authorized>
                                                            <button type="button" @onclick="() => EditOrder(o.Id)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded hover:bg-slate-50">Edit</button>
                                                            <button type="button" @onclick="() => ConvertQuoteToOrder(o)" class="px-3 py-1.5 text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100 shadow-sm">Make Order</button>
                                                        </Authorized>
                                                    </PermissionGate>
                                                }
                                            }
                                            else if (o.Status == OrderStatus.Order || (o.OrderNumber.StartsWith("ORD") && o.Status == OrderStatus.Invoiced))
                                            {
                                                bool isConverted = o.Status == OrderStatus.Invoiced || orders.Any(inv => inv.ConvertedFromQuoteNumber == o.OrderNumber);
                                                if (isConverted)
                                                {
                                                    <button type="button" @onclick="() => EditOrder(o.Id)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded hover:bg-slate-100">View</button>
                                                    <span class="px-3 py-1.5 text-[10px] font-bold text-slate-400 bg-slate-100 rounded border border-slate-200 uppercase tracking-wider">Converted</span>
                                                }
                                                else
                                                {
                                                    <PermissionGate Key="SALES_ORDER_CREATE">
                                                        <Authorized>
                                                            <button type="button" @onclick="() => EditOrder(o.Id)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded hover:bg-slate-50">Edit</button>
                                                            <button type="button" @onclick="() => ConvertOrderToInvoice(o)" class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded hover:bg-indigo-100 shadow-sm">Make Invoice</button>
                                                        </Authorized>
                                                    </PermissionGate>
                                                }
                                            }
                                            else if (o.OrderNumber.StartsWith("INV"))
                                            {
                                                @if (!isGlCommitted)
                                                {
                                                    <PermissionGate Key="SALES_ORDER_CREATE">
                                                        <Authorized>
                                                            <button type="button" @onclick="() => EditOrder(o.Id)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded hover:bg-slate-50">Edit</button>
                                                        </Authorized>
                                                    </PermissionGate>
                                                    <PermissionGate Key="SALES_INVOICE_POST">
                                                        <Authorized>
                                                            <button type="button" @onclick="() => InvoiceOrderFromList(o)" class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded hover:bg-emerald-100 shadow-sm">
                                                                @(isStagedForReview ? "Update Staging" : (isRejected ? "Resubmit Invoice" : "Submit Invoice"))
                                                            </button>
                                                        </Authorized>
                                                    </PermissionGate>
                                                }
                                                else
                                                {
                                                    <button type="button" @onclick="() => EditOrder(o.Id)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded hover:bg-slate-100">View</button>

                                                    var physicalLines = o.Lines?.Where(l => l.Item != null && !l.Item.IsService).ToList() ?? new List<SalesOrderLine>();
                                                    bool needsShipping = physicalLines.Any(l => (l.QtyShipped - l.QtyReturned) < (l.Quantity - l.QtyCredited - l.QtyReturned));
                                                    bool hasShippedAny = physicalLines.Any(l => l.QtyShipped > 0);

                                                    @if (needsShipping)
                                                    {
                                                        <PermissionGate Key="SHIPMENT_CREATE">
                                                            <Authorized>
                                                                <button type="button" @onclick="() => SendToWarehouse(o)"
                                                                        class="px-3 py-1.5 text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded hover:bg-amber-100 shadow-sm"
                                                                        title="Send to Warehouse for Dispatch">
                                                                    To Warehouse
                                                                </button>
                                                            </Authorized>
                                                        </PermissionGate>
                                                    }
                                                    else if (physicalLines.Any() && hasShippedAny)
                                                    {
                                                        <span class="px-2.5 py-1 bg-slate-100 text-slate-500 font-bold text-[10px] uppercase tracking-wider rounded border border-slate-200">
                                                            Dispatched
                                                        </span>
                                                    }

                                                    @if (o.IsFullyPaid)
                                                    {
                                                        <span class="inline-flex items-center gap-1 px-3 py-1.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-lg text-xs font-bold">
                                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> Paid
                                                        </span>
                                                    }
                                                    else if (o.AmountPaid > 0)
                                                    {
                                                        <button type="button" @onclick='() => Nav.NavigateTo($"/ar/payment-entry?invoiceId={o.Id}")' class="px-3 py-1.5 text-[10px] uppercase tracking-wider font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded hover:bg-amber-100 shadow-sm flex items-center gap-1">
                                                            Receive Balance
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" @onclick='() => Nav.NavigateTo($"/ar/payment-entry?invoiceId={o.Id}")' class="px-3 py-1.5 text-[10px] uppercase tracking-wider font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded hover:bg-emerald-100 shadow-sm flex items-center gap-1">
                                                            Receive Payment
                                                        </button>
                                                    }
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!PagedOrders.Any())
                            {
                                <tr><td colspan="9" class="p-12 text-center text-slate-400">No records found matching your criteria.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredOrders.Any())
                {
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                            Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, FilteredOrders.Count())) of @FilteredOrders.Count() records
                        </div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="() => currentPage--" disabled="@(currentPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">
                                Previous
                            </button>
                            <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm">
                                Page @currentPage of @TotalPages
                            </span>
                            <button type="button" @onclick="() => currentPage++" disabled="@(currentPage >= TotalPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">
                                Next
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl animate-in fade-in slide-in-from-bottom-4 overflow-visible flex flex-col h-full">

                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <div class="flex items-center gap-4">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Record Details</h3>
                        @if (!string.IsNullOrEmpty(currentOrder.OrderNumber))
                        {
                            <span class="px-2 py-0.5 bg-slate-200 text-slate-700 font-mono text-xs rounded font-bold">@currentOrder.OrderNumber</span>
                        }
                    </div>

                    <div class="flex items-center gap-3">
                        @if (canConfigureRoute && !IsLocked)
                        {
                            <button type="button" @onclick="OpenConfigModal" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors flex items-center gap-1.5 shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                <span>Configure Route</span>
                            </button>
                        }

                        @if (!IsLocked)
                        {
                            <div class="flex items-center gap-2 bg-white p-1 rounded-xl border border-slate-200 shadow-sm">
                                <button type="button" @onclick="() => SetStatusType(OrderStatus.Quote)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status == OrderStatus.Quote ? "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-200" : "text-slate-500 hover:bg-slate-50")">
                                    Quote
                                </button>
                                <button type="button" @onclick="() => SetStatusType(OrderStatus.Order)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status == OrderStatus.Order ? "bg-blue-50 text-blue-700 ring-1 ring-blue-200" : "text-slate-500 hover:bg-slate-50")">
                                    Sales Order
                                </button>
                                <button type="button" @onclick="() => SetStatusType(OrderStatus.Draft)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status == OrderStatus.Draft ? "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200" : "text-slate-500 hover:bg-slate-50")">
                                    Direct Invoice
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="px-4 py-1.5 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-700 ring-emerald-200 ring-1 flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                Locked Invoice (Posted)
                            </div>
                        }
                    </div>
                </div>

                <!-- Rejection Banner -->
                @if (IsCurrentOrderRejected)
                {
                    <div class="mx-6 sm:mx-8 mt-6 p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-start gap-3 animate-in fade-in">
                        <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                        <div>
                            <span class="text-xs font-bold uppercase tracking-wider text-rose-800 block">Reviewer Rejection Notice</span>
                            <p class="text-xs text-rose-700 mt-0.5 leading-relaxed">
                                @(CurrentOrderBatchInfo?.RejectionReason ?? "This financial batch was rejected by a reviewer. Please make adjustments and re-submit to the GL queue.")
                            </p>
                        </div>
                    </div>
                }

                <div class="p-6 sm:p-8">
                    <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 mb-6 shadow-sm">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                            <div>
                                <label class="label">Customer</label>
                                <select value="@currentOrder.CustomerId" @onchange="OnCustomerChanged" class="input-class font-bold text-slate-800 border-indigo-200 bg-white" disabled="@IsLocked">
                                    <option value="@Guid.Empty">-- Select Customer --</option>
                                    @foreach (var c in customers)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="label flex justify-between">
                                    Warehouse
                                    <span class="text-[9px] text-slate-400 font-normal normal-case">Opt. for Quotes</span>
                                </label>
                                <select @bind="currentOrder.WarehouseId" class="input-class bg-white" disabled="@IsLocked">
                                    <option value="@Guid.Empty">-- Select Warehouse --</option>
                                    @foreach (var w in warehouses)
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="label">Transaction Date</label>
                                <input type="date"
                                       value="@currentOrder.Date.ToString("yyyy-MM-dd")"
                                       @onchange="@(e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) currentOrder.Date = d; })"
                                       class="input-class bg-white" disabled="@IsLocked" />
                            </div>

                            <ExchangeRatePicker CompanyId="@selectedCompanyId"
                                                 CurrencyId="@currentOrder.CurrencyId"
                                                 CurrencyCode="@GetCurrencyCode(currentOrder.CurrencyId)"
                                                 CompanyBaseCurrency="@companyBaseCurrency"
                                                 CurrentRate="@currentOrder.ExchangeRate"
                                                 CurrentRateChanged="OnExchangeRateChanged"
                                                 Disabled="@IsLocked" />

                            <div>
                                <label class="label">Tax / VAT</label>
                                <select value="@currentOrder.TaxId" @onchange="OnTaxChanged" class="input-class bg-white" disabled="@IsLocked">
                                    <option value="">No Tax</option>
                                    @foreach (var t in taxes)
                                    {
                                        <option value="@t.Id">@t.TaxName (@t.Per%)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-xl overflow-visible mb-6 shadow-sm">
                        <div class="relative overflow-visible">
                            <table class="w-full text-sm text-left">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-[40%]">Item</th>
                                        <th class="p-3 w-[15%] text-center">Qty</th>
                                        <th class="p-3 w-[20%] text-right">Unit Price (@currencySymbol)</th>
                                        <th class="p-3 w-[20%] text-right pr-4">Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 min-h-[150px]">
                                    @foreach (var line in currentOrder.Lines)
                                    {
                                        var isService = items.FirstOrDefault(i => i.Id == line.ItemId)?.IsService ?? false;

                                        <tr class="relative group hover:bg-slate-50 transition-colors">
                                            <td class="p-2 pl-4 align-top relative z-30">
                                                @if (IsLocked)
                                                {
                                                    <div class="p-2 font-bold text-slate-700 bg-slate-50 rounded-lg border border-slate-200">
                                                        @(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <SearchableItem Label=""
                                                                    Items="@items"
                                                                    Value="@(line.ItemId ?? Guid.Empty)"
                                                                    ValueChanged="@(EventCallback.Factory.Create<Guid>(this, val => line.ItemId = val == Guid.Empty ? null : val))"
                                                                    OnSelectionChanged="@(() => UpdateLineItem(line))"
                                                                    IsInvalid="@(line.ItemId == null || line.ItemId == Guid.Empty)" />
                                                    @if (isService)
                                                    {
                                                        <div class="mt-1 text-[10px] text-indigo-600 font-bold uppercase tracking-wider flex items-center gap-1">
                                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                            Service Item
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td class="p-2 align-top pt-3 text-center">
                                                @if (isService)
                                                {
                                                    <input type="number" value="1" class="input-class py-2 text-center font-bold bg-slate-100 text-slate-500 cursor-not-allowed border-slate-200" readonly disabled />
                                                }
                                                else
                                                {
                                                    <input type="number" step="0.0001" @bind="line.Quantity" class="input-class py-2 text-center font-bold" placeholder="1.0000" disabled="@IsLocked" />
                                                }
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.0001" @bind="line.UnitPrice" class="input-class py-2 text-right font-mono @(IsLocked ? "bg-slate-100 text-slate-500 cursor-not-allowed border-slate-200" : "")" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-4 text-right font-mono font-bold text-slate-700">
                                                @((line.Quantity * line.UnitPrice).ToString("N4"))
                                            </td>
                                            <td class="p-2 text-center align-top pt-4">
                                                @if (!IsLocked)
                                                {
                                                    <button type="button" @onclick="() => currentOrder.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600 opacity-0 group-hover:opacity-100">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!IsLocked)
                        {
                            <div class="p-2 bg-slate-50 border-t border-slate-200">
                                <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    Add Line Item
                                </button>
                            </div>
                        }
                    </div>

                    <div class="flex flex-col md:flex-row justify-between items-start gap-6">
                        <div class="w-full md:w-1/2 p-5 bg-rose-50 border border-rose-100 rounded-xl shadow-sm">
                            <h4 class="font-extrabold text-xs uppercase tracking-wider text-rose-700 mb-4 flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg>
                                Apply Discount
                            </h4>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="label text-[10px]">Percentage (%)</label>
                                    <input type="number" step="0.0001" @bind="currentOrder.DiscountPercentage"
                                           @bind:after="() => { if (currentOrder.DiscountPercentage > 0) currentOrder.DiscountAmount = 0; }"
                                           class="input-class text-center font-bold text-rose-600 border-rose-200 focus:border-rose-500" disabled="@IsLocked" />
                                </div>
                                <div>
                                    <label class="label text-[10px]">Flat Amount (@currencySymbol)</label>
                                    <input type="number" step="0.0001" @bind="currentOrder.DiscountAmount"
                                           @bind:after="() => { if (currentOrder.DiscountAmount > 0) currentOrder.DiscountPercentage = 0; }"
                                           class="input-class text-right font-mono border-rose-200 focus:border-rose-500" disabled="@IsLocked" />
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2 text-sm text-slate-600 w-full md:w-80 bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm">
                            <div class="flex justify-between">
                                <span>Subtotal:</span>
                                <span class="font-mono font-bold">@SubTotal.ToString("N4")</span>
                            </div>
                            <div class="flex justify-between items-center text-rose-600 border-b border-slate-200 pb-2">
                                <span>Discount:</span>
                                <span class="font-mono font-bold">- @DiscountValue.ToString("N4")</span>
                            </div>
                            <div class="flex justify-between items-center pt-1">
                                <span>Net Subtotal:</span>
                                <span class="font-mono font-bold">@DiscountedSubTotal.ToString("N4")</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span>Tax (@TaxPercentage%):</span>
                                <span class="font-mono font-bold">+ @TaxAmount.ToString("N4")</span>
                            </div>
                            <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                <span class="font-bold">Total (@currencySymbol):</span>
                                <span class="font-mono font-black text-emerald-700 text-2xl">@GrandTotalForeign.ToString("N4")</span>
                            </div>
                            <div class="flex justify-between text-[10px] text-slate-400 mt-1 uppercase font-bold tracking-wider">
                                <span>Ledger Base Value:</span>
                                <span class="font-mono text-slate-500">@GrandTotalBase.ToString("N4")</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 mt-8 justify-end pt-5 border-t border-slate-200">
                        @if (currentOrder.Id != Guid.Empty && currentOrder.OrderNumber.StartsWith("INV"))
                        {
                            <button type="button" @onclick="DownloadInvoice" disabled="@isExporting" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-bold text-sm hover:bg-slate-50 shadow-sm transition-colors flex items-center gap-2 disabled:opacity-50">
                                @if (isExporting)
                                {
                                    <span class="animate-spin">↻</span>
                                }
                                <svg class="w-4 h-4 text-rose-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path></svg>
                                Download Invoice
                            </button>
                        }
                        @if (!IsLocked)
                        {
                            <PermissionGate Key="SALES_ORDER_CREATE">
                                <Authorized>
                                    <button type="button" @onclick="TerminateOrder" class="px-5 py-2.5 rounded-xl border border-rose-200 text-rose-600 font-bold text-sm hover:bg-rose-50 transition-colors">
                                        Delete
                                    </button>
                                </Authorized>
                            </PermissionGate>
                            <button type="button" @onclick="() => activeTab = 0" class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-sm hover:bg-slate-50 transition-colors">
                                Cancel
                            </button>

                            @if (currentOrder.Status == OrderStatus.Quote)
                            {
                                <PermissionGate Key="SALES_ORDER_CREATE">
                                    <Authorized>
                                        <button type="button" @onclick="SaveOrder" class="px-8 py-2.5 bg-indigo-600 text-white rounded-xl font-bold text-sm hover:bg-indigo-700 shadow-md transition-all active:scale-95 flex items-center gap-2">
                                            Save Quote
                                        </button>
                                    </Authorized>
                                </PermissionGate>
                            }
                            else if (currentOrder.Status == OrderStatus.Order)
                            {
                                <PermissionGate Key="SALES_ORDER_CREATE">
                                    <Authorized>
                                        <button type="button" @onclick="SaveOrder" class="px-8 py-2.5 bg-blue-600 text-white rounded-xl font-bold text-sm hover:bg-blue-700 shadow-md transition-all active:scale-95 flex items-center gap-2">
                                            Save Order
                                        </button>
                                    </Authorized>
                                </PermissionGate>
                            }
                            else if (currentOrder.Status == OrderStatus.Draft || currentOrder.Status == OrderStatus.Invoiced)
                            {
                                <PermissionGate Key="SALES_INVOICE_POST">
                                    <Authorized>
                                        <button type="button" @onclick="SaveAndPostInvoice" class="px-8 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-700 shadow-md transition-all active:scale-95 flex items-center gap-2">
                                            <span>@(IsCurrentOrderStaged ? "Update Staged Invoice" : (IsCurrentOrderRejected ? "Resubmit to GL Review" : "Submit Invoice to GL Queue"))</span>
                                        </button>
                                    </Authorized>
                                </PermissionGate>
                            }
                        }
                        else
                        {
                            <button type="button" @onclick="() => activeTab = 0" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md">
                                Close View
                            </button>
                        }
                    </div>

                </div>
            </div>
        }
    }
</div>

@if (showEmailPopup && recentlyPostedInvoice != null)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border border-slate-200 animate-in zoom-in-95 duration-200">

            <div class="p-6 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <h3 class="font-bold text-slate-800 uppercase tracking-wider text-sm">Send Invoice via Email</h3>
                <button type="button" @onclick="() => showEmailPopup = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="label">To Customer:</label>
                    <input type="text" class="input-class bg-slate-50 cursor-not-allowed font-bold text-slate-600" value="@($"{recentlyPostedInvoice.Customer?.Name} <{recentlyPostedInvoice.Customer?.Email}>")" disabled />
                </div>

                <div>
                    <label class="label">Subject:</label>
                    <input type="text" class="input-class font-bold text-slate-800" value="Invoice @recentlyPostedInvoice.OrderNumber from @companyName" disabled />
                </div>

                <div>
                    <label class="label">Professional Message:</label>
                    <textarea @bind="customEmailMessage" class="input-class h-36 resize-none text-sm text-slate-700"></textarea>
                </div>

                <div class="flex items-center gap-2 p-3 bg-indigo-50 border border-indigo-100 rounded-lg text-indigo-700 text-xs font-bold">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                    A PDF copy of Invoice @recentlyPostedInvoice.OrderNumber will be attached automatically.
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
                <button type="button" @onclick="() => { showEmailPopup = false; activeTab = 0; }" class="px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors disabled:opacity-50" disabled="@isSendingEmail">
                    Skip
                </button>
                <button type="button" @onclick="DispatchEmail" class="px-6 py-2.5 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50" disabled="@isSendingEmail">
                    @if (isSendingEmail)
                    {
                        <span class="animate-spin -ml-1 mr-2 h-4 w-4 text-white">↻</span>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Email</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (showConfigModal)
{
    <div class="fixed inset-0 z-[120] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col overflow-visible">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                <div>
                    <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">Transaction GL Account Mapping Preview</h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Inspect and override account routes for this transaction execution.</p>
                </div>
                <button type="button" @onclick="() => showConfigModal = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-visible space-y-5 flex-1">
                <div class="p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 space-y-2 relative z-[60]">
                    <label class="block text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Transaction Routing Profile</label>
                    <div class="flex items-center gap-2">
                        @if (currentOrder.CustomTransactionTypeId.HasValue)
                        {
                            <button type="button"
                                    @onclick="() => currentOrder.CustomTransactionTypeId = null"
                                    class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                    title="Reset to Standard System Route">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        }
                        <select value="@(currentOrder.CustomTransactionTypeId?.ToString() ?? "")" @onchange="OnCustomTemplateSelected"
                                class="input-class font-bold text-xs bg-white flex-1" disabled="@IsLocked">
                            <option value="">-- Standard System Sales Route (Default) --</option>
                            @foreach (var custom in customTemplates)
                            {
                                <option value="@custom.Id">@custom.Name (Custom Template)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="space-y-3 overflow-visible">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active GL Account Routing</span>

                    <div class="border border-slate-200 rounded-xl overflow-visible divide-y divide-slate-100 text-xs bg-white">
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[50] rounded-t-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Accounts Receivable</span>
                                <span class="text-[10px] text-indigo-600 font-bold uppercase">Debit Side</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentOrder.ReceivablesGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentOrder.ReceivablesGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="System Default Customer AR"
                                                         Accounts="@allAccounts"
                                                         Value="@(currentOrder.ReceivablesGlAccountId ?? defaultArAccountId)"
                                                         ValueChanged="@((Guid val) => currentOrder.ReceivablesGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[40] overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Sales Revenue</span>
                                <span class="text-[10px] text-emerald-600 font-bold uppercase">Credit Side</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (modalRevenueAccountId != Guid.Empty)
                                {
                                    <button type="button"
                                            @onclick="() => modalRevenueAccountId = Guid.Empty"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="Default Line Item Income Accounts"
                                                         Accounts="@allAccounts"
                                                         Value="@(modalRevenueAccountId)"
                                                         ValueChanged="@((Guid val) => { modalRevenueAccountId = val; currentOrder.DirectIncomeGlAccountId = val == Guid.Empty ? null : val; })" />
                                </div>
                            </div>
                        </div>

                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[30] overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Tax / VAT Payable</span>
                                <span class="text-[10px] text-emerald-600 font-bold uppercase">Credit Side</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentOrder.TaxGLAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentOrder.TaxGLAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="Tax Setup Default Account"
                                                         Accounts="@liabilityAccounts"
                                                         Value="@(currentOrder.TaxGLAccountId ?? Guid.Empty)"
                                                         ValueChanged="@((Guid val) => currentOrder.TaxGLAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[20] rounded-b-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Discount Allowed</span>
                                <span class="text-[10px] text-indigo-600 font-bold uppercase">Debit Side</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentOrder.DiscountGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentOrder.DiscountGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="GL Setup Default Discount Account"
                                                         Accounts="@allAccounts"
                                                         Value="@(currentOrder.DiscountGlAccountId ?? defaultDiscountAccountId)"
                                                         ValueChanged="@((Guid val) => currentOrder.DiscountGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-2xl relative z-[10]">
                <button type="button" @onclick="() => showConfigModal = false" class="px-5 py-2 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors">
                    Close
                </button>
                <button type="button" @onclick="ApplyTransactionMappingModal" class="px-6 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95">
                    Apply to Document
                </button>
            </div>
        </div>
    </div>
}

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        outline: none;
        transition: border-color 0.2s;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

        .input-class:disabled, .input-class[readonly] {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
            border-color: #e2e8f0;
        }
</style>

@code {
    private Guid selectedCompanyId = Guid.Empty;
    private string companyName = "";
    private string companyBaseCurrency = "BASE";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private int activeTab = 0;
    private bool isExporting = false;
    private bool canConfigureRoute = false;
    private bool showConfigModal = false;
    private List<CustomTransactionType> customTemplates = new();
    private Guid defaultArAccountId = Guid.Empty;
    private Guid defaultDiscountAccountId = Guid.Empty;
    private Guid modalRevenueAccountId = Guid.Empty;

    // Cache batch status and rejection details by batch ID
    private record BatchSummary(BatchStatus Status, string? RejectionReason);
    private Dictionary<Guid, BatchSummary> batchMap = new();

    private BatchSummary? CurrentOrderBatchInfo =>
        currentOrder.InvoiceBatchId.HasValue && batchMap.TryGetValue(currentOrder.InvoiceBatchId.Value, out var b) ? b : null;

    private bool IsCurrentOrderPosted => CurrentOrderBatchInfo?.Status == BatchStatus.Posted;
    private bool IsCurrentOrderStaged => CurrentOrderBatchInfo?.Status == BatchStatus.Ready;
    private bool IsCurrentOrderRejected => CurrentOrderBatchInfo?.Status == BatchStatus.Rejected;

    // Strict lock check factoring in batch ID and posted status
    private bool IsLocked =>
        IsCurrentOrderPosted ||
        ((currentOrder.Status == OrderStatus.Quote || currentOrder.Status == OrderStatus.Order) &&
         orders.Any(inv => inv.ConvertedFromQuoteNumber == currentOrder.OrderNumber));

    private string currencySymbol = "";

    // Filters & Pagination
    private int pageSize = 15;
    private int currentPage = 1;

    private string _recordFilter = "Quotes";
    private string recordFilter
    {
        get => _recordFilter;
        set { _recordFilter = value; currentPage = 1; }
    }

    private string _searchTerm = "";
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; currentPage = 1; }
    }

    private DateOnly? _filterStartDate;
    private DateOnly? filterStartDate
    {
        get => _filterStartDate;
        set { _filterStartDate = value; currentPage = 1; }
    }

    private DateOnly? _filterEndDate;
    private DateOnly? filterEndDate
    {
        get => _filterEndDate;
        set { _filterEndDate = value; currentPage = 1; }
    }

    private List<SalesOrder> orders = new();
    private SalesOrder currentOrder = new();
    private List<Customer> customers = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<Warehouse> warehouses = new();
    private List<Tax> taxes = new();

    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> liabilityAccounts = new();
    private List<SegChartOfAccount> expenseAccounts = new();
    private List<SegAccountType> accountTypes = new();

    // Email Modal State
    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private SalesOrder? recentlyPostedInvoice = null;
    private string customEmailMessage = "";

    private decimal SubTotal => currentOrder.Lines.Sum(l => l.Quantity * l.UnitPrice);

    private decimal DiscountValue => currentOrder.DiscountPercentage > 0
        ? SubTotal * (currentOrder.DiscountPercentage / 100)
        : currentOrder.DiscountAmount;

    private decimal DiscountedSubTotal => SubTotal - DiscountValue;

    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == currentOrder.TaxId)?.Per ?? 0;
    private decimal TaxAmount => DiscountedSubTotal * (TaxPercentage / 100);

    private decimal GrandTotalForeign => DiscountedSubTotal + TaxAmount;
    private decimal GrandTotalBase => currentOrder.ExchangeRate == 0 ? 0 : GrandTotalForeign * currentOrder.ExchangeRate;

    private IEnumerable<SalesOrder> FilteredOrders => orders
        .Where(o => recordFilter == "All"
                 || (recordFilter == "Quotes" && o.OrderNumber.StartsWith("QUO"))
                 || (recordFilter == "Orders" && o.OrderNumber.StartsWith("ORD"))
                 || (recordFilter == "Invoices" && o.OrderNumber.StartsWith("INV")))
        .Where(o => string.IsNullOrWhiteSpace(searchTerm)
                 || o.OrderNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                 || (o.ConvertedFromQuoteNumber != null && o.ConvertedFromQuoteNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                 || (o.Customer != null && o.Customer.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
                 || o.Lines.Any(l => items.FirstOrDefault(i => i.Id == l.ItemId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true))
        .Where(o => !filterStartDate.HasValue || o.Date >= filterStartDate.Value)
        .Where(o => !filterEndDate.HasValue || o.Date <= filterEndDate.Value)
        .OrderByDescending(o => o.Date);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count() / (double)pageSize));

    private IEnumerable<SalesOrder> PagedOrders => FilteredOrders
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SALES_ORDER_PAGE")) { Nav.NavigateTo("/access-denied"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            selectedCompanyId = user.CompanyDetailsId.Value;
            canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(selectedCompanyId);
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            if (company != null)
            {
                companyName = company.CompanyName;
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }
            await LoadData();
        }

        isLoading = false;
    }

    private async Task OpenConfigModal()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        customTemplates = await ctx.CustomTransactionTypes
            .AsNoTracking()
            .Where(t => t.CompanyId == selectedCompanyId)
            .OrderBy(t => t.Name)
            .ToListAsync();

        var customer = customers.FirstOrDefault(c => c.Id == currentOrder.CustomerId);
        defaultArAccountId = customer?.ReceivablesAccountId ?? Guid.Empty;

        defaultDiscountAccountId = await MappingService.GetMappedAccountAsync(
            selectedCompanyId, SystemTransactionType.DiscountAllowed, isDebit: true, defaultAccountId: Guid.Empty);

        modalRevenueAccountId = currentOrder.DirectIncomeGlAccountId ?? await MappingService.GetMappedAccountAsync(
            selectedCompanyId, SystemTransactionType.SalesInvoice, isDebit: false, defaultAccountId: Guid.Empty);

        showConfigModal = true;
    }

    private async Task OnCustomTemplateSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var customId) && customId != Guid.Empty)
        {
            currentOrder.CustomTransactionTypeId = customId;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var map = await ctx.TransactionGlMappings
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.CompanyId == selectedCompanyId && m.CustomTransactionTypeId == customId);

            if (map != null)
            {
                if (map.OverrideDebitGlAccountId.HasValue)
                    currentOrder.ReceivablesGlAccountId = map.OverrideDebitGlAccountId.Value;

                if (map.OverrideCreditGlAccountId.HasValue)
                {
                    modalRevenueAccountId = map.OverrideCreditGlAccountId.Value;
                    currentOrder.DirectIncomeGlAccountId = map.OverrideCreditGlAccountId.Value;
                }
            }
        }
        else
        {
            currentOrder.CustomTransactionTypeId = null;
        }
    }

    private void ApplyTransactionMappingModal()
    {
        showConfigModal = false;
        StateHasChanged();
    }

    private async Task LoadData()
    {
        if (!HasCompany) return;
        using var ctx = await DbFactory.CreateDbContextAsync();

        // Populate Batch Status Map for all batches in the current company
        var batches = await ctx.GLBatches
            .AsNoTracking()
            .Where(b => b.CompanyId == selectedCompanyId)
            .Select(b => new { b.Id, b.Status, b.RejectionReason })
            .ToListAsync();

        batchMap = batches.ToDictionary(b => b.Id, b => new BatchSummary(b.Status, b.RejectionReason));

        customers = await ctx.Customers.Include(c => c.DefaultCurrency).Where(c => c.CompanyId == selectedCompanyId).ToListAsync();

        var allOrders = await SalesService.GetOrdersAsync(selectedCompanyId);
        orders = allOrders.Where(o => !o.IsDirectInvoice).ToList();

        currencies = await CurrService.GetCurrenciesAsync(selectedCompanyId);
        items = await MasterService.GetItemsAsync(selectedCompanyId);
        warehouses = await WhService.GetWarehousesAsync(selectedCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == selectedCompanyId).ToListAsync();

        accountTypes = await SegCoaService.GetAccountTypesAsync();
        allAccounts = await SegCoaService.GetCoaAsync(selectedCompanyId);

        liabilityAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && type.IsDebit == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        expenseAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsDebit == true && type.IsBalanceSheet == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();
    }

    private void CreateNew()
    {
        currentOrder = new SalesOrder { CompanyId = selectedCompanyId, Date = DateOnly.FromDateTime(DateTime.Today), Status = OrderStatus.Quote };
        currencySymbol = "";
        currentOrder.Lines.Add(new SalesOrderLine { HeaderId = currentOrder.Id });
        activeTab = 1;
    }

    private void SetStatusType(OrderStatus status)
    {
        currentOrder.Status = status;
    }

    private async Task EditOrder(Guid id)
    {
        var o = await SalesService.GetOrderByIdAsync(id);
        if (o != null)
        {
            currentOrder = o;
            activeTab = 1;
            var c = currencies.FirstOrDefault(x => x.Id == o.CurrencyId);
            currencySymbol = c?.CurrencyCode ?? "";
        }
    }

    private async Task ConvertQuoteToOrder(SalesOrder quote)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Convert Quote {quote.OrderNumber} to a Sales Order?");
        if (!confirm) return;

        var err = await SalesService.ConvertQuoteToOrderAsync(quote.Id);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        await JS.InvokeVoidAsync("alert", "Quote Successfully Converted to Order!");
        await LoadData();

        var newOrder = orders.FirstOrDefault(o => o.ConvertedFromQuoteNumber == quote.OrderNumber);
        if (newOrder != null) await EditOrder(newOrder.Id);
    }

    private async Task SendToWarehouse(SalesOrder order)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Send Order {order.OrderNumber} to Warehouse for Dispatch?");
        if (!confirm) return;

        var err = await ShipmentService.CreateShipmentFromOrderAsync(order.Id);
        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        await JS.InvokeVoidAsync("alert", "Order successfully sent to Warehouse Queue!");
        await LoadData();
    }

    private async Task ConvertOrderToInvoice(SalesOrder order)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Convert Sales Order {order.OrderNumber} to an Invoice Draft?");
        if (!confirm) return;

        var err = await SalesService.ConvertOrderToInvoiceAsync(order.Id);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        await JS.InvokeVoidAsync("alert", "Order Successfully Converted to Draft Invoice!");
        await LoadData();

        var newInvoice = orders.FirstOrDefault(o => o.ConvertedFromQuoteNumber == order.OrderNumber);
        if (newInvoice != null) await EditOrder(newInvoice.Id);
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var custId))
        {
            currentOrder.CustomerId = custId;
            var customer = customers.FirstOrDefault(c => c.Id == custId);

            if (customer != null && customer.CurrencyId != Guid.Empty)
            {
                currentOrder.CurrencyId = customer.CurrencyId;
                currencySymbol = customer.DefaultCurrency?.CurrencyCode ?? "";
                currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, currentOrder.CurrencyId);

                foreach (var line in currentOrder.Lines) UpdateLineItem(line);
                RecalculatePrices();
            }
            else if (currencies.Any())
            {
                var def = currencies.First();
                currentOrder.CurrencyId = def.Id;
                currencySymbol = def.CurrencyCode;
                currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(selectedCompanyId, def.Id);

                foreach (var line in currentOrder.Lines) UpdateLineItem(line);
                RecalculatePrices();
            }
        }
        else currentOrder.CustomerId = Guid.Empty;
    }

    private void OnExchangeRateChanged(decimal rate)
    {
        currentOrder.ExchangeRate = Math.Round(rate, 4);
        RecalculatePrices();
    }

    private string GetCurrencyCode(Guid currencyId) => currencies.FirstOrDefault(c => c.Id == currencyId)?.CurrencyCode ?? "";

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId))
        {
            currentOrder.TaxId = taxId;
            var selectedTax = taxes.FirstOrDefault(t => t.Id == taxId);
            if (selectedTax != null)
            {
                currentOrder.TaxGLAccountId = selectedTax.GLAccountId;
            }
        }
        else
        {
            currentOrder.TaxId = null;
            currentOrder.TaxGLAccountId = null;
        }
    }

    private void AddLine() => currentOrder.Lines.Add(new SalesOrderLine { HeaderId = currentOrder.Id });

    private void UpdateLineItem(SalesOrderLine line)
    {
        var item = items.FirstOrDefault(x => x.Id == line.ItemId);
        if (item != null)
        {
            decimal rate = currentOrder.ExchangeRate > 0 ? currentOrder.ExchangeRate : 1;
            line.UnitPrice = item.SellingPrice / rate;
            if (item.IsService) line.Quantity = 1;
        }
    }

    private void RecalculatePrices()
    {
        foreach (var line in currentOrder.Lines)
        {
            UpdateLineItem(line);
        }
        StateHasChanged();
    }

    private async Task SaveOrder()
    {
        if (currentOrder.CustomerId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a customer."); return; }

        var err = await SalesService.SaveOrderAsync(currentOrder);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        await JS.InvokeVoidAsync("alert", "Saved Successfully.");
        await LoadData();
        activeTab = 0;
    }

    private async Task SaveAndPostInvoice()
    {
        if (currentOrder.CustomerId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a customer."); return; }

        bool hasPhysicalItems = currentOrder.Lines.Any(l =>
        {
            var i = items.FirstOrDefault(x => x.Id == l.ItemId);
            return i != null && !i.IsService;
        });

        if (hasPhysicalItems && currentOrder.WarehouseId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a fulfillment warehouse for physical items.");
            return;
        }

        var saveErr = await SalesService.SaveOrderAsync(currentOrder);
        if (!string.IsNullOrEmpty(saveErr)) { await JS.InvokeVoidAsync("alert", saveErr); return; }

        bool confirm = await JS.InvokeAsync<bool>("confirm", "Submit this invoice to the General Ledger review queue?");
        if (!confirm) return;

        var invErr = await SalesService.InvoiceOrderAsync(currentOrder.Id, currentUserId);
        if (!string.IsNullOrEmpty(invErr)) { await JS.InvokeVoidAsync("alert", invErr); return; }

        await JS.InvokeVoidAsync("alert", "Invoice staged and submitted to the General Ledger review queue.");
        await LoadData();
        activeTab = 0;
    }

    private async Task InvoiceOrderFromList(SalesOrder o)
    {
        bool hasPhysical = o.Lines.Any(l =>
        {
            var i = items.FirstOrDefault(x => x.Id == l.ItemId);
            return i != null && !i.IsService;
        });

        if (hasPhysical && o.WarehouseId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "This order contains physical items but no warehouse is selected. Please edit the order first.");
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Submit Invoice {o.OrderNumber} to the General Ledger review queue?");
        if (!confirm) return;

        var err = await SalesService.InvoiceOrderAsync(o.Id, currentUserId);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        await JS.InvokeVoidAsync("alert", "Invoice submitted to General Ledger batches.");
        await LoadData();
    }

    private async Task DownloadInvoice()
    {
        if (currentOrder == null || currentOrder.Id == Guid.Empty) return;

        isExporting = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            if (company == null)
            {
                await JS.InvokeVoidAsync("alert", "Company profile is missing. Cannot generate invoice header.");
                return;
            }

            var printOrder = await SalesService.GetOrderByIdAsync(currentOrder.Id);

            var pdfBytes = ReportExportService.GenerateInvoicePdf(printOrder, company, currencySymbol);
            var fileName = $"{printOrder.OrderNumber}_{printOrder.Customer?.Name?.Replace(" ", "_")}.pdf";

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(pdfBytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }
    private async Task DispatchEmail()
    {
        if (recentlyPostedInvoice == null) return;

        isSendingEmail = true;
        try
        {
            var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
            var currCode = currencies.FirstOrDefault(c => c.Id == recentlyPostedInvoice.CurrencyId)?.CurrencyCode ?? "";

            var pdfBytes = ReportExportService.GenerateInvoicePdf(recentlyPostedInvoice, company, currCode);
            var fileName = $"Invoice_{recentlyPostedInvoice.OrderNumber}.pdf";
            var subject = $"Invoice {recentlyPostedInvoice.OrderNumber} from {companyName}";

            await EmailService.SendEmailAsync(
                recentlyPostedInvoice.Customer?.Email ?? "",
                subject,
                customEmailMessage.Replace("\n", "<br>"),
                pdfBytes,
                fileName
            );

            await JS.InvokeVoidAsync("alert", "Invoice emailed successfully!");
            showEmailPopup = false;
            activeTab = 0;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}");
        }
        finally
        {
            isSendingEmail = false;
        }
    }
    private async Task TerminateOrder()
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", "Delete this record permanently?");
        if (!confirm) return;

        var err = await SalesService.TerminateOrderAsync(currentOrder.Id);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        await LoadData();
        activeTab = 0;
    }
}
