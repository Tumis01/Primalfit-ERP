@page "/procurement/purchase-orders"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject NavigationManager Nav
@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject TransactionMappingService MappingService
@inject WarehouseService WhService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ReportExportService ReportExportService
@inject IEmailService EmailService
@inject PermissionCacheService PermissionCache
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mx-auto max-w-[1400px] space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800 pb-16">

    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
        <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-6 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <div class="shrink-0">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Procurement</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200 mt-2">
                        @companyName
                    </span>
                }
            </div>

            <div class="flex flex-col lg:flex-row flex-wrap gap-4 items-stretch lg:items-center w-full xl:w-auto xl:justify-end">
                @if (activeTab == 0 || activeTab == 2 || activeTab == 3)
                {
                    <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center w-full lg:w-auto">
                        <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-xl border border-slate-200 w-full md:w-auto overflow-x-auto scrollbar-hide h-[42px]">
                            <input type="date" @bind="filterFromDate" class="px-2 py-1.5 text-xs font-bold bg-transparent text-slate-700 outline-none flex-1 md:w-32 cursor-pointer" />
                            <span class="text-slate-400 font-bold text-xs shrink-0">-</span>
                            <input type="date" @bind="filterToDate" class="px-2 py-1.5 text-xs font-bold bg-transparent text-slate-700 outline-none flex-1 md:w-32 cursor-pointer" />
                        </div>

                        <div class="relative w-full md:w-64 h-[42px]">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search Reference, Vendor..." class="w-full h-full pl-9 pr-4 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all" />
                        </div>
                    </div>
                }

                <div class="flex bg-slate-100 p-1 rounded-xl w-full lg:w-auto overflow-x-auto whitespace-nowrap scrollbar-hide">
                    <button @onclick="() => SetActiveTab(2)" class="flex-1 lg:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 2 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                        Requests
                    </button>
                    <button @onclick="() => SetActiveTab(0)" class="flex-1 lg:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 0 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                        Purchase Orders
                    </button>
                    <button @onclick="() => SetActiveTab(3)" class="flex-1 lg:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 3 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                        Invoices
                    </button>
                    <PermissionGate Key="PO_CREATE">
                        <Authorized>
                            <button @onclick="CreateNew" class="flex-1 lg:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 1 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                                New PO
                            </button>
                            
                        </Authorized>
                    </PermissionGate>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading procurement workspace data...</div>
    }
    else if (currentCompanyId != Guid.Empty)
    {
        @if (activeTab == 2)
        {
            <!-- REQUESTS GRID -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
                <div class="p-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Purchase Requests</h3>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left text-sm whitespace-nowrap min-w-[1000px]">
                        <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="px-6 py-4">Request Number</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Vendor</th>
                                <th class="px-6 py-4 w-[25%]">Items (Qty)</th>
                                <th class="px-6 py-4 text-right">Total (Foreign)</th>
                                <th class="px-6 py-4 text-right border-r border-slate-100">Total (Base)</th>
                                <th class="px-6 py-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var req in PagedRequests)
                            {
                                var vendorName = vendors.FirstOrDefault(v => v.Id == req.VendorId)?.Name ?? "Unknown";
                                <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                    <td class="px-6 py-4"><div class="font-mono font-bold text-slate-900">@req.OrderNumber</div></td>
                                    <td class="px-6 py-4 text-slate-500 font-medium">@req.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4"><div class="font-bold text-slate-800 truncate max-w-[200px]" title="@vendorName">@vendorName</div></td>
                                    <td class="px-6 py-4">
                                        @if (req.Lines != null && req.Lines.Any())
                                        {
                                            <div class="space-y-1.5">
                                                @foreach (var line in req.Lines.Take(2))
                                                {
                                                    var itemName = items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown Item";
                                                    <div class="flex items-center justify-between gap-3 text-xs">
                                                        <span class="truncate text-slate-600 font-medium">@itemName</span>
                                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x@(line.QuantityOrdered.ToString("G29")))</span>
                                                    </div>
                                                }
                                                @if (req.Lines.Count > 2)
                                                {
                                                    <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-500 pt-1">+ @(req.Lines.Count - 2) more item(s)</div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="font-mono font-bold text-slate-900">@req.GrandTotalForeign.ToString("N4")</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@req.Currency?.CurrencyCode</div>
                                    </td>
                                    <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                        <div class="font-mono font-bold text-emerald-700">@((req.GrandTotalForeign * (req.ExchangeRate > 0 ? req.ExchangeRate : 1)).ToString("N4"))</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            @if (orders.Any(o => o.ConvertedFromRequestNumber == req.OrderNumber))
                                            {
                                                <button @onclick="() => EditOrder(req)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100">View</button>
                                                <span class="px-3 py-1.5 text-[10px] font-bold text-slate-400 bg-slate-100 rounded border border-slate-200 uppercase tracking-wider">Converted</span>
                                            }
                                            else
                                            {
                                                <PermissionGate Key="PO_CREATE">
                                                    <Authorized>
                                                        <button @onclick="() => EditOrder(req)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50">Edit</button>
                                                        <button @onclick="() => ConvertRequestToOrder(req)" class="px-3 py-1.5 text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 shadow-sm">Make Order</button>
                                                    </Authorized>
                                                </PermissionGate>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!PagedRequests.Any())
                            {
                                <tr><td colspan="7" class="p-16 text-center text-slate-400">No requests found matching your criteria.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredRequests.Any())
                {
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                            Showing @(((currentReqPage - 1) * pageSize) + 1) to @(Math.Min(currentReqPage * pageSize, FilteredRequests.Count())) of @FilteredRequests.Count() records
                        </div>
                        <div class="flex items-center gap-2">
                            <button @onclick="() => { currentReqPage--; StateHasChanged(); }" disabled="@(currentReqPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 shadow-sm">Previous</button>
                            <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm">Page @currentReqPage of @TotalReqPages</span>
                            <button @onclick="() => { currentReqPage++; StateHasChanged(); }" disabled="@(currentReqPage >= TotalReqPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 shadow-sm">Next</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == 0)
        {
            <!-- PURCHASE ORDERS GRID -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left text-sm whitespace-nowrap min-w-[1100px]">
                        <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="px-6 py-4">PO Number</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Vendor</th>
                                <th class="px-6 py-4 w-[25%]">Items (Qty)</th>
                                <th class="px-6 py-4 text-right">Total (Foreign)</th>
                                <th class="px-6 py-4 text-right border-l border-slate-200">Total (Base)</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var po in PagedOrders)
                            {
                                var vendorName = vendors.FirstOrDefault(v => v.Id == po.VendorId)?.Name ?? "Unknown";
                                <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                    <td class="px-6 py-4">
                                        <div class="font-mono font-bold text-slate-900">@po.OrderNumber</div>
                                        @if (!string.IsNullOrEmpty(po.ConvertedFromRequestNumber))
                                        {
                                            <div class="text-[9px] text-slate-400 font-mono mt-1">From: @po.ConvertedFromRequestNumber</div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-slate-500 font-medium">@po.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4"><div class="font-bold text-slate-800 truncate max-w-[200px]" title="@vendorName">@vendorName</div></td>
                                    <td class="px-6 py-4">
                                        @if (po.Lines != null && po.Lines.Any())
                                        {
                                            <div class="space-y-1.5">
                                                @foreach (var line in po.Lines.Take(2))
                                                {
                                                    var itemName = items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown Item";
                                                    <div class="flex items-center justify-between gap-3 text-xs">
                                                        <span class="truncate text-slate-600 font-medium">@itemName</span>
                                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x@(line.QuantityOrdered.ToString("G29")))</span>
                                                    </div>
                                                }
                                                @if (po.Lines.Count > 2)
                                                {
                                                    <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-500 pt-1">+ @(po.Lines.Count - 2) more item(s)</div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="font-mono font-bold text-slate-900">@po.GrandTotalForeign.ToString("N4")</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@po.Currency?.CurrencyCode</div>
                                    </td>
                                    <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                        <div class="font-mono font-bold text-emerald-700">@((po.GrandTotalForeign * (po.ExchangeRate > 0 ? po.ExchangeRate : 1)).ToString("N4"))</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            @{
                                                bool hasInvLink = orders.Any(o => o.ConvertedFromPONumber == po.OrderNumber);
                                            }
                                            @if (hasInvLink)
                                            {
                                                <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors">View</button>
                                                <span class="px-3 py-1.5 text-[10px] font-bold text-slate-400 bg-slate-100 rounded border border-slate-200 uppercase tracking-wider">Invoiced</span>
                                            }
                                            else
                                            {
                                                <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">Edit</button>
                                                <button @onclick="() => GenerateInvoiceFromPo(po)" class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-lg hover:bg-indigo-100 shadow-sm">Make Invoice</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!PagedOrders.Any())
                            {
                                <tr><td colspan="7" class="p-16 text-center text-slate-400">No orders found matching your criteria.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredOrders.Any())
                {
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                            Showing @(((currentOrderPage - 1) * pageSize) + 1) to @(Math.Min(currentOrderPage * pageSize, FilteredOrders.Count())) of @FilteredOrders.Count() records
                        </div>
                        <div class="flex items-center gap-2">
                            <button @onclick="() => { currentOrderPage--; StateHasChanged(); }" disabled="@(currentOrderPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 shadow-sm">Previous</button>
                            <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm">Page @currentOrderPage of @TotalOrderPages</span>
                            <button @onclick="() => { currentOrderPage++; StateHasChanged(); }" disabled="@(currentOrderPage >= TotalOrderPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 shadow-sm">Next</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == 3)
        {
            <!-- INVOICES GRID -->
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left text-sm whitespace-nowrap min-w-[1100px]">
                        <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="px-6 py-4">Invoice Number</th>
                                <th class="px-6 py-4">Linked From PO</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Vendor</th>
                                <th class="px-6 py-4 text-right">Total (Base)</th>
                                <th class="px-6 py-4 text-center">Receipt Status</th>
                                <th class="px-6 py-4 text-center">Invoice Status</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var inv in PagedInvoices)
                            {
                                var vendorName = vendors.FirstOrDefault(v => v.Id == inv.VendorId)?.Name ?? "Unknown";
                                bool hasAnyReceipt = inv.HasReceipt || inv.IsFullyReceived;
                                var invoiceBatchInfo = inv.GLBatchId.HasValue && batchMap.TryGetValue(inv.GLBatchId.Value, out var mappedBatch) ? mappedBatch : null;
                                bool isRejected = invoiceBatchInfo?.Status == BatchStatus.Rejected;
                                bool isReviewEditable = invoiceBatchInfo?.Status is BatchStatus.Ready or BatchStatus.Rejected or BatchStatus.Draft;
                                bool isPosted = !isReviewEditable && (inv.IsInvoicePosted || inv.Status == PurchaseOrderStatus.Invoiced);
                                bool isLockedFromEdit = !isReviewEditable && ((hasAnyReceipt && !isRejected) || isPosted);

                                decimal debitNoteAmt = debitNotesMap.TryGetValue(inv.Id, out var dn) ? dn : 0;
                                
                                // Precise multi-currency ledger values
                                decimal invoiceTotalBase = inv.GrandTotalForeign * (inv.ExchangeRate > 0 ? inv.ExchangeRate : 1);
                                decimal netInvoiceBase = Math.Max(0, invoiceTotalBase - debitNoteAmt);
                                
                                decimal grossPaidBase = 0;
                                if (linkedBillsMap.TryGetValue(inv.Id, out var billObj))
                                {
                                    grossPaidBase = billObj.Payments?.Where(p => p.Amount > 0).Sum(p => p.Amount) ?? 0;
                                }

                                decimal remainingBalanceBase = Math.Max(0, netInvoiceBase - grossPaidBase);
                                bool isFullySettled = isPosted && (remainingBalanceBase <= 0.01m);

                                <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                    <td class="px-6 py-4 font-mono font-bold text-emerald-800">@inv.OrderNumber</td>
                                    <td class="px-6 py-4 font-mono text-xs text-slate-400">@(inv.ConvertedFromPONumber ?? "Direct Expense")</td>
                                    <td class="px-6 py-4 text-slate-500 font-medium">@inv.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4 font-bold text-slate-800">@vendorName</td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="font-mono font-bold text-emerald-700">
                                            @invoiceTotalBase.ToString("N4")
                                        </div>
                                        @if (debitNoteAmt > 0)
                                        {
                                            <div class="text-[10px] font-mono font-bold text-rose-600">
                                                Debit Note: (@debitNoteAmt.ToString("N4"))
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (inv.IsFullyReceived)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">
                                                Received Full
                                            </span>
                                        }
                                        else if (inv.HasReceipt)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">
                                                Partial GRN
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-slate-100 border border-slate-200 px-2.5 py-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider">
                                                Unreceived
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (isPosted)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">
                                                Posted
                                            </span>
                                        }
                                        else if (isRejected)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-rose-50 border border-rose-200 px-2.5 py-1 text-[10px] font-bold text-rose-700 uppercase tracking-wider animate-pulse" title="@invoiceBatchInfo?.RejectionReason">Rejected</span>
                                        }
                                        else if (invoiceBatchInfo?.Status == BatchStatus.Ready)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">In Review</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">
                                                Draft
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            <!-- View vs Edit button -->
                                            <button @onclick="() => EditOrder(inv)"
                                                    class="px-3 py-1.5 text-xs font-bold rounded-lg border transition-colors
                                                    @(isLockedFromEdit
                                                        ? "text-slate-500 bg-slate-50 border-slate-200 hover:bg-slate-100"
                                                        : "text-slate-600 bg-white border-slate-200 hover:bg-slate-50")">
                                                @(isLockedFromEdit ? "View" : "Edit")
                                            </button>

                                            <!-- Receive Goods Button -->
                                            @if (!inv.IsFullyReceived)
                                            {
                                                <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{inv.Id}")'
                                                        class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors shadow-sm flex items-center gap-1">
                                                    <span>@(inv.HasReceipt ? "Receive Remainder" : "Receive Goods")</span>
                                                </button>
                                            }

                                            <!-- Invoice Posting or Payment Flow -->
                                            @if (!isPosted)
                                            {
                                                <button @onclick="() => ExecuteInvoicePostFromList(inv)"
                                                        disabled="@(isPostingId == inv.Id)"
                                                        class="px-3 py-1.5 text-xs font-bold text-white bg-indigo-600 border border-indigo-700 rounded-lg hover:bg-indigo-700 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                                                @(isPostingId == inv.Id ? "Submitting..." : (isRejected ? "Resubmit for Review" : invoiceBatchInfo?.Status == BatchStatus.Ready ? "Update Staging" : "Submit for Review"))
                                                </button>
                                            }
                                            else
                                            {
                                                @if (isFullySettled)
                                                {
                                                    <span class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg shadow-sm">
                                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                                                        </svg>
                                                        Paid
                                                    </span>
                                                }
                                                else if (grossPaidBase > 0)
                                                {
                                                    <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={inv.Id}")'
                                                            class="px-3 py-1.5 text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded-lg hover:bg-amber-100 transition-colors shadow-sm flex items-center gap-1">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                        Receive Balance
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={inv.Id}")'
                                                            class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-lg hover:bg-indigo-100 transition-colors shadow-sm">
                                                        Receive Payment
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!PagedInvoices.Any())
                            {
                                <tr><td colspan="8" class="p-16 text-center text-slate-400">No invoice records logged in this cycle.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredInvoices.Any())
                {
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                            Showing @(((currentInvPage - 1) * pageSize) + 1) to @(Math.Min(currentInvPage * pageSize, FilteredInvoices.Count())) of @FilteredInvoices.Count() records
                        </div>
                        <div class="flex items-center gap-2">
                            <button @onclick="() => { currentInvPage--; StateHasChanged(); }" disabled="@(currentInvPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 shadow-sm">Previous</button>
                            <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm">Page @currentInvPage of @TotalInvPages</span>
                            <button @onclick="() => { currentInvPage++; StateHasChanged(); }" disabled="@(currentInvPage >= TotalInvPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 shadow-sm">Next</button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- WORKSPACE EDITOR -->
            @if (IsCurrentOrderRejected)
            {
                <div class="mb-4 p-4 bg-rose-50 border border-rose-200 rounded-xl text-sm text-rose-800">
                    <span class="font-bold uppercase tracking-wider">GL review rejection:</span> @CurrentOrderRejectionReason
                </div>
            }
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl animate-in fade-in slide-in-from-bottom-4 overflow-visible flex flex-col h-full">

                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
                    <div class="flex items-center gap-4">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Record Details</h3>
                        @if (!string.IsNullOrEmpty(currentOrder.OrderNumber))
                        {
                            <span class="px-2 py-0.5 bg-slate-200 text-slate-700 font-mono text-xs rounded font-bold">@currentOrder.OrderNumber</span>
                        }
                    </div>

                    <div class="flex items-center gap-3">
                        @if (canConfigureRoute)
                        {
                            <button type="button" @onclick="OpenRouteModal" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors flex items-center gap-1.5 shadow-sm active:scale-95">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                <span>Configure Route</span>
                                @if (currentOrder.CustomTransactionTypeId.HasValue)
                                {
                                    <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                                }
                            </button>
                        }

                        @if (!IsLocked)
                        {
                            <div class="flex items-center gap-2 bg-white p-1 rounded-xl border border-slate-200 shadow-sm">
                                <button type="button" @onclick="() => SetStatusType(PurchaseOrderStatus.Request)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status == PurchaseOrderStatus.Request ? "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-200" : "text-slate-500 hover:bg-slate-50")">
                                    Request (Draft)
                                </button>
                                <button type="button" @onclick="() => SetStatusType(PurchaseOrderStatus.Open)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status == PurchaseOrderStatus.Open ? "bg-blue-50 text-blue-700 ring-1 ring-blue-200" : "text-slate-500 hover:bg-slate-50")">
                                    Purchase Order
                                </button>
                                <button type="button" @onclick="() => SetStatusType(PurchaseOrderStatus.DraftInvoice)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status == PurchaseOrderStatus.DraftInvoice ? "bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200" : "text-slate-500 hover:bg-slate-50")">
                                    Direct Invoice
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 ring-slate-200 ring-1 flex items-center gap-1">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                                Locked Document
                            </div>
                        }
                    </div>
                </div>

                <div class="p-6 sm:p-8">
                    <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 mb-6 shadow-sm">
                        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
                            <div>
                                <label class="label">Vendor</label>
                                <select value="@currentOrder.VendorId" @onchange="OnVendorChanged" class="input-class font-bold text-slate-800 border-indigo-200 bg-white" disabled="@IsLocked">
                                    <option value="@Guid.Empty">-- Select Vendor --</option>
                                    @foreach (var v in vendors)
                                    {
                                        <option value="@v.Id">@v.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="label">Order Date</label>
                                <input type="date" @bind="currentOrder.OrderDate" class="input-class bg-white" disabled="@IsLocked" />
                            </div>

                            <ExchangeRatePicker CompanyId="@currentCompanyId"
                                                 CurrencyId="@currentOrder.CurrencyId"
                                                 CurrencyCode="@GetCurrencyCode(currentOrder.CurrencyId)"
                                                 CompanyBaseCurrency="@companyBaseCurrency"
                                                 CurrentRate="@currentOrder.ExchangeRate"
                                                 CurrentRateChanged="OnExchangeRateChanged"
                                                 Disabled="@IsLocked" />

                            <div>
                                <label class="label">Tax / VAT</label>
                                <select value="@currentOrder.TaxId" @onchange="OnTaxChanged" class="input-class bg-white" disabled="@IsLocked">
                                    <option value="">No Tax</option>
                                    @foreach (var t in taxes)
                                    {
                                        <option value="@t.Id">@t.TaxName (@t.Per%)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-xl overflow-visible mb-6 shadow-sm">
                        <div class="relative overflow-visible">
                            <table class="w-full text-sm text-left overflow-visible">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-[40%]">Item</th>
                                        <th class="p-3 w-[15%] text-center">Qty</th>
                                        <th class="p-3 w-[20%] text-right">Unit Price / Cost (@currencySymbol)</th>
                                        <th class="p-3 w-[20%] text-right pr-4">Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 min-h-[150px] overflow-visible">
                                    @foreach (var line in currentOrder.Lines)
                                    {
                                        <tr class="relative group hover:bg-slate-50 transition-colors overflow-visible">
                                            <td class="p-2 pl-4 align-top overflow-visible z-50">
                                                @if (IsLocked)
                                                {
                                                    <div class="p-2 font-bold text-slate-700 bg-slate-50 rounded-lg border border-slate-200">
                                                        @(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown Product Definition")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <SearchableItem Label="" Items="@items" @bind-Value="line.ItemId" OnSelectionChanged="@(() => UpdateLineItem(line))" IsInvalid="@(line.ItemId == Guid.Empty)" />
                                                }
                                            </td>
                                            <td class="p-2 align-top pt-3 text-center">
                                                <input type="number" step="0.0001" @bind="line.QuantityOrdered" class="input-class py-2 text-center font-bold" placeholder="1.0000" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.0001" @bind="line.UnitCost" class="input-class py-2 text-right font-mono @(IsLocked ? "bg-slate-100 text-slate-500 cursor-not-allowed border-slate-200" : "")" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-4 text-right font-mono font-bold text-slate-700">
                                                @((line.QuantityOrdered * line.UnitCost).ToString("N4"))
                                            </td>
                                            <td class="p-2 text-center align-top pt-4">
                                                @if (!IsLocked)
                                                {
                                                    <button type="button" @onclick="() => currentOrder.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600 opacity-0 group-hover:opacity-100">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (!IsLocked)
                        {
                            <div class="p-2 bg-slate-50 border-t border-slate-200">
                                <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Line Item
                                </button>
                            </div>
                        }
                    </div>

                    <div class="flex flex-col md:flex-row justify-between items-start gap-6">
                        <div class="w-full md:w-1/2 p-5 border border-emerald-100 rounded-xl shadow-sm bg-emerald-50/20">
                            <h4 class="font-extrabold text-xs uppercase tracking-wider text-emerald-800 mb-4 flex items-center gap-2">Discount Terms</h4>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="label text-[10px]">Percentage (%)</label>
                                    <input type="number" step="0.0001" @bind="currentOrder.DiscountPercentage" @bind:after="() => { if (currentOrder.DiscountPercentage > 0) currentOrder.DiscountAmount = 0; }" class="input-class text-center font-bold text-emerald-700 border-emerald-200 focus:border-emerald-500" disabled="@IsLocked" />
                                </div>
                                <div>
                                    <label class="label text-[10px]">Flat Value Amount (@currencySymbol)</label>
                                    <input type="number" step="0.0001" @bind="currentOrder.DiscountAmount" @bind:after="() => { if (currentOrder.DiscountAmount > 0) currentOrder.DiscountPercentage = 0; }" class="input-class text-right font-mono border-emerald-200 focus:border-emerald-500" disabled="@IsLocked" />
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2 text-sm text-slate-600 w-full md:w-80 bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm">
                            <div class="flex justify-between"><span>Subtotal:</span><span class="font-mono font-bold">@SubTotal.ToString("N4")</span></div>
                            <div class="flex justify-between items-center text-emerald-600 border-b border-slate-200 pb-2"><span>Discount:</span><span class="font-mono font-bold">- @DiscountValue.ToString("N4")</span></div>
                            <div class="flex justify-between items-center pt-1"><span>Net Subtotal:</span><span class="font-mono font-bold">@DiscountedSubTotal.ToString("N4")</span></div>
                            <div class="flex justify-between items-center"><span>Tax (@TaxPercentage%):</span><span class="font-mono font-bold">+ @TaxAmount.ToString("N4")</span></div>
                            <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                <span class="font-bold">Total (@currencySymbol):</span>
                                <span class="font-mono font-black text-indigo-700 text-2xl">@GrandTotalForeign.ToString("N4")</span>
                            </div>
                            <div class="flex justify-between text-[10px] text-slate-400 mt-1 uppercase font-bold tracking-wider">
                                <span>Ledger Base Value:</span><span class="font-mono text-slate-500">@GrandTotalBase.ToString("N4")</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-end gap-3 mt-8 pt-5 border-t border-slate-200">
                        @if (currentOrder.Id != Guid.Empty && currentOrder.Status != PurchaseOrderStatus.Request)
                        {
                            <button type="button" @onclick="DownloadPO" disabled="@isExporting" class="px-6 py-2.5 rounded-xl border border-emerald-200 text-emerald-700 bg-emerald-50 font-bold text-sm hover:bg-emerald-100 transition-colors flex items-center gap-2 disabled:opacity-50 shadow-sm mr-auto">
                                @if (isExporting)
                                {
                                    <span class="animate-spin">↻</span>
                                }
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg> Download PO
                            </button>
                        }

                        @if (!IsLocked)
                        {
                            <PermissionGate Key="PO_CREATE">
                                <Authorized>
                                    <button type="button" @onclick="TerminateOrder" class="px-5 py-2.5 rounded-xl border border-rose-200 text-rose-600 font-bold text-sm hover:bg-rose-50 transition-colors">Delete</button>
                                </Authorized>
                            </PermissionGate>

                            <button type="button" @onclick="() => SetActiveTab(currentOrder.Status == PurchaseOrderStatus.DraftInvoice ? 3 : (currentOrder.Status == PurchaseOrderStatus.Request ? 2 : 0))" class="px-6 py-2.5 rounded-xl font-bold text-slate-500 hover:bg-slate-100 transition-colors">Cancel</button>

                            <PermissionGate Key="PO_CREATE">
                                <Authorized>
                                    @if (currentOrder.Status == PurchaseOrderStatus.DraftInvoice)
                                    {
                                        <button type="button" @onclick="SaveInvoiceDraft" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2" disabled="@isBusy">
                                            @if (isBusy) { <span class="animate-spin">↻</span> }
                                            <span>Save Invoice Draft</span>
                                        </button>

                                        <button type="button" @onclick="SaveAndPostFormInvoice" class="px-8 py-2.5 bg-emerald-600 text-white rounded-xl font-bold text-sm hover:bg-emerald-700 shadow-md transition-all active:scale-95 flex items-center gap-2" disabled="@isBusy">
                                            @if (isBusy) { <span class="animate-spin">↻</span> }
                                            <span>@(IsCurrentOrderRejected ? "Resubmit Invoice for GL Review" : CurrentOrderBatchInfo?.Status == BatchStatus.Ready ? "Update Invoice Staging" : "Submit Invoice for GL Review")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" @onclick="SaveOrder" class="px-8 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2" disabled="@isBusy">
                                            @if (isBusy) { <span class="animate-spin">↻</span> }
                                            <span>@(currentOrder.Status == PurchaseOrderStatus.Request ? "Save Request" : "Save Purchase Order")</span>
                                        </button>
                                    }
                                </Authorized>
                            </PermissionGate>
                        }
                        else
                        {
                            <button type="button" @onclick="() => SetActiveTab(currentOrder.Status == PurchaseOrderStatus.DraftInvoice || currentOrder.Status == PurchaseOrderStatus.Invoiced ? 3 : (currentOrder.Status == PurchaseOrderStatus.Request ? 2 : 0))" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md">Close View</button>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Modal Dialogs -->
@if (showRouteModal)
{
    <div class="fixed inset-0 z-[120] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col overflow-visible">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                <div>
                    <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">Procurement GL Route Mapping</h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Inspect and override accounting routes for purchase bills and vendor liability.</p>
                </div>
                <button type="button" @onclick="() => showRouteModal = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-visible space-y-5 flex-1">
                <div class="p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 space-y-2 relative z-[60]">
                    <label class="block text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Transaction Routing Profile</label>
                    <div class="flex items-center gap-2">
                        @if (currentOrder.CustomTransactionTypeId.HasValue)
                        {
                            <button type="button"
                                    @onclick="() => currentOrder.CustomTransactionTypeId = null"
                                    class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                    title="Reset to Standard Procurement Route">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        }
                        <select value="@(currentOrder.CustomTransactionTypeId?.ToString() ?? "")" @onchange="OnCustomTemplateSelected"
                                class="input-class font-bold text-xs bg-white flex-1" disabled="@IsLocked">
                            <option value="">-- Standard Procurement Route (Default) --</option>
                            @foreach (var custom in customTemplates)
                            {
                                <option value="@custom.Id">@custom.Name (Custom Template)</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="space-y-3 overflow-visible">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active GL Account Routing</span>

                    <div class="border border-slate-200 rounded-xl overflow-visible divide-y divide-slate-100 text-xs bg-white">
                        <!-- 1. GR/IR Clearing Account -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[50] rounded-t-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">GR/IR Clearing / Expense</span>
                                <span class="text-[10px] text-indigo-600 font-bold uppercase">Debit Side (Clearing)</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentOrder.GoodsReceiptClearingGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentOrder.GoodsReceiptClearingGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="Default GR/IR Clearing Account"
                                                         Accounts="@allAccounts"
                                                         Value="@(currentOrder.GoodsReceiptClearingGlAccountId ?? defaultGrIrAccountId)"
                                                         ValueChanged="@((Guid val) => currentOrder.GoodsReceiptClearingGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

