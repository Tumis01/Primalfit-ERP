    private async Task OpenRouteModal()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        customTemplates = await ctx.CustomTransactionTypes
            .AsNoTracking()
            .Where(t => t.CompanyId == currentCompanyId)
            .OrderBy(t => t.Name)
            .ToListAsync();

        var vendor = vendors.FirstOrDefault(v => v.Id == currentOrder.VendorId);
        defaultApAccountId = vendor?.PayablesAccountId ?? Guid.Empty;

        showRouteModal = true;
    }

    private async Task OnCustomTemplateSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var customId) && customId != Guid.Empty)
        {
            currentOrder.CustomTransactionTypeId = customId;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var map = await ctx.TransactionGlMappings
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.CompanyId == currentCompanyId && m.CustomTransactionTypeId == customId);

            if (map != null)
            {
                if (map.OverrideDebitGlAccountId.HasValue)
                    currentOrder.GoodsReceiptClearingGlAccountId = map.OverrideDebitGlAccountId.Value;

                if (map.OverrideCreditGlAccountId.HasValue)
                    currentOrder.AccountsPayableGlAccountId = map.OverrideCreditGlAccountId.Value;
            }
        }
        else
        {
            currentOrder.CustomTransactionTypeId = null;
        }
    }

    private async Task<(byte[] Bytes, string FileName, string Subject, string VendorEmail)> GetPoPdfDataAsync(Guid poId)
    {
        var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
        using var ctx = await DbFactory.CreateDbContextAsync();
        var printOrder = await ctx.PurchaseOrders.Include(p => p.Lines).Include(p => p.Currency).FirstOrDefaultAsync(p => p.Id == poId);

        if (printOrder == null || company == null) return (null, "", "", "");

        var vendor = vendors.FirstOrDefault(v => v.Id == printOrder.VendorId);
        var itemNamesMap = items.ToDictionary(i => i.Id, i => i.Name);

        decimal st = printOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
        decimal disc = printOrder.DiscountPercentage > 0 ? st * (printOrder.DiscountPercentage / 100) : printOrder.DiscountAmount;
        decimal taxP = taxes.FirstOrDefault(t => t.Id == printOrder.TaxId)?.Per ?? 0;
        printOrder.GrandTotalForeign = (st - disc) + ((st - disc) * (taxP / 100));

        var pdfBytes = ReportExportService.GeneratePurchaseOrderPdf(printOrder, company, vendor?.Name ?? "Vendor", vendor?.Email ?? "", itemNamesMap);
        return (pdfBytes, $"PO_{printOrder.OrderNumber}.pdf", $"Purchase Order {printOrder.OrderNumber} from {company.CompanyName}", vendor?.Email ?? "");
    }

    private async Task DownloadPO()
    {
        if (currentOrder == null || currentOrder.Id == Guid.Empty) return;
        isExporting = true;
        try
        {
            var data = await GetPoPdfDataAsync(currentOrder.Id);
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(data.Bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", data.FileName, streamRef);
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}"); }
        finally { isExporting = false; }
    }

    private async Task DispatchEmail()
    {
        if (emailTargetPoId == Guid.Empty) return;
        isSendingEmail = true;
        try
        {
            var data = await GetPoPdfDataAsync(emailTargetPoId);
            await EmailService.SendEmailAsync(emailVendorAddress, emailSubject, customEmailMessage.Replace("\n", "<br>"), data.Bytes, data.FileName);
            await JS.InvokeVoidAsync("alert", "Document emailed successfully!");
            showEmailPopup = false;
            SetActiveTab(3);
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}"); }
        finally { isSendingEmail = false; }
    }

    private async Task TerminateOrder()
    {
        if (currentOrder.Id == Guid.Empty) { SetActiveTab(0); return; }
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete {currentOrder.OrderNumber}?");
        if (!confirm) return;

        isBusy = true;
        try
        {
            var err = await PurchService.DeletePurchaseOrderAsync(currentOrder.Id);
            if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }
            await LoadData();
            SetActiveTab(0);
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("alert", $"UI Error: {ex.Message}"); }
        finally { isBusy = false; }
    }
