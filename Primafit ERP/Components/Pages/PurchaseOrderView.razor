@page "/procurement/purchase-orders"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Nav
@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-2 border-b border-slate-200">
        <div class="space-y-1">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Purchase Orders</h1>
            <p class="text-sm text-slate-500 font-medium">Create commitments and track procurement.</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="hidden sm:flex items-center gap-2 px-4 py-2 bg-slate-100 rounded-xl border border-slate-200">
                <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Orders</span>
                <span class="text-sm font-black text-slate-900">@orders.Count</span>
            </div>
            <button @onclick="CreateNew"
                    class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 active:translate-y-0 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
                <span>New Order</span>
            </button>
        </div>
    </div>

    @if (currentCompanyId == Guid.Empty)
    {
        <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 shadow-sm flex items-start gap-3">
            <svg class="w-5 h-5 text-rose-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <div>
                <h3 class="text-sm font-bold text-rose-800">Critical System Error</h3>
                <p class="text-sm text-rose-600 mt-1">No Company ID Loaded. Orders cannot be processed.</p>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-16 text-center shadow-sm flex flex-col items-center justify-center">
            <div class="w-10 h-10 border-4 border-slate-200 border-t-slate-900 rounded-full animate-spin mb-4"></div>
            <p class="text-sm font-bold text-slate-400">Loading purchase orders...</p>
        </div>
    }
    else
    {
        <div class="hidden lg:block rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="px-6 py-4">PO Number</th>
                            <th class="px-6 py-4">Date</th>
                            <th class="px-6 py-4">Vendor</th>
                            <th class="px-6 py-4 w-[25%]">Items (Qty)</th>
                            <th class="px-6 py-4 text-right">Total (Vendor)</th>
                            <th class="px-6 py-4 text-right">Base Value</th>
                            <th class="px-6 py-4 text-center">Status</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var po in orders)
                        {
                            var vendorName = vendors.FirstOrDefault(v => v.Id == po.VendorId)?.Name ?? "Unknown";
                            var vendorTotal = po.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
                            var baseTotal = vendorTotal * po.ExchangeRate;

                            <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                <td class="px-6 py-4">
                                    <div class="font-mono font-bold text-slate-900">@po.OrderNumber</div>
                                    @if (po.ExchangeRate != 1)
                                    {
                                        <div class="text-[10px] text-slate-400 font-medium mt-0.5">Rate: @po.ExchangeRate.ToString("N4")</div>
                                    }
                                </td>

                                <td class="px-6 py-4 text-slate-500 font-medium">@po.OrderDate.ToString("MMM dd, yyyy")</td>

                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-800 truncate max-w-[200px]" title="@vendorName">@vendorName</div>
                                </td>

                                <td class="px-6 py-4">
                                    @if (po.Lines != null && po.Lines.Any())
                                    {
                                        <div class="space-y-1.5">
                                            @foreach (var line in po.Lines.Take(2))
                                            {
                                                var itemName = items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown Item";
                                                <div class="flex items-center justify-between gap-3 text-xs">
                                                    <span class="truncate text-slate-600 font-medium">@itemName</span>
                                                    <span class="shrink-0 font-mono font-bold text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded">x @line.QuantityOrdered.ToString("G29")</span>
                                                </div>
                                            }
                                            @if (po.Lines.Count > 2)
                                            {
                                                <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-500 pt-1">
                                                    + @(po.Lines.Count - 2) more item(s)
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 italic text-xs">No items</span>
                                    }
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-slate-900">@vendorTotal.ToString("N2")</div>
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-emerald-600">@baseTotal.ToString("N2")</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                </td>

                                <td class="px-6 py-4 text-center">
                                    @if (po.IsInvoicePosted)
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">
                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> Posted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Open
                                        </span>
                                    }
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (po.Status == PurchaseOrderStatus.Open && !po.HasReceipt)
                                        {
                                            <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">Edit</button>
                                            <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")' class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors shadow-sm">Receive Goods</button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors">View</button>

                                            @if (!po.IsFullyReceived)
                                            {
                                                <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")' class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors shadow-sm">
                                                    Receive Goods
                                                </button>
                                            }

                                            @if (!po.IsInvoicePosted)
                                            {
                                                <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={po.Id}")' class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-lg hover:bg-indigo-100 transition-colors shadow-sm">
                                                    Post Invoice
                                                </button>
                                            }
                                            else if (!po.IsFullyPaid)
                                            {
                                                <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={po.Id}")' class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-lg hover:bg-indigo-100 transition-colors shadow-sm">
                                                    Make Payments
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-1 bg-emerald-100 text-emerald-700 font-bold text-[10px] uppercase tracking-wider rounded border border-emerald-200 flex items-center gap-1">
                                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> Paid & Closed
                                                </span>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!orders.Any())
                {
                    <div class="p-16 text-center text-slate-400">
                        <svg class="w-12 h-12 mx-auto text-slate-200 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                        <p class="font-medium">No purchase orders found.</p>
                    </div>
                }
            </div>
        </div>

        <div class="lg:hidden space-y-4">
            @if (!orders.Any())
            {
                <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 shadow-sm">
                    No orders found.
                </div>
            }
            else
            {
                @foreach (var po in orders)
                {
                    var vendorName = vendors.FirstOrDefault(v => v.Id == po.VendorId)?.Name ?? "Unknown";
                    var vendorTotal = po.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
                    var baseTotal = vendorTotal * po.ExchangeRate;

                    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden">
                        <div class="p-5 space-y-4">
                            <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-3">
                                <div class="min-w-0">
                                    <div class="font-mono font-bold text-slate-900 text-base">@po.OrderNumber</div>
                                    <div class="text-xs text-slate-500 font-medium mt-0.5">@po.OrderDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="shrink-0">
                                    @if (po.IsInvoicePosted)
                                    {
                                        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 border border-emerald-200 uppercase tracking-wider">Posted</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-bold text-amber-700 border border-amber-200 uppercase tracking-wider">Open</span>
                                    }
                                </div>
                            </div>

                            <div class="space-y-1">
                                <div class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Vendor</div>
                                <div class="font-bold text-slate-800 text-sm truncate">@vendorName</div>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div class="rounded-xl border border-slate-100 bg-slate-50 p-3">
                                    <div class="text-[10px] text-slate-500 font-bold uppercase tracking-wider">Total (Vendor)</div>
                                    <div class="mt-1 font-mono font-bold text-slate-900">@vendorTotal.ToString("N2")</div>
                                </div>
                                <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-3">
                                    <div class="text-[10px] text-emerald-700 font-bold uppercase tracking-wider">Base (@companyBaseCurrency)</div>
                                    <div class="mt-1 font-mono font-bold text-emerald-800">@baseTotal.ToString("N2")</div>
                                </div>
                            </div>
                        </div>

                        <div class="border-t border-slate-100 bg-slate-50/50 p-4">
                            <div class="flex flex-col sm:flex-row gap-2">
                                @if (po.Status == PurchaseOrderStatus.Open && !po.HasReceipt)
                                {
                                    <button @onclick="() => EditOrder(po)" class="w-full sm:w-1/2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-slate-50 shadow-sm transition-colors">
                                        Edit Order
                                    </button>
                                    <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")' class="w-full sm:w-1/2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm font-bold text-emerald-800 hover:bg-emerald-100 shadow-sm transition-colors">
                                        Receive Goods
                                    </button>
                                }
                                else if (po.Status == PurchaseOrderStatus.Open && po.HasReceipt && !po.IsInvoicePosted)
                                {
                                    <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={po.Id}")' class="w-full rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-sm font-bold text-indigo-800 hover:bg-indigo-100 shadow-sm transition-colors">
                                        Post Vendor Bill
                                    </button>
                                }
                                else
                                {
                                    <button @onclick="() => EditOrder(po)" class="w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-50 shadow-sm transition-colors">
                                        View Details
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @if (orders.Any())
        {
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 pt-4">

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <div class="flex items-center gap-3 mb-6 border-b border-slate-100 pb-4">
                        <div class="p-2 bg-indigo-50 rounded-lg">
                            <svg class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900">Top Spending by Vendor</h3>
                            <p class="text-[10px] text-slate-500 uppercase tracking-wider font-bold">Base Currency</p>
                        </div>
                    </div>

                    <div class="space-y-5">
                        @foreach (var stat in vendorStats.Take(5))
                        {
                            <div class="flex items-center gap-4 group">
                                <div class="h-10 w-10 shrink-0 rounded-xl bg-slate-50 text-slate-600 border border-slate-200 flex items-center justify-center font-black text-sm group-hover:bg-indigo-50 group-hover:text-indigo-600 group-hover:border-indigo-200 transition-colors">
                                    @stat.VendorInitial
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline justify-between gap-2 mb-1.5">
                                        <span class="truncate font-bold text-slate-700 text-sm">@stat.VendorName</span>
                                        <span class="shrink-0 font-mono font-black text-slate-900 text-sm">
                                            @stat.TotalSpent.ToString("N0")
                                        </span>
                                    </div>
                                    <div class="h-1.5 w-full rounded-full bg-slate-100 overflow-hidden">
                                        <div class="h-full bg-indigo-500 rounded-full" style="width: @(Math.Min((stat.TotalSpent / (maxVendorSpend == 0 ? 1 : maxVendorSpend)) * 100, 100))%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm flex flex-col">
                    <div class="flex items-center gap-3 mb-6 border-b border-slate-100 pb-4">
                        <div class="p-2 bg-emerald-50 rounded-lg">
                            <svg class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-slate-900">Monthly Commitments</h3>
                            <p class="text-[10px] text-slate-500 uppercase tracking-wider font-bold">Past 6 Months</p>
                        </div>
                    </div>

                    <div class="flex items-end justify-between flex-1 pt-4 gap-2">
                        @foreach (var month in monthlyStats)
                        {
                            <div class="flex flex-col items-center flex-1 min-w-0 h-full justify-end group">
                                <div class="text-[10px] font-mono font-bold text-slate-500 mb-2 opacity-0 group-hover:opacity-100 transition-opacity translate-y-2 group-hover:translate-y-0">
                                    @month.Total.ToString("N0")
                                </div>
                                <div class="w-full max-w-[40px] rounded-t-lg bg-slate-50 border border-slate-100 border-b-0 overflow-hidden flex flex-col justify-end" style="height: 140px;">
                                    <div class="w-full bg-emerald-400 group-hover:bg-emerald-500 transition-all duration-300"
                                         style="height: @(Math.Max((month.Total / (maxMonthlySpend == 0 ? 1 : maxMonthlySpend)) * 100, 4))%">
                                    </div>
                                </div>
                                <div class="mt-3 text-[10px] font-bold text-slate-600 uppercase tracking-wider">
                                    @month.MonthName
                                </div>
                            </div>
                        }
                    </div>
                </div>

            </div>
        }
    }

    @if (showModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 overflow-y-auto animate-in fade-in duration-200">
            <div class="bg-white rounded-3xl shadow-2xl w-full max-w-4xl p-0 my-8 overflow-hidden animate-in zoom-in-95 duration-300 border border-slate-200">

                <div class="flex items-center justify-between px-6 py-4 bg-slate-50 border-b border-slate-100">
                    <div>
                        <h3 class="text-lg font-black text-slate-900 uppercase tracking-tight">
                            @((currentOrder.Id == Guid.Empty) ? "New Purchase Order" : "Purchase Order Details")
                        </h3>
                    </div>
                    <button @onclick="() => showModal = false" class="rounded-full p-2 text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition-colors">
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <div class="p-6">
                    <div class="grid grid-cols-1 gap-5 md:grid-cols-4 mb-8">
                        <div class="md:col-span-2">
                            <label class="label">Vendor</label>
                            <select value="@currentOrder.VendorId" @onchange="OnVendorChanged" class="input-class font-bold text-slate-800">
                                <option value="@Guid.Empty">-- Select Vendor --</option>
                                @foreach (var v in vendors)
                                {
                                    <option value="@v.Id">@v.Name</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="label">Order Date</label>
                            <input type="date" @bind="currentOrder.OrderDate" class="input-class" />
                        </div>
                        <div>
                            <label class="label text-slate-400">Order Number</label>
                            <input @bind="currentOrder.OrderNumber" class="input-class bg-slate-50 font-mono text-slate-500 border-dashed" readonly />
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(selectedCurrencyCode))
                    {
                        <div class="flex items-center gap-4 bg-indigo-50 border border-indigo-100 p-3 rounded-xl mb-6">
                            <div>
                                <label class="block text-[10px] font-bold text-indigo-400 uppercase tracking-wider mb-1">Currency</label>
                                <div class="font-bold text-indigo-700">@selectedCurrencyCode</div>
                            </div>
                            <div class="h-8 w-px bg-indigo-200 mx-2"></div>
                            <div>
                                <label class="block text-[10px] font-bold text-indigo-400 uppercase tracking-wider mb-1">Exchange Rate</label>
                                <input type="number" step="0.0001" @bind="currentOrder.ExchangeRate" class="input-class py-1 px-2 text-sm font-mono font-bold text-indigo-900 border-indigo-300 w-32" />
                            </div>
                        </div>
                    }

                    <div class="border border-slate-200 rounded-2xl overflow-hidden mb-6 shadow-sm">
                        <div class="bg-slate-50 px-4 py-3 border-b border-slate-200 flex items-center justify-between">
                            <h4 class="font-black text-slate-700 text-xs uppercase tracking-wider">Line Items</h4>
                            <button @onclick="AddLine" class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-2.5 py-1.5 rounded-lg hover:bg-indigo-100 transition-colors">
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" /></svg> Add
                            </button>
                        </div>

                        <div class="hidden md:block overflow-x-auto bg-white">
                            <table class="w-full text-sm text-left">
                                <thead class="text-[10px] uppercase font-bold text-slate-400 border-b border-slate-100">
                                    <tr>
                                        <th class="p-3 pl-4 w-[45%]">Item Selection</th>
                                        <th class="p-3 text-right w-[15%]">Quantity</th>
                                        <th class="p-3 text-right w-[15%]">Unit Cost</th>
                                        <th class="p-3 text-right w-[20%]">Line Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50">
                                    @foreach (var line in currentOrder.Lines)
                                    {
                                        <tr class="group hover:bg-slate-50/50 transition-colors">
                                            <td class="p-2 pl-4">
                                                <SearchableItem Label="" Items="@items" @bind-Value="line.ItemId" />
                                            </td>
                                            <td class="p-2">
                                                <input type="number" @bind="line.QuantityOrdered" class="input-class text-right font-mono font-bold" />
                                            </td>
                                            <td class="p-2">
                                                <input type="number" @bind="line.UnitCost" class="input-class text-right font-mono text-slate-500" />
                                            </td>
                                            <td class="p-2 pr-4 text-right font-mono font-bold text-slate-800">
                                                @((line.QuantityOrdered * line.UnitCost).ToString("N2"))
                                            </td>
                                            <td class="p-2 text-center">
                                                <button @onclick="() => currentOrder.Lines.Remove(line)" class="text-slate-300 hover:text-rose-500 transition-colors opacity-0 group-hover:opacity-100">
                                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="md:hidden bg-slate-50/50 p-3 space-y-3">
                            @foreach (var line in currentOrder.Lines)
                            {
                                <div class="bg-white rounded-xl border border-slate-200 p-3 relative">
                                    <button @onclick="() => currentOrder.Lines.Remove(line)" class="absolute -top-2 -right-2 bg-white rounded-full p-1 text-rose-500 shadow-sm border border-slate-100 hover:bg-rose-50">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                    <div class="mb-3">
                                        <SearchableItem Label="" Items="@items" @bind-Value="line.ItemId" />
                                    </div>
                                    <div class="grid grid-cols-2 gap-3 mb-3">
                                        <div>
                                            <div class="text-[10px] font-bold text-slate-400 uppercase mb-1">Qty</div>
                                            <input type="number" @bind="line.QuantityOrdered" class="input-class text-center font-mono font-bold" />
                                        </div>
                                        <div>
                                            <div class="text-[10px] font-bold text-slate-400 uppercase mb-1">Unit Cost</div>
                                            <input type="number" @bind="line.UnitCost" class="input-class text-center font-mono" />
                                        </div>
                                    </div>
                                    <div class="flex justify-between items-center pt-2 border-t border-slate-100">
                                        <span class="text-[10px] font-bold text-slate-500 uppercase">Line Total</span>
                                        <span class="font-mono font-bold text-slate-900">@((line.QuantityOrdered * line.UnitCost).ToString("N2"))</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="bg-slate-50 border-t border-slate-200 p-5 flex flex-col sm:flex-row justify-end items-end sm:items-center gap-6">
                            <div class="flex flex-col items-end">
                                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Total (@(string.IsNullOrEmpty(selectedCurrencyCode) ? "N/A" : selectedCurrencyCode))</span>
                                <span class="text-xl font-mono font-black text-slate-900 leading-none">@VendorTotal.ToString("N2")</span>
                            </div>
                            <div class="h-8 w-px bg-slate-200 hidden sm:block"></div>
                            <div class="flex flex-col items-end">
                                <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider mb-1">Base Ledger (@companyBaseCurrency)</span>
                                <span class="text-lg font-mono font-bold text-emerald-700 leading-none">@BaseTotal.ToString("N2")</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 pt-2">
                        <button @onclick="() => showModal = false" class="w-full sm:w-auto px-6 py-2.5 rounded-xl font-bold text-slate-500 hover:bg-slate-100 transition-colors">
                            Cancel
                        </button>
                        <button @onclick="SaveOrder" disabled="@isBusy" class="w-full sm:w-auto px-8 py-2.5 rounded-xl bg-slate-900 text-white font-bold shadow-md hover:bg-slate-800 transition-all hover:-translate-y-0.5 disabled:opacity-50 flex justify-center items-center gap-2">
                            @if (isBusy)
                            {
                                <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save Order</span>
                            }
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: .05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        outline: none;
        background: #fff;
        color: #1e293b;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .input-class:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }
    
        .input-class:read-only {
            background-color: #f8fafc;
            color: #64748b;
            cursor: not-allowed;
        }
</style>

@code {
    private List<PurchaseOrder> orders = new();
    private List<Vendor> vendors = new();
    private List<Item> items = new();
    private PurchaseOrder currentOrder = new();

    private bool isLoading = true;
    private bool showModal = false;
    private bool isBusy = false;
    private Guid currentCompanyId;
    private string selectedCurrencyCode = "";
    private string companyBaseCurrency = "BASE";

    private List<VendorStat> vendorStats = new();
    private List<MonthlyStat> monthlyStats = new();
    private decimal maxVendorSpend = 1;
    private decimal maxMonthlySpend = 1;

    private decimal VendorTotal => currentOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
    private decimal BaseTotal => VendorTotal * currentOrder.ExchangeRate;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;

            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null)
            {
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }

            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        orders = await PurchService.GetPOsAsync(currentCompanyId);
        vendors = await MasterService.GetVendorsAsync(currentCompanyId);
        items = await MasterService.GetItemsAsync(currentCompanyId);

        CalculateAnalytics();
    }

    private void CalculateAnalytics()
    {
        vendorStats = orders
            .GroupBy(o => o.VendorId)
            .Select(g => new VendorStat
            {
                VendorName = vendors.FirstOrDefault(v => v.Id == g.Key)?.Name ?? "Unknown",
                TotalSpent = g.Sum(o => o.Lines.Sum(l => l.QuantityOrdered * l.UnitCost) * o.ExchangeRate)
            })
            .OrderByDescending(x => x.TotalSpent)
            .ToList();

        if (vendorStats.Any()) maxVendorSpend = vendorStats.Max(x => x.TotalSpent);

        var sixMonthsAgo = DateTime.Today.AddMonths(-5);
        monthlyStats = orders
            .Where(o => o.OrderDate >= sixMonthsAgo)
            .GroupBy(o => new { o.OrderDate.Year, o.OrderDate.Month })
            .Select(g => new MonthlyStat
            {
                MonthName = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM"),
                Total = g.Sum(o => o.Lines.Sum(l => l.QuantityOrdered * l.UnitCost) * o.ExchangeRate)
            })
            .OrderBy(x => DateTime.ParseExact(x.MonthName, "MMM", null))
            .ToList();

        if (monthlyStats.Any()) maxMonthlySpend = monthlyStats.Max(x => x.Total);
    }

    private void CreateNew()
    {
        currentOrder = new PurchaseOrder
        {
            CompanyId = currentCompanyId,
            OrderNumber = $"PO-{DateTime.Now:yyMM}-{new Random().Next(1000, 9999)}",
            Lines = new List<PurchaseOrderLine> { new() },
            ExchangeRate = 1
        };
        selectedCurrencyCode = "";
        showModal = false; // Hide first to trigger re-render animation
        StateHasChanged();
        showModal = true;
    }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid vendorId))
        {
            currentOrder.VendorId = vendorId;
            var result = await PurchService.GetVendorCurrencyDataAsync(vendorId, currentCompanyId);

            currentOrder.CurrencyId = result.CurrencyId;
            currentOrder.ExchangeRate = result.Rate;
            selectedCurrencyCode = result.CurrencyCode;
        }
    }

    private async Task EditOrder(PurchaseOrder po)
    {
        var result = await PurchService.GetVendorCurrencyDataAsync(po.VendorId, currentCompanyId);
        selectedCurrencyCode = result.CurrencyCode;

        currentOrder = new PurchaseOrder
        {
            Id = po.Id,
            CompanyId = po.CompanyId,
            VendorId = po.VendorId,
            OrderDate = po.OrderDate,
            OrderNumber = po.OrderNumber,
            Status = po.Status,
            CurrencyId = po.CurrencyId,
            ExchangeRate = po.ExchangeRate,
            Lines = po.Lines.Select(l => new PurchaseOrderLine
            {
                Id = l.Id,
                ItemId = l.ItemId,
                QuantityOrdered = l.QuantityOrdered,
                UnitCost = l.UnitCost
            }).ToList()
        };
        showModal = true;
    }

    private void AddLine() => currentOrder.Lines.Add(new PurchaseOrderLine());

    private async Task SaveOrder()
    {
        if (currentOrder.VendorId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Vendor.");
            return;
        }

        isBusy = true;
        try
        {
            if (currentOrder.CurrencyId == Guid.Empty && currentOrder.VendorId != Guid.Empty)
            {
                var result = await PurchService.GetVendorCurrencyDataAsync(currentOrder.VendorId, currentCompanyId);
                currentOrder.CurrencyId = result.CurrencyId;
                currentOrder.ExchangeRate = result.Rate;
            }

            string resultStr = await PurchService.SavePurchaseOrderAsync(currentOrder);

            if (string.IsNullOrEmpty(resultStr))
            {
                showModal = false;
                await LoadData();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ " + resultStr);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "UI Error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    public class VendorStat
    {
        public string VendorName { get; set; } = "";
        public decimal TotalSpent { get; set; }
        public string VendorInitial => string.IsNullOrEmpty(VendorName) ? "?" : VendorName.Substring(0, 1).ToUpper();
    }

    public class MonthlyStat
    {
        public string MonthName { get; set; } = "";
        public decimal Total { get; set; }
    }
}