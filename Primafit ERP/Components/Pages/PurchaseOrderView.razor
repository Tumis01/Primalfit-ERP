@page "/procurement/purchase-orders"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject NavigationManager Nav
@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject WarehouseService WhService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ReportExportService ReportExportService
@inject IEmailService EmailService
@inject PermissionCacheService PermissionCache
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mx-auto max-w-[1400px] space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800 pb-16">

    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div class="shrink-0">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Purchase Orders</h1>
            @if (!string.IsNullOrEmpty(companyName))
            {
                <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200 mt-2">
                    @companyName
                </span>
            }
        </div>

        <div class="flex flex-col sm:flex-row flex-wrap gap-4 items-start sm:items-center w-full lg:w-auto lg:justify-end">
            @if (activeTab == 0 || activeTab == 2)
            {
                <div class="flex flex-col xl:flex-row gap-3 items-start xl:items-center w-full sm:w-auto">
                    <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-xl border border-slate-200 w-full sm:w-auto overflow-x-auto shrink-0 scrollbar-hide h-[42px]">
                        <input type="date" @bind="filterFromDate" class="px-2 py-1.5 text-xs font-bold bg-transparent text-slate-700 outline-none w-auto sm:w-32 cursor-pointer" />
                        <span class="text-slate-400 font-bold text-xs shrink-0">-</span>
                        <input type="date" @bind="filterToDate" class="px-2 py-1.5 text-xs font-bold bg-transparent text-slate-700 outline-none w-auto sm:w-32 cursor-pointer" />
                    </div>
                    <div class="relative w-full sm:w-64 xl:w-72 h-[42px] shrink-0">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search Reference, Vendor..." class="w-full h-full pl-9 pr-4 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all" />
                    </div>
                </div>
            }

            <div class="flex bg-slate-100 p-1 rounded-xl w-full sm:w-auto shrink-0">
                <button @onclick="() => activeTab = 2" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 2 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    Requests
                </button>
                <button @onclick="() => activeTab = 0" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 0 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    All Orders
                </button>
                <PermissionGate Key="PO_CREATE">
                    <Authorized>
                        <button @onclick="CreateNew" class="flex-1 sm:flex-none px-4 py-2 rounded-lg text-sm font-bold transition-all text-center @(activeTab == 1 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                            New PO
                        </button>
                    </Authorized>
                </PermissionGate>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading purchase orders...</div>
    }
    else if (currentCompanyId != Guid.Empty)
    {
        @if (activeTab == 2)
        {
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
                <div class="p-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Purchase Requests</h3>
                </div>
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left text-sm whitespace-nowrap min-w-[1000px]">
                        <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="px-6 py-4">Request Number</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Vendor</th>
                                <th class="px-6 py-4 w-[25%]">Items (Qty)</th>
                                <th class="px-6 py-4 text-right">Total (Foreign)</th>
                                <th class="px-6 py-4 text-right border-r border-slate-100">Total (Base)</th>
                                <th class="px-6 py-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var req in PagedRequests)
                            {
                                var vendorName = vendors.FirstOrDefault(v => v.Id == req.VendorId)?.Name ?? "Unknown";

                                <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                    <td class="px-6 py-4">
                                        <div class="font-mono font-bold text-slate-900">@req.OrderNumber</div>
                                    </td>
                                    <td class="px-6 py-4 text-slate-500 font-medium">@req.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4">
                                        <div class="font-bold text-slate-800 truncate max-w-[200px]" title="@vendorName">@vendorName</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (req.Lines != null && req.Lines.Any())
                                        {
                                            <div class="space-y-1.5">
                                                @foreach (var line in req.Lines.Take(2))
                                                {
                                                    var itemName = items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown Item";
                                                    <div class="flex items-center justify-between gap-3 text-xs">
                                                        <span class="truncate text-slate-600 font-medium">@itemName</span>
                                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x@(line.QuantityOrdered.ToString("G29")))</span>
                                                    </div>
                                                }
                                                @if (req.Lines.Count > 2)
                                                {
                                                    <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-500 pt-1">+ @(req.Lines.Count - 2) more item(s)</div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="font-mono font-bold text-slate-900">@req.GrandTotalForeign.ToString("N2")</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@req.Currency?.CurrencyCode</div>
                                    </td>
                                    <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                        <div class="font-mono font-bold text-emerald-700">@((req.GrandTotalForeign * (req.ExchangeRate > 0 ? req.ExchangeRate : 1)).ToString("N2"))</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            @{
                                                bool isConverted = orders.Any(inv => inv.ConvertedFromRequestNumber == req.OrderNumber);
                                            }

                                            @if (isConverted)
                                            {
                                                <button @onclick="() => EditOrder(req)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded hover:bg-slate-100">View</button>
                                                <span class="px-3 py-1.5 text-[10px] font-bold text-slate-400 bg-slate-100 rounded border border-slate-200 uppercase tracking-wider">Converted</span>
                                            }
                                            else
                                            {
                                                <PermissionGate Key="PO_CREATE">
                                                    <Authorized>
                                                        <button @onclick="() => EditOrder(req)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded hover:bg-slate-50">Edit</button>
                                                        <button @onclick="() => ConvertRequestToOrder(req)" class="px-3 py-1.5 text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 rounded hover:bg-blue-100 shadow-sm">Make Order</button>
                                                    </Authorized>
                                                </PermissionGate>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!PagedRequests.Any())
                            {
                                <tr><td colspan="7" class="p-16 text-center text-slate-400">No requests found matching your criteria.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredRequests.Any())
                {
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                            Showing @(((currentReqPage - 1) * pageSize) + 1) to @(Math.Min(currentReqPage * pageSize, FilteredRequests.Count())) of @FilteredRequests.Count() records
                        </div>
                        <div class="flex items-center gap-2">
                            <button @onclick="() => currentReqPage--" disabled="@(currentReqPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Previous</button>
                            <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm">Page @currentReqPage of @TotalReqPages</span>
                            <button @onclick="() => currentReqPage++" disabled="@(currentReqPage >= TotalReqPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Next</button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == 0)
        {
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left text-sm whitespace-nowrap min-w-[1100px]">
                        <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="px-6 py-4">PO Number</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Vendor</th>
                                <th class="px-6 py-4 w-[25%]">Items (Qty)</th>
                                <th class="px-6 py-4 text-right">Total (Foreign)</th>
                                <th class="px-6 py-4 text-right border-l border-slate-200">Total (Base)</th>
                                <th class="px-6 py-4 text-center">Status</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var po in PagedOrders)
                            {
                                var vendorName = vendors.FirstOrDefault(v => v.Id == po.VendorId)?.Name ?? "Unknown";

                                <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                    <td class="px-6 py-4">
                                        <div class="font-mono font-bold text-slate-900">@po.OrderNumber</div>
                                        @if (!string.IsNullOrEmpty(po.ConvertedFromRequestNumber))
                                        {
                                            <div class="text-[9px] text-slate-400 font-mono mt-1">From: @po.ConvertedFromRequestNumber</div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-slate-500 font-medium">@po.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4">
                                        <div class="font-bold text-slate-800 truncate max-w-[200px]" title="@vendorName">@vendorName</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (po.Lines != null && po.Lines.Any())
                                        {
                                            <div class="space-y-1.5">
                                                @foreach (var line in po.Lines.Take(2))
                                                {
                                                    var itemName = items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown Item";
                                                    <div class="flex items-center justify-between gap-3 text-xs">
                                                        <span class="truncate text-slate-600 font-medium">@itemName</span>
                                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x@(line.QuantityOrdered.ToString("G29")))</span>
                                                    </div>
                                                }
                                                @if (po.Lines.Count > 2)
                                                {
                                                    <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-500 pt-1">+ @(po.Lines.Count - 2) more item(s)</div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="font-mono font-bold text-slate-900">@po.GrandTotalForeign.ToString("N2")</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@po.Currency?.CurrencyCode</div>
                                    </td>
                                    <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                        <div class="font-mono font-bold text-emerald-700">@((po.GrandTotalForeign * (po.ExchangeRate > 0 ? po.ExchangeRate : 1)).ToString("N2"))</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (po.IsFullyPaid)
                                        {
                                            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Paid</span>
                                        }
                                        else if (po.IsInvoicePosted)
                                        {
                                            <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Invoiced</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">Open</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            @if (po.Status == PurchaseOrderStatus.Open && !po.HasReceipt)
                                            {
                                                <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">Edit</button>
                                                <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")' class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors shadow-sm">Receive Goods</button>
                                            }
                                            else
                                            {
                                                <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors">View</button>
                                                @if (!po.IsFullyReceived)
                                                {
                                                    <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")' class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors shadow-sm">Receive Goods</button>
                                                }
                                                @if (!po.IsInvoicePosted && po.HasReceipt)
                                                {
                                                    <PermissionGate Key="PO_INVOICE_POST">
                                                        <Authorized>
                                                            <button @onclick="() => AutoPostInvoice(po)" disabled="@(isPostingId == po.Id)" class="px-3 py-1.5 text-xs font-bold text-white bg-indigo-600 border border-indigo-700 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                                                                @(isPostingId == po.Id ? "Posting..." : "Post Invoice")
                                                            </button>
                                                        </Authorized>
                                                    </PermissionGate>
                                                }
                                                else if (po.IsInvoicePosted && !po.IsFullyPaid)
                                                {
                                                    <PermissionGate Key="PAYMENT_CREATE">
                                                        <Authorized>
                                                            <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={po.Id}")' class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-lg hover:bg-indigo-100 transition-colors shadow-sm">Make Payment</button>
                                                        </Authorized>
                                                    </PermissionGate>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!PagedOrders.Any())
                            {
                                <tr><td colspan="8" class="p-16 text-center text-slate-400">No orders found matching your criteria.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredOrders.Any())
                {
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                            Showing @(((currentOrderPage - 1) * pageSize) + 1) to @(Math.Min(currentOrderPage * pageSize, FilteredOrders.Count())) of @FilteredOrders.Count() records
                        </div>
                        <div class="flex items-center gap-2">
                            <button @onclick="() => currentOrderPage--" disabled="@(currentOrderPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Previous</button>
                            <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm">Page @currentOrderPage of @TotalOrderPages</span>
                            <button @onclick="() => currentOrderPage++" disabled="@(currentOrderPage >= TotalOrderPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed shadow-sm">Next</button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl animate-in fade-in slide-in-from-bottom-4 overflow-visible flex flex-col h-full">

                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <div class="flex items-center gap-4">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Purchase Details</h3>
                        @if (!string.IsNullOrEmpty(currentOrder.OrderNumber))
                        {
                            <span class="px-2 py-0.5 bg-slate-200 text-slate-700 font-mono text-xs rounded font-bold">@currentOrder.OrderNumber</span>
                        }
                    </div>

                    @if (!IsLocked)
                    {
                        <div class="flex items-center gap-2 bg-white p-1 rounded-xl border border-slate-200 shadow-sm">
                            <button type="button" @onclick="() => SetStatusType(PurchaseOrderStatus.Request)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status == PurchaseOrderStatus.Request ? "bg-indigo-50 text-indigo-700 ring-1 ring-indigo-200" : "text-slate-500 hover:bg-slate-50")">
                                Request (Draft)
                            </button>
                            <button type="button" @onclick="() => SetStatusType(PurchaseOrderStatus.Open)" class="px-4 py-1.5 rounded-lg text-xs font-bold transition-colors @(currentOrder.Status != PurchaseOrderStatus.Request ? "bg-blue-50 text-blue-700 ring-1 ring-blue-200" : "text-slate-500 hover:bg-slate-50")">
                                Purchase Order
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 ring-slate-200 ring-1 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            Locked (Received/Invoiced)
                        </div>
                    }
                </div>

                <div class="p-6 sm:p-8">

                    <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 mb-6 shadow-sm">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                            <div>
                                <label class="label">Vendor</label>
                                <select value="@currentOrder.VendorId" @onchange="OnVendorChanged" class="input-class font-bold text-slate-800 border-indigo-200 bg-white" disabled="@IsLocked">
                                    <option value="@Guid.Empty">-- Select Vendor --</option>
                                    @foreach (var v in vendors)
                                    {
                                        <option value="@v.Id">@v.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="label">Order Date</label>
                                <input type="date" @bind="currentOrder.OrderDate" class="input-class bg-white" disabled="@IsLocked" />
                            </div>

                            <div>
                                <label class="label text-indigo-700">Currency & Rate</label>
                                <div class="flex items-center gap-2">
                                    <!-- Set a fixed width (w-20 or w-24) so it doesn't compress or expand unnecessarily -->
                                    <select value="@currentOrder.CurrencyId" class="input-class w-24 shrink-0 bg-slate-200 text-slate-500 font-bold cursor-not-allowed px-2 text-center" disabled>
                                        <option value="@Guid.Empty">N/A</option>
                                        @foreach (var c in currencies)
                                        {
                                            <option value="@c.Id">@c.CurrencyCode</option>
                                        }
                                    </select>
                                    <!-- Use flex-1 so the input naturally fills the rest of the available space -->
                                    <div class="relative flex-1">
                                        <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">x</span>
                                        <input type="number" step="0.01" @bind="currentOrder.ExchangeRate"
                                               @bind:after="RecalculatePrices"
                                               class="input-class w-full pl-6 pr-2 text-right font-mono font-bold text-indigo-700 border-indigo-200 focus:border-indigo-500 bg-white" disabled="@IsLocked" />
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="label">Tax / VAT</label>
                                <select value="@currentOrder.TaxId" @onchange="OnTaxChanged" class="input-class bg-white" disabled="@IsLocked">
                                    <option value="">No Tax</option>
                                    @foreach (var t in taxes)
                                    {
                                        <option value="@t.Id">@t.TaxName (@t.Per%)</option>
                                    }
                                </select>
                            </div>

                            @if (currentOrder.TaxId != null && !IsLocked)
                            {
                                <div class=" hidden lg:col-span-2 animate-in fade-in slide-in-from-left-2">
                                    <SearchableGlAccount Label="Tax GL Account (Asset/Input)"
                                                         Placeholder="Search Tax GL..."
                                                         Accounts="@taxAccounts"
                                                         @bind-Value="SelectedTaxGlAccountId"
                                                         IsInvalid="@(currentOrder.TaxGLAccountId == null || currentOrder.TaxGLAccountId == Guid.Empty)" />
                                </div>
                            }
                            else if (currentOrder.TaxId != null && IsLocked)
                            {
                                <div class=" hidden lg:col-span-2">
                                    <label class="label text-slate-600">Tax GL Account (Asset/Input)</label>
                                    <div class="text-xs text-slate-500 font-bold bg-white p-3 rounded-lg border border-slate-200 shadow-sm">
                                        @(taxAccounts.FirstOrDefault(a => a.Id == currentOrder.TaxGLAccountId)?.Description ?? "Unknown")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-xl overflow-visible mb-6 shadow-sm">
                        <div class="relative overflow-visible">
                            <table class="w-full text-sm text-left overflow-visible">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-[40%]">Item</th>
                                        <th class="p-3 w-[15%] text-center">Qty</th>
                                        <th class="p-3 w-[20%] text-right">Unit Cost (@currencySymbol)</th>
                                        <th class="p-3 w-[20%] text-right pr-4">Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 min-h-[150px] overflow-visible">
                                    @foreach (var line in currentOrder.Lines)
                                    {
                                        var isService = items.FirstOrDefault(i => i.Id == line.ItemId)?.IsService ?? false;

                                        <tr class="relative group hover:bg-slate-50 transition-colors overflow-visible">
                                            <td class="p-2 pl-4 align-top overflow-visible z-50">
                                                @if (IsLocked)
                                                {
                                                    <div class="p-2 font-bold text-slate-700 bg-slate-50 rounded-lg border border-slate-200">
                                                        @(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <SearchableItem Label="" Items="@items" @bind-Value="line.ItemId" OnSelectionChanged="@(() => UpdateLineItem(line))" IsInvalid="@(line.ItemId == Guid.Empty)" />
                                                    @if (isService)
                                                    {
                                                        <div class="mt-1 text-[10px] text-indigo-600 font-bold uppercase tracking-wider flex items-center gap-1">
                                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                            Service Item
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td class="p-2 align-top pt-3 text-center">
                                                @if (isService)
                                                {
                                                    <input type="number" value="1" class="input-class py-2 text-center font-bold bg-slate-100 text-slate-500 cursor-not-allowed border-slate-200" readonly disabled />
                                                }
                                                else
                                                {
                                                    <input type="number" @bind="line.QuantityOrdered" class="input-class py-2 text-center font-bold" placeholder="1" disabled="@IsLocked" />
                                                }
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.01" @bind="line.UnitCost" class="input-class py-2 text-right font-mono @(IsLocked ? "bg-slate-100 text-slate-500 cursor-not-allowed border-slate-200" : "")" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-4 text-right font-mono font-bold text-slate-700">
                                                @((line.QuantityOrdered * line.UnitCost).ToString("N2"))
                                            </td>
                                            <td class="p-2 text-center align-top pt-4">
                                                @if (!IsLocked)
                                                {
                                                    <button type="button" @onclick="() => currentOrder.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600 opacity-0 group-hover:opacity-100">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!IsLocked)
                        {
                            <div class="p-2 bg-slate-50 border-t border-slate-200">
                                <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Line Item
                                </button>
                            </div>
                        }
                    </div>

                    <div class="flex flex-col md:flex-row justify-between items-start gap-6">

                        <div class="w-full md:w-1/2 p-5 border border-emerald-100 rounded-xl shadow-sm">
                            <h4 class="font-extrabold text-xs uppercase tracking-wider text-emerald-800 mb-4 flex items-center gap-2">
                                Discount Received
                            </h4>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="label text-[10px]">Percentage (%)</label>
                                    <input type="number" @bind="currentOrder.DiscountPercentage"
                                           @bind:after="() => { if (currentOrder.DiscountPercentage > 0) currentOrder.DiscountAmount = 0; }"
                                           class="input-class text-center font-bold text-emerald-700 border-emerald-200 focus:border-emerald-500" disabled="@IsLocked" />
                                </div>
                                <div>
                                    <label class="label text-[10px]">Flat Amount (@currencySymbol)</label>
                                    <input type="number" @bind="currentOrder.DiscountAmount"
                                           @bind:after="() => { if (currentOrder.DiscountAmount > 0) currentOrder.DiscountPercentage = 0; }"
                                           class="input-class text-right font-mono border-emerald-200 focus:border-emerald-500" disabled="@IsLocked" />
                                </div>
                            </div>

                        </div>
                        <div class="space-y-2 text-sm text-slate-600 w-full md:w-80 bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm">
                            <div class="flex justify-between">
                                <span>Subtotal:</span>
                                <span class="font-mono font-bold">@SubTotal.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between items-center text-emerald-600 border-b border-slate-200 pb-2">
                                <span>Discount:</span>
                                <span class="font-mono font-bold">- @DiscountValue.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between items-center pt-1">
                                <span>Net Subtotal:</span>
                                <span class="font-mono font-bold">@DiscountedSubTotal.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span>Tax (@TaxPercentage%):</span>
                                <span class="font-mono font-bold">+ @TaxAmount.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                <span class="font-bold">Total (@currencySymbol):</span>
                                <span class="font-mono font-black text-indigo-700 text-2xl">@GrandTotalForeign.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between text-[10px] text-slate-400 mt-1 uppercase font-bold tracking-wider">
                                <span>Ledger Base Value:</span>
                                <span class="font-mono text-slate-500">@GrandTotalBase.ToString("N2")</span>
                            </div>
                        </div>

                    </div>

                    <div class="flex items-center justify-end gap-3 mt-8 pt-5 border-t border-slate-200">
                        @if (currentOrder.Id != Guid.Empty && currentOrder.Status != PurchaseOrderStatus.Request)
                        {
                            <button type="button" @onclick="DownloadPO" disabled="@isExporting" class="px-6 py-2.5 rounded-xl border border-emerald-200 text-emerald-700 bg-emerald-50 font-bold text-sm hover:bg-emerald-100 transition-colors flex items-center gap-2 disabled:opacity-50 shadow-sm mr-auto">
                                @if (isExporting)
                                {
                                    <span class="animate-spin">↻</span>
                                }
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                Download PO
                            </button>
                        }

                        @if (!IsLocked)
                        {
                            <PermissionGate Key="PO_CREATE">
                                <Authorized>
                                    <button type="button" @onclick="TerminateOrder" class="px-5 py-2.5 rounded-xl border border-rose-200 text-rose-600 font-bold text-sm hover:bg-rose-50 transition-colors">
                                        Delete
                                    </button>
                                </Authorized>
                            </PermissionGate>

                            <button type="button" @onclick="() => activeTab = 0" class="px-6 py-2.5 rounded-xl font-bold text-slate-500 hover:bg-slate-100 transition-colors">
                                Cancel
                            </button>

                            <PermissionGate Key="PO_CREATE">
                                <Authorized>
                                    <button type="button" @onclick="SaveOrder" class="px-8 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50" disabled="@isBusy">
                                        @if (isBusy)
                                        {
                                            <span class="animate-spin">↻</span>
                                        }
                                        @(currentOrder.Status == PurchaseOrderStatus.Request ? "Save Request" : "Save Purchase Order")
                                    </button>
                                </Authorized>
                            </PermissionGate>
                        }
                        else
                        {
                            <button type="button" @onclick="() => activeTab = 0" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md">
                                Close View
                            </button>
                        }
                    </div>

                </div>
            </div>
        }
    }
</div>

