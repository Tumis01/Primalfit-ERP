@page "/procurement/purchase-orders"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Nav
@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Purchase Orders</h1>
            <p class="text-sm text-slate-500">Create commitments and track procurement.</p>
            
        </div>
        <button @onclick="CreateNew" class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800 transition-all flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>New Order</span>
        </button>
    </div>

    @if (currentCompanyId == Guid.Empty)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r">
            <p class="text-sm text-red-700 font-bold">⚠️ CRITICAL: No Company ID Loaded. Orders cannot be processed.</p>
        </div>
    }

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse">Loading orders...</div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-100">
                    <tr>
                        <th class="p-4">PO Number</th>
                        <th class="p-4">Date</th>
                        <th class="p-4">Vendor</th>
                        <th class="p-4 text-right">Total Value(Vendor's Currency) </th>
                        <th class="p-4 text-right">Base Value</th>
                        <th class="p-4 text-center">Status</th>
                        <th class="p-4 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var po in orders)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="p-4 font-mono font-bold text-slate-700">@po.OrderNumber</td>
                            <td class="p-4 text-slate-500">@po.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td class="p-4 font-medium text-slate-900">
                                @(vendors.FirstOrDefault(v => v.Id == po.VendorId)?.Name ?? "Unknown")
                            </td>

                            @* Foreign Total *@
                            <td class="p-4 text-right font-mono font-bold text-slate-700">
                                @(po.Lines.Sum(l => l.QuantityOrdered * l.UnitCost).ToString("N2"))
                            </td>

                            @* Base Total (Calculated) *@
                            <td class="p-4 text-right font-mono text-emerald-600 text-xs">
                                @((po.Lines.Sum(l => l.QuantityOrdered * l.UnitCost) * po.ExchangeRate).ToString("N2"))
                            </td>

                            <td class="p-4 text-center">
                                @if (po.IsInvoicePosted)
                                {
                                    <span class="px-2 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold">Posted</span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold">Open</span>
                                }
                            </td>


                            <td class="p-4 text-center flex justify-center gap-3">

                                @* 1) OPEN + NOT RECEIVED: can edit + receive *@
                                @if (po.Status == PurchaseOrderStatus.Open && !po.HasReceipt)
                                {
                                    <button @onclick="() => EditOrder(po)" class="text-slate-400 hover:text-indigo-600 font-bold text-xs flex items-center gap-1">
                                        Edit
                                    </button>

                                    <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")'
                                            class="text-emerald-600 hover:text-emerald-800 font-bold text-xs flex items-center gap-1 bg-emerald-50 px-2 py-1 rounded border border-emerald-100">
                                        Receive
                                    </button>
                                }
                                @* 2) OPEN + RECEIVED: disable receive, show post invoice *@
                                else if (po.Status == PurchaseOrderStatus.Open && po.HasReceipt && !po.IsInvoicePosted)
                                {
                                    <span class="text-xs font-bold bg-slate-100 text-slate-600 px-2 py-1 rounded border">
                                        Received
                                    </span>

                                    <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={po.Id}")'
                                            class="text-indigo-600 hover:text-indigo-800 font-bold text-xs flex items-center gap-1 bg-indigo-50 px-2 py-1 rounded border border-indigo-100">
                                        Post Invoice
                                    </button>
                                }
                                @* 3) INVOICE POSTED: still listed, no edit *@
                                else
                                {
                                    <span class="text-xs font-bold bg-green-50 text-green-700 px-2 py-1 rounded border border-green-100">
                                        Invoice Posted
                                    </span>
                                }

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (showModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 overflow-y-auto">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl p-6 my-8 animate-in zoom-in-95 duration-200">

                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h3 class="text-xl font-bold text-slate-900">@((currentOrder.Id == Guid.Empty) ? "New Purchase Order" : "Edit Purchase Order")</h3>
                        @if (!string.IsNullOrEmpty(selectedCurrencyCode))
                        {
                            <div class="text-xs text-indigo-600 font-bold mt-1 flex items-center gap-1">
                                <span>Currency: @selectedCurrencyCode</span>
                                <span class="text-slate-400">|</span>
                                <span class="text-slate-500 font-normal">Rate Locked: @currentOrder.ExchangeRate.ToString("N4")</span>
                            </div>
                        }
                    </div>
                    <button @onclick="() => showModal = false" class="text-slate-400 hover:text-slate-600">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                    <div>
                        <label class="label">Vendor</label>
                        <select value="@currentOrder.VendorId" @onchange="OnVendorChanged" class="input-class">
                            <option value="@Guid.Empty">-- Select Vendor --</option>
                            @foreach (var v in vendors)
                            {
                                <option value="@v.Id">@v.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="label">Order Date</label>
                        <input type="date" @bind="currentOrder.OrderDate" class="input-class" />
                    </div>
                    <div>
                        <label class="label">Order Number</label>
                        <input @bind="currentOrder.OrderNumber" class="input-class bg-slate-50 font-mono" readonly />
                    </div>
                </div>

                <div class="border-t border-slate-100 pt-4">
                    <div class="flex justify-between items-center mb-4">
                        <h4 class="font-bold text-slate-700">Order Lines</h4>
                        <button @onclick="AddLine" class="text-xs font-bold text-indigo-600 border border-indigo-200 px-3 py-1 rounded hover:bg-indigo-50">
                            + Add Item
                        </button>
                    </div>

                    <table class="w-full text-sm text-left">
                        <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500">
                            <tr>
                                <th class="p-3 w-[40%]">Item</th>
                                <th class="p-3 text-right w-[15%]">Qty</th>
                                <th class="p-3 text-right w-[20%]">Unit Cost</th>
                                <th class="p-3 text-right w-[20%]">Total</th>
                                <th class="p-3 w-[5%]"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var line in currentOrder.Lines)
                            {
                                <tr>
                                    <td class="p-2">
                                        <SearchableItem Label="" Items="@items" @bind-Value="line.ItemId" />
                                    </td>
                                    <td class="p-2">
                                        <input type="number" @bind="line.QuantityOrdered" class="input-class text-right font-bold" />
                                    </td>
                                    <td class="p-2">
                                        <input type="number" @bind="line.UnitCost" class="input-class text-right font-mono" />
                                    </td>
                                    <td class="p-2 text-right font-bold text-slate-700">
                                        @((line.QuantityOrdered * line.UnitCost).ToString("N2"))
                                    </td>
                                    <td class="p-2 text-center">
                                        <button @onclick="() => currentOrder.Lines.Remove(line)" class="text-red-400 hover:text-red-600 font-bold text-lg">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-slate-50 border-t border-slate-200">
                            <tr>
                                <td colspan="3" class="p-3 text-right font-bold text-slate-500 uppercase text-xs">
                                    Total (@(string.IsNullOrEmpty(selectedCurrencyCode) ? "N/A" : selectedCurrencyCode))
                                </td>
                                <td class="p-3 text-right font-bold text-lg text-slate-900">
                                    @VendorTotal.ToString("N2")
                                </td>
                                <td></td>
                            </tr>
                            <tr>
                                <td colspan="3" class="p-2 text-right font-bold text-emerald-600 uppercase text-[10px]">
                                    Total Amount (Base)
                                </td>
                                <td class="p-2 text-right font-mono font-bold text-emerald-700 text-sm">
                                    @BaseTotal.ToString("N2")
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="flex justify-end gap-3 mt-8 pt-4 border-t border-slate-100">
                    <button @onclick="() => showModal = false" class="px-4 py-2 text-slate-500 font-bold hover:bg-slate-50 rounded-lg">Cancel</button>
                    <button @onclick="SaveOrder" disabled="@isBusy" class="px-6 py-2 bg-slate-900 text-white font-bold rounded-lg shadow-lg hover:bg-slate-800 disabled:opacity-50 flex items-center gap-2">
                        @if (isBusy)
                        {
                            <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Order</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.5rem;
        font-size: 0.875rem;
        outline: none;
        transition: border-color 0.2s;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.1);
        }
</style>

@code {
    private List<PurchaseOrder> orders = new();
    private List<Vendor> vendors = new();
    private List<Item> items = new();
    private PurchaseOrder currentOrder = new();

    private bool isLoading = true;
    private bool showModal = false;
    private bool isBusy = false;
    private Guid currentCompanyId;
    private string selectedCurrencyCode = "";

    private decimal VendorTotal => currentOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
    private decimal BaseTotal => VendorTotal * currentOrder.ExchangeRate;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        orders = await PurchService.GetPOsAsync(currentCompanyId);
        vendors = await MasterService.GetVendorsAsync(currentCompanyId);
        items = await MasterService.GetItemsAsync(currentCompanyId);
    }

    private void CreateNew()
    {
        currentOrder = new PurchaseOrder
        {
            CompanyId = currentCompanyId,
            OrderNumber = $"PO-{DateTime.Now:yyMM}-{new Random().Next(1000, 9999)}",
            Lines = new List<PurchaseOrderLine> { new() },
            ExchangeRate = 1
        };
        selectedCurrencyCode = "";
        showModal = true;
    }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid vendorId))
        {
            currentOrder.VendorId = vendorId;
            var result = await PurchService.GetVendorCurrencyDataAsync(vendorId, currentCompanyId);

            currentOrder.CurrencyId = result.CurrencyId;
            currentOrder.ExchangeRate = result.Rate;
            selectedCurrencyCode = result.CurrencyCode;
        }
    }

    private async Task EditOrder(PurchaseOrder po)
    {
        var result = await PurchService.GetVendorCurrencyDataAsync(po.VendorId, currentCompanyId);
        selectedCurrencyCode = result.CurrencyCode;

        currentOrder = new PurchaseOrder
        {
            Id = po.Id,
            CompanyId = po.CompanyId,
            VendorId = po.VendorId,
            OrderDate = po.OrderDate,
            OrderNumber = po.OrderNumber,
            Status = po.Status,
            CurrencyId = po.CurrencyId,
            ExchangeRate = po.ExchangeRate,
            Lines = po.Lines.Select(l => new PurchaseOrderLine
            {
                Id = l.Id,
                ItemId = l.ItemId,
                QuantityOrdered = l.QuantityOrdered,
                UnitCost = l.UnitCost
            }).ToList()
        };
        showModal = true;
    }

    private void AddLine() => currentOrder.Lines.Add(new PurchaseOrderLine());

    private async Task SaveOrder()
    {
        isBusy = true;
        try
        {
            if (currentOrder.CurrencyId == Guid.Empty && currentOrder.VendorId != Guid.Empty)
            {
                var result = await PurchService.GetVendorCurrencyDataAsync(currentOrder.VendorId, currentCompanyId);
                currentOrder.CurrencyId = result.CurrencyId;
                currentOrder.ExchangeRate = result.Rate;
            }

            string resultStr = await PurchService.SavePurchaseOrderAsync(currentOrder);

            if (string.IsNullOrEmpty(resultStr))
            {
                await JS.InvokeVoidAsync("alert", "✅ Order Saved Successfully!");
                showModal = false;
                await LoadData();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "❌ " + resultStr);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "UI Error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}