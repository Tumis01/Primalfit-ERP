@code {
    private string companyName = "";
    private Guid currentCompanyId = Guid.Empty;
    private bool isLoading = true;
    private int activeTab = 2;

    private record BatchSummary(BatchStatus Status, string? RejectionReason);
    private Dictionary<Guid, BatchSummary> batchMap = new();
    private BatchSummary? CurrentOrderBatchInfo => currentOrder.GLBatchId.HasValue && batchMap.TryGetValue(currentOrder.GLBatchId.Value, out var batch) ? batch : null;
    private bool IsCurrentOrderRejected => CurrentOrderBatchInfo?.Status == BatchStatus.Rejected;
    private string? CurrentOrderRejectionReason => CurrentOrderBatchInfo?.RejectionReason;

    private bool IsReviewEditable => CurrentOrderBatchInfo?.Status is BatchStatus.Ready or BatchStatus.Rejected or BatchStatus.Draft;

    private bool IsLocked =>
        !IsReviewEditable && (((currentOrder.HasReceipt || currentOrder.IsFullyReceived) && !IsCurrentOrderRejected) ||
        (currentOrder.IsInvoicePosted && !IsCurrentOrderRejected) ||
        (currentOrder.Status == PurchaseOrderStatus.Invoiced && !IsCurrentOrderRejected) ||
        (currentOrder.Status == PurchaseOrderStatus.Request && orders.Any(o => o.ConvertedFromRequestNumber == currentOrder.OrderNumber)) ||
        (currentOrder.Status == PurchaseOrderStatus.Open && orders.Any(o => o.ConvertedFromPONumber == currentOrder.OrderNumber)));

    private int pageSize = 15;
    private int currentOrderPage = 1;
    private int currentReqPage = 1;
    private int currentInvPage = 1;

    private string _searchTerm = "";
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; ResetPaginationMatrices(); }
    }

    private DateTime _filterFromDate = DateTime.Today.AddDays(-365);
    private DateTime filterFromDate
    {
        get => _filterFromDate;
        set { _filterFromDate = value; ResetPaginationMatrices(); }
    }

    private DateTime _filterToDate = DateTime.Today;
    private DateTime filterToDate
    {
        get => _filterToDate;
        set { _filterToDate = value; ResetPaginationMatrices(); }
    }

    private List<PurchaseOrder> orders = new();
    private PurchaseOrder currentOrder = new();
    private List<Vendor> vendors = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<Warehouse> warehouses = new();
    private List<Tax> taxes = new();

    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> liabilityAccounts = new();
    private List<SegChartOfAccount> taxAccounts = new();
    private List<SegChartOfAccount> discountAccounts = new();
    private List<SegAccountType> accountTypes = new();

    // Route Configuration Modal State
    private bool showRouteModal = false;
    private List<CustomTransactionType> customTemplates = new();
    private Guid defaultApAccountId = Guid.Empty;
    private Guid defaultGrIrAccountId = Guid.Empty;
    private Guid defaultDiscountAccountId = Guid.Empty;

    private string currencySymbol = "";
    private string companyBaseCurrency = "BASE";
    private string selectedCurrencyCode = "";
    private Guid isPostingId = Guid.Empty;
    private bool isBusy = false;
    private bool isExporting = false;

    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private Guid emailTargetPoId = Guid.Empty;
    private string emailVendorName = "";
    private string emailVendorAddress = "";
    private string emailSubject = "";
    private string customEmailMessage = "";

    private decimal SubTotal => currentOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
    private decimal DiscountValue => currentOrder.DiscountPercentage > 0 ? SubTotal * (currentOrder.DiscountPercentage / 100) : currentOrder.DiscountAmount;
    private decimal DiscountedSubTotal => SubTotal - DiscountValue;
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == currentOrder.TaxId)?.Per ?? 0;
    private decimal TaxAmount => DiscountedSubTotal * (TaxPercentage / 100);
    private decimal GrandTotalForeign => DiscountedSubTotal + TaxAmount;
    private decimal GrandTotalBase => currentOrder.ExchangeRate == 0 ? 0 : GrandTotalForeign * currentOrder.ExchangeRate;
    private Dictionary<Guid, VendorBill> linkedBillsMap = new();
    private Dictionary<Guid, decimal> debitNotesMap = new();
    private bool canConfigureRoute = false;

    private IEnumerable<PurchaseOrder> FilteredRequests => orders
        .Where(o => o.OrderNumber.StartsWith("REQ", StringComparison.OrdinalIgnoreCase))
        .Where(o => o.OrderDate.Date >= filterFromDate.Date && o.OrderDate.Date <= filterToDate.Date)
        .Where(o => string.IsNullOrWhiteSpace(searchTerm)
                 || o.OrderNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                 || vendors.FirstOrDefault(v => v.Id == o.VendorId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
        .OrderByDescending(o => o.OrderDate);

    private int TotalReqPages => Math.Max(1, (int)Math.Ceiling(FilteredRequests.Count() / (double)pageSize));
    private IEnumerable<PurchaseOrder> PagedRequests => FilteredRequests.Skip((currentReqPage - 1) * pageSize).Take(pageSize);

    private IEnumerable<PurchaseOrder> FilteredOrders => orders
        .Where(o => o.OrderNumber.StartsWith("PO", StringComparison.OrdinalIgnoreCase))
        .Where(o => o.OrderDate.Date >= filterFromDate.Date && o.OrderDate.Date <= filterToDate.Date)
        .Where(o => string.IsNullOrWhiteSpace(searchTerm)
                 || o.OrderNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                 || vendors.FirstOrDefault(v => v.Id == o.VendorId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
                 || o.Lines.Any(l => items.FirstOrDefault(i => i.Id == l.ItemId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true))
        .OrderByDescending(o => o.OrderDate);

    private int TotalOrderPages => Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count() / (double)pageSize));
    private IEnumerable<PurchaseOrder> PagedOrders => FilteredOrders.Skip((currentOrderPage - 1) * pageSize).Take(pageSize);

    private IEnumerable<PurchaseOrder> FilteredInvoices => orders
        .Where(o => o.OrderNumber.StartsWith("INV", StringComparison.OrdinalIgnoreCase))
        .Where(o => o.OrderDate.Date >= filterFromDate.Date && o.OrderDate.Date <= filterToDate.Date)
        .Where(o => string.IsNullOrWhiteSpace(searchTerm)
                 || o.OrderNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                 || vendors.FirstOrDefault(v => v.Id == o.VendorId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
        .OrderByDescending(o => o.OrderDate);

    private int TotalInvPages => Math.Max(1, (int)Math.Ceiling(FilteredInvoices.Count() / (double)pageSize));
    private IEnumerable<PurchaseOrder> PagedInvoices => FilteredInvoices.Skip((currentInvPage - 1) * pageSize).Take(pageSize);

    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("PURCHASING_PAGE")) { Nav.NavigateTo("/access-denied"); return; }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            currentCompanyId = user.CompanyDetailsId.Value;
            canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(currentCompanyId);
            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null)
            {
                companyName = company.CompanyName;
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }
            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        vendors = await MasterService.GetVendorsAsync(currentCompanyId);
        currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);
        items = await MasterService.GetItemsAsync(currentCompanyId);
        warehouses = await WhService.GetWarehousesAsync(currentCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == currentCompanyId).ToListAsync();

        var rawOrders = await PurchService.GetPOsAsync(currentCompanyId);
        foreach (var po in rawOrders)
        {
            decimal st = po.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
            decimal disc = po.DiscountPercentage > 0 ? st * (po.DiscountPercentage / 100) : po.DiscountAmount;
            decimal net = st - disc;
            decimal txAmount = 0;
            if (po.TaxId.HasValue)
            {
                var taxObj = taxes.FirstOrDefault(t => t.Id == po.TaxId);
                if (taxObj != null) txAmount = net * (taxObj.Per / 100);
            }
            po.GrandTotalForeign = net + txAmount;
        }
        orders = rawOrders;
        var batchIds = orders.Where(o => o.GLBatchId.HasValue).Select(o => o.GLBatchId!.Value).Distinct().ToList();
        var batchRows = await ctx.GLBatches.AsNoTracking()
            .Where(b => b.CompanyId == currentCompanyId && batchIds.Contains(b.Id))
            .Select(b => new { b.Id, b.Status, b.RejectionReason })
            .ToListAsync();
        batchMap = batchRows.ToDictionary(b => b.Id, b => new BatchSummary(b.Status, b.RejectionReason));

        accountTypes = await SegCoaService.GetAccountTypesAsync();
        allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

        liabilityAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        taxAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        discountAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == false && type.IsDebit == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        defaultGrIrAccountId = await MappingService.GetMappedAccountAsync(
            currentCompanyId, SystemTransactionType.GoodsReceipt, isDebit: false, defaultAccountId: Guid.Empty);

        defaultDiscountAccountId = await MappingService.GetMappedAccountAsync(
            currentCompanyId, SystemTransactionType.DiscountReceived, isDebit: false, defaultAccountId: Guid.Empty);

        using var billingCtx = await DbFactory.CreateDbContextAsync();

        // 1. Fetch Posted Bills (Cash Outflows)
        var postedBills = await billingCtx.VendorBills
            .Include(b => b.Payments)
            .Where(b => b.CompanyId == currentCompanyId && b.PurchaseOrderId != null && b.IsPosted)
            .ToListAsync();

        linkedBillsMap = postedBills
            .GroupBy(b => b.PurchaseOrderId!.Value)
            .ToDictionary(g => g.Key, g => g.First());

        // 2. Fetch all Posted Debit Notes directly from DebitNotes table by Invoice ID
        var postedDebitNotes = await billingCtx.DebitNotes
            .AsNoTracking()
            .Where(d => d.CompanyId == currentCompanyId && d.PurchaseOrderId != null && d.Status == DebitNoteStatus.Posted)
            .ToListAsync();

        debitNotesMap = postedDebitNotes
            .GroupBy(d => d.PurchaseOrderId!.Value)
            .ToDictionary(
                g => g.Key,
                g => g.Sum(d => Math.Round(d.TotalAmount * (d.ExchangeRate > 0 ? d.ExchangeRate : 1.0m), 2))
            );
    }

    private void SetActiveTab(int index) { activeTab = index; ResetPaginationMatrices(); }
    private void ResetPaginationMatrices() { currentOrderPage = 1; currentReqPage = 1; currentInvPage = 1; }

    private void CreateNew()
    {
        currentOrder = new PurchaseOrder { CompanyId = currentCompanyId, OrderDate = DateTime.Today, ExchangeRate = 1, Status = PurchaseOrderStatus.Request };
        currencySymbol = "";
        selectedCurrencyCode = "";
        currentOrder.Lines.Add(new PurchaseOrderLine());
        activeTab = 1;
    }

    private void CreateNewInvoice()
    {
        currentOrder = new PurchaseOrder
        {
            CompanyId = currentCompanyId,
            OrderDate = DateTime.Today,
            ExchangeRate = 1,
            Status = PurchaseOrderStatus.DraftInvoice
        };
        currencySymbol = "";
        selectedCurrencyCode = "";
        currentOrder.Lines.Add(new PurchaseOrderLine());
        activeTab = 1;
    }

    private void SetStatusType(PurchaseOrderStatus status) => currentOrder.Status = status;

    private async Task EditOrder(PurchaseOrder po)
    {
        var result = await PurchService.GetVendorCurrencyDataAsync(po.VendorId, currentCompanyId);
        currencySymbol = result.CurrencyCode;
        selectedCurrencyCode = result.CurrencyCode;

        var vendor = vendors.FirstOrDefault(v => v.Id == po.VendorId);
        defaultApAccountId = vendor?.PayablesAccountId ?? Guid.Empty;

        currentOrder = new PurchaseOrder
        {
            Id = po.Id,
            CompanyId = po.CompanyId,
            GLBatchId = po.GLBatchId,
            VendorId = po.VendorId,
            OrderDate = po.OrderDate,
            OrderNumber = po.OrderNumber,
            ConvertedFromRequestNumber = po.ConvertedFromRequestNumber,
            ConvertedFromPONumber = po.ConvertedFromPONumber,
            Status = po.Status,
            CurrencyId = po.CurrencyId,
            ExchangeRate = po.ExchangeRate,
            TaxId = po.TaxId,
            TaxGLAccountId = po.TaxGLAccountId,
            DiscountAmount = po.DiscountAmount,
            DiscountPercentage = po.DiscountPercentage,
            DiscountGlAccountId = po.DiscountGlAccountId,
            CustomTransactionTypeId = po.CustomTransactionTypeId,
            AccountsPayableGlAccountId = po.AccountsPayableGlAccountId,
            GoodsReceiptClearingGlAccountId = po.GoodsReceiptClearingGlAccountId,
            HasReceipt = po.HasReceipt,
            IsInvoicePosted = po.IsInvoicePosted,
            IsFullyPaid = po.IsFullyPaid,
            IsFullyReceived = po.IsFullyReceived,
            Lines = po.Lines.Select(l => new PurchaseOrderLine
            {
                Id = l.Id,
                PurchaseOrderId = po.Id,
                ItemId = l.ItemId,
                QuantityOrdered = l.QuantityOrdered,
                UnitCost = l.UnitCost
            }).ToList()
        };
        activeTab = 1;
    }

    private async Task ConvertRequestToOrder(PurchaseOrder req)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Convert Request {req.OrderNumber} to a Purchase Order?");
        if (!confirm) return;

        var err = await PurchService.ConvertRequestToOrderAsync(req.Id);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        await JS.InvokeVoidAsync("alert", "Request Successfully Converted to Purchase Order!");
        await LoadData();
        SetActiveTab(0);
    }

    private async Task GenerateInvoiceFromPo(PurchaseOrder po)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Convert Purchase Order {po.OrderNumber} to an Invoice Draft?");
        if (!confirm) return;

        var err = await PurchService.ConvertPOToInvoiceAsync(po.Id);
        if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

        await JS.InvokeVoidAsync("alert", "Order Successfully Converted to Draft Invoice!");
        await LoadData();

        var newInvoice = orders.FirstOrDefault(o => o.ConvertedFromPONumber == po.OrderNumber);
        if (newInvoice != null) await EditOrder(newInvoice);
        SetActiveTab(3);
    }

    private async Task SaveInvoiceDraft()
    {
        if (currentOrder.VendorId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a vendor."); return; }
        if (!currentOrder.Lines.Any()) { await JS.InvokeVoidAsync("alert", "Please add at least one line item."); return; }

        isBusy = true;
        try
        {
            currentOrder.Status = PurchaseOrderStatus.DraftInvoice;
            var err = await PurchService.SavePurchaseOrderAsync(currentOrder);
            if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

            await JS.InvokeVoidAsync("alert", "Invoice Draft saved successfully!");
            await LoadData();
            SetActiveTab(3);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ExecuteInvoicePostFromList(PurchaseOrder inv)
    {
        isPostingId = inv.Id;
        var err = await PurchService.PostInvoiceOrderAsync(inv.Id, currentUserId);
        isPostingId = Guid.Empty;

        if (string.IsNullOrEmpty(err))
        {
            await LoadData();

            using var ctx = await DbFactory.CreateDbContextAsync();
            var emailConfig = await ctx.CompanyEmailSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == currentCompanyId);
            bool showPopupToggle = emailConfig?.EnableInvoiceEmailPopup ?? true;

            if (!showPopupToggle)
            {
                await JS.InvokeVoidAsync("alert", "Invoice submitted for GL review.");
                showEmailPopup = false;
                SetActiveTab(3);
                return;
            }

            var vendor = vendors.FirstOrDefault(v => v.Id == inv.VendorId);
            emailTargetPoId = inv.Id;
            emailVendorName = vendor?.Name ?? "Vendor";
            emailVendorAddress = vendor?.Email ?? "";
            emailSubject = $"Purchase Order Processing - {inv.OrderNumber}";
                customEmailMessage = $"Dear {emailVendorName},\n\nWe have submitted the invoice against Purchase Order {inv.OrderNumber} for accounting review.\n\nPlease find the referenced Purchase Order document attached for your records.\n\nBest Regards,\n{companyName} Procurement Team";

            showEmailPopup = true;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveAndPostFormInvoice()
    {
        if (currentOrder.VendorId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a vendor."); return; }

        currentOrder.Status = PurchaseOrderStatus.DraftInvoice;

        var saveErr = await PurchService.SavePurchaseOrderAsync(currentOrder);
        if (!string.IsNullOrEmpty(saveErr)) { await JS.InvokeVoidAsync("alert", saveErr); return; }

        await ExecuteInvoicePostFromList(currentOrder);
    }

    private async Task SaveOrder()
    {
        if (currentOrder.VendorId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a vendor."); return; }
        isBusy = true;
        try
        {
            var err = await PurchService.SavePurchaseOrderAsync(currentOrder);
            if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

            await JS.InvokeVoidAsync("alert", "Saved Successfully.");
            await LoadData();
            SetActiveTab(currentOrder.Status == PurchaseOrderStatus.Request ? 2 : 0);
        }
        finally { isBusy = false; }
    }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var venId))
        {
            currentOrder.VendorId = venId;
            var vendor = vendors.FirstOrDefault(c => c.Id == venId);

            if (vendor != null && vendor.CurrencyId != Guid.Empty)
            {
                currentOrder.CurrencyId = vendor.CurrencyId;
                currencySymbol = vendor.DefaultCurrency?.CurrencyCode ?? "";
                selectedCurrencyCode = currencySymbol;
                currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(currentCompanyId, currentOrder.CurrencyId);
                RecalculatePrices();
            }
        }
    }

    private void OnExchangeRateChanged(decimal rate)
    {
        currentOrder.ExchangeRate = Math.Round(rate, 4);
        RecalculatePrices();
    }

    private string GetCurrencyCode(Guid currencyId) => currencies.FirstOrDefault(c => c.Id == currencyId)?.CurrencyCode ?? "";

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId))
        {
            currentOrder.TaxId = taxId;
            currentOrder.TaxGLAccountId = taxes.FirstOrDefault(t => t.Id == taxId)?.GLAccountId;
        }
        else
        {
            currentOrder.TaxId = null;
            currentOrder.TaxGLAccountId = null;
        }
    }

    private void AddLine() => currentOrder.Lines.Add(new PurchaseOrderLine());
