@code {
    private string companyName = "";
    private Guid currentCompanyId = Guid.Empty;
    private bool isLoading = true;
    private int activeTab = 0; // 0 = All Orders, 1 = New/Edit, 2 = Requests

    private bool IsLocked => currentOrder.HasReceipt || currentOrder.IsInvoicePosted || (currentOrder.Status == PurchaseOrderStatus.Request && orders.Any(o => o.ConvertedFromRequestNumber == currentOrder.OrderNumber));

    // Filters & Pagination State
    private int pageSize = 15;
    private int currentOrderPage = 1;
    private int currentReqPage = 1;

    private string _searchTerm = "";
    private string searchTerm
    {
        get => _searchTerm;
        set { _searchTerm = value; currentOrderPage = 1; currentReqPage = 1; }
    }

    private DateTime _filterFromDate = DateTime.Today.AddDays(-30);
    private DateTime filterFromDate
    {
        get => _filterFromDate;
        set { _filterFromDate = value; currentOrderPage = 1; currentReqPage = 1; }
    }

    private DateTime _filterToDate = DateTime.Today;
    private DateTime filterToDate
    {
        get => _filterToDate;
        set { _filterToDate = value; currentOrderPage = 1; currentReqPage = 1; }
    }

    private List<PurchaseOrder> orders = new();
    private PurchaseOrder currentOrder = new();
    private List<Vendor> vendors = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<Warehouse> warehouses = new();
    private List<Tax> taxes = new();

    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> liabilityAccounts = new();
    private List<SegChartOfAccount> taxAccounts = new();
    private List<SegChartOfAccount> discountAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private string currencySymbol = "";
    private string companyBaseCurrency = "BASE";
    private string selectedCurrencyCode = "";
    private Guid isPostingId = Guid.Empty;
    private bool isBusy = false;
    private bool isExporting = false;

    // Email State
    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private Guid emailTargetPoId = Guid.Empty;
    private string emailVendorName = "";
    private string emailVendorAddress = "";
    private string emailSubject = "";
    private string customEmailMessage = "";

    // --- COMPUTED MATH ---
    private decimal SubTotal => currentOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
    private decimal DiscountValue => currentOrder.DiscountPercentage > 0
        ? SubTotal * (currentOrder.DiscountPercentage / 100)
        : currentOrder.DiscountAmount;
    private decimal DiscountedSubTotal => SubTotal - DiscountValue;
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == currentOrder.TaxId)?.Per ?? 0;
    private decimal TaxAmount => DiscountedSubTotal * (TaxPercentage / 100);
    private decimal GrandTotalForeign => DiscountedSubTotal + TaxAmount;
    private decimal GrandTotalBase => currentOrder.ExchangeRate == 0 ? 0 : GrandTotalForeign * currentOrder.ExchangeRate;

    private Guid SelectedDiscountGlAccountId
    {
        get => currentOrder.DiscountGlAccountId ?? Guid.Empty;
        set => currentOrder.DiscountGlAccountId = value == Guid.Empty ? null : value;
    }

    private Guid SelectedTaxGlAccountId
    {
        get => currentOrder.TaxGLAccountId ?? Guid.Empty;
        set => currentOrder.TaxGLAccountId = value == Guid.Empty ? null : value;
    }

    // --- FILTERS & PAGINATION CALCULATIONS ---
    private IEnumerable<PurchaseOrder> FilteredOrders => orders
        .Where(o => o.Status != PurchaseOrderStatus.Request) // Exclude Requests
        .Where(o => o.OrderDate.Date >= filterFromDate.Date && o.OrderDate.Date <= filterToDate.Date)
        .Where(o => string.IsNullOrWhiteSpace(searchTerm)
                 || o.OrderNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                 || vendors.FirstOrDefault(v => v.Id == o.VendorId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
                 || o.Lines.Any(l => items.FirstOrDefault(i => i.Id == l.ItemId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true))
        .OrderByDescending(o => o.OrderDate);

    private int TotalOrderPages => Math.Max(1, (int)Math.Ceiling(FilteredOrders.Count() / (double)pageSize));
    private IEnumerable<PurchaseOrder> PagedOrders => FilteredOrders.Skip((currentOrderPage - 1) * pageSize).Take(pageSize);


    private IEnumerable<PurchaseOrder> FilteredRequests => orders
        .Where(o => o.Status == PurchaseOrderStatus.Request) // Only Requests
        .Where(o => o.OrderDate.Date >= filterFromDate.Date && o.OrderDate.Date <= filterToDate.Date)
        .Where(o => string.IsNullOrWhiteSpace(searchTerm)
                 || o.OrderNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                 || vendors.FirstOrDefault(v => v.Id == o.VendorId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)
        .OrderByDescending(o => o.OrderDate);

    private int TotalReqPages => Math.Max(1, (int)Math.Ceiling(FilteredRequests.Count() / (double)pageSize));
    private IEnumerable<PurchaseOrder> PagedRequests => FilteredRequests.Skip((currentReqPage - 1) * pageSize).Take(pageSize);
    private string currentUserId = "";

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("PURCHASING_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            currentCompanyId = user.CompanyDetailsId.Value;
            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null)
            {
                companyName = company.CompanyName;
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }

            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        vendors = await MasterService.GetVendorsAsync(currentCompanyId);
        currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);
        items = await MasterService.GetItemsAsync(currentCompanyId);
        warehouses = await WhService.GetWarehousesAsync(currentCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == currentCompanyId).ToListAsync();

        var rawOrders = await PurchService.GetPOsAsync(currentCompanyId);

        foreach (var po in rawOrders)
        {
            decimal st = po.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
            decimal disc = po.DiscountAmount;
            if (po.DiscountPercentage > 0) disc = st * (po.DiscountPercentage / 100);
            decimal net = st - disc;
            decimal txAmount = 0;
            if (po.TaxId.HasValue)
            {
                var taxObj = taxes.FirstOrDefault(t => t.Id == po.TaxId);
                if (taxObj != null) txAmount = net * (taxObj.Per / 100);
            }
            po.GrandTotalForeign = net + txAmount;
        }
        orders = rawOrders;

        accountTypes = await SegCoaService.GetAccountTypesAsync();
        allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

        liabilityAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        taxAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        discountAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == false && type.IsDebit == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();
    }

    private void CreateNew()
    {
        currentOrder = new PurchaseOrder { CompanyId = currentCompanyId, OrderDate = DateTime.Today, ExchangeRate = 1, Status = PurchaseOrderStatus.Request };
        currencySymbol = "";
        selectedCurrencyCode = "";
        currentOrder.Lines.Add(new PurchaseOrderLine());
        activeTab = 1;
    }

    private void SetStatusType(PurchaseOrderStatus status)
    {
        currentOrder.Status = status;
    }

    private async Task EditOrder(PurchaseOrder po)
    {
        var result = await PurchService.GetVendorCurrencyDataAsync(po.VendorId, currentCompanyId);
        currencySymbol = result.CurrencyCode;
        selectedCurrencyCode = result.CurrencyCode;

        currentOrder = new PurchaseOrder
        {
            Id = po.Id,
            CompanyId = po.CompanyId,
            VendorId = po.VendorId,
            OrderDate = po.OrderDate,
            OrderNumber = po.OrderNumber,
            ConvertedFromRequestNumber = po.ConvertedFromRequestNumber,
            Status = po.Status,
            CurrencyId = po.CurrencyId,
            ExchangeRate = po.ExchangeRate,
            TaxId = po.TaxId,
            TaxGLAccountId = po.TaxGLAccountId,
            DiscountAmount = po.DiscountAmount,
            DiscountPercentage = po.DiscountPercentage,
            DiscountGlAccountId = po.DiscountGlAccountId,
            HasReceipt = po.HasReceipt,
            IsInvoicePosted = po.IsInvoicePosted,
            Lines = po.Lines.Select(l => new PurchaseOrderLine
            {
                Id = l.Id,
                ItemId = l.ItemId,
                QuantityOrdered = l.QuantityOrdered,
                UnitCost = l.UnitCost
            }).ToList()
        };
        activeTab = 1;
    }

    private async Task ConvertRequestToOrder(PurchaseOrder req)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Convert Request {req.OrderNumber} to a Purchase Order?");
        if (!confirm) return;

        var err = await PurchService.ConvertRequestToOrderAsync(req.Id);
        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        await JS.InvokeVoidAsync("alert", "Request Successfully Converted to Purchase Order!");
        await LoadData();

        activeTab = 0;
        var newOrder = orders.FirstOrDefault(o => o.ConvertedFromRequestNumber == req.OrderNumber);
        if (newOrder != null)
        {
            await EditOrder(newOrder);
        }
        StateHasChanged();
    }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var venId))
        {
            currentOrder.VendorId = venId;
            var vendor = vendors.FirstOrDefault(c => c.Id == venId);

            if (vendor != null && vendor.CurrencyId != Guid.Empty)
            {
                currentOrder.CurrencyId = vendor.CurrencyId;
                currencySymbol = vendor.DefaultCurrency?.CurrencyCode ?? "";
                selectedCurrencyCode = currencySymbol;
                currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(currentCompanyId, currentOrder.CurrencyId);

                foreach (var line in currentOrder.Lines) UpdateLineItem(line);
                RecalculatePrices();
            }
            else if (currencies.Any())
            {
                var def = currencies.First();
                currentOrder.CurrencyId = def.Id;
                currencySymbol = def.CurrencyCode;
                selectedCurrencyCode = currencySymbol;
                currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(currentCompanyId, def.Id);

                foreach (var line in currentOrder.Lines) UpdateLineItem(line);
                RecalculatePrices();
            }
        }
        else
        {
            currentOrder.VendorId = Guid.Empty;
            selectedCurrencyCode = "";
            currencySymbol = "";
        }
    }

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId))
        {
            currentOrder.TaxId = taxId;
            var selectedTax = taxes.FirstOrDefault(t => t.Id == taxId);
            if (selectedTax != null)
            {
                currentOrder.TaxGLAccountId = selectedTax.GLAccountId;
            }
        }
        else
        {
            currentOrder.TaxId = null;
            currentOrder.TaxGLAccountId = null;
        }
    }

    private void AddLine() => currentOrder.Lines.Add(new PurchaseOrderLine());

    private void UpdateLineItem(PurchaseOrderLine line)
    {
        var item = items.FirstOrDefault(x => x.Id == line.ItemId);
        if (item != null)
        {
            line.UnitCost = 0;
        }
    }

    private void RecalculatePrices()
    {
        foreach (var line in currentOrder.Lines)
        {
            UpdateLineItem(line);
        }
        StateHasChanged();
    }

    private async Task SaveOrder()
    {
        if (currentOrder.VendorId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a vendor."); return; }

        isBusy = true;
        try
        {
            var err = await PurchService.SavePurchaseOrderAsync(currentOrder);
            if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

            await JS.InvokeVoidAsync("alert", "Saved Successfully.");
            await LoadData();
            activeTab = 0;
        }
        finally
        {
            isBusy = false;
        }
    }

    // --- REFACTORED INVOICE GENERATION PIPELINE ---
    private async Task AutoPostInvoice(PurchaseOrder po)
    {
        isPostingId = po.Id;
        var err = await PurchService.AutoPostVendorBillFromPOAsync(po.Id, currentCompanyId, currentUserId);
        isPostingId = Guid.Empty;

        if (string.IsNullOrEmpty(err))
        {
            await LoadData();

            // --- MULTI-TENANT TOGGLE CONTROL SWITCH ENFORCEMENT ---
            using var ctx = await DbFactory.CreateDbContextAsync();
            var emailConfig = await ctx.CompanyEmailSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == currentCompanyId);
            bool showPopupToggle = emailConfig?.EnableInvoiceEmailPopup ?? true;

            // If checked off, exit layout, alert user, and bypass email completely
            if (!showPopupToggle)
            {
                await JS.InvokeVoidAsync("alert", "Invoice Posted Successfully!");
                showEmailPopup = false;
                activeTab = 0; // Cleanly drops out of document form mode back to listing view grid
                StateHasChanged();
                return;
            }

            var vendor = vendors.FirstOrDefault(v => v.Id == po.VendorId);
            emailTargetPoId = po.Id;
            emailVendorName = vendor?.Name ?? "Vendor";
            emailVendorAddress = vendor?.Email ?? "";
            emailSubject = $"Purchase Order Processing - {po.OrderNumber}";
            customEmailMessage = $"Dear {emailVendorName},\n\nWe have successfully posted the invoice against Purchase Order {po.OrderNumber}.\n\nPlease find the referenced Purchase Order document attached for your records.\n\nBest Regards,\n{companyName} Procurement Team";

            showEmailPopup = true;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task<(byte[] Bytes, string FileName, string Subject, string VendorEmail)> GetPoPdfDataAsync(Guid poId)
    {
        var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
        using var ctx = await DbFactory.CreateDbContextAsync();
        var printOrder = await ctx.PurchaseOrders
            .Include(p => p.Lines)
            .Include(p => p.Currency)
            .FirstOrDefaultAsync(p => p.Id == poId);

        if (printOrder == null || company == null) return (null, "", "", "");

        var vendor = vendors.FirstOrDefault(v => v.Id == printOrder.VendorId);
        var itemNamesMap = items.ToDictionary(i => i.Id, i => i.Name);

        decimal st = printOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
        decimal disc = printOrder.DiscountPercentage > 0 ? st * (printOrder.DiscountPercentage / 100) : printOrder.DiscountAmount;
        decimal taxP = taxes.FirstOrDefault(t => t.Id == printOrder.TaxId)?.Per ?? 0;
        printOrder.GrandTotalForeign = (st - disc) + ((st - disc) * (taxP / 100));

        var pdfBytes = ReportExportService.GeneratePurchaseOrderPdf(printOrder, company, vendor?.Name ?? "Vendor", vendor?.Email ?? "", itemNamesMap);
        string fileName = $"PO_{printOrder.OrderNumber}.pdf";
        string subject = $"Purchase Order {printOrder.OrderNumber} from {company.CompanyName}";

        return (pdfBytes, fileName, subject, vendor?.Email ?? "");
    }

    private async Task DownloadPO()
    {
        if (currentOrder == null || currentOrder.Id == Guid.Empty) return;

        isExporting = true;
        try
        {
            var data = await GetPoPdfDataAsync(currentOrder.Id);
            if (data.Bytes == null)
            {
                await JS.InvokeVoidAsync("alert", "Failed to generate PO. Missing order or company data.");
                return;
            }

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(data.Bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", data.FileName, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task DispatchEmail()
    {
        isSendingEmail = true;
        try
        {
            var data = await GetPoPdfDataAsync(emailTargetPoId);
            if (data.Bytes == null) throw new Exception("Failed to generate PDF attachment.");

            await EmailService.SendEmailAsync(
                emailVendorAddress,
                emailSubject,
                customEmailMessage.Replace("\n", "<br>"),
                data.Bytes,
                data.FileName
            );

            await JS.InvokeVoidAsync("alert", "Document emailed successfully!");
            showEmailPopup = false;
            emailTargetPoId = Guid.Empty;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}");
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    private async Task TerminateOrder()
    {
        if (currentOrder.Id == Guid.Empty)
        {
            activeTab = 0;
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete {currentOrder.OrderNumber}?\n\nThis action cannot be undone.");
        if (!confirm) return;

        isBusy = true;
        try
        {
            var err = await PurchService.DeletePurchaseOrderAsync(currentOrder.Id);

            if (!string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", err);
                return;
            }

            await LoadData();
            activeTab = 0;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"UI Error: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }
}