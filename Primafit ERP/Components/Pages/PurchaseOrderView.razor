@page "/procurement/purchase-orders"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject NavigationManager Nav
@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject CompanyApiService CompanyService
@inject CurrencyService CurrService
@inject SegCoaService SegCoaService
@inject WarehouseService WhService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mx-auto max-w-[1400px] space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Purchase Orders</h1>
            @if (!string.IsNullOrEmpty(companyName))
            {
                <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200 mt-2">
                    @companyName
                </span>
            }
        </div>

        <div class="flex flex-col sm:flex-row gap-4 items-center">
            @if (activeTab == 0 || activeTab == 2)
            {
                <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-xl border border-slate-200">
                    <input type="date" @bind="filterFromDate" class="px-2 py-1.5 text-xs font-bold bg-white border border-slate-200 rounded-lg outline-none focus:border-indigo-500" />
                    <span class="text-slate-400 font-bold text-xs">-</span>
                    <input type="date" @bind="filterToDate" class="px-2 py-1.5 text-xs font-bold bg-white border border-slate-200 rounded-lg outline-none focus:border-indigo-500" />
                </div>
                <div class="relative w-full sm:w-64">
                    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search PO, Vendor, Item..." class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition-all" />
                </div>
            }

            <div class="flex bg-slate-100 p-1 rounded-xl">
                <button @onclick="() => activeTab = 2" class="px-4 py-2 rounded-lg text-sm font-bold transition-all @(activeTab == 2 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    Requests
                </button>
                <button @onclick="() => activeTab = 0" class="px-4 py-2 rounded-lg text-sm font-bold transition-all @(activeTab == 0 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    All Orders
                </button>
                <button @onclick="CreateNew" class="px-4 py-2 rounded-lg text-sm font-bold transition-all @(activeTab == 1 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    New PO
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading purchase orders...</div>
    }
    else if (currentCompanyId != Guid.Empty)
    {
        @if (activeTab == 2)
        {
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
                <div class="p-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Purchase Requests (Drafts)</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="px-6 py-4">Request Number</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Vendor</th>
                                <th class="px-6 py-4 w-[25%]">Items (Qty)</th>
                                <th class="px-6 py-4 text-right">Total (Foreign)</th>
                                <th class="px-6 py-4 text-right border-l border-slate-200">Total (Base)</th>
                                <th class="px-6 py-4 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">

                            <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                <td class="px-6 py-4"><div class="font-mono font-bold text-slate-900">PO-2603-1567</div></td>
                                <td class="px-6 py-4 text-slate-500 font-medium">Mar 05, 2026</td>
                                <td class="px-6 py-4"><div class="font-bold text-slate-800">Venture Demo</div></td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-between gap-3 text-xs">
                                        <span class="truncate text-slate-600 font-medium">Blue Chair</span>
                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x100)</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-slate-900">1,935,000.00</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">NGN</div>
                                </td>
                                <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                    <div class="font-mono font-bold text-emerald-700">1,935,000.00</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Invoiced</span>
                                </td>
                            </tr>

                            <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                <td class="px-6 py-4"><div class="font-mono font-bold text-slate-900">PO-2603-2885</div></td>
                                <td class="px-6 py-4 text-slate-500 font-medium">Mar 05, 2026</td>
                                <td class="px-6 py-4"><div class="font-bold text-slate-800">Tunmise</div></td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-between gap-3 text-xs">
                                        <span class="truncate text-slate-600 font-medium">Demo Item</span>
                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x4)</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-slate-900">77.40</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">NGN</div>
                                </td>
                                <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                    <div class="font-mono font-bold text-emerald-700">116,100.00</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Invoiced</span>
                                </td>
                            </tr>

                            <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                <td class="px-6 py-4"><div class="font-mono font-bold text-slate-900">PO-2603-6530</div></td>
                                <td class="px-6 py-4 text-slate-500 font-medium">Mar 05, 2026</td>
                                <td class="px-6 py-4"><div class="font-bold text-slate-800">Demo vendor</div></td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-between gap-3 text-xs">
                                        <span class="truncate text-slate-600 font-medium">Demo Item</span>
                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x5)</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-slate-900">120,937.50</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">NGN</div>
                                </td>
                                <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                    <div class="font-mono font-bold text-emerald-700">120,937.50</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Invoiced</span>
                                </td>
                            </tr>

                            <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                <td class="px-6 py-4"><div class="font-mono font-bold text-slate-900">PO-2603-6138</div></td>
                                <td class="px-6 py-4 text-slate-500 font-medium">Mar 05, 2026</td>
                                <td class="px-6 py-4"><div class="font-bold text-slate-800">Ad Agency Corp</div></td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-between gap-3 text-xs">
                                        <span class="truncate text-slate-600 font-medium">Goods A</span>
                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x210)</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-slate-900">3,047,625.00</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">NGN</div>
                                </td>
                                <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                    <div class="font-mono font-bold text-emerald-700">3,047,625.00</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Invoiced</span>
                                </td>
                            </tr>

                            <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                <td class="px-6 py-4"><div class="font-mono font-bold text-slate-900">PO-2603-9791</div></td>
                                <td class="px-6 py-4 text-slate-500 font-medium">Mar 05, 2026</td>
                                <td class="px-6 py-4"><div class="font-bold text-slate-800">Tunmise</div></td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center justify-between gap-3 text-xs">
                                        <span class="truncate text-slate-600 font-medium">white chair</span>
                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x100)</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="font-mono font-bold text-slate-900">1,935.00</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">NGN</div>
                                </td>
                                <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                    <div class="font-mono font-bold text-emerald-700">2,999,250.00</div>
                                    <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Invoiced</span>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == 0)
        {
            <div class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden animate-in fade-in">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-slate-50/80 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="px-6 py-4">PO Number</th>
                                <th class="px-6 py-4">Date</th>
                                <th class="px-6 py-4">Vendor</th>
                                <th class="px-6 py-4 w-[25%]">Items (Qty)</th>
                                <th class="px-6 py-4 text-right">Total (Foreign)</th>
                                <th class="px-6 py-4 text-right border-l border-slate-200">Total (Base)</th>
                                <th class="px-6 py-4 text-center">Status</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var po in FilteredOrders)
                            {
                                var vendorName = vendors.FirstOrDefault(v => v.Id == po.VendorId)?.Name ?? "Unknown";

                                <tr class="hover:bg-slate-50/80 transition-colors group align-top">
                                    <td class="px-6 py-4">
                                        <div class="font-mono font-bold text-slate-900">@po.OrderNumber</div>
                                    </td>
                                    <td class="px-6 py-4 text-slate-500 font-medium">@po.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="px-6 py-4">
                                        <div class="font-bold text-slate-800 truncate max-w-[200px]" title="@vendorName">@vendorName</div>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (po.Lines != null && po.Lines.Any())
                                        {
                                            <div class="space-y-1.5">
                                                @foreach (var line in po.Lines.Take(2))
                                                {
                                                    var itemName = items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown Item";
                                                    <div class="flex items-center justify-between gap-3 text-xs">
                                                        <span class="truncate text-slate-600 font-medium">@itemName</span>
                                                        <span class="shrink-0 font-mono font-bold text-slate-500">(x@(line.QuantityOrdered.ToString("G29")))</span>
                                                    </div>
                                                }
                                                @if (po.Lines.Count > 2)
                                                {
                                                    <div class="text-[10px] font-bold uppercase tracking-wider text-indigo-500 pt-1">+ @(po.Lines.Count - 2) more item(s)</div>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="font-mono font-bold text-slate-900">@po.GrandTotalForeign.ToString("N2")</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@po.Currency?.CurrencyCode</div>
                                    </td>
                                    <td class="px-6 py-4 text-right border-l border-slate-100 bg-slate-50/30">
                                        <div class="font-mono font-bold text-emerald-700">@((po.GrandTotalForeign * (po.ExchangeRate > 0 ? po.ExchangeRate : 1)).ToString("N2"))</div>
                                        <div class="text-[9px] text-slate-400 font-bold uppercase tracking-wider mt-0.5">@companyBaseCurrency</div>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        @if (po.IsFullyPaid)
                                        {
                                            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Paid</span>
                                        }
                                        else if (po.IsInvoicePosted)
                                        {
                                            <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Invoiced</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">Open</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex items-center justify-end gap-2">
                                            @if (po.Status == PurchaseOrderStatus.Open && !po.HasReceipt)
                                            {
                                                <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors">Edit</button>
                                                <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")' class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors shadow-sm">Receive Goods</button>
                                            }
                                            else
                                            {
                                                <button @onclick="() => EditOrder(po)" class="px-3 py-1.5 text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors">View</button>
                                                @if (!po.IsFullyReceived)
                                                {
                                                    <button @onclick='() => Nav.NavigateTo($"/procurement/goods-receipt/{po.Id}")' class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors shadow-sm">Receive Goods</button>
                                                }
                                                @if (!po.IsInvoicePosted && po.HasReceipt)
                                                {
                                                    <button @onclick="() => AutoPostInvoice(po)" disabled="@(isPostingId == po.Id)" class="px-3 py-1.5 text-xs font-bold text-white bg-indigo-600 border border-indigo-700 rounded-lg hover:bg-indigo-700 transition-colors shadow-sm">
                                                        @(isPostingId == po.Id ? "Posting..." : "Post Bill")
                                                    </button>
                                                }
                                                else if (po.IsInvoicePosted && !po.IsFullyPaid)
                                                {
                                                    <button @onclick='() => Nav.NavigateTo($"/ap/bill-entry?poId={po.Id}")' class="px-3 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 border border-indigo-200 rounded-lg hover:bg-indigo-100 transition-colors shadow-sm">Make Payment</button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!FilteredOrders.Any())
                            {
                                <tr><td colspan="8" class="p-16 text-center text-slate-400">No orders found matching your criteria.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xl animate-in fade-in slide-in-from-bottom-4 overflow-visible flex flex-col h-full">

                <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                    <div class="flex items-center gap-4">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Purchase Details</h3>
                        @if (!string.IsNullOrEmpty(currentOrder.OrderNumber))
                        {
                            <span class="px-2 py-0.5 bg-slate-200 text-slate-700 font-mono text-xs rounded font-bold">@currentOrder.OrderNumber</span>
                        }
                    </div>
                    @if (IsLocked)
                    {
                        <div class="px-4 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-600 ring-slate-200 ring-1 flex items-center gap-1">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                            Locked (Received/Invoiced)
                        </div>
                    }
                </div>

                <div class="p-6 sm:p-8">

                    <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200 mb-6 shadow-sm">
                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

                            <div>
                                <label class="label">Vendor</label>
                                <select value="@currentOrder.VendorId" @onchange="OnVendorChanged" class="input-class font-bold text-slate-800 border-indigo-200 bg-white" disabled="@IsLocked">
                                    <option value="@Guid.Empty">-- Select Vendor --</option>
                                    @foreach (var v in vendors)
                                    {
                                        <option value="@v.Id">@v.Name</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="label">Order Date</label>
                                <input type="date" @bind="currentOrder.OrderDate" class="input-class bg-white" disabled="@IsLocked" />
                            </div>

                            <div>
                                <label class="label text-indigo-700">Currency & Rate</label>
                                <div class="flex gap-2">
                                    <select value="@currentOrder.CurrencyId" class="input-class w-5/12 bg-slate-200 text-slate-500 font-bold cursor-not-allowed px-2" disabled>
                                        <option value="@Guid.Empty">N/A</option>
                                        @foreach (var c in currencies)
                                        {
                                            <option value="@c.Id">@c.CurrencyCode</option>
                                        }
                                    </select>
                                    <div class="relative w-7/12">
                                        <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">x</span>
                                        <input type="number" step="0.01" @bind="currentOrder.ExchangeRate"
                                               @bind:after="RecalculatePrices"
                                               class="input-class pl-6 pr-2 text-right font-mono font-bold text-indigo-700 border-indigo-200 focus:border-indigo-500 bg-white" disabled="@IsLocked" />
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="label">Tax / VAT</label>
                                <select value="@currentOrder.TaxId" @onchange="OnTaxChanged" class="input-class bg-white" disabled="@IsLocked">
                                    <option value="">No Tax</option>
                                    @foreach (var t in taxes)
                                    {
                                        <option value="@t.Id">@t.TaxName (@t.Per%)</option>
                                    }
                                </select>
                            </div>

                            @if (currentOrder.TaxId != null && !IsLocked)
                            {
                                <div class="lg:col-span-2 animate-in fade-in slide-in-from-left-2">
                                    <SearchableGlAccount Label="Tax GL Account (Asset/Input)"
                                                         Placeholder="Search Tax GL..."
                                                         Accounts="@taxAccounts"
                                                         @bind-Value="SelectedTaxGlAccountId"
                                                         IsInvalid="@(currentOrder.TaxGLAccountId == null || currentOrder.TaxGLAccountId == Guid.Empty)" />
                                </div>
                            }
                            else if (currentOrder.TaxId != null && IsLocked)
                            {
                                <div class="lg:col-span-2">
                                    <label class="label text-slate-600">Tax GL Account (Asset/Input)</label>
                                    <div class="text-xs text-slate-500 font-bold bg-white p-3 rounded-lg border border-slate-200 shadow-sm">
                                        GL Acc: @(taxAccounts.FirstOrDefault(a => a.Id == currentOrder.TaxGLAccountId)?.AccountCode ?? "Unknown")
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="border border-slate-200 rounded-xl overflow-visible mb-6 shadow-sm">
                        <div class="relative overflow-visible">
                            <table class="w-full text-sm text-left overflow-visible">
                                <thead class="bg-slate-50 text-slate-500 font-bold border-b border-slate-200 text-xs uppercase">
                                    <tr>
                                        <th class="p-3 pl-4 w-[40%]">Item</th>
                                        <th class="p-3 w-[15%] text-center">Qty</th>
                                        <th class="p-3 w-[20%] text-right">Unit Cost (@currencySymbol)</th>
                                        <th class="p-3 w-[20%] text-right pr-4">Total</th>
                                        <th class="p-3 w-[5%]"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100 min-h-[150px] overflow-visible">
                                    @foreach (var line in currentOrder.Lines)
                                    {
                                        var isService = items.FirstOrDefault(i => i.Id == line.ItemId)?.IsService ?? false;

                                        <tr class="relative group hover:bg-slate-50 transition-colors overflow-visible">
                                            <td class="p-2 pl-4 align-top overflow-visible z-50">
                                                @if (IsLocked)
                                                {
                                                    <div class="p-2 font-bold text-slate-700 bg-slate-50 rounded-lg border border-slate-200">
                                                        @(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Unknown")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <SearchableItem Label="" Items="@items" @bind-Value="line.ItemId" OnSelectionChanged="@(() => UpdateLineItem(line))" IsInvalid="@(line.ItemId == Guid.Empty)" />
                                                    @if (isService)
                                                    {
                                                        <div class="mt-1 text-[10px] text-indigo-600 font-bold uppercase tracking-wider flex items-center gap-1">
                                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                            Service Item
                                                        </div>
                                                    }
                                                }
                                            </td>
                                            <td class="p-2 align-top pt-3 text-center">
                                                @if (isService)
                                                {
                                                    <input type="number" value="1" class="input-class py-2 text-center font-bold bg-slate-100 text-slate-500 cursor-not-allowed border-slate-200" readonly disabled />
                                                }
                                                else
                                                {
                                                    <input type="number" @bind="line.QuantityOrdered" class="input-class py-2 text-center font-bold" placeholder="1" disabled="@IsLocked" />
                                                }
                                            </td>
                                            <td class="p-2 align-top pt-3">
                                                <input type="number" step="0.01" @bind="line.UnitCost" class="input-class py-2 text-right font-mono @(IsLocked ? "bg-slate-100 text-slate-500 cursor-not-allowed border-slate-200" : "")" disabled="@IsLocked" />
                                            </td>
                                            <td class="p-2 pr-4 align-top pt-4 text-right font-mono font-bold text-slate-700">
                                                @((line.QuantityOrdered * line.UnitCost).ToString("N2"))
                                            </td>
                                            <td class="p-2 text-center align-top pt-4">
                                                @if (!IsLocked)
                                                {
                                                    <button type="button" @onclick="() => currentOrder.Lines.Remove(line)" class="text-slate-400 hover:text-rose-600 opacity-0 group-hover:opacity-100">
                                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (!IsLocked)
                        {
                            <div class="p-2 bg-slate-50 border-t border-slate-200">
                                <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 hover:text-indigo-900 flex items-center gap-1 px-2 py-1 uppercase tracking-wide">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg> Add Line Item
                                </button>
                            </div>
                        }
                    </div>

                    <div class="flex flex-col md:flex-row justify-between items-start gap-6">

                        <div class="w-full md:w-1/2 p-5 border border-emerald-100 rounded-xl shadow-sm">
                            <h4 class="font-extrabold text-xs uppercase tracking-wider text-emerald-800 mb-4 flex items-center gap-2">

                                Discount Received
                            </h4>
                            <div class="grid grid-cols-2 gap-4 mb-4">
                                <div>
                                    <label class="label text-[10px]">Percentage (%)</label>
                                    <input type="number" @bind="currentOrder.DiscountPercentage"
                                           @bind:after="() => { if(currentOrder.DiscountPercentage > 0) currentOrder.DiscountAmount = 0; }"
                                           class="input-class text-center font-bold text-emerald-700 border-emerald-200 focus:border-emerald-500" disabled="@IsLocked" />
                                </div>
                                <div>
                                    <label class="label text-[10px]">Flat Amount (@currencySymbol)</label>
                                    <input type="number" @bind="currentOrder.DiscountAmount"
                                           @bind:after="() => { if(currentOrder.DiscountAmount > 0) currentOrder.DiscountPercentage = 0; }"
                                           class="input-class text-right font-mono border-emerald-200 focus:border-emerald-500" disabled="@IsLocked" />
                                </div>
                            </div>

                            @if ((currentOrder.DiscountPercentage > 0 || currentOrder.DiscountAmount > 0) && !IsLocked)
                            {
                                <div class="pt-2 border-t border-emerald-200/50">
                                    <SearchableGlAccount Label="Discount Income Account (Credit)"
                                                         Placeholder="Select Income GL..."
                                                         Accounts="@discountAccounts"
                                                         @bind-Value="SelectedDiscountGlAccountId"
                                                         IsInvalid="@(currentOrder.DiscountGlAccountId == null || currentOrder.DiscountGlAccountId == Guid.Empty)" />
                                </div>
                            }
                            else if (IsLocked && currentOrder.DiscountGlAccountId != null)
                            {
                                <div class="text-xs text-slate-500 font-bold bg-white p-3 rounded-lg border border-emerald-100 shadow-sm mt-2">
                                    GL Acc: @(discountAccounts.FirstOrDefault(a => a.Id == currentOrder.DiscountGlAccountId)?.AccountCode ?? "Unknown")
                                </div>
                            }
                        </div>

                        <div class="space-y-2 text-sm text-slate-600 w-full md:w-80 bg-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm">
                            <div class="flex justify-between">
                                <span>Subtotal:</span>
                                <span class="font-mono font-bold">@SubTotal.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between items-center text-emerald-600 border-b border-slate-200 pb-2">
                                <span>Discount:</span>
                                <span class="font-mono font-bold">- @DiscountValue.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between items-center pt-1">
                                <span>Net Subtotal:</span>
                                <span class="font-mono font-bold">@DiscountedSubTotal.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span>Tax (@TaxPercentage%):</span>
                                <span class="font-mono font-bold">+ @TaxAmount.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between border-t border-slate-300 pt-3 text-slate-900 text-lg mt-3">
                                <span class="font-bold">Total (@currencySymbol):</span>
                                <span class="font-mono font-black text-indigo-700 text-2xl">@GrandTotalForeign.ToString("N2")</span>
                            </div>
                            <div class="flex justify-between text-[10px] text-slate-400 mt-1 uppercase font-bold tracking-wider">
                                <span>Ledger Base Value:</span>
                                <span class="font-mono text-slate-500">@GrandTotalBase.ToString("N2")</span>
                            </div>
                        </div>

                    </div>

                    <div class="flex items-center justify-end gap-3 mt-8 pt-5 border-t border-slate-200">
                        @if (!IsLocked)
                        {
                            <button type="button" @onclick="TerminateOrder" class="px-5 py-2.5 rounded-xl border border-rose-200 text-rose-600 font-bold text-sm hover:bg-rose-50 transition-colors">
                                Delete
                            </button>
                            <button type="button" @onclick="() => activeTab = 0" class="px-6 py-2.5 rounded-xl font-bold text-slate-500 hover:bg-slate-100 transition-colors">
                                Cancel
                            </button>
                            <button type="button" @onclick="SaveOrder" class="px-8 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50" disabled="@isBusy">
                                @if (isBusy)
                                {
                                    <span class="animate-spin">↻</span>
                                }
                                Save Purchase Order
                            </button>
                        }
                        else
                        {
                            <button type="button" @onclick="() => activeTab = 0" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md">
                                Close View
                            </button>
                        }
                    </div>

                </div>
            </div>
        }
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        outline: none;
        transition: border-color 0.2s;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

        .input-class:disabled, .input-class:read-only {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
            border-color: #e2e8f0;
        }
</style>

@code {
    private string companyName = "";
    private Guid currentCompanyId = Guid.Empty;
    private bool isLoading = true;
    private int activeTab = 0; // 0 = All Orders, 1 = New/Edit, 2 = Requests

    private bool IsLocked => currentOrder.HasReceipt || currentOrder.IsInvoicePosted;

    // Filters
    private string searchTerm = "";
    private DateTime filterFromDate = DateTime.Today.AddDays(-30);
    private DateTime filterToDate = DateTime.Today;

    private List<PurchaseOrder> orders = new();
    private PurchaseOrder currentOrder = new();
    private List<Vendor> vendors = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<Warehouse> warehouses = new();
    private List<Tax> taxes = new();

    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> liabilityAccounts = new();
    private List<SegChartOfAccount> taxAccounts = new();
    private List<SegChartOfAccount> discountAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private string currencySymbol = "";
    private string companyBaseCurrency = "BASE";
    private string selectedCurrencyCode = "";
    private Guid isPostingId = Guid.Empty;
    private bool isBusy = false;

    // --- COMPUTED MATH ---
    private decimal SubTotal => currentOrder.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
    private decimal DiscountValue => currentOrder.DiscountPercentage > 0
        ? SubTotal * (currentOrder.DiscountPercentage / 100)
        : currentOrder.DiscountAmount;
    private decimal DiscountedSubTotal => SubTotal - DiscountValue;
    private decimal TaxPercentage => taxes.FirstOrDefault(t => t.Id == currentOrder.TaxId)?.Per ?? 0;
    private decimal TaxAmount => DiscountedSubTotal * (TaxPercentage / 100);
    private decimal GrandTotalForeign => DiscountedSubTotal + TaxAmount;
    private decimal GrandTotalBase => currentOrder.ExchangeRate == 0 ? 0 : GrandTotalForeign * currentOrder.ExchangeRate;

    // Nullable Guid bridge for component
    private Guid SelectedDiscountGlAccountId
    {
        get => currentOrder.DiscountGlAccountId ?? Guid.Empty;
        set => currentOrder.DiscountGlAccountId = value == Guid.Empty ? null : value;
    }

    private Guid SelectedTaxGlAccountId
    {
        get => currentOrder.TaxGLAccountId ?? Guid.Empty;
        set => currentOrder.TaxGLAccountId = value == Guid.Empty ? null : value;
    }

    private IEnumerable<PurchaseOrder> FilteredOrders => orders
        .Where(o => o.OrderDate.Date >= filterFromDate.Date && o.OrderDate.Date <= filterToDate.Date)
        .Where(o => string.IsNullOrWhiteSpace(searchTerm)
                 || o.OrderNumber.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
                 || vendors.FirstOrDefault(v => v.Id == o.VendorId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
                 || o.Lines.Any(l => items.FirstOrDefault(i => i.Id == l.ItemId)?.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null)
            {
                companyName = company.CompanyName;
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }

            await LoadData();
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        vendors = await MasterService.GetVendorsAsync(currentCompanyId);
        currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);
        items = await MasterService.GetItemsAsync(currentCompanyId);
        warehouses = await WhService.GetWarehousesAsync(currentCompanyId);
        taxes = await ctx.Taxes.Where(t => t.CompanyId == currentCompanyId).ToListAsync();

        // Fetch Orders and Calculate Totals
        var rawOrders = await PurchService.GetPOsAsync(currentCompanyId);

        // Dynamic PO Math (Since POs don't store GrandTotal in DB)
        foreach (var po in rawOrders)
        {
            decimal st = po.Lines.Sum(l => l.QuantityOrdered * l.UnitCost);
            decimal disc = po.DiscountAmount;
            if (po.DiscountPercentage > 0) disc = st * (po.DiscountPercentage / 100);
            decimal net = st - disc;
            decimal txAmount = 0;
            if (po.TaxId.HasValue)
            {
                var taxObj = taxes.FirstOrDefault(t => t.Id == po.TaxId);
                if (taxObj != null) txAmount = net * (taxObj.Per / 100);
            }
            po.GrandTotalForeign = net + txAmount;
        }
        orders = rawOrders;

        // GL Accounts Setup
        accountTypes = await SegCoaService.GetAccountTypesAsync();
        allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

        // Liabilities (for standard Tax mapping)
        liabilityAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        // Tax Input can be an Asset (Debit) or mapped to the main VAT Liability (Credit)
        taxAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == true && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();

        // Discount Received is Income / Credit
        discountAccounts = allAccounts.Where(a =>
        {
            var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
            return type != null && type.IsBalanceSheet == false && type.IsDebit == false && a.IsActive;
        }).OrderBy(x => x.AccountCode).ToList();
    }

    private void CreateNew()
    {
        currentOrder = new PurchaseOrder { CompanyId = currentCompanyId, OrderDate = DateTime.Today, ExchangeRate = 1 };
        currencySymbol = "";
        selectedCurrencyCode = "";
        currentOrder.Lines.Add(new PurchaseOrderLine());
        activeTab = 1;
    }

    private async Task EditOrder(PurchaseOrder po)
    {
        var result = await PurchService.GetVendorCurrencyDataAsync(po.VendorId, currentCompanyId);
        currencySymbol = result.CurrencyCode;
        selectedCurrencyCode = result.CurrencyCode;

        currentOrder = new PurchaseOrder
        {
            Id = po.Id,
            CompanyId = po.CompanyId,
            VendorId = po.VendorId,
            OrderDate = po.OrderDate,
            OrderNumber = po.OrderNumber,
            Status = po.Status,
            CurrencyId = po.CurrencyId,
            ExchangeRate = po.ExchangeRate,
            TaxId = po.TaxId,
            TaxGLAccountId = po.TaxGLAccountId,
            DiscountAmount = po.DiscountAmount,
            DiscountPercentage = po.DiscountPercentage,
            DiscountGlAccountId = po.DiscountGlAccountId,
            HasReceipt = po.HasReceipt,
            IsInvoicePosted = po.IsInvoicePosted,
            Lines = po.Lines.Select(l => new PurchaseOrderLine
            {
                Id = l.Id,
                ItemId = l.ItemId,
                QuantityOrdered = l.QuantityOrdered,
                UnitCost = l.UnitCost
            }).ToList()
        };
        activeTab = 1;
    }

    private async Task OnVendorChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var venId))
        {
            currentOrder.VendorId = venId;
            var vendor = vendors.FirstOrDefault(c => c.Id == venId);

            if (vendor != null && vendor.CurrencyId != Guid.Empty)
            {
                currentOrder.CurrencyId = vendor.CurrencyId;
                currencySymbol = vendor.DefaultCurrency?.CurrencyCode ?? "";
                selectedCurrencyCode = currencySymbol;
                currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(currentCompanyId, currentOrder.CurrencyId);

                foreach (var line in currentOrder.Lines) UpdateLineItem(line);
                RecalculatePrices();
            }
            else if (currencies.Any())
            {
                var def = currencies.First();
                currentOrder.CurrencyId = def.Id;
                currencySymbol = def.CurrencyCode;
                selectedCurrencyCode = currencySymbol;
                currentOrder.ExchangeRate = await CurrService.GetLatestExchangeRateAsync(currentCompanyId, def.Id);

                foreach (var line in currentOrder.Lines) UpdateLineItem(line);
                RecalculatePrices();
            }
        }
        else
        {
            currentOrder.VendorId = Guid.Empty;
            selectedCurrencyCode = "";
            currencySymbol = "";
        }
    }

    private void OnTaxChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var taxId))
        {
            currentOrder.TaxId = taxId;
            var selectedTax = taxes.FirstOrDefault(t => t.Id == taxId);
            if (selectedTax != null)
            {
                currentOrder.TaxGLAccountId = selectedTax.GLAccountId;
            }
        }
        else
        {
            currentOrder.TaxId = null;
            currentOrder.TaxGLAccountId = null;
        }
    }

    private void AddLine() => currentOrder.Lines.Add(new PurchaseOrderLine());

    private void UpdateLineItem(PurchaseOrderLine line)
    {
        var item = items.FirstOrDefault(x => x.Id == line.ItemId);
        if (item != null)
        {
            // Always default the unit cost to 0 when an item is selected
            // so the purchasing manager is forced to enter the newly negotiated rate.
            line.UnitCost = 0;
        }
    }

    private void RecalculatePrices()
    {
        foreach (var line in currentOrder.Lines)
        {
            UpdateLineItem(line);
        }
        StateHasChanged();
    }

    private async Task SaveOrder()
    {
        if (currentOrder.VendorId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a vendor."); return; }

        isBusy = true;
        try
        {
            var err = await PurchService.SavePurchaseOrderAsync(currentOrder);
            if (!string.IsNullOrEmpty(err)) { await JS.InvokeVoidAsync("alert", err); return; }

            await JS.InvokeVoidAsync("alert", "PO Saved Successfully.");
            await LoadData();
            activeTab = 0;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task AutoPostInvoice(PurchaseOrder po)
    {
        isPostingId = po.Id;
        var err = await PurchService.AutoPostVendorBillFromPOAsync(po.Id, currentCompanyId);
        isPostingId = Guid.Empty;

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Vendor Bill posted successfully! You can now Make Payments.");
            await LoadData();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task TerminateOrder()
    {
        if (currentOrder.Id == Guid.Empty)
        {
            activeTab = 0; // Just cancel if it's a new, unsaved PO
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete {currentOrder.OrderNumber}?\n\nThis action cannot be undone.");
        if (!confirm) return;

        isBusy = true;
        try
        {
            var err = await PurchService.DeletePurchaseOrderAsync(currentOrder.Id);

            if (!string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", err);
                return;
            }

            // Success
            await LoadData();
            activeTab = 0;

            // Optional: small success toast/alert
            await JS.InvokeVoidAsync("alert", "Purchase Order deleted successfully.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"UI Error: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }
}