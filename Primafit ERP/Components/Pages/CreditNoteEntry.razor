@page "/sales/credit-notes/entry/{Id:guid?}"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject CreditNoteService CnService
@inject SegCoaService SegCoaService
@inject TransactionMappingService MappingService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PermissionCacheService PermissionCache
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

@rendermode InteractiveServer

<div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800 pb-16">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-4 border-b border-slate-200">
        <div class="space-y-1">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
                @(IsNew ? "New Invoice Adjustment Credit Note" : $"Credit Note: {currentCn.CreditNoteNumber}")
            </h1>
            <p class="text-sm font-medium @(IsPosted ? "text-emerald-600" : (IsRejected ? "text-rose-600" : "text-amber-600"))">
                @(IsPosted ? "● Posted Document - Read Only" : (IsRejected ? "● Returned for Correction" : "● Draft - Pending Approval"))
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <button type="button" @onclick='() => Nav.NavigateTo("/sales/credit-notes")' class="px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-600 font-bold hover:bg-slate-50 transition-colors shadow-sm active:scale-95">
                Back to List
            </button>

            @if (!IsNew && canConfigureRoute)
            {
                <!-- Configure Route Button -->
                <button type="button" @onclick="OpenRouteModal" class="px-4 py-2.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors flex items-center gap-1.5 shadow-sm active:scale-95">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <span>Configure Route</span>
                    @if (currentCn.CustomTransactionTypeId.HasValue)
                    {
                        <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                    }
                </button>
            }
            @if (!IsPosted && !IsNew)
            {
                <PermissionGate Key="CREDIT_NOTE_CREATE">
                    <Authorized>
                        <button type="button" @onclick="DeleteDraft" class="px-5 py-2.5 bg-white border border-slate-200 text-rose-600 text-sm font-bold rounded-xl hover:bg-rose-50 transition-colors shadow-sm active:scale-95">
                            Delete Draft
                        </button>
                        <button type="button" @onclick="SaveDraft" class="px-5 py-2.5 bg-white border border-slate-200 text-indigo-600 text-sm font-bold rounded-xl hover:bg-indigo-50 transition-colors shadow-sm active:scale-95">
                            Save Draft
                        </button>
                    </Authorized>
                </PermissionGate>
                <button type="button" @onclick="PostCreditNote" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2">
                    Submit Adjustment for GL Review
                </button>
            }
        </div>
    </div>

    @if (IsRejected && !string.IsNullOrWhiteSpace(currentBatchRejectionReason))
    {
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl text-sm text-rose-800">
            <span class="font-bold uppercase tracking-wider">GL review rejection:</span> @currentBatchRejectionReason
        </div>
    }

    @if (IsNew)
    {
        <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm max-w-xl mx-auto mt-6 space-y-6 overflow-visible relative">
            <h3 class="text-lg font-bold text-slate-900 text-center">Initialize Invoice Credit Note</h3>

            <div class="relative overflow-visible">
                <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Step 1: Select Target Customer Profile <span class="text-rose-500">*</span></label>

                <div @onclick="ToggleCustomerDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none">
                    <span class="@(selectedCustomerId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">
                        @selectedCustomerName
                    </span>
                    <svg class="w-4 h-4 text-slate-400 transition-transform @(isCustomerDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>

                @if (isCustomerDropdownOpen)
                {
                    <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl z-[100] p-3 space-y-3 animate-in fade-in zoom-in-95 duration-100">
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                            </div>
                            <input type="text" @bind="customerSearchQuery" @bind:event="oninput" class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 focus:bg-white transition-all font-medium text-slate-800" placeholder="Filter customer names..." @onclick:stopPropagation />
                        </div>
                        <div class="max-h-48 overflow-y-auto pr-1 divide-y divide-slate-50">
                            @foreach (var cust in customers.Where(c => c.Name.Contains(customerSearchQuery, StringComparison.OrdinalIgnoreCase)))
                            {
                                <div @onclick="() => SelectCustomer(cust)" class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-900 rounded-lg transition-colors cursor-pointer">
                                    @cust.Name
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (selectedCustomerId != Guid.Empty)
            {
                <div class="relative animate-in fade-in duration-300">
                    <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Step 2: Select Open Invoice Reference <span class="text-rose-500">*</span></label>
                    <select @bind="selectedInvoiceId" class="input-class font-bold bg-slate-50 focus:bg-white text-sm text-slate-900 transition-all cursor-pointer outline-none">
                        <option value="@Guid.Empty">-- Choose Target Invoice --</option>
                        @foreach (var inv in eligibleInvoices)
                        {
                            <option value="@inv.Id">@inv.OrderNumber (@inv.Date.ToString("yyyy-MM-dd"))</option>
                        }
                    </select>
                    @if (!eligibleInvoices.Any())
                    {
                        <p class="text-xs text-rose-600 font-bold mt-2">⚠️ No outstanding posted invoices available for adjustment.</p>
                    }
                </div>
            }

            <button type="button" @onclick="InitializeDraft" disabled="@(_busy || selectedInvoiceId == Guid.Empty)" class="w-full px-6 py-3.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-40">
                @if (_busy)
                {
                    <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                }
                <span>Initialize Draft Workspace</span>
            </button>
            @if (!string.IsNullOrWhiteSpace(_errMsg))
            {
                <div class="p-4 bg-rose-50 border border-rose-100 text-rose-700 text-xs font-bold rounded-xl">@_errMsg</div>
            }
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 relative z-10 overflow-visible">
            <div class="lg:col-span-4 space-y-6">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                    <h3 class="font-extrabold text-xs text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Operational Parameters</h3>
                    <div>
                        <label class="label">Adjustment Posting Date</label>
                        <input type="datetime-local" value="@currentCn.TransactionDateTime.ToString("yyyy-MM-ddTHH:mm")" @onchange="OnAdjustmentDateChanged" class="input-class font-bold" disabled="@IsPosted" />
                    </div>
                    <div>
                        <label class="label">Reason for Adjustment</label>
                        <textarea @bind="currentCn.Reason" class="input-class h-32 resize-none text-sm font-medium" placeholder="Provide invoice re-balancing justification logs..." disabled="@IsPosted"></textarea>
                    </div>
                </div>

                @if (canConfigureRoute)
                {
                <!-- Active Routing Profile Card -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                        <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Active Route</span>
                        <button type="button" @onclick="OpenRouteModal" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 transition-colors">
                            Edit Mappings
                        </button>
                    </div>
                    <div class="space-y-2 text-xs">
                        <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg">
                            <span class="text-slate-500 font-medium">Revenue Reversal (Dr):</span>
                            <span class="font-mono font-bold text-slate-800 truncate max-w-[160px]" title="@GetAccountDisplayName(currentCn.OverrideRevenueGlAccountId ?? defaultRevenueAccountId)">
                                @(GetAccountDisplayName(currentCn.OverrideRevenueGlAccountId ?? defaultRevenueAccountId))
                            </span>
                        </div>
                        <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg">
                            <span class="text-slate-500 font-medium">Customer AR (Cr):</span>
                            <span class="font-mono font-bold text-slate-800 truncate max-w-[160px]" title="@GetAccountDisplayName(currentCn.OverrideReceivablesGlAccountId ?? defaultArAccountId)">
                                @(GetAccountDisplayName(currentCn.OverrideReceivablesGlAccountId ?? defaultArAccountId))
                            </span>
                        </div>
                    </div>
                </div>
                }
            </div>

            <div class="lg:col-span-8 overflow-visible">
                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-visible flex flex-col h-full">
                    <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                        <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Line Items Value Balancing Matrix</h3>
                        <span class="text-xs font-medium text-slate-500 bg-white px-3 py-1 rounded-full border border-slate-200 font-mono font-bold">Invoice Ref: @currentCn.SalesOrder?.OrderNumber</span>
                    </div>

                    <div class="overflow-x-auto overflow-visible relative">
                        <table class="w-full text-left text-sm whitespace-nowrap overflow-visible relative" style="border-collapse: collapse;">
                            <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider relative z-20">
                                <tr>
                                    <th class="p-4 pl-6">Item Name</th>
                                    <th class="p-4 text-center">UOM</th>
                                    <th class="p-4 text-center">Invoiced Qty</th>
                                    <th class="p-4 text-center text-amber-600">Max Adjustable</th>
                                    <th class="p-4 text-center w-32">Adjustment Qty</th>
                                    <th class="p-4 text-right">Unit Price</th>
                                    <th class="p-4 text-right pr-6">Credit Total</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 overflow-visible relative z-10">
                                @foreach (var line in currentCn.Lines)
                                {
                                    <tr class="hover:bg-slate-50/80 transition-colors align-middle relative overflow-visible">
                                        <td class="p-4 pl-6 font-bold text-slate-800">@(line.Item?.Name ?? "Unknown Product Item")</td>
                                        <td class="p-4 text-center text-xs font-semibold text-slate-500">@line.UomName</td>
                                        <td class="p-4 text-center font-mono font-semibold text-slate-500">@((line.UomConversionFactor > 0 ? line.OriginalSoldQty / line.UomConversionFactor : line.OriginalSoldQty).ToString("N2"))</td>
                                        <td class="p-4 text-center font-mono font-bold text-amber-600 bg-amber-50/20">@((line.UomConversionFactor > 0 ? line.MaxReturnableQty / line.UomConversionFactor : line.MaxReturnableQty).ToString("N2"))</td>
                                        <td class="p-4">
                                            <input type="number"   value="@(line.Quantity == 0 ? "" : (line.UomConversionFactor > 0 ? line.Quantity / line.UomConversionFactor : line.Quantity).ToString("N2"))" @oninput="@(e => ValidateQuantity(line, e.Value?.ToString()))" disabled="@IsPosted" class="w-full text-center font-mono font-black border border-slate-200 bg-white rounded-lg px-2 py-1.5 appearance-none focus:border-indigo-500 focus:outline-none transition-all" />
                                        </td>
                                        <td class="p-4 text-right font-mono text-slate-500">@line.UnitPrice.ToString("N4")</td>
                                        <td class="p-4 pr-6 text-right font-mono font-black text-rose-600">@line.LineTotal.ToString("N4")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="bg-slate-50 border-t border-slate-200 p-5 flex justify-end items-center mt-auto rounded-b-2xl">
                        <div class="text-right">
                            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Total Balanced Credit to Customer (@currentCn.Currency?.CurrencyCode)</div>
                            <div class="text-2xl font-mono font-black text-slate-900">@currentCn.Lines.Sum(l => l.LineTotal).ToString("N4")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ========================================================= -->
<!-- ROUTE CONFIGURATION MODAL (WITH OVERLAPPING DROPDOWNS & 'X' BUTTONS) -->
<!-- ========================================================= -->
@if (showRouteModal)
{
    <div class="fixed inset-0 z-[120] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col overflow-visible">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                <div>
                    <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">Credit Note GL Route Mapping</h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Inspect and override accounting routes for sales returns and invoice reductions.</p>
                </div>
                <button type="button" @onclick="() => showRouteModal = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-visible space-y-5 flex-1">
                <!-- Custom Template Profile Selector -->
                <div class="p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 space-y-2 relative z-[60]">
                    <label class="block text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Transaction Routing Profile</label>
                    <div class="flex items-center gap-2">
                        @if (currentCn.CustomTransactionTypeId.HasValue)
                        {
                            <button type="button"
                                    @onclick="() => currentCn.CustomTransactionTypeId = null"
                                    class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                    title="Reset to Standard Credit Note Route">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        }
                        <select value="@(currentCn.CustomTransactionTypeId?.ToString() ?? "")" @onchange="OnCustomTemplateSelected"
                                class="input-class font-bold text-xs bg-white flex-1" disabled="@IsPosted">
                            <option value="">-- Standard Credit Note Route (Default) --</option>
                            @foreach (var custom in customTemplates)
                            {
                                <option value="@custom.Id">@custom.Name (Custom Template)</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Live Ledger Breakdown Table -->
                <div class="space-y-3 overflow-visible">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active GL Account Routing</span>

                    <div class="border border-slate-200 rounded-xl overflow-visible divide-y divide-slate-100 text-xs bg-white">

                        <!-- 1. Revenue Reversal Account (Debit) -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[50] rounded-t-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Sales Income / Revenue</span>
                                <span class="text-[10px] text-indigo-600 font-bold uppercase">Debit Side (Reversal)</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentCn.OverrideRevenueGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentCn.OverrideRevenueGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="Default Line Item Income Accounts"
                                                         Accounts="@allAccounts"
                                                         Value="@(currentCn.OverrideRevenueGlAccountId ?? defaultRevenueAccountId)"
                                                         ValueChanged="@((Guid val) => currentCn.OverrideRevenueGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                        <!-- 2. Customer AR Account (Credit) -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[40] rounded-b-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Accounts Receivable</span>
                                <span class="text-[10px] text-emerald-600 font-bold uppercase">Credit Side (Reduction)</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentCn.OverrideReceivablesGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentCn.OverrideReceivablesGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="System Default Customer AR"
                                                         Accounts="@allAccounts"
                                                         Value="@(currentCn.OverrideReceivablesGlAccountId ?? defaultArAccountId)"
                                                         ValueChanged="@((Guid val) => currentCn.OverrideReceivablesGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-2xl relative z-[10]">
                <button type="button" @onclick="() => showRouteModal = false" class="px-5 py-2 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors">
                    Close
                </button>
                <button type="button" @onclick="() => showRouteModal = false" class="px-6 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95">
                    Apply to Document
                </button>
            </div>
        </div>
    </div>
}

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: .05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.65rem 0.8rem;
        font-size: 0.875rem;
        outline: none;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }

    tr, td {
        overflow: visible !important;
    }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }

    private CreditNote currentCn = new();
    private List<Customer> customers = new();
    private List<SalesOrder> eligibleInvoices = new();
    private List<Warehouse> warehouses = new();
    private List<SegChartOfAccount> allAccounts = new();

    // Route Configuration Modal State
    private bool showRouteModal = false;
    private List<CustomTransactionType> customTemplates = new();
    private Guid defaultRevenueAccountId = Guid.Empty;
    private Guid defaultArAccountId = Guid.Empty;

    private Guid selectedCustomerId = Guid.Empty;
    private Guid selectedInvoiceId = Guid.Empty;

    private bool isCustomerDropdownOpen = false;
    private string customerSearchQuery = string.Empty;
    private string selectedCustomerName = "-- Choose Target Customer Profile --";

    private bool _busy = false;
    private string _errMsg = string.Empty;
    private bool canConfigureRoute = false;

    private bool IsNew => Id == null;
    private BatchStatus? currentBatchStatus;
    private string? currentBatchRejectionReason;
    private bool IsRejected => currentBatchStatus == BatchStatus.Rejected;
    private bool IsPosted => currentCn.Status == CreditNoteStatus.Posted
        && currentBatchStatus != BatchStatus.Ready
        && currentBatchStatus != BatchStatus.Rejected
        && currentBatchStatus != BatchStatus.Draft;

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("CREDIT_NOTE_PAGE")) { Nav.NavigateTo("/access-denied"); return; }

        using var ctx = await DbFactory.CreateDbContextAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user?.CompanyDetailsId == null) return;

        Guid companyId = user.CompanyDetailsId.Value;
        canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(companyId);
        warehouses = await ctx.Warehouses.AsNoTracking().Where(w => w.CompanyId == companyId).ToListAsync();
        customers = await ctx.Customers.AsNoTracking().Where(c => c.CompanyId == companyId).OrderBy(c => c.Name).ToListAsync();
        allAccounts = await SegCoaService.GetCoaAsync(companyId);

        defaultRevenueAccountId = await MappingService.GetMappedAccountAsync(
            companyId, SystemTransactionType.CreditNote, isDebit: true, defaultAccountId: Guid.Empty);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!IsNew)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var cn = await CnService.GetByIdAsync(Id.Value, user.CompanyDetailsId ?? Guid.Empty);
            if (cn != null)
            {
                currentCn = cn;
                var batch = cn.GlBatchId.HasValue
                    ? await ctx.GLBatches.AsNoTracking().FirstOrDefaultAsync(b => b.Id == cn.GlBatchId.Value && b.CompanyId == cn.CompanyId)
                    : null;
                currentBatchStatus = batch?.Status;
                currentBatchRejectionReason = batch?.RejectionReason;
                var customer = customers.FirstOrDefault(c => c.Id == currentCn.CustomerId);
                defaultArAccountId = customer?.ReceivablesAccountId ?? Guid.Empty;
            }
            else Nav.NavigateTo("/sales/credit-notes");
        }
    }

    private void ToggleCustomerDropdown() => isCustomerDropdownOpen = !isCustomerDropdownOpen;

    private async Task SelectCustomer(Customer cust)
    {
        selectedCustomerId = cust.Id;
        selectedCustomerName = cust.Name;
        isCustomerDropdownOpen = false;
        customerSearchQuery = string.Empty;

        selectedInvoiceId = Guid.Empty;
        eligibleInvoices.Clear();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        _busy = true; StateHasChanged();
        eligibleInvoices = await CnService.GetInvoicesEligibleForAdjustmentAsync(user.CompanyDetailsId.Value, selectedCustomerId);
        _busy = false; StateHasChanged();
    }

    private async Task InitializeDraft()
    {
        if (selectedInvoiceId == Guid.Empty) return;
        _busy = true; _errMsg = string.Empty; StateHasChanged();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            var cn = await CnService.CreateStockReturnDraftAsync(selectedInvoiceId, Guid.Parse(user.Id));
            Nav.NavigateTo($"/sales/credit-notes/entry/{cn.Id}");
        }
        catch (Exception ex) { _errMsg = ex.Message; }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task OpenRouteModal()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        customTemplates = await ctx.CustomTransactionTypes
            .AsNoTracking()
            .Where(t => t.CompanyId == currentCn.CompanyId)
            .OrderBy(t => t.Name)
            .ToListAsync();

        var customer = customers.FirstOrDefault(c => c.Id == currentCn.CustomerId);
        defaultArAccountId = customer?.ReceivablesAccountId ?? Guid.Empty;

        showRouteModal = true;
    }

    private async Task OnCustomTemplateSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var customId) && customId != Guid.Empty)
        {
            currentCn.CustomTransactionTypeId = customId;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var map = await ctx.TransactionGlMappings
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.CompanyId == currentCn.CompanyId && m.CustomTransactionTypeId == customId);

            if (map != null)
            {
                if (map.OverrideDebitGlAccountId.HasValue)
                    currentCn.OverrideRevenueGlAccountId = map.OverrideDebitGlAccountId.Value;

                if (map.OverrideCreditGlAccountId.HasValue)
                    currentCn.OverrideReceivablesGlAccountId = map.OverrideCreditGlAccountId.Value;
            }
        }
        else
        {
            currentCn.CustomTransactionTypeId = null;
        }
    }

    private string GetAccountDisplayName(Guid accountId)
    {
        if (accountId == Guid.Empty) return "System Default";
        var acc = allAccounts.FirstOrDefault(a => a.Id == accountId);
        return acc != null ? $"{acc.AccountCode} - {acc.Description}" : "System Default";
    }

    private void OnAdjustmentDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var parsedDateTime))
        {
            currentCn.TransactionDateTime = parsedDateTime;
            currentCn.Date = DateOnly.FromDateTime(parsedDateTime);
        }
    }

    private void ValidateQuantity(CreditNoteLine line, string? val)
    {
        if (decimal.TryParse(val, out decimal res))
        {
            var factor = line.UomConversionFactor > 0 ? line.UomConversionFactor : 1m;
            if (res < 0) line.Quantity = 0;
            else if (res > line.MaxReturnableQty / factor) line.Quantity = line.MaxReturnableQty;
            else line.Quantity = res * factor;
        }
        else line.Quantity = 0;
        StateHasChanged();
    }

    private async Task SaveDraft()
    {
        var err = await CnService.SaveDraftAsync(currentCn);
        if (string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", "Draft Workspace parameters saved successfully.");
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task PostCreditNote()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Execute ledger posting? This will re-balance the invoice financial components instantly.")) return;

        await SaveDraft();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        var err = await CnService.PostStockCreditNoteAsync(currentCn.Id, Guid.Parse(user.Id));
        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Invoice adjustment submitted for GL review.");
            Nav.NavigateTo("/sales/credit-notes");
        }
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task DeleteDraft()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Permanently clear draft payload data?")) return;
        await CnService.DeleteDraftAsync(currentCn.Id);
        Nav.NavigateTo("/sales/credit-notes");
    }
}
