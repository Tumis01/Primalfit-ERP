@page "/wh/shipments/new"
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Components.Shared
@using Primafit_ERP.Services
@using PrimafitERP.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ShipmentDraftService DraftService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject PermissionCacheService PermissionCache
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>New Shipment</PageTitle>
<div class="mx-auto max-w-[1400px] space-y-6 px-4 py-8 font-sans text-slate-800">
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div><h1 class="text-2xl font-bold text-slate-900">New Shipment</h1><p class="mt-1 text-sm text-slate-500">Select a customer, warehouse, and source document lines.</p></div><a href="/wh/shipments" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-bold text-slate-600">All Shipments</a></div>
    @if (!string.IsNullOrWhiteSpace(message)) { <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">@message</div> }
    @if (loading) { <div class="p-8 text-center text-slate-400">Loading shipment details...</div> }
    else if (companyId != Guid.Empty)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-6">
            <div class="grid gap-4 rounded-xl border border-slate-200 bg-slate-50 p-5 md:grid-cols-3"><SearchableGuidSelect Label="Customer" Required="true" Options="@CustomerOptions" Value="@customerId" ValueChanged="OnCustomerChanged" Placeholder="Search customer" /><SearchableGuidSelect Label="Warehouse" Required="true" Options="@WarehouseOptions" Value="@warehouseId" ValueChanged="@(id => warehouseId = id)" Placeholder="Search warehouse" /><fieldset><legend class="block text-[10px] font-extrabold uppercase tracking-wider text-slate-500 mb-1.5">Source document</legend><div class="flex gap-2"><button type="button" @onclick="() => ChangeSource(false)" aria-pressed="@(!invoiceSource)" class="rounded-xl border px-3 py-2 text-sm font-semibold @(invoiceSource ? "border-slate-200 text-slate-600" : "border-indigo-600 bg-indigo-50 text-indigo-700")">Sales order</button><button type="button" @onclick="() => ChangeSource(true)" aria-pressed="@invoiceSource" class="rounded-xl border px-3 py-2 text-sm font-semibold @(invoiceSource ? "border-indigo-600 bg-indigo-50 text-indigo-700" : "border-slate-200 text-slate-600")">Posted invoice</button></div></fieldset></div>
            @if (!customerId.HasValue)
            {
                <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-6 text-sm text-slate-600">Select a customer to find their available source lines. Then select a warehouse and enter the quantity to ship.</div>
            }
            @if (customerId.HasValue)
            {
                <div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-sm font-bold text-slate-900">Available @(invoiceSource ? "invoice" : "order") lines</h2><p class="mt-1 text-xs text-slate-600">Select a document header for all displayed lines, or choose individual lines. Enter a quantity for each selected line.</p></div><input type="search" @bind="search" @bind:event="oninput" aria-label="Search documents and items" placeholder="Search document number or item" class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100 md:max-w-sm" /></div>
                <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600"><span aria-live="polite">@lines.Count(x => x.Selected) selected · @Filtered.Count() displayed</span><div class="flex gap-4"><button type="button" @onclick="SelectVisible" disabled="@(!Filtered.Any())" class="font-bold text-indigo-700 disabled:opacity-50">Select displayed lines</button><button type="button" @onclick="ClearSelected" disabled="@(!lines.Any(x => x.Selected))" class="font-bold text-slate-600 disabled:opacity-50">Clear selection</button></div></div>
                <div class="overflow-x-auto rounded-xl border border-slate-200"><div class="transaction-lines-scroll" role="region" aria-label="Transaction line items" tabindex="0"><table class="transaction-lines w-full min-w-[1000px] text-left text-sm"><thead class="bg-slate-50 text-xs font-bold uppercase text-slate-500"><tr><th class="p-3">Select</th><th class="p-3">Document / Item</th><th class="p-3 text-right">@(invoiceSource ? "Invoiced" : "Ordered")</th><th class="p-3 text-right">Shipped</th><th class="p-3 text-right">Reserved</th><th class="p-3 text-right">Available</th><th class="p-3">Shipment UOM</th><th class="p-3 text-right">Quantity to ship</th></tr></thead><tbody class="divide-y divide-slate-100">
                @foreach (var group in Filtered.GroupBy(x => x.Source.OrderId))
                {
                    var first = group.First();
                    <tr class="bg-slate-50 font-bold"><td class="p-3"><input type="checkbox" checked="@group.All(x => x.Selected)" @onchange="e => ToggleGroup(group, e)" aria-label="Select displayed lines from @first.Source.OrderNumber" /></td><td colspan="7" class="p-3 font-mono">@first.Source.OrderNumber</td><th class="p-3">Dimensions</th></tr>
                    @foreach (var line in group) { <tr @key="line.Source.LineId" class="@(line.Selected ? "bg-indigo-50/30" : "")"><td class="p-3"><input type="checkbox" @bind="line.Selected" aria-label="Select @line.Source.ItemName from @line.Source.OrderNumber" class="accent-indigo-600" /></td><td class="p-3 font-semibold">@line.Source.ItemName</td><td class="p-3 text-right font-mono">@Display(line.Source.Ordered, line).ToString("N4")</td><td class="p-3 text-right font-mono">@Display(line.Source.Shipped, line).ToString("N4")</td><td class="p-3 text-right font-mono">@Display(line.Source.Reserved, line).ToString("N4")</td><td class="p-3 text-right font-mono font-bold">@Display(line.Source.Remaining, line).ToString("N4")</td><td class="p-3 min-w-[160px]"><SearchableGuidSelect Options="@UomOptions(line)" Value="@line.UomId" ValueChanged="@(id => SetUom(line, id))" Disabled="@(!line.Selected || UomOptions(line).Count == 0)" AllowClear="false" Placeholder="Search unit" InlineMenu="true" /></td><td class="p-3"><input type="number" min="0" step="0.0001" value="@Number(Display(line.QuantityBase, line))" @onchange="e => SetQuantity(line, e)" disabled="@(!line.Selected)" aria-invalid="@(showQuantityErrors && line.Selected && !ValidQuantity(line) ? "true" : "false")" aria-label="Quantity to ship for @line.Source.ItemName from @line.Source.OrderNumber" class="w-32 rounded-lg border @(showQuantityErrors && line.Selected && !ValidQuantity(line) ? "border-rose-500" : "border-slate-200") p-2 text-right font-mono disabled:bg-slate-100" />@if (showQuantityErrors && line.Selected && !ValidQuantity(line)) { <span class="block mt-1 text-xs text-rose-700">Enter a positive quantity up to @Display(line.Source.Remaining, line).ToString("N4") @line.UomName.</span> }</td><td class="p-3"><DimensionSelect CompanyId="@companyId" @bind-Value="line.DimensionSetId" Disabled="@(!line.Selected)" /></td></tr> }
                }
                @if (!Filtered.Any()) { <tr><td colspan="8" class="p-10 text-center text-slate-400">No available source lines match the selection.</td></tr> }
                </tbody></table></div></div>
                <p class="text-xs text-slate-500">Quantities are shown in the selected shipment unit. Saving reserves them until the draft is processed or deleted. Selections remain when you search.</p>
                @if (lines.Any(x => x.Selected))
                {
                    <section class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4" aria-label="Selected shipment lines"><h3 class="text-sm font-bold text-slate-900">Shipment selection</h3><p class="mt-1 text-xs text-slate-600">Review all selected lines, including those hidden by the search.</p><ul class="mt-3 divide-y divide-indigo-100">@foreach (var line in lines.Where(x => x.Selected)) { <li @key="line.Source.LineId" class="flex flex-wrap items-center justify-between gap-2 py-2 text-sm"><span><span class="font-mono text-xs text-indigo-700">@line.Source.OrderNumber</span> · @line.Source.ItemName</span><span class="font-mono">@Display(line.QuantityBase, line).ToString("N4") @line.UomName <button type="button" @onclick="() => line.Selected = false" aria-label="Remove @line.Source.ItemName from @line.Source.OrderNumber" class="ml-2 font-sans text-xs font-bold text-rose-700">Remove</button></span></li> }</ul></section>
                }
            }
            <div class="flex justify-end gap-3 border-t border-slate-200 pt-5"><a href="/wh/shipments" class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-bold text-slate-600">Cancel</a><button type="button" @onclick="Save" disabled="@(saving || !customerId.HasValue || !warehouseId.HasValue || !lines.Any(x => x.Selected))" class="rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white disabled:opacity-50">@(saving ? "Saving..." : "Save Shipment Draft")</button></div>
        </div>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "order")] public Guid? InitialOrderId { get; set; }
    private sealed class DraftRow { public Guid? DimensionSetId { get; set; } public required ShipmentOrderCandidate Source { get; init; } public bool Selected { get; set; } public decimal QuantityBase { get; set; } public Guid? UomId { get; set; } public string UomName { get; set; } = ""; public decimal Factor { get; set; } = 1; }
    private Guid companyId; private Guid? customerId, warehouseId; private string message = "", search = ""; private bool loading = true, saving, showQuantityErrors, invoiceSource;
    private List<Customer> customers = new(); private List<Warehouse> warehouses = new(); private List<Item> items = new(); private List<UnitOfMeasure> uoms = new(); private List<UomConversionRule> rules = new(); private List<ItemUomConversionLine> itemUoms = new(); private List<DraftRow> lines = new();
    private IReadOnlyCollection<DropdownOption> CustomerOptions => customers.Select(x => new DropdownOption(x.Id, x.Name)).ToList();
    private IReadOnlyCollection<DropdownOption> WarehouseOptions => warehouses.Select(x => new DropdownOption(x.Id, x.Name)).ToList();
    private IReadOnlyDictionary<(Guid, Guid), decimal> ConversionMap => rules.ToDictionary(x => (x.FromUomId, x.ToUomId), x => x.ConversionFactor);
    private IEnumerable<DraftRow> Filtered => lines.Where(x => string.IsNullOrWhiteSpace(search) || x.Source.OrderNumber.Contains(search, StringComparison.OrdinalIgnoreCase) || x.Source.ItemName.Contains(search, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyCollection<DropdownOption> UomOptions(DraftRow row) { var item = items.FirstOrDefault(x => x.Id == row.Source.ItemId); if (item == null) return Array.Empty<DropdownOption>(); var ids = item.UomId.HasValue ? UomConversion.ConfiguredUoms(item).ToHashSet() : new HashSet<Guid>(); foreach (var unit in itemUoms.Where(x => x.ItemId == item.Id)) ids.Add(unit.UomId); return uoms.Where(x => ids.Contains(x.Id)).Select(x => new DropdownOption(x.Id, x.Name)).ToList(); }
    private static decimal Display(decimal baseQty, DraftRow row) => UomConversion.FromBase(baseQty, row.Factor);
    private static string Number(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);
    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SHIPMENT_CREATE")) { Navigation.NavigateTo("/access-denied"); return; }
        var user = await UserManager.GetUserAsync((await AuthenticationStateProvider.GetAuthenticationStateAsync()).User); companyId = user?.CompanyDetailsId ?? Guid.Empty;
        if (companyId != Guid.Empty) { await using var db = await DbFactory.CreateDbContextAsync(); customers = await db.Customers.AsNoTracking().Where(x => x.CompanyId == companyId).OrderBy(x => x.Name).ToListAsync(); warehouses = await db.Warehouses.AsNoTracking().Where(x => x.CompanyId == companyId && (x.Type == WarehouseType.Sales || x.Type == WarehouseType.Both)).OrderBy(x => x.Name).ToListAsync(); items = await db.Items.Include(x => x.UomConversions).AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); uoms = await db.UnitOfMeasures.AsNoTracking().Where(x => x.CompanyId == companyId).ToListAsync(); rules = await db.UomConversionRules.AsNoTracking().Where(x => x.CompanyId == companyId && x.IsActive).ToListAsync(); itemUoms = await db.ItemUomConversionLines.AsNoTracking().Where(x => x.IsActive && x.Item!.CompanyId == companyId).ToListAsync(); if (InitialOrderId.HasValue) { var order = await db.SalesOrders.AsNoTracking().FirstOrDefaultAsync(x => x.Id == InitialOrderId && x.CompanyId == companyId); if (order != null) { await OnCustomerChanged(order.CustomerId); foreach (var line in lines.Where(x => x.Source.OrderId == order.Id)) line.Selected = true; } } }
        loading = false;
    }
    private async Task OnCustomerChanged(Guid? id) { if (id == customerId) return; if (lines.Any(x => x.Selected) && !await JS.InvokeAsync<bool>("confirm", "Changing the customer will remove the selected shipment lines. Continue?")) return; customerId = id; message = ""; search = ""; showQuantityErrors = false; lines = id.HasValue ? (await LoadCandidates(id.Value)).Select(NewRow).ToList() : new(); }
    private Task<List<ShipmentOrderCandidate>> LoadCandidates(Guid id) => invoiceSource ? DraftService.GetInvoiceCandidatesAsync(companyId, id) : DraftService.GetOrderCandidatesAsync(companyId, id);
    private async Task ChangeSource(bool value) { if (invoiceSource == value) return; if (lines.Any(x => x.Selected) && !await JS.InvokeAsync<bool>("confirm", "Changing the source document will remove the selected shipment lines. Continue?")) return; invoiceSource = value; search = ""; message = ""; showQuantityErrors = false; lines = customerId.HasValue ? (await LoadCandidates(customerId.Value)).Select(NewRow).ToList() : new(); }
    private DraftRow NewRow(ShipmentOrderCandidate source) { var row = new DraftRow { DimensionSetId = source.DimensionSetId, Source = source, UomId = source.UomId, UomName = source.UomName }; var item = items.First(x => x.Id == source.ItemId); if (row.UomId.HasValue && !UomOptions(row).Any(x => x.Id == row.UomId)) { row.UomId = item.UomId; row.UomName = uoms.FirstOrDefault(x => x.Id == item.UomId)?.Name ?? item.UoM; } var factors = itemUoms.Where(x => x.ItemId == item.Id).GroupBy(x => x.UomId).ToDictionary(x => x.Key, x => x.First().ConversionFactorToBase); row.Factor = UomConversion.FactorFor(item, row.UomId, factors, ConversionMap); return row; }
    private static void ToggleGroup(IEnumerable<DraftRow> rows, ChangeEventArgs e) { foreach (var row in rows) row.Selected = e.Value is bool b && b; }
    private void SelectVisible() { foreach (var row in Filtered) row.Selected = true; }
    private void ClearSelected() { foreach (var row in lines) row.Selected = false; showQuantityErrors = false; }
    private static bool ValidQuantity(DraftRow row) => row.QuantityBase > 0 && !UomConversion.Exceeds(row.QuantityBase, row.Source.Remaining);
    private void SetUom(DraftRow row, Guid? id) { var item = items.First(x => x.Id == row.Source.ItemId); if (!id.HasValue || !UomOptions(row).Any(x => x.Id == id)) return; row.UomId = id; row.UomName = uoms.First(x => x.Id == id).Name; var factors = itemUoms.Where(x => x.ItemId == item.Id).GroupBy(x => x.UomId).ToDictionary(x => x.Key, x => x.First().ConversionFactorToBase); row.Factor = UomConversion.FactorFor(item, id, factors, ConversionMap); }
    private static void SetQuantity(DraftRow row, ChangeEventArgs e) { row.QuantityBase = decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var value) ? UomConversion.ToBase(value, row.Factor) : 0; }
    private async Task Save() { if (saving || !customerId.HasValue || !warehouseId.HasValue) return; var selected = lines.Where(x => x.Selected).ToList(); var invalid = selected.FirstOrDefault(x => !ValidQuantity(x)); if (invalid != null) { showQuantityErrors = true; message = $"Enter a positive quantity up to the available balance for {invalid.Source.ItemName} on {invalid.Source.OrderNumber}. Clear the search if this line is hidden."; return; } saving = true; try { var inputs = selected.Select(x => new ShipmentDraftLineInput(x.Source.LineId, x.QuantityBase, x.UomId, x.UomName, x.Factor, x.DimensionSetId, true)).ToList(); var result = invoiceSource ? await DraftService.CreateInvoiceDraftAsync(companyId, customerId.Value, warehouseId.Value, inputs) : await DraftService.CreateOrderDraftAsync(companyId, customerId.Value, warehouseId.Value, inputs); if (result.Error != null) message = result.Error; else Navigation.NavigateTo("/wh/shipments"); } finally { saving = false; } }
}
