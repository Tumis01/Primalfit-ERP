@page "/setup/ap-transaction-types"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore

@inject TransactionMappingService MappingService
@inject SegCoaService SegCoaService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 mt-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-2">
                <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">AP & Procurement</span>
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">AP Transaction Types</h1>
            </div>
            <p class="text-sm text-slate-500 mt-1">Configure global ledger overrides, define custom AP transactional routing templates, and manage AP default accounts.</p>
        </div>
        <button @onclick="OpenCreateModal" class="px-5 py-2.5 bg-slate-900 text-white font-bold text-sm rounded-xl hover:bg-slate-800 transition-all flex items-center gap-2 active:scale-95 shadow-sm">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>Add Transaction Type</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse bg-white border border-slate-200 rounded-2xl">
            Loading AP Transaction Routes...
        </div>
    }
    else
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap min-w-[950px]">
                    <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="p-4 w-[24%] pl-6">Transaction Type</th>
                            <th class="p-4 w-[28%]">Page Link</th>
                            <th class="p-4 w-[20%]">Debit Account </th>
                            <th class="p-4 w-[20%]">Credit Account</th>
                            <th class="p-4 text-center w-[8%] pr-6">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var map in apMappings)
                        {
                            bool isCustom = map.TransactionType == SystemTransactionType.CustomGlAdjustment;

                            <tr class="hover:bg-slate-50 transition-colors group @(isCustom ? "bg-amber-50/10" : "")">
                                <td class="p-4 pl-6 font-bold text-slate-800">
                                    <div class="flex items-center gap-2">
                                        @if (isCustom)
                                        {
                                            <span class="inline-flex h-2 w-2 rounded-full bg-amber-500 shrink-0"></span>
                                            <span class="truncate max-w-[240px]" title="@(map.CustomTransactionType?.Name ?? "Custom Template")">
                                                @(map.CustomTransactionType?.Name ?? "Custom Template")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>@GetApRouteTitle(map.TransactionType)</span>
                                        }
                                    </div>
                                    <span class="block text-[11px] text-slate-400 font-normal truncate max-w-xs" title="@GetApRouteDescription(map)">
                                        @GetApRouteDescription(map)
                                    </span>
                                </td>

                                <td class="p-4">
                                    @if (isCustom)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 text-xs font-semibold">
                                            Custom Template Route
                                        </span>
                                    }
                                    else
                                    {
                                        var link = GetApNavLink(map.TransactionType);
                                        @if (!string.IsNullOrEmpty(link.Href))
                                        {
                                            <a href="@link.Href" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 text-xs font-semibold transition-colors border border-slate-200">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                                </svg>
                                                <span>@link.Label</span>
                                            </a>
                                        }
                                    }
                                </td>

                                <td class="p-4">
                                    @if (map.OverrideDebitGlAccountId.HasValue)
                                    {
                                        <div class="font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-100 inline-block text-xs truncate max-w-[180px]">
                                            @GetAccountDisplayName(map.OverrideDebitGlAccountId)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-slate-400 font-medium italic">
                                            @(isCustom ? "Variable Selection" : GetDefaultDescription(map.TransactionType, true))
                                        </div>
                                    }
                                </td>

                                <td class="p-4">
                                    @if (map.OverrideCreditGlAccountId.HasValue)
                                    {
                                        <div class="font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-100 inline-block text-xs truncate max-w-[180px]">
                                            @GetAccountDisplayName(map.OverrideCreditGlAccountId)
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-slate-400 font-medium italic">
                                            @(isCustom ? "Variable Selection" : GetDefaultDescription(map.TransactionType, false))
                                        </div>
                                    }
                                </td>

                                <td class="p-4 text-center pr-6">
                                    <div class="flex items-center justify-center gap-1.5">
                                        <button @onclick="() => OpenEditModal(map)" class="px-3 py-1.5 text-xs font-bold text-emerald-700 bg-white border border-slate-200 rounded-lg shadow-sm hover:bg-emerald-50 transition-colors opacity-100 md:opacity-0 group-hover:opacity-100">
                                            Configure
                                        </button>
                                        @if (isCustom)
                                        {
                                            <button @onclick="() => DeleteCustomType(map)" class="px-2.5 py-1.5 text-xs font-bold text-rose-600 bg-white border border-slate-200 rounded-lg shadow-sm hover:bg-rose-50 hover:text-rose-700 transition-colors opacity-100 md:opacity-0 group-hover:opacity-100" title="Delete Custom Template">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showModal)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">
                    @if (isCreatingCustom)
                    {
                        <span class="text-emerald-700">Define Custom AP Transaction Template</span>
                    }
                    else
                    {
                        <span>Configure Route: <span class="text-emerald-700">@(editingMap?.TransactionType == SystemTransactionType.CustomGlAdjustment ? editingMap.CustomTransactionType?.Name : GetApRouteTitle(editingMap?.TransactionType ?? SystemTransactionType.PurchaseInvoice))</span></span>
                    }
                </h3>
                <button type="button" @onclick="CloseModal" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-visible flex-1 space-y-4">
                @if (isCreatingCustom || (editingMap != null && editingMap.TransactionType == SystemTransactionType.CustomGlAdjustment))
                {
                    <div class="space-y-4 animate-in fade-in duration-300">
                        <div>
                            <label class="label">Custom Template Name <span class="text-rose-500">*</span></label>
                            <input type="text" @bind="newCustomName" class="input-class" placeholder="e.g. Supplier Prepayment Settlement Offset" />
                        </div>
                        <div>
                            <label class="label">Functional Workflow Description</label>
                            <input type="text" @bind="newCustomDesc" class="input-class" placeholder="Describe the procurement/payable business scenario..." />
                        </div>
                    </div>
                    <hr class="border-slate-200/60 my-2" />
                }

                <div class="space-y-2 relative z-50">
                    <div class="flex justify-between items-center">
                        <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Debit Account Override Mapping</label>
                        @if (tempDebit.HasValue)
                        {
                            <button type="button" @onclick="() => tempDebit = null" class="text-[9px] font-bold text-rose-500 hover:text-rose-700 uppercase tracking-wider bg-rose-50 px-2 py-0.5 rounded border border-rose-100">
                                Clear Override
                            </button>
                        }
                    </div>
                    <SearchableGlAccount Label=""
                                         Placeholder="@(isCreatingCustom ? "Select Default Debit Account (Optional)..." : GetDefaultDescription(editingMap?.TransactionType ?? SystemTransactionType.PurchaseInvoice, true))"
                                         Accounts="@coaList"
                                         Value="@(tempDebit ?? Guid.Empty)"
                                         ValueChanged="@((Guid val) => tempDebit = val == Guid.Empty ? null : val)" />
                </div>

                <div class="h-2"></div>

                <div class="space-y-2 relative z-30">
                    <div class="flex justify-between items-center">
                        <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Credit Account Override Mapping</label>
                        @if (tempCredit.HasValue)
                        {
                            <button type="button" @onclick="() => tempCredit = null" class="text-[9px] font-bold text-rose-500 hover:text-rose-700 uppercase tracking-wider bg-rose-50 px-2 py-0.5 rounded border border-rose-100">
                                Clear Override
                            </button>
                        }
                    </div>
                    <SearchableGlAccount Label=""
                                         Placeholder="@(isCreatingCustom ? "Select Default Credit Account (Optional)..." : GetDefaultDescription(editingMap?.TransactionType ?? SystemTransactionType.PurchaseInvoice, false))"
                                         Accounts="@coaList"
                                         Value="@(tempCredit ?? Guid.Empty)"
                                         ValueChanged="@((Guid val) => tempCredit = val == Guid.Empty ? null : val)" />
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-2xl">
                <button @onclick="CloseModal" class="px-5 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors" disabled="@isSaving">
                    Cancel
                </button>
                <button @onclick="ApplyAndSaveModal" class="px-6 py-2.5 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-1.5" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="animate-spin h-3 w-3 border-2 border-white border-t-transparent rounded-full"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Apply Changes</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        color: #0f172a;
        outline: none;
        transition: all 0.2s;
    }

    .input-class:focus {
        border-color: #059669;
        box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }
</style>

@code {
    private Guid currentCompanyId;
    private string currentUserId = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showModal = false;
    private bool isCreatingCustom = false;

    private List<TransactionGlMapping> apMappings = new();
    private List<SegChartOfAccount> coaList = new();

    private string newCustomName = string.Empty;
    private string newCustomDesc = string.Empty;

    private TransactionGlMapping? editingMap;
    private Guid? tempDebit;
    private Guid? tempCredit;
    private static readonly HashSet<SystemTransactionType> ApTransactionScope = new()
    {
        SystemTransactionType.PurchaseInvoice,
        SystemTransactionType.DirectPurchaseInvoice,
        SystemTransactionType.ApAdjustment,
        SystemTransactionType.VendorPayment,
        SystemTransactionType.VendorReturnStock,
        SystemTransactionType.VendorReturnRefund,
        SystemTransactionType.DebitNote,
        SystemTransactionType.GoodsReceipt,
        SystemTransactionType.DiscountReceived
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;
            await RefreshDataset();
        }
        isLoading = false;
    }

    private async Task RefreshDataset()
    {
        coaList = await SegCoaService.GetActiveCoaAsync(currentCompanyId);
        await MappingService.GetMappingsAsync(currentCompanyId);

        using var ctx = await DbFactory.CreateDbContextAsync();
        var allMappings = await ctx.TransactionGlMappings
            .AsNoTracking()
            .Include(m => m.CustomTransactionType)
            .Where(m => m.CompanyId == currentCompanyId)
            .ToListAsync();

        apMappings = allMappings
            .Where(m => m.TransactionType == SystemTransactionType.CustomGlAdjustment 
                     || ApTransactionScope.Contains(m.TransactionType))
            .OrderBy(m => m.TransactionType == SystemTransactionType.CustomGlAdjustment ? 1 : 0)
            .ThenBy(m => m.TransactionType)
            .ThenBy(m => m.CustomTransactionType?.Name)
            .ToList();
    }

    private void OpenCreateModal()
    {
        isCreatingCustom = true;
        editingMap = null;
        newCustomName = string.Empty;
        newCustomDesc = string.Empty;
        tempDebit = null;
        tempCredit = null;
        showModal = true;
    }

    private void OpenEditModal(TransactionGlMapping map)
    {
        isCreatingCustom = false;
        editingMap = map;
        tempDebit = map.OverrideDebitGlAccountId;
        tempCredit = map.OverrideCreditGlAccountId;

        if (map.TransactionType == SystemTransactionType.CustomGlAdjustment && map.CustomTransactionType != null)
        {
            newCustomName = map.CustomTransactionType.Name;
            newCustomDesc = map.CustomTransactionType.Description;
        }
        else
        {
            newCustomName = string.Empty;
            newCustomDesc = string.Empty;
        }
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task ApplyAndSaveModal()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        isSaving = true;

        try
        {
            if (isCreatingCustom)
            {
                if (string.IsNullOrWhiteSpace(newCustomName))
                {
                    await JS.InvokeVoidAsync("alert", "Validation Error: A Template Name is required.");
                    isSaving = false;
                    return;
                }

                bool nameExists = await ctx.CustomTransactionTypes.AnyAsync(x => x.CompanyId == currentCompanyId && x.Name.ToLower() == newCustomName.ToLower());
                if (nameExists)
                {
                    await JS.InvokeVoidAsync("alert", $"Validation Error: A template named '{newCustomName}' already exists.");
                    isSaving = false;
                    return;
                }

                var customRecord = new CustomTransactionType
                {
                    Id = Guid.NewGuid(),
                    CompanyId = currentCompanyId,
                    Name = newCustomName.Trim(),
                    Description = newCustomDesc.Trim(),
                    CreatedByUserId = currentUserId,
                    CreatedAt = DateTime.UtcNow
                };

                var routingRecord = new TransactionGlMapping
                {
                    Id = Guid.NewGuid(),
                    CompanyId = currentCompanyId,
                    TransactionType = SystemTransactionType.CustomGlAdjustment,
                    CustomTransactionTypeId = customRecord.Id,
                    OverrideDebitGlAccountId = tempDebit,
                    OverrideCreditGlAccountId = tempCredit,
                    IsActive = true,
                    UpdatedByUserId = currentUserId,
                    UpdatedAt = DateTime.UtcNow
                };

                ctx.CustomTransactionTypes.Add(customRecord);
                ctx.TransactionGlMappings.Add(routingRecord);
            }
            else if (editingMap != null)
            {
                var targetRecord = await ctx.TransactionGlMappings.FindAsync(editingMap.Id);
                if (targetRecord != null)
                {
                    targetRecord.OverrideDebitGlAccountId = tempDebit;
                    targetRecord.OverrideCreditGlAccountId = tempCredit;
                    targetRecord.UpdatedByUserId = currentUserId;
                    targetRecord.UpdatedAt = DateTime.UtcNow;

                    if (targetRecord.TransactionType == SystemTransactionType.CustomGlAdjustment && targetRecord.CustomTransactionTypeId.HasValue)
                    {
                        var existingCustom = await ctx.CustomTransactionTypes.FindAsync(targetRecord.CustomTransactionTypeId.Value);
                        if (existingCustom != null)
                        {
                            existingCustom.Name = newCustomName.Trim();
                            existingCustom.Description = newCustomDesc.Trim();
                        }
                    }
                }
            }

            await ctx.SaveChangesAsync();
            await RefreshDataset();
            showModal = false;
            await JS.InvokeVoidAsync("alert", "Changes saved successfully!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Save Operation Rejected: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCustomType(TransactionGlMapping map)
    {
        bool confirm = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete template '{map.CustomTransactionType?.Name}'?");
        if (!confirm) return;

        try
        {
            bool deleted = await MappingService.DeleteCustomTransactionTypeAsync(map.Id, currentCompanyId);
            if (deleted)
            {
                await RefreshDataset();
                await JS.InvokeVoidAsync("alert", "Custom transaction template deleted successfully.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Could not locate template to delete.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private string GetAccountDisplayName(Guid? accountId)
    {
        if (!accountId.HasValue || accountId.Value == Guid.Empty) return "";
        var acc = coaList.FirstOrDefault(a => a.Id == accountId.Value);
        return acc != null ? $"{acc.AccountCode} - {acc.Description}" : "Unknown Account";
    }

    

    private (string Label, string Href) GetApNavLink(SystemTransactionType type)
    {
        return type switch
        {
            SystemTransactionType.PurchaseInvoice => ("Purchase Orders", "procurement/purchase-orders"),
            SystemTransactionType.DirectPurchaseInvoice => ("Direct Invoice", "/ap/direct-bills"),
            SystemTransactionType.ApAdjustment => ("AP Adjustment / Balances", "/finance/ap-adjustments"),
            SystemTransactionType.VendorPayment => ("Vendor Bills", "ap/bill-entry"),
            SystemTransactionType.VendorReturnStock => ("Stock Returns", "/purchases/vendor-returns"),
            SystemTransactionType.VendorReturnRefund => ("Cash Refunds", "/purchases/vendor-returns"),
            SystemTransactionType.DebitNote => ("Debit Note Entry", "/ap/debit-note"),
            SystemTransactionType.GoodsReceipt => ("Goods Receipt (GR/IR)", "procurement/purchase-orders"),
            SystemTransactionType.DiscountReceived => ("Purchase Discounts", "ap/bill-entry"),
            _ => (string.Empty, string.Empty)
        };
    }

    private string GetApRouteTitle(SystemTransactionType type)
    {
        return type switch
        {
            SystemTransactionType.PurchaseInvoice => "Purchase Invoicing",
            SystemTransactionType.DirectPurchaseInvoice => "Direct Purchase Invoicing (No Inventory)",
            SystemTransactionType.ApAdjustment => "AP Adjustment",
            SystemTransactionType.VendorPayment => "Vendor Payment",
            SystemTransactionType.VendorReturnStock => "Vendor Return (Stock Only)",
            SystemTransactionType.VendorReturnRefund => "Vendor Return (Cash Refund Only)",
            SystemTransactionType.DebitNote => "Debit Note",
            SystemTransactionType.GoodsReceipt => "Goods Receipt / Stock Inflow (GR/IR)",
            SystemTransactionType.DiscountReceived => "Discount Received",
            _ => type.ToString()
        };
    }

    private string GetApRouteDescription(TransactionGlMapping map)
    {
        if (map.TransactionType == SystemTransactionType.CustomGlAdjustment)
        {
            return !string.IsNullOrWhiteSpace(map.CustomTransactionType?.Description)
                ? map.CustomTransactionType.Description
                : "User Defined Custom GL Adjustment Template Route.";
        }

        return map.TransactionType switch
        {
            SystemTransactionType.PurchaseInvoice => "Standard inventory-tracked vendor procurement.",
            SystemTransactionType.DirectPurchaseInvoice => "Non-inventory direct accounts payable procurement.",
            SystemTransactionType.ApAdjustment => "Opening balance migration & AP subledger manual adjustments.",
            SystemTransactionType.VendorPayment => "Vendor bill outgoing payments & bank disbursements.",
            SystemTransactionType.VendorReturnStock => "Vendor physical stock returns (AP Liability Reduction vs Inventory Asset Credit).",
            SystemTransactionType.VendorReturnRefund => "Vendor cash payment refunds (Deposit Bank Asset vs AP Liability Restoration).",
            SystemTransactionType.DebitNote => "Purchase invoice price reductions & non-stock corrections.",
            SystemTransactionType.GoodsReceipt => "Accrual clearing account (GR/IR) for physical goods receipts.",
            SystemTransactionType.DiscountReceived => "Financial ledger routing for purchasing discounts captured / rolled back.",
            _ => "Core accounts payable ledger route."
        };
    }

    private string GetDefaultDescription(SystemTransactionType type, bool isDebit)
    {
        if (isDebit)
        {
            return type switch
            {
                SystemTransactionType.PurchaseInvoice => "System Default [Line Expense / Asset]",
                SystemTransactionType.DirectPurchaseInvoice => "NOT SET [Expense Account]",
                SystemTransactionType.ApAdjustment => "NOT SET [Suspense / Equity Offset]",
                SystemTransactionType.VendorPayment => "System Default [Vendor AP Control]",
                SystemTransactionType.VendorReturnStock => "System Default [Vendor AP Control]",
                SystemTransactionType.VendorReturnRefund => "NOT SET [Deposit Bank / Cash Asset]",
                SystemTransactionType.DebitNote => "System Default [Vendor AP Control]",
                SystemTransactionType.GoodsReceipt => "System Default [Inventory Asset Account]",
                SystemTransactionType.DiscountReceived => "NOT SET [Discount Rollback Debit Acc]",
                _ => "System Default"
            };
        }
        else
        {
            return type switch
            {
                SystemTransactionType.PurchaseInvoice => "System Default [Vendor AP Control]",
                SystemTransactionType.DirectPurchaseInvoice => "System Default [Vendor AP Control]",
                SystemTransactionType.ApAdjustment => "System Default [Vendor AP Control]",
                SystemTransactionType.VendorPayment => "NOT SET [Disbursement Bank / Cash Asset]",
                SystemTransactionType.VendorReturnStock => "System Default [Item Inventory Asset Account]",
                SystemTransactionType.VendorReturnRefund => "System Default [Vendor AP Control]",
                SystemTransactionType.DebitNote => "System Default [Line Expense / Clearing Account]",
                SystemTransactionType.GoodsReceipt => "NOT SET [GR/IR Clearing Liability Account]",
                SystemTransactionType.DiscountReceived => "System Default [Line Discount Received Acc]",
                _ => "System Default"
            };
        }
    }
}