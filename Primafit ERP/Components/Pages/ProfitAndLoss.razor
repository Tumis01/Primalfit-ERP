@page "/reports/profit-and-loss"
@using Primafit_ERP.Services
@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Components.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject FinancialReportingService FinanceService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto mt-6">
    <ReportViewer Title="Profit & Loss Statement"
                  Description="Income statement tracking revenue, COGS, and operating expenses."
                  ShowDateRange="true"
                  FetchData="GetData" />
</div>

@code {
    private Guid companyId;

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("FINANCE_REPORTS_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null) companyId = user.CompanyDetailsId.Value;
    }

    // This method is passed to the component
    private async Task<StandardReportData> GetData(DateOnly start, DateOnly end)
    {
        return await FinanceService.GeneratePnLAsync(companyId, start, end);
    }
}