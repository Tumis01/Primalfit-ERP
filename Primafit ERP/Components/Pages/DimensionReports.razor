@page "/dimensions/reports"
@page "/dimensions/reports/{ReportKind}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Components.Shared
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject DimensionService Dimensions
@inject DimensionReportService Reports
@inject FinancialReportingService Finance
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ILogger<DimensionReports> Logger
@rendermode InteractiveServer

<PageTitle>Dimension reports · @ReportTitle</PageTitle>
<div class="mx-auto max-w-7xl min-w-0 space-y-6 pb-12">
    <div class="flex flex-wrap items-center justify-between gap-3 text-sm"><p class="text-slate-500">Dimensions / Reports</p><a href="/dimensions/setup/types" class="font-bold text-indigo-700">Dimension setup</a></div>
    @if (loadError.Length > 0) { <p role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">@loadError</p> }
    else if (loading) { <p role="status" class="p-10 text-center text-slate-500">Loading report filters…</p> }
    else
    {
        <ReportViewer @ref="viewer" @key="kind" CompanyId="@companyId" Title="@ReportTitle"
            Description="Finance & GL statements filtered by dimensions. Only posted activity is included."
            ShowDateRange="@(kind != "balance-sheet")" ShowAsOfDate="@(kind == "balance-sheet")"
            ShowCsvExport="true" ShowInitialState="true" Paginate="true" FetchData="FetchReport">
            <FilterContent>
                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <div><label for="dimension-report-kind" class="mb-1.5 block text-[10px] font-extrabold uppercase tracking-wider text-slate-500">Report</label><select id="dimension-report-kind" aria-label="Report" value="@kind" @onchange="ChangeReport" class="w-full rounded-xl border border-slate-200 bg-white p-2.5 text-sm font-semibold"><option value="general-ledger">General Ledger</option><option value="profit-and-loss">Profit &amp; Loss</option><option value="balance-sheet">Balance Sheet</option></select></div>
                    @foreach (var type in types)
                    {
                        var typeId = type.Id;
                        <SearchableGuidSelect @key="typeId" Label="@type.Name" Options="@FilterOptions(typeId)"
                            Value="@filters.GetValueOrDefault(typeId)" ValueChanged="@(id => SetFilter(typeId, id))"
                            Placeholder="@($"All {type.Name} · search to filter")" ClearLabel="All values" InlineMenu="true" />
                    }
                </div>
                <p class="mt-4 text-xs text-slate-500">Filters combine across dimension types. Historical inactive values remain available for reporting.</p>
            </FilterContent>
        </ReportViewer>
    }
</div>

@code {
    [Parameter] public string? ReportKind { get; set; }
    [SupplyParameterFromQuery(Name = "dimension")] public Guid? InitialValueId { get; set; }
    private ReportViewer? viewer;
    private Guid companyId;
    private List<DimensionType> types = new();
    private List<DimensionValue> values = new();
    private readonly Dictionary<Guid, Guid?> filters = new();
    private string kind = "general-ledger", loadError = "";
    private bool loading = true;
    private Guid? appliedInitialValue;
    private string ReportTitle => kind switch { "profit-and-loss" => "Profit & Loss Statement", "balance-sheet" => "Balance Sheet", _ => "General Ledger" };

    protected override async Task OnInitializedAsync()
    {
        try {
            var user = await UserManager.GetUserAsync((await Auth.GetAuthenticationStateAsync()).User);
            companyId = user?.CompanyDetailsId ?? Guid.Empty;
            if (companyId == Guid.Empty) { loadError = "Select a company before running dimension reports."; return; }
            types = await Dimensions.GetTypesAsync(companyId);
            values = await Dimensions.GetValuesAsync(companyId);
        } catch (Exception ex) { Logger.LogError(ex, "Could not load dimension report filters"); loadError = "Report filters could not be loaded. Refresh to try again."; }
        finally { loading = false; }
    }
    protected override void OnParametersSet()
    {
        kind = ReportKind is "profit-and-loss" or "balance-sheet" ? ReportKind : "general-ledger";
        if (InitialValueId != appliedInitialValue) {
            if (values.FirstOrDefault(x => x.Id == InitialValueId) is { } initial) { filters[initial.DimensionTypeId] = initial.Id; viewer?.Invalidate(); }
            appliedInitialValue = InitialValueId;
        }
    }
    private void ChangeReport(ChangeEventArgs e) => Navigation.NavigateTo($"/dimensions/reports/{e.Value}");
    private void SetFilter(Guid typeId, Guid? valueId) { filters[typeId] = valueId; viewer?.Invalidate(); }
    private IReadOnlyCollection<DropdownOption> FilterOptions(Guid typeId) => values.Where(x => x.DimensionTypeId == typeId)
        .Select(x => new DropdownOption(x.Id, $"{x.Code} — {x.Name}{(!x.IsActive ? " (inactive)" : "")}", x.Description)).ToList();

    private async Task<StandardReportData> FetchReport(DateOnly from, DateOnly to)
    {
        var ids = filters.Values.Where(x => x.HasValue).Select(x => x!.Value).Distinct().ToList();
        StandardReportData report;
        if (kind == "profit-and-loss") report = await Finance.GeneratePnLAsync(companyId, from, to, ids);
        else if (kind == "balance-sheet") report = await Finance.GenerateBalanceSheetAsync(companyId, to, ids);
        else {
            var rows = await Reports.GetTransactionsAsync(companyId, from, to, ids);
            var captions = await Reports.GetCaptionsAsync(companyId, rows.Where(x => x.DimensionSetId.HasValue).Select(x => x.DimensionSetId!.Value).Distinct().ToList());
            report = new StandardReportData { ReportName = "General Ledger", ReportingPeriod = $"{from:dd MMM yyyy} to {to:dd MMM yyyy}", Headers = new() { "Date", "Account", "Description", "Dimensions", "Debit", "Credit" } };
            foreach (var row in rows) report.Rows.Add(new() { row.PostingDate.ToString("dd MMM yyyy"), $"{row.SegCoa?.AccountCode} — {row.SegCoa?.Description}", row.Narration ?? "", captions.GetValueOrDefault(row.DimensionSetId ?? Guid.Empty, "—"), row.Debit.ToString("N4"), row.Credit.ToString("N4") });
            if (rows.Count > 0) report.Rows.Add(new() { "", "TOTAL", "", "", rows.Sum(x => x.Debit).ToString("N4"), rows.Sum(x => x.Credit).ToString("N4") });
        }
        report.ReportingPeriod += "\n" + (ids.Count == 0 ? "All dimensions" : string.Join(" · ", types.Where(x => filters.GetValueOrDefault(x.Id).HasValue).Select(x => $"{x.Name}: {values.FirstOrDefault(v => v.Id == filters[x.Id])?.Name}")));
        return report;
    }
}
