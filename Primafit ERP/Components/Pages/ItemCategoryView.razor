@page "/sc/item-categories"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using System.Text

@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject IDocumentNumberingService NumberingService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Item Categories</h1>
            <p class="text-sm text-slate-500 mt-1">Configure predefined General Ledger templates for your inventory and services.</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <PermissionGate Key="INVENTORY_SETUP_MANAGE">
                <Authorized>
                    <button @onclick="ExportCsv" class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 text-sm">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                        Export CSV
                    </button>

                    <label class="px-4 py-2 bg-slate-50 text-slate-700 rounded-lg font-bold border border-slate-200 hover:bg-slate-100 shadow-sm transition-colors flex items-center gap-2 cursor-pointer mb-0 text-sm">
                        @if (isImporting)
                        {
                            <span class="animate-spin">↻</span>
                            <span>Importing...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                            <span>Import CSV</span>
                        }
                        <InputFile OnChange="ImportCsv" accept=".csv" class="hidden" disabled="@isImporting" />
                    </label>

                    <button @onclick="CreateNew" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                        New Category
                    </button>
                </Authorized>
            </PermissionGate>
        </div>
    </div>

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl mb-6 animate-in slide-in-from-top-4">
            <h3 class="text-lg font-bold text-slate-900 mb-6">@(isEditing ? "Edit Category" : "New Category")</h3>

            <EditForm Model="@currentCategory" OnValidSubmit="SaveCategory">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div>
                        <label class="label">Category Name <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentCategory.Name" class="input-class" placeholder="e.g. Electronics, Consulting, Raw Materials..." />
                    </div>
                    <div>
                        <label class="label">Category Code <span class="text-rose-500">*</span></label>
                        <InputText @bind-Value="currentCategory.Code" class="input-class" placeholder="Enter category code" />
                        <ValidationMessage For="@(() => currentCategory.Code)" class="mt-1 block text-xs font-semibold text-rose-600" />
                        <p class="mt-1 text-xs text-slate-500">Category codes are entered manually. Item codes use the category sequence below.</p>
                        @if (!string.IsNullOrWhiteSpace(categoryCodeError))
                        {
                            <p role="alert" class="mt-1 text-xs font-semibold text-rose-600">@categoryCodeError</p>
                        }
                    </div>
                    <div>
                        <label class="label">Item Code Sequence</label>
                        <select value="@(currentCategory.ItemCodeSequenceDefinitionId?.ToString() ?? string.Empty)" @onchange="OnItemCodeSequenceChanged" class="input-class bg-white">
                            <option value="">User Defined / Manual item codes</option>
                            @foreach (var sequence in itemCodeSequences)
                            {
                                <option value="@sequence.Id">@sequence.Name</option>
                            }
                        </select>
                        <p class="mt-1 text-xs text-slate-500">Items assigned to this category use this sequence for their code.</p>
                    </div>
                    <div>
                        <label class="label">Category Type</label>
                        <div class="flex items-center gap-3 mt-2">
                            <label class="flex items-center gap-2 cursor-pointer p-2 rounded hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all">
                                <InputCheckbox @bind-Value="currentCategory.IsService" class="w-4 h-4 rounded text-slate-900 focus:ring-slate-900" />
                                <span class="text-sm font-bold text-slate-700">Service Item</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="bg-50 p-6 rounded-xl border border-100 mb-6">
                    <h4 class="text-xs font-bold text-indigo-900 uppercase mb-4 border-b border-indigo-200 pb-2"> General Ledger Mapping</h4>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        @if (!currentCategory.IsService)
                        {
                            <SearchableGlAccount Label="Inventory Asset Account (BS / Debit)"
                                                 Placeholder="Search Asset Accounts..."
                                                 Accounts="@assetAccounts"
                                                 @bind-Value="ProxyAssetAccountId"
                                                 IsInvalid="@(ProxyAssetAccountId == Guid.Empty)" />
                        }

                        <SearchableGlAccount Label="Sales Income Account (PL / Credit)"
                                             Placeholder="Search Revenue Accounts..."
                                             Accounts="@revenueAccounts"
                                             @bind-Value="currentCategory.SalesIncomeAccountId"
                                             IsInvalid="@(currentCategory.SalesIncomeAccountId == Guid.Empty)" />

                        <SearchableGlAccount Label="Cost of Goods Sold (PL / Debit)"
                                             Placeholder="Search Expense Accounts..."
                                             Accounts="@expenseAccounts"
                                             @bind-Value="currentCategory.CostOfGoodsSoldAccountId"
                                             IsInvalid="@(currentCategory.CostOfGoodsSoldAccountId == Guid.Empty)" />

                        @if (!currentCategory.IsService)
                        {
                            <SearchableGlAccount Label="Inventory Adjustment / Loss (PL / Debit)"
                                                 Placeholder="Search Expense Accounts..."
                                                 Accounts="@expenseAccounts"
                                                 @bind-Value="ProxyAdjustmentAccountId" />
                        }
                    </div>
                </div>

                <div class="flex justify-end gap-3">
                    <button type="button" @onclick="() => showForm = false" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancel</button>
                    <button type="submit" disabled="@isBusy" class="rounded-xl bg-slate-900 px-8 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                        @if (isBusy)
                        {
                            <span class="animate-spin">↻</span>
                        }
                        else
                        {

                            <span>@(isEditing ? "Update Category" : "Save Category")</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-900 min-w-[800px]">
            <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                <tr>
                    <th class="p-4 pl-6">Category Code</th>
                    <th class="p-4">Category Name</th>
                    <th class="p-4">Item Code Sequence</th>
                    <th class="p-4 text-center">Type</th>
                    <th class="p-4">Income Account</th>
                    <th class="p-4">COGS Account</th>
                    <th class="p-4 text-right pr-6">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (categories.Any())
                {
                    @foreach (var c in categories)
                    {
                        var incomeAcc = allAccounts.FirstOrDefault(a => a.Id == c.SalesIncomeAccountId);
                        var cogsAcc = allAccounts.FirstOrDefault(a => a.Id == c.CostOfGoodsSoldAccountId);

                        <tr class="hover:bg-slate-50 transition-colors group">
                            <td class="p-4 pl-6 font-mono font-bold text-slate-700">@c.Code</td>
                            <td class="p-4 font-bold text-slate-900">@c.Name</td>
                            <td class="p-4">
                                @if (c.ItemCodeSequenceDefinition is not null)
                                {
                                    <span class="inline-flex rounded-md bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">@c.ItemCodeSequenceDefinition.Name</span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">Manual item codes</span>
                                }
                            </td>
                            <td class="p-4 text-center">
                                <span class="px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider @(c.IsService ? "bg-indigo-50 text-indigo-700 border border-indigo-200" : "bg-emerald-50 text-emerald-700 border border-emerald-200")">
                                    @(c.IsService ? "Service" : "Goods")
                                </span>
                            </td>
                            <td class="p-4 text-xs font-mono text-slate-500">@(incomeAcc?.Description ?? "Missing") (@(incomeAcc?.AccountCode ?? "Missing")) </td>
                            <td class="p-4 text-xs font-mono text-slate-500">@(cogsAcc?.Description ?? "Missing") (@(cogsAcc?.AccountCode ?? "Missing"))</td>
                            <td class="p-4 text-right pr-6 opacity-100 md:opacity-0 group-hover:opacity-100 transition-opacity">
                                <PermissionGate Key="INVENTORY_SETUP_MANAGE">
                                    <Authorized>
                                        <button @onclick="() => Edit(c)" class="text-indigo-600 font-bold hover:text-indigo-900 mr-4 text-xs uppercase tracking-wider">Edit</button>
                                        <button @onclick="() => Delete(c)" class="text-rose-500 font-bold hover:text-rose-700 text-xs uppercase tracking-wider">Delete</button>
                                    </Authorized>
                                </PermissionGate>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="p-12 text-center text-slate-400">No categories found. Create one to organize your inventory.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        transition: all 0.2s;
        outline: none;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private Guid currentCompanyId = Guid.Empty;
    private bool showForm = false;
    private bool isEditing = false;
    private bool isBusy = false;
    private bool isImporting = false;

    private List<ItemCategory> categories = new();
    private List<SequenceDefinition> itemCodeSequences = new();
    private ItemCategory currentCategory = new();
    private string? categoryCodeError;

    // Segmented COA lists
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> assetAccounts = new();
    private List<SegChartOfAccount> revenueAccounts = new();
    private List<SegChartOfAccount> expenseAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private Guid ProxyAssetAccountId
    {
        get => currentCategory.InventoryAssetAccountId ?? Guid.Empty;
        set => currentCategory.InventoryAssetAccountId = value == Guid.Empty ? null : value;
    }
    private Guid ProxyAdjustmentAccountId
    {
        get => currentCategory.AdjustmentExpenseAccountId ?? Guid.Empty;
        set => currentCategory.AdjustmentExpenseAccountId = value == Guid.Empty ? null : value;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("INVENTORY_SETUP_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            await LoadData();
            itemCodeSequences = await NumberingService.GetDefinitionsAsync(currentCompanyId, SequenceTargetType.ItemCode);

            // Fetch Financial Data for Dropdowns
            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

            assetAccounts = FilterAccounts(true, true);
            revenueAccounts = FilterAccounts(false, false);
            expenseAccounts = FilterAccounts(false, true);
        }
    }

    private async Task LoadData()
    {
        categories = await MasterService.GetItemCategoriesAsync(currentCompanyId);
    }

    private List<SegChartOfAccount> FilterAccounts(bool isBs, bool isDr)
    {
        return allAccounts
            .Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.IsBalanceSheet == isBs && type.IsDebit == isDr && a.IsActive;
            })
            .OrderBy(a => a.AccountCode)
            .ToList();
    }

    private void CreateNew()
    {
        currentCategory = new ItemCategory { CompanyId = currentCompanyId };
        categoryCodeError = null;
        showForm = true;
        isEditing = false;
    }

    private void OnItemCodeSequenceChanged(ChangeEventArgs args)
    {
        currentCategory.ItemCodeSequenceDefinitionId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : null;
    }

    private void Edit(ItemCategory c)
    {
        currentCategory = new ItemCategory
        {
            Id = c.Id,
            CompanyId = c.CompanyId,
            Code = c.Code,
            ItemCodeSequenceDefinitionId = c.ItemCodeSequenceDefinitionId,
            Name = c.Name,
            IsService = c.IsService,
            SalesIncomeAccountId = c.SalesIncomeAccountId,
            CostOfGoodsSoldAccountId = c.CostOfGoodsSoldAccountId,
            InventoryAssetAccountId = c.InventoryAssetAccountId,
            AdjustmentExpenseAccountId = c.AdjustmentExpenseAccountId
        };
        categoryCodeError = null;
        showForm = true;
        isEditing = true;
    }

    private async Task Delete(ItemCategory c)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Permanently delete category '{c.Name}'?")) return;

        var err = await MasterService.DeleteItemCategoryAsync(c.Id);
        if (string.IsNullOrEmpty(err))
        {
            await LoadData();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveCategory()
    {
        categoryCodeError = null;
        if (string.IsNullOrWhiteSpace(currentCategory.Code))
        {
            categoryCodeError = "Enter a category code.";
            return;
        }
        if (!await NumberingService.IsCodeAvailableAsync(currentCompanyId, SequenceTargetType.ItemCategoryCode, currentCategory.Code, currentCategory.Id))
        {
            categoryCodeError = $"Category Code '{currentCategory.Code.Trim()}' already exists in this company.";
            return;
        }
        if (currentCategory.SalesIncomeAccountId == Guid.Empty || currentCategory.CostOfGoodsSoldAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Sales Income and COGS accounts are strictly required.");
            return;
        }

        if (!currentCategory.IsService && (currentCategory.InventoryAssetAccountId == null || currentCategory.InventoryAssetAccountId == Guid.Empty))
        {
            await JS.InvokeVoidAsync("alert", "Inventory Asset account is required for physical goods categories.");
            return;
        }

        isBusy = true;
        try
        {
            var err = await MasterService.SaveItemCategoryAsync(currentCategory);
            if (string.IsNullOrEmpty(err))
            {
                showForm = false;
                categoryCodeError = null;
                await LoadData();
                return;
            }
            await JS.InvokeVoidAsync("alert", err);
        }
        catch (Exception ex)
        {
            categoryCodeError = $"Could not save the category: {ex.Message}";
        }
        finally { isBusy = false; }
    }

    // --- CSV EXPORT LOGIC ---
    private async Task ExportCsv()
    {
        try
        {
            var sb = new StringBuilder();
            sb.AppendLine("CategoryName,IsService,SalesIncomeGlCode,CogsGlCode,InventoryAssetGlCode,AdjustmentGlCode,CategoryCode");

            foreach (var c in categories)
            {
                var incomeCode = allAccounts.FirstOrDefault(a => a.Id == c.SalesIncomeAccountId)?.AccountCode ?? "";
                var cogsCode = allAccounts.FirstOrDefault(a => a.Id == c.CostOfGoodsSoldAccountId)?.AccountCode ?? "";
                var assetCode = allAccounts.FirstOrDefault(a => a.Id == c.InventoryAssetAccountId)?.AccountCode ?? "";
                var adjCode = allAccounts.FirstOrDefault(a => a.Id == c.AdjustmentExpenseAccountId)?.AccountCode ?? "";

                sb.AppendLine($"\"{c.Name?.Replace("\"", "\"\"")}\",{c.IsService},\"{incomeCode}\",\"{cogsCode}\",\"{assetCode}\",\"{adjCode}\",\"{c.Code?.Replace("\"", "\"\"")}\"");
            }

            var bytes = Encoding.UTF8.GetBytes(sb.ToString());
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(bytes));

            await JS.InvokeVoidAsync("downloadFileFromStream", "ItemCategories_Export.csv", streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Export failed: {ex.Message}");
        }
    }

    // --- CSV IMPORT LOGIC ---
    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        isImporting = true;
        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                await JS.InvokeVoidAsync("alert", "Please upload a valid .csv file.");
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();

            var lines = content.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            if (lines.Length <= 1)
            {
                await JS.InvokeVoidAsync("alert", "The file appears to be empty or missing data rows.");
                return;
            }

            int successCount = 0;
            var importErrors = new List<string>();

            for (int i = 1; i < lines.Length; i++)
            {
                var cols = ParseCsvLine(lines[i]);

                if (cols.Count >= 1)
                {
                    var name = cols[0].Trim();
                    if (string.IsNullOrWhiteSpace(name)) continue;

                    var category = categories.FirstOrDefault(c => c.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
                                   ?? new ItemCategory { CompanyId = currentCompanyId, Name = name };

                    if (cols.Count > 1 && bool.TryParse(cols[1].Trim(), out bool isSvc))
                    {
                        category.IsService = isSvc;
                    }

                    // GL Mapping
                    if (cols.Count > 2 && !string.IsNullOrWhiteSpace(cols[2]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[2].Trim());
                        if (gl != null) category.SalesIncomeAccountId = gl.Id;
                    }
                    if (cols.Count > 3 && !string.IsNullOrWhiteSpace(cols[3]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[3].Trim());
                        if (gl != null) category.CostOfGoodsSoldAccountId = gl.Id;
                    }
                    if (cols.Count > 4 && !string.IsNullOrWhiteSpace(cols[4]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[4].Trim());
                        if (gl != null) category.InventoryAssetAccountId = gl.Id;
                    }
                    if (cols.Count > 5 && !string.IsNullOrWhiteSpace(cols[5]))
                    {
                        var gl = allAccounts.FirstOrDefault(a => a.AccountCode == cols[5].Trim());
                        if (gl != null) category.AdjustmentExpenseAccountId = gl.Id;
                    }
                    if (cols.Count > 6) category.Code = cols[6].Trim();
                    // Strict Validation before saving
                    if (category.SalesIncomeAccountId != Guid.Empty && category.CostOfGoodsSoldAccountId != Guid.Empty)
                    {
                        if (category.IsService || (category.InventoryAssetAccountId.HasValue && category.InventoryAssetAccountId != Guid.Empty))
                        {
                            var saveError = await MasterService.SaveItemCategoryAsync(category);
                            if (string.IsNullOrEmpty(saveError)) successCount++;
                            else importErrors.Add($"Row {i + 1}: {saveError}");
                        }
                    }
                }
            }

            await LoadData();
            var summary = $"Import complete. {successCount} categories saved.";
            if (importErrors.Count > 0)
                summary += $" {importErrors.Count} rows failed: {string.Join(" | ", importErrors.Take(10))}";
            await JS.InvokeVoidAsync("alert", summary);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Import error: {ex.Message}");
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    // Helper to safely parse CSV rows
    private List<string> ParseCsvLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var currentField = new StringBuilder();

        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            if (c == '\"')
            {
                inQuotes = !inQuotes;
            }
            else if (c == ',' && !inQuotes)
            {
                result.Add(currentField.ToString());
                currentField.Clear();
            }
            else
            {
                currentField.Append(c);
            }
        }
        result.Add(currentField.ToString());
        return result;
    }
}
