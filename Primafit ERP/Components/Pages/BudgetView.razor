@page "/finance/budget"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject BudgetService BudgetService
@inject SegCoaService SegCoaService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-5xl mx-auto space-y-6 animate-in fade-in duration-500">
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Budget Control</h1>
            <p class="text-sm text-slate-500">Define spending limits per GL Account to block unauthorized POs.</p>
        </div>
        <button @onclick="SaveBudget" class="px-6 py-2 bg-emerald-600 text-white font-bold rounded-lg shadow hover:bg-emerald-700 transition-colors">
            Save Budget
        </button>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">

        <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-50 p-4 rounded-xl border border-slate-100">
            <div>
                <label class="label">Budget Name / Fiscal Year</label>
                <input @bind="budget.BudgetName" class="input-class font-bold text-slate-700" placeholder="e.g. Master Budget 2026" />
            </div>
            <div class="flex items-center pt-6">
                <label class="flex items-center gap-3 cursor-pointer">
                    <div class="relative">
                        <input type="checkbox" @bind="budget.IsActive" class="peer sr-only" />
                        <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                    </div>
                    <span class="font-bold text-slate-700 select-none">Budget is Active (Enforce Limits)</span>
                </label>
            </div>
        </div>

        <div class="border-t border-slate-100 pt-4">
            <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                Spending Limits
            </h3>

            <table class="w-full text-sm text-left">
                <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 rounded-t-lg">
                    <tr>
                        <th class="p-3 w-1/2">GL Account (Expense or Asset)</th>
                        <th class="p-3 text-right">Limit Amount</th>
                        <th class="p-3 w-10"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var line in budget.Lines)
                    {
                        <tr>
                            <td class="p-2">
                                <SearchableGlAccount Label=""
                                                     Placeholder="Search GL Account..."
                                                     Accounts="@glAccounts"
                                                     @bind-Value="line.GlAccountId" />
                            </td>
                            <td class="p-2">
                                <div class="relative">
                                    <span class="absolute left-3 top-2 text-slate-400 font-bold">$</span>
                                    <input type="number" @bind="line.LimitAmount" class="input-class text-right font-bold font-mono pl-6" placeholder="0.00" />
                                </div>
                            </td>
                            <td class="p-2 text-center">
                                <button @onclick="() => budget.Lines.Remove(line)" class="text-slate-300 hover:text-red-500 transition-colors p-1">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <button @onclick="AddLine" class="mt-4 flex items-center gap-2 text-xs font-bold text-indigo-600 border border-indigo-200 px-4 py-2 rounded-lg hover:bg-indigo-50 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Add Account Line
            </button>
        </div>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
        letter-spacing: 0.025em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #059669;
            outline: none;
            ring: 2px;
            ring-color: #a7f3d0;
        }
</style>

@code {
    private BudgetHeader budget = new() { Lines = new List<BudgetLine> { new() } };

    // CHANGED: Use SegChartOfAccount
    private List<SegChartOfAccount> glAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private Guid currentCompanyId;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;

            // 1. Get Types for flags
            accountTypes = await SegCoaService.GetAccountTypesAsync();

            // 2. Get All COA
            var allCoa = await SegCoaService.GetCoaAsync(currentCompanyId);

            // 3. Filter for Budgetable accounts (Expenses & Assets = Debit Accounts)
            glAccounts = allCoa
                .Where(a =>
                {
                    var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                    return type != null && type.IsDebit == true;
                })
                .OrderBy(x => x.AccountCode)
                .ToList();
        }
    }

    private void AddLine() => budget.Lines.Add(new BudgetLine());

    private async Task SaveBudget()
    {
        if (string.IsNullOrWhiteSpace(budget.BudgetName))
        {
            await JS.InvokeVoidAsync("alert", "Please enter a Budget Name.");
            return;
        }

        budget.CompanyId = currentCompanyId;
        var err = await BudgetService.SaveBudgetAsync(budget);

        if (string.IsNullOrEmpty(err)) await JS.InvokeVoidAsync("alert", "Budget Saved Successfully!");
        else await JS.InvokeVoidAsync("alert", err);
    }
}