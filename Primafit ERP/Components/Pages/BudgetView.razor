@page "/finance/budget"
@using System.IO
@using ExcelDataReader
@using System.Data
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject BudgetService BudgetService
@inject SegCoaService SegCoaService
@inject AccountingPeriodService PeriodService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in duration-500 pb-12">

    <div class="flex justify-between items-center bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Budget Management</h1>
            <p class="text-sm text-slate-500">Manage fiscal plans, period limits, and transfer configurations.</p>
        </div>
        
        @if (!showForm)
        {
            <button @onclick="CreateNew" class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800 transition-colors flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                <span>New Budget</span>
            </button>
        }
    </div>

    @if (showForm)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-xl p-6 relative overflow-visible animate-in slide-in-from-top-4 duration-300">
            
            <div class="flex justify-between items-center mb-6 border-b border-slate-100 pb-4">
                <h3 class="text-lg font-bold text-slate-900">
                    @* FIX: Reversed the logic so it shows correctly *@
                    @(budget.Id == Guid.Empty ? "Create New Budget" : "Edit Budget")
                </h3>
                <button @onclick="CancelEdit" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            @if (isLoadingForm)
            {
                <div class="p-12 text-center text-slate-400 italic">Loading budget details...</div>
            }
            else
            {
                <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-6 bg-slate-50 p-5 rounded-xl border border-slate-100">
                    <div>
                        <label class="label">Budget Name / Fiscal Year</label>
                        <input @bind="budget.BudgetName" class="input-class font-bold text-slate-700 text-lg" placeholder="e.g. Master Budget 2026" />
                    </div>
                    <div class="flex items-center pt-6">
                        <label class="flex items-center gap-3 cursor-pointer group">
                            <div class="relative">
                                <input type="checkbox" @bind="budget.IsActive" class="peer sr-only" />
                                <div class="w-11 h-6 bg-slate-200 peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600 transition-colors"></div>
                            </div>
                            <div>
                                <span class="font-bold text-slate-700 select-none block group-hover:text-emerald-700 transition-colors">Active</span>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="border-t border-slate-100 pt-4">
                    <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-4 gap-4">
                        <h3 class="font-bold text-slate-800 flex items-center gap-2">
                            <svg class="w-4 h-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            Periodic Spending Limits
                        </h3>
                        <div class="flex flex-wrap items-center gap-2">
                            @if (isImporting)
                            {
                                <span class="text-xs font-bold text-slate-400 animate-pulse px-3 py-1.5">Importing...</span>
                            }
                            else
                            {
                                <button type="button" @onclick="ExportTemplate" class="text-xs font-bold text-slate-600 bg-white border border-slate-300 px-3 py-1.5 rounded hover:bg-slate-50 transition-colors flex items-center gap-1 shadow-sm">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                    Export Template
                                </button>

                                <InputFile id="budgetUpload" OnChange="ImportExcel" class="hidden" accept=".csv, .xls, .xlsx" />
                                <label for="budgetUpload" class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded hover:bg-emerald-100 transition-colors flex items-center gap-1 cursor-pointer shadow-sm mb-0">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                                    Import Excel
                                </label>

                                <button type="button" @onclick="AddLine" class="text-xs font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 px-3 py-1.5 rounded hover:bg-indigo-100 transition-colors flex items-center gap-1 shadow-sm">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    Add GL Account
                                </button>
                            }
                        </div>
                    </div>

                    <div class="space-y-4 overflow-visible">
                        @foreach (var line in budget.Lines)
                        {
                            <div class="border border-slate-200 rounded-xl overflow-visible shadow-sm group bg-white">
                                <div class="bg-slate-50 rounded-t-xl p-4 border-b border-slate-200 flex flex-col md:flex-row md:items-center gap-4 relative z-50">
                                    <div class="flex-1 relative">
                                        <SearchableGlAccount Label="GL Account (Expense or Asset)"
                                                             Placeholder="Search GL Account..."
                                                             Accounts="@glAccounts"
                                                             @bind-Value="line.GlAccountId" />
                                        @if (GetDuplicateCount(line.GlAccountId) > 1)
                                        {
                                            <div class="text-[10px] text-rose-500 font-bold mt-1 animate-pulse">Duplicate Account Selected</div>
                                        }
                                    </div>
                                    <div class="w-full md:w-64 text-right">
                                        <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mb-1">Calculated Total Limit</div>
                                        <div class="text-xl font-mono font-black text-slate-800">
                                            @line.PeriodAllocations.Sum(p => p.Amount ?? 0).ToString("N2")
                                        </div>
                                    </div>
                                    <button @onclick="() => budget.Lines.Remove(line)" class="text-slate-400 hover:text-rose-500 transition-colors p-2 rounded-full hover:bg-rose-50">
                                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    </button>
                                </div>
                                
                                @if (line.GlAccountId != Guid.Empty && line.PeriodAllocations.Any())
                                {
                                    <div class="p-4 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 relative z-0">
                                        @foreach (var p in line.PeriodAllocations.OrderBy(x => openPeriods.FirstOrDefault(op => op.Id == x.AccountingPeriodId)?.StartDate))
                                        {
                                            <div>
                                                <label class="label text-[10px] text-indigo-600">@p.PeriodName</label>
                                                <input type="number" step="0.01" @bind="p.Amount" class="input-class text-right font-mono font-bold text-slate-700 border-indigo-100 bg-indigo-50/30 focus:border-indigo-400 text-sm" placeholder="NOT SET" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-8 border-t border-slate-100 pt-6 transition-all duration-300">
                    <div class="flex justify-between items-center mb-4 cursor-pointer group" @onclick="() => showTransferRules = !showTransferRules">
                        <div>
                            <h3 class="font-bold text-slate-800 flex items-center gap-2 group-hover:text-indigo-600 transition-colors">
                                <svg class="w-4 h-4 text-slate-500 group-hover:text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
                                Transfer Limits (Reappropriation)
                                @if(budget.TransferLines.Any())
                                {
                                    <span class="bg-indigo-100 text-indigo-700 px-2 py-0.5 rounded-full text-[10px] ml-2">@budget.TransferLines.Count Rules Configured</span>
                                }
                            </h3>
                            <p class="text-xs text-slate-500 mt-1">Define maximum allowable funds that can be moved between accounts per period.</p>
                        </div>
                        <div class="flex items-center gap-4">
                            @if (showTransferRules)
                            {
                                <button @onclick:stopPropagation="true" @onclick="AddTransferLine" class="text-xs font-bold text-indigo-600 bg-indigo-50 border border-indigo-200 px-3 py-1.5 rounded hover:bg-indigo-100 transition-colors flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                    Add Transfer Rule
                                </button>
                            }
                            <div class="p-2 rounded-full bg-slate-50 group-hover:bg-indigo-50 transition-colors">
                                <svg class="w-5 h-5 text-slate-400 group-hover:text-indigo-600 transition-transform duration-300 @(showTransferRules ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            </div>
                        </div>
                    </div>

                    @if (showTransferRules)
                    {
                        <div class="space-y-4 overflow-visible animate-in slide-in-from-top-2 fade-in duration-300 mt-6">
                            @if (!budget.TransferLines.Any())
                            {
                                <div class="text-center p-8 border-2 border-dashed border-slate-200 rounded-xl text-slate-400 text-sm">
                                    No transfer rules configured. Click "Add Transfer Rule" above to allow funds movement.
                                </div>
                            }
                            
                            @foreach (var tLine in budget.TransferLines)
                            {
                                <div class="border border-slate-200 rounded-xl overflow-visible shadow-sm group bg-white">
                                    <div class="bg-slate-50 rounded-t-xl p-4 border-b border-slate-200 flex flex-col lg:flex-row lg:items-center gap-4 relative z-40">
                                        <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div class="relative">
                                                <SearchableGlAccount Label="From (Source) Account"
                                                                     Placeholder="Search GL Account..."
                                                                     Accounts="@glAccounts"
                                                                     @bind-Value="tLine.FromGlAccountId" />
                                            </div>
                                            <div class="relative">
                                                <SearchableGlAccount Label="To (Destination) Account"
                                                                     Placeholder="Search GL Account..."
                                                                     Accounts="@glAccounts"
                                                                     @bind-Value="tLine.ToGlAccountId" />
                                            </div>
                                        </div>
                                        <div class="w-full lg:w-64 text-right">
                                            <div class="text-[10px] text-slate-400 uppercase font-bold tracking-wider mb-1">Calculated Transfer Limit</div>
                                            <div class="text-xl font-mono font-black text-slate-800">
                                                @tLine.PeriodAllocations.Sum(p => p.Amount ?? 0).ToString("N2")
                                            </div>
                                        </div>
                                        <button @onclick="() => budget.TransferLines.Remove(tLine)" class="text-slate-400 hover:text-rose-500 transition-colors p-2 rounded-full hover:bg-rose-50">
                                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </div>
                                    
                                    @if (tLine.FromGlAccountId != Guid.Empty && tLine.ToGlAccountId != Guid.Empty && tLine.PeriodAllocations.Any())
                                    {
                                        <div class="p-4 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 relative z-0">
                                            @foreach (var p in tLine.PeriodAllocations.OrderBy(x => openPeriods.FirstOrDefault(op => op.Id == x.AccountingPeriodId)?.StartDate))
                                            {
                                                <div>
                                                    <label class="label text-[10px] text-emerald-600">@p.PeriodName</label>
                                                    <input type="number" step="0.01" @bind="p.Amount" class="input-class text-right font-mono font-bold text-slate-700 border-emerald-100 bg-emerald-50/30 focus:border-emerald-400 text-sm" placeholder="NOT SET" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="flex justify-end gap-3 mt-8 pt-6 border-t border-slate-100">
                    <button @onclick="CancelEdit" class="px-5 py-2.5 border border-slate-200 text-slate-600 font-bold rounded-xl hover:bg-slate-50 transition-colors">
                        Cancel
                    </button>
                    <button @onclick="SaveBudget" disabled="@isSaving" class="px-6 py-2.5 bg-emerald-600 text-white font-bold rounded-xl shadow hover:bg-emerald-700 transition-colors flex items-center gap-2 disabled:opacity-50">
                        @if (isSaving)
                        {
                            <span class="animate-spin">↻</span> <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                </div>
            }
        </div>
    }
    
    @if (!showForm)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                <h3 class="font-bold text-slate-800">Existing Budgets</h3>
                <span class="text-xs font-bold text-slate-400 bg-slate-100 px-2 py-1 rounded">@existingBudgets.Count Records</span>
            </div>

            @if (isLoadingList)
            {
                <div class="p-8 text-center text-slate-400 italic">Loading list...</div>
            }
            else
            {
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4">Budget Name</th>
                            <th class="px-6 py-4 text-center">Accounts Configured</th> 
                            <th class="px-6 py-4 text-center">Transfer Rules</th> 
                            <th class="px-6 py-4 text-right">Total Limit</th>
                            <th class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var b in existingBudgets)
                        {
                            <tr class="hover:bg-indigo-50/30 transition-colors">
                                <td class="px-6 py-4">
                                    @if (b.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex px-2.5 py-1 rounded-full bg-slate-100 text-slate-500 text-xs font-bold border border-slate-200">
                                            Draft
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 font-bold text-slate-900">@b.BudgetName</td>
                                
                                <td class="px-6 py-4 text-center font-bold text-slate-500">
                                    <span class="bg-slate-100 px-2.5 py-1 rounded-lg">@b.Lines.Count</span>
                                </td>

                                <td class="px-6 py-4 text-center font-bold text-slate-500">
                                    <span class="bg-slate-100 px-2.5 py-1 rounded-lg">@b.TransferLines.Count</span>
                                </td>

                                <td class="px-6 py-4 text-right font-mono font-bold text-slate-700">
                                    @b.Lines.Sum(l => l.LimitAmount).ToString("N2")
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button @onclick="() => LoadBudgetForEdit(b.Id)" class="text-indigo-600 font-bold hover:underline hover:text-indigo-800 transition-colors text-xs uppercase tracking-wide">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!existingBudgets.Any())
                        {
                            <tr><td colspan="6" class="p-8 text-center text-slate-400 italic">No budget history found.</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</div>

<style>
    .label { display: block; font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 0.35rem; letter-spacing: 0.025em; }
    .input-class { width: 100%; border-radius: 0.5rem; border: 1px solid #cbd5e1; padding: 0.6rem; font-size: 0.875rem; transition: all 0.2s; }
    .input-class:focus { border-color: #4f46e5; outline: none; box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15); }
</style>

@code {
    private BudgetHeader budget = new();
    private List<BudgetHeader> existingBudgets = new();
    private List<SegChartOfAccount> glAccounts = new();
    private List<SegAccountType> accountTypes = new();
    private List<AccountingPeriod> openPeriods = new();
    
    private Guid currentCompanyId;
    private bool showForm = false;
    private bool showTransferRules = false;
    private bool isLoadingList = true;
    private bool isLoadingForm = false;
    private bool isSaving = false;
    private bool isImporting = false;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            
            accountTypes = await SegCoaService.GetAccountTypesAsync();
            var allCoa = await SegCoaService.GetActiveCoaAsync(currentCompanyId);
            glAccounts = allCoa.Where(a => {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.IsDebit == true; 
            }).OrderBy(x => x.AccountCode).ToList();

            openPeriods = await PeriodService.GetPeriodsAsync();
            openPeriods = openPeriods.Where(p => p.CompanyId == currentCompanyId).OrderBy(p => p.StartDate).ToList();

            await RefreshList();
        }
        isLoadingList = false;
    }

    private async Task RefreshList()
    {
        existingBudgets = await BudgetService.GetAllBudgetsAsync(currentCompanyId);
    }

    private void CreateNew()
    {
        ResetForm();
        showForm = true;
    }

    private async Task LoadBudgetForEdit(Guid id)
    {
        showForm = true;
        isLoadingForm = true;
        
        var result = await BudgetService.GetBudgetByIdAsync(id);
        if (result != null)
        {
            budget = result;
            
            if (budget.TransferLines.Any()) showTransferRules = true;
            else showTransferRules = false;

            foreach(var line in budget.Lines)
            {
                foreach(var p in line.PeriodAllocations)
                {
                    p.PeriodName = openPeriods.FirstOrDefault(op => op.Id == p.AccountingPeriodId)?.PeriodName ?? "Unknown Period";
                }
            }
            foreach(var tLine in budget.TransferLines)
            {
                foreach(var p in tLine.PeriodAllocations)
                {
                    p.PeriodName = openPeriods.FirstOrDefault(op => op.Id == p.AccountingPeriodId)?.PeriodName ?? "Unknown Period";
                }
            }
        }
        
        isLoadingForm = false;
    }

    private void CancelEdit()
    {
        showForm = false;
        ResetForm();
    }

    private void ResetForm()
    {
        budget = new BudgetHeader { CompanyId = currentCompanyId };
        budget.Lines = new List<BudgetLine>();
        budget.TransferLines = new List<BudgetTransferLine>();
        showTransferRules = false;
        AddLine();
    }

    private void AddLine()
    {
        var newLine = new BudgetLine();
        foreach(var p in openPeriods)
        {
            newLine.PeriodAllocations.Add(new BudgetPeriodAllocation { AccountingPeriodId = p.Id, PeriodName = p.PeriodName });
        }
        budget.Lines.Add(newLine);
    }

    private void AddTransferLine()
    {
        var newTLine = new BudgetTransferLine();
        foreach(var p in openPeriods)
        {
            newTLine.PeriodAllocations.Add(new BudgetTransferPeriodAllocation { AccountingPeriodId = p.Id, PeriodName = p.PeriodName });
        }
        budget.TransferLines.Add(newTLine);
    }

    private int GetDuplicateCount(Guid accountId)
    {
        if (accountId == Guid.Empty) return 0;
        return budget.Lines.Count(x => x.GlAccountId == accountId);
    }

    // --- EXPORT TO EXCEL (CSV) ---
    private async Task ExportTemplate()
    {
        var sb = new System.Text.StringBuilder();
        var periodNames = openPeriods.Select(p => p.PeriodName).ToList();
        
        // Headers
        sb.AppendLine("Account Code,Account Name," + string.Join(",", periodNames));

        // Export existing lines in the budget, or just the headers if empty
        if (budget.Lines.Any())
        {
            foreach (var line in budget.Lines)
            {
                var acc = glAccounts.FirstOrDefault(a => a.Id == line.GlAccountId);
                if (acc == null) continue;
                
                var row = new List<string> { acc.AccountCode, $"\"{acc.Description}\"" };
                
                foreach (var p in openPeriods)
                {
                    var alloc = line.PeriodAllocations.FirstOrDefault(a => a.AccountingPeriodId == p.Id);
                    row.Add(alloc?.Amount?.ToString("F2") ?? "");
                }
                sb.AppendLine(string.Join(",", row));
            }
        }
        else
        {
            // If they haven't added anything, export all available accounts so they can pick and choose
            foreach (var acc in glAccounts)
            {
                var row = new List<string> { acc.AccountCode, $"\"{acc.Description}\"" };
                // Empty amounts
                foreach (var p in openPeriods) row.Add(""); 
                sb.AppendLine(string.Join(",", row));
            }
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        using var streamRef = new DotNetStreamReference(new MemoryStream(bytes));
        await JS.InvokeVoidAsync("downloadFileFromStream", "Budget_Template.csv", streamRef);
    }

    // --- IMPORT FROM EXCEL ---
    private async Task ImportExcel(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isImporting = true;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms); // Max 10MB
            ms.Position = 0;

            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            var newLines = new List<BudgetLine>();

            if (ext == ".xlsx" || ext == ".xls")
            {
                System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);
                using var reader = ExcelReaderFactory.CreateReader(ms);
                var dataset = reader.AsDataSet(new ExcelDataSetConfiguration
                {
                    ConfigureDataTable = _ => new ExcelDataTableConfiguration { UseHeaderRow = true }
                });

                var table = dataset.Tables[0];
                foreach (System.Data.DataRow row in table.Rows)
                {
                    var code = row[0]?.ToString()?.Trim();
                    if (string.IsNullOrEmpty(code)) continue;

                    var acc = glAccounts.FirstOrDefault(a => a.AccountCode.Equals(code, StringComparison.OrdinalIgnoreCase));
                    if (acc == null) continue;

                    var bLine = new BudgetLine { GlAccountId = acc.Id };
                    foreach(var p in openPeriods)
                        bLine.PeriodAllocations.Add(new BudgetPeriodAllocation { AccountingPeriodId = p.Id, PeriodName = p.PeriodName });

                    bool hasAnyAmount = false;
                    for (int i = 2; i < table.Columns.Count; i++)
                    {
                        var colName = table.Columns[i].ColumnName;
                        var alloc = bLine.PeriodAllocations.FirstOrDefault(p => p.PeriodName.Equals(colName, StringComparison.OrdinalIgnoreCase));
                        if (alloc != null)
                        {
                            if (decimal.TryParse(row[i]?.ToString(), out decimal amt) && amt > 0)
                            {
                                alloc.Amount = amt;
                                hasAnyAmount = true;
                            }
                        }
                    }
                    if (hasAnyAmount) newLines.Add(bLine); // Only add if they actually budgeted money
                }
            }
            else if (ext == ".csv")
            {
                ms.Position = 0;
                using var reader = new StreamReader(ms);
                var headerLine = await reader.ReadLineAsync();
                if (string.IsNullOrEmpty(headerLine)) return;

                var headers = headerLine.Split(',').Select(h => h.Trim()).ToList();
                string line;
                
                while ((line = await reader.ReadLineAsync()) != null)
                {
                    var parts = line.Split(',').Select(p => p.Trim().Trim('"')).ToList();
                    if (parts.Count == 0 || string.IsNullOrEmpty(parts[0])) continue;

                    var code = parts[0];
                    var acc = glAccounts.FirstOrDefault(a => a.AccountCode.Equals(code, StringComparison.OrdinalIgnoreCase));
                    if (acc == null) continue;

                    var bLine = new BudgetLine { GlAccountId = acc.Id };
                    foreach(var p in openPeriods)
                        bLine.PeriodAllocations.Add(new BudgetPeriodAllocation { AccountingPeriodId = p.Id, PeriodName = p.PeriodName });

                    bool hasAnyAmount = false;
                    for (int i = 2; i < parts.Count && i < headers.Count; i++)
                    {
                        var colName = headers[i];
                        var alloc = bLine.PeriodAllocations.FirstOrDefault(p => p.PeriodName.Equals(colName, StringComparison.OrdinalIgnoreCase));
                        if (alloc != null)
                        {
                            if (decimal.TryParse(parts[i], out decimal amt) && amt > 0)
                            {
                                alloc.Amount = amt;
                                hasAnyAmount = true;
                            }
                        }
                    }
                    if (hasAnyAmount) newLines.Add(bLine);
                }
            }

            if (newLines.Any())
            {
                // Clear any empty lines from the UI before merging
                budget.Lines.RemoveAll(l => l.GlAccountId == Guid.Empty);

                foreach (var nl in newLines)
                {
                    var existing = budget.Lines.FirstOrDefault(l => l.GlAccountId == nl.GlAccountId);
                    if (existing != null)
                    {
                        // Overwrite existing amounts
                        foreach(var na in nl.PeriodAllocations)
                        {
                            var ea = existing.PeriodAllocations.FirstOrDefault(a => a.AccountingPeriodId == na.AccountingPeriodId);
                            if (ea != null && na.Amount.HasValue) ea.Amount = na.Amount;
                        }
                    }
                    else
                    {
                        budget.Lines.Add(nl);
                    }
                }
                await JS.InvokeVoidAsync("alert", $"Imported {newLines.Count} budget accounts successfully.");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "No valid budget data was found in the file.");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Import failed: {ex.Message}");
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task SaveBudget()
    {
        if (string.IsNullOrWhiteSpace(budget.BudgetName)) { await JS.InvokeVoidAsync("alert", "Enter Budget Name."); return; }
        
        if (budget.Lines.Where(l => l.GlAccountId != Guid.Empty).GroupBy(l => l.GlAccountId).Any(g => g.Count() > 1))
        {
            await JS.InvokeVoidAsync("alert", "Error: You have selected the same GL Account multiple times in Spending Limits. Please combine them.");
            return;
        }

        isSaving = true;
        try
        {
            var err = await BudgetService.SaveBudgetAsync(budget);
            if (string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", "Budget Saved Successfully!");
                showForm = false; 
                await RefreshList(); 
            }
            else
            {
                await JS.InvokeVoidAsync("alert", err);
            }
        }
        finally
        {
            isSaving = false;
        }
    }
}