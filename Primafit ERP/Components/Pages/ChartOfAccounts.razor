@page "/gl/chart-of-accounts"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using System.Text
@inject GLService Service
@inject ProjectService ProjectService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in duration-500">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Detailed Ledger View</h1>
            <p class="text-sm text-slate-500 mt-1">A flat view of all sub-accounts joined with their master parents and projects.</p>
        </div>

        <div class="flex gap-3">
            @if (!showForm)
            {
                <button @onclick="OpenCreateForm"
                        class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-200 hover:bg-indigo-700 hover:shadow-lg transition-all active:scale-95">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                    Add Sub-Account
                </button>
            }

            <label class="cursor-pointer inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-indigo-600 transition-all">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                Import (CSV)
                <InputFile OnChange="ImportCsv" class="hidden" accept=".csv" />
            </label>

            <button @onclick="ExportCsv" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-indigo-600 transition-all">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export CSV
            </button>
        </div>
    </div>

    @* --- EDIT/CREATE FORM (Unchanged) --- *@
    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 transition-all duration-300 animate-in fade-in slide-in-from-top-4">

            <div class="flex items-center justify-between mb-8">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">
                        @(isEditing ? "Edit Sub-Account" : "Create New Sub-Account")
                    </h3>
                    <p class="text-sm text-slate-500">Manage account details below.</p>
                </div>
                @if (isEditing)
                {
                    <span class="inline-flex items-center rounded-lg bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-700/10">Editing Mode</span>
                }
            </div>

            <EditForm Model="@currentSub" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                    <div>
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Master Account</label>
                        <div class="relative">
                            <InputSelect @bind-Value="currentSub.MasterAccountId" class="@InputClass">
                                <option value="@Guid.Empty">-- Select Parent --</option>
                                @foreach (var m in masterAccounts)
                                {
                                    <option value="@m.Id">@m.AccountCode - @m.AccountName</option>
                                }
                            </InputSelect>
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Sub-Code</label>
                        <div class="flex items-center rounded-xl border border-slate-200 bg-white focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/20 overflow-hidden transition-all shadow-sm">
                            <span class="bg-slate-50 px-3 py-2.5 border-r border-slate-200 text-slate-500 text-sm font-mono font-bold">
                                @(masterAccounts.FirstOrDefault(m => m.Id == currentSub.MasterAccountId)?.AccountCode ?? "XXXX") -
                            </span>
                            <InputText @bind-Value="currentSub.SubCode" class="w-full border-0 bg-transparent px-3 py-2.5 text-sm font-mono focus:ring-0 placeholder:text-slate-300" placeholder="001" />
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Account Name</label>
                        <InputText @bind-Value="currentSub.AccountName" class="@InputClass" placeholder="e.g. Petty Cash" />
                    </div>

                    <div class="md:col-span-2 p-4 rounded-xl bg-indigo-50/50 border border-indigo-100">
                        <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-indigo-700">Project Link</label>
                        <div class="relative">
                            <InputSelect @bind-Value="currentSub.ProjectId" class="@InputClass">
                                <option value="">-- No Project (General) --</option>
                                @foreach (var p in projects)
                                {
                                    <option value="@p.Id">@p.Code - @p.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex items-center justify-between border-t border-slate-100 pt-6">
                    <div>
                        @if (isEditing)
                        {
                            <button type="button" @onclick="DeleteSub"
                                    class="inline-flex items-center gap-2 rounded-xl border border-red-100 bg-red-50 px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-100 transition-colors">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                Delete
                            </button>
                        }
                    </div>

                    <div class="flex gap-3">
                        <button type="button" @onclick="CloseForm" class="rounded-xl px-5 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                            Cancel
                        </button>

                        <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-200 hover:bg-indigo-700 transition-all active:scale-95">
                            @if (isEditing)
                            {
                                <span>Update Sub-Account</span>
                            }
                            else
                            {

                                <span>Create Sub-Account</span>
                            }
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50/50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4">Sub Code</th>
                        <th class="px-6 py-4">Sub Account Name</th>
                        <th class="px-6 py-4">Master Code</th>
                        <th class="px-6 py-4">Master Name</th>
                        <th class="px-6 py-4">Type</th>
                        <th class="px-6 py-4">Project</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (isLoading)
                    {
                        <tr><td colspan="7" class="px-6 py-8 text-center text-slate-400">Loading accounts...</td></tr>
                    }
                    else if (!reportData.Any())
                    {
                        <tr><td colspan="7" class="px-6 py-8 text-center text-slate-400">No records found.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in PagedData)
                        {
                            <tr class="hover:bg-slate-50 transition-colors group @(currentSub.Id == item.Id && isEditing ? "bg-indigo-50/30" : "")">
                                <td class="px-6 py-4 font-mono font-medium text-indigo-600">@item.SubCode</td>
                                <td class="px-6 py-4 font-medium text-slate-900">@item.AccountName</td>
                                <td class="px-6 py-4 font-mono text-slate-500">@item.MasterAccount?.AccountCode</td>
                                <td class="px-6 py-4 text-slate-600">@item.MasterAccount?.AccountName</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-500/10">
                                        @item.MasterAccount?.AccountType
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.LinkedProject != null)
                                    {
                                        <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-600/10">
                                            <span class="h-1.5 w-1.5 rounded-full bg-indigo-500"></span>
                                            @item.LinkedProject.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 italic text-xs">General Overhead</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button @onclick="() => EditSub(item)"
                                            class="rounded-lg border border-slate-200 bg-white p-2 text-slate-500 shadow-sm hover:border-indigo-300 hover:text-indigo-600 transition-all"
                                            title="Edit Sub-Account">
                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="flex items-center justify-between border-t border-slate-100 bg-slate-50 px-6 py-3">
            <div class="text-xs text-slate-500">
                Showing @((CurrentPage - 1) * PageSize + 1) to @(Math.Min(CurrentPage * PageSize, reportData.Count)) of @reportData.Count results
            </div>
            <div class="flex gap-2">
                <button @onclick="PreviousPage" disabled="@(CurrentPage == 1)" class="rounded-lg border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 shadow-sm hover:bg-slate-50 disabled:opacity-50">Previous</button>
                <button @onclick="NextPage" disabled="@(CurrentPage == TotalPages)" class="rounded-lg border border-slate-200 bg-white px-3 py-1 text-xs font-medium text-slate-600 shadow-sm hover:bg-slate-50 disabled:opacity-50">Next</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Simple JS helper for file download
    window.downloadFile = (fileName, content) => {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = "data:text/csv;charset=utf-8," + encodeURIComponent(content);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
</script>

@code {
    private const string InputClass = "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all";

    private List<GLSubAccount> reportData = new();
    private List<GLMasterAccount> masterAccounts = new();
    private List<Project> projects = new();

    private GLSubAccount currentSub = new();
    private bool isLoading = true;
    private bool showForm = false;
    private bool isEditing = false;

    // PAGINATION STATE
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)reportData.Count / PageSize);
    private IEnumerable<GLSubAccount> PagedData => reportData.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        reportData = await Service.GetAllSubsAsync();
        masterAccounts = await Service.GetMastersAsync();
        projects = await ProjectService.GetProjectsAsync();
        isLoading = false;
        StateHasChanged();
    }

    // --- PAGINATION ACTIONS ---
    private void NextPage() { if (CurrentPage < TotalPages) CurrentPage++; }
    private void PreviousPage() { if (CurrentPage > 1) CurrentPage--; }

    // --- CSV EXPORT ---
    private async Task ExportCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("SubCode,AccountName,MasterCode,MasterName,Type,Project");

        foreach (var item in reportData)
        {
            var project = item.LinkedProject?.Name ?? "General";
            sb.AppendLine($"{item.SubCode},{item.AccountName},{item.MasterAccount?.AccountCode},{item.MasterAccount?.AccountName},{item.MasterAccount?.AccountType},{project}");
        }

        await JS.InvokeVoidAsync("downloadFile", "Chart Of Accounts.csv", sb.ToString());
    }

    // --- CSV IMPORT ---
    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1MB limit
            using var reader = new StreamReader(stream);
            var text = await reader.ReadToEndAsync();
            var lines = text.Split('\n');

            foreach (var line in lines.Skip(1)) // Skip Header
            {
                if (string.IsNullOrWhiteSpace(line)) continue;

                var cols = line.Split(',');
                if (cols.Length < 3) continue; // Basic validation

                // Expected Format: SubCode, Name, MasterCode
                var subCode = cols[0].Trim();
                var name = cols[1].Trim();
                var masterCode = cols[2].Trim();

                // Find Master ID by Code
                var master = masterAccounts.FirstOrDefault(m => m.AccountCode == masterCode);
                if (master != null)
                {
                    var newAcc = new GLSubAccount
                    {
                        SubCode = subCode,
                        AccountName = name,
                        MasterAccountId = master.Id
                    };
                    await Service.CreateSubAsync(newAcc);
                }
            }
            await LoadData();
            await JS.InvokeVoidAsync("alert", "Import Successful!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Import Failed: {ex.Message}");
        }
    }

    // --- EXISTING CRUD LOGIC (Unchanged) ---
    private void OpenCreateForm() { currentSub = new GLSubAccount(); isEditing = false; showForm = true; }
    private void CloseForm() { showForm = false; isEditing = false; currentSub = new GLSubAccount(); }
    private void EditSub(GLSubAccount item)
    {
        currentSub = new GLSubAccount { Id = item.Id, SubCode = item.SubCode, AccountName = item.AccountName, MasterAccountId = item.MasterAccountId, ProjectId = item.ProjectId };
        isEditing = true; showForm = true;
    }
    private async Task HandleSubmit()
    {
        if (currentSub.MasterAccountId == Guid.Empty) return;
        bool success = isEditing ? await Service.UpdateSubAsync(currentSub) : await Service.CreateSubAsync(currentSub);
        if (success) { CloseForm(); await LoadData(); }
    }
    private async Task DeleteSub()
    {
        if (await JS.InvokeAsync<bool>("confirm", $"Delete {currentSub.AccountName}?")) { await Service.DeleteSubAsync(currentSub.Id); CloseForm(); await LoadData(); }
    }
}