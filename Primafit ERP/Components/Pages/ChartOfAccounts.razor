@page "/gl/chart-of-accounts"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text
@inject GLSetupService GLService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Chart of Accounts</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Manage transactional accounts (leaf nodes) linked to Main Accounts.</p>
        </div>

        <div class="flex gap-2">
            <label class="cursor-pointer inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50 transition-all active:scale-95 disabled:opacity-50">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <span>Import</span>
                <InputFile OnChange="ImportCsv" class="hidden" accept=".csv" disabled="@(!HasCompany)" />
            </label>

            <button @onclick="ExportCsv" disabled="@(!HasCompany || !chartOfAccounts.Any())"
                    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                <span>Export</span>
            </button>

            <button @onclick="OpenForm" disabled="@(!HasCompany)"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                New Account
            </button>
        </div>
    </div>

    @if (showForm && HasCompany)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 animate-in fade-in slide-in-from-top-4">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">New Transaction Account</h3>
                    <p class="text-sm text-slate-500">Create a leaf account linked to a main header.</p>
                </div>
                <button @onclick="CloseForm" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="@newAccount" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <div class="md:col-span-5">
                        <label class="label">Main Account (Header)</label>
                        <InputSelect @bind-Value="newAccount.MainAccountId" class="@InputClass">
                            <option value="@Guid.Empty">-- Select Header --</option>
                            @foreach (var m in mainAccounts)
                            {
                                <option value="@m.Id">@m.Code - @m.Name (@m.AccountType?.Name)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="md:col-span-3">
                        <label class="label">Account Code</label>
                        <InputText @bind-Value="newAccount.AccountCode" class="@InputClass" placeholder="e.g. 1001" />
                    </div>
                    <div class="md:col-span-4">
                        <label class="label">Account Name</label>
                        <InputText @bind-Value="newAccount.AccountName" class="@InputClass" placeholder="e.g. Petty Cash" />
                    </div>
                </div>
                <div class="mt-8 flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" @onclick="CloseForm" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancel</button>
                    <button type="submit" disabled="@isSaving" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                        @(isSaving ? "Saving..." : "Save Account")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-900">
            <thead class="bg-slate-50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                <tr>
                    <th class="px-6 py-4 w-32">Acct Code</th>
                    <th class="px-6 py-4">Account Name</th>
                    <th class="px-6 py-4">Main Header</th>
                    <th class="px-6 py-4">Type</th>
                    <th class="px-6 py-4">Class</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (isLoading)
                {
                    <tr><td colspan="5" class="px-6 py-12 text-center text-slate-400 animate-pulse">Loading data...</td></tr>
                }
                else if (PagedAccounts.Any())
                {
                    @foreach (var a in PagedAccounts)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-mono font-bold text-slate-900">@a.AccountCode</td>
                            <td class="px-6 py-4 font-semibold text-slate-900">@a.AccountName</td>
                            <td class="px-6 py-4">
                                <span class="text-slate-500 text-xs uppercase font-bold tracking-wide mr-1">@a.MainAccount?.Code</span>
                                <span class="font-medium text-slate-700">@a.MainAccount?.Name</span>
                            </td>
                            <td class="px-6 py-4 text-slate-600">@a.MainAccount?.AccountType?.Name</td>
                            <td class="px-6 py-4">
                                @if (a.MainAccount?.AccountType != null)
                                {
                                    <span class="inline-flex items-center rounded border border-slate-200 bg-slate-100 px-2 py-1 text-xs font-bold text-slate-900">
                                        @a.MainAccount.AccountType.Class
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                            No accounts found for this company.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (TotalPages > 1)
        {
            <div class="flex items-center justify-between border-t border-slate-100 px-6 py-4 bg-slate-50/50">
                <div class="text-xs font-medium text-slate-500">
                    Page <span class="text-slate-900 font-bold">@currentPage</span> of <span class="text-slate-900 font-bold">@TotalPages</span>
                </div>
                <div class="flex gap-2">
                    <button disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)" class="btn-paginate">Previous</button>
                    <button disabled="@(currentPage == TotalPages)" @onclick="() => ChangePage(currentPage + 1)" class="btn-paginate">Next</button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Professional Typography & Inputs */
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.025em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
        }

    /* Pagination Buttons */
    .btn-paginate {
        border-radius: 0.5rem;
        border: 1px solid #e2e8f0;
        background: white;
        padding: 0.35rem 0.85rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #334155;
        transition: all 0.2s;
    }

        .btn-paginate:hover:not(:disabled) {
            background: #f1f5f9;
            border-color: #cbd5e1;
            color: #0f172a;
        }

        .btn-paginate:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
</style>

@code {
    private const string InputClass = "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-200 transition-all";

    // --- CONTEXT ---
    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;

    // --- DATA ---
    private List<GLMainAccount> mainAccounts = new();
    private List<GLChartOfAccount> chartOfAccounts = new();
    private GLChartOfAccount newAccount = new();
    private bool showForm = false;
    private bool isSaving = false;

    // --- PAGINATION ---
    private int currentPage = 1;
    private int pageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)chartOfAccounts.Count / pageSize);
    private IEnumerable<GLChartOfAccount> PagedAccounts => chartOfAccounts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                await LoadData();
            }
        }
    }

    private async Task LoadData()
    {
        if (!HasCompany) return;

        isLoading = true;
        mainAccounts = await GLService.GetMainAccountsAsync(selectedCompanyId);
        chartOfAccounts = await GLService.GetChartOfAccountsAsync(selectedCompanyId);
        isLoading = false;
    }

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages) currentPage = newPage;
    }

    private void OpenForm() { newAccount = new GLChartOfAccount { CompanyId = selectedCompanyId }; showForm = true; }
    private void CloseForm() { showForm = false; }

    private async Task Save()
    {
        if (!HasCompany) return;
        if (newAccount.MainAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Main Account.");
            return;
        }

        try
        {
            isSaving = true;
            newAccount.CompanyId = selectedCompanyId;
            var msg = await GLService.CreateChartOfAccountAsync(selectedCompanyId, newAccount);

            if (!string.IsNullOrEmpty(msg))
            {
                await JS.InvokeVoidAsync("alert", msg);
                return;
            }

            await LoadData();
            CloseForm();
        }
        finally { isSaving = false; }
    }

    // --- EXPORT CSV ---
    private async Task ExportCsv()
    {
        var sb = new StringBuilder();
        sb.AppendLine("AccountCode,AccountName,MainAccountCode,MainAccountName,AccountType,Class");

        foreach (var a in chartOfAccounts)
        {
            var aName = a.AccountName.Replace(",", " ");
            var mName = a.MainAccount?.Name.Replace(",", " ") ?? "";
            // Safe null checks
            var mCode = a.MainAccount?.Code ?? "";
            var tName = a.MainAccount?.AccountType?.Name ?? "";
            var tClass = a.MainAccount?.AccountType?.Class.ToString() ?? "";

            sb.AppendLine($"{a.AccountCode},{aName},{mCode},{mName},{tName},{tClass}");
        }

        var fileName = $"COA_{DateTime.Now:yyyyMMdd}.csv";
        var preamble = Encoding.UTF8.GetPreamble();
        var content = Encoding.UTF8.GetBytes(sb.ToString());

        using var stream = new MemoryStream();
        stream.Write(preamble, 0, preamble.Length);
        stream.Write(content, 0, content.Length);
        stream.Position = 0;

        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    // --- IMPORT CSV ---
    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        if (!HasCompany) return;
        var file = e.File;
        if (file == null) return;

        using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var reader = new StreamReader(stream);

        int success = 0;
        int errors = 0;

        await reader.ReadLineAsync(); // Skip Header

        string? line;
        while ((line = await reader.ReadLineAsync()) != null)
        {
            if (string.IsNullOrWhiteSpace(line)) continue;
            var values = line.Split(',');

            if (values.Length < 3) { errors++; continue; }

            var acctCode = values[0].Trim();
            var acctName = values[1].Trim();
            var mainCode = values[2].Trim();

            // Link to Main Account via Code
            var matchedMain = mainAccounts.FirstOrDefault(m => m.Code.Equals(mainCode, StringComparison.OrdinalIgnoreCase));

            if (matchedMain != null)
            {
                var newAcct = new GLChartOfAccount
                {
                    CompanyId = selectedCompanyId,
                    AccountCode = acctCode,
                    AccountName = acctName,
                    MainAccountId = matchedMain.Id
                };

                var result = await GLService.CreateChartOfAccountAsync(selectedCompanyId, newAcct);
                if (string.IsNullOrEmpty(result)) success++; else errors++;
            }
            else
            {
                errors++; // Main Code not found
            }
        }

        await LoadData();
        await JS.InvokeVoidAsync("alert", $"Import Finished.\n\n✅ Success: {success}\n❌ Failed: {errors}");
    }
}