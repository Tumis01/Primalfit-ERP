@page "/chart-of-accounts"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject ChartOfAccountService ApiService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Chart of Accounts</h1>
            <p class="text-sm text-slate-500">Manage your financial ledger hierarchy.</p>
        </div>

        @if (!showForm)
        {
           <AuthorizeView Roles="SuperAdmin, CFO, Accountant">
                <Authorized>
                    <button @onclick="ShowCreateForm" ... >Add Account</button>
                </Authorized>
           </AuthorizeView>
        }
    </div>

    @if (showForm)
    {
        <div class="rounded-2xl border border-slate-200 bg-white shadow-sm animate-in fade-in slide-in-from-top-4 duration-300">
            <div class="border-b border-slate-100 px-6 py-4">
                <h2 class="font-semibold text-slate-900">@(isEditing ? "Edit Account" : "New Account")</h2>
            </div>

            <EditForm Model="@currentAccount" OnValidSubmit="HandleSubmit" class="p-6">
                <DataAnnotationsValidator />

                <div class="grid gap-6 md:grid-cols-2 items-start">

                    <div class="space-y-6">
                        <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
                            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Identity</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Account Code</label>
                                    <InputText @bind-Value="currentAccount.AccountCode" class="@InputClass" placeholder="e.g. 1000" />
                                </div>
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Account Name</label>
                                    <InputText @bind-Value="currentAccount.AccountName" class="@InputClass" placeholder="e.g. Petty Cash" />
                                </div>
                            </div>
                        </div>

                        <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
                            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Configuration</h3>
                            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 transition-colors hover:bg-slate-50">
                                <div class="flex h-5 items-center">
                                    <InputCheckbox @bind-Value="currentAccount.IsParent" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                                </div>
                                <div>
                                    <span class="block text-sm font-medium text-slate-900">Is Group / Header?</span>
                                    <span class="block text-xs text-slate-500">Check this if this account will act as a folder for other accounts and will not accept direct transactions.</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4">
                            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Hierarchy</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="mb-1 block text-sm font-medium text-slate-700">Parent Account</label>
                                    <InputSelect @bind-Value="currentAccount.ParentAccountId" class="@InputClass">
                                        <option value="">-- No Parent (Top Level) --</option>
                                        @foreach (var acc in accounts.OrderBy(x => x.AccountCode))
                                        {
                                            if (acc.AccountId != currentAccount.AccountId)
                                            {
                                                <option value="@acc.AccountId">
                                                    @if (acc.Level > 1)
                                                    {
                                                        @(new string('\u00A0', (acc.Level - 1) * 3) + "└ ")
                                                    }
                                                    @acc.AccountCode - @acc.AccountName
                                                </option>
                                            }
                                        }
                                    </InputSelect>
                                    <p class="mt-1.5 text-xs text-slate-500">
                                        Selecting a parent will automatically inherit the <strong>Type</strong> and <strong>Balance</strong> settings.
                                    </p>
                                </div>

                                @if (currentAccount.ParentAccountId == null)
                                {
                                    <div class="grid grid-cols-2 gap-4 animate-in fade-in slide-in-from-top-1">
                                        <div>
                                            <label class="mb-1 block text-sm font-medium text-slate-700">Account Type</label>
                                            <InputSelect @bind-Value="currentAccount.Type" class="@InputClass">
                                                @foreach (var t in Enum.GetValues<AccountType>())
                                                {
                                                    <option value="@t">@t</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div>
                                            <label class="mb-1 block text-sm font-medium text-slate-700">Normal Balance</label>
                                            <InputSelect @bind-Value="currentAccount.NormalBalance" class="@InputClass">
                                                <option value="@NormalBalance.Debit">Debit</option>
                                                <option value="@NormalBalance.Credit">Credit</option>
                                            </InputSelect>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-lg bg-indigo-50 border border-indigo-100 p-3 text-xs text-indigo-700">
                                        <span class="font-semibold">Note:</span> Classification settings are hidden because they are inherited from the selected Parent Account.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-8 flex items-center justify-end gap-3 border-t border-slate-100 pt-5">
                    <button type="button" @onclick="CancelForm" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900">
                        Cancel
                    </button>
                    <button type="submit" class="rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 shadow-sm transition-colors">
                        @(isEditing ? "Update Account" : "Save Account")
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs uppercase font-semibold text-slate-500">
                    <tr>
                        <th class="px-6 py-4">Code</th>
                        <th class="px-6 py-4">Account Name</th>
                        <th class="px-6 py-4">Type</th>
                        <th class="px-6 py-4">Level</th>
                        <th class="px-6 py-4 text-center">Header?</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (accounts == null)
                    {
                        <tr><td colspan="6" class="p-6 text-center text-slate-400">Loading accounts...</td></tr>
                    }
                    else if (!accounts.Any())
                    {
                        <tr><td colspan="6" class="p-6 text-center text-slate-400">No accounts found. Add one to get started.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in accounts)
                        {
                            <tr class="group hover:bg-slate-50/50 transition-colors">
                                <td class="px-6 py-3 font-mono text-xs font-semibold text-slate-900">@item.AccountCode</td>

                                <td class="px-6 py-3">
                                    <div style="padding-left: @((item.Level - 1) * 20)px" class="flex items-center gap-2">
                                        @if (item.Level > 1)
                                        {
                                            <span class="text-slate-300">└</span>
                                        }
                                        <span class="@(item.IsParent ? "font-bold text-slate-800" : "text-slate-600")">
                                            @item.AccountName
                                        </span>
                                    </div>
                                </td>

                                <td class="px-6 py-3">
                                    <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 border border-slate-200">
                                        @item.Type
                                    </span>
                                </td>
                                <td class="px-6 py-3 text-xs text-slate-400">Lvl @item.Level</td>
                                <td class="px-6 py-3 text-center">
                                    @if (item.IsParent)
                                    {
                                        <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-3 text-right">
                                    <AuthorizeView Roles="SuperAdmin, CFO, Accountant">
                                        <Authorized>
                                            <button @onclick="() => EditAccount(item)" ... >Edit</button>
                                        </Authorized>
                                    </AuthorizeView>

                                    <AuthorizeView Roles="SuperAdmin">
                                        <Authorized>
                                            <button @onclick="() => DeleteAccount(item)" ... >Delete</button>
                                        </Authorized>
                                    </AuthorizeView>
                            </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    // 1. Styling Constant (Same as Companies page for consistency)
    private const string InputClass = "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-4 focus:ring-indigo-500/10";

    private List<ChartOfAccount> accounts = new();
    private ChartOfAccount currentAccount = new();
    private bool showForm = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // Get data and Sort by Code so the hierarchy (01 -> 011) looks correct in the table
        var data = await ApiService.GetAccountsAsync();
        accounts = data.OrderBy(x => x.AccountCode).ToList();
    }

    private void ShowCreateForm()
    {
        currentAccount = new ChartOfAccount { CompanyDetailsId = Guid.NewGuid() }; // Replace Guid with real CompanyID later
        isEditing = false;
        showForm = true;
    }

    private void EditAccount(ChartOfAccount item)
    {
        // Clone object
        currentAccount = new ChartOfAccount
        {
            AccountId = item.AccountId,
            AccountCode = item.AccountCode,
            AccountName = item.AccountName,
            ParentAccountId = item.ParentAccountId,
            Type = item.Type,
            NormalBalance = item.NormalBalance,
            IsParent = item.IsParent,
            Level = item.Level
        };
        isEditing = true;
        showForm = true;
    }

    private async Task HandleSubmit()
    {
        if (isEditing)
        {
            await ApiService.UpdateAccountAsync(currentAccount.AccountId, currentAccount);
        }
        else
        {
            await ApiService.CreateAccountAsync(currentAccount);
        }
        showForm = false;
        await LoadData();
    }

    private async Task DeleteAccount(ChartOfAccount item)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {item.AccountName}?");
        if (confirmed)
        {
            string? error = await ApiService.DeleteAccountAsync(item.AccountId);
            if (error != null)
            {
                await JS.InvokeVoidAsync("alert", $"Cannot delete: {error}");
            }
            else
            {
                await LoadData();
            }
        }
    }

    private void CancelForm()
    {
        showForm = false;
    }
}