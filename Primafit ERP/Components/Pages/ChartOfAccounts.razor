@page "/gl/chart-of-accounts"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using System.Text
@inject GLSetupService GLService
@inject CompanyApiService CompanyService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Chart of Accounts</h1>
            <p class="text-sm text-slate-500">Transactional accounts (leaf nodes) linked to Main Accounts.</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-2">
            <label class="cursor-pointer inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-indigo-600 transition-all disabled:opacity-50 @(!HasCompany ? "opacity-50 pointer-events-none" : "")">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                Import CSV
                <InputFile OnChange="ImportCsv" class="hidden" accept=".csv" disabled="@(!HasCompany)" />
            </label>

            <button @onclick="ExportCsv" disabled="@(!HasCompany || !chartOfAccounts.Any())"
                    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 hover:text-indigo-600 transition-all disabled:opacity-50">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export
            </button>

            <button @onclick="OpenForm"
                    disabled="@(!HasCompany)"
                    class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
                + Add Account
            </button>
        </div>
    </div>

    <div class="w-full sm:max-w-sm">
        <label class="mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500">Company</label>
        <select class="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
                value="@selectedCompanyId"
                @onchange="OnCompanyChanged">
            <option value="@Guid.Empty">-- Select Company --</option>
            @foreach (var c in companies)
            {
                <option value="@c.CompanyDetailsId">@c.CompanyName</option>
            }
        </select>
    </div>

    @if (isBusy)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-500 shadow-sm text-center">
            <span class="inline-block animate-pulse">Loading data...</span>
        </div>
    }
    else if (HasCompany)
    {
        @if (showForm)
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm animate-in fade-in slide-in-from-top-2">
                <div class="mb-4 flex items-center justify-between border-b border-slate-100 pb-3">
                    <div>
                        <h3 class="font-semibold text-slate-800">New COA Account</h3>
                        <p class="text-xs text-slate-500">Select a Main Account to inherit Type and Class.</p>
                    </div>
                    <button type="button" @onclick="CloseForm" class="rounded-xl border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Close</button>
                </div>

                <EditForm Model="@newAccount" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                        <div class="md:col-span-5">
                            <label class="mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500">Main Account</label>
                            <InputSelect @bind-Value="newAccount.MainAccountId" class="@InputClass">
                                <option value="@Guid.Empty">-- Select Main Account --</option>
                                @foreach (var m in mainAccounts)
                                {
                                    <option value="@m.Id">@m.Code - @m.Name (@m.AccountType?.Name)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="md:col-span-3">
                            <label class="mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500">Account Code</label>
                            <InputText @bind-Value="newAccount.AccountCode" class="@InputClass" placeholder="e.g. 1001" />
                        </div>
                        <div class="md:col-span-4">
                            <label class="mb-1 block text-xs font-bold uppercase tracking-wide text-slate-500">Account Name</label>
                            <InputText @bind-Value="newAccount.AccountName" class="@InputClass" placeholder="e.g. HEAD OFFICE BUILDING" />
                        </div>
                    </div>
                    <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-5">
                        <button type="button" @onclick="CloseForm" class="rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancel</button>
                        <button type="submit" disabled="@isSaving" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition-all active:scale-95 disabled:opacity-50">
                            @(isSaving ? "Saving..." : "Save Account")
                        </button>
                    </div>
                </EditForm>
            </div>
        }

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50/50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-100">
                        <tr>
                            <th class="px-6 py-4">Acct Code</th>
                            <th class="px-6 py-4">Acct Name</th>
                            <th class="px-6 py-4">Main</th>
                            <th class="px-6 py-4">Type</th>
                            <th class="px-6 py-4">Class</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-slate-100">
                        @if (PagedAccounts.Any())
                        {
                            @foreach (var a in PagedAccounts)
                            {
                                <tr class="hover:bg-slate-50/50 transition-colors">
                                    <td class="px-6 py-4 font-mono font-bold text-indigo-600">@a.AccountCode</td>
                                    <td class="px-6 py-4 font-medium text-slate-900">@a.AccountName</td>
                                    <td class="px-6 py-4">
                                        <span class="font-mono text-slate-700">@a.MainAccount?.Code</span>
                                        <span class="text-slate-400"> — </span>
                                        <span>@a.MainAccount?.Name</span>
                                    </td>
                                    <td class="px-6 py-4">@a.MainAccount?.AccountType?.Name</td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center rounded-md bg-slate-100 px-2.5 py-1 text-xs font-bold text-slate-600 ring-1 ring-inset ring-slate-500/10">
                                            @a.MainAccount?.AccountType?.Class
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-10 text-center text-slate-400">
                                    No chart of accounts found for this company.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TotalPages > 1)
            {
                <div class="flex items-center justify-between border-t border-slate-100 px-6 py-4">
                    <div class="text-xs text-slate-500">
                        Page <span class="font-bold">@currentPage</span> of <span class="font-bold">@TotalPages</span>
                    </div>
                    <div class="flex gap-2">
                        <button disabled="@(currentPage == 1)" @onclick="() => ChangePage(currentPage - 1)"
                                class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">
                            Previous
                        </button>
                        <button disabled="@(currentPage == TotalPages)" @onclick="() => ChangePage(currentPage + 1)"
                                class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">
                            Next
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-slate-500 shadow-sm">
            Please select a company to view the chart of accounts.
        </div>
    }
</div>

@code {
    private const string InputClass = "w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-all";

    private List<CompanyDetails> companies = new();
    private List<GLMainAccount> mainAccounts = new();
    private List<GLChartOfAccount> chartOfAccounts = new();

    private Guid selectedCompanyId = Guid.Empty;
    private bool HasCompany => selectedCompanyId != Guid.Empty;

    private bool showForm = false;
    private bool isBusy = false;
    private bool isSaving = false;
    private GLChartOfAccount newAccount = new();

    // Pagination Logic
    private int currentPage = 1;
    private int pageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)chartOfAccounts.Count / pageSize);
    private IEnumerable<GLChartOfAccount> PagedAccounts => chartOfAccounts.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        companies = await CompanyService.GetCompaniesAsync();
        if (companies.Any())
        {
            selectedCompanyId = companies[0].CompanyDetailsId;
            await LoadData();
        }
    }

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e?.Value?.ToString(), out var id))
        {
            selectedCompanyId = id;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        showForm = false;
        newAccount = new();
        currentPage = 1;

        if (!HasCompany)
        {
            mainAccounts.Clear();
            chartOfAccounts.Clear();
            return;
        }

        try
        {
            isBusy = true;
            mainAccounts = await GLService.GetMainAccountsAsync(selectedCompanyId);
            chartOfAccounts = await GLService.GetChartOfAccountsAsync(selectedCompanyId);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages) currentPage = newPage;
    }

    private void OpenForm()
    {
        if (!HasCompany) return;
        newAccount = new GLChartOfAccount { CompanyId = selectedCompanyId };
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        newAccount = new();
    }

    private async Task Save()
    {
        if (!HasCompany) return;
        if (newAccount.MainAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Main Account.");
            return;
        }

        try
        {
            isSaving = true;
            newAccount.CompanyId = selectedCompanyId;
            var msg = await GLService.CreateChartOfAccountAsync(selectedCompanyId, newAccount);
            if (!string.IsNullOrEmpty(msg))
            {
                await JS.InvokeVoidAsync("alert", msg);
                return;
            }
            await LoadData();
            CloseForm();
        }
        finally
        {
            isSaving = false;
        }
    }

    // --- CSV EXPORT (EXCEL COMPATIBLE) ---
    private async Task ExportCsv()
    {
        var sb = new StringBuilder();
        // CSV Header including extra details you requested
        sb.AppendLine("AccountCode,AccountName,MainAccountCode,MainAccountName,AccountType,Class");

        foreach (var a in chartOfAccounts)
        {
            // Sanitize
            var aName = a.AccountName.Replace(",", " ");
            var mName = a.MainAccount?.Name.Replace(",", " ") ?? "";

            sb.AppendLine($"{a.AccountCode},{aName},{a.MainAccount?.Code},{mName},{a.MainAccount?.AccountType?.Name},{a.MainAccount?.AccountType?.Class}");
        }

        var fileName = $"COA_{DateTime.Now:yyyyMMdd_HHmm}.csv";

        // Add Byte Order Mark (BOM) for Excel
        var preamble = Encoding.UTF8.GetPreamble();
        var content = Encoding.UTF8.GetBytes(sb.ToString());

        using var stream = new MemoryStream();
        stream.Write(preamble, 0, preamble.Length);
        stream.Write(content, 0, content.Length);
        stream.Position = 0;

        using var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);
    }

    // --- CSV IMPORT (ASYNC FIX) ---
    private async Task ImportCsv(InputFileChangeEventArgs e)
    {
        if (!HasCompany) return;
        var file = e.File;
        if (file == null) return;

        // 2MB Limit
        using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var reader = new StreamReader(stream);

        int successCount = 0;
        int errorCount = 0;

        // Skip header
        await reader.ReadLineAsync();

        string? line;

        // FIX: Use async loop instead of EndOfStream
        while ((line = await reader.ReadLineAsync()) != null)
        {
            if (string.IsNullOrWhiteSpace(line)) continue;
            var values = line.Split(',');

            // Ensure we have at least AccountCode, Name, MainCode (3 columns)
            if (values.Length < 3) { errorCount++; continue; }

            var acctCode = values[0].Trim();
            var acctName = values[1].Trim();
            var mainCode = values[2].Trim();

            // Link to Main Account
            var matchedMain = mainAccounts.FirstOrDefault(m => m.Code.Equals(mainCode, StringComparison.OrdinalIgnoreCase));

            if (matchedMain != null)
            {
                var newAcct = new GLChartOfAccount
                {
                    CompanyId = selectedCompanyId,
                    AccountCode = acctCode,
                    AccountName = acctName,
                    MainAccountId = matchedMain.Id
                };

                var result = await GLService.CreateChartOfAccountAsync(selectedCompanyId, newAcct);
                if (string.IsNullOrEmpty(result)) successCount++;
                else errorCount++;
            }
            else
            {
                errorCount++; // Main Account Code not found in system
            }
        }

        await LoadData();
        await JS.InvokeVoidAsync("alert", $"Import Finished.\n\n✅ Success: {successCount}\n❌ Failed/Duplicates: {errorCount}\n\n(Tip: Ensure Main Account Code exists in 'Main Accounts' before importing)");
    }
}