@page "/reports/dashboard"
@using Primafit_ERP.Services
@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Components.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@inject FinancialReportingService FinanceReports
@inject OperationalReportingService OpsReports
@inject BudgetService BudgetService
@inject ReportExportService Exporter
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-8 animate-in fade-in duration-500 mb-20">

    <div class="bg-gradient-to-r from-slate-900 to-slate-800 p-8 rounded-3xl shadow-lg text-white flex flex-col md:flex-row justify-between items-center gap-6">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">Intelligence & Analytics</h1>
            <p class="text-slate-300 mt-2">Generate standard financial and operational reports.</p>
        </div>
        <div class="bg-white/10 px-6 py-3 rounded-2xl border border-white/20 backdrop-blur-sm">
            <label class="text-xs font-bold text-slate-300 uppercase tracking-widest block mb-1">Global Date Filter</label>
            <div class="flex gap-3">
                <input type="date" @bind="globalStartDate" class="bg-transparent text-white border-b border-white/30 focus:border-white outline-none font-mono text-sm" />
                <span class="text-slate-400">to</span>
                <input type="date" @bind="globalEndDate" class="bg-transparent text-white border-b border-white/30 focus:border-white outline-none font-mono text-sm" />
            </div>
        </div>
    </div>

    @if (isProcessing)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 backdrop-blur-sm">
            <div class="bg-white p-8 rounded-2xl shadow-2xl flex flex-col items-center">
                <div class="w-12 h-12 border-4 border-indigo-200 border-t-indigo-600 rounded-full animate-spin mb-4"></div>
                <h3 class="font-bold text-slate-900">Generating Report...</h3>
                <p class="text-xs text-slate-500">Compiling data and rendering file.</p>
            </div>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <ReportCard Title="Trial Balance" 
                    Description="A mathematical proof that Debits equal Credits across all segmented accounts for the period." 
                    IconPath="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                    ColorClass="text-emerald-600 bg-emerald-50 border-emerald-100"
                    OnGeneratePdf="() => HandleReport(1, isPdf: true)"
                    OnGenerateExcel="() => HandleReport(1, isPdf: false)" />

        <ReportCard Title="Profit & Loss (P&L)" 
                    Description="Income statement tracking revenue, COGS, and operating expenses to calculate Net Profit." 
                    IconPath="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    ColorClass="text-emerald-600 bg-emerald-50 border-emerald-100"
                    OnGeneratePdf="() => HandleReport(2, isPdf: true)"
                    OnGenerateExcel="() => HandleReport(2, isPdf: false)" />

        <ReportCard Title="Balance Sheet" 
                    Description="Snapshot of Assets, Liabilities, and Equity (including current period retained earnings)." 
                    IconPath="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"
                    ColorClass="text-emerald-600 bg-emerald-50 border-emerald-100"
                    OnGeneratePdf="() => HandleReport(3, isPdf: true)"
                    OnGenerateExcel="() => HandleReport(3, isPdf: false)" />

        <ReportCard Title="Budget Variance Report" 
                    Description="Compare the Active Budget against Actual GL postings and Encumbered (Open PO) commitments." 
                    IconPath="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ColorClass="text-rose-600 bg-rose-50 border-rose-100"
                    OnGeneratePdf="() => HandleReport(4, isPdf: true)"
                    OnGenerateExcel="() => HandleReport(4, isPdf: false)" />

        <ReportCard Title="Inventory Valuation (WACC)" 
                    Description="Real-time value of all physical inventory multiplied by their Weighted Average Cost." 
                    IconPath="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                    ColorClass="text-amber-600 bg-amber-50 border-amber-100"
                    OnGeneratePdf="() => HandleReport(5, isPdf: true)"
                    OnGenerateExcel="() => HandleReport(5, isPdf: false)" />

        <ReportCard Title="Internal Consumption Log" 
                    Description="Audit trail of items consumed internally via Project Issues." 
                    IconPath="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                    ColorClass="text-amber-600 bg-amber-50 border-amber-100"
                    OnGeneratePdf="() => HandleReport(6, isPdf: true)"
                    OnGenerateExcel="() => HandleReport(6, isPdf: false)" />

        <ReportCard Title="Stock Aging Report" 
                    Description="Identify slow-moving items (90+ days no movement) and calculate dead capital tied up." 
                    IconPath="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    ColorClass="text-amber-600 bg-amber-50 border-amber-100"
                    OnGeneratePdf="() => HandleReport(7, isPdf: true)"
                    OnGenerateExcel="() => HandleReport(7, isPdf: false)" />
    </div>
</div>

@code {
    public RenderFragment ReportCard(string Title, string Description, string IconPath, string ColorClass, EventCallback OnGeneratePdf, EventCallback OnGenerateExcel) => __builder =>
    {
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
                <div class="w-10 h-10 rounded-xl mb-4 flex items-center justify-center @ColorClass">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@IconPath" /></svg>
                </div>
                <h3 class="font-bold text-slate-900 mb-2">@Title</h3>
                <p class="text-xs text-slate-500 leading-relaxed mb-6">@Description</p>
            </div>
            
            <div class="flex gap-2 border-t border-slate-100 pt-4">
                <button @onclick="OnGeneratePdf" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-100 transition-colors">
                    <svg class="w-4 h-4 text-rose-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.5 14h-1v-2H8c-.55 0-1-.45-1-1v-3c0-.55.45-1 1-1h2.5v7zm3-4.5h-1v1h1c.28 0 .5-.22.5-.5s-.22-.5-.5-.5zm2.5-1.5h-2v2h1v1h-1v1h-1v-5h3v1zm-3.5 1h-1v-2h1c.55 0 1 .45 1 1s-.45 1-1 1zm-4.5-2v3h1v-3h-1z"/></svg>
                    PDF
                </button>
                <button @onclick="OnGenerateExcel" class="flex-1 flex items-center justify-center gap-2 px-3 py-2 bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-100 transition-colors">
                    <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 24 24"><path d="M21.17 3.25Q21.5 3.25 21.76 3.5 22 3.74 22 4.08V19.92Q22 20.26 21.76 20.5 21.5 20.75 21.17 20.75H7.83Q7.5 20.75 7.24 20.5 7 20.26 7 19.92V17H2.83Q2.5 17 2.24 16.76 2 16.5 2 16.17V7.83Q2 7.5 2.24 7.24 2.5 7 2.83 7H7V4.08Q7 3.74 7.24 3.5 7.5 3.25 7.83 3.25M7 13.06L8.18 15.28H9.97L8 12.06L9.93 8.89H8.22L7.13 10.9L6.04 8.89H4.26L6.19 12.06L4.25 15.28H5.96M20.5 19.25V4.75H8.5V19.25Z"/></svg>
                    Excel
                </button>
            </div>
        </div>
    };
}

@code {
    private Guid currentCompanyId;
    private DateOnly globalStartDate = new DateOnly(DateTime.Today.Year, 1, 1);
    private DateOnly globalEndDate = DateOnly.FromDateTime(DateTime.Today);
    private bool isProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null) currentCompanyId = user.CompanyDetailsId.Value;
    }

    private async Task HandleReport(int reportId, bool isPdf)
    {
        if(currentCompanyId == Guid.Empty) return;

        isProcessing = true;
        StateHasChanged(); // Force UI to show loading spinner

        try
        {
            // 1. Gather Data based on Report ID
            StandardReportData data = null;

            switch (reportId)
            {
                case 1: data = await FinanceReports.GenerateTrialBalanceAsync(currentCompanyId, globalStartDate, globalEndDate); break;
                case 2: data = await FinanceReports.GeneratePnLAsync(currentCompanyId, globalStartDate, globalEndDate); break;
                case 3: data = await FinanceReports.GenerateBalanceSheetAsync(currentCompanyId, globalEndDate); break; // BS only uses End Date
                case 4: data = await BudgetService.GenerateVarianceReportAsync(currentCompanyId); break; // Doesn't use dates, uses Active Budget
                case 5: data = await OpsReports.GenerateInventoryValuationAsync(currentCompanyId); break; // Real-time
                case 6: data = await OpsReports.GenerateConsumptionLogAsync(currentCompanyId, globalStartDate, globalEndDate); break;
                case 7: data = await OpsReports.GenerateStockAgingReportAsync(currentCompanyId, 90); break; // 90 days default
            }

            if (data == null) throw new Exception("Report data failed to generate.");

            // 2. Export to Format
            byte[] fileBytes;
            string extension;
            string mimeType;

            if (isPdf)
            {
                fileBytes = Exporter.GeneratePdf(data);
                extension = ".pdf";
                mimeType = "application/pdf";
            }
            else
            {
                fileBytes = Exporter.GenerateExcel(data);
                extension = ".xlsx";
                mimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            }

            // 3. Download to User
            string safeName = data.ReportName.Replace(" ", "_").Replace("&", "and");
            string fileName = $"{safeName}_{DateTime.Now:yyyyMMddHHmmss}{extension}";
            await DownloadFile(fileName, fileBytes, mimeType);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Report Error: {ex.Message}");
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    // Standard JS Interop to trigger a file download in the browser
    private async Task DownloadFile(string fileName, byte[] bytes, string mimeType)
    {
        var base64 = Convert.ToBase64String(bytes);
        var url = $"data:{mimeType};base64,{base64}";

        await JS.InvokeVoidAsync("eval", $@"
            var a = document.createElement('a');
            a.href = '{url}';
            a.download = '{fileName}';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        ");
    }
}