@page "/reports/consumption-log"
@using Primafit_ERP.Services
@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Components.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject OperationalReportingService OpsService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager Nav

@rendermode InteractiveServer

<div class="max-w-7xl mx-auto mt-6">
    <ReportViewer CompanyId="companyId" Title="Internal Consumption & Project Issue Log"
                  Description="Audit trail of items consumed internally via Project Issues."
                  ShowDateRange="true"
                  FetchData="GetData" />
</div>

@code {
    private Guid companyId;

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("INVENTORY_REPORTS_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return; // Stop rendering
        }
        var user = await UserManager.GetUserAsync((await AuthStateProvider.GetAuthenticationStateAsync()).User);
        if (user?.CompanyDetailsId != null) companyId = user.CompanyDetailsId.Value;
    }

    private async Task<StandardReportData> GetData(DateOnly start, DateOnly end)
    {
        return await OpsService.GenerateConsumptionLogAsync(companyId, start, end);
    }
}