@page "/sc/business-partners"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject MasterDataService MasterService
@inject GLSetupService GLService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Business Partners</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Manage Customers and Vendors details and GL links.</p>
        </div>

        <div class="flex gap-2">
            <button @onclick="CreateNew" disabled="@(!HasCompany)"
                    class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                New Partner
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading data...
        </div>
    }
    else if (showForm && HasCompany)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-xl shadow-slate-200/50 ring-1 ring-slate-200 animate-in fade-in slide-in-from-top-4">
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">@(isEditing ? "Edit Partner" : "New Partner")</h3>
                    <p class="text-sm text-slate-500">Define partner roles and financial links.</p>
                </div>
                <button @onclick="() => showForm = false" class="rounded-lg p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors">
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <EditForm Model="@currentPartner" OnValidSubmit="SavePartner">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <label class="label">Partner Name</label>
                        <InputText @bind-Value="currentPartner.Name" class="input-class" placeholder="e.g. Global Supplies Ltd" />
                    </div>
                    <div>
                        <label class="label">Email / Contact</label>
                        <InputText @bind-Value="currentPartner.Email" class="input-class" placeholder="contact@global.com" />
                    </div>

                    <div class="md:col-span-2 flex gap-4 p-4 rounded-xl border border-slate-200 bg-slate-50">
                        <label class="flex items-center gap-3 cursor-pointer">
                            <InputCheckbox @bind-Value="currentPartner.IsCustomer" class="w-4 h-4 text-slate-900 rounded border-slate-300 focus:ring-slate-900" />
                            <span class="text-sm font-bold text-slate-900">Is Customer?</span>
                        </label>
                        <div class="w-px bg-slate-300 h-6"></div>
                        <label class="flex items-center gap-3 cursor-pointer">
                            <InputCheckbox @bind-Value="currentPartner.IsVendor" class="w-4 h-4 text-slate-900 rounded border-slate-300 focus:ring-slate-900" />
                            <span class="text-sm font-bold text-slate-900">Is Vendor?</span>
                        </label>
                    </div>

                    @if (currentPartner.IsCustomer)
                    {
                        <div class="animate-in fade-in slide-in-from-top-2">
                            <label class="label">Receivables Account (Asset)</label>
                            <InputSelect @bind-Value="currentPartner.ReceivablesAccountId" class="input-class">
                                <option value="">-- Select GL Account --</option>
                                @foreach (var a in assetAccounts)
                                {
                                    <option value="@a.Id">@a.AccountCode - @a.AccountName</option>
                                }
                            </InputSelect>
                        </div>
                    }
                    @if (currentPartner.IsVendor)
                    {
                        <div class="animate-in fade-in slide-in-from-top-2">
                            <label class="label">Payables Account (Liability)</label>
                            <InputSelect @bind-Value="currentPartner.PayablesAccountId" class="input-class">
                                <option value="">-- Select GL Account --</option>
                                @foreach (var a in liabilityAccounts)
                                {
                                    <option value="@a.Id">@a.AccountCode - @a.AccountName</option>
                                }
                            </InputSelect>
                        </div>
                    }
                </div>

                <div class="flex justify-end gap-3 border-t border-slate-100 pt-6">
                    <button type="button" @onclick="() => showForm = false" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">Cancel</button>
                    <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">Save Partner</button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-900">
            <thead class="bg-slate-50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                <tr>
                    <th class="px-6 py-4">Name</th>
                    <th class="px-6 py-4">Roles</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (partners.Any())
                {
                    @foreach (var p in partners)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-bold text-slate-900">@p.Name</div>
                                <div class="text-xs text-slate-500 font-medium">@p.Email</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex gap-2">
                                    @if (p.IsCustomer)
                                    {
                                        <span class="inline-flex items-center rounded border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-700">Customer</span>
                                    }
                                    @if (p.IsVendor)
                                    {
                                        <span class="inline-flex items-center rounded border border-slate-300 bg-white px-2 py-1 text-xs font-bold text-slate-700">Vendor</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button @onclick="() => Edit(p)" class="text-slate-600 hover:text-slate-900 font-bold hover:underline transition-all">Edit</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-6 py-12 text-center text-slate-400">No partners found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.025em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 23, 42, 0.1);
        }
</style>

@code {
    // --- Context ---
    private Guid selectedCompanyId = Guid.Empty;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;

    // --- Data ---
    private List<BusinessPartner> partners = new();
    private List<GLChartOfAccount> assetAccounts = new();
    private List<GLChartOfAccount> liabilityAccounts = new();

    private BusinessPartner currentPartner = new();
    private bool showForm = false;
    private bool isEditing = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                await LoadData();
            }
        }
        isLoading = false;
    }

    private async Task LoadData()
    {
        if (!HasCompany) return;

        partners = await MasterService.GetPartnersAsync(selectedCompanyId);

        var coa = await GLService.GetChartOfAccountsAsync(selectedCompanyId);
        assetAccounts = coa.Where(a => a.AccountCode.StartsWith("1")).ToList(); // Assets
        liabilityAccounts = coa.Where(a => a.AccountCode.StartsWith("2")).ToList(); // Liabilities
    }

    private void CreateNew()
    {
        currentPartner = new() { CompanyId = selectedCompanyId };
        isEditing = false;
        showForm = true;
    }

    private void Edit(BusinessPartner p)
    {
        currentPartner = new BusinessPartner
        {
            Id = p.Id,
            CompanyId = p.CompanyId,
            Name = p.Name,
            Email = p.Email,
            IsCustomer = p.IsCustomer,
            IsVendor = p.IsVendor,
            ReceivablesAccountId = p.ReceivablesAccountId,
            PayablesAccountId = p.PayablesAccountId
        };
        isEditing = true;
        showForm = true;
    }

    private async Task SavePartner()
    {
        currentPartner.CompanyId = selectedCompanyId; // Ensure context
        var err = await MasterService.SavePartnerAsync(currentPartner);

        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
            return;
        }

        showForm = false;
        await LoadData();
    }
}