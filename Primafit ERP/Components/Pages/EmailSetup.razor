@page "/Setup/email-setup"

@using Primafit_ERP.Components.Models
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Primafit_ERP.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-3xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 mt-6">

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Email Configuration Settings</h1>
            <p class="text-sm text-slate-500 mt-1">Configure automated communication parameters for sales and invoicing workflows.</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="bg-white rounded-2xl border border-slate-200 p-12 text-center text-slate-400 animate-pulse">
            Loading email configurations...
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm divide-y divide-slate-100 overflow-hidden">

            <!-- Toggle Rule Section -->
            <div class="p-6 flex items-start justify-between gap-6 hover:bg-slate-50/50 transition-colors">
                <div class="space-y-1">
                    <span class="text-sm font-bold text-slate-900 block">Prompt Email Modal on Post</span>
                    <p class="text-xs text-slate-500 max-w-xl leading-relaxed">
                        When enabled, the application automatically displays an interactive composition window upon posting an invoice, allowing confirmation or text edits before dispatching a PDF copy directly to the customer. Turn off to skip dispatch actions seamlessly without confirmation forms.
                    </p>
                </div>

                <!-- Toggle Switch Widget -->
                <button type="button" @onclick="TogglePopupPreference"
                        class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out outline-none @(settings.EnableInvoiceEmailPopup ? "bg-indigo-600" : "bg-slate-200")">
                    <span class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out @(settings.EnableInvoiceEmailPopup ? "translate-x-5" : "translate-x-0")"></span>
                </button>
            </div>

            <!-- Status Indicator Indicator Footer Bar -->
            <div class="px-6 py-4 bg-slate-50 flex justify-between items-center text-xs font-medium">
                <span class="text-slate-500">Configuration status profile:</span>
                <span class="font-bold uppercase tracking-wider @(settings.EnableInvoiceEmailPopup ? "text-slate-600" : "text-slate-600")">
                    @(settings.EnableInvoiceEmailPopup ? "Email Pop up" : "No Email to be sent")
                </span>
            </div>

        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private Guid companyId;
    private CompanyEmailSetting settings = new();

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("GL_PAGE")) // Relying on core General Ledger config access clearance rules
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            companyId = user.CompanyDetailsId.Value;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var record = await ctx.CompanyEmailSettings.FirstOrDefaultAsync(s => s.CompanyId == companyId);

            if (record != null)
            {
                settings = record;
            }
            else
            {
                settings = new CompanyEmailSetting { CompanyId = companyId, EnableInvoiceEmailPopup = true };
                ctx.CompanyEmailSettings.Add(settings);
                await ctx.SaveChangesAsync();
            }
        }
        isLoading = false;
    }

    private async Task TogglePopupPreference()
    {
        settings.EnableInvoiceEmailPopup = !settings.EnableInvoiceEmailPopup;

        using var ctx = await DbFactory.CreateDbContextAsync();
        ctx.CompanyEmailSettings.Update(settings);
        await ctx.SaveChangesAsync();

        StateHasChanged();
    }
}