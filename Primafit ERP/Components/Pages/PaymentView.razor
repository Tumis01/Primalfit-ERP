                        <select value="@(payment.CustomTransactionTypeId?.ToString() ?? "")" @onchange="OnCustomTemplateSelected"
                                class="input-class font-bold text-xs bg-white flex-1">
                            <option value="">-- Standard Customer Receipt Route (Default) --</option>
                            @foreach (var custom in customTemplates)
                            {
