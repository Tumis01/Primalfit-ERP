@code {
    [SupplyParameterFromQuery]
    public Guid? invoiceId { get; set; }

    private int activeTab = 0;

    private CustomerPayment payment = new();
    private List<Customer> customers = new();
    private List<Currency> currencies = new();

    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private Guid currentCompanyId;
    private bool isBusy = false;
    private string currencySymbol = "";

    private Guid selectedInvoiceId = Guid.Empty;
    private bool HasInvoiceSelected => selectedInvoiceId != Guid.Empty;
    private InvoiceRow? SelectedInvoice => openInvoices.FirstOrDefault(i => i.InvoiceId == selectedInvoiceId);

    // Email State
    private bool showEmailPopup = false;
    private bool isSendingEmail = false;
    private string emailCustomerName = "";
    private string emailCustomerAddress = "";
    private string emailSubject = "";
    private string customEmailMessage = "";
    private Guid emailTargetInvoiceId = Guid.Empty;

    private int pageSize = 15;
    private int currentPage = 1;
    private string currentUserId = "";
    private string _statusFilter = "All";
    private string statusFilter
    {
        get => _statusFilter;
        set { _statusFilter = value; currentPage = 1; }
    }

    public class InvoiceRow
    {
        public Guid InvoiceId { get; set; }
        public string OrderNumber { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal OriginalTotal { get; set; }
        public decimal BalanceDue { get; set; }
        public decimal OriginalRate { get; set; }
        public Guid CurrencyId { get; set; }
        public List<SalesOrderLine> Lines { get; set; } = new();

        public decimal SubTotal { get; set; }
        public decimal DiscountValue { get; set; }
        public decimal TaxAmount { get; set; }
        public string TaxDescription { get; set; } = "Tax";
        public decimal CreditNoteTotal { get; set; }
    }

    public class InvoiceStatusRow
    {
        public Guid InvoiceId { get; set; }
        public string OrderNumber { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public DateTime Date { get; set; }
        public decimal GrandTotal { get; set; }
        public decimal AmountPaid { get; set; }
        public decimal BalanceDue { get; set; }
        public string Status { get; set; } = "";
        public string CurrencyCode { get; set; } = "";
    }

    private List<InvoiceRow> openInvoices = new();
    private List<InvoiceStatusRow> invoiceStatuses = new();

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("AR_PAYMENT_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentUserId = user.Id;
            currentCompanyId = user.CompanyDetailsId.Value;

            customers = await MasterService.GetCustomersAsync(currentCompanyId);
            currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);

            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

            bankAccounts = allAccounts.Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null &&
                       type.Description.Trim().Equals("Cash and Cash Equivalents", StringComparison.OrdinalIgnoreCase) &&
                       type.IsBalanceSheet == true &&
                       type.IsDebit == true;
            }).OrderBy(x => x.AccountCode).ToList();

            await LoadInvoiceStatuses();
            await CreateNewAsync();

            if (invoiceId.HasValue && invoiceId.Value != Guid.Empty)
            {
                activeTab = 1;
                using var ctx = await DbFactory.CreateDbContextAsync();
                var targetInvoice = await ctx.SalesOrders.FirstOrDefaultAsync(o => o.Id == invoiceId.Value);
                if (targetInvoice != null)
                {
                    await OnCustomerChanged(new ChangeEventArgs { Value = targetInvoice.CustomerId.ToString() });
                    OnInvoiceChanged(new ChangeEventArgs { Value = invoiceId.Value.ToString() });
                }
            }
        }
    }
    private async Task CreateNewAsync()
    {
        payment = new CustomerPayment
        {
            CompanyId = currentCompanyId,
            Date = DateTime.Today,
            ExchangeRate = 1,
            DepositToGlAccountId = Guid.Empty // Explicitly empty
        };
        openInvoices.Clear();
        selectedInvoiceId = Guid.Empty;

        // Only preset if explicitly mapped in GL Mapping router
        Guid defaultBank = await MappingService.GetMappedAccountAsync(
            currentCompanyId,
            SystemTransactionType.CustomerPayment,
            isDebit: true,
            defaultAccountId: Guid.Empty);

        if (defaultBank != Guid.Empty)
        {
            payment.DepositToGlAccountId = defaultBank;
        }

        if (currencies.Any())
        {
            var def = currencies.First();
            payment.CurrencyId = def.Id;
            currencySymbol = def.CurrencyCode;
        }
    }

    private async Task LoadInvoiceStatuses()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        var taxes = await ctx.Taxes.Where(t => t.CompanyId == currentCompanyId).ToDictionaryAsync(t => t.Id, t => t.Per);

        var invoices = await ctx.SalesOrders
            .Include(o => o.Customer)
            .Include(o => o.Currency)
            .Include(o => o.Lines)
            .Where(o => o.CompanyId == currentCompanyId &&
                        o.OrderNumber.StartsWith("INV") &&
                        (o.Status == OrderStatus.Invoiced || o.Status == OrderStatus.PartiallyInvoiced || o.IsDirectInvoice == true))
            .OrderByDescending(o => o.Date)
            .ToListAsync();

        var invoiceIds = invoices.Select(i => i.Id).ToList();

        var arPayments = await (from pa in ctx.PaymentApplications
                                join p in ctx.CustomerPayments on pa.CustomerPaymentId equals p.Id
                                where invoiceIds.Contains(pa.InvoiceId) && p.Status == PaymentStatus.Posted
                                group pa by pa.InvoiceId into g
                                select new { InvoiceId = g.Key, Paid = g.Sum(x => x.AppliedAmount + x.CashDiscountTaken) })
                                .ToDictionaryAsync(x => x.InvoiceId, x => x.Paid);

        var creditNotesMap = await ctx.CreditNotes
            .Where(cn => invoiceIds.Contains(cn.SalesOrderId) && cn.Status == CreditNoteStatus.Posted)
            .GroupBy(cn => cn.SalesOrderId)
            .Select(g => new { InvoiceId = g.Key, TotalCredited = g.Sum(x => x.TotalAmount) })
            .ToDictionaryAsync(x => x.InvoiceId, x => x.TotalCredited);

        invoiceStatuses.Clear();
        foreach (var inv in invoices)
        {
            decimal subTotal = inv.Lines.Sum(l => l.Quantity * l.UnitPrice);
            decimal discount = inv.DiscountPercentage > 0 ? subTotal * (inv.DiscountPercentage / 100) : inv.DiscountAmount;
            decimal net = subTotal - discount;
            decimal taxPer = inv.TaxId.HasValue && taxes.ContainsKey(inv.TaxId.Value) ? taxes[inv.TaxId.Value] : 0;
            decimal grandTotal = net + (net * (taxPer / 100));

            decimal paid = arPayments.GetValueOrDefault(inv.Id, 0);
            decimal credited = creditNotesMap.GetValueOrDefault(inv.Id, 0);

            decimal balance = grandTotal - paid - credited;

            string status = "Unpaid";
            if (balance <= 0.01m) status = "Paid in Full";
            else if (paid > 0) status = "Partially Paid";

            invoiceStatuses.Add(new InvoiceStatusRow
            {
                InvoiceId = inv.Id,
                OrderNumber = inv.OrderNumber,
                CustomerName = inv.Customer?.Name ?? "Unknown",
                Date = inv.Date.ToDateTime(TimeOnly.MinValue),
                GrandTotal = grandTotal,
                AmountPaid = paid,
                BalanceDue = balance,
                Status = status,
                CurrencyCode = inv.Currency?.CurrencyCode ?? ""
            });
        }
    }

    private async Task SelectAndLoadInvoice(InvoiceStatusRow statusRow)
    {
        var targetCustomer = customers.FirstOrDefault(c => c.Name == statusRow.CustomerName);
        if (targetCustomer == null) return;

        isBusy = true; StateHasChanged();

        payment.CustomerId = targetCustomer.Id;

        // Resolve AR Account override from GL Router first, fallback to Customer master
        Guid defaultAr = targetCustomer.ReceivablesAccountId ?? Guid.Empty;
        payment.CreditGlAccountId = await MappingService.GetMappedAccountAsync(
            currentCompanyId,
            SystemTransactionType.CustomerPayment,
            isDebit: false,
            defaultAccountId: defaultAr);

        await LoadCustomerInvoices(targetCustomer.Id);

        selectedInvoiceId = statusRow.InvoiceId;

        var loadedInvoice = openInvoices.FirstOrDefault(i => i.InvoiceId == selectedInvoiceId);
        if (loadedInvoice != null)
        {
            payment.AmountReceived = loadedInvoice.BalanceDue;
            payment.ExchangeRate = loadedInvoice.OriginalRate;
            payment.CurrencyId = loadedInvoice.CurrencyId;
            payment.Reference = loadedInvoice.OrderNumber;

            var currencyObj = currencies.FirstOrDefault(x => x.Id == payment.CurrencyId);
            currencySymbol = currencyObj?.CurrencyCode ?? "";
        }

        activeTab = 1;
        isBusy = false;
        StateHasChanged();
    }

    private async Task OnCustomerChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var custId) && custId != Guid.Empty)
        {
            payment.CustomerId = custId;

            var customer = customers.FirstOrDefault(c => c.Id == custId);
            Guid defaultAr = customer?.ReceivablesAccountId ?? Guid.Empty;

            // Resolve AR Account override from GL Router first, fallback to Customer master
            payment.CreditGlAccountId = await MappingService.GetMappedAccountAsync(
                currentCompanyId,
                SystemTransactionType.CustomerPayment,
                isDebit: false,
                defaultAccountId: defaultAr);

            await LoadCustomerInvoices(custId);
            selectedInvoiceId = Guid.Empty;
            payment.AmountReceived = 0;
            payment.Reference = "";
        }
        else
        {
            payment.CustomerId = Guid.Empty;
            payment.CreditGlAccountId = Guid.Empty;
            openInvoices.Clear();
            selectedInvoiceId = Guid.Empty;
        }
    }

    private async Task LoadCustomerInvoices(Guid customerId)
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        var invoices = await ctx.SalesOrders
            .Include(o => o.Lines).ThenInclude(l => l.Item)
            .Where(o => o.CompanyId == currentCompanyId &&
                        o.CustomerId == customerId &&
                        o.OrderNumber.StartsWith("INV") &&
                        (o.Status == OrderStatus.Invoiced || o.Status == OrderStatus.PartiallyInvoiced || o.IsDirectInvoice == true))
            .ToListAsync();

        var invoiceIds = invoices.Select(i => i.Id).ToList();

        var creditNotesMap = await ctx.CreditNotes
            .Where(cn => invoiceIds.Contains(cn.SalesOrderId) && cn.Status == CreditNoteStatus.Posted)
            .GroupBy(cn => cn.SalesOrderId)
            .Select(g => new { InvoiceId = g.Key, TotalCredited = g.Sum(x => x.TotalAmount) })
            .ToDictionaryAsync(x => x.InvoiceId, x => x.TotalCredited);

        var arPaymentsMap = await (from pa in ctx.PaymentApplications
                                   join p in ctx.CustomerPayments on pa.CustomerPaymentId equals p.Id
                                   where invoiceIds.Contains(pa.InvoiceId) && p.Status == PaymentStatus.Posted
                                   group pa by pa.InvoiceId into g
                                   select new { InvoiceId = g.Key, Paid = g.Sum(x => x.AppliedAmount + x.CashDiscountTaken) })
                                   .ToDictionaryAsync(x => x.InvoiceId, x => x.Paid);

        openInvoices.Clear();
        foreach (var inv in invoices)
        {
            decimal subTotal = inv.Lines.Sum(l => l.Quantity * l.UnitPrice);

            decimal discountValue = inv.DiscountAmount;
            if (inv.DiscountPercentage > 0)
            {
                discountValue = subTotal * (inv.DiscountPercentage / 100);
            }
            decimal discountedSubTotal = subTotal - discountValue;

            decimal taxAmount = 0;
            string taxDesc = "Tax";
            if (inv.TaxId.HasValue)
            {
                var tax = await ctx.Taxes.FindAsync(inv.TaxId.Value);
                if (tax != null)
                {
                    taxAmount = discountedSubTotal * (tax.Per / 100);
                    taxDesc = $"{tax.TaxName} ({tax.Per}%)";
                }
            }

            decimal grandTotal = discountedSubTotal + taxAmount;

            decimal paidAmount = arPaymentsMap.GetValueOrDefault(inv.Id, 0);
            decimal creditedAmount = creditNotesMap.GetValueOrDefault(inv.Id, 0);

            decimal balanceDue = grandTotal - paidAmount - creditedAmount;

            if (balanceDue > 0.01m)
            {
                openInvoices.Add(new InvoiceRow
                {
                    InvoiceId = inv.Id,
                    OrderNumber = inv.OrderNumber,
                    Date = inv.Date.ToDateTime(TimeOnly.MinValue),
                    OriginalTotal = grandTotal,
                    BalanceDue = balanceDue,
                    OriginalRate = inv.ExchangeRate > 0 ? inv.ExchangeRate : 1,
                    CurrencyId = inv.CurrencyId,
                    Lines = inv.Lines.ToList(),
                    SubTotal = subTotal,
                    DiscountValue = discountValue,
                    TaxAmount = taxAmount,
                    TaxDescription = taxDesc,
                    CreditNoteTotal = creditedAmount
                });
            }
        }

        openInvoices = openInvoices.OrderBy(i => i.Date).ToList();
    }

    private void OnInvoiceChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var invId) && invId != Guid.Empty)
        {
            selectedInvoiceId = invId;
            var inv = SelectedInvoice;

            if (inv != null)
            {
                payment.AmountReceived = inv.BalanceDue;
                payment.ExchangeRate = inv.OriginalRate;
                payment.CurrencyId = inv.CurrencyId;
                payment.Reference = inv.OrderNumber;

                var c = currencies.FirstOrDefault(x => x.Id == payment.CurrencyId);
                currencySymbol = c?.CurrencyCode ?? "";
            }
        }
        else
        {
            selectedInvoiceId = Guid.Empty;
            payment.AmountReceived = 0;
            payment.Reference = "";
        }
    }

    private async Task PromptEmailPopup(Customer customer, Guid invoiceId, string invoiceNum, decimal amountPaid, decimal remainingBalance, string currSymbol)
    {
        if (customer != null && !string.IsNullOrWhiteSpace(customer.Email))
        {
            emailTargetInvoiceId = invoiceId;

            emailCustomerName = customer.Name;
            emailCustomerAddress = customer.Email;
            emailSubject = $"Payment Receipt - Invoice {invoiceNum}";

            customEmailMessage = $"Dear {customer.Name},\n\nThank you for your payment of {currSymbol}{amountPaid:N2} towards invoice {invoiceNum} today.\n\nYour remaining balance on this invoice is {currSymbol}{remainingBalance:N2}.\n\nPlease find your official receipt attached.\n\nWe appreciate your continued business!\n\nBest Regards,\nAccounts Receivable Team";

            showEmailPopup = true;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "✅ Payment Posted Successfully!\n(No email sent: Customer missing email address).");
            activeTab = 0;
        }
    }

    private async Task PostPayment()
    {
        if (!HasInvoiceSelected) { await JS.InvokeVoidAsync("alert", "Please select a Sales Order Invoice."); return; }
        if (payment.AmountReceived <= 0) { await JS.InvokeVoidAsync("alert", "Amount received must be greater than zero."); return; }
        if (payment.DepositToGlAccountId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a Deposit (Bank) account."); return; }
        if (payment.CreditGlAccountId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a Crediting (A/R) account."); return; }
        if (SelectedInvoice != null && payment.AmountReceived > SelectedInvoice.BalanceDue)
        {
            await JS.InvokeVoidAsync("alert", $"Validation Error:\n\nPayment amount ({payment.AmountReceived:N2}) cannot exceed the remaining adjusted balance due ({SelectedInvoice.BalanceDue:N2}) after credit note deductions.");
            return;
        }

        payment.Applications.Clear();
        if (SelectedInvoice != null)
        {
            payment.Applications.Add(new PaymentApplication
            {
                InvoiceId = SelectedInvoice.InvoiceId,
                AppliedAmount = payment.AmountReceived,
                CashDiscountTaken = 0
            });
        }

        isBusy = true;
        try
        {
            var saveErr = await PayService.SavePaymentAsync(payment);
            if (!string.IsNullOrEmpty(saveErr)) throw new Exception(saveErr);

            var postErr = await PayService.PostPaymentAsync(payment.Id, currentUserId);

            if (string.IsNullOrEmpty(postErr))
            {
                var cust = customers.FirstOrDefault(c => c.Id == payment.CustomerId);
                Guid targetInvId = SelectedInvoice!.InvoiceId;
                string invNum = SelectedInvoice!.OrderNumber;
                decimal amt = payment.AmountReceived;
                decimal remBal = SelectedInvoice.BalanceDue - payment.AmountReceived;
                string cur = currencySymbol;

                await LoadCustomerInvoices(payment.CustomerId);
                await LoadInvoiceStatuses();

                selectedInvoiceId = Guid.Empty;
                payment.AmountReceived = 0;
                payment.Reference = "";

                using var ctx = await DbFactory.CreateDbContextAsync();
                var emailConfig = await ctx.CompanyEmailSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == currentCompanyId);
                bool showPopupToggle = emailConfig?.EnableInvoiceEmailPopup ?? true;

                if (!showPopupToggle)
                {
                    await JS.InvokeVoidAsync("alert", "✅ Payment Posted Successfully!");
                    showEmailPopup = false;
                    activeTab = 0;
                    StateHasChanged();
                    return;
                }

                await PromptEmailPopup(cust, targetInvId, invNum, amt, remBal, cur);
            }
            else
            {
                await JS.InvokeVoidAsync("alert", postErr);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task PrepareEmailReceipt(Guid invoiceId)
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        var emailConfig = await ctx.CompanyEmailSettings.AsNoTracking().FirstOrDefaultAsync(s => s.CompanyId == currentCompanyId);
        bool showPopupToggle = emailConfig?.EnableInvoiceEmailPopup ?? true;

        if (!showPopupToggle)
        {
            await JS.InvokeVoidAsync("alert", "Manual email composition prompts are currently disabled in ledger communication parameters.");
            return;
        }

        emailTargetInvoiceId = invoiceId;
        var row = invoiceStatuses.FirstOrDefault(i => i.InvoiceId == invoiceId);
        var customer = customers.FirstOrDefault(c => c.Name == row?.CustomerName);

        if (customer != null && !string.IsNullOrWhiteSpace(customer.Email))
        {
            emailCustomerName = customer.Name;
            emailCustomerAddress = customer.Email;
            emailSubject = $"Payment Receipt - {row?.OrderNumber}";
            customEmailMessage = $"Dear {customer.Name},\n\nPlease find attached the payment receipt for {row?.OrderNumber}.\n\nCurrent Balance Due: {row?.CurrencyCode} {row?.BalanceDue:N2}\n\nThank you for your business!\n\nBest Regards,\nAccounts Receivable Team";

            showEmailPopup = true;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "This customer does not have an email address on file.");
        }
    }

    private async Task<(byte[] Bytes, string FileName, string Subject, string CustomerEmail)> GetReceiptDataAsync(Guid invoiceId)
    {
        var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
        var order = await SalesService.GetOrderByIdAsync(invoiceId);

        if (order == null || company == null) return (null, "", "", "");

        var currency = currencies.FirstOrDefault(c => c.Id == order.CurrencyId);
        string curSymbol = currency?.CurrencyCode ?? "";

        byte[] pdfBytes = ReportExportService.GenerateInvoicePdf(order, company, curSymbol);

        string fileName = $"Receipt_{order.OrderNumber}.pdf";
        string subject = $"Payment Receipt - {order.OrderNumber} from {company.CompanyName}";

        return (pdfBytes, fileName, subject, order.Customer?.Email ?? "");
    }

    private async Task DownloadReceipt(Guid invoiceId)
    {
        try
        {
            var data = await GetReceiptDataAsync(invoiceId);
            if (data.Bytes == null)
            {
                await JS.InvokeVoidAsync("alert", "Failed to generate receipt. Missing order or company data.");
                return;
            }

            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(data.Bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", data.FileName, streamRef);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Download Error: {ex.Message}");
        }
    }

    private async Task DispatchEmail()
    {
        isSendingEmail = true;
        try
        {
            var data = await GetReceiptDataAsync(emailTargetInvoiceId);
            if (data.Bytes == null) throw new Exception("Failed to generate PDF attachment.");

            await EmailService.SendEmailAsync(
                emailCustomerAddress,
                emailSubject,
                customEmailMessage.Replace("\n", "<br>"),
                data.Bytes,
                data.FileName
            );

            await JS.InvokeVoidAsync("alert", "Receipt emailed successfully!");
            showEmailPopup = false;
            emailTargetInvoiceId = Guid.Empty;
            activeTab = 0;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Failed to send email: {ex.Message}");
        }
        finally
        {
            isSendingEmail = false;
        }
    }

    private IEnumerable<InvoiceStatusRow> FilteredInvoiceStatuses => invoiceStatuses
        .Where(i => statusFilter == "All" || i.Status == statusFilter);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredInvoiceStatuses.Count() / (double)pageSize));

    private IEnumerable<InvoiceStatusRow> PagedInvoiceStatuses => FilteredInvoiceStatuses
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);
}