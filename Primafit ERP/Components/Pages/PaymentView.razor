                                                         ValueChanged="@((Guid val) => payment.CreditGlAccountId = val)" />
                                </div>
                            </div>
                        </div>

                        <!-- 3. Discount Allowed Account (Debit) -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[30] rounded-b-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Discount Allowed (Cash Disc)</span>
                                <span class="text-[10px] text-indigo-600 font-bold uppercase">Debit Side</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (payment.DiscountGlAccountId.HasValue)
