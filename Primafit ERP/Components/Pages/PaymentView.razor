@page "/ar/payment-entry"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.IO

@inject PaymentService PayService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject CurrencyService CurrService
@inject TransactionMappingService MappingService
@inject IEmailService EmailService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject SalesService SalesService
@inject CompanyApiService CompanyService
@inject ReportExportService ReportExportService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 mb-16">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Accounts Receivable</h1>
            <p class="text-sm text-slate-500">Track invoice statuses and receive incoming payments.</p>
        </div>
        <div class="flex items-center gap-4">
            <div class="flex bg-slate-100 p-1 rounded-xl">
                <button @onclick="() => activeTab = 0" class="px-4 py-2 rounded-lg text-sm font-bold transition-all @(activeTab == 0 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    Invoice Statuses
                </button>
                <button @onclick="() => activeTab = 1" class="px-4 py-2 rounded-lg text-sm font-bold transition-all @(activeTab == 1 ? "bg-white text-slate-900 shadow-sm" : "text-slate-500 hover:text-slate-700")">
                    Receive Payment
                </button>
            </div>
        </div>
    </div>

    @if (currentCompanyId != Guid.Empty)
    {
        @if (activeTab == 0)
        {
            <div class="flex justify-between items-center mb-4 animate-in fade-in slide-in-from-bottom-2">
                <div class="flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 h-[42px]">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Filter Status:</span>
                    <select @bind="statusFilter" class="bg-transparent text-sm font-bold text-slate-700 outline-none cursor-pointer">
                        <option value="All">All Invoices</option>
                        <option value="Unpaid">Unpaid</option>
                        <option value="Partially Paid">Partially Paid</option>
                        <option value="Paid in Full">Paid in Full</option>
                    </select>
                </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm animate-in fade-in slide-in-from-bottom-2">
                <div class="overflow-x-auto w-full">
                    <table class="w-full text-left text-sm text-slate-900 min-w-[900px]">
                        <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                            <tr>
                                <th class="p-4">Invoice #</th>
                                <th class="p-4">Date</th>
                                <th class="p-4">Customer</th>
                                <th class="p-4 text-right">Invoice Total</th>
                                <th class="p-4 text-right">Amount Paid</th>
                                <th class="p-4 text-right">Balance Due</th>
                                <th class="p-4 text-center">Status</th>
                                <th class="p-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @foreach (var inv in PagedInvoiceStatuses)
                            {
                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="p-4 font-mono font-bold text-indigo-700">@inv.OrderNumber</td>
                                    <td class="p-4 font-mono text-slate-600 text-xs">@inv.Date.ToString("dd MMM, yyyy")</td>
                                    <td class="p-4 font-medium">@inv.CustomerName</td>
                                    <td class="p-4 text-right font-mono font-bold text-slate-800">@inv.CurrencyCode @inv.GrandTotal.ToString("N2")</td>
                                    <td class="p-4 text-right font-mono font-bold text-emerald-600">@inv.CurrencyCode @inv.AmountPaid.ToString("N2")</td>
                                    <td class="p-4 text-right font-mono font-bold text-rose-600">@inv.CurrencyCode @inv.BalanceDue.ToString("N2")</td>
                                    <td class="p-4 text-center">
                                        @if (inv.Status == "Paid in Full")
                                        {
                                            <span class="inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Paid in Full</span>
                                        }
                                        else if (inv.Status == "Partially Paid")
                                        {
                                            <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">Partially Paid</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full border border-rose-200 bg-rose-50 px-2.5 py-1 text-[10px] font-bold text-rose-700 uppercase tracking-wider">Unpaid</span>
                                        }
                                    </td>
                                    <td class="p-4 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            @if (inv.Status != "Paid in Full")
                                            {
                                                <button @onclick="() => SelectAndLoadInvoice(inv)" class="p-1.5 text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-all" title="Load Invoice into Payment Form">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
                                                    </svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <div class="w-7 h-7"></div>
                                            }

                                            <button @onclick="() => DownloadReceipt(inv.InvoiceId)" class="p-1.5 text-slate-400 hover:text-indigo-600 transition-colors" title="Download Receipt PDF">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                                            </button>
                                            <button @onclick="() => PrepareEmailReceipt(inv.InvoiceId)" class="p-1.5 text-slate-400 hover:text-emerald-600 transition-colors" title="Email Receipt">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!PagedInvoiceStatuses.Any())
                            {
                                <tr><td colspan="8" class="p-12 text-center text-slate-400">No invoices found matching the selected filter.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilteredInvoiceStatuses.Any())
                {
                    <div class="flex flex-col sm:flex-row items-center justify-between px-6 py-4 border-t border-slate-200 bg-slate-50">
                        <div class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 sm:mb-0">
                            Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, FilteredInvoiceStatuses.Count())) of @FilteredInvoiceStatuses.Count() records
                        </div>
                        <div class="flex items-center gap-2">
                            <button @onclick="() => currentPage--" disabled="@(currentPage == 1)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">
                                Previous
                            </button>

                            <span class="px-3 py-1.5 text-xs font-bold text-slate-700 bg-white border border-slate-200 rounded-lg shadow-sm">
                                Page @currentPage of @TotalPages
                            </span>

                            <button @onclick="() => currentPage++" disabled="@(currentPage >= TotalPages)" class="px-3 py-1.5 text-xs font-bold text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">
                                Next
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == 1)
        {
            <div class="flex justify-end mb-4">
                <PermissionGate Key="AR_PAYMENT_CREATE">
                    <Authorized>
                        <button @onclick="PostPayment" disabled="@isBusy" class="px-6 py-2.5 bg-emerald-600 text-white font-bold rounded-xl shadow-md hover:bg-emerald-700 disabled:opacity-50 flex items-center gap-2 transition-all active:scale-95">
                            @if (isBusy)
                            {
                                <span class="animate-spin">↻</span> <span>Processing...</span>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                <span>Post Payment</span>
                            }
                        </button>
                    </Authorized>
                </PermissionGate>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 animate-in fade-in slide-in-from-bottom-2">
                <div class="lg:col-span-4 space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                        <h3 class="font-bold border-b border-slate-100 pb-2 text-slate-800 uppercase text-xs tracking-wider">Transaction Details</h3>

                        <div>
                            <label class="label">Date Received</label>
                            <input type="date" @bind="payment.Date" class="input-class" />
                        </div>

                        <div>
                            <label class="label">Customer</label>
                            <select value="@payment.CustomerId" @onchange="OnCustomerChanged" class="input-class font-bold text-slate-900 border-indigo-200 bg-indigo-50/30">
                                <option value="@Guid.Empty">-- Select Customer --</option>
                                @foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="label text-indigo-600">Sales Order Invoice Number</label>
                            <select value="@selectedInvoiceId" @onchange="OnInvoiceChanged" class="input-class border-indigo-200 bg-indigo-50/30 font-bold" disabled="@(payment.CustomerId == Guid.Empty)">
                                <option value="@Guid.Empty">-- Select Order --</option>
                                @foreach (var inv in openInvoices)
                                {
                                    <option value="@inv.InvoiceId">@inv.OrderNumber (Due: @inv.BalanceDue.ToString("N2"))</option>
                                }
                            </select>
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="label">Currency</label>
                                <select value="@payment.CurrencyId" class="input-class @(HasInvoiceSelected ? "bg-slate-50 text-slate-500 cursor-not-allowed" : "")" disabled="@HasInvoiceSelected">
                                    <option value="@Guid.Empty">N/A</option>
                                    @foreach (var c in currencies)
                                    {
                                        <option value="@c.Id">@c.CurrencyCode</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="label">Exchange Rate</label>
                                <input type="number" step="0.0001" @bind="payment.ExchangeRate" class="input-class font-mono text-right @(HasInvoiceSelected ? "bg-slate-50 text-slate-500 cursor-not-allowed" : "")" readonly="@HasInvoiceSelected" />
                            </div>
                        </div>

                        <div class="pt-2">
                            <label class="label text-emerald-700">Amount Received (@currencySymbol)</label>
                            <div class="relative">
                                <input type="number" step="0.01" @bind="payment.AmountReceived" class="input-class pl-8 font-bold text-xl text-emerald-700 border-emerald-200 bg-emerald-50 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100" placeholder="0.00" />
                            </div>

                            @if (HasInvoiceSelected)
                            {
                                <div class="mt-2 flex justify-between items-center bg-slate-50 p-2 rounded text-xs border border-slate-100">
                                    <span class="font-bold text-slate-400 uppercase">Ledger Value (Base)</span>
                                    <div class="font-mono font-bold text-emerald-600">
                                        @((payment.AmountReceived * payment.ExchangeRate).ToString("N2"))
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- GL MAPPING OVERRIDES -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                        <h3 class="font-bold border-b border-slate-100 pb-2 text-slate-800 uppercase text-xs tracking-wider flex items-center justify-between">
                            GL Mapping Configuration
                            <span class="text-[10px] text-slate-400 font-normal normal-case">Overrides Mapping Router</span>
                        </h3>

                        <div class="space-y-4">
                            <div>
                                <SearchableGlAccount Label="Deposit To (Bank Account - Debit)"
                                                     Placeholder="Search Bank Asset..."
                                                     Accounts="@bankAccounts"
                                                     @bind-Value="payment.DepositToGlAccountId"
                                                     IsInvalid="@(payment.DepositToGlAccountId == Guid.Empty)" />
                                <p class="text-[10px] text-slate-400 mt-1">Preset from GL Mapping router (Deposit Bank Asset).</p>
                            </div>

                            <div>
                                <SearchableGlAccount Label="Crediting Account (A/R Control - Credit)"
                                                     Placeholder="Search A/R Control Account..."
                                                     Accounts="@allAccounts"
                                                     @bind-Value="payment.CreditGlAccountId"
                                                     IsInvalid="@(payment.CreditGlAccountId == Guid.Empty)" />
                                <p class="text-[10px] text-slate-400 mt-1">Preset from GL Mapping router / Customer master.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-8">
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-visible flex flex-col h-full min-h-[600px]">

                        @if (SelectedInvoice != null)
                        {
                            <div class="p-6 border-b border-slate-100 bg-slate-50/50 rounded-t-2xl">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                                    <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                                        Invoice Tracking: <span class="text-indigo-600 font-mono ml-1 text-base">@SelectedInvoice.OrderNumber</span>
                                    </h3>
                                    <span class="text-xs font-semibold text-slate-400 font-mono">Date Issued: @SelectedInvoice.Date.ToString("yyyy-MM-dd")</span>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 animate-in slide-in-from-bottom-2 duration-300">

                                    <div class="bg-white border border-slate-200 p-4 rounded-xl text-center shadow-sm flex flex-col justify-center min-h-[90px]">
                                        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1 tracking-wide">Invoice Total (@currencySymbol)</div>
                                        <div class="text-xl font-mono font-black text-slate-900">@SelectedInvoice.OriginalTotal.ToString("N2")</div>
                                    </div>

                                    @if (SelectedInvoice.CreditNoteTotal > 0)
                                    {
                                        <div class="bg-rose-50 border border-rose-200 p-4 rounded-xl text-center shadow-sm flex flex-col justify-center min-h-[90px] animate-in zoom-in-95 duration-200">
                                            <div class="text-[10px] text-rose-700 uppercase font-bold mb-1 tracking-wide">Credit Adjustments</div>
                                            <div class="text-xl font-mono font-black text-rose-700">@SelectedInvoice.CreditNoteTotal.ToString("N2")</div>
                                        </div>
                                    }

                                    <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl text-center shadow-sm flex flex-col justify-center min-h-[90px]">
                                        <div class="text-[10px] text-emerald-700 uppercase font-bold mb-1 tracking-wide">Prior Cash Paid</div>
                                        <div class="text-xl font-mono font-black text-emerald-700">
                                            @((SelectedInvoice.OriginalTotal - SelectedInvoice.BalanceDue - SelectedInvoice.CreditNoteTotal).ToString("N2"))
                                        </div>
                                    </div>

                                    <div class="bg-indigo-50 border border-indigo-200 p-4 rounded-xl text-center shadow-sm flex flex-col justify-center min-h-[90px] @(SelectedInvoice.CreditNoteTotal > 0 ? "" : "sm:col-span-2")">
                                        <div class="text-[10px] text-indigo-700 uppercase font-bold mb-1 tracking-wide">Net Balance Due</div>
                                        <div class="text-xl font-mono font-black text-indigo-700">@SelectedInvoice.BalanceDue.ToString("N2")</div>
                                    </div>

                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-5 border-b border-slate-100 bg-slate-50/50 flex justify-between items-center">
                                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Order Items</h3>
                            </div>
                        }

                        <div class="overflow-x-auto flex-1 p-6">
                            @if (SelectedInvoice != null)
                            {
                                <table class="w-full text-left text-sm border border-slate-200 rounded-lg overflow-hidden">
                                    <thead class="text-[10px] uppercase font-extrabold text-slate-500 bg-slate-50 border-b border-slate-200 tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3 w-[45%]">Item</th>
                                            <th class="px-4 py-3 text-center">Qty</th>
                                            <th class="px-4 py-3 text-right">Unit Price</th>
                                            <th class="px-4 py-3 text-right pr-6">Total (@currencySymbol)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        @foreach (var line in SelectedInvoice.Lines)
                                        {
                                            <tr class="hover:bg-slate-50 transition-colors">
                                                <td class="px-4 py-3 font-medium text-slate-800">@(line.Item?.Name ?? "Unknown Item")</td>
                                                <td class="px-4 py-3 text-center font-mono font-bold text-slate-600">@line.Quantity</td>
                                                <td class="px-4 py-3 text-right font-mono text-slate-500">@line.UnitPrice.ToString("N2")</td>
                                                <td class="px-4 py-3 pr-6 text-right font-mono font-bold text-slate-700">@((line.Quantity * line.UnitPrice).ToString("N2"))</td>
                                            </tr>
                                        }
                                    </tbody>

                                    <tfoot class="bg-slate-50 border-t-2 border-slate-200 text-right text-slate-600">
                                        <tr>
                                            <td colspan="3" class="px-4 py-2 font-bold text-xs uppercase tracking-wider">Subtotal:</td>
                                            <td class="px-4 py-2 pr-6 font-mono font-bold text-slate-700">@SelectedInvoice.SubTotal.ToString("N2")</td>
                                        </tr>
                                        @if (SelectedInvoice.DiscountValue > 0)
                                        {
                                            <tr class="text-rose-600">
                                                <td colspan="3" class="px-4 py-2 font-bold text-xs uppercase tracking-wider">Discount:</td>
                                                <td class="px-4 py-2 pr-6 font-mono font-bold">- @SelectedInvoice.DiscountValue.ToString("N2")</td>
                                            </tr>
                                        }
                                        @if (SelectedInvoice.TaxAmount > 0)
                                        {
                                            <tr>
                                                <td colspan="3" class="px-4 py-2 font-bold text-xs uppercase tracking-wider">@SelectedInvoice.TaxDescription:</td>
                                                <td class="px-4 py-2 pr-6 font-mono font-bold">+ @SelectedInvoice.TaxAmount.ToString("N2")</td>
                                            </tr>
                                        }
                                        <tr class="text-slate-900 border-t border-slate-200 bg-slate-100/50">
                                            <td colspan="3" class="px-4 py-3 font-black uppercase text-xs tracking-wider">Invoice Grand Total:</td>
                                            <td class="px-4 py-3 pr-6 font-mono font-black text-lg text-indigo-700">@currencySymbol@SelectedInvoice.OriginalTotal.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            }
                            else
                            {
                                <div class="p-16 text-center text-slate-400 border-2 border-dashed border-slate-200 rounded-2xl m-4">
                                    <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                                    Please select a Customer and an Order to view items.
                                </div>
                            }
                        </div>

                        @if (SelectedInvoice != null)
                        {
                            <div class="border-t border-slate-200 bg-slate-50 p-5 grid grid-cols-12 gap-4 items-center mt-auto rounded-b-2xl">
                                <div class="col-span-8 text-right text-[10px] font-black text-slate-500 uppercase tracking-wider">Payment Currently Applying:</div>
                                <div class="col-span-4 text-right font-mono font-black text-emerald-600 text-2xl">@currencySymbol@payment.AmountReceived.ToString("N2")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (showEmailPopup)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 backdrop-blur-sm animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg overflow-hidden border border-slate-200 animate-in zoom-in-95 duration-200">
            <div class="p-6 border-b border-slate-100 bg-slate-50 flex justify-between items-center">
                <h3 class="font-bold text-slate-800 uppercase tracking-wider text-sm">Send Payment Receipt</h3>
                <button type="button" @onclick="() => showEmailPopup = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 space-y-4">
                <div>
                    <label class="label">To Customer:</label>
                    <input type="text" class="input-class bg-slate-50 cursor-not-allowed font-bold text-slate-600" value="@($"{emailCustomerName} <{emailCustomerAddress}>")" disabled />
                </div>

                <div>
                    <label class="label">Subject:</label>
                    <input type="text" class="input-class font-bold text-slate-800" value="@emailSubject" disabled />
                </div>

                <div>
                    <label class="label"> Content:</label>
                    <textarea @bind="customEmailMessage" class="input-class h-40 resize-none text-sm text-slate-700"></textarea>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
                <button type="button" @onclick="() => { showEmailPopup = false; activeTab = 0; }" class="px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors disabled:opacity-50" disabled="@isSendingEmail">
                    Skip
                </button>
                <button type="button" @onclick="DispatchEmail" class="px-6 py-2.5 text-sm font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50" disabled="@isSendingEmail">
                    @if (isSendingEmail)
                    {
                        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Receipt</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

