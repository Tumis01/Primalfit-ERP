@page "/roles"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject RoleApiService RoleService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Role Management</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Define custom job titles and select their accessible modules.</p>
        </div>

        <div class="flex gap-2">
            @if (!showForm)
            {
                <button @onclick="CreateNew" disabled="@(!HasCompany)"
                        class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                    <span>+ New Custom Role</span>
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading roles...
        </div>
    }
    else if (showForm && HasCompany)
    {
        <div class="relative overflow-hidden rounded-2xl bg-white p-8 shadow-xl ring-1 ring-slate-200 animate-in slide-in-from-top-4 duration-300">
            <div class="absolute top-0 left-0 w-full h-1 bg-slate-900"></div>

            <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
                <h3 class="text-lg font-bold text-slate-900">@(string.IsNullOrEmpty(currentRole.Id) ? "Create New Role" : "Edit Role")</h3>
            </div>

            <EditForm Model="currentRole" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <div class="space-y-1.5">
                        <label class="label">Role Title</label>
                        <InputText @bind-Value="currentRole.DisplayName" class="@InputClass" placeholder="e.g. Warehouse Manager" />
                    </div>

                    <div class="space-y-1.5">
                        <label class="label">Description</label>
                        <InputText @bind-Value="currentRole.Description" class="@InputClass" placeholder="What can this role do?" />
                    </div>
                </div>

                <div class="mb-4">
                    <h4 class="text-sm font-bold text-slate-900 mb-3 border-b pb-2">Module Access (Page-Level Permissions)</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        @foreach (var perm in availablePagePermissions.OrderBy(p => p.Module))
                        {
                            <label class="flex items-start gap-3 p-3 rounded-lg border border-slate-200 hover:bg-slate-50 cursor-pointer transition-colors">
                                <input type="checkbox"
                                       class="mt-0.5 rounded text-indigo-600 focus:ring-indigo-500"
                                       checked="@selectedPermissionIds.Contains(perm.Id)"
                                       @onchange="@(e => TogglePermission(perm.Id, e.Value))" />
                                <div>
                                    <div class="text-xs font-bold text-slate-900">@perm.DisplayName</div>
                                    <div class="text-[10px] text-slate-500">@perm.Module Module</div>
                                </div>
                            </label>
                        }
                    </div>
                </div>

                <div class="mt-8 flex justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" @onclick="CancelForm" class="rounded-xl px-5 py-2.5 text-sm font-bold text-slate-600 hover:bg-slate-100 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="rounded-xl bg-slate-900 px-6 py-2.5 text-sm font-bold text-white shadow-md hover:bg-slate-800 transition-all active:scale-95">
                        Save Role & Permissions
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-sm text-slate-900">
            <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200 tracking-wider">
                <tr>
                    <th class="px-6 py-4">Role Name</th>
                    <th class="px-6 py-4">Description</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (roles.Any())
                {
                    @foreach (var role in roles)
                    {
                        <tr class="group hover:bg-slate-50 transition-colors cursor-pointer" @onclick="() => ToggleViewPermissions(role.Id)">
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-bold text-slate-700">
                                    @role.DisplayName
                                </span>
                            </td>
                            <td class="px-6 py-4 text-slate-600 font-medium">@role.Description</td>
                            <td class="px-6 py-4 text-right">
                                @if (role.CompanyId != Guid.Empty && !role.Name.Contains("SuperAdmin"))
                                {
                                    <div class="flex items-center justify-end gap-3 opacity-100" @onclick:stopPropagation="true">
                                        <button @onclick="() => Edit(role)" class="text-indigo-600 hover:text-indigo-900 font-bold text-xs hover:underline transition-all">Edit</button>
                                        <button @onclick="() => DeleteRole(role)" class="text-slate-400 hover:text-red-600 transition-colors p-1">
                                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </div>
                                }
                                else if (role.CompanyId == Guid.Empty && !role.Name.Contains("SuperAdmin"))
                                {
                                    <span class="text-xs text-slate-400 italic bg-slate-50 px-2 py-1 rounded border border-slate-100">System Default</span>
                                }
                            </td>
                        </tr>
                        
                        @if (viewingRoleId == role.Id)
                        {
                            <tr class="bg-slate-50/80 border-b border-slate-200">
                                <td colspan="3" class="px-6 py-4">
                                    <div class="text-xs font-bold text-slate-500 mb-2 uppercase tracking-wide">Assigned Access</div>
                                    <div class="flex flex-wrap gap-2">
                                        @if (rolePermissionsCache.ContainsKey(role.Id) && rolePermissionsCache[role.Id].Any())
                                        {
                                            @foreach (var perm in rolePermissionsCache[role.Id])
                                            {
                                                <span class="px-2 py-1 bg-white border border-slate-200 rounded text-xs text-slate-700 shadow-sm">
                                                    @perm.DisplayName
                                                </span>
                                            }
                                        }
                                        else if(role.Name.Contains("SuperAdmin"))
                                        {
                                            <span class="text-slate-400 text-xs italic">Access to all modules</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 text-xs italic">No specific module access assigned.</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-6 py-12 text-center text-slate-400">
                            No custom roles defined for this company.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.025em;
    }
</style>

@code {
    private const string InputClass = "block w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-900 shadow-sm focus:border-slate-800 focus:ring-2 focus:ring-slate-200 transition-all placeholder:text-slate-400";

    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;

    private List<ApplicationRole> roles = new();
    private ApplicationRole currentRole = new();
    private bool showForm = false;

    // RBAC Additions
    private List<Permission> availablePagePermissions = new();
    private HashSet<int> selectedPermissionIds = new();
    private string viewingRoleId = "";
    private Dictionary<string, List<Permission>> rolePermissionsCache = new();

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("SuperAdmin"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);
            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                await LoadAvailablePermissions();
                await LoadRoles();
            }
        }
        isLoading = false;
    }

    private async Task LoadAvailablePermissions()
    {
        // Custom roles only get assigned Page-level access (ActionKey == null) as per RBAC docs.
        availablePagePermissions = await RoleService.GetPageLevelPermissionsAsync();
    }

    private async Task LoadRoles()
    {
        if (!HasCompany) return;
        roles = await RoleService.GetRolesAsync(selectedCompanyId);
    }

    private void CreateNew()
    {
        currentRole = new ApplicationRole { CompanyId = selectedCompanyId };
        selectedPermissionIds.Clear();
        showForm = true;
    }

    private async Task Edit(ApplicationRole role)
    {
        currentRole = new ApplicationRole
        {
            Id = role.Id,
            CompanyId = role.CompanyId,
            DisplayName = role.DisplayName,
            Description = role.Description
        };
        
        // Fetch existing permissions for this role to populate checkboxes
        var currentPerms = await RoleService.GetPermissionsForRoleAsync(role.Id);
        selectedPermissionIds = currentPerms.Select(p => p.Id).ToHashSet();
        
        showForm = true;
    }

    private void TogglePermission(int permissionId, object? checkedValue)
    {
        if (checkedValue is bool isChecked)
        {
            if (isChecked) selectedPermissionIds.Add(permissionId);
            else selectedPermissionIds.Remove(permissionId);
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(currentRole.DisplayName)) return;

        currentRole.CompanyId = selectedCompanyId;

        // Save role AND its permissions
        var err = await RoleService.SaveRoleWithPermissionsAsync(currentRole, selectedPermissionIds.ToList());

        if (string.IsNullOrEmpty(err))
        {
            showForm = false;
            rolePermissionsCache.Remove(currentRole.Id); // Clear cache to force reload on next view
            await LoadRoles();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private void CancelForm() { showForm = false; }

    private async Task DeleteRole(ApplicationRole role)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete role '{role.DisplayName}'?")) return;

        var err = await RoleService.DeleteRoleAsync(role.Id);
        if (string.IsNullOrEmpty(err)) await LoadRoles();
        else await JS.InvokeVoidAsync("alert", err);
    }

    // Toggle expanding the row to view permissions
    private async Task ToggleViewPermissions(string roleId)
    {
        if (viewingRoleId == roleId)
        {
            viewingRoleId = ""; // Collapse
        }
        else
        {
            viewingRoleId = roleId; // Expand
            if (!rolePermissionsCache.ContainsKey(roleId))
            {
                var perms = await RoleService.GetPermissionsForRoleAsync(roleId);
                rolePermissionsCache[roleId] = perms;
            }
        }
    }
}