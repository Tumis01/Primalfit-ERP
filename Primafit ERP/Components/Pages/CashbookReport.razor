@page "/reports/cashbook"

@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore

@* @inject CashbookService CashService *@
@inject FinancialReportingService Cashreport
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
        <div class="flex-1">
            <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
                <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Cashbook Batch Report
            </h1>
            <p class="text-sm text-slate-500 mt-1">View detailed money-in and money-out transactions for a specific banking batch.</p>
        </div>

        <div class="flex flex-wrap items-end gap-3 w-full md:w-auto">
            <div class="w-full md:w-72">
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Select Cashbook Batch</label>
                <select @bind="selectedBatchId" class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-900 focus:border-slate-900 focus:ring-slate-900 transition-all outline-none">
                    <option value="@Guid.Empty">-- Select a Batch --</option>
                    @foreach (var batch in availableBatches)
                    {
                        <option value="@batch.Id">@batch.BatchReference - @batch.Date.ToString("MMM dd, yyyy")</option>
                    }
                </select>
            </div>

            <button @onclick="RunReportAsync" disabled="@(isGenerating || selectedBatchId == Guid.Empty)"
                    class="px-6 py-2.5 bg-slate-900 text-white text-sm font-bold rounded-xl shadow-md hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-2">
                @if (isGenerating)
                {
                    <svg class="h-4 w-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    <span>Generating...</span>
                }
                else
                {
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    <span>View Cashbook</span>
                }
            </button>
        </div>
    </div>

    @if (reportData != null)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500">
            
            <div class="bg-slate-50/50 border-b border-slate-100 p-4 flex justify-between items-center">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">@reportData.ReportName</h3>
                    <p class="text-xs font-mono text-slate-500">@reportData.ReportingPeriod</p>
                </div>
                <div class="flex gap-2">
                    <button class="flex items-center gap-2 px-4 py-1.5 bg-white border border-slate-200 text-slate-600 text-xs font-bold rounded hover:bg-slate-50 transition-colors shadow-sm">
                        Export PDF
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-900 text-xs uppercase font-bold text-white tracking-wider">
                        <tr>
                            @foreach (var header in reportData.Headers)
                            {
                                <th class="px-6 py-4 @(header.Contains("Money") || header.Contains("Balance") ? "text-right" : "")">@header</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var row in reportData.Rows)
                        {
                            // Detect structural rows created in your C# method to apply beautiful styling
                            bool isInfoRow = row[0] == "INFO";
                            bool isOpeningBal = row[1] == "OPENING BALANCE";
                            bool isClosingBal = row[1] == "CLOSING BALANCE";

                            if (isInfoRow)
                            {
                                <tr class="bg-indigo-50/50 border-b-2 border-indigo-100">
                                    <td colspan="6" class="px-6 py-3 text-xs font-bold text-indigo-700 uppercase tracking-wide">
                                        @row[1]
                                    </td>
                                </tr>
                            }
                            else if (isOpeningBal)
                            {
                                <tr class="bg-slate-50 border-b-2 border-slate-200">
                                    <td class="px-6 py-4"></td>
                                    <td colspan="4" class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">
                                        Opening Balance
                                    </td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-900 text-base">
                                        @row[5]
                                    </td>
                                </tr>
                            }
                            else if (isClosingBal)
                            {
                                <tr class="bg-slate-50 border-t-2 border-slate-800">
                                    <td class="px-6 py-4"></td>
                                    <td class="px-6 py-4 text-sm font-bold text-slate-900 uppercase tracking-wider">
                                        Closing Balance
                                    </td>
                                    <td class="px-6 py-4"></td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-600">@row[2]</td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-600">@row[3]</td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-emerald-600 text-lg">
                                        @row[5]
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="hover:bg-slate-50 transition-colors group">
                                    <td class="px-6 py-3 font-mono text-slate-500 text-xs">@row[0]</td>
                                    <td class="px-6 py-3 font-mono text-xs text-indigo-600 font-bold">@row[1]</td>
                                    <td class="px-6 py-3 text-slate-700 max-w-xs truncate" title="@row[2]">@row[2]</td>
                                    <td class="px-6 py-3 text-right font-mono text-emerald-600 font-medium">@row[3]</td>
                                    <td class="px-6 py-3 text-right font-mono text-rose-500 font-medium">@row[4]</td>
                                    <td class="px-6 py-3 text-right font-mono font-bold text-slate-800">@row[5]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool isGenerating = false;
    private Guid selectedBatchId = Guid.Empty;
    private StandardReportData? reportData;

    // A lightweight DTO for the dropdown
    public class BatchDropdownItem
    {
        public Guid Id { get; set; }
        public string BatchReference { get; set; } = "";
        public DateTime Date { get; set; }
    }

    private List<BatchDropdownItem> availableBatches = new();

    protected override async Task OnInitializedAsync()
    {
        // TODO: Replace with your actual database fetch for CashbookBatches
        // Example: availableBatches = await ctx.CashbookBatches.Select(b => new BatchDropdownItem { Id = b.Id, BatchReference = b.BatchReference, Date = b.Date }).ToListAsync();
        
        // Mock data so the UI works immediately for you to see
        availableBatches.Add(new BatchDropdownItem { Id = Guid.NewGuid(), BatchReference = "CB-FEB-001", Date = DateTime.Today.AddDays(-2) });
    }

    private async Task RunReportAsync()
    {
        if (selectedBatchId == Guid.Empty) return;

        isGenerating = true;
        reportData = null;

        try
        {
            // Call the exact C# method you provided
            reportData = await Cashreport.GenerateCashbookReportAsync(selectedBatchId);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error generating cashbook: {ex.Message}");
        }
        finally
        {
            isGenerating = false;
        }
    }
}