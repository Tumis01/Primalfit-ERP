@page "/reports/cashbook"

@using Primafit_ERP.Components.Models.Reporting
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject FinancialReportingService Cashreport
@inject ReportExportService ExportService
@inject SegCoaService GLService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12">

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col xl:flex-row justify-between items-start xl:items-end gap-4">
        <div class="flex-1">
            <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
                
                Bank Statement / Cashbook
            </h1>
            <p class="text-sm text-slate-500 mt-1">View the complete ledger and running balance for any bank or cash account.</p>
        </div>

        <div class="flex flex-wrap items-end gap-3 w-full xl:w-auto bg-slate-50 p-3 rounded-xl border border-slate-100">
            
            <div class="w-full md:w-64">
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Bank Account</label>
                <select @bind="selectedBankId" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 focus:border-slate-900 focus:ring-slate-900 transition-all outline-none shadow-sm">
                    <option value="@Guid.Empty">-- Select Account --</option>
                    @foreach (var bank in bankAccounts)
                    {
                        <option value="@bank.Id">@bank.AccountCode - @bank.Description</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">Start Date</label>
                <input type="date" @bind="startDate" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-slate-900" />
            </div>

            <div>
                <label class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider mb-1">End Date</label>
                <input type="date" @bind="endDate" class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-slate-900" />
            </div>

            <button @onclick="RunReportAsync" disabled="@(isGenerating || selectedBankId == Guid.Empty)"
                    class="px-5 py-2 bg-slate-900 text-white text-sm font-bold rounded-lg shadow-md hover:bg-slate-800 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-2 h-[38px]">
                @if (isGenerating)
                {
                    <span class="animate-spin">↻</span>
                    <span>Loading...</span>
                }
                else
                {
                    <span>Run Report</span>
                }
            </button>
        </div>
    </div>

    @if (reportData != null)
    {
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500">
            
            <div class="bg-slate-50/50 border-b border-slate-100 p-4 flex flex-col sm:flex-row justify-between items-center gap-4">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">@reportData.ReportName</h3>
                    <p class="text-xs font-mono text-slate-500">@reportData.ReportingPeriod</p>
                </div>
                <div class="flex gap-2">
                    <button @onclick="ExportPdf" disabled="@isExporting" class="flex items-center gap-2 px-4 py-1.5 bg-white border border-rose-200 text-rose-700 text-xs font-bold rounded hover:bg-rose-50 transition-colors shadow-sm disabled:opacity-50">
                        PDF
                    </button>
                    <button @onclick="ExportExcel" disabled="@isExporting" class="flex items-center gap-2 px-4 py-1.5 bg-white border border-emerald-200 text-emerald-700 text-xs font-bold rounded hover:bg-emerald-50 transition-colors shadow-sm disabled:opacity-50">
                         Excel
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm whitespace-nowrap">
                    <thead class="bg-slate-900 text-xs uppercase font-bold text-white tracking-wider">
                        <tr>
                            @foreach (var header in reportData.Headers)
                            {
                                <th class="px-6 py-4 @(header.Contains("Money") || header.Contains("Balance") ? "text-right" : "")">@header</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var row in reportData.Rows)
                        {
                            bool isInfoRow = row[0] == "INFO";
                            bool isOpeningBal = row[1] == "OPENING BALANCE";
                            bool isClosingBal = row[1] == "CLOSING BALANCE";

                            if (isInfoRow)
                            {
                                <tr class="bg-indigo-50/50 border-b-2 border-indigo-100">
                                    <td colspan="6" class="px-6 py-3 text-xs font-bold text-indigo-700 uppercase tracking-wide">
                                        @row[1]
                                    </td>
                                </tr>
                            }
                            else if (isOpeningBal)
                            {
                                <tr class="bg-slate-50 border-b-2 border-slate-200">
                                    <td class="px-6 py-4"></td>
                                    <td colspan="4" class="px-6 py-4 text-xs font-bold text-slate-500 uppercase tracking-wider">
                                        Opening Balance
                                    </td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-900 text-base">
                                        @row[5]
                                    </td>
                                </tr>
                            }
                            else if (isClosingBal)
                            {
                                <tr class="bg-slate-50 border-t-2 border-slate-800">
                                    <td class="px-6 py-4"></td>
                                    <td class="px-6 py-4 text-sm font-bold text-slate-900 uppercase tracking-wider">
                                        Closing Balance
                                    </td>
                                    <td class="px-6 py-4"></td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-600">@row[2]</td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-slate-600">@row[3]</td>
                                    <td class="px-6 py-4 text-right font-mono font-bold text-emerald-600 text-lg">
                                        @row[5]
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr class="hover:bg-slate-50 transition-colors group">
                                    <td class="px-6 py-3 font-mono text-slate-500 text-xs">@row[0]</td>
                                    <td class="px-6 py-3 font-mono text-xs text-indigo-600 font-bold">@row[1]</td>
                                    <td class="px-6 py-3 text-slate-700 max-w-xs truncate" title="@row[2]">@row[2]</td>
                                    <td class="px-6 py-3 text-right font-mono text-emerald-600 font-medium">@row[3]</td>
                                    <td class="px-6 py-3 text-right font-mono text-rose-500 font-medium">@row[4]</td>
                                    <td class="px-6 py-3 text-right font-mono font-bold text-slate-800">@row[5]</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private Guid currentCompanyId;
    private bool isGenerating = false;
    private bool isExporting = false;
    
    private Guid selectedBankId = Guid.Empty;
    private DateOnly startDate = new DateOnly(DateTime.Today.Year, DateTime.Today.Month, 1); // Default to start of month
    private DateOnly endDate = DateOnly.FromDateTime(DateTime.Today);
    
    private StandardReportData? reportData;
    private List<SegChartOfAccount> bankAccounts = new();

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("FINANCE_REPORTS_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            
            // Fetch all accounts that are Assets (usually Banks fall under Current Assets / IsDebit = true)
            // You can narrow this down further if you have a specific SegAccountTypeId for "Bank and Cash"
            var allAccts = await GLService.GetActiveCoaAsync(currentCompanyId);
            var types = await GLService.GetAccountTypesAsync();
            
            bankAccounts = allAccts.Where(a =>
            {
                var t = types.FirstOrDefault(x => x.Id == a.SegAccountTypeId);
                return t != null && t.IsBalanceSheet && t.IsDebit && (t.Description.Contains("Bank") || t.Description.Contains("Cash"));
            }).OrderBy(a => a.AccountCode).ToList();
        }
    }

    private async Task RunReportAsync()
    {
        if (selectedBankId == Guid.Empty) return;

        isGenerating = true;
        reportData = null;

        try
        {
            reportData = await Cashreport.GenerateBankLedgerAsync(currentCompanyId, selectedBankId, startDate, endDate);
            
            // Inject current user name for the footer of the exports
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            reportData.GeneratedBy = authState.User.Identity?.Name ?? "System User";
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error generating cashbook: {ex.Message}");
        }
        finally
        {
            isGenerating = false;
        }
    }

    private async Task ExportPdf()
    {
        if (reportData == null) return;
        isExporting = true;
        try
        {
            var bytes = ExportService.GeneratePdf(reportData);
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", $"BankLedger_{DateTime.Now:yyyyMMdd_HHmm}.pdf", streamRef);
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task ExportExcel()
    {
        if (reportData == null) return;
        isExporting = true;
        try
        {
            var bytes = ExportService.GenerateExcel(reportData);
            using var streamRef = new DotNetStreamReference(stream: new MemoryStream(bytes));
            await JS.InvokeVoidAsync("downloadFileFromStream", $"BankLedger_{DateTime.Now:yyyyMMdd_HHmm}.xlsx", streamRef);
        }
        finally
        {
            isExporting = false;
        }
    }
}