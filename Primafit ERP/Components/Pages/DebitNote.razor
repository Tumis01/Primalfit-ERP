    {
        selectedVendorId = Guid.Empty;
        selectedBillId = Guid.Empty;
        amountToReverseForeign = 0;
        baseCurrencyRefundDisplayValue = 0;
        customReferenceInput = "";
        currencySymbol = "";
        targetBankGlAccountId = Guid.Empty;
        currentPaymentId = Guid.Empty;
        _isFormWorkspaceOpen = false;
        IsDraftRecord = false;
        _errMsg = string.Empty;
