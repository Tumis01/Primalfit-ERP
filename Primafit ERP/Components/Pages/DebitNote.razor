@page "/ap/debit-note"
@page "/ap/debit-note/entry/{Id:guid?}"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@using DebitNoteModel = Primafit_ERP.Components.Models.DebitNote
@using DebitNoteLineModel = Primafit_ERP.Components.Models.DebitNoteLine

@inject DebitNoteService DebitService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject TransactionMappingService MappingService
@inject CompanyApiService CompanyService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800 pb-16">

    <!-- HEADER / ACTION BAR -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-4 border-b border-slate-200">
        <div class="space-y-1">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
                @if (IsListMode)
                {
                    <span>Debit Notes</span>
                }
                else if (IsNewInitialization)
                {
                    <span>Initialize Debit Note</span>
                }
                else
                {
                    <span>Debit Note: @currentDebitNote?.DebitNoteNumber</span>
                }
            </h1>
            <p class="text-sm font-medium @(IsPosted ? "text-emerald-600" : (IsRejected ? "text-rose-600" : "text-amber-600"))">
                @if (IsListMode)
                {
                    <span class="text-slate-500">Review, track, and manage vendor purchase billing line adjustments</span>
                }
                else if (IsPosted)
                {
                    <span>● Posted Financial Document - Read Only</span>
                }
                else if (IsRejected)
                {
                    <span>● Returned for Correction - Edit and Resubmit</span>
                }
                else
                {
                    <span>● Draft - Pending GL Review</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            @if (!IsListMode)
            {
                <button type="button" @onclick="NavigateToListView"
                        class="px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-600 font-bold hover:bg-slate-50 transition-all shadow-sm active:scale-95">
                    Back to List
                </button>
            }

            @if (!IsListMode && !IsNewInitialization && currentDebitNote != null && canConfigureRoute)
            {
                <!-- Configure Route Button -->
                <button type="button" @onclick="OpenRouteModal" class="px-4 py-2.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors flex items-center gap-1.5 shadow-sm active:scale-95">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    <span>Configure Route</span>
                    @if (currentDebitNote.CustomTransactionTypeId.HasValue)
                    {
                        <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                    }
                </button>
            }

            @if (IsListMode)
            {
                <button type="button" @onclick="OpenNewFormInitializer" class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                    <span>New Debit Note</span>
                </button>
            }
            else if (!IsPosted && !IsNewInitialization)
            {
                <button type="button" @onclick="DeleteDraft" class="px-5 py-2.5 bg-white border border-slate-200 text-rose-600 text-sm font-bold rounded-xl hover:bg-rose-50 transition-colors shadow-sm active:scale-95">
                    Delete Draft
                </button>

                <button type="button" @onclick="SaveDraftWorkspace" disabled="@isBusy" class="px-5 py-2.5 bg-white border border-slate-200 text-indigo-600 text-sm font-bold rounded-xl hover:bg-indigo-50 transition-colors shadow-sm active:scale-95">
                    Save Draft
                </button>

                <button type="button" @onclick="PostStockDebitNote" disabled="@isBusy" class="px-6 py-2.5 bg-rose-600 text-white rounded-xl text-sm font-bold hover:bg-rose-700 shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50">
                    @if (isBusy)
                    {
                        <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                    }
                    <span>Submit Adjustment for GL Review</span>
                </button>
            }
        </div>
    </div>

    @if (IsRejected && !string.IsNullOrWhiteSpace(currentBatchRejectionReason))
    {
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl text-sm text-rose-800">
            <span class="font-bold uppercase tracking-wider">GL review rejection:</span> @currentBatchRejectionReason
        </div>
    }

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading debit note workspace...
        </div>
    }
    else if (currentCompanyId != Guid.Empty)
    {
        @if (IsListMode)
        {
            <!-- LIST VIEW -->
            <div class="space-y-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="relative w-full sm:w-80">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        <input type="text" @bind="listSearchTerm" @bind:event="oninput" placeholder="Search reference, vendor, invoice..." class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium outline-none focus:border-rose-500 transition-all" />
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                                <tr>
                                    <th class="px-6 py-4">Debit Note #</th>
                                    <th class="px-6 py-4">Date</th>
                                    <th class="px-6 py-4">Vendor</th>
                                    <th class="px-6 py-4">Target Invoice</th>
                                    <th class="px-6 py-4 text-center">Status</th>
                                    <th class="px-6 py-4 text-right pr-8">Total Adjusted</th>
                                    <th class="px-6 py-4 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                                @foreach (var dn in PaginatedDebitNotes)
                                {
                                    bool hasFx = dn.ExchangeRate > 1 && dn.ExchangeRate != 1m;
                                    decimal baseAmount = Math.Round(dn.TotalAmount * dn.ExchangeRate, 2);
                                    var batchStatus = GetBatchStatus(dn.GlBatchId, dn.Status == DebitNoteStatus.Posted);
                                    bool isRejected = batchStatus == BatchStatus.Rejected;
                                    bool isPosted = batchStatus == BatchStatus.Posted;

                                    <tr class="hover:bg-slate-50/60 transition-colors">
                                        <td class="px-6 py-4 font-mono font-bold text-slate-900">@dn.DebitNoteNumber</td>
                                        <td class="px-6 py-4 text-slate-500 font-medium">@dn.TransactionDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="px-6 py-4 font-bold text-slate-900">@(dn.Vendor?.Name ?? "Unknown Vendor")</td>
                                        <td class="px-6 py-4 font-mono text-xs font-bold text-slate-600">@(dn.PurchaseOrder?.OrderNumber ?? "N/A")</td>
                                        <td class="px-6 py-4 text-center">
                                            @if (isPosted)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Posted</span>
                                            }
                                            else if (isRejected)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 border border-rose-200 px-2.5 py-1 text-[10px] font-bold text-rose-700 uppercase tracking-wider animate-pulse">Rejected - Edit Required</span>
                                            }
                                            else if (batchStatus == BatchStatus.Ready)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-1 text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Pending GL Review</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">Draft</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right font-mono pr-8">
                                            @if (hasFx)
                                            {
                                                <div>
                                                    <span class="font-bold text-rose-600">@dn.TotalAmount.ToString("N4")</span>
                                                    <span class="text-[9px] text-slate-400 uppercase ml-0.5">@(dn.Currency?.CurrencyCode ?? "")</span>
                                                </div>
                                                <div class="text-xs text-slate-500 font-semibold">
                                                    <span>@baseAmount.ToString("N4")</span>
                                                    <span class="text-[9px] text-slate-400 uppercase ml-0.5">@companyBaseCurrency</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="font-black text-rose-600">@dn.TotalAmount.ToString("N4")</span>
                                                <span class="text-[9px] text-slate-400 uppercase ml-0.5">@(dn.Currency?.CurrencyCode ?? companyBaseCurrency)</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <button type="button" @onclick="() => RouteToTargetNote(dn.Id)" class="inline-flex items-center justify-center rounded-lg px-4 py-1.5 text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors">
                                                @(isRejected ? "Edit & Resubmit" : (isPosted ? "View Details" : "Edit Draft"))
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!PaginatedDebitNotes.Any())
                                {
                                    <tr><td colspan="7" class="p-16 text-center text-slate-400 font-medium">No debit notes recorded for this period.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-bold text-slate-500">
                        <div>Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, TotalFilteredCount) of @TotalFilteredCount items</div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="() => { if (currentPage > 1) currentPage--; }" disabled="@(currentPage == 1)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40">Previous</button>
                            <span class="px-3 font-semibold text-slate-700">Page @currentPage of @TotalPages</span>
                            <button type="button" @onclick="() => { if (currentPage < TotalPages) currentPage++; }" disabled="@(currentPage == TotalPages || TotalPages == 0)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (IsNewInitialization)
        {
            <!-- INITIALIZATION WIZARD -->
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm max-w-xl mx-auto mt-6 space-y-6">
                <div>
                    <h3 class="text-base font-bold text-slate-900 uppercase tracking-wider">Initialize Invoice Line Adjustment</h3>
                    <p class="text-xs text-slate-500 mt-1">Select a vendor partner and the target purchase invoice to adjust quantities and costs.</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="label">Step 1: Select Vendor <span class="text-rose-500">*</span></label>
                        <select value="@selectedVendorId" @onchange="OnVendorSelected" class="input-class font-bold">
                            <option value="@Guid.Empty">-- Select Vendor --</option>
                            @foreach (var ven in vendors)
                            {
                                <option value="@ven.Id">@ven.Name</option>
                            }
                        </select>
                    </div>

                    @if (selectedVendorId != Guid.Empty)
                    {
                        <div class="animate-in fade-in duration-300">
                            <label class="label">Step 2: Choose Target Purchase Invoice <span class="text-rose-500">*</span></label>
                            <select @bind="selectedInvoiceId" class="input-class font-mono font-bold">
                                <option value="@Guid.Empty">-- Select Invoice --</option>
                                @foreach (var inv in eligibleInvoices)
                                {
                                    <option value="@inv.Id">@inv.OrderNumber (@inv.OrderDate.ToString("yyyy-MM-dd HH:mm"))</option>
                                }
                            </select>
                            @if (_loadingInvoices)
                            {
                                <p class="text-xs text-rose-600 font-bold mt-2 animate-pulse">Scanning eligible transactions...</p>
                            }
                            else if (!eligibleInvoices.Any())
                            {
                                <p class="text-xs text-amber-600 font-bold mt-2">No adjustable invoices found for this supplier.</p>
                            }
                        </div>
                    }

                    <button type="button" @onclick="CreateDebitNoteWorkspace" disabled="@(isBusy || selectedInvoiceId == Guid.Empty)" class="w-full px-6 py-3.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-40">
                        @if (isBusy)
                        {
                            <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                        }
                        <span>Open Debit Note Workspace</span>
                    </button>

                    @if (!string.IsNullOrEmpty(_errMsg))
                    {
                        <div class="p-4 bg-rose-50 border border-rose-100 text-rose-700 text-xs font-bold rounded-xl">@_errMsg</div>
                    }
                </div>
            </div>
        }
        else if (currentDebitNote != null)
        {
            <!-- ACTIVE WORKSPACE -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 relative z-10">

                <!-- PARAMETERS SIDEBAR -->
                <div class="lg:col-span-4 space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                        <h3 class="font-extrabold text-xs text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Document Parameters</h3>

                        <div>
                            <label class="label">Execution Date</label>
                            <input type="datetime-local" value="@currentDebitNote.TransactionDateTime.ToString("yyyy-MM-ddTHH:mm")" @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) { currentDebitNote.TransactionDateTime = d; currentDebitNote.Date = DateOnly.FromDateTime(d); } })" class="input-class font-bold text-slate-800" disabled="@IsPosted" />
                        </div>

                        <div>
                            <label class="label">Vendor</label>
                            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800">
                                @(currentDebitNote.Vendor?.Name ?? "Loaded Supplier Profile")
                            </div>
                        </div>

                        <div>
                            <label class="label">Reference Invoice Link</label>
                            <div class="font-mono bg-slate-50 p-3 rounded-xl border border-slate-200 text-sm font-bold text-slate-800">
                                @(currentDebitNote.PurchaseOrder?.OrderNumber ?? "N/A")
                            </div>
                        </div>

                        <div>
                            <label class="label">Debit Note Reference Code</label>
                            <input type="text" @bind="currentDebitNote.DebitNoteNumber" class="input-class font-mono font-bold" disabled />
                        </div>

                        <div>
                            <label class="label">Reason / Narrative</label>
                            <input type="text" @bind="currentDebitNote.Reason" class="input-class" placeholder="Correction description..." disabled="@IsPosted" />
                        </div>

                        @if (currentDebitNote.ExchangeRate > 1 && currentDebitNote.ExchangeRate != 1m)
                        {
                            <div class="p-3 bg-indigo-50/50 border border-indigo-100 rounded-xl space-y-1">
                                <span class="text-[10px] font-extrabold text-indigo-900 uppercase tracking-wider">Exchange Rate</span>
                                <div class="text-sm font-mono font-bold text-indigo-700">
                                    1 @(currentDebitNote.Currency?.CurrencyCode ?? "FX") = @currentDebitNote.ExchangeRate.ToString("N4") @companyBaseCurrency
                                </div>
                            </div>
                        }
                    </div>

                    @if (canConfigureRoute)
                    {
                    <!-- Live Active Route Card -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">Active Route</span>
                            <button type="button" @onclick="OpenRouteModal" class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800 transition-colors">
                                Edit Mappings
                            </button>
                        </div>
                        <div class="space-y-2 text-xs">
                            <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg">
                                <span class="text-slate-500 font-medium">Accounts Payable (Dr):</span>
                                <span class="font-mono font-bold text-slate-800 truncate max-w-[160px]" title="@GetAccountDisplayName(currentDebitNote.OverrideAccountsPayableGlAccountId ?? defaultApAccountId)">
                                    @(GetAccountDisplayName(currentDebitNote.OverrideAccountsPayableGlAccountId ?? defaultApAccountId))
                                </span>
                            </div>
                            <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg">
                                <span class="text-slate-500 font-medium">Inventory Stock (Cr):</span>
                                <span class="font-mono font-bold text-slate-800 truncate max-w-[160px]" title="@GetAccountDisplayName(currentDebitNote.OverrideGrIrClearingGlAccountId ?? defaultGrIrAccountId)">
                                    @(currentDebitNote.OverrideGrIrClearingGlAccountId.HasValue
                                        ? GetAccountDisplayName(currentDebitNote.OverrideGrIrClearingGlAccountId.Value)
                                        : "Per-item Inventory Asset Account")
                                </span>
                            </div>
                        </div>
                    </div>
                    }
                </div>

                <!-- MAIN WORKSPACE DETAILS -->
                <div class="lg:col-span-8">
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col min-h-[550px]">

                        <!-- BILLING QUANTITY GRID -->
                        <div class="p-6 border-b border-slate-100 bg-slate-50/50">
                            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                                Invoice Line Item Adjustments
                            </h3>
                            <p class="text-xs text-slate-500 mt-1">Specify deduction quantities against original billed amounts to reduce AP liability.</p>
                        </div>

                        <div class="overflow-x-auto flex-1 p-6">
                            <table class="w-full text-left text-sm border border-slate-200 rounded-lg overflow-hidden">
                                <thead class="text-[10px] uppercase font-extrabold text-slate-500 bg-slate-50 border-b border-slate-200 tracking-wider">
                                    <tr>
                                        <th class="px-4 py-3">Item / Service Component</th>
                                        <th class="px-4 py-3 text-center">UOM</th>
                                        <th class="px-4 py-3 text-center">Billed Qty</th>
                                        <th class="px-4 py-3 text-center text-amber-600">Max Allowance</th>
                                        <th class="px-4 py-3 text-right">Unit Cost (@(currentDebitNote.Currency?.CurrencyCode ?? "BASE"))</th>
                                        <th class="px-4 py-3 text-right w-36">Reduction Qty</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in currentDebitNote.Lines)
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors">
                                            <td class="px-4 py-3 font-medium text-slate-800">@(line.Item?.Name ?? "Item Reference")</td>
                                            <td class="px-4 py-3 text-center text-xs font-semibold text-slate-500">@(string.IsNullOrWhiteSpace(line.UomName) ? (line.Item?.UoM ?? "Each") : line.UomName)</td>
                                            <td class="px-4 py-3 text-center font-mono text-slate-600">@((line.UomConversionFactor > 0 ? line.OriginalPurchasedQty / line.UomConversionFactor : line.OriginalPurchasedQty).ToString("N2"))</td>
                                            <td class="px-4 py-3 text-center font-mono font-bold text-amber-600 bg-amber-50/30">@((line.UomConversionFactor > 0 ? line.MaxReturnableQty / line.UomConversionFactor : line.MaxReturnableQty).ToString("N2"))</td>
                                            <td class="px-4 py-3 text-right font-mono text-slate-500">
                                                @line.UnitCost.ToString("N4")
                                                @if (currentDebitNote.ExchangeRate > 1 && currentDebitNote.ExchangeRate != 1m)
                                                {
                                                    <div class="text-[10px] text-slate-400 font-semibold">
                                                        (@((line.UnitCost * currentDebitNote.ExchangeRate).ToString("N4")) @companyBaseCurrency)
                                                    </div>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-right">
                                                <input type="number"   min="0" max="@line.MaxReturnableQty"
                                                 value="@(line.Quantity == 0 ? "" : (line.UomConversionFactor > 0 ? line.Quantity / line.UomConversionFactor : line.Quantity).ToString("N2"))"
                                                       @oninput="@(e => ValidateLineQty(line, e.Value?.ToString()))"
                                                       disabled="@IsPosted"
                                                       placeholder="0.0000"
                                                       class="w-full text-right font-bold font-mono text-rose-700 border border-slate-300 rounded-lg px-2 py-1.5 appearance-none outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-100 transition-all disabled:opacity-50" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- FOOTER TOTALS -->
                        <div class="border-t border-slate-200 bg-slate-50 p-6 flex justify-between items-center mt-auto rounded-b-2xl">
                            <div>
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Adjustment Value:</span>
                            </div>
                            <div class="text-right font-mono">
                                @{
                                    decimal totalForeign = currentDebitNote.Lines.Sum(l => l.Quantity * l.UnitCost);
                                    bool hasFx = currentDebitNote.ExchangeRate > 1 && currentDebitNote.ExchangeRate != 1m;
                                    decimal totalBase = Math.Round(totalForeign * currentDebitNote.ExchangeRate, 2);
                                }

                                @if (hasFx)
                                {
                                    <div class="text-3xl font-black text-rose-600">
                                        @totalForeign.ToString("N4")
                                        <span class="text-sm font-sans font-bold text-slate-400 uppercase ml-1">@(currentDebitNote.Currency?.CurrencyCode ?? "FX")</span>
                                    </div>
                                    <div class="text-sm font-bold text-slate-600 mt-0.5">
                                        ≈ @totalBase.ToString("N4")
                                        <span class="text-xs font-sans font-semibold text-slate-400 uppercase ml-1">@companyBaseCurrency</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-3xl font-black text-rose-600">
                                        @totalForeign.ToString("N4")
                                        <span class="text-sm font-sans font-bold text-slate-400 uppercase ml-1">@(currentDebitNote.Currency?.CurrencyCode ?? companyBaseCurrency)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- ROUTE CONFIGURATION MODAL -->
@if (showRouteModal && currentDebitNote != null)
{
    <div class="fixed inset-0 z-[120] flex items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col overflow-visible">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                            <div>
                                <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">Debit Note GL Route Mapping</h3>
                                <p class="text-[11px] text-slate-500 mt-0.5">Configure the inventory-stock credit and vendor-AP debit route. Debit notes do not use a bank account.</p>
                </div>
                <button type="button" @onclick="() => showRouteModal = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-visible space-y-5 flex-1">
                <!-- Custom Template Profile Selector -->
                <div class="p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 space-y-2 relative z-[60]">
                    <label class="block text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Transaction Type / Routing Profile</label>
                    <div class="flex items-center gap-2">
                        @if (currentDebitNote.CustomTransactionTypeId.HasValue)
                        {
                            <button type="button"
                                    @onclick="() => currentDebitNote.CustomTransactionTypeId = null"
                                    class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                    title="Reset to Standard Debit Note Route">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        }
                        <select value="@(currentDebitNote.CustomTransactionTypeId?.ToString() ?? "")" @onchange="OnCustomTemplateSelected"
                                class="input-class font-bold text-xs bg-white flex-1" disabled="@IsPosted">
                            <option value="">-- Standard Debit Note (Default) --</option>
                            @foreach (var custom in customTemplates)
                            {
                                <option value="@custom.Id">@custom.Name (Transaction Type)</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Live Ledger Breakdown Table -->
                <div class="space-y-3 overflow-visible">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active GL Account Routing</span>

                    <div class="border border-slate-200 rounded-xl overflow-visible divide-y divide-slate-100 text-xs bg-white">

                        <!-- 1. Accounts Payable Liability (Debit Leg - Reduction) -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[50] rounded-t-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Accounts Payable</span>
                                <span class="text-[10px] text-indigo-600 font-bold uppercase">Debit Side (Liability Reduction)</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentDebitNote.OverrideAccountsPayableGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentDebitNote.OverrideAccountsPayableGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="System Default Vendor AP"
                                                         Accounts="@allAccounts"
                                                         Value="@(currentDebitNote.OverrideAccountsPayableGlAccountId ?? defaultApAccountId)"
                                                         ValueChanged="@((Guid val) => currentDebitNote.OverrideAccountsPayableGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                        <!-- 2. Inventory Stock Account (Credit Leg - Stock Reduction) -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[40] rounded-b-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Inventory Stock Account</span>
                                <span class="text-[10px] text-emerald-600 font-bold uppercase">Credit Side (Stock Reduction)</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (currentDebitNote.OverrideGrIrClearingGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => currentDebitNote.OverrideGrIrClearingGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="Optional Stock Account Override"
                                                         Accounts="@allAccounts"
                                                         Value="@(currentDebitNote.OverrideGrIrClearingGlAccountId ?? Guid.Empty)"
                                                         ValueChanged="@((Guid val) => currentDebitNote.OverrideGrIrClearingGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-2xl relative z-[10]">
                <button type="button" @onclick="() => showRouteModal = false" class="px-5 py-2 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors">
                    Close
                </button>
                <button type="button" @onclick="() => showRouteModal = false" class="px-6 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95">
                    Apply to Document
                </button>
            </div>
        </div>
    </div>
}

