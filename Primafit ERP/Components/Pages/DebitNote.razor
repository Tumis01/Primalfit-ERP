@page "/ap/debit-note"
@page "/ap/debit-note/entry/{Id:guid?}"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@using DebitNoteModel = Primafit_ERP.Components.Models.DebitNote
@using DebitNoteLineModel = Primafit_ERP.Components.Models.DebitNoteLine

@inject DebitNoteService DebitService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject CompanyApiService CompanyService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800">

    <!-- HEADER / ACTION BAR -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-4 border-b border-slate-200">
        <div class="space-y-1">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
                @if (IsListMode)
                {
                    <span>Debit Notes</span>
                }
                else if (IsNewInitialization)
                {
                    <span>Initialize Debit Note</span>
                }
                else
                {
                    <span>Debit Note: @currentDebitNote?.DebitNoteNumber</span>
                }
            </h1>
            <p class="text-sm font-medium @(IsPosted ? "text-emerald-600" : "text-amber-600")">
                @if (IsListMode)
                {
                    <span class="text-slate-500">Review, track, and manage vendor purchase billing line adjustments</span>
                }
                else if (IsPosted)
                {
                    <span>● Posted Financial Document - Read Only</span>
                }
                else
                {
                    <span>● Draft Debit Note Workspace</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            @if (!IsListMode)
            {
                <button type="button" @onclick="NavigateToListView"
                        class="px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-600 font-bold hover:bg-slate-50 transition-all shadow-sm active:scale-95">
                    Cancel & Back to List
                </button>
            }

            @if (IsListMode)
            {
                <button type="button" @onclick="OpenNewFormInitializer" class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                    <span>New Debit Note</span>
                </button>
            }
            else if (!IsPosted && !IsNewInitialization)
            {
                <button type="button" @onclick="DeleteDraft" class="px-5 py-2.5 bg-white border border-slate-200 text-rose-600 text-sm font-bold rounded-xl hover:bg-rose-50 transition-colors shadow-sm active:scale-95">
                    Delete Draft
                </button>

                <button type="button" @onclick="SaveDraftWorkspace" disabled="@isBusy" class="px-5 py-2.5 bg-white border border-slate-200 text-indigo-600 text-sm font-bold rounded-xl hover:bg-indigo-50 transition-colors shadow-sm active:scale-95">
                    Save Draft
                </button>

                <button type="button" @onclick="PostStockDebitNote" disabled="@isBusy" class="px-6 py-2.5 bg-rose-600 text-white rounded-xl text-sm font-bold hover:bg-rose-700 shadow-md transition-all active:scale-95 flex items-center gap-2 disabled:opacity-50">
                    @if (isBusy)
                    {
                        <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                    }
                    <span>Post Billing Adjustment</span>
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading debit note workspace...
        </div>
    }
    else if (currentCompanyId != Guid.Empty)
    {
        @if (IsListMode)
        {
            <!-- LIST VIEW -->
            <div class="space-y-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="relative w-full sm:w-80">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        <input type="text" @bind="listSearchTerm" @bind:event="oninput" placeholder="Search reference, vendor, invoice..." class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium outline-none focus:border-rose-500 transition-all" />
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                                <tr>
                                    <th class="px-6 py-4">Debit Note #</th>
                                    <th class="px-6 py-4">Date</th>
                                    <th class="px-6 py-4">Vendor</th>
                                    <th class="px-6 py-4">Target Invoice</th>
                                    <th class="px-6 py-4 text-center">Status</th>
                                    <th class="px-6 py-4 text-right pr-8">Total Adjusted</th>
                                    <th class="px-6 py-4 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                                @foreach (var dn in PaginatedDebitNotes)
                                {
                                    bool hasFx = dn.ExchangeRate > 1 && dn.ExchangeRate != 1m;
                                    decimal baseAmount = Math.Round(dn.TotalAmount * dn.ExchangeRate, 2);

                                    <tr class="hover:bg-slate-50/60 transition-colors">
                                        <td class="px-6 py-4 font-mono font-bold text-slate-900">@dn.DebitNoteNumber</td>
                                        <td class="px-6 py-4 text-slate-500 font-medium">@dn.Date.ToString("yyyy-MM-dd")</td>
                                        <td class="px-6 py-4 font-bold text-slate-900">@(dn.Vendor?.Name ?? "Unknown Vendor")</td>
                                        <td class="px-6 py-4 font-mono text-xs font-bold text-slate-600">@(dn.PurchaseOrder?.OrderNumber ?? "N/A")</td>
                                        <td class="px-6 py-4 text-center">
                                            @if (dn.Status == DebitNoteStatus.Posted)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Posted</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">Draft</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right font-mono pr-8">
                                            @if (hasFx)
                                            {
                                                <div>
                                                    <span class="font-bold text-rose-600">@dn.TotalAmount.ToString("N2")</span>
                                                    <span class="text-[9px] text-slate-400 uppercase ml-0.5">@(dn.Currency?.CurrencyCode ?? "")</span>
                                                </div>
                                                <div class="text-xs text-slate-500 font-semibold">
                                                    <span>@baseAmount.ToString("N2")</span>
                                                    <span class="text-[9px] text-slate-400 uppercase ml-0.5">@companyBaseCurrency</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="font-black text-rose-600">@dn.TotalAmount.ToString("N2")</span>
                                                <span class="text-[9px] text-slate-400 uppercase ml-0.5">@(dn.Currency?.CurrencyCode ?? companyBaseCurrency)</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <button type="button" @onclick="() => RouteToTargetNote(dn.Id)" class="inline-flex items-center justify-center rounded-lg px-4 py-1.5 text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors">
                                                @(dn.Status == DebitNoteStatus.Posted ? "View Details" : "Edit Draft")
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!PaginatedDebitNotes.Any())
                                {
                                    <tr><td colspan="7" class="p-16 text-center text-slate-400 font-medium">No debit notes recorded for this period.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-bold text-slate-500">
                        <div>Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, TotalFilteredCount) of @TotalFilteredCount items</div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="() => { if (currentPage > 1) currentPage--; }" disabled="@(currentPage == 1)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40">Previous</button>
                            <span class="px-3 font-semibold text-slate-700">Page @currentPage of @TotalPages</span>
                            <button type="button" @onclick="() => { if (currentPage < TotalPages) currentPage++; }" disabled="@(currentPage == TotalPages || TotalPages == 0)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (IsNewInitialization)
        {
            <!-- INITIALIZATION WIZARD -->
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm max-w-xl mx-auto mt-6 space-y-6">
                <div>
                    <h3 class="text-base font-bold text-slate-900 uppercase tracking-wider">Initialize Invoice Line Adjustment</h3>
                    <p class="text-xs text-slate-500 mt-1">Select a vendor partner and the target purchase invoice to adjust quantities and costs.</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="label">Step 1: Select Vendor <span class="text-rose-500">*</span></label>
                        <select value="@selectedVendorId" @onchange="OnVendorSelected" class="input-class font-bold">
                            <option value="@Guid.Empty">-- Select Vendor --</option>
                            @foreach (var ven in vendors)
                            {
                                <option value="@ven.Id">@ven.Name</option>
                            }
                        </select>
                    </div>

                    @if (selectedVendorId != Guid.Empty)
                    {
                        <div class="animate-in fade-in duration-300">
                            <label class="label">Step 2: Choose Target Purchase Invoice <span class="text-rose-500">*</span></label>
                            <select @bind="selectedInvoiceId" class="input-class font-mono font-bold">
                                <option value="@Guid.Empty">-- Select Invoice --</option>
                                @foreach (var inv in eligibleInvoices)
                                {
                                    <option value="@inv.Id">@inv.OrderNumber (@inv.OrderDate.ToString("yyyy-MM-dd"))</option>
                                }
                            </select>
                            @if (_loadingInvoices)
                            {
                                <p class="text-xs text-rose-600 font-bold mt-2 animate-pulse">Scanning eligible transactions...</p>
                            }
                            else if (!eligibleInvoices.Any())
                            {
                                <p class="text-xs text-amber-600 font-bold mt-2">No adjustable invoices found for this supplier.</p>
                            }
                        </div>
                    }

                    <button type="button" @onclick="CreateDebitNoteWorkspace" disabled="@(isBusy || selectedInvoiceId == Guid.Empty)" class="w-full px-6 py-3.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-40">
                        @if (isBusy)
                        {
                            <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                        }
                        <span>Open Debit Note Workspace</span>
                    </button>

                    @if (!string.IsNullOrEmpty(_errMsg))
                    {
                        <div class="p-4 bg-rose-50 border border-rose-100 text-rose-700 text-xs font-bold rounded-xl">@_errMsg</div>
                    }
                </div>
            </div>
        }
        else if (currentDebitNote != null)
        {
            <!-- ACTIVE WORKSPACE -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 relative z-10">

                <!-- PARAMETERS SIDEBAR -->
                <div class="lg:col-span-4 space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
                        <h3 class="font-extrabold text-xs text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Document Parameters</h3>

                        <div>
                            <label class="label">Execution Date</label>
                            <input type="date" value="@currentDebitNote.Date.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateOnly.TryParse(e.Value?.ToString(), out var d)) currentDebitNote.Date = d; })" class="input-class font-bold text-slate-800" disabled="@IsPosted" />
                        </div>

                        <div>
                            <label class="label">Vendor</label>
                            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800">
                                @(currentDebitNote.Vendor?.Name ?? "Loaded Supplier Profile")
                            </div>
                        </div>

                        <div>
                            <label class="label">Reference Invoice Link</label>
                            <div class="font-mono bg-slate-50 p-3 rounded-xl border border-slate-200 text-sm font-bold text-slate-800">
                                @(currentDebitNote.PurchaseOrder?.OrderNumber ?? "N/A")
                            </div>
                        </div>

                        <div>
                            <label class="label">Debit Note Reference Code</label>
                            <input type="text" @bind="currentDebitNote.DebitNoteNumber" class="input-class font-mono font-bold" disabled />
                        </div>

                        <div>
                            <label class="label">Reason / Narrative</label>
                            <input type="text" @bind="currentDebitNote.Reason" class="input-class" placeholder="Correction description..." disabled="@IsPosted" />
                        </div>

                        @if (currentDebitNote.ExchangeRate > 1 && currentDebitNote.ExchangeRate != 1m)
                        {
                            <div class="p-3 bg-indigo-50/50 border border-indigo-100 rounded-xl space-y-1">
                                <span class="text-[10px] font-extrabold text-indigo-900 uppercase tracking-wider">Exchange Rate</span>
                                <div class="text-sm font-mono font-bold text-indigo-700">
                                    1 @(currentDebitNote.Currency?.CurrencyCode ?? "FX") = @currentDebitNote.ExchangeRate.ToString("N4") @companyBaseCurrency
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- MAIN WORKSPACE DETAILS -->
                <div class="lg:col-span-8">
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col min-h-[550px]">

                        <!-- BILLING QUANTITY GRID -->
                        <div class="p-6 border-b border-slate-100 bg-slate-50/50">
                            <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">
                                Invoice Line Item Adjustments
                            </h3>
                            <p class="text-xs text-slate-500 mt-1">Specify deduction quantities against original billed amounts to reduce AP liability.</p>
                        </div>

                        <div class="overflow-x-auto flex-1 p-6">
                            <table class="w-full text-left text-sm border border-slate-200 rounded-lg overflow-hidden">
                                <thead class="text-[10px] uppercase font-extrabold text-slate-500 bg-slate-50 border-b border-slate-200 tracking-wider">
                                    <tr>
                                        <th class="px-4 py-3">Item / Service Component</th>
                                        <th class="px-4 py-3 text-center">Billed Qty</th>
                                        <th class="px-4 py-3 text-center text-amber-600">Max Allowance</th>
                                        <th class="px-4 py-3 text-right">Unit Cost (@(currentDebitNote.Currency?.CurrencyCode ?? "BASE"))</th>
                                        <th class="px-4 py-3 text-right w-36">Reduction Qty</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @foreach (var line in currentDebitNote.Lines)
                                    {
                                        <tr class="bg-white hover:bg-slate-50 transition-colors">
                                            <td class="px-4 py-3 font-medium text-slate-800">@(line.Item?.Name ?? "Item Reference")</td>
                                            <td class="px-4 py-3 text-center font-mono text-slate-600">@line.OriginalPurchasedQty.ToString("N2")</td>
                                            <td class="px-4 py-3 text-center font-mono font-bold text-amber-600 bg-amber-50/30">@line.MaxReturnableQty.ToString("N2")</td>
                                            <td class="px-4 py-3 text-right font-mono text-slate-500">
                                                @line.UnitCost.ToString("N2")
                                                @if (currentDebitNote.ExchangeRate > 1 && currentDebitNote.ExchangeRate != 1m)
                                                {
                                                    <div class="text-[10px] text-slate-400 font-semibold">
                                                        (@((line.UnitCost * currentDebitNote.ExchangeRate).ToString("N2")) @companyBaseCurrency)
                                                    </div>
                                                }
                                            </td>
                                            <td class="px-4 py-3 text-right">
                                                <input type="number" step="0.01" min="0" max="@line.MaxReturnableQty"
                                                       value="@(line.Quantity == 0 ? "" : line.Quantity)"
                                                       @oninput="@(e => ValidateLineQty(line, e.Value?.ToString()))"
                                                       disabled="@IsPosted"
                                                       placeholder="0.00"
                                                       class="w-full text-right font-bold font-mono text-rose-700 border border-slate-300 rounded-lg px-2 py-1.5 outline-none focus:border-rose-500 focus:ring-2 focus:ring-rose-100 transition-all disabled:opacity-50" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- FOOTER TOTALS WITH MULTI-CURRENCY RENDERING -->
                        <div class="border-t border-slate-200 bg-slate-50 p-6 flex justify-between items-center mt-auto rounded-b-2xl">
                            <div>
                                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Adjustment Value:</span>
                            </div>
                            <div class="text-right font-mono">
                                @{
                                    decimal totalForeign = currentDebitNote.Lines.Sum(l => l.Quantity * l.UnitCost);
                                    bool hasFx = currentDebitNote.ExchangeRate > 1 && currentDebitNote.ExchangeRate != 1m;
                                    decimal totalBase = Math.Round(totalForeign * currentDebitNote.ExchangeRate, 2);
                                }

                                @if (hasFx)
                                {
                                    <div class="text-3xl font-black text-rose-600">
                                        @totalForeign.ToString("N2")
                                        <span class="text-sm font-sans font-bold text-slate-400 uppercase ml-1">@(currentDebitNote.Currency?.CurrencyCode ?? "FX")</span>
                                    </div>
                                    <div class="text-sm font-bold text-slate-600 mt-0.5">
                                        ≈ @totalBase.ToString("N2")
                                        <span class="text-xs font-sans font-semibold text-slate-400 uppercase ml-1">@companyBaseCurrency</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-3xl font-black text-rose-600">
                                        @totalForeign.ToString("N2")
                                        <span class="text-sm font-sans font-bold text-slate-400 uppercase ml-1">@(currentDebitNote.Currency?.CurrencyCode ?? companyBaseCurrency)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        outline: none;
        transition: all 0.2s;
        color: #0f172a;
        background-color: #fff;
    }

        .input-class:focus {
            border-color: #e11d48;
            box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.15);
        }

        .input-class:disabled {
            background-color: #f8fafc;
            color: #94a3b8;
            cursor: not-allowed;
        }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }

    private Guid currentCompanyId = Guid.Empty;
    private string currentUserId = "";
    private string companyBaseCurrency = "BASE";
    private bool isLoading = true;
    private bool isBusy = false;
    private bool isCreateMode = false;
    private bool _loadingInvoices = false;
    private string _errMsg = string.Empty;

    private Guid selectedVendorId = Guid.Empty;
    private Guid selectedInvoiceId = Guid.Empty;

    private DebitNoteModel? currentDebitNote;
    private List<DebitNoteModel> allDebitNotes = new();
    private List<PurchaseOrder> eligibleInvoices = new();
    private List<Vendor> vendors = new();

    private int pageSize = 15;
    private int currentPage = 1;
    private string listSearchTerm = "";

    // View State Selectors
    private bool IsListMode => !Id.HasValue && !isCreateMode && currentDebitNote == null;
    private bool IsNewInitialization => isCreateMode && currentDebitNote == null;
    private bool IsPosted => currentDebitNote?.Status == DebitNoteStatus.Posted;

    private IEnumerable<DebitNoteModel> FilteredDebitNotes => allDebitNotes
        .Where(d => string.IsNullOrWhiteSpace(listSearchTerm)
                 || d.DebitNoteNumber.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)
                 || (d.Vendor?.Name != null && d.Vendor.Name.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase))
                 || (d.PurchaseOrder?.OrderNumber != null && d.PurchaseOrder.OrderNumber.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)));

    private int TotalFilteredCount => FilteredDebitNotes.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalFilteredCount / (double)pageSize));
    private IEnumerable<DebitNoteModel> PaginatedDebitNotes => FilteredDebitNotes.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;

            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null)
            {
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }

            vendors = await MasterService.GetVendorsAsync(currentCompanyId);

            await LoadListGrid();

            if (Id.HasValue)
            {
                await LoadExistingNote(Id.Value);
            }
        }
        isLoading = false;
    }

    private async Task LoadListGrid()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        allDebitNotes = await ctx.DebitNotes
            .AsNoTracking()
            .Include(d => d.Vendor)
            .Include(d => d.PurchaseOrder)
            .Include(d => d.Currency)
            .Where(d => d.CompanyId == currentCompanyId)
            .OrderByDescending(d => d.Date)
            .ToListAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (isLoading) return;

        if (Id.HasValue && (currentDebitNote == null || currentDebitNote.Id != Id.Value))
        {
            await LoadExistingNote(Id.Value);
        }
        else if (!Id.HasValue && currentDebitNote != null && !isCreateMode)
        {
            currentDebitNote = null;
            selectedVendorId = Guid.Empty;
            selectedInvoiceId = Guid.Empty;
        }
    }

    private async Task LoadExistingNote(Guid noteId)
    {
        isBusy = true;
        currentDebitNote = await DebitService.GetByIdAsync(noteId, currentCompanyId);

        if (currentDebitNote != null)
        {
            isCreateMode = false;
            selectedVendorId = currentDebitNote.VendorId;
            selectedInvoiceId = currentDebitNote.PurchaseOrderId ?? Guid.Empty;
        }
        else
        {
            NavigateToListView();
        }

        isBusy = false;
        StateHasChanged();
    }

    private async Task OnVendorSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var venId) && venId != Guid.Empty)
        {
            selectedVendorId = venId;
            await LoadEligibleInvoices();
        }
        else
        {
            selectedVendorId = Guid.Empty;
            eligibleInvoices.Clear();
        }
    }

    private async Task LoadEligibleInvoices()
    {
        _loadingInvoices = true;
        StateHasChanged();

        eligibleInvoices = await DebitService.GetInvoicesEligibleForAdjustmentAsync(currentCompanyId, selectedVendorId);

        _loadingInvoices = false;
        StateHasChanged();
    }

    private async Task CreateDebitNoteWorkspace()
    {
        if (selectedInvoiceId == Guid.Empty) return;
        isBusy = true;
        _errMsg = string.Empty;

        try
        {
            Guid parsedUserId = Guid.TryParse(currentUserId, out var uid) ? uid : Guid.Empty;

            currentDebitNote = await DebitService.CreateStockAdjustmentDraftAsync(selectedInvoiceId, parsedUserId);

            if (currentDebitNote != null)
            {
                currentDebitNote = await DebitService.GetByIdAsync(currentDebitNote.Id, currentCompanyId);
                isCreateMode = false;
            }
        }
        catch (Exception ex)
        {
            _errMsg = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ValidateLineQty(DebitNoteLineModel line, string? val)
    {
        if (decimal.TryParse(val, out var parsed))
        {
            if (parsed < 0) line.Quantity = 0;
            else if (parsed > line.MaxReturnableQty) line.Quantity = line.MaxReturnableQty;
            else line.Quantity = parsed;
        }
        else
        {
            line.Quantity = 0;
        }
    }

    private async Task SaveDraftWorkspace()
    {
        if (currentDebitNote == null) return;

        isBusy = true;
        string err = await DebitService.SaveDraftAsync(currentDebitNote);
        isBusy = false;

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Draft workspace parameters saved securely.");
            await LoadListGrid();
            NavigateToListView();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task PostStockDebitNote()
    {
        if (currentDebitNote == null) return;

        decimal draftTotal = currentDebitNote.Lines.Sum(l => l.Quantity * l.UnitCost);
        if (draftTotal <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Validation Failed: No item quantities have been assigned to generate a ledger debit impact.");
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", "This operation will permanently adjust Accounts Payable and Expense/Cost ledgers. Proceed?")) return;

        isBusy = true;
        await DebitService.SaveDraftAsync(currentDebitNote);

        Guid parsedUserId = Guid.TryParse(currentUserId, out var uid) ? uid : Guid.Empty;
        string err = await DebitService.PostStockDebitNoteAsync(currentDebitNote.Id, parsedUserId);
        isBusy = false;

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Debit Note successfully posted and locked in the General Ledger.");
            await LoadListGrid();
            NavigateToListView();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task DeleteDraft()
    {
        if (currentDebitNote == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Permanently discard this draft workspace?")) return;

        string err = await DebitService.DeleteDraftAsync(currentDebitNote.Id);
        if (string.IsNullOrEmpty(err))
        {
            await LoadListGrid();
            NavigateToListView();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private void RouteToTargetNote(Guid noteId)
    {
        Nav.NavigateTo($"/ap/debit-note/entry/{noteId}");
    }

    private void NavigateToListView()
    {
        currentDebitNote = null;
        isCreateMode = false;
        selectedVendorId = Guid.Empty;
        selectedInvoiceId = Guid.Empty;
        _errMsg = string.Empty;

        if (Id.HasValue)
        {
            Nav.NavigateTo("/ap/debit-note");
        }
    }

    private void OpenNewFormInitializer()
    {
        currentDebitNote = null;
        isCreateMode = true;
        selectedVendorId = Guid.Empty;
        selectedInvoiceId = Guid.Empty;
        eligibleInvoices.Clear();
        _errMsg = string.Empty;
    }
}