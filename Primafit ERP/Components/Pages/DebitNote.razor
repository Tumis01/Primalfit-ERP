@page "/ap/debit-note"
@page "/ap/debit-note/entry/{Id:guid?}"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject CurrencyService CurrService
@inject CompanyApiService CompanyService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:px-6 lg:px-8 animate-in fade-in duration-500 font-sans text-slate-800">

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 pb-4 border-b border-slate-200">
        <div class="space-y-1">
            <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
                @if (IsListMode)
                {
                    <span>Purchase Debit Notes Ledger</span>
                }
                else if (IsNewInitialization)
                {
                    <span>Initialize Supplier Cash Refund</span>
                }
                else
                {
                    <span>Debit Note: @customReferenceInput</span>
                }
            </h1>
            <p class="text-sm font-medium @(IsPosted ? "text-emerald-600" : "text-amber-600")">
                @if (IsListMode)
                {
                    <span class="text-slate-500">Review, track, and manage historical outgoing banking recovery adjustments.</span>
                }
                else if (IsPosted)
                {
                    <span>● Posted Financial Document - Read Only</span>
                }
                else
                {
                    <span>● Draft Debit Note - Pending Ledger Posting</span>
                }
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            @if (!IsListMode)
            {
                <button type="button" @onclick="NavigateToListView"
                        class="px-5 py-2.5 bg-white border border-slate-200 rounded-xl text-sm text-slate-600 font-bold hover:bg-slate-50 transition-all shadow-sm active:scale-95 animate-in fade-in duration-200">
                    Cancel & Back to List
                </button>
            }

            @if (IsListMode)
            {
                <PermissionGate Key="AP_PAYMENT_PAGE">
                    <Authorized>
                        <button type="button" @onclick="OpenNewFormInitializer" class="px-5 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 shadow-md transition-all active:scale-95 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                            <span>New Debit Note</span>
                        </button>
                    </Authorized>
                </PermissionGate>
            }
            else if (!IsPosted && !IsNewInitialization)
            {
                <PermissionGate Key="AP_PAYMENT_PAGE">
                    <Authorized>
                        <button type="button" @onclick="DeleteDraft" class="px-5 py-2.5 bg-white border border-slate-200 text-rose-600 text-sm font-bold rounded-xl hover:bg-rose-50 transition-colors shadow-sm active:scale-95">
                            Delete Draft
                        </button>
                        <button type="button" @onclick="SaveDraftWorkspace" class="px-5 py-2.5 bg-white border border-slate-200 text-indigo-600 text-sm font-bold rounded-xl hover:bg-indigo-50 transition-colors shadow-sm active:scale-95">
                            Save Draft
                        </button>
                    </Authorized>
                </PermissionGate>
                <button type="button" @onclick="PostDebitNoteAdjustment" class="px-6 py-2.5 bg-rose-600 text-white rounded-xl text-sm font-bold hover:bg-rose-700 shadow-md transition-all active:scale-95 flex items-center gap-2">
                    Post Debit Note
                </button>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading debit note workspace context configuration...
        </div>
    }
    else if (currentCompanyId != Guid.Empty)
    {
        @if (IsListMode)
        {
            <div class="space-y-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="relative w-full sm:w-80">
                        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        <input type="text" @bind="listSearchTerm" @bind:event="oninput" placeholder="Search reference, bill hash..." class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm font-medium outline-none focus:border-rose-500 transition-all" />
                    </div>
                    <div class="text-xs text-slate-400 font-medium italic">Displaying financial banking recoveries without stock updates.</div>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                                <tr>
                                    <th class="px-6 py-4">Document Ref</th>
                                    <th class="px-6 py-4">Execution Date</th>
                                    <th class="px-6 py-4">Vendor Partner</th>
                                    <th class="px-6 py-4">Settled Invoice Link</th>
                                    <th class="px-6 py-4">Refunding Bank Account</th>
                                    <th class="px-6 py-4 text-center">Status</th>
                                    <th class="px-6 py-4 text-right">Refund Amount (Foreign)</th>
                                    <th class="px-6 py-4 text-right pr-8">Refund Amount (Base)</th>
                                    <th class="px-6 py-4 text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 font-medium text-slate-700">
                                @foreach (var rev in PaginatedReversals)
                                {
                                    <tr class="hover:bg-slate-50/60 transition-colors">
                                        <td class="px-6 py-4 font-mono font-bold text-slate-900">@rev.Reference</td>
                                        <td class="px-6 py-4 text-slate-500 font-medium">@rev.Date.ToString("yyyy-MM-dd")</td>
                                        <td class="px-6 py-4 font-bold text-slate-900">@rev.VendorName</td>
                                        <td class="px-6 py-4"><span class="text-xs font-mono font-bold bg-slate-100 text-slate-600 px-2 py-1 rounded-md border border-slate-200">@rev.BillRef</span></td>
                                        <td class="px-6 py-4 text-xs text-slate-600">@rev.GlAccountDescription</td>
                                        <td class="px-6 py-4 text-center">
                                            @if (rev.IsPosted)
                                            {
                                                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 border border-emerald-200 px-2.5 py-1 text-[10px] font-bold text-emerald-700 uppercase tracking-wider">Posted</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase tracking-wider">Draft</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right font-mono font-bold text-slate-700">
                                            <span>@rev.AmountForeign.ToString("N2")</span>
                                            <span class="text-[9px] text-slate-400 font-bold uppercase ml-1">@rev.CurrencyCode</span>
                                        </td>
                                        <td class="px-6 py-4 text-right font-mono font-black text-rose-600 pr-8">
                                            <span>@rev.AmountBase.ToString("N2")</span>
                                            <span class="text-[9px] text-slate-400 font-bold uppercase ml-1">@companyBaseCurrency</span>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <button type="button" @onclick="() => RouteToTargetAdjustment(rev.PaymentId)" class="inline-flex items-center justify-center rounded-lg px-4 py-1.5 text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors">
                                                @(rev.IsPosted ? "View Details" : "Edit Draft")
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (!PaginatedReversals.Any())
                                {
                                    <tr><td colspan="9" class="p-16 text-center text-slate-400 font-medium">No payment reversals recorded inside this ledger cycle partition.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-4 bg-slate-50 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-bold text-slate-500">
                        <div>Showing @((currentPage - 1) * pageSize + 1) to @Math.Min(currentPage * pageSize, TotalFilteredCount) of @TotalFilteredCount items</div>
                        <div class="flex items-center gap-2">
                            <button type="button" @onclick="() => { if (currentPage > 1) currentPage--; }" disabled="@(currentPage == 1)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40">Previous</button>
                            <span class="px-3 font-semibold text-slate-700">Page @currentPage of @TotalPages</span>
                            <button type="button" @onclick="() => { if (currentPage < TotalPages) currentPage++; }" disabled="@(currentPage == TotalPages || TotalPages == 0)" class="px-3 py-1.5 bg-white border border-slate-200 rounded-lg hover:bg-slate-100 disabled:opacity-40">Next</button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (IsNewInitialization)
        {
            <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-sm max-w-xl mx-auto mt-6 space-y-6 overflow-visible relative">
                <h3 class="text-lg font-bold text-slate-900 text-center">Initialize Refund Voucher</h3>

                <div class="relative overflow-visible z-50">
                    <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Step 1: Select Vendor Partner Target <span class="text-rose-500">*</span></label>
                    <div @onclick="ToggleVendorDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none">
                        <span class="@(selectedVendorId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">@selectedVendorName</span>
                        <svg class="w-4 h-4 text-slate-400 transition-transform @(isVendorDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                    </div>

                    @if (isVendorDropdownOpen)
                    {
                        <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl p-3 space-y-3 z-[100] animate-in fade-in zoom-in-95 duration-100">
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                </div>
                                <input type="text" @bind="vendorSearchQuery" @bind:event="oninput" class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-rose-500 focus:bg-white transition-all font-medium text-slate-800" placeholder="Filter vendor partners..." @onclick:stopPropagation />
                            </div>
                            <div class="max-h-48 overflow-y-auto pr-1 divide-y divide-slate-50">
                                @foreach (var ven in vendors.Where(v => v.Name.Contains(vendorSearchQuery, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <div @onclick="() => SelectVendor(ven)" @onclick:stopPropagation class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-rose-50 hover:text-rose-900 rounded-lg transition-colors cursor-pointer">@ven.Name</div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (selectedVendorId != Guid.Empty)
                {
                    <div class="relative animate-in fade-in duration-300 z-40">
                        <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">Step 2: Choose Settled Supplier Invoice <span class="text-rose-500">*</span></label>
                        <div @onclick="ToggleBillDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none">
                            <span class="@(selectedBillId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">@selectedBillName</span>
                            <svg class="w-4 h-4 text-slate-400 transition-transform @(isBillDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                        </div>

                        @if (isBillDropdownOpen)
                        {
                            <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl p-3 space-y-3 z-[100] animate-in fade-in zoom-in-95 duration-100">
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                    </div>
                                    <input type="text" @bind="billSearchQuery" @bind:event="oninput" class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-rose-500 focus:bg-white transition-all font-medium text-slate-800" placeholder="Search by Invoice Number..." @onclick:stopPropagation />
                                </div>
                                <div class="max-h-48 overflow-y-auto pr-1 divide-y divide-slate-50">
                                    @foreach (var bill in openBills.Where(b => b.RefNumber.Contains(billSearchQuery, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <div @onclick="() => SelectBillItem(bill)" @onclick:stopPropagation class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-rose-50 hover:text-rose-900 rounded-lg transition-colors cursor-pointer flex justify-between">
                                            <span>@bill.RefNumber</span>
                                            <span class="text-slate-400 font-mono">Refundable: @bill.RemainingRefundableForeign.ToString("N2")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (_loadingInvoices)
                        {
                            <p class="text-xs text-rose-600 font-bold mt-2 animate-pulse">Aggregating historical payment allocations...</p>
                        }
                    </div>
                }

                <button type="button" @onclick="InitializeDraftWorkspace" disabled="@(isBusy || selectedBillId == Guid.Empty)" class="w-full px-6 py-3.5 bg-slate-900 text-white rounded-xl font-bold text-sm hover:bg-slate-800 shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-40">
                    @if (isBusy)
                    {
                        <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                    }
                    <span>Open Form Workspace</span>
                </button>
                @if (!string.IsNullOrEmpty(_errMsg))
                {
                    <div class="p-4 bg-rose-50 border border-rose-100 text-rose-700 text-xs font-bold rounded-xl">@_errMsg</div>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 relative z-10 overflow-visible">

                <div class="lg:col-span-4 space-y-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5 overflow-visible relative">
                        <h3 class="font-extrabold text-xs text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-3">Operational Parameters</h3>

                        <div>
                            <label class="label">Date of Recovery</label>
                            <input type="date" value="@targetReversalDate.ToString("yyyy-MM-dd")" @onchange="@(e => { if (DateTime.TryParse(e.Value?.ToString(), out var d)) targetReversalDate = d; })" class="input-class font-bold text-slate-800" disabled="@IsPosted" />
                        </div>

                        <div>
                            <label class="label text-slate-500">Vendor Partner</label>
                            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800">
                                @(vendors.FirstOrDefault(v => v.Id == selectedVendorId)?.Name ?? "Loaded Supplier Master Profile")
                            </div>
                        </div>

                        <div>
                            <label class="label text-slate-500">Original Invoice Link</label>
                            <div class="font-mono bg-slate-50 p-3 rounded-xl border border-slate-200 text-sm font-bold text-slate-800">
                                @(SelectedBillRow?.RefNumber ?? "Direct Reversal Tracking")
                            </div>
                        </div>

                        <div>
                            <label class="label">Debit Note Reference Code</label>
                            <input type="text" @bind="customReferenceInput" class="input-class font-mono font-bold" placeholder="Auto-Generated Reference ID" disabled />
                        </div>

                        <div class="relative overflow-visible z-50">
                            <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-1.5">Bank Account Target (Inflow) <span class="text-rose-500">*</span></label>
                            <div @onclick="ToggleBankDropdown" class="w-full p-3 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white shadow-sm hover:border-slate-300 transition-all flex items-center justify-between cursor-pointer select-none @(IsPosted ? "bg-slate-50 opacity-60 cursor-not-allowed" : "")">
                                <span class="@(targetBankGlAccountId == Guid.Empty ? "text-slate-400 font-medium" : "text-slate-900")">@selectedBankGlName</span>
                                @if (!IsPosted)
                                {
                                    <svg class="w-4 h-4 text-slate-400 transition-transform @(isBankDropdownOpen ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" /></svg>
                                }
                            </div>

                            @if (isBankDropdownOpen && !IsPosted)
                            {
                                <div class="absolute w-full mt-2 bg-white border border-slate-200 rounded-2xl shadow-xl p-3 space-y-3 z-[100] animate-in fade-in zoom-in-95 duration-100">
                                    <div class="relative">
                                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                                        </div>
                                        <input type="text" @bind="bankSearchQuery" @bind:event="oninput" class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-rose-500 focus:bg-white transition-all font-medium text-slate-800" placeholder="Filter cash accounts..." @onclick:stopPropagation />
                                    </div>
                                    <div class="max-h-40 overflow-y-auto pr-1 divide-y divide-slate-50">
                                        @foreach (var bank in bankAccounts.Where(b => $"{b.AccountCode} {b.Description}".Contains(bankSearchQuery, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <div @onclick="() => SelectBankAccount(bank)" @onclick:stopPropagation class="px-2.5 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 rounded-lg transition-colors cursor-pointer">
                                                @bank.AccountCode - @bank.Description
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-8 overflow-visible">
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden h-full flex flex-col min-h-[550px]">
                        @if (SelectedBillRow != null)
                        {
                            <div class="p-6 border-b border-slate-100 bg-slate-50/50">
                                <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-4">
                                    AP Exposure Matrix Verification: <span class="text-rose-600 font-mono ml-2">@SelectedBillRow.RefNumber</span> (@currencySymbol)
                                </h3>
                                <div class="grid grid-cols-3 gap-4">
                                    <div class="bg-white border border-slate-200 p-4 rounded-xl text-center shadow-sm">
                                        <div class="text-[10px] text-slate-500 uppercase font-bold mb-1">Total Bill Balance</div>
                                        <div class="text-xl font-mono font-bold text-slate-900">@SelectedBillRow.TotalForeign.ToString("N2")</div>
                                    </div>
                                    <div class="bg-emerald-50 border border-emerald-200 p-4 rounded-xl text-center shadow-sm">
                                        <div class="text-[10px] text-emerald-700 uppercase font-bold mb-1">Historical Cash Paid</div>
                                        <div class="text-xl font-mono font-black text-emerald-700">@SelectedBillRow.TotalPaidForeign.ToString("N2")</div>
                                    </div>

                                    <div class="bg-rose-50 border border-rose-200 p-4 rounded-xl text-center shadow-sm">
                                        <div class="text-[10px] text-rose-700 uppercase font-bold mb-1">Remaining Refundable</div>
                                        <div class="text-xl font-mono font-black text-rose-700">@SelectedBillRow.RemainingRefundableForeign.ToString("N2")</div>
                                    </div>

                                </div>
                            </div>

                            <div class="overflow-x-auto flex-1 p-6">
                                <table class="w-full text-left text-sm border border-slate-200 rounded-lg overflow-hidden">
                                    <thead class="text-[10px] uppercase font-extrabold text-slate-500 bg-slate-50 border-b border-slate-200 tracking-wider">
                                        <tr>
                                            <th class="px-4 py-3">Purchase Item / Service Segment</th>
                                            <th class="px-4 py-3 text-center">Billed Quantity</th>
                                            <th class="px-4 py-3 text-right">Unit Settlement Cost (@currencySymbol)</th>
                                            <th class="px-4 py-3 text-right pr-6">Line Valuation Gross (@currencySymbol)</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        @foreach (var line in SelectedBillRow.Lines)
                                        {
                                            <tr class="bg-white">
                                                <td class="px-4 py-3 font-medium text-slate-800">@(items.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? "Ad-Hoc Procurement Expense Line")</td>
                                                <td class="px-4 py-3 text-center font-mono text-slate-600">@line.QuantityBilled.ToString("N2")</td>
                                                <td class="px-4 py-3 text-right font-mono text-slate-500">@line.UnitCostBilled.ToString("N2")</td>
                                                <td class="px-4 py-3 pr-6 text-right font-mono font-semibold text-slate-700">@((line.QuantityBilled * line.UnitCostBilled).ToString("N2"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="border border-slate-100 rounded-2xl p-5 bg-slate-50/30 space-y-4 max-w-xl mx-6 mb-6">
                                <h4 class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest border-b border-slate-100 pb-2">Voucher Recovery Allocation</h4>

                                @if (SelectedBillRow.ExchangeRate == 1)
                                {
                                    <div class="space-y-2">
                                        <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">Refund Cash Value Amount</label>
                                        <div class="relative bg-white border border-slate-200 rounded-2xl focus-within:ring-2 focus-within:ring-rose-900/10 transition-all duration-200">
                                            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                                                <span class="text-xs font-black text-slate-300 font-mono uppercase tracking-wider">@currencySymbol</span>
                                            </div>
                                            <input type="number" step="0.01" max="@SelectedBillRow.RemainingRefundableForeign"
                                                   value="@amountToReverseForeign"
                                                   @oninput="CalculateFromForeignInput"
                                                   disabled="@IsPosted"
                                                   class="w-full bg-transparent pl-16 pr-4 py-3.5 font-mono font-black text-rose-700 text-right text-lg outline-none placeholder:text-slate-300 disabled:opacity-50 disabled:cursor-not-allowed"
                                                   placeholder="0.00" />
                                        </div>
                                        <p class="text-[10px] text-slate-400 font-medium px-1">
                                            Max refundable: <span class="font-mono font-bold text-slate-600">@((SelectedBillRow?.RemainingRefundableForeign ?? 0).ToString("N2"))</span>
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-3">
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                            <div class="space-y-2">
                                                <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">Foreign Amount</label>
                                                <div class="relative bg-white border border-slate-200 rounded-2xl focus-within:ring-2 focus-within:ring-rose-900/10 transition-all duration-200">
                                                    <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                                                        <span class="text-[10px] font-black text-slate-300 font-mono uppercase tracking-wider">@currencySymbol</span>
                                                    </div>
                                                    <input type="number" step="0.01"
                                                           value="@(amountToReverseForeign == 0 ? "" : amountToReverseForeign)"
                                                           @oninput="CalculateFromForeignInput"
                                                           disabled="@IsPosted"
                                                           class="w-full bg-transparent pl-16 pr-4 py-3.5 font-mono font-black text-rose-700 text-right text-lg outline-none placeholder:text-slate-300 disabled:opacity-50"
                                                           placeholder="0.00" />
                                                </div>
                                            </div>
                                            <div class="space-y-2">
                                                <label class="block text-[10px] font-extrabold text-slate-400 uppercase tracking-widest">Base Currency Impact</label>
                                                <div class="relative bg-white border border-slate-200 rounded-2xl focus-within:ring-2 focus-within:ring-rose-900/10 transition-all duration-200">
                                                    <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none">
                                                        <span class="text-[10px] font-black text-slate-300 font-mono uppercase tracking-wider">Base</span>
                                                    </div>
                                                    <input type="number" step="0.01"
                                                           value="@(baseCurrencyRefundDisplayValue == 0 ? "" : baseCurrencyRefundDisplayValue)"
                                                           @oninput="CalculateFromBaseInput"
                                                           disabled="@IsPosted"
                                                           class="w-full bg-transparent pl-14 pr-4 py-3.5 font-mono font-black text-slate-900 text-right text-lg outline-none placeholder:text-slate-300 disabled:opacity-50"
                                                           placeholder="0.00" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="flex items-center justify-between px-1">
                                            <p class="text-[10px] text-slate-400 font-medium">
                                                Max refundable: <span class="font-mono font-bold text-slate-600">@SelectedBillRow.RemainingRefundableForeign.ToString("N2") @currencySymbol</span>
                                            </p>
                                            <div class="flex items-center gap-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                                                <span class="w-1 h-1 rounded-full bg-slate-300 inline-block"></span>
                                                Rate <span class="font-mono text-slate-600">@SelectedBillRow.ExchangeRate.ToString("N4")</span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="border-t border-slate-200 bg-rose-50/50 p-5 flex justify-between items-center mt-auto rounded-b-2xl gap-6">
                                <div class="text-right ml-auto">
                                    <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-0.5">Total Ledger Inflow Value (Base Currency)</div>
                                    <div class="text-2xl font-mono font-black text-emerald-700">
                                        @((amountToReverseForeign * (SelectedBillRow?.ExchangeRate ?? 1m)).ToString("N2")) <span class="text-sm font-sans font-bold text-slate-400">@companyBaseCurrency</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
@code {
    [Parameter] public Guid? Id { get; set; }
    [Parameter] public Guid? RouteBillId { get; set; }

    private int activeTab = 0;
    private Guid currentCompanyId = Guid.Empty;
    private string companyName = "";
    private string currencySymbol = "";
    private string companyBaseCurrency = "BASE";

    private bool isLoading = true;
    private bool isBusy = false;
    private bool _isFormWorkspaceOpen = false;

    // Fixed Context Parameter Variables
    private DateTime targetReversalDate = DateTime.Today;
    private Guid selectedVendorId = Guid.Empty;
    private Guid selectedBillId = Guid.Empty;
    private string customReferenceInput = "";
    private decimal amountToReverseForeign = 0;
    private Guid targetBankGlAccountId = Guid.Empty;

    // Dropdown / UI state
    private bool _loadingList = true;
    private bool _loadingInvoices = false;
    private string selectedBankGlName = "-- Search Bank Account --";
    private string selectedVendorName = "-- Choose Target Vendor Partner --";
    private string selectedBillName = "-- Choose Settled Supplier Invoice --";

    private bool isVendorDropdownOpen = false;
    private string vendorSearchQuery = string.Empty;
    private bool isBillDropdownOpen = false;
    private string billSearchQuery = string.Empty;
    private bool isBankDropdownOpen = false;
    private string bankSearchQuery = string.Empty;
    private string currentUserId = "";
    private string _errMsg = string.Empty;

    // Repositories
    private List<Vendor> vendors = new();
    private List<Currency> currencies = new();
    private List<Item> items = new();
    private List<SegChartOfAccount> allAccounts = new();
    private List<SegChartOfAccount> bankAccounts = new();
    private List<SegAccountType> accountTypes = new();

    private int pageSize = 15;
    private int currentPage = 1;
    private string listSearchTerm = "";
    private decimal baseCurrencyRefundDisplayValue = 0;

    public class LocalBillRow
    {
        public Guid BillId { get; set; }
        public string RefNumber { get; set; } = "";
        public decimal TotalForeign { get; set; }

        // Total actually paid (positive posted payments only — no drafts, no reversals)
        public decimal TotalPaidForeign { get; set; }

        // Net ceiling: TotalPaidForeign minus already-posted debit note reversals
        public decimal RemainingRefundableForeign { get; set; }

        public decimal ExchangeRate { get; set; }
        public Guid CurrencyId { get; set; }
        public List<VendorBillLine> Lines { get; set; } = new();
    }

    public class LocalReversalRow
    {
        public Guid PaymentId { get; set; }
        public DateTime Date { get; set; }
        public string Reference { get; set; } = "";
        public string BillRef { get; set; } = "";
        public string VendorName { get; set; } = "";
        public string GlAccountDescription { get; set; } = "";
        public decimal Amount { get; set; }
        public decimal AmountForeign { get; set; }
        public decimal AmountBase { get; set; }
        public string CurrencyCode { get; set; } = "BASE";
        public bool IsPosted { get; set; }
    }

    private List<LocalBillRow> openBills = new();
    private List<LocalReversalRow> historicalReversals = new();

    private LocalBillRow? SelectedBillRow => openBills.FirstOrDefault(b => b.BillId == selectedBillId);
    private int TotalFilteredCount => FilteredReversals.Count();

    // View-state selectors
    private bool IsListMode => !Id.HasValue && !_isFormWorkspaceOpen;
    private bool IsNewInitialization => !Id.HasValue && _isFormWorkspaceOpen && selectedBillId == Guid.Empty;
    private bool IsPosted => !isLoading && !IsListMode && currentPaymentId != Guid.Empty && !IsDraftRecord;
    private bool IsDraftRecord = false;

    private Guid currentPaymentId = Guid.Empty;

    private IEnumerable<LocalReversalRow> FilteredReversals => historicalReversals
        .Where(r => string.IsNullOrWhiteSpace(listSearchTerm)
                 || r.Reference.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)
                 || r.BillRef.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase)
                 || r.VendorName.Contains(listSearchTerm, StringComparison.OrdinalIgnoreCase));

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredReversals.Count() / (double)pageSize));
    private IEnumerable<LocalReversalRow> PaginatedReversals =>
        FilteredReversals.Skip((currentPage - 1) * pageSize).Take(pageSize);

    // ─────────────────────────────────────────────────────────────────────────
    // LIFECYCLE
    // ─────────────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;

            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null)
            {
                companyName = company.CompanyName;
                companyBaseCurrency = company.BaseCurrency ?? "BASE";
            }

            vendors = await MasterService.GetVendorsAsync(currentCompanyId);
            currencies = await CurrService.GetCurrenciesAsync(currentCompanyId);
            items = await MasterService.GetItemsAsync(currentCompanyId);
            accountTypes = await SegCoaService.GetAccountTypesAsync();
            allAccounts = await SegCoaService.GetCoaAsync(currentCompanyId);

            bankAccounts = allAccounts.Where(a =>
            {
                var type = accountTypes.FirstOrDefault(t => t.Id == a.SegAccountTypeId);
                return type != null && type.IsBalanceSheet == true && type.IsDebit == true && type.Id == 1 && a.IsActive;
            }).OrderBy(x => x.AccountCode).ToList();

            await LoadHistoricalReversalsGrid();

            // Load payment record only after all repositories are ready
            if (Id.HasValue)
                await LoadFromExistingPayment(Id.Value);
        }

        isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Guard: OnInitializedAsync handles the first load; this only fires on
        // subsequent soft-nav parameter changes (no forceLoad).
        if (isLoading) return;

        if (Id.HasValue && currentPaymentId != Id.Value)
            await LoadFromExistingPayment(Id.Value);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // LOAD EXISTING PAYMENT
    // Shared by both lifecycle hooks — always runs after repositories are ready.
    // ─────────────────────────────────────────────────────────────────────────
    private async Task LoadFromExistingPayment(Guid paymentId)
    {
        _isFormWorkspaceOpen = true;
        currentPaymentId = paymentId;

        using var ctx = await DbFactory.CreateDbContextAsync();

        var paymentRow = await ctx.VendorPayments
            .Include(p => p.VendorBill)
            .FirstOrDefaultAsync(p => p.Id == paymentId);

        if (paymentRow == null || paymentRow.VendorBill == null)
        {
            _errMsg = "The requested debit note record could not be found.";
            ResetFormStateContainers();
            return;
        }

        selectedVendorId = paymentRow.VendorBill.VendorId;
        selectedBillId = paymentRow.VendorBillId;
        targetReversalDate = paymentRow.Date;

        IsDraftRecord = paymentRow.Reference.StartsWith("DRAFT-", StringComparison.OrdinalIgnoreCase);

        var vendorObj = vendors.FirstOrDefault(v => v.Id == selectedVendorId);
        if (vendorObj != null) selectedVendorName = vendorObj.Name;

        // forCreation: false — load ALL bills with real payments, including fully
        // reversed ones, so SelectedBillRow can always resolve for view/edit.
        await LoadVendorBills(selectedVendorId, forCreation: false);

        decimal rate = paymentRow.VendorBill.ExchangeRate > 0 ? paymentRow.VendorBill.ExchangeRate : 1.0m;
        baseCurrencyRefundDisplayValue = Math.Abs(paymentRow.Amount);
        amountToReverseForeign = Math.Round(baseCurrencyRefundDisplayValue / rate, 2);

        customReferenceInput = IsDraftRecord
            ? paymentRow.Reference.Substring(6)
            : paymentRow.Reference;

        targetBankGlAccountId = paymentRow.BankGlAccountId;

        SyncBillSelectionMetrics();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // NAVIGATION
    // ─────────────────────────────────────────────────────────────────────────

    private void SetActiveTab(int tabIndex)
    {
        activeTab = tabIndex;
        _isFormWorkspaceOpen = (tabIndex == 1);
        if (tabIndex == 0) ResetFormStateContainers();
    }

    private void NavigateToListView()
    {
        ResetFormStateContainers();
        SetActiveTab(0);
        if (Id.HasValue)
            Nav.NavigateTo("/ap/debit-note");
    }

    private void OpenNewFormInitializer() => SetActiveTab(1);

    private void ToggleVendorDropdown() => isVendorDropdownOpen = !isVendorDropdownOpen;
    private void ToggleBillDropdown() => isBillDropdownOpen = !isBillDropdownOpen;
    private void ToggleBankDropdown() => isBankDropdownOpen = !isBankDropdownOpen;

    // ─────────────────────────────────────────────────────────────────────────
    // DROPDOWN SELECTION HANDLERS
    // ─────────────────────────────────────────────────────────────────────────

    private async Task SelectVendor(Vendor ven)
    {
        selectedVendorId = ven.Id;
        selectedVendorName = ven.Name;
        isVendorDropdownOpen = false;
        vendorSearchQuery = string.Empty;
        selectedBillId = Guid.Empty;
        selectedBillName = "-- Choose Settled Supplier Invoice --";
        openBills.Clear();

        _loadingInvoices = true;
        StateHasChanged();
        // forCreation: true — exclude exhausted bills from the new-note dropdown
        await LoadVendorBills(selectedVendorId, forCreation: true);
        _loadingInvoices = false;
        StateHasChanged();
    }

    private void SelectBillItem(LocalBillRow bill)
    {
        selectedBillId = bill.BillId;
        // Show the remaining refundable in the dropdown label so the user
        // immediately knows the net ceiling before opening the workspace.
        selectedBillName = $"{bill.RefNumber} (Refundable: {bill.RemainingRefundableForeign:N2})";
        isBillDropdownOpen = false;
        billSearchQuery = string.Empty;
        SyncBillSelectionMetrics();
    }

    private void SelectBankAccount(SegChartOfAccount bank)
    {
        targetBankGlAccountId = bank.Id;
        selectedBankGlName = $"{bank.AccountCode} - {bank.Description}";
        isBankDropdownOpen = false;
        bankSearchQuery = string.Empty;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // INITIALIZE WORKSPACE
    // ─────────────────────────────────────────────────────────────────────────
    private async Task InitializeDraftWorkspace()
    {
        if (selectedVendorId == Guid.Empty)
        {
            _errMsg = "Please select a vendor partner before proceeding.";
            StateHasChanged();
            return;
        }
        if (selectedBillId == Guid.Empty)
        {
            _errMsg = "Please select a settled supplier invoice before opening the workspace.";
            StateHasChanged();
            return;
        }

        isBusy = true;
        _errMsg = string.Empty;
        StateHasChanged();

        // Always reload fresh from the DB at the moment the user opens the workspace.
        // This guarantees RemainingRefundableForeign reflects any reversals posted
        // since the vendor dropdown was first populated — including a first reversal
        // the user just ran moments ago in the same session.
        // Never rely on the cached openBills entry from SelectVendor.
        await LoadVendorBills(selectedVendorId, forCreation: true);

        // After the fresh reload, the selected bill may no longer exist in openBills
        // if it was fully exhausted between vendor selection and workspace open.
        if (SelectedBillRow == null)
        {
            _errMsg = "This invoice has no remaining refundable balance. It may have been fully reversed since you selected it.";
            selectedBillId = Guid.Empty;
            selectedBillName = "-- Choose Settled Supplier Invoice --";
            isBusy = false;
            StateHasChanged();
            return;
        }

        // Reset the amount so SyncBillSelectionMetrics defaults it to the
        // freshly-loaded RemainingRefundableForeign, not a stale cached value.
        amountToReverseForeign = 0;

        SyncBillSelectionMetrics();

        isBusy = false;
        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DATA LOADING
    // ─────────────────────────────────────────────────────────────────────────

    // forCreation = true  → called from the new-debit-note wizard.
    //                        Bills with no remaining refundable are excluded from
    //                        the dropdown so the user can't select an exhausted bill.
    //
    // forCreation = false → called from LoadFromExistingPayment when viewing /
    //                        editing a record that was already saved.
    //                        ALL bills with at least one real payment are included
    //                        regardless of remaining ceiling, so the form can always
    //                        resolve SelectedBillRow and render correctly.
    private async Task LoadVendorBills(Guid vendorId, bool forCreation = true)
    {
        using var ctx = await DbFactory.CreateDbContextAsync();

        var bills = await ctx.VendorBills
            .Include(b => b.Lines)
            .Include(b => b.Payments)
            .Where(b => b.CompanyId == currentCompanyId && b.VendorId == vendorId && b.IsPosted)
            .ToListAsync();

        openBills.Clear();

        foreach (var b in bills)
        {
            decimal rate = b.ExchangeRate > 0 ? b.ExchangeRate : 1m;

            // ── Step 1: Real cash paid ────────────────────────────────────────
            // Only positive, non-draft payments count as genuine cash settled.
            decimal totalPaidBase = b.Payments?
                .Where(p => p.Amount > 0
                         && !p.Reference.StartsWith("DRAFT-", StringComparison.OrdinalIgnoreCase))
                .Sum(p => p.Amount) ?? 0m;

            // No real payment ever made — nothing to show, skip regardless of mode.
            if (totalPaidBase <= 0.01m) continue;

            decimal totalPaidForeign = Math.Round(totalPaidBase / rate, 2);

            // ── Step 2: Already-posted reversals against this bill ────────────
            // Negative, non-draft payments are finalised debit notes.
            // Sum their absolute values to know how much has already been reversed.
            decimal alreadyReversedBase = b.Payments?
                .Where(p => p.Amount < 0
                         && !p.Reference.StartsWith("DRAFT-", StringComparison.OrdinalIgnoreCase))
                .Sum(p => Math.Abs(p.Amount)) ?? 0m;

            decimal alreadyReversedForeign = Math.Round(alreadyReversedBase / rate, 2);

            // ── Step 3: Net remaining refundable ceiling ──────────────────────
            decimal remainingRefundableForeign =
                Math.Max(0m, Math.Round(totalPaidForeign - alreadyReversedForeign, 2));

            // When building the new-creation dropdown, skip bills that have
            // nothing left to refund — there is no point offering them.
            // When loading for view/edit, always include the bill so the form
            // can render the existing record even if the ceiling is now zero.
            if (forCreation && remainingRefundableForeign <= 0.01m) continue;

            openBills.Add(new LocalBillRow
            {
                BillId = b.Id,
                RefNumber = b.ExternalInvoiceNumber,
                TotalForeign = b.TotalAmountForeign,
                TotalPaidForeign = totalPaidForeign,           // raw paid — "Historical Cash Paid" tile
                RemainingRefundableForeign = remainingRefundableForeign, // net ceiling — validations & default amount
                ExchangeRate = rate,
                CurrencyId = b.CurrencyId,
                Lines = b.Lines.ToList()
            });
        }
    }

    private async Task LoadHistoricalReversalsGrid()
    {
        _loadingList = true;
        using var ctx = await DbFactory.CreateDbContextAsync();

        var rawPayments = await ctx.VendorPayments
            .Include(p => p.VendorBill)
            .Where(p => p.Amount < 0
                     && p.VendorBill.CompanyId == currentCompanyId
                     && (p.Reference == null || !p.Reference.ToLower().StartsWith("draft-"))) // <-- FIXED TRANSLATION HERE
            .OrderByDescending(p => p.Date)
            .ToListAsync();

        historicalReversals = rawPayments.Select(p =>
        {
            decimal rate = p.VendorBill?.ExchangeRate > 0 ? p.VendorBill.ExchangeRate : 1.0m;
            bool posted = !p.Reference.StartsWith("DRAFT-", StringComparison.OrdinalIgnoreCase);
            return new LocalReversalRow
            {
                PaymentId = p.Id,
                Date = p.Date,
                Reference = p.Reference,
                BillRef = p.VendorBill?.ExternalInvoiceNumber ?? "DIRECT-EXPENSE",
                VendorName = vendors.FirstOrDefault(v => v.Id == p.VendorBill.VendorId)?.Name ?? "Unknown Supplier",
                GlAccountDescription = allAccounts.FirstOrDefault(a => a.Id == p.BankGlAccountId)?.Description ?? "Liquid Asset Account",
                Amount = p.Amount,
                AmountForeign = Math.Round(Math.Abs(p.Amount) / rate, 2),
                AmountBase = Math.Abs(p.Amount),
                CurrencyCode = currencies.FirstOrDefault(c => c.Id == p.VendorBill.CurrencyId)?.CurrencyCode ?? "Base",
                IsPosted = posted
            };
        }).ToList();

        _loadingList = false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // CALCULATION HELPERS
    // ─────────────────────────────────────────────────────────────────────────

    private void SyncBillSelectionMetrics()
    {
        if (SelectedBillRow == null) return;

        // Default the amount to the net remaining ceiling freshly computed from DB.
        // amountToReverseForeign is reset to 0 before this call in InitializeDraftWorkspace
        // so this always picks up the latest RemainingRefundableForeign after a reload.
        if (amountToReverseForeign == 0)
            amountToReverseForeign = SelectedBillRow.RemainingRefundableForeign;

        if (string.IsNullOrEmpty(customReferenceInput))
            customReferenceInput = $"DN-{DateTime.UtcNow:yyMM}-{Random.Shared.Next(1000, 9999)}";

        currencySymbol = currencies.FirstOrDefault(c => c.Id == SelectedBillRow.CurrencyId)?.CurrencyCode ?? "";
        baseCurrencyRefundDisplayValue = Math.Round(amountToReverseForeign * SelectedBillRow.ExchangeRate, 2);

        // Keep the dropdown label in sync with the freshly-loaded ceiling so it
        // always shows the correct remaining balance, not the stale value from
        // when the user first opened the vendor dropdown.
        selectedBillName = $"{SelectedBillRow.RefNumber} (Refundable: {SelectedBillRow.RemainingRefundableForeign:N2})";

        var matchedBank = bankAccounts.FirstOrDefault(b => b.Id == targetBankGlAccountId);
        selectedBankGlName = matchedBank != null
            ? $"{matchedBank.AccountCode} - {matchedBank.Description}"
            : "-- Search Bank Account --";
    }

    private void CalculateFromForeignInput(ChangeEventArgs e)
    {
        if (SelectedBillRow == null) return;

        if (decimal.TryParse(e.Value?.ToString(), out decimal val) && val > 0)
        {
            // Cap against the net remaining refundable ceiling, not the gross paid total.
            if (val > SelectedBillRow.RemainingRefundableForeign)
            {
                amountToReverseForeign = SelectedBillRow.RemainingRefundableForeign;
                _errMsg = $"Amount capped at the remaining refundable balance: {SelectedBillRow.RemainingRefundableForeign:N2} {currencySymbol}";
            }
            else
            {
                amountToReverseForeign = val;
                _errMsg = string.Empty;
            }

            baseCurrencyRefundDisplayValue = Math.Round(amountToReverseForeign * SelectedBillRow.ExchangeRate, 2);
        }
        else
        {
            amountToReverseForeign = 0;
            baseCurrencyRefundDisplayValue = 0;
            _errMsg = string.Empty;
        }

        StateHasChanged();
    }

    private void CalculateFromBaseInput(ChangeEventArgs e)
    {
        if (SelectedBillRow == null) return;

        if (decimal.TryParse(e.Value?.ToString(), out decimal baseVal) && baseVal > 0)
        {
            decimal maxBase = SelectedBillRow.RemainingRefundableForeign * SelectedBillRow.ExchangeRate;

            if (baseVal > maxBase)
            {
                baseCurrencyRefundDisplayValue = Math.Round(maxBase, 2);
                _errMsg = $"Base amount capped at the remaining refundable equivalent: {maxBase:N2}";
            }
            else
            {
                baseCurrencyRefundDisplayValue = baseVal;
                _errMsg = string.Empty;
            }

            amountToReverseForeign = SelectedBillRow.ExchangeRate > 0
                ? Math.Round(baseCurrencyRefundDisplayValue / SelectedBillRow.ExchangeRate, 4)
                : 0;
        }
        else
        {
            amountToReverseForeign = 0;
            baseCurrencyRefundDisplayValue = 0;
            _errMsg = string.Empty;
        }

        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SAVE / POST / DELETE
    // ─────────────────────────────────────────────────────────────────────────

    private async Task SaveDraftWorkspace()
    {
        if (SelectedBillRow == null)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: Please select an active invoice target first.");
            return;
        }
        if (amountToReverseForeign <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: Refund amount must be greater than zero.");
            return;
        }
        if (amountToReverseForeign > SelectedBillRow.RemainingRefundableForeign)
        {
            await JS.InvokeVoidAsync("alert",
                $"Validation Error: Refund amount ({amountToReverseForeign:N2}) cannot exceed the remaining " +
                $"refundable balance ({SelectedBillRow.RemainingRefundableForeign:N2} {currencySymbol}). " +
                $"Previously reversed: {(SelectedBillRow.TotalPaidForeign - SelectedBillRow.RemainingRefundableForeign):N2} {currencySymbol}.");
            return;
        }
        if (targetBankGlAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: Please select a Bank Account before saving the draft.");
            return;
        }
        if (targetReversalDate == default || targetReversalDate > DateTime.Today)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: Please enter a valid date that is not in the future.");
            return;
        }

        using var ctx = await DbFactory.CreateDbContextAsync();

        string draftRef = customReferenceInput.StartsWith("DRAFT-", StringComparison.OrdinalIgnoreCase)
            ? customReferenceInput
            : $"DRAFT-{customReferenceInput}";

        decimal rate = SelectedBillRow.ExchangeRate > 0 ? SelectedBillRow.ExchangeRate : 1.0m;

        var existingDraft = await ctx.VendorPayments.FirstOrDefaultAsync(p => p.Id == currentPaymentId);

        if (existingDraft == null)
        {
            ctx.VendorPayments.Add(new VendorPayment
            {
                Id = Guid.NewGuid(),
                VendorBillId = selectedBillId,
                Date = targetReversalDate,
                Amount = -Math.Round(amountToReverseForeign * rate, 2),
                BankGlAccountId = targetBankGlAccountId,
                Reference = draftRef
            });
        }
        else
        {
            existingDraft.Date = targetReversalDate;
            existingDraft.Amount = -Math.Round(amountToReverseForeign * rate, 2);
            existingDraft.BankGlAccountId = targetBankGlAccountId;
            existingDraft.Reference = draftRef;
            ctx.VendorPayments.Update(existingDraft);
        }

        await ctx.SaveChangesAsync();
        await JS.InvokeVoidAsync("alert", "Debit Note draft saved successfully.");
        await LoadHistoricalReversalsGrid();
        NavigateToListView();
    }

    private async Task PostDebitNoteAdjustment()
    {
        if (isBusy) return;
        _errMsg = string.Empty;
        try
        {
            await ExecutePaymentReversalPost();
        }
        catch (Exception ex)
        {
            _errMsg = $"Ledger Interface Exception: {ex.Message}";
            await JS.InvokeVoidAsync("alert", _errMsg);
        }
    }

    private async Task ExecutePaymentReversalPost()
    {
        if (SelectedBillRow == null)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: Please select an invoice.");
            return;
        }
        if (amountToReverseForeign <= 0)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: Refund amount must be greater than zero.");
            return;
        }
        if (amountToReverseForeign > SelectedBillRow.RemainingRefundableForeign)
        {
            await JS.InvokeVoidAsync("alert",
                $"Validation Error: Refund amount ({amountToReverseForeign:N2}) exceeds the remaining " +
                $"refundable balance ({SelectedBillRow.RemainingRefundableForeign:N2} {currencySymbol}). " +
                $"Previously reversed: {(SelectedBillRow.TotalPaidForeign - SelectedBillRow.RemainingRefundableForeign):N2} {currencySymbol}.");
            return;
        }
        if (targetBankGlAccountId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Ledger Error: A valid refund bank account mapping is required before posting.");
            return;
        }
        if (targetReversalDate == default || targetReversalDate > DateTime.Today)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: Please enter a valid date that is not in the future.");
            return;
        }

        var confirmation = await JS.InvokeAsync<bool>("confirm",
            $"Post financial reversal for {currencySymbol} {amountToReverseForeign:N2} to the General Ledger?");
        if (!confirmation) return;

        isBusy = true;
        StateHasChanged();

        using var ctx = await DbFactory.CreateDbContextAsync();

        string postedRef = customReferenceInput.StartsWith("DRAFT-", StringComparison.OrdinalIgnoreCase)
            ? customReferenceInput.Substring(6)
            : customReferenceInput;

        var reversalWrapper = new VendorPayment
        {
            VendorBillId = selectedBillId,
            Date = targetReversalDate,
            Amount = amountToReverseForeign, // service layer handles base conversion & polarity
            BankGlAccountId = targetBankGlAccountId,
            Reference = postedRef
        };

        string result = await PurchService.PostVendorPaymentReversalAsync(reversalWrapper, currentCompanyId, currentUserId);

        if (string.IsNullOrEmpty(result))
        {
            // Clean up the draft row now that the real posted entry exists
            if (currentPaymentId != Guid.Empty)
            {
                var looseDraft = await ctx.VendorPayments.FindAsync(currentPaymentId);
                if (looseDraft != null)
                {
                    ctx.VendorPayments.Remove(looseDraft);
                    await ctx.SaveChangesAsync();
                }
            }

            await JS.InvokeVoidAsync("alert", "Debit Note posted to the General Ledger successfully.");
            await LoadHistoricalReversalsGrid();
            ResetFormStateContainers();
            NavigateToListView();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", result);
        }

        isBusy = false;
        StateHasChanged();
    }

    private async Task DeleteDraft()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Permanently discard this Debit Note draft?")) return;

        if (currentPaymentId != Guid.Empty)
        {
            using var ctx = await DbFactory.CreateDbContextAsync();
            var draft = await ctx.VendorPayments.FindAsync(currentPaymentId);
            if (draft != null)
            {
                ctx.VendorPayments.Remove(draft);
                await ctx.SaveChangesAsync();
            }
        }

        await LoadHistoricalReversalsGrid();
        NavigateToListView();
    }

    // forceLoad removed — OnParametersSetAsync handles parameter changes cleanly.
    private void RouteToTargetAdjustment(Guid targetId)
    {
        Nav.NavigateTo($"/ap/debit-note/entry/{targetId}");
    }

