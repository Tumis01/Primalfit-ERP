@using Primafit_ERP.Components.Models

<div class="relative">
    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">@Label</label>
    
    @if (SelectedItem != null && !isSearching)
    {
        <div class="flex items-center justify-between p-2.5 border rounded-xl bg-slate-50 border-slate-200 cursor-pointer hover:border-slate-300 transition-colors" 
             @onclick="EnableSearch">
            <div class="flex flex-col">
                <span class="text-sm font-bold text-slate-900">@SelectedItem.Name</span>
                <span class="text-xs text-slate-500 font-mono">@SelectedItem.SKU</span>
            </div>
            <div class="flex items-center gap-2">
                @if(SelectedItem.IsService)
                {
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700 uppercase tracking-wide">Service</span>
                }
                <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </div>
        </div>
    }
    else
    {
        <div class="relative">
            <input @bind="searchTerm" 
                   @bind:event="oninput"
                   @onfocus="() => showDropdown = true"
                   @onblur="OnBlur"
                   class="w-full rounded-xl border border-slate-200 p-2.5 text-sm focus:border-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-100 @(IsInvalid ? "border-red-300 bg-red-50" : "")"
                   placeholder="Search Name or SKU..." 
                   autoFocus />
            
            <div class="absolute right-3 top-3 text-slate-400 pointer-events-none">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            </div>
        </div>
        
        @if (showDropdown)
        {
            <div class="absolute z-50 mt-1 max-h-60 w-full overflow-auto rounded-xl border border-slate-200 bg-white shadow-xl animate-in fade-in slide-in-from-top-2 duration-200">
                @if (FilteredItems.Any())
                {
                    @foreach (var item in FilteredItems)
                    {
                        <div class="cursor-pointer px-4 py-2 hover:bg-slate-50 border-b border-slate-50 last:border-0 transition-colors"
                             @onmousedown="() => Select(item)"> 
                            <div class="font-bold text-sm text-slate-900">@item.Name</div>
                            <div class="flex justify-between items-center mt-0.5">
                                <span class="text-xs text-slate-500 font-mono">@item.SKU</span>
                                @if(item.IsService) 
                                { 
                                    <span class="text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-100">SERVICE</span> 
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-4 text-xs text-slate-400 text-center italic">No items found matching '@searchTerm'</div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Item";
    [Parameter] public List<Item> Items { get; set; } = new();
    [Parameter] public Guid Value { get; set; }
    [Parameter] public EventCallback<Guid> ValueChanged { get; set; }
    [Parameter] public EventCallback OnSelectionChanged { get; set; } // Hook to trigger parent logic
    [Parameter] public bool IsInvalid { get; set; }

    private string searchTerm = "";
    private bool isSearching = false;
    private bool showDropdown = false;

    private Item? SelectedItem => Items.FirstOrDefault(i => i.Id == Value);

    private IEnumerable<Item> FilteredItems => 
        string.IsNullOrWhiteSpace(searchTerm) 
        ? Items.Take(20) 
        : Items.Where(i => i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) 
                           || i.SKU.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override void OnParametersSet()
    {
        if (Value != Guid.Empty && string.IsNullOrEmpty(searchTerm))
        {
            isSearching = false;
        }
    }

    private void EnableSearch()
    {
        isSearching = true;
        showDropdown = true;
        searchTerm = ""; 
    }

    private async Task Select(Item item)
    {
        searchTerm = "";
        isSearching = false;
        showDropdown = false;
        await ValueChanged.InvokeAsync(item.Id);
        await OnSelectionChanged.InvokeAsync();
    }

    private async Task OnBlur()
    {
        await Task.Delay(150); // Delay to allow click event to register
        showDropdown = false;
        isSearching = false;
    }
}