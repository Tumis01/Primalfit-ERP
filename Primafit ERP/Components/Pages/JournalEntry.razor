@page "/gl/journal-entry"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject SegCoaService SetupService
@inject GLOperationsService GlOps
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject IJSRuntime JS
@inject NavigationManager NavManager

@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 animate-in fade-in duration-500 pb-16">

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Journal Entry Workspace</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Create and balance manual adjustments. Staged batches are sent to the General Ledger review queue for posting.</p>
        </div>
        <PermissionGate Key="GL_JOURNAL_CREATE">
            <Authorized>
                <button type="button" @onclick="CreateBatch" class="px-5 py-2.5 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800 transition-all flex items-center gap-2 active:scale-95 text-sm">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    <span>New Journal Batch</span>
                </button>
            </Authorized>
        </PermissionGate>
    </div>

    @if (isLoading)
    {
        <div class="p-12 text-center text-slate-400 animate-pulse bg-white border border-slate-200 rounded-2xl">Loading journal batches...</div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

            <!-- Batches Sidebar List -->
            <div class="lg:col-span-1 space-y-3 h-[calc(100vh-210px)] overflow-y-auto pr-1">
                @if (activeBatches.Any())
                {
                    @foreach (var batch in activeBatches)
                    {
                        <div @onclick="() => SelectBatch(batch.Id)"
                             class="p-4 rounded-xl border cursor-pointer transition-all hover:shadow-sm @(selectedBatch?.Id == batch.Id ? "bg-indigo-50/50 border-indigo-300 ring-2 ring-indigo-100" : "bg-white border-slate-200 hover:border-slate-300")">

                            <div class="flex justify-between items-start mb-2">
                                <span class="text-xs font-mono font-bold text-slate-700">@batch.BatchName</span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider @GetStatusPillClass(batch.Status)">
                                    @batch.Status
                                </span>
                            </div>

                            <div class="font-bold text-slate-900 text-sm mb-1 truncate" title="@batch.Description">
                                @(string.IsNullOrWhiteSpace(batch.Description) ? "Manual Journal" : batch.Description)
                            </div>

                            <div class="flex justify-between items-end mt-3 border-t border-slate-100 pt-2 text-xs">
                                <div>
                                    <div class="text-[10px] text-slate-400 uppercase font-bold">Date</div>
                                    <div class="font-mono font-bold text-slate-600">@batch.Journals.FirstOrDefault()?.TransactionDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-[10px] text-slate-400 uppercase font-bold">Lines</div>
                                    <div class="font-mono font-bold text-slate-600">@(batch.Journals.FirstOrDefault()?.Lines.Count ?? 0)</div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-8 text-center border-2 border-dashed border-slate-200 rounded-2xl text-slate-400 text-sm bg-white">
                        No manual journal batches recorded.
                    </div>
                }
            </div>

            <!-- Workspace Editor -->
            <div class="lg:col-span-3">
                @if (selectedBatch != null)
                {
                    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden flex flex-col h-full min-h-[620px]">

                        <!-- Top Batch Bar -->
                        <div class="p-6 border-b border-slate-100 bg-slate-50/50 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
                            <div>
                                <div class="flex items-center gap-2">
                                    <h2 class="text-lg font-bold text-slate-900 font-mono">@selectedBatch.BatchName</h2>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider @GetStatusPillClass(selectedBatch.Status)">
                                        @selectedBatch.Status
                                    </span>
                                </div>
                                <p class="text-xs text-slate-500 mt-1">@(string.IsNullOrWhiteSpace(selectedBatch.Description) ? "No description provided." : selectedBatch.Description)</p>
                            </div>

                            <div class="flex gap-2 items-center flex-wrap">
                                @if (selectedBatch.Status == BatchStatus.Draft || selectedBatch.Status == BatchStatus.Rejected)
                                {
                                    @if (selectedBatch.Status == BatchStatus.Rejected || !selectedBatch.IsLocked)
                                    {
                                        <PermissionGate Key="GL_JOURNAL_CREATE">
                                            <Authorized>
                                                <button type="button" @onclick="DeleteBatch" class="px-4 py-2 bg-white border border-rose-200 text-rose-600 text-xs font-bold rounded-xl hover:bg-rose-50 transition-colors shadow-sm active:scale-95">
                                                    Delete Draft
                                                </button>
                                            </Authorized>
                                        </PermissionGate>
                                    }

                                    @if (selectedBatch.Status == BatchStatus.Draft && !selectedBatch.IsLocked)
                                    {
                                        <button type="button" @onclick="LockBatch" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-xl hover:bg-slate-50 transition-all shadow-sm">Lock Batch</button>
                                    }
                                    else if (selectedBatch.Status == BatchStatus.Draft && selectedBatch.IsLocked)
                                    {
                                        <button type="button" @onclick="UnlockBatch" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 text-xs font-bold rounded-xl hover:bg-slate-50 transition-all shadow-sm">Unlock for Edit</button>
                                    }
                                    <button type="button" @onclick="SubmitForApproval" disabled="@(!IsBalanced || TotalDebits == 0)"
                                            class="px-5 py-2 bg-indigo-600 text-white text-xs font-bold rounded-xl shadow hover:bg-indigo-700 transition-all flex items-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed active:scale-95">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                        <span>@(selectedBatch.Status == BatchStatus.Rejected ? "Resubmit for GL Review" : "Submit for GL Review")</span>
                                    </button>
                                }
                                else if (selectedBatch.Status == BatchStatus.Ready)
                                {
                                    <span class="text-xs font-bold text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-xl flex items-center gap-1.5">
                                        <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse"></span>
                                        Staged for Review on /gl/batches
                                    </span>

                                    <PermissionGate Key="GL_BATCH_APPROVE">
                                        <Authorized>
                                            <button type="button" @onclick="UnlockBatch" class="px-4 py-2 bg-white border border-slate-200 text-slate-700 text-xs font-bold rounded-xl hover:bg-slate-50 transition-all shadow-sm">
                                                Unlock for Edit
                                            </button>
                                        </Authorized>
                                    </PermissionGate>
                                }
                                else if (selectedBatch.Status == BatchStatus.Posted)
                                {
                                    <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-xl flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                                        Committed to GL (Read-Only)
                                    </span>
                                    <button type="button" @onclick="ReuseBatch" class="px-4 py-2 bg-indigo-600 text-white text-xs font-bold rounded-xl hover:bg-indigo-700 shadow-sm">Reuse Batch</button>
                                }
                            </div>
                        </div>

                        <!-- Rejection Warning Banner -->
                        @if (selectedBatch.Status == BatchStatus.Rejected && !string.IsNullOrWhiteSpace(selectedBatch.RejectionReason))
                        {
                            <div class="mx-6 mt-4 p-4 bg-rose-50 border border-rose-200 rounded-xl flex items-start gap-3">
                                <svg class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                <div class="text-xs">
                                    <span class="font-bold text-rose-800 uppercase tracking-wider block">Reviewer Rejection Notice</span>
                                    <span class="text-rose-700 mt-0.5 block leading-relaxed">@selectedBatch.RejectionReason</span>
                                </div>
                            </div>
                        }

                        <!-- Editable Line Entry Form (Only when in Draft or Rejected) -->
                        @if ((selectedBatch.Status == BatchStatus.Draft || selectedBatch.Status == BatchStatus.Rejected) && !selectedBatch.IsLocked)
                        {
                            <EditForm Model="@entryForm" OnValidSubmit="SaveLine" class="p-5 bg-slate-50/50 border-b border-slate-100">
                                <DataAnnotationsValidator />
                                <div class="grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
                                    <div class="md:col-span-4">
                                        <SearchableGlAccount Label="GL Account"
                                                             Placeholder="Search Account..."
                                                             Accounts="@coaList"
                                                             @bind-Value="entryForm.SegCoaId"
                                                             IsInvalid="@(entryForm.SegCoaId == Guid.Empty)" />
                                    </div>
                                    <div class="md:col-span-4">
                                        <label class="label">Reference / Line Memo <span class="text-rose-500">*</span></label>
                                        <InputText @bind-Value="entryForm.Reference" class="@InputClass" placeholder="Line details..." />
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="label text-emerald-700">Debit</label>
                                        <InputNumber @bind-Value="entryForm.Debit" @oninput="(e) => entryForm.Credit = 0" class="@($"{InputClass} font-mono font-bold text-emerald-700 text-right")" placeholder="0.0000" />
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="label text-rose-700">Credit</label>
                                        <InputNumber @bind-Value="entryForm.Credit" @oninput="(e) => entryForm.Debit = 0" class="@($"{InputClass} font-mono font-bold text-rose-700 text-right")" placeholder="0.0000" />
                                    </div>

                                    <div class="md:col-span-12 flex justify-end gap-2 pt-1">
                                        @if (isEditing)
                                        {
                                            <button type="button" @onclick="CancelEdit" class="px-4 py-2 bg-white border border-slate-300 text-slate-600 rounded-xl text-xs font-bold hover:bg-slate-50 transition-colors">Cancel</button>
                                            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-xl text-xs font-bold shadow-sm hover:bg-indigo-700 transition-colors">Update Line</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="px-6 py-2 bg-slate-900 text-white rounded-xl text-xs font-bold shadow-sm hover:bg-slate-800 transition-colors flex items-center gap-1.5">
                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" /></svg>
                                                <span>Add Line</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </EditForm>
                        }

                        <!-- Journal Lines Table -->
                        <div class="flex-1 overflow-auto p-0">
                            <table class="w-full text-left text-sm whitespace-nowrap">
                                <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 sticky top-0 tracking-wider">
                                    <tr>
                                        <th class="p-4 w-1/3">Account</th>
                                        <th class="p-4">Reference / Details</th>
                                        <th class="p-4 text-right w-36">Debit</th>
                                        <th class="p-4 text-right w-36">Credit</th>
                                        <th class="p-4 w-24 text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-100">
                                    @if (CurrentLines.Any())
                                    {
                                        @foreach (var line in CurrentLines)
                                        {
                                            <tr class="hover:bg-slate-50/70 transition-colors @(line.Id == entryForm.Id ? "bg-indigo-50/40" : "")">
                                                <td class="p-4 text-xs font-bold text-slate-800">
                                                    @GetAccountName(line.SegCoaId)
                                                </td>
                                                <td class="p-4 text-slate-600 text-xs">@line.Reference</td>
                                                <td class="p-4 text-right font-mono font-bold text-emerald-700">
                                                    @(line.Debit > 0 ? line.Debit.ToString("N4") : "-")
                                                </td>
                                                <td class="p-4 text-right font-mono font-bold text-rose-700">
                                                    @(line.Credit > 0 ? line.Credit.ToString("N4") : "-")
                                                </td>
                                                <td class="p-4 text-center">
                                                    @if ((selectedBatch.Status == BatchStatus.Draft || selectedBatch.Status == BatchStatus.Rejected) && !line.IsPosted)
                                                    {
                                                        <div class="flex items-center justify-center gap-2">
                                                            <button type="button" @onclick="() => EditLine(line)" disabled="@selectedBatch.IsLocked" class="p-1 text-slate-400 hover:text-indigo-600 transition-colors disabled:cursor-not-allowed disabled:opacity-40" title="@(selectedBatch.IsLocked ? "Unlock the batch to edit this line" : "Edit Line")">
                                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                                                </svg>
                                                            </button>
                                                            <button type="button" @onclick="() => RemoveLine(line.Id)" disabled="@selectedBatch.IsLocked" class="p-1 text-slate-400 hover:text-rose-600 transition-colors disabled:cursor-not-allowed disabled:opacity-40" title="@(selectedBatch.IsLocked ? "Unlock the batch to delete this line" : "Delete Line")">
                                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                                </svg>
                                                            </button>
                                                        </div>
                                                    }
                                                    else if (selectedBatch.Status == BatchStatus.Posted)
                                                    {
                                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-700">
                                                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                                                            Posted
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-xs text-slate-400 font-medium italic">Locked</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="p-12 text-center text-slate-400 italic">
                                                No lines in this batch yet. Add debit and credit components above.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Balances Footer Bar -->
                        <div class="border-t border-slate-200 p-4 bg-slate-50 flex flex-col sm:flex-row justify-between items-center gap-4 text-sm mt-auto">
                            <div>
                                @if (!IsBalanced)
                                {
                                    <div class="text-rose-600 font-bold flex items-center gap-1.5 text-xs">
                                        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                        <span>Out of Balance by @Math.Abs(TotalDebits - TotalCredits).ToString("N4")</span>
                                    </div>
                                }
                                else if (TotalDebits > 0)
                                {
                                    <div class="text-emerald-600 font-bold flex items-center gap-1.5 text-xs">
                                        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                                        <span>Journal is Balanced</span>
                                    </div>
                                }
                            </div>

                            <div class="flex items-center gap-6 font-mono font-bold text-sm">
                                <div>
                                    <span class="text-[10px] font-sans text-slate-400 uppercase tracking-wider block">Total Debits</span>
                                    <span class="text-emerald-700 text-base font-bold">@TotalDebits.ToString("N4")</span>
                                </div>
                                <div class="w-px h-8 bg-slate-200"></div>
                                <div>
                                    <span class="text-[10px] font-sans text-slate-400 uppercase tracking-wider block">Total Credits</span>
                                    <span class="text-rose-700 text-base font-bold">@TotalCredits.ToString("N4")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="h-full min-h-[500px] flex flex-col items-center justify-center bg-white border border-slate-200 rounded-2xl text-slate-400 p-8">
                        <svg class="w-16 h-16 opacity-20 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                        <p class="font-medium text-sm">Select an existing batch or create a new one to begin adjustments.</p>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Create Batch Modal -->
    @if (showCreateModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 animate-in fade-in duration-200">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 border border-slate-200">
                <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                    <h3 class="text-base font-bold text-slate-900">Initialize Journal Batch</h3>
                    <button type="button" @onclick="() => showCreateModal = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    </button>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="label">Posting Date</label>
                        <InputDate @bind-Value="newBatchDate" class="input-class font-bold" />
                    </div>
                    <div>
                        <label class="label">Batch Description / Purpose <span class="text-rose-500">*</span></label>
                        <textarea @bind="newBatchDescription" class="input-class resize-none" rows="3" placeholder="e.g. Month-end depreciation adjustment..."></textarea>
                    </div>
                    <label class="flex items-start gap-3 rounded-xl border border-indigo-100 bg-indigo-50/60 p-3 cursor-pointer">
                        <input type="checkbox" @bind="newBatchClearAfterPost" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                        <span class="text-xs text-indigo-900"><span class="font-bold block">Clear posted lines after approval</span><span class="text-indigo-700">When enabled, approved debit and credit lines are removed from this reusable batch. The batch itself remains available.</span></span>
                    </label>
                    <div class="p-3 bg-slate-50 border border-slate-200/80 rounded-xl text-xs text-slate-500 leading-relaxed">
                        Entries are saved as unposted draft lines. When balanced, submit the batch to the General Ledger review queue.
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-slate-100">
                    <button type="button" @onclick="() => showCreateModal = false" class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">Cancel</button>
                    <button type="button" @onclick="ConfirmCreateBatch" disabled="@(string.IsNullOrWhiteSpace(newBatchDescription))" class="px-5 py-2 bg-slate-900 text-white text-xs font-bold rounded-xl shadow hover:bg-slate-800 disabled:opacity-50 transition-all">Create Batch</button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
        letter-spacing: 0.05em;
    }

    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #cbd5e1;
        padding: 0.6rem 0.8rem;
        font-size: 0.875rem;
        background-color: #fff;
        color: #0f172a;
        outline: none;
        transition: border-color 0.2s;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private const string InputClass = "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100 transition-all";

    private Guid currentCompanyId = Guid.Empty;
    private string currentUserId = "";
    private string companyName = "";
    private bool isLoading = true;
    private bool showCreateModal = false;
    private bool isEditing = false;

    private List<GLBatch> activeBatches = new();
    private List<SegChartOfAccount> coaList = new();
    private List<SegChartOfAccount> fullMasterCoaList = new();

    private GLBatch? selectedBatch;
    private GLJournalLine entryForm = new();

    private DateOnly newBatchDate = DateOnly.FromDateTime(DateTime.Today);
    private string newBatchDescription = "";
    private bool newBatchClearAfterPost = true;

    private List<GLJournalLine> CurrentLines =>
        selectedBatch?.Journals?.FirstOrDefault()?.Lines ?? new List<GLJournalLine>();

    private IEnumerable<GLJournalLine> PendingLines => CurrentLines.Where(l => !l.IsPosted);
    private decimal TotalDebits => PendingLines.Sum(l => l.Debit);
    private decimal TotalCredits => PendingLines.Sum(l => l.Credit);
    private bool IsBalanced => TotalDebits > 0 && TotalDebits == TotalCredits;

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("GL_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;

            var company = await CompanyService.GetCompanyByIdAsync(currentCompanyId);
            if (company != null) companyName = company.CompanyName;

            var allCoa = await SetupService.GetCoaAsync(currentCompanyId);
            fullMasterCoaList = allCoa.ToList();
            coaList = allCoa.Where(x => x.AllowJournal && x.IsActive).OrderBy(x => x.AccountCode).ToList();

            await LoadBatches();
        }
        isLoading = false;
    }

    private async Task LoadBatches()
    {
        var allBatches = await GlOps.GetActiveJournalBatchesAsync(currentCompanyId);
        activeBatches = allBatches
            .Where(b => !string.IsNullOrWhiteSpace(b.BatchName) && b.BatchName.StartsWith("JV-"))
            .ToList();

        if (selectedBatch != null)
        {
            selectedBatch = await GlOps.GetBatchByIdAsync(selectedBatch.Id);
        }
    }

    private async Task SelectBatch(Guid id)
    {
        selectedBatch = await GlOps.GetBatchByIdAsync(id);
        ResetForm();
    }

    private void CreateBatch()
    {
        newBatchDate = DateOnly.FromDateTime(DateTime.Today);
        newBatchDescription = "";
        newBatchClearAfterPost = true;
        showCreateModal = true;
    }

    private async Task ConfirmCreateBatch()
    {
        try
        {
            var batch = await GlOps.CreateDraftBatchAsync(
                currentCompanyId, newBatchDate, newBatchDescription,
                currentUserId, clearAfterPost: newBatchClearAfterPost);

            showCreateModal = false;
            await LoadBatches();
            await SelectBatch(batch.Id);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task SubmitForApproval()
    {
        if (selectedBatch == null || !IsBalanced) return;

        bool confirm = await JS.InvokeAsync<bool>("confirm",
            $"Submit batch {selectedBatch.BatchName} for General Ledger review? It will be routed to the manager on /gl/batches.");
        if (!confirm) return;

        var err = await GlOps.SubmitForApprovalAsync(selectedBatch.Id, currentUserId);

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Batch submitted successfully. It is now visible on the General Ledger Batches review screen.");
            await LoadBatches();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task UnlockBatch()
    {
        if (selectedBatch == null) return;
        var err = await GlOps.RevertToDraftAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err))
        {
            await LoadBatches();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task LockBatch()
    {
        if (selectedBatch == null) return;
        var err = await GlOps.LockBatchAsync(selectedBatch.Id, currentUserId);
        if (string.IsNullOrEmpty(err)) await LoadBatches();
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task ReuseBatch()
    {
        if (selectedBatch == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Reuse {selectedBatch.BatchName} for additional journal entries?")) return;
        var err = await GlOps.ReuseBatchAsync(selectedBatch.Id, currentUserId);
        if (string.IsNullOrEmpty(err))
        {
            await LoadBatches();
            await SelectBatch(selectedBatch.Id);
        }
        else await JS.InvokeVoidAsync("alert", err);
    }

    private async Task DeleteBatch()
    {
        if (selectedBatch == null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"Permanently delete draft batch {selectedBatch.BatchName}?")) return;

        var err = await GlOps.DeleteDraftBatchAsync(selectedBatch.Id);
        if (string.IsNullOrEmpty(err))
        {
            selectedBatch = null;
            await LoadBatches();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private async Task SaveLine()
    {
        if (entryForm.SegCoaId == Guid.Empty) { await JS.InvokeVoidAsync("alert", "Please select a GL Account."); return; }
        if (string.IsNullOrWhiteSpace(entryForm.Reference)) { await JS.InvokeVoidAsync("alert", "Reference / Details is required."); return; }
        if (entryForm.Debit == 0 && entryForm.Credit == 0) { await JS.InvokeVoidAsync("alert", "You must enter either a Debit or Credit amount."); return; }
        if (entryForm.Debit > 0 && entryForm.Credit > 0) { await JS.InvokeVoidAsync("alert", "A line cannot have both a Debit and Credit. Use separate lines."); return; }

        string err = isEditing
            ? await GlOps.UpdateJournalLineAsync(entryForm)
            : await GlOps.AddJournalLineAsync(selectedBatch!.Id, entryForm);

        if (string.IsNullOrEmpty(err))
        {
            await LoadBatches();
            ResetForm();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }

    private void EditLine(GLJournalLine line)
    {
        entryForm = new GLJournalLine
        {
            Id = line.Id,
            HeaderId = line.HeaderId,
            SegCoaId = line.SegCoaId,
            Reference = line.Reference,
            Debit = line.Debit,
            Credit = line.Credit
        };
        isEditing = true;
    }

    private void CancelEdit() => ResetForm();

    private async Task RemoveLine(Guid lineId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Remove this line?")) return;
        await GlOps.RemoveJournalLineAsync(lineId);
        await LoadBatches();
    }

    private void ResetForm()
    {
        isEditing = false;
        entryForm = new GLJournalLine();
    }

    private string GetAccountName(Guid id) =>
        fullMasterCoaList.FirstOrDefault(a => a.Id == id)?.Description ?? "Control Account";

    private string GetStatusPillClass(BatchStatus status) => status switch
    {
        BatchStatus.Draft => "bg-slate-100 text-slate-700 border border-slate-200",
        BatchStatus.Ready => "bg-amber-100 text-amber-800 border border-amber-200",
        BatchStatus.Posted => "bg-emerald-100 text-emerald-800 border border-emerald-200",
        BatchStatus.Rejected => "bg-rose-100 text-rose-800 border border-rose-200",
        _ => "bg-slate-100 text-slate-600"
    };
}
