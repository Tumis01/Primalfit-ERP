@page "/gl/journal-entry"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject GLOperationsService GLOps
@inject GLSetupService SetupService
@inject CompanyApiService CompanyService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-7xl mx-auto space-y-6 p-6">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">General Journal Entry</h1>
            <p class="text-sm text-slate-500">Create a manual double-entry journal.</p>
        </div>
        <div class="text-right">
            <span class="block text-xs uppercase text-slate-500 font-bold">Balance Check</span>
            <span class="text-xl font-mono font-bold @(Imbalance == 0 ? "text-emerald-600" : "text-red-600")">
                @Imbalance.ToString("N2")
            </span>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">

        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Company</label>
            <select class="@InputClass" @bind="selectedCompanyId" @bind:after="OnCompanyChanged">
                <option value="@Guid.Empty">-- Select --</option>
                @foreach (var c in companies)
                {
                    <option value="@c.CompanyDetailsId">@c.CompanyName</option>
                }
            </select>
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Date</label>
            <InputDate class="@InputClass" @bind-Value="journalDate" />
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Batch Name / Ref</label>
            <InputText class="@InputClass" @bind-Value="batchName" placeholder="e.g. Monthly Accruals" />
        </div>

        <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Description</label>
            <InputText class="@InputClass" @bind-Value="description" placeholder="Narration..." />
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
        <table class="w-full text-left text-sm text-slate-700">
            <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-100">
                <tr>
                    <th class="px-5 py-3 w-[40%]">Account Name</th>
                    <th class="px-5 py-3 w-[25%]">Line Description</th>
                    <th class="px-5 py-3 w-[15%] text-right">Debit</th>
                    <th class="px-5 py-3 w-[15%] text-right">Credit</th>
                    <th class="px-5 py-3 w-[5%]"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @for (int i = 0; i < lines.Count; i++)
                {
                    var line = lines[i];
                    <tr class="hover:bg-slate-50">
                        <td class="px-5 py-2">
                            <select class="@InputClass" @bind="line.AccountId" disabled="@(!HasCompany)">
                                <option value="@Guid.Empty">-- Select Account --</option>
                                @foreach (var a in accounts)
                                {
                                    <option value="@a.Id">@a.AccountName (@a.AccountCode)</option>
                                }
                            </select>
                        </td>

                        <td class="px-5 py-2">
                            <InputText class="@InputClass" @bind-Value="line.Reference" placeholder="Line memo..." />
                        </td>

                        <td class="px-5 py-2">
                            <InputNumber class="@NumberClass" @bind-Value="line.Debit" />
                        </td>

                        <td class="px-5 py-2">
                            <InputNumber class="@NumberClass" @bind-Value="line.Credit" />
                        </td>

                        <td class="px-5 py-2 text-center">
                            <button @onclick="() => RemoveLine(line)" class="text-red-500 hover:text-red-700 font-bold">×</button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="bg-slate-50 font-bold text-slate-900">
                <tr>
                    <td colspan="2" class="px-5 py-3 text-right">Totals:</td>
                    <td class="px-5 py-3 text-right">@lines.Sum(x => x.Debit).ToString("N2")</td>
                    <td class="px-5 py-3 text-right">@lines.Sum(x => x.Credit).ToString("N2")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <div class="p-4 border-t border-slate-100 flex justify-between">
            <button @onclick="AddLine" class="text-indigo-600 font-bold hover:underline">+ Add Line</button>

            <button @onclick="SaveJournal"
                    disabled="@(!CanSave)"
                    class="bg-indigo-600 text-white px-6 py-2.5 rounded-xl font-bold hover:bg-indigo-700 shadow-md disabled:opacity-50 disabled:cursor-not-allowed">
                Post Journal Entry
            </button>
        </div>
    </div>
</div>

@code {
    private const string InputClass = "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all";
    private const string NumberClass = "w-full rounded-lg border border-slate-200 px-3 py-2 text-sm text-right font-mono focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all";

    private List<CompanyDetails> companies = new();
    private List<GLChartOfAccount> accounts = new();

    // Header Data
    private Guid selectedCompanyId;
    private DateOnly journalDate = DateOnly.FromDateTime(DateTime.Today);
    private string batchName = "General Journal"; // Default editable name
    private string description = "";

    private List<GLJournalLine> lines = new() { new GLJournalLine(), new GLJournalLine() };

    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private decimal Imbalance => lines.Sum(l => l.Debit) - lines.Sum(l => l.Credit);
    private bool CanSave => HasCompany && Imbalance == 0 && lines.Any(l => l.AccountId != Guid.Empty && (l.Debit > 0 || l.Credit > 0));

    protected override async Task OnInitializedAsync()
    {
        companies = await CompanyService.GetCompaniesAsync();
    }

    private async Task OnCompanyChanged()
    {
        if (selectedCompanyId != Guid.Empty)
        {
            accounts = await SetupService.GetChartOfAccountsAsync(selectedCompanyId);
            // Auto-sort by Name for user convenience
            accounts = accounts.OrderBy(a => a.AccountName).ToList();
        }
    }

    private void AddLine() => lines.Add(new GLJournalLine());
    private void RemoveLine(GLJournalLine line) => lines.Remove(line);

    private async Task SaveJournal()
    {
        // Call service (Auth disabled internally)
        var result = await GLOps.CreateJournalEntryAsync(
            selectedCompanyId,
            journalDate,
            batchName,
            description,
            lines
        );

        if (string.IsNullOrEmpty(result.error))
        {
            await JS.InvokeVoidAsync("alert", "Journal Saved Successfully!");
            // Reset Form
            lines = new() { new GLJournalLine(), new GLJournalLine() };
            batchName = "General Journal";
            description = "";
        }
        else
        {
            await JS.InvokeVoidAsync("alert", $"Error: {result.error}");
        }
    }
}