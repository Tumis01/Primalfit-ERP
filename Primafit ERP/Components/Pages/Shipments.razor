@page "/wh/shipments"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Components.Shared
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ShipmentService ShipmentService
@inject MasterDataService MasterService
@inject WarehouseService WhService
@inject CompanyApiService CompanyService
@inject SegCoaService SegCoaService
@inject TransactionMappingService MappingService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-[1400px] mx-auto space-y-6 animate-in fade-in duration-500 pb-16 font-sans text-slate-800">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between bg-white p-6 rounded-2xl border border-slate-200 shadow-sm gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Sales Shipments</h1>
            <p class="text-sm text-slate-500 mt-1">Process physical shipments, configure inventory GL routes, and view dispatch history.</p>
        </div>

        <PermissionGate Key="SHIPMENT_CREATE"><Authorized><a href="/wh/shipments/new" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-bold">New Shipment</a></Authorized></PermissionGate>
    </div>

    <div class="flex gap-4 border-b border-slate-200">
        <button @onclick="() => activeTab = 0" class="pb-3 px-4 text-sm font-bold border-b-2 transition-colors @(activeTab == 0 ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700")">
                                    Pending Dispatch / GL Review
        </button>
        <button @onclick="() => activeTab = 1" class="pb-3 px-4 text-sm font-bold border-b-2 transition-colors @(activeTab == 1 ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700")">
            Shipment History
        </button>
    </div>

    @if (ViewSourceId.HasValue && activeTab == 1)
    {
        <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-indigo-900"><span>Showing the linked shipment.</span><a href="/wh/shipments" class="font-bold text-indigo-700 underline">View all shipments</a></div>
    }

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">Loading dispatch data...</div>
    }
    else if (activeTab == 0)
    {
        @if (!shipments.Any())
        {
            <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400">
                <svg class="mx-auto h-12 w-12 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
                No pending shipments. Create a shipment to begin.
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var shp in shipments)
                {
                    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm transition-all hover:shadow-md">
                        <button type="button" class="flex w-full justify-between items-center gap-3 bg-slate-50 p-4 border-b border-slate-200 text-left hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500" @onclick="() => ToggleExpand(shp.Id)" aria-expanded="@(expandedShipmentId == shp.Id ? "true" : "false")" aria-label="@(expandedShipmentId == shp.Id ? $"Close {shp.ShipmentNumber}" : $"View {shp.ShipmentNumber}")">
                            <span class="flex items-center gap-4 flex-wrap">
                                <span class="font-mono font-bold text-indigo-700">@shp.ShipmentNumber</span>
                                <span class="text-sm font-bold text-slate-700">Sources: @GetShipmentOrderRefs(shp)</span>
                                <span class="text-sm text-slate-500 hidden sm:inline">| Customer: @GetShipmentCustomer(shp)</span>
                                @if (shp.CustomTransactionTypeId.HasValue)
                                {
                                    <span class="px-2 py-0.5 text-[10px] font-bold text-amber-700 bg-amber-50 border border-amber-200 rounded-full">
                                        Custom Route Active
                                    </span>
                                }
                            </span>
                            <span class="flex items-center gap-3">
                                <span class="px-2.5 py-1 text-[10px] font-bold rounded-full uppercase tracking-wider @ReviewPillClass(GetReviewStatus(shp))">
                                    @ReviewLabel(GetReviewStatus(shp))
                                </span>
                                <svg class="w-5 h-5 text-slate-400 transform transition-transform @(expandedShipmentId == shp.Id ? "rotate-180" : "")" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            </span>
                        </button>

                        @if (expandedShipmentId == shp.Id)
                        {
                            <div class="p-6 bg-white animate-in slide-in-from-top-2 overflow-x-auto space-y-6">
                                @if (GetReviewStatus(shp) == BatchStatus.Posted)
                                {
                                    <div role="alert" class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">The GL batch is posted, but physical dispatch is still pending. Check warehouse stock and refresh to retry finalization.</div>
                                }
                                <div class="flex justify-between items-center pb-2 border-b border-slate-100">
                                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Dispatch Parameters</span>
                                    @if (canConfigureRoute)
                                    {
                                        <button type="button" @onclick="() => OpenRouteModal(shp)" disabled="@(!IsShipmentEditable(shp))" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 transition-colors flex items-center gap-1.5 shadow-sm disabled:opacity-50">
                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                            <span>Configure GL Route</span>
                                        </button>
                                    }
                                </div>

                                <div class="transaction-lines-scroll" role="region" aria-label="Transaction line items" tabindex="0"><table class="transaction-lines w-full text-sm text-left min-w-[500px]">
                                    <thead class="text-xs text-slate-500 uppercase font-bold border-b border-slate-200">
                                        <tr>
                                            <th class="pb-3 min-w-[220px]">Item Name</th>
                                            <th class="pb-3 text-right">Source Qty<br /><span class="text-[9px] font-semibold normal-case">Required</span></th>
                                            <th class="pb-3 text-right">Previously Shipped</th>
                                            <th class="pb-3 text-right">Max Left to Ship</th>
                                            <th class="pb-3 text-center w-36">Ship UOM</th>
                                            <th class="pb-3 text-center w-40">Qty Shipped<br /><span class="text-[9px] font-semibold normal-case">This Dispatch</span></th>
                                        <th class="p-3">Dimensions</th></tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        @foreach (var line in shp.Lines)
                                        {
                                            var invoiceQty = GetInvoiceQuantity(shp, line);
                                            var previouslyShipped = GetPreviouslyShipped(shp, line);
                                            var maxLeftToShip = GetMaxLeftToShip(shp, line);
                                            var displayFactor = GetLineFactor(line);
                                            var uomOptions = GetUomOptions(line).ToList();
                                            bool isOver = line.QtyShipped > maxLeftToShip;
                                            <tr class="@(isOver ? "bg-rose-50/40" : "")">
                                                <td class="py-4 font-bold text-slate-800">@line.Item?.Name @if (line.SalesInvoiceLine?.SalesInvoice is { } invoice) { <a class="block text-xs font-normal text-indigo-700 underline" href="@($"/ar/sales-invoices?view={invoice.Id}")">Invoice @invoice.InvoiceNumber</a> }</td>
                                                <td class="py-4 text-right text-slate-600 font-mono">@UomConversion.FromBase(invoiceQty, displayFactor).ToString("N4") @GetLineUomName(line)</td>
                                                <td class="py-4 text-right text-slate-500 font-mono">@if (line.SalesInvoiceLineId.HasValue) { <span>—</span> } else { @UomConversion.FromBase(previouslyShipped, displayFactor).ToString("N4") <span>@GetLineUomName(line)</span> }</td>
                                                <td class="py-4 text-right font-mono font-bold text-indigo-700">@UomConversion.FromBase(maxLeftToShip, displayFactor).ToString("N4") @GetLineUomName(line)</td>
                                                <td class="py-4">
                                                    @if (uomOptions.Count > 0)
                                                    {
                                                        <SearchableGuidSelect Options="@(uomOptions.Select(x => new DropdownOption(x.Id, x.Name, $"Factor {x.Factor:N4}")).ToList())" Value="@line.UomId" ValueChanged="@(id => OnUomChanged(line, id))" Disabled="@(!IsShipmentEditable(shp))" AllowClear="false" InlineMenu="true" Placeholder="Search shipment unit" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-xs font-bold text-slate-500">@GetLineUomName(line)</span>
                                                    }
                                                </td>
                                                <td class="py-4">
                                                    <input type="text" inputmode="decimal" max="@UomConversion.FromBase(maxLeftToShip, displayFactor)" min="0"
                                                           value="@UomConversion.FromBase(line.QtyShipped, displayFactor).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)"
                                                           @onchange="@(e => ValidateQuantity(line, e.Value?.ToString()))"
                                                            disabled="@(!IsShipmentEditable(shp))"
                                                            class="w-full border rounded-lg px-3 py-2 text-center font-bold focus:ring-1 outline-none transition-all
                                                    @(isOver ? "border-rose-400 text-rose-700 bg-rose-50 focus:border-rose-500" : "border-slate-300 text-slate-900 bg-white focus:border-indigo-500 focus:ring-indigo-500")" />
                                                    @if (isOver)
                                                    {
                                                         <div class="text-[10px] text-rose-500 mt-1 font-bold text-center">Exceeds maximum left to ship</div>
                                                    }
                                                </td>
                                            <td class="p-3 align-top"><DimensionSelect CompanyId="@shp.CompanyId" @bind-Value="line.DimensionSetId" Disabled="@(!IsShipmentEditable(shp))" /></td></tr>
                                        }
                                    </tbody>
                                </table></div>

                                <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-slate-100">
                                    @if (IsDraftShipment(shp))
                                    {
                                        <PermissionGate Key="SHIPMENT_CREATE">
                                            <Authorized>
                                                <button type="button"
                                                        @onclick="() => DeleteDraftShipment(shp)"
                                                        disabled="@isBusy"
                                                        class="px-5 py-2 rounded-xl text-rose-700 font-bold bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                                                    Delete Draft
                                                </button>
                                            </Authorized>
                                        </PermissionGate>
                                    }
                                    <button type="button" @onclick="() => expandedShipmentId = Guid.Empty" class="px-5 py-2 rounded-xl text-slate-600 font-bold hover:bg-slate-50 border border-slate-200 transition-colors">
                                        Cancel
                                    </button>
                                    <PermissionGate Key="SHIPMENT_DISPATCH">
                                        <Authorized>
                                            <button type="button" @onclick="() => ConfirmDispatch(shp)"
                                                     disabled="@(!IsShipmentEditable(shp) || shp.Lines.Any(l => l.QtyShipped > GetMaxLeftToShip(shp, l)) || !shp.Lines.Any(l => l.QtyShipped > 0))"
                                                    class="px-6 py-2 bg-indigo-600 text-white rounded-xl font-bold shadow-md hover:bg-indigo-700 transition-colors flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed active:scale-95">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                             <span>@(GetReviewStatus(shp) == BatchStatus.Rejected ? "Resubmit Dispatch for GL Review" : "Submit Dispatch for GL Review")</span>
                                            </button>
                                        </Authorized>
                                    </PermissionGate>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (activeTab == 1)
    {
        <section aria-label="Shipment history filters" class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:grid-cols-2 xl:grid-cols-4">
            <label class="text-xs font-bold text-slate-600 sm:col-span-2">Search history<input type="search" @bind="historySearch" @bind:event="oninput" @bind:after="ResetHistoryPage" placeholder="Document number, item or customer" class="mt-1 w-full rounded-xl border border-slate-200 p-2.5 text-sm font-normal" /></label>
            <label class="text-xs font-bold text-slate-600">From date<input type="date" @bind="historyFrom" @bind:after="ResetHistoryPage" class="mt-1 w-full rounded-xl border border-slate-200 p-2.5 text-sm font-normal" /></label>
            <label class="text-xs font-bold text-slate-600">To date<input type="date" @bind="historyTo" @bind:after="ResetHistoryPage" class="mt-1 w-full rounded-xl border border-slate-200 p-2.5 text-sm font-normal" /></label>
            <div class="flex flex-wrap items-center justify-between gap-3 sm:col-span-2 xl:col-span-4"><label class="flex items-center gap-2 text-xs font-bold text-slate-600">Rows per page<select @bind="historyPageSize" @bind:after="ResetHistoryPage" class="rounded-lg border border-slate-200 p-2"><option value="10">10</option><option value="20">20</option><option value="50">50</option><option value="100">100</option></select></label><button type="button" @onclick="ClearHistoryFilters" class="text-xs font-bold text-indigo-700">Clear filters</button></div>
            @if (historyFrom.HasValue && historyTo.HasValue && historyFrom > historyTo) { <p role="alert" class="text-sm text-rose-700 sm:col-span-2 xl:col-span-4">From date must be on or before To date.</p> }
        </section>
        <div class="bg-white border border-slate-200 rounded-2xl overflow-x-auto shadow-sm">
            <div class="transaction-lines-scroll" role="region" aria-label="Transaction line items" tabindex="0"><table class="transaction-lines w-full text-left text-sm text-slate-900 min-w-[800px]">
                <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="p-4 w-32">Date Shipped</th>
                        <th class="p-4">Shipment #</th>
                        <th class="p-4">Source document(s)</th>
                        <th class="p-4">Customer</th>
                        <th class="p-4">Warehouse</th>
                        <th class="p-4">Items Processed</th>
                        <th class="p-4">Confirmed By</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var h in PagedHistory)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="p-4 font-mono text-slate-600 text-xs">@(h.ShippedDate?.ToString("dd MMM, yyyy HH:mm") ?? "-")</td>
                            <td class="p-4 font-mono font-bold text-indigo-700">@h.ShipmentNumber</td>
                            <td class="p-4 font-mono text-xs font-bold text-slate-600">@GetShipmentOrderRefs(h)</td>
                            <td class="p-4 font-medium">@GetShipmentCustomer(h)</td>
                            <td class="p-4 text-xs font-bold text-slate-600">@(warehouses.FirstOrDefault(w => w.Id == h.WarehouseId)?.Name ?? "Unknown")</td>
                            <td class="p-4 text-sm">
                                @if (h.Lines != null)
                                {
                                    foreach (var l in h.Lines.Where(x => x.QtyShipped > 0))
                                    {
                                        <div class="text-xs mt-0.5">
                                            <span class="text-slate-700 font-medium">@l.Item?.Name</span>
                                             <span class="text-emerald-600 font-bold ml-1">(Qty: @UomConversion.FromBase(l.QtyShipped, UomConversion.NormalizeFactor(l.UomConversionFactor)).ToString("N4") @(string.IsNullOrWhiteSpace(l.UomName) ? "base" : l.UomName))</span>
                                        </div>
                                    }
                                }
                            </td>
                            <td class="p-4 text-xs text-slate-500 font-bold">@(h.ConfirmedBy ?? "Unknown")</td>
                        </tr>
                    }
                    @if (!FilteredHistory.Any())
                    {
                        <tr><td colspan="7" class="p-12 text-center text-slate-400">No shipment history matches these filters.</td></tr>
                    }
                </tbody>
            </table></div>
        </div>
        <nav aria-label="Shipment history pagination" class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600">
            <span aria-live="polite">@(HistoryCount == 0 ? 0 : (CurrentHistoryPage - 1) * historyPageSize + 1)–@Math.Min(CurrentHistoryPage * historyPageSize, HistoryCount) of @HistoryCount shipments</span>
            <div class="flex items-center gap-3"><button type="button" @onclick="() => historyPage = CurrentHistoryPage - 1" disabled="@(CurrentHistoryPage == 1)" class="rounded-lg border px-3 py-2 font-semibold disabled:opacity-40">Previous</button><span>Page @CurrentHistoryPage of @HistoryPages</span><button type="button" @onclick="() => historyPage = CurrentHistoryPage + 1" disabled="@(CurrentHistoryPage == HistoryPages)" class="rounded-lg border px-3 py-2 font-semibold disabled:opacity-40">Next</button></div>
        </nav>
    }
</div>

<!-- ROUTE CONFIGURATION MODAL -->
@if (showRouteModal && selectedShipmentForConfig != null)
{
    <div class="fixed inset-0 z-[120] flex items-start sm:items-center justify-center overflow-y-auto bg-slate-900/40 backdrop-blur-sm p-4 animate-in fade-in duration-200 route-config-overlay">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl border border-slate-200 animate-in zoom-in-95 duration-200 flex flex-col overflow-hidden route-config-dialog">

            <div class="p-5 border-b border-slate-100 bg-slate-50 flex justify-between items-center rounded-t-2xl">
                <div>
                    <h3 class="font-bold text-slate-800 uppercase tracking-wider text-xs">Shipment Dispatch GL Route Mapping</h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Inspect and override accounting routes for physical stock releases.</p>
                </div>
                <button type="button" @onclick="() => showRouteModal = false" class="text-slate-400 hover:text-rose-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            <div class="p-6 overflow-visible space-y-5 flex-1 route-config-body">
                <!-- Custom Template Profile Selector -->
                <div class="p-4 bg-indigo-50/50 rounded-xl border border-indigo-100 space-y-2 relative z-[60]">
                    <label class="block text-[10px] font-bold text-indigo-700 uppercase tracking-wider">Transaction Routing Profile</label>
                    <div class="flex items-center gap-2">
                        @if (selectedShipmentForConfig.CustomTransactionTypeId.HasValue)
                        {
                            <button type="button"
                                    @onclick="() => selectedShipmentForConfig.CustomTransactionTypeId = null"
                                    class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                    title="Reset to Standard Shipment Route">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                            </button>
                        }
                        <select value="@(selectedShipmentForConfig.CustomTransactionTypeId?.ToString() ?? "")" @onchange="OnCustomTemplateSelected"
                                class="w-full border border-slate-200 rounded-xl p-2.5 text-xs font-bold text-slate-900 bg-white focus:border-indigo-500 focus:outline-none transition-all flex-1">
                            <option value="">-- Standard Warehouse Dispatch Route (Default) --</option>
                            @foreach (var custom in customTemplates)
                            {
                                <option value="@custom.Id">@custom.Name (Custom Template)</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Live Ledger Breakdown Table -->
                <div class="space-y-3 overflow-visible">
                    <span class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Active GL Account Routing</span>

                    <div class="border border-slate-200 rounded-xl overflow-visible divide-y divide-slate-100 text-xs bg-white">

                        <!-- 1. Cost of Goods Sold (COGS - Debit) -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[50] rounded-t-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Cost of Goods Sold (COGS)</span>
                                <span class="text-[10px] text-indigo-600 font-bold uppercase">Debit Side</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (selectedShipmentForConfig.OverrideCogsGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => selectedShipmentForConfig.OverrideCogsGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="Default Line Item COGS Account"
                                                         Accounts="@allAccounts"
                                                         Value="@(selectedShipmentForConfig.OverrideCogsGlAccountId ?? defaultCogsAccountId)"
                                                         ValueChanged="@((Guid val) => selectedShipmentForConfig.OverrideCogsGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                        <!-- 2. Inventory Asset (Stock Out - Credit) -->
                        <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-center justify-between gap-2 relative z-[40] rounded-b-xl overflow-visible">
                            <div class="w-1/3">
                                <span class="font-bold text-slate-700 block">Inventory Stock Asset</span>
                                <span class="text-[10px] text-emerald-600 font-bold uppercase">Credit Side</span>
                            </div>
                            <div class="w-2/3 flex items-center gap-2 overflow-visible">
                                @if (selectedShipmentForConfig.OverrideInventoryAssetGlAccountId.HasValue)
                                {
                                    <button type="button"
                                            @onclick="() => selectedShipmentForConfig.OverrideInventoryAssetGlAccountId = null"
                                            class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 bg-white border border-rose-200 rounded-lg transition-colors shrink-0 shadow-sm"
                                            title="Clear Override">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    </button>
                                }
                                <div class="flex-1 overflow-visible relative">
                                    <SearchableGlAccount Label=""
                                                         Placeholder="Default Line Item Inventory Asset"
                                                         Accounts="@allAccounts"
                                                         Value="@(selectedShipmentForConfig.OverrideInventoryAssetGlAccountId ?? defaultInventoryAssetAccountId)"
                                                         ValueChanged="@((Guid val) => selectedShipmentForConfig.OverrideInventoryAssetGlAccountId = val == Guid.Empty ? null : val)" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="p-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3 rounded-b-2xl relative z-[10] route-config-footer">
                <button type="button" @onclick="() => showRouteModal = false" class="px-5 py-2 text-xs font-bold text-slate-600 hover:bg-slate-200 rounded-xl transition-colors">
                    Close
                </button>
                <button type="button" @onclick="ApplyRouteModalChanges" class="px-6 py-2 text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-md transition-all active:scale-95">
                    Apply to Dispatch
                </button>
            </div>
        </div>
    </div>
}

@code {
    private int activeTab = 1;
    private bool isLoading = true;
    private bool isBusy = false;
    private Guid companyId;
    private string currentUser = "System User";

    private string orderSearchTerm = "";
    private bool showOrderDropdown = false;
    private HashSet<Guid> selectedUnshippedOrderIds = new();
    private HashSet<Guid> selectedOrderLineIds = new();

    private List<SalesOrder> unshippedOrders = new();
    private List<Warehouse> warehouses = new();
    private List<SegChartOfAccount> allAccounts = new();

    private List<SalesShipment> shipments = new();
    private List<SalesShipment> history = new();
    private string historySearch = "";
    private DateTime? historyFrom, historyTo;
    private int historyPage = 1, historyPageSize = 20;
    private IEnumerable<SalesShipment> FilteredHistory => history.Where(x => (!ViewSourceId.HasValue || x.Id == ViewSourceId.Value)
        && (!historyFrom.HasValue || (x.ShippedDate ?? x.CreatedDate).Date >= historyFrom.Value.Date)
        && (!historyTo.HasValue || (x.ShippedDate ?? x.CreatedDate).Date <= historyTo.Value.Date)
        && (string.IsNullOrWhiteSpace(historySearch) || x.ShipmentNumber.Contains(historySearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || GetShipmentOrderRefs(x).Contains(historySearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || GetShipmentCustomer(x).Contains(historySearch.Trim(), StringComparison.OrdinalIgnoreCase)
            || x.Lines.Any(l => (l.Item?.Name ?? "").Contains(historySearch.Trim(), StringComparison.OrdinalIgnoreCase) || (l.Item?.Code ?? "").Contains(historySearch.Trim(), StringComparison.OrdinalIgnoreCase))))
        .OrderByDescending(x => x.ShippedDate ?? x.CreatedDate).ThenBy(x => x.Id);
    private int HistoryCount => FilteredHistory.Count();
    private int HistoryPages => Math.Max(1, (int)Math.Ceiling(HistoryCount / (double)historyPageSize));
    private int CurrentHistoryPage => Math.Clamp(historyPage, 1, HistoryPages);
    private IEnumerable<SalesShipment> PagedHistory => FilteredHistory.Skip((CurrentHistoryPage - 1) * historyPageSize).Take(historyPageSize);
    private void ResetHistoryPage() => historyPage = 1;
    private void ClearHistoryFilters() { historySearch = ""; historyFrom = historyTo = null; ResetHistoryPage(); }
    private Dictionary<Guid, decimal> postedShippedByOrderLine = new();
    private Dictionary<Guid, decimal> reservedDraftQuantities = new();
    private List<UnitOfMeasure> uoms = new();
    private List<ItemUomConversionLine> itemUomLines = new();
    private List<UomConversionRule> conversionRules = new();
    private IReadOnlyDictionary<(Guid From, Guid To), decimal> ConversionMap =>
        conversionRules.ToDictionary(x => (x.FromUomId, x.ToUomId), x => x.ConversionFactor);
    private Dictionary<Guid, BatchStatus> shipmentBatchStatuses = new();
    private Guid expandedShipmentId = Guid.Empty;
    private string currentUserId = "";
    private bool canConfigureRoute = false;
    // Route Configuration Modal State
    private bool showRouteModal = false;
    [SupplyParameterFromQuery(Name = "view")] public Guid? ViewSourceId { get; set; }
    private SalesShipment? selectedShipmentForConfig;
    private List<CustomTransactionType> customTemplates = new();
    private Guid defaultCogsAccountId = Guid.Empty;
    private Guid defaultInventoryAssetAccountId = Guid.Empty;

    private IEnumerable<SalesOrder> FilteredUnshippedOrders =>
        unshippedOrders.Where(o => o.Status != OrderStatus.Draft &&
                                (string.IsNullOrWhiteSpace(orderSearchTerm)
                                || o.OrderNumber.Contains(orderSearchTerm, StringComparison.OrdinalIgnoreCase)
                                || (o.Customer != null && o.Customer.Name.Contains(orderSearchTerm, StringComparison.OrdinalIgnoreCase))));

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("WH_SHIPMENTS_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentUserId = user.Id;
            currentUser = user.UserName ?? "System User";
            if (user.CompanyDetailsId != null)
            {
                companyId = user.CompanyDetailsId.Value;
                canConfigureRoute = await MappingService.IsRouteConfigVisibleAsync(companyId);
                allAccounts = await SegCoaService.GetCoaAsync(companyId);

                defaultCogsAccountId = await MappingService.GetMappedAccountAsync(
                    companyId, SystemTransactionType.ShipmentDispatch, isDebit: true, defaultAccountId: Guid.Empty);

                defaultInventoryAssetAccountId = await MappingService.GetMappedAccountAsync(
                    companyId, SystemTransactionType.ShipmentDispatch, isDebit: false, defaultAccountId: Guid.Empty);

                await LoadData();
                if (ViewSourceId.HasValue && history.Any(x => x.Id == ViewSourceId.Value)) activeTab = 1;
            }
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        warehouses = await WhService.GetWarehousesAsync(companyId, WarehouseType.Sales);
        await using (var uomCtx = await DbFactory.CreateDbContextAsync())
        {
            uoms = await uomCtx.UnitOfMeasures.AsNoTracking()
                .Where(u => u.CompanyId == companyId)
                .OrderBy(u => u.Name)
                .ToListAsync();
        }
        itemUomLines = await MasterService.GetItemUomConversionLinesAsync(companyId, true);
        conversionRules = await MasterService.GetUomConversionRulesAsync(companyId);
        shipments = await ShipmentService.GetPendingShipmentsAsync(companyId);
        foreach (var shipmentLine in shipments.SelectMany(s => s.Lines))
        {
            if (!shipmentLine.UomId.HasValue && shipmentLine.Item?.UomId is Guid primaryUomId)
            {
                shipmentLine.UomId = primaryUomId;
                shipmentLine.UomName = uoms.FirstOrDefault(u => u.Id == primaryUomId)?.Name ?? shipmentLine.Item.UoM;
                shipmentLine.UomConversionFactor = 1m;
            }
            else if (shipmentLine.UomConversionFactor <= 0)
            {
                shipmentLine.UomConversionFactor = 1m;
            }
        }
        var shipmentBatchIds = shipments.Where(s => s.ShipmentBatchId.HasValue).Select(s => s.ShipmentBatchId!.Value).ToList();
        await using (var ctx = await DbFactory.CreateDbContextAsync())
        {
            shipmentBatchStatuses = await ctx.GLBatches.AsNoTracking()
                .Where(b => shipmentBatchIds.Contains(b.Id) && b.CompanyId == companyId)
                .ToDictionaryAsync(b => b.Id, b => b.Status);
        }
        history = await ShipmentService.GetShipmentHistoryAsync(companyId);
        reservedDraftQuantities = shipments.SelectMany(s => s.Lines).ToDictionary(l => l.Id, l => l.QtyShipped);
        postedShippedByOrderLine = history
            .SelectMany(s => s.Lines)
            .Where(line => line.SalesOrderLineId.HasValue)
            .GroupBy(line => line.SalesOrderLineId!.Value)
            .ToDictionary(group => group.Key, group => group.Sum(line => line.QtyShipped));
        unshippedOrders = await ShipmentService.GetUnshippedOrdersAsync(companyId);
        isLoading = false;
        StateHasChanged();
    }

    private BatchStatus? GetReviewStatus(SalesShipment shipment) =>
        shipment.ShipmentBatchId.HasValue && shipmentBatchStatuses.TryGetValue(shipment.ShipmentBatchId.Value, out var status)
            ? status : null;

    private bool IsShipmentEditable(SalesShipment shipment) =>
        GetReviewStatus(shipment) is null or BatchStatus.Draft or BatchStatus.Rejected;

    private bool IsDraftShipment(SalesShipment shipment) =>
        shipment.Status == ShipmentStatus.Pending
        && (GetReviewStatus(shipment) is null or BatchStatus.Draft);

    private SalesOrderLine? GetInvoiceLine(SalesShipment shipment, SalesShipmentLine line) =>
        line.SalesOrderLine ?? shipment.SalesOrder?.Lines?.FirstOrDefault(orderLine => orderLine.Id == line.SalesOrderLineId);

    private decimal GetInvoiceQuantity(SalesShipment shipment, SalesShipmentLine line) =>
        line.SalesInvoiceLine?.QuantityInvoiced ?? GetInvoiceLine(shipment, line)?.Quantity ?? line.QtyOrdered;

    private decimal GetPreviouslyShipped(SalesShipment shipment, SalesShipmentLine line) =>
        Math.Max(0,
            line.SalesOrderLineId.HasValue && postedShippedByOrderLine.TryGetValue(line.SalesOrderLineId.Value, out var postedQty)
                ? postedQty
                : GetInvoiceLine(shipment, line)?.QtyShipped ?? 0);

    private decimal GetMaxLeftToShip(SalesShipment shipment, SalesShipmentLine line) =>
        line.SalesInvoiceLineId.HasValue ? reservedDraftQuantities.GetValueOrDefault(line.Id)
        : Math.Max(0, line.QtyOrdered - GetPreviouslyShipped(shipment, line));

    private string ReviewLabel(BatchStatus? status) => status switch
    {
        BatchStatus.Ready => "In Review",
        BatchStatus.Rejected => "Rejected - Edit Required",
        BatchStatus.Posted => "Posted - Dispatch Pending",
        _ => "Draft - Not Submitted"
    };

    private string ReviewPillClass(BatchStatus? status) => status switch
    {
        BatchStatus.Ready => "text-amber-700 bg-amber-50 border border-amber-200",
        BatchStatus.Rejected => "text-rose-700 bg-rose-50 border border-rose-200",
        BatchStatus.Posted => "text-emerald-700 bg-emerald-50 border border-emerald-200",
        _ => "text-slate-600 bg-slate-100 border border-slate-200"
    };

    private void HandleInput()
    {
        showOrderDropdown = true;
    }

    private void SelectOrder(SalesOrder o)
    {
        var ids = o.Lines.Where(l => l.Item != null && !l.Item.IsService).Select(l => l.Id).ToList();
        if (ids.All(id => selectedOrderLineIds.Contains(id))) { foreach (var id in ids) selectedOrderLineIds.Remove(id); selectedUnshippedOrderIds.Remove(o.Id); }
        else { foreach (var id in ids) selectedOrderLineIds.Add(id); selectedUnshippedOrderIds.Add(o.Id); }
    }
    private void ToggleOrderLine(SalesOrder order, Guid id, ChangeEventArgs e)
    {
        if (e.Value is bool b && b) selectedOrderLineIds.Add(id); else selectedOrderLineIds.Remove(id);
        if (order.Lines.Any(l => selectedOrderLineIds.Contains(l.Id))) selectedUnshippedOrderIds.Add(order.Id); else selectedUnshippedOrderIds.Remove(order.Id);
    }

    private async Task PullOrderToQueue()
    {
        // Allow an exact order search to be loaded without clicking its checkbox.
        if (selectedUnshippedOrderIds.Count == 0 && !string.IsNullOrWhiteSpace(orderSearchTerm))
        {
            var match = unshippedOrders.FirstOrDefault(o =>
                o.OrderNumber.Equals(orderSearchTerm.Trim(), StringComparison.OrdinalIgnoreCase) ||
                $"{o.OrderNumber} - {o.Customer?.Name}".Equals(orderSearchTerm.Trim(), StringComparison.OrdinalIgnoreCase));

            if (match != null)
            {
                SelectOrder(match);
            }
        }

        if (selectedUnshippedOrderIds.Count == 0)
        {
            await JS.InvokeVoidAsync("alert", "Please select at least one eligible sales order.");
            return;
        }

        isBusy = true;
        StateHasChanged();

        var selectedLineIds = selectedOrderLineIds.ToList();
        var err = await ShipmentService.CreateShipmentFromOrderLinesAsync(selectedLineIds);
        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
        }
        else
        {
            selectedUnshippedOrderIds.Clear();
            selectedOrderLineIds.Clear();
            orderSearchTerm = "";
            showOrderDropdown = false;
            await LoadData();
        }

        isBusy = false;
        StateHasChanged();
    }

    private string GetWarehouseName(Guid warehouseId) => warehouses.FirstOrDefault(w => w.Id == warehouseId)?.Name ?? "No warehouse";

    private static string GetShipmentOrderRefs(SalesShipment shipment)
    {
        var refs = shipment.Lines.Select(l => l.SalesInvoiceLine?.SalesInvoice?.InvoiceNumber ?? l.SalesOrderLine?.Header?.OrderNumber)
            .Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().ToList();
        if (refs.Count == 0 && shipment.SalesOrder != null) refs.Add(shipment.SalesOrder.OrderNumber);
        return refs.Count > 0 ? string.Join(", ", refs) : "—";
    }

    private static string GetShipmentCustomer(SalesShipment shipment) =>
        shipment.Lines.Select(l => l.SalesInvoiceLine?.SalesInvoice?.Customer?.Name ?? l.SalesOrderLine?.Header?.Customer?.Name).FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
        ?? shipment.SalesOrder?.Customer?.Name ?? "—";

    private void ToggleExpand(Guid id)
    {
        expandedShipmentId = expandedShipmentId == id ? Guid.Empty : id;
    }

    private async Task DeleteDraftShipment(SalesShipment shipment)
    {
        if (!IsDraftShipment(shipment) || isBusy) return;

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete shipment draft {shipment.ShipmentNumber}? This cannot be undone.");
        if (!confirmed) return;

        isBusy = true;
        try
        {
            var error = await ShipmentService.DeleteDraftShipmentAsync(companyId, shipment.Id, currentUserId);
            if (!string.IsNullOrWhiteSpace(error))
            {
                await JS.InvokeVoidAsync("alert", error);
                return;
            }

            expandedShipmentId = Guid.Empty;
            await LoadData();
        }
        finally
        {
            isBusy = false;
        }
    }

    private decimal GetLineFactor(SalesShipmentLine line) => UomConversion.NormalizeFactor(line.UomConversionFactor);

    private string GetLineUomName(SalesShipmentLine line) =>
        string.IsNullOrWhiteSpace(line.UomName)
            ? uoms.FirstOrDefault(u => u.Id == line.UomId)?.Name ?? line.Item?.UoM ?? "base"
            : line.UomName;

    private IEnumerable<UomOption> GetUomOptions(SalesShipmentLine line)
    {
        var item = line.Item;
        if (item == null) yield break;

        if (item.UomId.HasValue)
        {
            var primaryName = uoms.FirstOrDefault(u => u.Id == item.UomId.Value)?.Name ?? item.UoM;
            yield return new UomOption(item.UomId.Value, primaryName, 1m);
        }

        foreach (var conversion in itemUomLines.Where(x => x.ItemId == item.Id && x.UomId != item.UomId))
        {
            var name = conversion.Uom?.Name ?? uoms.FirstOrDefault(u => u.Id == conversion.UomId)?.Name ?? "UOM";
            var factors = itemUomLines.Where(x => x.ItemId == item.Id).GroupBy(x => x.UomId).ToDictionary(x => x.Key, x => x.First().ConversionFactorToBase);
            yield return new UomOption(conversion.UomId, name, UomConversion.FactorFor(item, conversion.UomId, factors, ConversionMap));
        }

        if (item.UomId.HasValue)
        {
            foreach (var uomId in UomConversion.ConfiguredUoms(item))
            {
                if (uomId == item.UomId.Value || itemUomLines.Any(x => x.ItemId == item.Id && x.UomId == uomId)) continue;
                yield return new UomOption(uomId, uoms.FirstOrDefault(x => x.Id == uomId)?.Name ?? "UOM", UomConversion.FactorFor(item, uomId));
            }
        }

    }

    private void OnUomChanged(SalesShipmentLine line, Guid? selectedId)
    {
        if (!selectedId.HasValue) return;
        var option = GetUomOptions(line).FirstOrDefault(x => x.Id == selectedId.Value);
        if (option == null) return;

        line.UomId = option.Id;
        line.UomName = option.Name;
        line.UomConversionFactor = option.Factor;
        StateHasChanged();
    }

    private void ValidateQuantity(SalesShipmentLine line, string? val)
    {
        if (TryParseDecimal(val, out decimal res))
        {
            line.QtyShipped = res < 0 ? 0 : UomConversion.ToBase(res, GetLineFactor(line));
        }
        else line.QtyShipped = 0;
        StateHasChanged();
    }

    private static bool TryParseDecimal(string? value, out decimal result) =>
        decimal.TryParse(value, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out result)
        || decimal.TryParse(value, out result);

    private sealed record UomOption(Guid Id, string Name, decimal Factor);

    private async Task OpenRouteModal(SalesShipment shp)
    {
        selectedShipmentForConfig = shp;

        using var ctx = await DbFactory.CreateDbContextAsync();
        customTemplates = await ctx.CustomTransactionTypes
            .AsNoTracking()
            .Where(t => t.CompanyId == companyId && (t.Module == TransactionTemplateModule.General || t.Module == TransactionTemplateModule.AR))
            .OrderBy(t => t.Name)
            .ToListAsync();

        showRouteModal = true;
    }

    private async Task OnCustomTemplateSelected(ChangeEventArgs e)
    {
        if (selectedShipmentForConfig == null) return;

        var val = e.Value?.ToString();
        if (Guid.TryParse(val, out var customId) && customId != Guid.Empty)
        {
            selectedShipmentForConfig.CustomTransactionTypeId = customId;

            using var ctx = await DbFactory.CreateDbContextAsync();
            var map = await ctx.TransactionGlMappings
                .AsNoTracking()
                .FirstOrDefaultAsync(m => m.CompanyId == companyId && m.CustomTransactionTypeId == customId);

            if (map != null)
            {
                if (map.OverrideDebitGlAccountId.HasValue)
                    selectedShipmentForConfig.OverrideCogsGlAccountId = map.OverrideDebitGlAccountId.Value;

                if (map.OverrideCreditGlAccountId.HasValue)
                    selectedShipmentForConfig.OverrideInventoryAssetGlAccountId = map.OverrideCreditGlAccountId.Value;
            }
        }
        else
        {
            selectedShipmentForConfig.CustomTransactionTypeId = null;
        }
    }

    private async Task ApplyRouteModalChanges()
    {
        if (selectedShipmentForConfig != null)
        {
            var err = await ShipmentService.UpdateShipmentRouteAsync(
                selectedShipmentForConfig.Id,
                selectedShipmentForConfig.CustomTransactionTypeId,
                selectedShipmentForConfig.OverrideCogsGlAccountId,
                selectedShipmentForConfig.OverrideInventoryAssetGlAccountId);

            if (!string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", err);
                return;
            }
        }

        showRouteModal = false;
        StateHasChanged();
    }

    private async Task ConfirmDispatch(SalesShipment shp)
    {
        if (shp == null || shp.Lines == null || shp.Lines.Count == 0)
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: This shipment has no dispatch lines.");
            return;
        }

        var invalidLines = shp.Lines
            .Where(line => line.QtyShipped < 0
                || line.UomConversionFactor <= 0
                || line.QtyShipped > GetMaxLeftToShip(shp, line) + 0.0001m)
            .ToList();

        if (invalidLines.Any())
        {
            var first = invalidLines[0];
            await JS.InvokeVoidAsync("alert",
                $"Validation Error: {first.Item?.Name ?? "This item"} exceeds the quantity available for dispatch. Previously shipped: {GetPreviouslyShipped(shp, first):N2}; maximum left to ship: {GetMaxLeftToShip(shp, first):N2}.");
            return;
        }

        if (!shp.Lines.Any(l => l.QtyShipped > 0.0001m))
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: You must dispatch at least one physical item quantity.");
            return;
        }

        bool isPartial = shp.Lines.Any(l => l.QtyShipped < GetMaxLeftToShip(shp, l));
        string msg = isPartial
            ? "You are doing a partial shipment. After approval, create another shipment for the remaining quantity. Submit this dispatch for GL review?"
            : "Submit this physical dispatch for GL review?";

        bool confirm = await JS.InvokeAsync<bool>("confirm", msg);
        if (!confirm) return;

        var err = await ShipmentService.PostShipmentAsync(shp.Id, shp.Lines, currentUser, currentUserId);

        if (!string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", err);
        }
        else
        {
            await JS.InvokeVoidAsync("alert", $"Dispatch {shp.ShipmentNumber} was submitted for GL review. It will be committed after reviewer approval.");
            expandedShipmentId = Guid.Empty;
            await LoadData();
        }
    }
}
