@page "/procurement/goods-receipt/{poId:guid?}"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject PurchasingService PurchService
@inject MasterDataService MasterService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-4xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Receive Goods</h1>
            <p class="text-sm text-slate-500">Process inbound stock from Vendor PO.</p>
        </div>
        <a href="procurement/purchase-orders" class="px-4 py-2 bg-slate-100 text-slate-600 rounded-lg text-sm font-bold hover:bg-slate-200">Back to Orders</a>
    </div>

    @if (currentReceipt != null)
    {
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-lg">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                <div>
                    <label class="label">GRN Reference</label>
                    <input @bind="currentReceipt.GrnNumber" class="input-class font-mono uppercase" placeholder="GRN-..." />
                </div>
                <div>
                    <label class="label">Date Received</label>
                    <input type="date" @bind="currentReceipt.DateReceived" class="input-class" />
                </div>
                <div>
                    <label class="label text-indigo-600">Receiving Warehouse</label>
                    <select @bind="selectedWarehouseId" class="input-class border-indigo-200 bg-indigo-50/30 font-bold text-indigo-700">
                        <option value="@Guid.Empty">-- Select Warehouse --</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="border rounded-xl overflow-hidden">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-50 text-xs uppercase font-bold text-slate-500">
                        <tr>
                            <th class="p-3 pl-4">Item</th>
                            <th class="p-3 text-right">Ordered</th>
                            <th class="p-3 text-right">Cost (Unit)</th>
                            <th class="p-3 text-right w-40">Received Now</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var line in currentReceipt.Lines)
                        {
                            var poLine = poLines.FirstOrDefault(pl => pl.Id == line.PurchaseOrderLineId);
                            var itemName = items.FirstOrDefault(i => i.Id == poLine?.ItemId)?.Name;

                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="p-3 pl-4">
                                    <div class="font-bold text-slate-700">@itemName</div>
                                    <div class="text-xs text-slate-400">SKU: @items.FirstOrDefault(i => i.Id == poLine?.ItemId)?.SKU</div>
                                </td>
                                <td class="p-3 text-right text-slate-400">@poLine?.QuantityOrdered.ToString("N0")</td>
                                <td class="p-3 text-right text-slate-400">@poLine?.UnitCost.ToString("N2")</td>
                                <td class="p-3">
                                    <input type="number" @bind="line.QuantityReceived" class="input-class py-1 text-center font-bold text-emerald-600 border-emerald-200 focus:border-emerald-500 focus:ring-emerald-200" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-6 flex justify-end items-center gap-4">
                <div class="text-xs text-slate-400 max-w-xs text-right">
                    Clicking confirm will increase stock levels and post a Journal Entry (Dr Inventory / Cr Accounts Payable).
                </div>
                <button @onclick="SaveReceipt" class="px-8 py-3 bg-emerald-600 text-white rounded-xl font-bold shadow-lg hover:bg-emerald-700 transition-transform active:scale-95 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    Confirm & Post
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="p-12 text-center text-slate-400 animate-pulse">Loading Order Data...</div>
    }
</div>

<style>
    .label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        margin-bottom: 0.25rem;
    }

    .input-class {
        width: 100%;
        border-radius: 0.5rem;
        border: 1px solid #cbd5e1;
        padding: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s;
    }

        .input-class:focus {
            border-color: #4f46e5;
            outline: none;
            ring: 2px;
            ring-color: #e0e7ff;
        }
</style>

@code {
    [Parameter] public Guid? poId { get; set; }

    private GoodsReceipt? currentReceipt;
    private List<PurchaseOrderLine> poLines = new();
    private List<Item> items = new();
    private List<Warehouse> warehouses = new();
    private Guid currentCompanyId;
    private Guid selectedWarehouseId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        if (user?.CompanyDetailsId != null && poId.HasValue)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            items = await MasterService.GetItemsAsync(currentCompanyId);

            using var ctx = await DbFactory.CreateDbContextAsync();
            warehouses = await ctx.Warehouses.Where(w => w.CompanyId == currentCompanyId).ToListAsync();

            // Load PO
            var po = await ctx.PurchaseOrders.Include(p => p.Lines).FirstOrDefaultAsync(p => p.Id == poId.Value);

            if (po != null)
            {
                poLines = po.Lines;

                // Initialize Receipt with ALL lines
                currentReceipt = new GoodsReceipt
                {
                    CompanyId = currentCompanyId,
                    PurchaseOrderId = po.Id,
                    GrnNumber = $"GRN-{po.OrderNumber}-{DateTime.Now:HHmm}",
                    DateReceived = DateTime.Today,
                    Lines = po.Lines.Select(l => new GoodsReceiptLine
                    {
                        PurchaseOrderLineId = l.Id,
                        QuantityReceived = l.QuantityOrdered // Default to full receipt
                    }).ToList()
                };
            }
        }
    }

    private async Task SaveReceipt()
    {
        if (currentReceipt == null) return;
        if (selectedWarehouseId == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "Please select a Warehouse to receive goods into.");
            return;
        }

        var err = await PurchService.SaveGoodsReceiptAsync(currentReceipt, selectedWarehouseId);

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Goods Received Successfully! Stock updated.");
            // Optional: NavManager.NavigateTo("/procurement/purchase-orders");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }
    }
}