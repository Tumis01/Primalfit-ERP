@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services

<section aria-labelledby="sequence-editor-title" class="overflow-hidden rounded-2xl border border-indigo-200 bg-white shadow-sm">
    <header class="flex flex-col justify-between gap-4 border-b border-slate-200 bg-gradient-to-r from-indigo-50 via-white to-white p-5 sm:flex-row sm:items-start sm:p-6">
        <div class="flex items-start gap-3">
            <span aria-hidden="true" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-indigo-600 text-lg font-black text-white">✎</span>
            <div>
                <div class="text-xs font-bold uppercase tracking-widest text-indigo-700">Sequence builder</div>
                <h2 id="sequence-editor-title" class="mt-1 text-lg font-bold text-slate-950">@(Definition.Id == Guid.Empty ? "Create a sequence" : "Edit sequence")</h2>
                <p class="mt-1 max-w-2xl text-sm leading-5 text-slate-600">Set a name, choose when the count resets, then arrange the parts from left to right.</p>
            </div>
        </div>
        <button type="button" disabled="@IsSaving" @onclick="() => OnCancel.InvokeAsync()" class="self-end rounded-lg px-3 py-2 text-sm font-semibold text-slate-500 transition hover:bg-slate-100 hover:text-slate-800 disabled:opacity-50 sm:self-auto">Close editor</button>
    </header>

    <div class="space-y-6 p-5 sm:p-6">
        <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_280px]">
            <label class="block">
                <span class="mb-1.5 block text-sm font-semibold text-slate-800">Sequence name <span class="text-rose-600">*</span></span>
                <InputText @bind-Value="Definition.Name" @bind-Value:after="NotifyChanged" maxlength="100" autocomplete="off" class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" placeholder="For example: Regional invoice numbers" />
                <span class="mt-1 block text-xs text-slate-500">A clear name helps your team choose the right format.</span>
            </label>
            <label class="block">
                <span class="mb-1.5 block text-sm font-semibold text-slate-800">Reset count</span>
                <InputSelect @bind-Value="Definition.ResetInterval" @bind-Value:after="NotifyChanged" class="w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-slate-900 outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">
                    @foreach (var reset in Enum.GetValues<ResetInterval>())
                    {
                        <option value="@reset">@ResetLabel(reset)</option>
                    }
                </InputSelect>
                <span class="mt-1 block text-xs text-slate-500">Controls when the next number starts again at 1.</span>
            </label>
            <label class="block lg:col-span-2">
                <span class="mb-1.5 block text-sm font-semibold text-slate-800">Description <span class="font-normal text-slate-400">(optional)</span></span>
                <InputText @bind-Value="Definition.Description" @bind-Value:after="NotifyChanged" maxlength="500" autocomplete="off" class="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100" placeholder="Explain when this sequence should be used" />
            </label>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-4 sm:p-5">
            <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
                <div>
                    <h3 class="font-bold text-slate-900">Build the number format</h3>
                    <p class="mt-1 text-sm text-slate-500">Add a row for each part, then choose its component type. Every sequence needs one sequence number.</p>
                </div>
            </div>

            @if (Definition.Components.Count == 0)
            {
                <div class="mt-4 rounded-xl border border-dashed border-slate-300 bg-white px-4 py-8 text-center">
                    <div aria-hidden="true" class="text-2xl text-slate-300">＋</div>
                    <div class="mt-2 text-sm font-bold text-slate-700">Add the first row</div>
                    <p class="mt-1 text-xs text-slate-500">Choose a component type for each row you add.</p>
                    <button type="button" disabled="@IsSaving" @onclick="AddRow" class="mt-3 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700 disabled:opacity-50">+ Add row</button>
                </div>
            }
            else
            {
                <ol aria-label="Sequence format parts" class="mt-4 space-y-3">
                    @foreach (var component in OrderedComponents)
                    {
                        var position = component.OrderIndex;
                        <li @key="component.Id" class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm sm:p-4">
                            <div class="mb-3 flex items-center justify-between gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="grid h-7 w-7 place-items-center rounded-lg bg-slate-100 font-mono text-xs font-bold text-slate-600">@(position + 1)</span>
                                    <span class="text-xs font-bold uppercase tracking-wide text-slate-500">Format row</span>
                                </div>
                                <div role="group" aria-label="Reorder or remove part @(position + 1)" class="flex items-center gap-1">
                                    <button type="button" disabled="@IsSaving" aria-label="Remove part @(position + 1)" title="Remove part" @onclick="() => Remove(component)" class="ml-1 rounded-lg px-2.5 py-1.5 text-xs font-bold text-rose-600 transition hover:bg-rose-50 disabled:opacity-40">Remove</button>
                                </div>
                            </div>
                            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_130px_minmax(0,1.15fr)]">
                                <label class="block">
                                    <span class="mb-1 block text-xs font-semibold text-slate-600">Part type</span>
                                    <select value="@(IsUnconfigured(component) ? string.Empty : component.ComponentType.ToString())" @onchange="args => ChangeType(component, args.Value?.ToString())" disabled="@IsSaving" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm text-slate-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 disabled:bg-slate-100">
                                        <option value="">Select a component type…</option>
                                        @foreach (var type in Enum.GetValues<SequenceComponentType>())
                                        {
                                            <option value="@type" disabled="@(type == SequenceComponentType.SequenceNumber && component.ComponentType != SequenceComponentType.SequenceNumber && HasSequenceNumber)">@ComponentLabel(type)</option>
                                        }
                                    </select>
                                </label>
                                <label class="block">
                                    <span class="mb-1 block text-xs font-semibold text-slate-600">Length</span>
                                    <InputNumber @bind-Value="component.Length" @bind-Value:after="() => NormalizeLength(component)" min="@MinLength(component.ComponentType)" max="@MaxLength(component.ComponentType)" disabled="@(IsSaving || IsUnconfigured(component) || IsFixedLength(component.ComponentType))" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm text-slate-800 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 disabled:bg-slate-100" />
                                    <span class="mt-1 block text-[11px] leading-4 text-slate-400">@(IsUnconfigured(component) ? "Choose a type first" : LengthHint(component.ComponentType))</span>
                                </label>
                                <div>
                                    <span class="mb-1 block text-xs font-semibold text-slate-600">Formula / value</span>
                                    @if (IsUnconfigured(component))
                                    {
                                        <div class="flex min-h-[42px] items-center rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-400">Choose a component type first</div>
                                    }
                                    else if (component.ComponentType == SequenceComponentType.Constant)
                                    {
                                        <InputText @bind-Value="component.Formula" @bind-Value:after="NotifyChanged" maxlength="20" autocomplete="off" disabled="@IsSaving" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 font-mono text-sm text-slate-900 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 disabled:bg-slate-100" placeholder="Enter constant" />
                                        <span class="mt-1 block text-[11px] leading-4 text-slate-400">Enter exactly @component.Length character(s).</span>
                                    }
                                    else
                                    {
                                        <div class="flex min-h-[42px] items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5">
                                            <span class="font-mono text-sm font-bold tracking-widest text-indigo-700">@Formula(component)</span>
                                            <span class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Automatic</span>
                                        </div>
                                        <span class="mt-1 block text-[11px] leading-4 text-slate-400">Filled from the sequence count or document date.</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ol>
                <button type="button" disabled="@IsSaving" @onclick="AddRow" class="mt-3 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700 disabled:opacity-50">+ Add row</button>
            }
        </div>

        <section aria-label="Format preview" class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(250px,0.7fr)]">
            <div class="min-w-0 rounded-2xl border border-indigo-200 bg-indigo-50/70 p-4 sm:p-5">
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <div><div class="text-xs font-bold uppercase tracking-widest text-indigo-700">Live example</div><p class="mt-1 text-xs text-indigo-800/70">Uses today’s date and the first sequence number.</p></div>
                    <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-indigo-100">@PreviewLength characters</span>
                </div>
                <div class="mt-4 max-w-full overflow-x-auto rounded-xl border border-indigo-100 bg-white px-4 py-3 font-mono text-xl font-bold tracking-wide text-slate-900 sm:text-2xl">@(string.IsNullOrEmpty(Preview) ? "Your format will appear here" : Preview)</div>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5">
                <div class="text-xs font-bold uppercase tracking-widest text-slate-500">Reset behavior</div>
                <div class="mt-2 font-bold text-slate-900">@ResetLabel(Definition.ResetInterval)</div>
                <p class="mt-1 text-sm leading-5 text-slate-500">@ResetHint(Definition.ResetInterval)</p>
                <div class="mt-4 border-t border-slate-100 pt-3 text-xs leading-5 text-slate-500">Numbers are reserved when a new record starts. If someone abandons a draft, that number may remain unused.</div>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            <div role="alert" class="flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
                <span aria-hidden="true" class="font-bold">!</span><span>@validationMessage</span>
            </div>
        }

        <footer class="flex flex-col-reverse justify-between gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:items-center">
            <p class="text-xs leading-5 text-slate-500">Saving an active format changes future numbers. Existing records keep their assigned numbers.</p>
            <div class="flex justify-end gap-2">
                <button type="button" disabled="@IsSaving" @onclick="() => OnCancel.InvokeAsync()" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-bold text-slate-700 transition hover:bg-slate-50 disabled:opacity-50">Cancel</button>
                <button type="button" disabled="@IsSaving" @onclick="Save" class="inline-flex min-w-36 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-200 disabled:cursor-wait disabled:opacity-60">
                    @if (IsSaving) { <span class="animate-spin" aria-hidden="true">◌</span><span>Saving…</span> }
                    else { <span>Save sequence</span> }
                </button>
            </div>
        </footer>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SequenceDefinition Definition { get; set; } = new();
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback<SequenceDefinition> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? validationMessage;
    private readonly HashSet<Guid> unconfiguredRowIds = new();
    private SequenceDefinition? lastDefinition;
    private List<SequenceComponent> OrderedComponents => Definition.Components.OrderBy(x => x.OrderIndex).ToList();
    private bool HasSequenceNumber => Definition.Components.Any(x => !IsUnconfigured(x) && x.ComponentType == SequenceComponentType.SequenceNumber);
    private string Preview => string.Concat(OrderedComponents.Where(x => !IsUnconfigured(x)).Select(x => x.ComponentType switch
    {
        SequenceComponentType.Constant => x.Formula ?? string.Empty,
        SequenceComponentType.SequenceNumber => "1".PadLeft(Math.Clamp(x.Length, 1, 20), '0'),
        SequenceComponentType.Year => (DateTime.Today.Year % (int)Math.Pow(10, Math.Clamp(x.Length, 2, 4))).ToString().PadLeft(Math.Clamp(x.Length, 2, 4), '0'),
        SequenceComponentType.Month => DateTime.Today.ToString("MM"),
        SequenceComponentType.Day => DateTime.Today.ToString("dd"),
        SequenceComponentType.FiscalYear => (DateTime.Today.Year % (int)Math.Pow(10, Math.Clamp(x.Length, 1, 3))).ToString().PadLeft(Math.Clamp(x.Length, 1, 3), '0'),
        _ => string.Empty
    }));
    private int PreviewLength => OrderedComponents.Where(x => !IsUnconfigured(x)).Sum(x => Math.Max(0, x.Length));

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(lastDefinition, Definition))
        {
            lastDefinition = Definition;
            unconfiguredRowIds.Clear();
            validationMessage = null;
        }
    }

    private bool IsUnconfigured(SequenceComponent component) => unconfiguredRowIds.Contains(component.Id);

    private async Task NotifyChanged()
    {
        validationMessage = unconfiguredRowIds.Count > 0 ? null : DocumentNumberingService.ValidateDefinition(Definition);
        await OnChanged.InvokeAsync();
    }

    private void AddRow()
    {
        var component = new SequenceComponent
        {
            Id = Guid.NewGuid(),
            SequenceDefinitionId = Definition.Id,
            OrderIndex = Definition.Components.Count,
            ComponentType = SequenceComponentType.Constant,
            Length = 1,
            Formula = null
        };
        Definition.Components.Add(component);
        unconfiguredRowIds.Add(component.Id);
        Reindex();
        validationMessage = null;
    }

    private async Task ChangeType(SequenceComponent component, string? value)
    {
        if (!Enum.TryParse<SequenceComponentType>(value, out var type))
        {
            component.ComponentType = SequenceComponentType.Constant;
            component.Length = 1;
            component.Formula = null;
            unconfiguredRowIds.Add(component.Id);
            await NotifyChanged();
            return;
        }
        if (type == SequenceComponentType.SequenceNumber && component.ComponentType != type && HasSequenceNumber) return;
        unconfiguredRowIds.Remove(component.Id);
        component.ComponentType = type;
        component.Length = type switch
        {
            SequenceComponentType.SequenceNumber => 4,
            SequenceComponentType.Year => 4,
            SequenceComponentType.Month or SequenceComponentType.Day => 2,
            SequenceComponentType.FiscalYear => 3,
            _ => 1
        };
        component.Formula = type == SequenceComponentType.Constant ? string.Empty : FormulaValue(type, component.Length);
        await NotifyChanged();
    }

    private async Task NormalizeLength(SequenceComponent component)
    {
        component.Length = Math.Clamp(component.Length, MinLength(component.ComponentType), MaxLength(component.ComponentType));
        await NotifyChanged();
    }

    private async Task Remove(SequenceComponent component)
    {
        Definition.Components.Remove(component);
        unconfiguredRowIds.Remove(component.Id);
        Reindex();
        await NotifyChanged();
    }

    private async Task Move(SequenceComponent component, int delta)
    {
        var ordered = OrderedComponents;
        var index = ordered.IndexOf(component);
        var destination = index + delta;
        if (index < 0 || destination < 0 || destination >= ordered.Count) return;
        (ordered[index], ordered[destination]) = (ordered[destination], ordered[index]);
        Definition.Components = ordered;
        Reindex();
        await NotifyChanged();
    }

    private void Reindex()
    {
        var ordered = OrderedComponents;
        for (var i = 0; i < ordered.Count; i++) ordered[i].OrderIndex = i;
        Definition.Components = ordered;
    }

    private async Task Save()
    {
        if (IsSaving) return;
        if (unconfiguredRowIds.Count > 0)
        {
            validationMessage = "Choose a component type for every row before saving.";
            return;
        }
        validationMessage = DocumentNumberingService.ValidateDefinition(Definition);
        if (validationMessage is not null) return;
        await OnSave.InvokeAsync(Definition);
    }

    private static int MinLength(SequenceComponentType type) => type switch
    {
        SequenceComponentType.Year => 2,
        SequenceComponentType.FiscalYear or SequenceComponentType.Constant or SequenceComponentType.SequenceNumber => 1,
        _ => 2
    };

    private static int MaxLength(SequenceComponentType type) => type switch
    {
        SequenceComponentType.Year => 4,
        SequenceComponentType.FiscalYear => 3,
        SequenceComponentType.Constant or SequenceComponentType.SequenceNumber => 20,
        _ => 2
    };

    private static bool IsFixedLength(SequenceComponentType type) => type is SequenceComponentType.Month or SequenceComponentType.Day;

    private static string LengthHint(SequenceComponentType type) => type switch
    {
        SequenceComponentType.Constant => "1–20 characters",
        SequenceComponentType.SequenceNumber => "1–20 digits, starts at 1",
        SequenceComponentType.Year => "2–4 digits of the calendar year",
        SequenceComponentType.Month => "Fixed at 2 digits",
        SequenceComponentType.Day => "Fixed at 2 digits",
        SequenceComponentType.FiscalYear => "1–3 digits of the fiscal year",
        _ => string.Empty
    };

    private static string Formula(SequenceComponent component) => component.ComponentType switch
    {
        SequenceComponentType.SequenceNumber => new string('0', Math.Clamp(component.Length, 1, 20)),
        SequenceComponentType.Year => new string('Y', Math.Clamp(component.Length, 2, 4)),
        SequenceComponentType.Month => "MM",
        SequenceComponentType.Day => "DD",
        SequenceComponentType.FiscalYear => "FY",
        _ => component.Formula ?? string.Empty
    };

    private static string FormulaValue(SequenceComponentType type, int length) => type switch
    {
        SequenceComponentType.SequenceNumber => new string('0', length),
        SequenceComponentType.Year => new string('Y', length),
        SequenceComponentType.Month => "MM",
        SequenceComponentType.Day => "DD",
        SequenceComponentType.FiscalYear => "FY",
        _ => string.Empty
    };

    private static string ComponentLabel(SequenceComponentType type) => type switch
    {
        SequenceComponentType.Constant => "Constant",
        SequenceComponentType.SequenceNumber => "Sequence number",
        SequenceComponentType.Year => "Year",
        SequenceComponentType.Month => "Month",
        SequenceComponentType.Day => "Day",
        SequenceComponentType.FiscalYear => "Fiscal year",
        _ => type.ToString()
    };

    private static string ResetLabel(ResetInterval reset) => reset switch
    {
        ResetInterval.Never => "Never",
        ResetInterval.Monthly => "Monthly",
        ResetInterval.Yearly => "Yearly",
        ResetInterval.Periodically => "Every 30 days",
        ResetInterval.FiscalYearly => "Each fiscal year",
        _ => reset.ToString()
    };

    private static string ResetHint(ResetInterval reset) => reset switch
    {
        ResetInterval.Never => "The sequence continues from its last number indefinitely.",
        ResetInterval.Monthly => "The count starts again at 1 at the beginning of each calendar month.",
        ResetInterval.Yearly => "The count starts again at 1 at the beginning of each calendar year.",
        ResetInterval.Periodically => "The count starts again at 1 every 30 days within the calendar year.",
        ResetInterval.FiscalYearly => "The count starts again at 1 at the beginning of each company fiscal year.",
        _ => string.Empty
    };
}
