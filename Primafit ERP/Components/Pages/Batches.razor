@page "/gl/batches"

@using Microsoft.EntityFrameworkCore
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization

@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<AppDbContext> DbFactory
@inject GLOperationsService GLOps
@inject ShipmentService ShipmentService
@inject ICashbookService CashbookService
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-[1400px] mx-auto space-y-6 animate-in fade-in duration-500 pb-16 font-sans text-slate-800">

    <!-- Header Section -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold tracking-tight text-slate-900">General Ledger Batches</h1>
                    @if (!string.IsNullOrEmpty(companyName))
                    {
                        <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                            @companyName
                        </span>
                    }
                </div>
                <p class="text-sm text-slate-500 mt-1">Review, approve, reject, and post staging financial batches from all ERP subledgers.</p>
            </div>

            @if (selectedBatch == null)
            {
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-sm hover:bg-slate-50 transition-all active:scale-95"
                        @onclick="LoadBatches" disabled="@(!HasCompany)">
                    <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.5 9.334M4.5 12H3m3.333-3H6m-2.667 3V4.333m15.357 5H19.5M3 12v7.667M3 19.667V12m16.5 7.667V12m-16.5 0h1.5m15 0h-1.5M4.5 19.667H19.5" />
                    </svg>
                    Refresh List
                </button>
            }
            else
            {
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-xl bg-slate-900 text-white px-5 py-2.5 text-sm font-bold shadow-md hover:bg-slate-800 transition-all active:scale-95"
                        @onclick="() => selectedBatch = null">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Back to Batch List
                </button>
            }
        </div>

        @if (selectedBatch == null)
        {
            <div class="flex flex-col sm:flex-row gap-4 border-t border-slate-100 pt-4">
                <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-xl border border-slate-200">
                    <input type="date" @bind="filterFromDate" @bind:after="OnFilterChangedAsync"
                           class="px-3 py-1.5 text-sm font-bold bg-white border border-slate-200 rounded-lg outline-none focus:border-indigo-500 transition-colors" />
                    <span class="text-slate-400 font-bold text-xs">-</span>
                    <input type="date" @bind="filterToDate" @bind:after="OnFilterChangedAsync"
                           class="px-3 py-1.5 text-sm font-bold bg-white border border-slate-200 rounded-lg outline-none focus:border-indigo-500 transition-colors" />
                </div>

                <div class="w-full sm:w-64">
                    <select class="input-class font-bold text-sm" disabled="@(!HasCompany)"
                            @bind="statusFilter" @bind:after="OnFilterChangedAsync">
                        <option value="">All Statuses</option>
                        <option value="Draft">Draft</option>
                        <option value="Ready">Ready (Awaiting Review)</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Posted">Posted</option>
                    </select>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="rounded-xl border border-rose-200 bg-rose-50 p-3.5 text-sm text-rose-700 font-medium">
                @loadError
            </div>
        }
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading batch data...
        </div>
    }
    else if (selectedBatch != null)
    {
        <!-- Batch Details Workspace -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-xl overflow-hidden animate-in slide-in-from-bottom-4">

            <!-- Detail Top Banner -->
            <div class="p-6 bg-slate-900 text-white flex flex-col md:flex-row md:justify-between md:items-center gap-4">
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-xl font-bold font-mono">@selectedBatch.BatchName</h2>
                        <span class="@StatusPill(selectedBatch.Status)">
                            @selectedBatch.Status
                        </span>
                    </div>
                    <p class="text-xs text-slate-300 mt-1">
                        @selectedBatch.Description | Created: @selectedBatch.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                    </p>
                </div>

                <div class="flex items-center gap-3 flex-wrap">
                    @if (selectedBatch.Status == BatchStatus.Ready)
                    {
                        <PermissionGate Key="GL_BATCH_APPROVE">
                            <Authorized>
                                <button type="button" disabled="@busy" @onclick="() => PromptRejectBatch(selectedBatch.Id)"
                                        class="rounded-xl border border-rose-400/50 bg-rose-500/20 px-4 py-2 text-xs font-bold text-rose-200 hover:bg-rose-500/30 transition-colors disabled:opacity-50 flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                                    <span>Reject Batch</span>
                                </button>
                            </Authorized>
                        </PermissionGate>

                        <PermissionGate Key="GL_BATCH_POST">
                            <Authorized>
                                <button type="button" disabled="@busy" @onclick="() => Post(selectedBatch.Id)"
                                        class="rounded-xl bg-emerald-600 px-6 py-2 text-xs font-bold text-white shadow-md hover:bg-emerald-500 transition-colors disabled:opacity-50 flex items-center gap-1.5">
                                    @if (busy)
                                    {
                                        <span class="animate-spin h-3 w-3 border-2 border-white border-t-transparent rounded-full"></span>
                                        <span>Posting...</span>
                                    }
                                    else
                                    {
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>
                                        <span>Post Batch to GL</span>
                                    }
                                </button>
                            </Authorized>
                        </PermissionGate>
                    }
                    else if (selectedBatch.Status == BatchStatus.Rejected)
                    {
                        <span class="text-xs text-rose-300 font-bold bg-rose-950/60 border border-rose-800 px-3 py-1 rounded-lg">
                            Returned for Correction
                        </span>
                    }
                    else if (selectedBatch.Status == BatchStatus.Posted)
                    {
                        <span class="text-xs text-emerald-300 font-bold bg-emerald-950/60 border border-emerald-800 px-3 py-1 rounded-lg flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                            Committed by @(selectedBatch.PostedByUserId ?? "System") at @selectedBatch.PostedAt?.ToLocalTime().ToString("MMM dd, HH:mm")
                        </span>
                    }
                </div>
            </div>

            <!-- Rejection Notice Banner -->
            @if (selectedBatch.Status == BatchStatus.Rejected && !string.IsNullOrWhiteSpace(selectedBatch.RejectionReason))
            {
                <div class="p-4 bg-rose-50 border-b border-rose-200 flex items-start gap-3">
                    <svg class="w-5 h-5 text-rose-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <div class="text-xs">
                        <span class="font-bold text-rose-800 uppercase tracking-wider block">Rejection Feedback</span>
                        <p class="text-rose-700 mt-0.5 leading-relaxed">@selectedBatch.RejectionReason</p>
                    </div>
                </div>
            }

            <!-- View Switcher Tabs -->
            <div class="flex border-b border-slate-200 bg-slate-50 px-4 pt-4 gap-2">
                <button type="button" @onclick="() => detailViewFormat = 0"
                        class="px-6 py-2.5 text-xs font-bold rounded-t-lg transition-colors @(detailViewFormat == 0 ? "bg-white border-t border-l border-r border-slate-200 text-indigo-700 shadow-sm" : "text-slate-500 hover:bg-slate-200 border border-transparent")">
                    Detailed Ledger Entries
                </button>
                <button type="button" @onclick="() => detailViewFormat = 1"
                        class="px-6 py-2.5 text-xs font-bold rounded-t-lg transition-colors @(detailViewFormat == 1 ? "bg-white border-t border-l border-r border-slate-200 text-indigo-700 shadow-sm" : "text-slate-500 hover:bg-slate-200 border border-transparent")">
                    Trial Balance Summary
                </button>
            </div>

            <!-- Detailed View -->
            @if (detailViewFormat == 0)
            {
                <div class="overflow-x-auto p-4">
                    <table class="w-full text-sm text-left whitespace-nowrap">
                        <thead class="bg-slate-100 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="p-3">Journal Ref</th>
                                <th class="p-3">Account Code</th>
                                <th class="p-3 w-[40%]">Account Description</th>
                                <th class="p-3">Narration / Line Reference</th>
                                <th class="p-3 text-right text-indigo-700">Debit</th>
                                <th class="p-3 text-right text-emerald-700">Credit</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-800">
                            @if (!selectedBatch.Journals.SelectMany(j => j.Lines).Any() && batchTransactions.Any())
                            {
                                @foreach (var txn in batchTransactions)
                                {
                                    var account = accountMap.ContainsKey(txn.SegCoaId) ? accountMap[txn.SegCoaId] : null;
                                    var parentJournal = selectedBatch.Journals.FirstOrDefault(j => j.Id == txn.JournalId);
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-3 font-mono text-xs text-slate-500">@(parentJournal?.JournalNumber ?? "-")</td>
                                        <td class="p-3 font-mono font-bold">@(account?.AccountCode ?? "UNKNOWN")</td>
                                        <td class="p-3 font-medium">@(account?.Description ?? "Unknown Account")</td>
                                        <td class="p-3 text-xs text-slate-600">@txn.Narration</td>
                                        <td class="p-3 text-right font-mono font-bold @(txn.Debit > 0 ? "text-indigo-700" : "text-slate-300")">
                                            @(txn.Debit > 0 ? txn.Debit.ToString("N4") : "-")
                                        </td>
                                        <td class="p-3 text-right font-mono font-bold @(txn.Credit > 0 ? "text-emerald-700" : "text-slate-300")">
                                            @(txn.Credit > 0 ? txn.Credit.ToString("N4") : "-")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                @foreach (var journal in selectedBatch.Journals)
                                {
                                    foreach (var line in journal.Lines)
                                    {
                                        var account = accountMap.ContainsKey(line.SegCoaId) ? accountMap[line.SegCoaId] : null;
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="p-3 font-mono text-xs text-slate-500">@journal.JournalNumber</td>
                                            <td class="p-3 font-mono font-bold">@(account?.AccountCode ?? "UNKNOWN")</td>
                                            <td class="p-3 font-medium">@(account?.Description ?? "Unknown Account")</td>
                                            <td class="p-3 text-xs text-slate-600">@(line.Reference ?? journal.Narration)</td>
                                            <td class="p-3 text-right font-mono font-bold @(line.Debit > 0 ? "text-indigo-700" : "text-slate-300")">
                                                @(line.Debit > 0 ? line.Debit.ToString("N4") : "-")
                                            </td>
                                            <td class="p-3 text-right font-mono font-bold @(line.Credit > 0 ? "text-emerald-700" : "text-slate-300")">
                                                @(line.Credit > 0 ? line.Credit.ToString("N4") : "-")
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                        <tfoot class="bg-slate-50 border-t-2 border-slate-200 font-bold">
                            <tr>
                                <td colspan="4" class="p-3 text-right uppercase text-xs tracking-widest text-slate-500">Batch Totals:</td>
                                <td class="p-3 text-right font-mono text-indigo-700 text-base">
                                    @if (!selectedBatch.Journals.SelectMany(j => j.Lines).Any() && batchTransactions.Any())
                                    {
                                        @batchTransactions.Sum(t => t.Debit).ToString("N4")
                                    }
                                    else
                                    {
                                        @selectedBatch.Journals.SelectMany(j => j.Lines).Sum(l => l.Debit).ToString("N4")
                                    }
                                </td>
                                <td class="p-3 text-right font-mono text-emerald-700 text-base">
                                    @if (!selectedBatch.Journals.SelectMany(j => j.Lines).Any() && batchTransactions.Any())
                                    {
                                        @batchTransactions.Sum(t => t.Credit).ToString("N4")
                                    }
                                    else
                                    {
                                        @selectedBatch.Journals.SelectMany(j => j.Lines).Sum(l => l.Credit).ToString("N4")
                                    }
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }

            <!-- Summary Trial Balance View -->
            @if (detailViewFormat == 1)
            {
                var hasLines = selectedBatch.Journals.SelectMany(j => j.Lines).Any();
                var groupedLines = hasLines
                    ? selectedBatch.Journals.SelectMany(j => j.Lines)
                        .GroupBy(l => l.SegCoaId)
                        .Select(g => new { AccountId = g.Key, NetBalance = g.Sum(x => x.Debit) - g.Sum(x => x.Credit) })
                        .Where(g => g.NetBalance != 0).ToList()
                    : batchTransactions.GroupBy(t => t.SegCoaId)
                        .Select(g => new { AccountId = g.Key, NetBalance = g.Sum(x => x.Debit) - g.Sum(x => x.Credit) })
                        .Where(g => g.NetBalance != 0).ToList();

                decimal totalNetDebit = groupedLines.Where(g => g.NetBalance > 0).Sum(g => g.NetBalance);
                decimal totalNetCredit = groupedLines.Where(g => g.NetBalance < 0).Sum(g => Math.Abs(g.NetBalance));

                <div class="overflow-x-auto p-4">
                    <table class="w-full text-sm text-left border border-slate-200 rounded-lg">
                        <thead class="bg-slate-100 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                            <tr>
                                <th class="p-4 w-32">Account Code</th>
                                <th class="p-4">Account Description</th>
                                <th class="p-4 text-right text-indigo-700 w-40">Net Debit</th>
                                <th class="p-4 text-right text-emerald-700 w-40">Net Credit</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-slate-800">
                            @foreach (var group in groupedLines)
                            {
                                var account = accountMap.ContainsKey(group.AccountId) ? accountMap[group.AccountId] : null;

                                <tr class="hover:bg-slate-50 transition-colors">
                                    <td class="p-4 font-mono font-bold">@(account?.AccountCode ?? "UNKNOWN")</td>
                                    <td class="p-4 font-bold text-slate-700">@(account?.Description ?? "Unknown Account")</td>
                                    <td class="p-4 text-right font-mono font-bold @(group.NetBalance > 0 ? "text-indigo-700" : "text-slate-300")">
                                        @(group.NetBalance > 0 ? group.NetBalance.ToString("N4") : "-")
                                    </td>
                                    <td class="p-4 text-right font-mono font-bold @(group.NetBalance < 0 ? "text-emerald-700" : "text-slate-300")">
                                        @(group.NetBalance < 0 ? Math.Abs(group.NetBalance).ToString("N4") : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-slate-50 border-t-2 border-slate-200 font-bold">
                            <tr>
                                <td colspan="2" class="p-4 text-right uppercase text-xs tracking-widest text-slate-500">Trial Balance Totals:</td>
                                <td class="p-4 text-right font-mono text-indigo-700 text-base">@totalNetDebit.ToString("N4")</td>
                                <td class="p-4 text-right font-mono text-emerald-700 text-base">@totalNetCredit.ToString("N4")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Master Batches Grid -->
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm flex flex-col min-h-[520px]">
            <div class="overflow-x-auto flex-1">
                <table class="w-full text-sm text-left whitespace-nowrap">
                    <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider">
                        <tr>
                            <th class="p-4 w-[25%]">Batch Details</th>
                            <th class="p-4 w-[10%]">Type</th>
                            <th class="p-4 w-[12%] text-center">Status</th>
                            <th class="p-4 w-[15%]">Created</th>
                            <th class="p-4 w-[15%]">Posted</th>
                            <th class="p-4 w-[23%] text-right pr-6">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-slate-900">
                        @foreach (var b in PaginatedBatches)
                        {
                            <tr class="group hover:bg-slate-50/80 transition-colors cursor-pointer align-middle" @onclick="() => ViewBatch(b.Id)">
                                <td class="p-4">
                                    <div class="font-bold text-indigo-700 group-hover:underline font-mono">@b.BatchName</div>
                                    @if (!string.IsNullOrWhiteSpace(b.Description))
                                    {
                                        <div class="text-xs text-slate-500 mt-0.5 truncate max-w-sm" title="@b.Description">@b.Description</div>
                                    }
                                </td>

                                <td class="p-4">
                                    <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-bold text-slate-600">
                                        @b.Type
                                    </span>
                                </td>

                                <td class="p-4 text-center">
                                    <span class="@StatusPill(b.Status)">
                                        @b.Status
                                    </span>
                                    @if (b.Status == BatchStatus.Rejected && !string.IsNullOrWhiteSpace(b.RejectionReason))
                                    {
                                        <div class="text-[10px] text-rose-600 font-normal truncate max-w-[140px] mx-auto mt-0.5" title="@b.RejectionReason">
                                            @b.RejectionReason
                                        </div>
                                    }
                                </td>

                                <td class="p-4">
                                    <div class="font-medium text-slate-700">@b.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                                </td>

                                <td class="p-4">
                                    @if (b.PostedAt.HasValue)
                                    {
                                        <div class="font-medium text-emerald-700">@b.PostedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                                    }
                                    else
                                    {
                                        <span class="text-slate-300 font-bold">—</span>
                                    }
                                </td>

                                <td class="p-4 text-right pr-6" @onclick:stopPropagation="true">
                                    <div class="flex justify-end items-center gap-2">
                                        <button type="button" @onclick="() => ViewBatch(b.Id)"
                                                class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50 transition-colors shadow-sm">
                                            Details
                                        </button>

                                        @if (b.Status == BatchStatus.Draft || b.Status == BatchStatus.Ready)
                                        {
                                            <PermissionGate Key="GL_BATCH_APPROVE">
                                                <Authorized>
                                                    <button type="button" disabled="@busy" @onclick="() => PromptRejectBatch(b.Id)"
                                                            class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-bold text-rose-700 hover:bg-rose-100 transition-colors disabled:opacity-50">
                                                        Reject
                                                    </button>
                                                </Authorized>
                                            </PermissionGate>

                                            <PermissionGate Key="GL_BATCH_POST">
                                                <Authorized>
                                                    <button type="button" disabled="@busy" @onclick="() => Post(b.Id)"
                                                            class="rounded-lg bg-emerald-600 px-3.5 py-1.5 text-xs font-bold text-white hover:bg-emerald-700 shadow-sm transition-colors disabled:opacity-50">
                                                        Post
                                                    </button>
                                                </Authorized>
                                            </PermissionGate>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!PaginatedBatches.Any())
                        {
                            <tr>
                                <td colspan="6" class="p-16 text-center text-slate-400">
                                    <div class="flex flex-col items-center gap-2">
                                        <svg class="h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                        </svg>
                                        <span>No batches found matching the specified filter criteria.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between mt-auto text-xs text-slate-500 font-medium">
                    <p>
                        Showing <span class="font-bold text-slate-900">@((currentPage - 1) * pageSize + 1)</span> to <span class="font-bold text-slate-900">@Math.Min(currentPage * pageSize, FilteredBatches.Count())</span> of <span class="font-bold text-slate-900">@FilteredBatches.Count()</span> batches
                    </p>
                    <div class="flex gap-2">
                        <button type="button" @onclick="PreviousPage" disabled="@(currentPage == 1)"
                                class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">
                            Previous
                        </button>
                        <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)"
                                class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-bold text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors shadow-sm">
                            Next
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .input-class {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        background-color: #fff;
        padding: 0.5rem 0.75rem;
        font-size: 0.875rem;
        color: #0f172a;
        font-weight: 600;
        transition: all 0.2s;
        outline: none;
    }

        .input-class:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
        }
</style>

@code {
    private Guid selectedCompanyId = Guid.Empty;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;

    // Filter Parameters
    private DateTime filterFromDate = DateTime.Today.AddDays(-30);
    private DateTime filterToDate = DateTime.Today;
    private string statusFilter = "";

    // Pagination
    private int currentPage = 1;
    private int pageSize = 15;

    // In-memory Datasets
    private List<GLBatch> batches = new();
    private Dictionary<Guid, SegChartOfAccount> accountMap = new();

    // Active Selection State
    private GLBatch? selectedBatch;
    private List<GLTransaction> batchTransactions = new();

    private int detailViewFormat = 0; // 0 = Detailed Journal View, 1 = Trial Balance Summary
    private bool busy;
    private string? loadError;

    private IEnumerable<GLBatch> FilteredBatches => batches;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredBatches.Count() / pageSize));
    private IEnumerable<GLBatch> PaginatedBatches => FilteredBatches.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("FINANCE_REPORTS_PAGE"))
        {
            NavManager.NavigateTo("/access-denied");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);
            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                await LoadAccountMap();
                await LoadBatches();
            }
        }

        isLoading = false;
    }

    private async Task OnFilterChangedAsync()
    {
        currentPage = 1;
        await LoadBatches();
    }

    private async Task LoadAccountMap()
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var accts = await ctx.SegChartOfAccounts
            .AsNoTracking()
            .Where(a => a.CompanyId == selectedCompanyId)
            .ToListAsync();

        accountMap = accts.ToDictionary(a => a.Id, a => a);
    }

    private async Task LoadBatches()
    {
        loadError = null;
        if (!HasCompany) return;

        try
        {
            isLoading = true;
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var q = ctx.GLBatches
                .AsNoTracking()
                .Where(b => b.CompanyId == selectedCompanyId);

            // Apply Date Bounds
            q = q.Where(b => b.CreatedAt.Date >= filterFromDate.Date && b.CreatedAt.Date <= filterToDate.Date);

            // Apply Status Criteria
            if (!string.IsNullOrWhiteSpace(statusFilter) && Enum.TryParse<BatchStatus>(statusFilter, out var st))
            {
                q = q.Where(b => b.Status == st);
            }

            batches = await q.OrderByDescending(b => b.CreatedAt).ToListAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewBatch(Guid batchId)
    {
        isLoading = true;
        try
        {
            selectedBatch = await GLOps.GetBatchByIdAsync(batchId, selectedCompanyId);

            await using var ctx = await DbFactory.CreateDbContextAsync();
            batchTransactions = await ctx.GLTransactions
                .AsNoTracking()
                .Where(t => t.BatchId == batchId && t.CompanyId == selectedCompanyId)
                .ToListAsync();

            detailViewFormat = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NextPage() { if (currentPage < TotalPages) currentPage++; }
    private void PreviousPage() { if (currentPage > 1) currentPage--; }

    private async Task Post(Guid batchId)
    {
        busy = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.GetUserAsync(authState.User);
            if (currentUser == null)
            {
                await JS.InvokeVoidAsync("alert", "Error: Unauthenticated user.");
                return;
            }

            var result = await GLOps.ApproveAndPostBatchAsync(selectedCompanyId, batchId, currentUser.Id);
            if (!string.IsNullOrEmpty(result))
            {
                await JS.InvokeVoidAsync("alert", $"Posting Error: {result}");
            }
            else
            {
                await FinalizeApprovedShipment(batchId, currentUser.Id);
                var cashbookFinalizationError = await CashbookService.FinalizeApprovedBatchAsync(batchId, currentUser.Id);
                if (!string.IsNullOrWhiteSpace(cashbookFinalizationError))
                    await JS.InvokeVoidAsync("alert", $"Cashbook finalization requires attention: {cashbookFinalizationError}");
                await JS.InvokeVoidAsync("alert", "Batch posted and committed to the General Ledger successfully!");
                await LoadBatches();

                if (selectedBatch != null && selectedBatch.Id == batchId)
                {
                    await ViewBatch(batchId);
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"System Error: {ex.Message}");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task FinalizeApprovedShipment(Guid batchId, string userId)
    {
        await using var ctx = await DbFactory.CreateDbContextAsync();
        var shipmentId = await ctx.SalesShipments.AsNoTracking()
            .Where(s => s.ShipmentBatchId == batchId)
            .Select(s => (Guid?)s.Id)
            .FirstOrDefaultAsync();
        if (shipmentId.HasValue)
        {
            var err = await ShipmentService.FinalizeApprovedShipmentAsync(shipmentId.Value, userId);
            if (!string.IsNullOrWhiteSpace(err))
                await JS.InvokeVoidAsync("alert", $"Shipment finalization requires attention: {err}");
        }
    }

    private async Task PromptRejectBatch(Guid batchId)
    {
        var reason = await JS.InvokeAsync<string>("prompt", "Please enter the rejection reason / correction requirements for this batch:");
        if (string.IsNullOrWhiteSpace(reason)) return;

        busy = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var currentUser = await UserManager.GetUserAsync(authState.User);
            if (currentUser == null) return;

            var err = await GLOps.RejectBatchAsync(selectedCompanyId, batchId, reason.Trim(), currentUser.Id);
            if (!string.IsNullOrEmpty(err))
            {
                await JS.InvokeVoidAsync("alert", $"Rejection Error: {err}");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Batch has been rejected and returned to the origin workspace for correction.");
                await LoadBatches();
                if (selectedBatch?.Id == batchId)
                {
                    await ViewBatch(batchId);
                }
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            busy = false;
        }
    }

    private static string StatusPill(BatchStatus st) => st switch
    {
        BatchStatus.Draft => "inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-[10px] font-bold text-slate-600 border border-slate-200 uppercase tracking-wider",
        BatchStatus.Ready => "inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-[10px] font-bold text-amber-700 border border-amber-200 uppercase tracking-wider",
        BatchStatus.Posted => "inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold text-emerald-700 border border-emerald-200 uppercase tracking-wider",
        BatchStatus.Rejected => "inline-flex items-center rounded-full bg-rose-50 px-2.5 py-0.5 text-[10px] font-bold text-rose-700 border border-rose-200 uppercase tracking-wider animate-pulse",
        _ => "inline-flex items-center rounded-full bg-slate-50 px-2.5 py-0.5 text-[10px] font-bold text-slate-600 uppercase tracking-wider"
    };
}
