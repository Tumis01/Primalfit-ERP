@page "/accounting-periods"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@inject AccountingPeriodService PeriodService
@inject CompanyApiService CompanyService
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Fiscal Periods</h1>
            <p class="text-sm text-slate-500 mt-1">Manage open/closed accounting months.</p>
        </div>

        <button @onclick="GeneratePeriods" disabled="@isBusy"
                class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-indigo-200 hover:bg-indigo-700 hover:shadow-lg transition-all active:scale-95 disabled:opacity-50">
            @if (isBusy)
            {
                <span>Generating...</span>
            }
            else
            {
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.5 9.334M4.5 12H3m3.333-3H6m-2.667 3V4.333m15.357 5H19.5M3 12v7.667M3 19.667V12m16.5 7.667V12m-16.5 0h1.5m15 0h-1.5M4.5 19.667H19.5" />
                </svg>
                <span>Generate Periods</span>
            }
        </button>
    </div>

    @if (companies.Any())
    {
        <div class="w-full md:w-1/3">
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Select Company</label>
            <select class="w-full rounded-xl border-slate-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20"
                    value="@selectedCompanyId"
                    @onchange="OnCompanyChanged">
                @foreach (var c in companies)
                {
                    <option value="@c.CompanyDetailsId">
                        @c.CompanyName (@c.FiscalStartYear.ToShortDateString() - @c.FiscalEndYear.ToShortDateString())
                    </option>
                }
            </select>
        </div>
    }

    <!-- Pagination toolbar -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <label class="text-xs font-bold text-slate-500 uppercase">Rows</label>
            <select class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20"
                    @bind="pageSize"
                    @bind:after="OnPageSizeChanged">
                @foreach (var s in pageSizeOptions)
                {
                    <option value="@s">@s</option>
                }
            </select>

            <span class="text-sm text-slate-500">
                Showing
                <span class="font-semibold text-slate-700">@displayFrom</span>
                –
                <span class="font-semibold text-slate-700">@displayTo</span>
                of
                <span class="font-semibold text-slate-700">@totalCount</span>
            </span>
        </div>

        <div class="flex items-center gap-2">
            <button class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 disabled:opacity-50"
                    @onclick="PrevPage"
                    disabled="@(!CanPrev)">
                Prev
            </button>

            <span class="text-sm text-slate-500 px-2">
                Page <span class="font-semibold text-slate-700">@currentPage</span> /
                <span class="font-semibold text-slate-700">@totalPages</span>
            </span>

            <button class="rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 disabled:opacity-50"
                    @onclick="NextPage"
                    disabled="@(!CanNext)">
                Next
            </button>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm mt-4">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50/50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4">Period Name</th>
                    <th class="px-6 py-4">Start Date</th>
                    <th class="px-6 py-4">End Date</th>
                    <th class="px-6 py-4 text-center">Status</th>
                    <th class="px-6 py-4 text-center">Close Period</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (pagedPeriods.Any())
                {
                    @foreach (var item in pagedPeriods)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors @(item.IsClosed ? "bg-slate-50 opacity-75" : "")">
                            <td class="px-6 py-4 font-medium text-slate-900">@item.PeriodName</td>

                            <td class="px-6 py-4 text-slate-600">
                                @item.StartDate.ToString("dd MMM yyyy")
                            </td>

                            <td class="px-6 py-4 text-slate-600">
                                @item.EndDate.ToString("dd MMM yyyy")
                            </td>

                            <td class="px-6 py-4 text-center">
                                @if (item.IsClosed)
                                {
                                    <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600 ring-1 ring-inset ring-slate-500/10">Closed</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Open</span>
                                }
                            </td>

                            <td class="px-6 py-4 text-center">
                                <input type="checkbox"
                                       checked="@item.IsClosed"
                                       @onchange="(e) => ToggleStatus(item, e)"
                                       class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-600 cursor-pointer" />
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                            No periods generated yet. Select a company and click Generate.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<AccountingPeriod> periods = new();
    private List<CompanyDetails> companies = new();
    private Guid selectedCompanyId;
    private bool isBusy = false;

    // Pagination state
    private int currentPage = 1; // 1-based
    private int pageSize = 10;
    private readonly int[] pageSizeOptions = new[] { 5, 10, 20, 50 };

    // Derived pagination values
    private int totalCount => periods?.Count ?? 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;

    private int displayFrom => totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int displayTo => totalCount == 0 ? 0 : Math.Min(currentPage * pageSize, totalCount);

    private IEnumerable<AccountingPeriod> pagedPeriods =>
        periods
            .OrderBy(p => p.StartDate)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        companies = await CompanyService.GetCompaniesAsync();

        if (companies.Any())
        {
            selectedCompanyId = companies.First().CompanyDetailsId;
            await LoadPeriods(resetPage: true);
        }
    }

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        if (e?.Value is null) return;

        if (Guid.TryParse(e.Value.ToString(), out var id))
        {
            selectedCompanyId = id;
            await LoadPeriods(resetPage: true);
        }
    }

    private async Task LoadPeriods(bool resetPage)
    {
        var allPeriods = await PeriodService.GetPeriodsAsync();
        periods = allPeriods.Where(p => p.CompanyId == selectedCompanyId).ToList();

        if (resetPage) currentPage = 1;

        // Clamp page if dataset shrank
        if (currentPage > totalPages) currentPage = totalPages;
    }

    private void PrevPage()
    {
        if (CanPrev) currentPage--;
    }

    private void NextPage()
    {
        if (CanNext) currentPage++;
    }

    private void OnPageSizeChanged()
    {
        currentPage = 1;
    }

    private async Task GeneratePeriods()
    {
        if (selectedCompanyId == Guid.Empty) return;

        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "This will regenerate periods for the selected company. Any existing period data will be reset. Continue?"
        );

        if (!confirmed) return;

        try
        {
            isBusy = true;

            var ok = await PeriodService.GeneratePeriodsForCompanyAsync(selectedCompanyId);
            if (!ok)
                await JS.InvokeVoidAsync("alert", "Period generation failed (company not found). Check your CompanyId mapping.");

            await LoadPeriods(resetPage: true);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ToggleStatus(AccountingPeriod item, ChangeEventArgs e)
    {
        bool isClosed = (bool)(e.Value ?? false);
        item.IsClosed = isClosed;
        await PeriodService.TogglePeriodStatusAsync(item.Id, isClosed);
    }
}
