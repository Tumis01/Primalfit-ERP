@page "/accounting-periods"
@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@inject AccountingPeriodService PeriodService
@inject CompanyApiService CompanyService
@inject UserManager<ApplicationUser> UserManager
@inject PermissionCacheService PermissionCache
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900">Fiscal Periods</h1>
                @if (!string.IsNullOrEmpty(companyName))
                {
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-slate-100 px-3 py-1 text-xs font-bold text-slate-900 border border-slate-200">
                        <svg class="h-3 w-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        @companyName
                    </span>
                }
            </div>
            <p class="text-sm text-slate-500 mt-1">Manage open and closed accounting months for financial reporting.</p>
        </div>

        <div class="flex gap-2">

            <PermissionGate Key="FISCAL_PERIODS_MANAGE">
                <Authorized>
                    <button @onclick="GeneratePeriods" disabled="@(isBusy || !HasCompany)"
                            class="inline-flex items-center gap-2 rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-slate-200 hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50">
                        @if (isBusy)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span>Generating...</span>
                        }
                        else
                        {
                            <svg class="h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.5 9.334M4.5 12H3m3.333-3H6m-2.667 3V4.333m15.357 5H19.5M3 12v7.667M3 19.667V12m16.5 7.667V12m-16.5 0h1.5m15 0h-1.5M4.5 19.667H19.5" /></svg>
                            <span>Generate Periods</span>
                        }
                    </button>
                </Authorized>
            </PermissionGate>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-400 animate-pulse">
            Loading periods...
        </div>
    }
    else if (HasCompany)
    {
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 bg-slate-50 p-4 rounded-2xl border border-slate-200">
            <div class="flex items-center gap-3">
                <label class="text-xs font-bold text-slate-500 uppercase tracking-wide">Rows</label>
                <select class="rounded-lg border-slate-200 bg-white px-2 py-1.5 text-sm font-bold text-slate-700 focus:border-slate-500 focus:ring-slate-200"
                        @bind="pageSize"
                        @bind:after="OnPageSizeChanged">
                    @foreach (var s in pageSizeOptions)
                    {
                        <option value="@s">@s</option>
                    }
                </select>

                <div class="h-4 w-px bg-slate-300 mx-2"></div>

                <span class="text-xs font-medium text-slate-500">
                    Showing <span class="font-bold text-slate-900">@displayFrom</span> – <span class="font-bold text-slate-900">@displayTo</span> of <span class="font-bold text-slate-900">@totalCount</span>
                </span>
            </div>

            <div class="flex items-center gap-2">
                <button class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                        @onclick="PrevPage"
                        disabled="@(!CanPrev)">
                    Previous
                </button>

                <button class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                        @onclick="NextPage"
                        disabled="@(!CanNext)">
                    Next
                </button>
            </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <table class="w-full text-left text-sm text-slate-900">
                <thead class="bg-slate-50 text-xs uppercase font-bold tracking-wider text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4">Period Name</th>
                        <th class="px-6 py-4">Start Date</th>
                        <th class="px-6 py-4">End Date</th>
                        <th class="px-6 py-4 text-center">Status</th>
                        <th class="px-6 py-4 text-center">Close Period</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (pagedPeriods.Any())
                    {
                        @foreach (var item in pagedPeriods)
                        {
                            <tr class="hover:bg-slate-50 transition-colors @(item.IsClosed ? "bg-slate-50/50" : "")">
                                <td class="px-6 py-4 font-bold text-slate-900">@item.PeriodName</td>
                                <td class="px-6 py-4 font-mono text-slate-600">@item.StartDate.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 font-mono text-slate-600">@item.EndDate.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 text-center">
                                    @if (item.IsClosed)
                                    {
                                        <span class="inline-flex items-center rounded border border-slate-200 bg-slate-100 px-2.5 py-0.5 text-xs font-bold text-slate-500">
                                            Closed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center rounded border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-xs font-bold text-emerald-700">
                                            Open
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-center">
                                    
                                    <PermissionGate Key="FISCAL_PERIODS_MANAGE">
                                        <Authorized>
                                            <input type="checkbox"
                                                   checked="@item.IsClosed"
                                                   @onchange="(e) => ToggleStatus(item, e)"
                                                   class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900 cursor-pointer" />
                                        </Authorized>
                                        <NotAuthorized>
                                            <!-- Read-only view for users without manage rights -->
                                            <input type="checkbox"
                                                   checked="@item.IsClosed"
                                                   @onchange="(e) => ToggleStatus(item, e)"
                                                   class="h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900 cursor-pointer" />
                                        </NotAuthorized>
                                    </PermissionGate>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                                No periods generated yet. Click 'Generate Periods' to initialize the fiscal year.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    // --- Context ---
    private Guid selectedCompanyId;
    private string companyName = "";
    private bool HasCompany => selectedCompanyId != Guid.Empty;
    private bool isLoading = true;
    private bool isBusy = false;

    // --- Data ---
    private List<AccountingPeriod> periods = new();

    // --- Pagination ---
    private int currentPage = 1;
    private int pageSize = 10;
    private readonly int[] pageSizeOptions = new[] { 12, 24, 48 };

    private int totalCount => periods?.Count ?? 0;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;

    private int displayFrom => totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int displayTo => totalCount == 0 ? 0 : Math.Min(currentPage * pageSize, totalCount);

    private IEnumerable<AccountingPeriod> pagedPeriods =>
        periods
            .OrderBy(p => p.StartDate)
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("FISCAL_PERIODS_PAGE")) { NavManager.NavigateTo("/access-denied"); return; }
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userPrincipal = authState.User;

        if (userPrincipal.Identity != null && userPrincipal.Identity.IsAuthenticated)
        {
            var currentUser = await UserManager.GetUserAsync(userPrincipal);

            if (currentUser != null && currentUser.CompanyDetailsId.HasValue)
            {
                selectedCompanyId = currentUser.CompanyDetailsId.Value;

                var company = await CompanyService.GetCompanyByIdAsync(selectedCompanyId);
                if (company != null) companyName = company.CompanyName;

                await LoadPeriods(resetPage: true);
            }
        }
        isLoading = false;
    }

    private async Task LoadPeriods(bool resetPage)
    {
        if (!HasCompany) return;

        var allPeriods = await PeriodService.GetPeriodsAsync();
        // Server-side filter typically better, but keeping existing service pattern
        periods = allPeriods.Where(p => p.CompanyId == selectedCompanyId).ToList();

        if (resetPage) currentPage = 1;
        if (currentPage > totalPages) currentPage = totalPages;
    }

    private void PrevPage() { if (CanPrev) currentPage--; }
    private void NextPage() { if (CanNext) currentPage++; }
    private void OnPageSizeChanged() { currentPage = 1; }

    private async Task GeneratePeriods()
    {
        if (!HasCompany) return;

        // UPDATED: Reassure the user that their data is safe!
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "This will generate missing periods for your fiscal year. Existing periods and their transactions will remain safely untouched. Continue?"
        );

        if (!confirmed) return;

        try
        {
            isBusy = true;
            var ok = await PeriodService.GeneratePeriodsForCompanyAsync(selectedCompanyId);
            if (!ok)
            {
                await JS.InvokeVoidAsync("alert", "Period generation failed. Please verify company fiscal settings.");
            }
            await LoadPeriods(resetPage: true);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ToggleStatus(AccountingPeriod item, ChangeEventArgs e)
    {
        bool isClosed = (bool)(e.Value ?? false);
        item.IsClosed = isClosed;
        await PeriodService.TogglePeriodStatusAsync(item.Id, isClosed);
    }
}