@page "/inventory/adjustments"

@using Primafit_ERP.Components.Models
@using Primafit_ERP.Services
@using PrimafitERP.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.IO

@inject InventoryService InvService
@inject MasterDataService MasterService
@inject SegCoaService SegCoaService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject PermissionCacheService PermissionCache
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="max-w-6xl mx-auto space-y-6 animate-in fade-in duration-500 pb-12 mt-6 font-sans text-slate-800">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Inventory Adjustments</h1>
            <p class="text-sm text-slate-500 mt-1">Perform granular inline stock level adjustments. Automatically records line-by-line offsetting balancing entries onto the ledger.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start relative z-50">

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm md:col-span-2 overflow-visible relative">
            <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">
                Balancing Account <span class="text-rose-500">*</span>
            </label>
            <SearchableGlAccount Label="" Placeholder="Search balancing account..." Accounts="@coaList" @bind-Value="balancingGlId" />
            <p class="text-[10px] text-slate-400 font-medium mt-2">Every line item entered below will be automatically balanced line-by-line by this designated GL account.</p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-center h-full">
            <label class="label block text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1.5">
                Adjustment Posting Date
            </label>
            <div class="relative w-full rounded-xl shadow-sm">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <input type="date"
                       @bind="postingDate"
                       class="w-full pl-10 pr-3 py-2.5 border border-slate-200 rounded-xl font-bold text-sm text-slate-900 bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition-all cursor-pointer" />
            </div>
        </div>

    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-visible relative">

        <!-- IMPORTANT -->
        <div class="overflow-visible relative">

            <table class="w-full text-left text-sm whitespace-nowrap min-w-[1100px]">

                <thead class="bg-slate-50 text-[10px] uppercase font-extrabold text-slate-500 border-b border-slate-200 tracking-wider relative z-10">
                    <tr>
                        <th class="p-4 w-[32%] pl-6">Physical Inventory Item Reference</th>
                        <th class="p-4 w-[20%]">Fulfillment Warehouse</th>
                        <th class="p-4 text-center w-[13%]">Quantity Delta</th>
                        <th class="p-4 text-right w-[15%]">Debit Value (Dr - Stock Up)</th>
                        <th class="p-4 text-right w-[15%]">Credit Value (Cr - Stock Down)</th>
                        <th class="p-4 text-center w-[5%] pr-6">Action</th>
                    </tr>
                </thead>

                <!-- REMOVE z-index FROM tbody -->
                <tbody class="divide-y divide-slate-100">

                    @foreach (var line in lines)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors align-middle">

                            <!-- VERY IMPORTANT -->
                            <td class="p-3 pl-6 relative overflow-visible">

                                <!-- SEARCH CONTAINER -->
                                <div class="relative z-[9999]">
                                    <SearchableItem Label=""
                                                    Items="@items"
                                                    @bind-Value="line.ItemId"
                                                    IsInvalid="@(line.ItemId == Guid.Empty)" />
                                </div>

                            </td>

                            <td class="p-3">
                                <select @bind="line.WarehouseId"
                                        class="w-full p-2.5 border border-slate-200 rounded-xl text-sm font-bold text-slate-800 bg-white focus:border-indigo-500 focus:outline-none transition-all">
                                    <option value="@Guid.Empty">-- Select Warehouse --</option>

                                    @foreach (var wh in warehouses)
                                    {
                                        <option value="@wh.Id">@wh.Name</option>
                                    }
                                </select>
                            </td>

                            <td class="p-3">
                                <input type="number"
                                       step="0.01"
                                       min="0"
                                       @bind="line.QuantityChange"
                                       class="w-full p-2.5 border border-slate-200 rounded-xl text-center font-mono font-bold text-slate-900 focus:border-indigo-500 focus:outline-none"
                                       placeholder="0.00" />
                            </td>

                            <td class="p-3">
                                <div class="relative rounded-xl shadow-sm">
                                    <input type="number"
                                           step="0.01"
                                           min="0"
                                           value="@(line.DebitAmount == 0 ? "" : line.DebitAmount.ToString())"
                                           @oninput="@(e => OnDebitChanged(line, e.Value?.ToString()))"
                                           disabled="@line.IsDebitReadOnly"
                                           class="w-full p-2.5 border rounded-xl text-right font-mono font-bold focus:border-indigo-500 focus:outline-none transition-all @(line.IsDebitReadOnly ? "bg-slate-50 border-slate-200 text-slate-400 cursor-not-allowed" : "bg-white border-slate-200 text-slate-900")"
                                           placeholder="0.00" />
                                </div>
                            </td>

                            <td class="p-3">
                                <div class="relative rounded-xl shadow-sm">
                                    <input type="number"
                                           step="0.01"
                                           min="0"
                                           value="@(line.CreditAmount == 0 ? "" : line.CreditAmount.ToString())"
                                           @oninput="@(e => OnCreditChanged(line, e.Value?.ToString()))"
                                           disabled="@line.IsCreditReadOnly"
                                           class="w-full p-2.5 border rounded-xl text-right font-mono font-bold focus:border-indigo-500 focus:outline-none transition-all @(line.IsCreditReadOnly ? "bg-slate-50 border-slate-200 text-slate-400 cursor-not-allowed" : "bg-white border-slate-200 text-slate-900")"
                                           placeholder="0.00" />
                                </div>
                            </td>

                            <td class="p-3 text-center pr-6">
                                <button type="button"
                                        @onclick="() => RemoveLine(line)"
                                        class="text-slate-400 hover:text-rose-600 transition-colors"
                                        title="Delete Row">
                                    <svg class="w-5 h-5 mx-auto"
                                         fill="none"
                                         viewBox="0 0 24 24"
                                         stroke="currentColor">
                                        <path stroke-linecap="round"
                                              stroke-linejoin="round"
                                              stroke-width="2"
                                              d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>
        </div>

        <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between mt-auto relative z-10">

            <button type="button"
                    @onclick="AddRow"
                    class="px-3 py-1.5 text-xs font-bold text-indigo-600 hover:text-indigo-900 uppercase tracking-wide flex items-center gap-1">
                <svg class="w-4 h-4"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2.5"
                          d="M12 4v16m8-8H4" />
                </svg>

                Add Line
            </button>

            <div class="text-right flex items-center gap-8">
                <div>
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">
                        Aggregate Value Debits (Dr)
                    </span>

                    <span class="text-lg font-mono font-bold text-emerald-600">
                        @lines.Sum(l => l.DebitAmount).ToString("N2")
                    </span>
                </div>

                <div class="w-px h-8 bg-slate-200"></div>

                <div>
                    <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">
                        Aggregate Value Credits (Cr)
                    </span>

                    <span class="text-lg font-mono font-bold text-rose-600">
                        @lines.Sum(l => l.CreditAmount).ToString("N2")
                    </span>
                </div>
            </div>

        </div>
    </div>

    <div class="flex justify-end pt-2">
        <button @onclick="PostStockAdjustments" disabled="@(isBusy || balancingGlId == Guid.Empty || !lines.Any(l => l.ItemId != Guid.Empty && (l.DebitAmount > 0 || l.CreditAmount > 0)))" class="px-8 py-3 bg-slate-900 text-white font-bold rounded-xl shadow-md hover:bg-slate-800 transition-all active:scale-95 disabled:opacity-50 flex items-center gap-2">
            @if (isBusy)
            {
                <span class="animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
                <span>Posting Balanced Stock Valuation Adjustments...</span>
            }
            else
            {
                <span>Post Adjustments</span>
            }
        </button>
    </div>
</div>

<style>
    .label {
        display: block;
        font-size: 0.70rem;
        font-weight: 800;
        color: #475569;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
        letter-spacing: 0.05em;
    }
</style>

@code {
    private Guid currentCompanyId;
    private string currentUserId = "";
    private bool isBusy = false;
    private DateOnly postingDate = DateOnly.FromDateTime(DateTime.Today);

    private Guid balancingGlId = Guid.Empty;
    private string balancingAccountLabel = string.Empty;

    private List<Item> items = new();
    private List<Warehouse> warehouses = new();
    private List<SegChartOfAccount> coaList = new();
    private List<InventoryAdjustmentUiRowDto> lines = new();

    public class InventoryAdjustmentUiRowDto
    {
        public Guid Id { get; set; } = Guid.NewGuid();
        public Guid ItemId { get; set; }
        public Guid WarehouseId { get; set; }
        public decimal QuantityChange { get; set; }
        public decimal DebitAmount { get; set; }
        public decimal CreditAmount { get; set; }

        public bool IsDebitReadOnly => CreditAmount > 0;
        public bool IsCreditReadOnly => DebitAmount > 0;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!PermissionCache.Has("INVENTORY_PAGE"))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user?.CompanyDetailsId != null)
        {
            currentCompanyId = user.CompanyDetailsId.Value;
            currentUserId = user.Id;

            items = await MasterService.GetItemsAsync(currentCompanyId);
            warehouses = await MasterService.GetREAlWarehousesAsync(currentCompanyId);
            coaList = await SegCoaService.GetActiveCoaAsync(currentCompanyId);

            await LoadActiveRoutingConfigurationLabels();
            lines.Add(new InventoryAdjustmentUiRowDto());
        }
    }

    private async Task LoadActiveRoutingConfigurationLabels()
    {
        using var ctx = await DbFactory.CreateDbContextAsync();
        var mappingConfig = await ctx.TransactionGlMappings
            .Include(m => m.OverrideCreditAccount)
            .AsNoTracking()
            .FirstOrDefaultAsync(m => m.CompanyId == currentCompanyId && m.TransactionType == SystemTransactionType.InventoryAdjustment);

        if (mappingConfig != null && mappingConfig.OverrideCreditAccount != null)
        {
            balancingGlId = mappingConfig.OverrideCreditGlAccountId ?? Guid.Empty;
            balancingAccountLabel = $"{mappingConfig.OverrideCreditAccount.AccountCode} - {mappingConfig.OverrideCreditAccount.Description}";
        }
    }

    private void OnDebitChanged(InventoryAdjustmentUiRowDto line, string? val)
    {
        if (decimal.TryParse(val, out decimal res))
        {
            line.DebitAmount = res;
            if (res > 0) line.CreditAmount = 0;
        }
        else line.DebitAmount = 0;
    }

    private void OnCreditChanged(InventoryAdjustmentUiRowDto line, string? val)
    {
        if (decimal.TryParse(val, out decimal res))
        {
            line.CreditAmount = res;
            if (res > 0) line.DebitAmount = 0;
        }
        else line.CreditAmount = 0;
    }

    private void AddRow() => lines.Add(new InventoryAdjustmentUiRowDto());

    private void RemoveLine(InventoryAdjustmentUiRowDto line)
    {
        lines.Remove(line);
        if (!lines.Any()) lines.Add(new InventoryAdjustmentUiRowDto());
    }

    private void ClearForm()
    {
        lines.Clear();
        lines.Add(new InventoryAdjustmentUiRowDto());
    }

    private async Task PostStockAdjustments()
    {
        var activeLines = lines.Where(l => l.ItemId != Guid.Empty && (l.DebitAmount > 0 || l.CreditAmount > 0)).ToList();

        if (activeLines.Any(l => l.WarehouseId == Guid.Empty && l.QuantityChange != 0))
        {
            await JS.InvokeVoidAsync("alert", "Validation Error: A valid warehouse allocation is required for lines processing a stock quantity change.");
            return;
        }

        isBusy = true;
        StateHasChanged();

        var mappedDtoLines = new List<InventoryAdjustmentLineDto>();

        foreach (var uiLine in activeLines)
        {
            bool isDebit = uiLine.DebitAmount > 0;
            decimal absoluteValueChange = isDebit ? uiLine.DebitAmount : uiLine.CreditAmount;

            decimal computedQuantityChange = isDebit ? Math.Abs(uiLine.QuantityChange) : -Math.Abs(uiLine.QuantityChange);

            mappedDtoLines.Add(new InventoryAdjustmentLineDto
            {
                Id = uiLine.Id,
                ItemId = uiLine.ItemId,
                WarehouseId = uiLine.WarehouseId,
                IsDebitInventory = isDebit,
                QuantityChange = computedQuantityChange,
                TotalValueChange = absoluteValueChange
            });
        }

        var err = await InvService.PostInventoryAdjustmentBatchAsync(currentCompanyId, postingDate, balancingGlId, mappedDtoLines, currentUserId);

        if (string.IsNullOrEmpty(err))
        {
            await JS.InvokeVoidAsync("alert", "Inventory adjustments committed and financial ledgers balanced successfully line-by-line!");
            ClearForm();
        }
        else
        {
            await JS.InvokeVoidAsync("alert", err);
        }

        isBusy = false;
        StateHasChanged();
    }
}